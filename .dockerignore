# ============================================================
# .dockerignore — W-R0 / R2 (platform-completion-plan.md)
# Exclui tudo que não é necessário para o build da imagem MAEZO.
# Mantém: src/, pyproject.toml, uv.lock, config/
# ============================================================

# Ambientes virtuais locais
.venv/
.venv-fix/

# Controle de versão
.git/
.github/

# Caches de ferramentas Python
.mypy_cache/
.pytest_cache/
.ruff_cache/
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
dist/
build/
.eggs/

# uv.lock É usado pelo build (uv sync --frozen — WS-3b predeploy): a imagem instala
# a partir do lock, não de `pip install .`, para reprodutibilidade byte-a-byte entre
# o lock auditado e o artefato implantado. NÃO adicionar de volta a exclusão acima.

# Testes e documentação (não entram na imagem de produção)
tests/
docs/

# Artefatos de deploy (o Dockerfile fica em deploy/ mas o contexto é a raiz)
deploy/
!deploy/
deploy/*
!deploy/cibseven/
deploy/cibseven/*
# Script de configuracao do motor, com as demais excecoes fechadas abaixo.
!deploy/cibseven/configure-group-whitelist.sh
!deploy/cibseven/human-webapp/
deploy/cibseven/human-webapp/*
!deploy/cibseven/human-webapp/WEB-INF/
deploy/cibseven/human-webapp/WEB-INF/*
!deploy/cibseven/human-webapp/WEB-INF/web.xml
!deploy/cibseven/read-webapp/
deploy/cibseven/read-webapp/*
!deploy/cibseven/read-webapp/WEB-INF/
deploy/cibseven/read-webapp/WEB-INF/*
!deploy/cibseven/read-webapp/WEB-INF/web.xml
!deploy/cibseven/secured/
deploy/cibseven/secured/*
!deploy/cibseven/secured/descriptors/
deploy/cibseven/secured/descriptors/*
!deploy/cibseven/secured/descriptors/global-web.xml
!deploy/cibseven/secured/descriptors/bpm-platform.xml
!deploy/cibseven/secured/descriptors/engine-rest-web.xml
!deploy/cibseven/secured/descriptors/camunda-web.xml
!deploy/cibseven/secured/descriptors/startup-global-web.xml
!deploy/cibseven/secured/descriptors/startup-engine-rest-web.xml
!deploy/cibseven/secured/descriptors/context.xml
!deploy/cibseven/secured/descriptors/ROOT-web.xml
!deploy/cibseven/secured/descriptors/docs-web.xml
!deploy/cibseven/secured/descriptors/manager-web.xml
!deploy/cibseven/secured/descriptors/host-manager-web.xml
!deploy/cibseven/secured/descriptors/webapp-web.xml
!deploy/cibseven/secured/descriptors/examples-web.xml
!deploy/cibseven/secured/descriptors/human-web.xml
!deploy/cibseven/secured/native-v2/
deploy/cibseven/secured/native-v2/*
!deploy/cibseven/secured/native-v2/WEB-INF/
deploy/cibseven/secured/native-v2/WEB-INF/*
!deploy/cibseven/secured/native-v2/WEB-INF/web.xml

# Variáveis de ambiente locais (nunca empacotar segredos)
.env
.env.*
*.env

# Dependências Node (scripts de ferramental, se houver)
node_modules/

# Artefatos de IDE / editores
.vscode/
.idea/
*.swp
*.swo

# macOS
.DS_Store
