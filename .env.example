# === Maezo Healthcare Plan — dev environment ===
TENANT_ID=amh
ENVIRONMENT=dev

# Runtime mode discriminator (ADR-0039 Q7). "local" is the ONLY non-production value; the settings
# default is fail-CLOSED ("production"), so this MUST be set explicitly for a local dev run —
# otherwise the agent-runtime composition roots refuse to build (unsigned Cards, no-op fact sink and
# non-durable idempotency are all dev-only branches gated on this). Deployed pods get "kubernetes"
# from Helm; docker-compose.yml sets "local" on the agent-runtime service for the same reason.
AGENT_RUNTIME_MODE=local

# PostgreSQL (estado de agentes, memória, auditoria)
# Porta 5433 (nao 5432): docker-compose.yml publica o host port em 5433 por padrao para nao
# colidir com outras instancias locais de Postgres (ver comentario no servico `postgres`).
DATABASE_URL=postgresql+asyncpg://maezo:maezo@localhost:5433/maezo

# CIB Seven (governança/compliance)
CIBSEVEN_BASE_URL=http://localhost:8080/engine-rest
CIBSEVEN_AUTH_USER=
CIBSEVEN_AUTH_PASSWORD=

# HAPI FHIR R4
FHIR_BASE_URL=http://localhost:8081/fhir

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# LLM — Zona Geral (PHI pseudonimizado; ver ADR-0006)
LLM_GENERAL_PROVIDER=anthropic
LLM_GENERAL_API_KEY=

# --- Inferencia LLM via AWS Bedrock (ZONA GERAL; ADR-0009 / maezo.runtime.inference) ---------
# Bloco COMENTADO de proposito: o default do repo continua `noop` (fail-closed, constraint 2) e
# descomentar estas linhas e o unico jeito de trocar o provider. Zona GERAL apenas — o provider
# `bedrock` tem phi_capable=False, entao uma requisicao phi=True contra ele e RECUSADA
# (PhiZoneRoutingError). A zona PHI continua sendo LLM_PHI_* / MAEZO_PHI_* mais abaixo.
#
# AUTENTICACAO: NENHUMA CREDENCIAL VAI AQUI. O acesso e SigV4 pela cadeia padrao da AWS
# (AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY, AWS_PROFILE, IRSA no cluster), resolvida pelo botocore
# na hora da requisicao — este processo nunca le, guarda nem valida a credencial. Em dev local o
# perfil e `amh-data-dev` (role assumida com MFA, cache do `aws sso`/`aws sts`): isso e AMBIENTE,
# nao configuracao do app, e por isso nao aparece como variavel do Maezo aqui.
# MAEZO_INFERENCE_PROVIDER=bedrock
# Model id — INFERENCE PROFILE `global.anthropic.*`, nao o id 1P e nao o foundation-model "pelado".
# Provado ao vivo (perfil amh-data-dev, sa-east-1, 2026-08-12): `global.anthropic.claude-opus-5`
# responde; `anthropic.claude-opus-5` devolve 404 "The model does not exist" nesta conta.
# MAEZO_BEDROCK_MODEL_ID=global.anthropic.claude-opus-5
# Regiao do endpoint (onde a request e assinada). Default: sa-east-1.
# ATENCAO LGPD: com inference profile `global.*` a inferencia ROTEIA CROSS-REGION por construcao —
# a regiao acima NAO e garantia de residencia (capability declarada: `global-multi-region`).
# Sancionado para a ZONA GERAL (dado pseudonimizado). Residencia PHI e a zona `br_resident`,
# gated em DPA. Transferencia internacional em producao e decisao de dono, nao de config.
# MAEZO_BEDROCK_REGION=sa-east-1
# LLM — Zona PHI (somente endpoint aprovado; egress restrito por NetworkPolicy)
LLM_PHI_ENDPOINT=
LLM_PHI_API_KEY=

# PHI pseudonymizer HMAC key (ADR-0006 — gap #12 vault injection).
# PROD: sincronizada do cofre/KMS (AWS Secrets Manager) para esta env pelo External Secrets
# Operator; lida via env PHI_HMAC_KEY -> Pseudonymizer.from_settings (webhook-receiver,
# fail-closed em prod; ADR-0035).
# Vazia em dev/CI (o runtime deriva uma chave determinista por tenant — NAO secreta).
# BLOCKED: popular o segredo real no cofre e passo manual (§6.2). NUNCA commitar a chave real.
PHI_HMAC_KEY=

# WhatsApp Cloud API — os nomes CANONICOS lidos pelo codigo
# (`src/maezo/tools/mcp_whatsapp/server.py` WhatsAppSettings e
# `src/maezo/platform/webhooks/whatsapp/settings.py` WhatsAppWebhookSettings).
WHATSAPP_TOKEN=
# SO dev local: NENHUM deployment injeta este nome (owner-gated, ver OWNER-DECISIONS)
# — sem ele `send_message` recusa toda resposta da Helena (fail-closed, achado 9.4).
WHATSAPP_PHONE_NUMBER_ID=
# Era `WHATSAPP_WEBHOOK_VERIFY_TOKEN` aqui — grafia MORTA, que NENHUMA das duas classes
# de settings le. O nome real e' o de baixo (`settings.py:44`, Helm
# `deploy/helm/maezo-tenant/templates/deployment-webhook-receiver.yaml:52`,
# `docker-compose.yml:253`).
WHATSAPP_VERIFY_TOKEN=
# Obrigatorio no receiver (`settings.py:40`, `min_length=1`): ausente ou vazio => o
# daemon NAO sobe (ValidationError -> CrashLoopBackOff), de proposito.
WHATSAPP_APP_SECRET=

# OTel (observability profile)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_SERVICE_NAME=maezo-agent

# Tasy Oracle (BLOCKED — credentials pending integration agreement)
# TASY_ORACLE_DSN=
# TASY_ORACLE_USER=

# Episodic attachments S3 (ADR-0002 gap #20 — BLOCKED §6.2: bucket + IAM/IRSA pending)
# Set to activate the S3 object-store path; empty/absent = in-memory fallback (dev/test only).
# EPISODIC_ATTACHMENTS_BUCKET=maezo-episodic-attachments-<env>
# EPISODIC_ATTACHMENTS_REGION=sa-east-1
