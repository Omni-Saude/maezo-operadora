# ADR0049 D5: opt-in pinned Tomcat package, build context is repository root.
# This image fails engine startup without explicit trust config and preinstalled SQL.
FROM maven:3.9.9-eclipse-temurin-17@sha256:f58d59b6273e785ac0a4477f6e9b5ba1d7731c75b906c0f7b34076f1851318cc AS human-build
WORKDIR /build
COPY src/maezo/portal/engine/java/pom.xml ./pom.xml
COPY src/maezo/portal/engine/java/src ./src
RUN mvn -B -DskipTests package
# T1.2: the staff composition plugin (T1.1, D-E) is an explicit image choice. `true` refuses to
# build unless the JAR really carries the class, so the descriptor never names a missing plugin.
ARG INSTALL_STAFF_COMPOSITION=false
RUN case "$INSTALL_STAFF_COMPOSITION" in \
      true) jar tf target/human-command-engine-1.0.0.jar | grep -qx 'br/com/maezo/human/StaffDeploymentComposition.class' ;; \
      false) true ;; \
      *) exit 1 ;; \
    esac
# B1: the Q2 provider package (src/maezo/portal/engine/read-provider/README.md) is part of the read
# composition: PortalReadPlugin refuses to start without it. Built only when INSTALL_PORTAL_READ=true
# (it compiles against the human JAR installed here); /build/provider stays empty otherwise, so
# the runtime COPY below adds nothing to a non-read image.
ARG INSTALL_PORTAL_READ=false
COPY src/maezo/portal/engine/read-provider/pom.xml ./read-provider/pom.xml
COPY src/maezo/portal/engine/read-provider/src/main ./read-provider/src/main
RUN mkdir /build/provider \
    && case "$INSTALL_PORTAL_READ" in \
      true) mvn -B -q -DskipTests install \
        && mvn -B -q -f read-provider/pom.xml -DskipTests package \
        && cp read-provider/target/maezo-portal-read-provider-1.0.0.jar /build/provider/maezo-portal-read-provider.jar ;; \
      false) true ;; \
      *) exit 1 ;; \
    esac
FROM cibseven/cibseven:tomcat-2.1.0@sha256:20a2135bbc634924838b6a067ac27172bb95d68ddec035e01b40d2b9e95a1169
RUN rm -rf /camunda/webapps/camunda-invoice /camunda/webapps/camunda-invoice.war \
    && rm -f /camunda/lib/camunda-invoice*.jar \
    && test ! -e /camunda/webapps/camunda-invoice \
    && test ! -e /camunda/webapps/camunda-invoice.war
COPY --from=human-build /build/target/human-command-engine-1.0.0.jar /camunda/lib/maezo-human-command.jar
COPY --from=human-build /build/provider/ /camunda/lib/
COPY deploy/cibseven/human-webapp /camunda/webapps/maezo-human
# T1.2: the mTLS connector serves ONLY this appBase (its own Service/Host in native-deploy/
# server.xml). The same descriptor stays under webapps/ so the plaintext 8080 keeps answering the
# 403 AUTHORITY_DENIED that the package harness asserts; engine-rest never exists on 8443.
# Created by the build user (same owner as the base's webapps/), so the read branch below can
# add its copy; the descriptor files themselves are root-owned by COPY.
RUN mkdir /camunda/native-webapps
COPY deploy/cibseven/human-webapp /camunda/native-webapps/maezo-human
# Explicit image composition only; this flag installs no read authority.
ARG INSTALL_PORTAL_READ=false
COPY --chown=camunda:camunda deploy/cibseven/read-webapp /tmp/maezo-human-read
# T1.2 owns this descriptor. Parity with the image that runs in dev today
# (deploy/cibseven/Dockerfile): the job executor must not be deployment aware (97 timers were
# never acquired after a restart, 09/09/2026) and the canonical group whitelist must be present.
# Without both, swapping the dev engine to this image (Onda 4) would regress the Helena.
# The staff plan needs authorizationEnabled=true (inherited) and tenant checks at the engine
# default (no tenantCheckEnabled override); the build refuses a base that changed either.
RUN sed -i 's|<property name="jobExecutorDeploymentAware">true</property>|<property name="jobExecutorDeploymentAware">false</property>|' \
        /camunda/conf/bpm-platform.xml \
    && grep -q '<property name="jobExecutorDeploymentAware">false</property>' /camunda/conf/bpm-platform.xml \
    && ! grep -q '<property name="jobExecutorDeploymentAware">true</property>' /camunda/conf/bpm-platform.xml \
    && [ "$(grep -c '<property name="authorizationEnabled">true</property>' /camunda/conf/bpm-platform.xml)" = "1" ] \
    && ! grep -q 'authorizationEnabled">false' /camunda/conf/bpm-platform.xml \
    && ! grep -q 'tenantCheckEnabled' /camunda/conf/bpm-platform.xml
COPY deploy/cibseven/configure-group-whitelist.sh /camunda/configure-group-whitelist.sh
RUN sh /camunda/configure-group-whitelist.sh /camunda/conf/bpm-platform.xml \
    && rm /camunda/configure-group-whitelist.sh
# Modify the existing Tomcat descriptor; do not substitute CIB Run config.
RUN test -f /camunda/conf/bpm-platform.xml \
    && sed -i 's|<plugins>|<plugins><plugin><class>br.com.maezo.human.HumanCommandPlugin</class></plugin>|' /camunda/conf/bpm-platform.xml \
    && grep -q 'br.com.maezo.human.HumanCommandPlugin' /camunda/conf/bpm-platform.xml
RUN case "$INSTALL_PORTAL_READ" in \
      true) cp -R /tmp/maezo-human-read /camunda/native-webapps/maezo-human-read \
        && mv /tmp/maezo-human-read /camunda/webapps/maezo-human-read \
        && sed -i 's|<plugins>|<plugins><plugin><class>br.com.maezo.human.PortalReadPlugin</class></plugin>|' /camunda/conf/bpm-platform.xml \
        && grep -q 'br.com.maezo.human.PortalReadPlugin' /camunda/conf/bpm-platform.xml ;; \
      false) rm -r /tmp/maezo-human-read ;; \
      *) exit 1 ;; \
    esac
# D-E: the composition plugin must run BEFORE HumanCommandPlugin (it calls its setters).
# Inserted last at the head of <plugins>, so it ends up first.
ARG INSTALL_STAFF_COMPOSITION=false
RUN case "$INSTALL_STAFF_COMPOSITION" in \
      true) sed -i 's|<plugins>|<plugins><plugin><class>br.com.maezo.human.StaffDeploymentComposition</class></plugin>|' /camunda/conf/bpm-platform.xml \
        && grep -q 'br.com.maezo.human.StaffDeploymentComposition' /camunda/conf/bpm-platform.xml ;; \
      false) true ;; \
      *) exit 1 ;; \
    esac

# T1.2 deployment descriptor: HTTP 8080 (engine-rest, unchanged) + ONE mTLS connector 8443
# (certificateVerification=required, TLS 1.3, PEM material mounted read-only under
# /run/maezo/native/), and the datasource with the schema path and TLS pinned
# (currentSchema=maezo_native,cibseven, sslmode=verify-full; ADR-0060 D2). Root-owned: the
# runtime user cannot rewrite it. See deploy/cibseven/native-deploy/README.md.
# No forwarded-cert, proxy trust, shared bearer secret, synthetic flag, or validity default.
COPY deploy/cibseven/native-deploy/server.xml /camunda/conf/server.xml
COPY deploy/cibseven/native-deploy/setenv.sh /camunda/bin/setenv.sh
# Public sa-east-1 RDS roots (deploy/certificates/README.md), byte-pinned: the sslrootcert of the
# pinned datasource. A different file fails the build instead of being trusted.
COPY deploy/certificates/sa-east-1-bundle.pem /camunda/conf/rds-sa-east-1-bundle.pem
RUN echo "c2f9255eadfa939dd6f965ede75d8e0d4168c9cbb7ca1e7baa9bff6d5e2c96e1  /camunda/conf/rds-sa-east-1-bundle.pem" | sha256sum -c - \
    && grep -q 'currentSchema=maezo_native,cibseven&amp;sslmode=verify-full&amp;sslrootcert=/camunda/conf/rds-sa-east-1-bundle.pem"' /camunda/conf/server.xml \
    && [ "$(grep -c 'SSLEnabled="true"' /camunda/conf/server.xml)" = "1" ] \
    && grep -q 'certificateVerification="required"' /camunda/conf/server.xml \
    && ! grep -q 'valves.RemoteIpValve"' /camunda/conf/server.xml
# The mTLS appBase holds the human webapps and nothing else (no engine-rest, no Cockpit).
RUN set -eu; native=$(ls -A /camunda/native-webapps | tr '\n' ' '); \
    [ "$native" = "maezo-human " ] || [ "$native" = "maezo-human maezo-human-read " ] \
    || { echo "FATAL (T1.2): unexpected native appBase content: $native" >&2; exit 1; }
# cibseven.sh rewrites the datasource from DB_URL unless this is set; setenv.sh refuses to start
# when a task definition clears it.
ENV SKIP_DB_CONFIG=true
EXPOSE 8443

# ---------------------------------------------------------------------------
# DS-0002 (trivy "Least Privilege User") — explicit final non-root USER plus a
# fail-closed build-time assertion. Base facts proven 2026-09-19 against
# cibseven/cibseven (index sha256:20a2135b…, Alpine 3.22.2): the image config
# already runs as User "camunda" (uid/gid 1000, home/WorkingDir /camunda, mode
# 2755), /tmp is 1777, and /usr/local/tomcat does NOT exist in this base — the
# real runtime paths are /camunda and /tmp. Every RUN above therefore already
# executed as camunda; USER below only makes it explicit, and the assertion runs
# AS camunda, so `test -w` proves the runtime user's write access, not root's.
# If the base changes underneath us (user missing, different uid, paths the
# camunda user cannot write), the build FAILS instead of publishing a root image.
# ---------------------------------------------------------------------------
# C1 (item 3): the engine descriptor (plugins, authorizationEnabled, whitelist) is fixed at build
# time and must not be rewritable by the process uid. The file becomes root:root 0444; its parent
# /camunda/conf becomes root:camunda 1775 (sticky): the runtime may still create files there
# (Tomcat's conf/Catalina), but cannot unlink or rename a root-owned descriptor to replace it.
USER root
RUN chown root:root /camunda/conf/bpm-platform.xml && chmod 0444 /camunda/conf/bpm-platform.xml \
    && chown root:camunda /camunda/conf && chmod 1775 /camunda/conf
USER camunda
RUN set -eu; \
    die() { echo "FATAL (DS-0002): $*" >&2; exit 1; }; \
    f=/camunda/conf/bpm-platform.xml; \
    [ "$(stat -c %u:%g:%a "$f")" = "0:0:444" ] || die "$f is not root:root 0444"; \
    [ ! -w "$f" ] || die "camunda can write $f"; \
    [ "$(stat -c %u:%a /camunda/conf)" = "0:1775" ] || die "/camunda/conf is not root-owned and sticky"; \
    if mv "$f" "$f.x" 2>/dev/null || rm -f "$f" 2>/dev/null && [ ! -e "$f" ]; then die "camunda can replace $f"; fi; \
    getent passwd camunda >/dev/null || die "user 'camunda' missing from base image (getent passwd failed)"; \
    [ "$(id -u)" = "1000" ] || die "effective uid $(id -u) != 1000 — USER camunda did not resolve to the proven base uid"; \
    [ "$(id -g)" = "1000" ] || die "effective gid $(id -g) != 1000"; \
    for d in /camunda /tmp; do \
        [ -d "$d" ] || die "runtime path missing from base image: $d"; \
        [ -w "$d" ] || die "camunda(1000:1000) cannot write $d — engine startup would break"; \
    done; \
    echo "OK (DS-0002): USER camunda 1000:1000 active; camunda writes /camunda and /tmp"
