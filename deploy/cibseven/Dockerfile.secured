# ADR0049 D7-B opt-in staging image. Existing Dockerfile.human and deployed human UI are unchanged.
FROM maven:3.9.9-eclipse-temurin-17@sha256:f58d59b6273e785ac0a4477f6e9b5ba1d7731c75b906c0f7b34076f1851318cc AS secured-build
WORKDIR /build
COPY src/maezo/portal/engine/java/pom.xml ./pom.xml
COPY src/maezo/portal/engine/java/src ./src
RUN mvn -B -DskipTests package
FROM cibseven/cibseven:tomcat-2.1.0@sha256:20a2135bbc634924838b6a067ac27172bb95d68ddec035e01b40d2b9e95a1169
RUN rm -rf /camunda/webapps/camunda-invoice /camunda/webapps/camunda-invoice.war \
    && rm -f /camunda/lib/camunda-invoice*.jar \
    && test ! -e /camunda/webapps/camunda-invoice
COPY --from=secured-build /build/target/human-command-engine-1.0.0.jar /camunda/lib/maezo-human-command.jar
# SPI API is provided by engine-rest's WEB-INF dependencies. It cannot live in Tomcat's common-loader jar.
COPY --from=secured-build /build/target/human-command-engine-1.0.0-rest-spi.jar /camunda/webapps/engine-rest/WEB-INF/lib/maezo-rest-spi.jar
COPY deploy/cibseven/human-webapp /camunda/webapps/maezo-human
# Reproducible XML patches of the inspected actual distribution; vendor servlet defaults retained.
COPY deploy/cibseven/secured/descriptors/global-web.xml /camunda/conf/web.xml
COPY deploy/cibseven/secured/descriptors/bpm-platform.xml /camunda/conf/bpm-platform.xml
COPY deploy/cibseven/secured/descriptors/engine-rest-web.xml /camunda/webapps/engine-rest/WEB-INF/web.xml
RUN cp /camunda/webapps/camunda/WEB-INF/web.xml /camunda/camunda-web.legacy.xml
COPY deploy/cibseven/secured/descriptors/camunda-web.xml /camunda/webapps/camunda/WEB-INF/web.xml
# No default policy or TLS material: SecureLayout requires exactly one HTTPS/mTLS connector,
# explicit mounted-file digests, auth/SPI/filter bindings and disabled autoDeploy before availability.

# ---------------------------------------------------------------------------
# DS-0002 (trivy "Least Privilege User") — explicit final non-root USER plus a
# fail-closed build-time assertion. Base facts proven 2026-09-19 against
# cibseven/cibseven (index sha256:20a2135b…, Alpine 3.22.2): the image config
# already runs as User "camunda" (uid/gid 1000, home/WorkingDir /camunda, mode
# 2755), /tmp is 1777, and /usr/local/tomcat does NOT exist in this base — the
# real runtime paths are /camunda and /tmp. Every RUN above therefore already
# executed as camunda; USER below only makes it explicit, and the assertion runs
# AS camunda, so `test -w` proves the runtime user's write access, not root's.
# If the base changes underneath us (user missing, different uid, paths the
# camunda user cannot write), the build FAILS instead of publishing a root image.
# ---------------------------------------------------------------------------
USER camunda
RUN set -eu; \
    die() { echo "FATAL (DS-0002): $*" >&2; exit 1; }; \
    getent passwd camunda >/dev/null || die "user 'camunda' missing from base image (getent passwd failed)"; \
    [ "$(id -u)" = "1000" ] || die "effective uid $(id -u) != 1000 — USER camunda did not resolve to the proven base uid"; \
    [ "$(id -g)" = "1000" ] || die "effective gid $(id -g) != 1000"; \
    for d in /camunda /tmp; do \
        [ -d "$d" ] || die "runtime path missing from base image: $d"; \
        [ -w "$d" ] || die "camunda(1000:1000) cannot write $d — engine startup would break"; \
    done; \
    echo "OK (DS-0002): USER camunda 1000:1000 active; camunda writes /camunda and /tmp"
