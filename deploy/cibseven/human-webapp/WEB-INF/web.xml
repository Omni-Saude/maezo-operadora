<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee" version="4.0">
  <display-name>Maezo private human commands</display-name>
  <servlet><servlet-name>human</servlet-name><servlet-class>br.com.maezo.human.HumanServlet</servlet-class><load-on-startup>1</load-on-startup></servlet>
  <servlet-mapping><servlet-name>human</servlet-name><url-pattern>/*</url-pattern></servlet-mapping>
  <session-config><cookie-config><http-only>true</http-only><secure>true</secure></cookie-config><tracking-mode>COOKIE</tracking-mode></session-config>
</web-app>
