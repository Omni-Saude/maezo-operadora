{
  "id": null,
  "uid": "maezo-worker-runtime",
  "title": "Maezo / Worker Runtime",
  "description": "Metricas de execucao/erro/outcome dos workers de external task (src/maezo/runtime/worker_runtime + src/maezo/tools/workers via src/maezo/runtime/metrics.py). Conteudo provisorio ate D12-01-a (documento de SLO) existir — ver nota do PR.",
  "tags": [
    "maezo",
    "worker-runtime",
    "d12-02"
  ],
  "schemaVersion": 39,
  "version": 1,
  "style": "dark",
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "fiscalYearStartMonth": 0,
  "weekStart": "",
  "links": [],
  "annotations": {
    "list": []
  },
  "templating": {
    "list": []
  },
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {},
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Worker execution time p95 (SLA: 5s — MaezoSLAWorkerLatencyHigh)",
      "description": "Mesma expressao de MaezoSLAWorkerLatencyHigh (alert-rules.yml), com o limiar de 5s marcado como threshold do painel.",
      "maezo_mirrors_alert": "MaezoSLAWorkerLatencyHigh",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "spanNulls": false,
            "pointSize": 5
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "last",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(maezo_worker_execution_time_seconds_bucket[5m]))",
          "legendFormat": "{{worker}} / {{topic}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Worker error rate (crash-loop proxy: MaezoWorkerCrashLoop > 0.01/s)",
      "description": "Mesma serie de MaezoWorkerCrashLoop.",
      "maezo_mirrors_alert": "MaezoWorkerCrashLoop",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "spanNulls": false,
            "pointSize": 5
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "last",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "rate(maezo_worker_error_count_total[5m])",
          "legendFormat": "{{worker}} / {{topic}} / {{error_type}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Worker error ratio (SLA: 5% — MaezoSLAWorkerErrorRateHigh)",
      "description": "Mesma expressao de MaezoSLAWorkerErrorRateHigh; espelha o alerta. ALERT-RULES-VECTOR-MATCH-MISMATCH CORRIGIDO nesta linha: a divisao antiga (sem `sum by` em nenhum lado, label sets divergentes worker,topic,error_type vs worker,topic) produzia vetor sempre vazio; agora ambos os lados agregam `sum by (worker, topic)`, igual ao padrao ja usado por MaezoSLAAgentErrorRateHigh (ALERT-COUNTER-LABELS/R-063).",
      "maezo_mirrors_alert": "MaezoSLAWorkerErrorRateHigh",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "spanNulls": false,
            "pointSize": 5
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "last",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "sum by (worker, topic) (rate(maezo_worker_error_count_total[5m])) / sum by (worker, topic) (rate(maezo_worker_execution_time_seconds_count[5m]))",
          "legendFormat": "{{worker}} / {{topic}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "External-task dispatch outcome rate (fetch-and-lock -> outcome)",
      "description": "T1.1/GAP-XOBS-4: outcome de cada external task despachada apos fetch-and-lock (completed | bpmn_error | failed | incident).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "spanNulls": false,
            "pointSize": 5
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "last",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "sum by (tenant, topic, outcome) (rate(maezo_worker_task_total[5m]))",
          "legendFormat": "{{tenant}} / {{topic}} / {{outcome}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "External-task handler duration p95",
      "description": "Latencia wall-clock do handler por outcome (T1.1/GAP-XOBS-4).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "spanNulls": false,
            "pointSize": 5
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "last",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, tenant, topic, outcome) (rate(maezo_worker_task_duration_seconds_bucket[5m])))",
          "legendFormat": "{{tenant}} / {{topic}} / {{outcome}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Worker execution count (throughput)",
      "description": "Throughput de execucoes concluidas por worker/topico.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "spanNulls": false,
            "pointSize": 5
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "last",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "sum by (worker, topic) (rate(maezo_worker_execution_time_seconds_count[5m]))",
          "legendFormat": "{{worker}} / {{topic}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ]
    }
  ]
}
