{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "maezo-operadora/docs/governance/cleanroom/cleanroom-record.schema.json",
  "title": "Registro de sala limpa por EXTRACT (EP-CORE-09b)",
  "description": "Um arquivo CLEANROOM-OMNI-V-<nn>.json por EXTRACT re-derivado pelo caminho B de CORE-09. Verificado por scripts/docs/cleanroom_records.py e tests/governance/test_cleanroom_records.py.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "extract", "modules", "spec_sources", "spec_author", "implementer", "attestation"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "extract": {"type": "string", "pattern": "^OMNI-V-[0-9]{2}$", "description": "Veredito OMNI-V-<nn> do EXTRACT (CORE-09, tabela por EXTRACT)."},
    "modules": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "description": "Caminho no maezo-operadora de um modulo que traz o marcador derived-from deste EXTRACT."}
    },
    "spec_sources": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["repository", "path"],
        "properties": {
          "repository": {"enum": ["Omni-Saude/maezo-operadora", "Omni-Saude/amh-data-platform"]},
          "path": {"type": "string", "minLength": 1},
          "lines": {"type": "string", "description": "Faixa de linhas opcional, p.ex. 445-464."},
          "commit": {"type": "string", "pattern": "^[0-9a-f]{7,40}$"}
        }
      }
    },
    "spec_author": {"type": "string", "minLength": 1, "description": "Quem escreveu a spec funcional (primeiro nome ou papel)."},
    "implementer": {"type": "string", "minLength": 1, "description": "Quem implementou; deve ser diferente de spec_author."},
    "attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["implementer_did_not_open_omni_files", "attested_by"],
      "properties": {
        "implementer_did_not_open_omni_files": {"const": true},
        "attested_by": {"type": "string", "minLength": 1, "description": "Igual a implementer."},
        "attested_at": {"type": "string", "format": "date"}
      }
    },
    "notes": {"type": "string"}
  }
}
