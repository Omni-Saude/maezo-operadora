<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_CA_SERVICOS" targetNamespace="http://central-atendimento/bpmn/arq01" exporter="Camunda Modeler" exporterVersion="5.44.0" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.24.0">
  <bpmn:collaboration id="Collaboration_CA_SERVICOS" name="Central de Atendimento — Serviços compartilhados">
    <bpmn:documentation>Serviços compartilhados: este arquivo concentra H1 (identidade e consentimento), H2 (comunicação) e H3 (perfil e recomendação), chamados por COMPRA, UTILIZAÇÃO e SUPORTE por callActivity entre arquivos. Dependência de implantação: publicar este arquivo antes dos chamadores. Estrutura: 1 colaboração, 9 participantes, 6 processos, 6 laneSets, 1 plano de diagrama.</bpmn:documentation>
    <bpmn:participant id="Participant_Macros" name="Macroprocessos COMPRA · UTILIZAÇÃO · SUPORTE"/>
    <bpmn:participant id="Participant_CA_H2_ComunicarCliente" name="H2 — Comunicar o cliente" processRef="Process_CA_H2_ComunicarCliente"/>
    <bpmn:participant id="Participant_Cliente" name="Cliente — necessidade · visão · intenção"/>
    <bpmn:participant id="Participant_CA_H2_SelecionarCanal" name="H2.1 — Selecionar canal e momento" processRef="Process_CA_H2_SelecionarCanal"/>
    <bpmn:participant id="Participant_CA_H1_IdentidadeConsentimento" name="H1 — Identidade e consentimento" processRef="Process_CA_H1_IdentidadeConsentimento"/>
    <bpmn:participant id="Participant_CA_H3_ConhecerCliente" name="H3 — Conhecer o cliente e aprender" processRef="Process_CA_H3_ConhecerCliente"/>
    <bpmn:participant id="Participant_CA_H3_EnriquecerCliente" name="H3.1 — Enriquecer perfil 360 do cliente" processRef="Process_CA_H3_EnriquecerCliente"/>
    <bpmn:participant id="Participant_Fontes" name="Fontes externas (DATASUS, ANS, FHIR)"/>
    <bpmn:participant id="Participant_CA_H3_ProximaMelhorAcao" name="H3.2 — Calcular próxima melhor ação" processRef="Process_CA_H3_ProximaMelhorAcao"/>
    <bpmn:messageFlow id="MF_SV_01" sourceRef="Participant_Macros" targetRef="H2_Start"/>
    <bpmn:messageFlow id="MF_SV_02" name="Mensagem" sourceRef="H2_T_Enviar" targetRef="Participant_Cliente"/>
    <bpmn:messageFlow id="MF_SV_03" name="SMS" sourceRef="H2_T_Fallback" targetRef="Participant_Cliente"/>
    <bpmn:messageFlow id="MF_SV_04" sourceRef="Participant_Macros" targetRef="H3_Start_Evento"/>
    <bpmn:messageFlow id="MF_SV_05" name="Dados abertos" sourceRef="Participant_Fontes" targetRef="EC_T_Abertos"/>
    <bpmn:messageFlow id="MF_SV_06" name="Dados clínicos" sourceRef="Participant_Fontes" targetRef="EC_T_Clinicos"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_CA_H2_ComunicarCliente" name="H2 — Comunicar o cliente" isExecutable="true" camunda:versionTag="3.0.0-arq01" camunda:historyTimeToLive="180">
    <bpmn:documentation>Serviço compartilhado: informar antes de o cliente perguntar. Acionado pelos marcos de COMPRA, UTILIZAÇÃO e SUPORTE e por recomendações de H3, sempre com o Journey ID (corrige FR-02). Mensagem: situação na 1ª frase, próxima ação na 2ª.</bpmn:documentation>
    <bpmn:documentation>Barreiras de contato: opt-in/base legal por categoria, frequency capping e horário silencioso, limiar de confiança com revisão humana e respeito à decisão de envio (enviar, adiar ou suprimir). Toda nova comunicação deve passar por essas barreiras.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_Process_CA_H2_ComunicarCliente">
      <bpmn:lane id="LN_CA0_H2_CrmEComunicacao" name="CRM e comunicação">
        <bpmn:documentation>Dimensão: Staff · Origem: SUB-01 §2.1 · Ref: H2_CA_Canal</bpmn:documentation>
        <bpmn:flowNodeRef>H2_Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>H2_T_Classificar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>H2_GW_Tipo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>H2_T_Gerar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>H2_GW_Confiavel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>H2_GW_MergeRevisao</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>H2_CA_Canal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>H2_GW_Envio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>H2_EV_Janela</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>H2_End_Suprimido</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>H2_T_Enviar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>H2_GW_Entregue</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>H2_End_Informado</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>H2_T_Fallback</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>H2_End_Contingencia</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>H2_T_Portal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>H2_End_Portal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>H2_T_Log</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>H2_End_Log</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LN_CA0_H2_GovernancaClinica" name="Governança clínica">
        <bpmn:documentation>Dimensão: Staff · Origem: candidateGroups da tarefa</bpmn:documentation>
        <bpmn:flowNodeRef>H2_T_Revisao</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>H2_B_SLA_Revisao</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>H2_T_EscalarRevisao</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>H2_End_SLA_Revisao</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="H2_Start" name="Marco ou informação a comunicar">
      <bpmn:documentation>Payload: journeyId, clienteId, marcoJornada, estadoFactual, etaEstimada, urgenciaSugerida. | Origem: M3_Start_StatusEntrega + M3_Start_Perfil + M3_Start_Recomendacao + M3_Start_Reengajar + M3_Start_ServiceRecovery + M3_Start_EventoClinico (consolidados)</bpmn:documentation>
      <bpmn:outgoing>F_CA_H2_ComunicarCliente_01</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_CA_ComunicarCliente"/>
    </bpmn:startEvent>
    <bpmn:serviceTask id="H2_T_Classificar" name="Classificar evento (IA): tipo, urgência, categoria" camunda:asyncBefore="true" camunda:delegateExpression="${eventClassifierAI}">
      <bpmn:documentation>Produz tipoEvento ∈ {ACAO, REFERENCIA, REGISTRO}, urgencia ∈ {CRITICA, ACIONAVEL, INFORMATIVA}, categoriaMensagem. | Origem: M3_T_Classificar</bpmn:documentation>
      <bpmn:incoming>F_CA_H2_ComunicarCliente_01</bpmn:incoming>
      <bpmn:outgoing>F_CA_H2_ComunicarCliente_02</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="H2_GW_Tipo" name="Evento exige ação ou antecipa dúvida?" default="F_CA_H2_ComunicarCliente_05">
      <bpmn:documentation>Origem: M3_GW_Classifica</bpmn:documentation>
      <bpmn:documentation>Regra: comunicar somente quando o evento exige ação do cliente ou antecipa dúvida; demais casos não geram envio — dono: CRM e comunicação</bpmn:documentation>
      <bpmn:incoming>F_CA_H2_ComunicarCliente_02</bpmn:incoming>
      <bpmn:outgoing>F_CA_H2_ComunicarCliente_03</bpmn:outgoing>
      <bpmn:outgoing>F_CA_H2_ComunicarCliente_04</bpmn:outgoing>
      <bpmn:outgoing>F_CA_H2_ComunicarCliente_05</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="H2_T_Gerar" name="Gerar mensagem (IA)" camunda:asyncBefore="true" camunda:delegateExpression="${proactiveMessageAI}">
      <bpmn:documentation>Situação na 1ª frase, ação na 2ª. Templates com revisão de compliance. Produz confiancaMensagem, tierClinico, mensagem. | Origem: M3_T_GerarMsg</bpmn:documentation>
      <bpmn:incoming>F_CA_H2_ComunicarCliente_03</bpmn:incoming>
      <bpmn:outgoing>F_CA_H2_ComunicarCliente_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="H2_GW_Confiavel" name="Mensagem confiável e fora do risco clínico 3?" default="F_CA_H2_ComunicarCliente_08">
      <bpmn:documentation>Origem: M3_GW_ConfiancaProativa</bpmn:documentation>
      <bpmn:documentation>Regra: envio automático só com confiança igual ou acima do limiar e fora de risco clínico alto; caso contrário, revisão humana — dono: CRM e comunicação</bpmn:documentation>
      <bpmn:incoming>F_CA_H2_ComunicarCliente_06</bpmn:incoming>
      <bpmn:outgoing>F_CA_H2_ComunicarCliente_07</bpmn:outgoing>
      <bpmn:outgoing>F_CA_H2_ComunicarCliente_08</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="H2_T_Revisao" name="Revisar clinicamente a mensagem" camunda:formKey="ced:revisao-clinica-mensagem" camunda:candidateGroups="governanca-clinica">
      <bpmn:documentation>Origem: M3_T_RevisaoClinica</bpmn:documentation>
      <bpmn:incoming>F_CA_H2_ComunicarCliente_08</bpmn:incoming>
      <bpmn:outgoing>F_CA_H2_ComunicarCliente_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="H2_B_SLA_Revisao" name="SLA 4h sem revisão" cancelActivity="false" attachedToRef="H2_T_Revisao">
      <bpmn:outgoing>F_CA_H2_ComunicarCliente_22</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT4H</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="H2_T_EscalarRevisao" name="Escalar revisão clínica pendente">
      <bpmn:incoming>F_CA_H2_ComunicarCliente_22</bpmn:incoming>
      <bpmn:outgoing>F_CA_H2_ComunicarCliente_23</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="H2_End_SLA_Revisao" name="Revisão escalada — mensagem retida">
      <bpmn:incoming>F_CA_H2_ComunicarCliente_23</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="H2_GW_MergeRevisao" name="">
      <bpmn:documentation>Origem: M3_GW_MergeRevisao</bpmn:documentation>
      <bpmn:incoming>F_CA_H2_ComunicarCliente_07</bpmn:incoming>
      <bpmn:incoming>F_CA_H2_ComunicarCliente_09</bpmn:incoming>
      <bpmn:incoming>F_CA_H2_ComunicarCliente_15</bpmn:incoming>
      <bpmn:outgoing>F_CA_H2_ComunicarCliente_10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:callActivity id="H2_CA_Canal" name="Selecionar canal e momento" camunda:asyncBefore="true" calledElement="Process_CA_H2_SelecionarCanal">
      <bpmn:documentation>Origem: M3_CA_SelecionarCanal</bpmn:documentation>
      <bpmn:documentation>Contrato de variáveis a confirmar com a equipe: este passo pode produzir/consumir variáveis em execução (delegados/formulários) não declaradas no modelo; a lista explícita reflete o que o próprio modelo comprova.</bpmn:documentation>
      <bpmn:extensionElements>
        <camunda:in businessKey="#{execution.processBusinessKey}"/>
        <camunda:in source="categoriaPermitida" target="categoriaPermitida"/>
        <camunda:in source="urgencia" target="urgencia"/>
        <camunda:in source="envioPermitidoAgora" target="envioPermitidoAgora"/>
        <camunda:in source="proximaJanela" target="proximaJanela"/>
        <camunda:out source="decisaoEnvio" target="decisaoEnvio"/>
      </bpmn:extensionElements>
      <bpmn:incoming>F_CA_H2_ComunicarCliente_10</bpmn:incoming>
      <bpmn:outgoing>F_CA_H2_ComunicarCliente_11</bpmn:outgoing>
      <bpmn:property id="Property_H2_CA_Canal_targetRef" name="__targetRef_placeholder"/>
      <bpmn:dataInputAssociation id="DIA_INS_001_2">
        <bpmn:sourceRef>DSR_INS_001_2</bpmn:sourceRef>
        <bpmn:targetRef>Property_H2_CA_Canal_targetRef</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="H2_GW_Envio" name="Decisão de envio?" default="F_CA_H2_ComunicarCliente_14">
      <bpmn:documentation>Origem: M3_GW_Envio</bpmn:documentation>
      <bpmn:documentation>Regra: a decisão de envio do cliente prevalece — enviar agora, adiar para a próxima janela ou suprimir — dono: CRM e comunicação</bpmn:documentation>
      <bpmn:incoming>F_CA_H2_ComunicarCliente_11</bpmn:incoming>
      <bpmn:outgoing>F_CA_H2_ComunicarCliente_12</bpmn:outgoing>
      <bpmn:outgoing>F_CA_H2_ComunicarCliente_13</bpmn:outgoing>
      <bpmn:outgoing>F_CA_H2_ComunicarCliente_14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateCatchEvent id="H2_EV_Janela" name="Aguardar próxima janela permitida">
      <bpmn:documentation>Horário silencioso / batching. | Origem: M3_EV_AguardarJanela</bpmn:documentation>
      <bpmn:incoming>F_CA_H2_ComunicarCliente_13</bpmn:incoming>
      <bpmn:outgoing>F_CA_H2_ComunicarCliente_15</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeDate xsi:type="bpmn:tFormalExpression">${proximaJanela}</bpmn:timeDate>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="H2_End_Suprimido" name="Suprimido ou agrupado por preferência">
      <bpmn:documentation>Origem: M3_End_Suprimido</bpmn:documentation>
      <bpmn:incoming>F_CA_H2_ComunicarCliente_14</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="H2_T_Enviar" name="Enviar no canal selecionado" camunda:asyncBefore="true" camunda:delegateExpression="${omniChannelDispatcher}">
      <bpmn:documentation>Produz entregue. | Origem: M3_T_Enviar</bpmn:documentation>
      <bpmn:incoming>F_CA_H2_ComunicarCliente_12</bpmn:incoming>
      <bpmn:outgoing>F_CA_H2_ComunicarCliente_16</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="H2_GW_Entregue" name="Entregue no canal?" default="F_CA_H2_ComunicarCliente_18">
      <bpmn:documentation>Origem: M3_GW_Entregue</bpmn:documentation>
      <bpmn:documentation>Regra: sem confirmação de entrega, reenviar pelo canal de contingência — dono: CRM e comunicação</bpmn:documentation>
      <bpmn:incoming>F_CA_H2_ComunicarCliente_16</bpmn:incoming>
      <bpmn:outgoing>F_CA_H2_ComunicarCliente_17</bpmn:outgoing>
      <bpmn:outgoing>F_CA_H2_ComunicarCliente_18</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="H2_End_Informado" name="Cliente informado antes de perguntar">
      <bpmn:documentation>Origem: M3_End_Proativo</bpmn:documentation>
      <bpmn:incoming>F_CA_H2_ComunicarCliente_17</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="H2_T_Fallback" name="Enviar por canal de contingência (SMS)" camunda:asyncBefore="true" camunda:delegateExpression="${fallbackChannelDispatcher}">
      <bpmn:documentation>Evita o anti-padrão "push sem app instalado". | Origem: M3_T_Fallback</bpmn:documentation>
      <bpmn:incoming>F_CA_H2_ComunicarCliente_18</bpmn:incoming>
      <bpmn:outgoing>F_CA_H2_ComunicarCliente_19</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="H2_End_Contingencia" name="Informado pelo canal de contingência">
      <bpmn:documentation>Origem: M3_End_ProativoFallback</bpmn:documentation>
      <bpmn:incoming>F_CA_H2_ComunicarCliente_19</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="H2_T_Portal" name="Atualizar FAQ personalizada e central de ajuda" camunda:asyncBefore="true" camunda:delegateExpression="${helpCenterPublisher}">
      <bpmn:documentation>Origem: M3_T_AtualizarPortal</bpmn:documentation>
      <bpmn:incoming>F_CA_H2_ComunicarCliente_04</bpmn:incoming>
      <bpmn:outgoing>F_CA_H2_ComunicarCliente_20</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="H2_End_Portal" name="Informação disponível quando o cliente buscar">
      <bpmn:documentation>Origem: M3_End_Portal</bpmn:documentation>
      <bpmn:incoming>F_CA_H2_ComunicarCliente_20</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="H2_T_Log" name="Registrar evento no contexto do cliente" camunda:asyncBefore="true" camunda:delegateExpression="${contextEventLogger}">
      <bpmn:documentation>Origem: M3_T_LogEvento</bpmn:documentation>
      <bpmn:incoming>F_CA_H2_ComunicarCliente_05</bpmn:incoming>
      <bpmn:outgoing>F_CA_H2_ComunicarCliente_21</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="H2_End_Log" name="Contexto atualizado">
      <bpmn:documentation>Origem: M3_End_Log</bpmn:documentation>
      <bpmn:incoming>F_CA_H2_ComunicarCliente_21</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_CA_H2_ComunicarCliente_01" sourceRef="H2_Start" targetRef="H2_T_Classificar"/>
    <bpmn:sequenceFlow id="F_CA_H2_ComunicarCliente_02" sourceRef="H2_T_Classificar" targetRef="H2_GW_Tipo"/>
    <bpmn:sequenceFlow id="F_CA_H2_ComunicarCliente_03" name="Ação / antecipação" sourceRef="H2_GW_Tipo" targetRef="H2_T_Gerar">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${tipoEvento == "ACAO"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_CA_H2_ComunicarCliente_04" name="Referência" sourceRef="H2_GW_Tipo" targetRef="H2_T_Portal">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${tipoEvento == "REFERENCIA"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_CA_H2_ComunicarCliente_05" name="Registro" sourceRef="H2_GW_Tipo" targetRef="H2_T_Log"/>
    <bpmn:sequenceFlow id="F_CA_H2_ComunicarCliente_06" sourceRef="H2_T_Gerar" targetRef="H2_GW_Confiavel"/>
    <bpmn:sequenceFlow id="F_CA_H2_ComunicarCliente_07" name="Sim — liberada" sourceRef="H2_GW_Confiavel" targetRef="H2_GW_MergeRevisao">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${confiancaMensagem &gt;= limiarConfianca &amp;&amp; tierClinico != "T3"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_CA_H2_ComunicarCliente_08" name="Não — revisão humana" sourceRef="H2_GW_Confiavel" targetRef="H2_T_Revisao"/>
    <bpmn:sequenceFlow id="F_CA_H2_ComunicarCliente_09" name="Aprovada" sourceRef="H2_T_Revisao" targetRef="H2_GW_MergeRevisao"/>
    <bpmn:sequenceFlow id="F_CA_H2_ComunicarCliente_10" sourceRef="H2_GW_MergeRevisao" targetRef="H2_CA_Canal"/>
    <bpmn:sequenceFlow id="F_CA_H2_ComunicarCliente_11" sourceRef="H2_CA_Canal" targetRef="H2_GW_Envio"/>
    <bpmn:sequenceFlow id="F_CA_H2_ComunicarCliente_12" name="Enviar agora" sourceRef="H2_GW_Envio" targetRef="H2_T_Enviar">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${decisaoEnvio == "ENVIAR"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_CA_H2_ComunicarCliente_13" name="Adiar" sourceRef="H2_GW_Envio" targetRef="H2_EV_Janela">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${decisaoEnvio == "ADIAR"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_CA_H2_ComunicarCliente_14" name="Suprimir" sourceRef="H2_GW_Envio" targetRef="H2_End_Suprimido"/>
    <bpmn:sequenceFlow id="F_CA_H2_ComunicarCliente_15" sourceRef="H2_EV_Janela" targetRef="H2_GW_MergeRevisao"/>
    <bpmn:sequenceFlow id="F_CA_H2_ComunicarCliente_16" sourceRef="H2_T_Enviar" targetRef="H2_GW_Entregue"/>
    <bpmn:sequenceFlow id="F_CA_H2_ComunicarCliente_17" name="Sim" sourceRef="H2_GW_Entregue" targetRef="H2_End_Informado">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${entregue == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_CA_H2_ComunicarCliente_18" name="Não — contingência" sourceRef="H2_GW_Entregue" targetRef="H2_T_Fallback"/>
    <bpmn:sequenceFlow id="F_CA_H2_ComunicarCliente_19" sourceRef="H2_T_Fallback" targetRef="H2_End_Contingencia"/>
    <bpmn:sequenceFlow id="F_CA_H2_ComunicarCliente_20" sourceRef="H2_T_Portal" targetRef="H2_End_Portal"/>
    <bpmn:sequenceFlow id="F_CA_H2_ComunicarCliente_21" sourceRef="H2_T_Log" targetRef="H2_End_Log"/>
    <bpmn:sequenceFlow id="F_CA_H2_ComunicarCliente_22" sourceRef="H2_B_SLA_Revisao" targetRef="H2_T_EscalarRevisao"/>
    <bpmn:sequenceFlow id="F_CA_H2_ComunicarCliente_23" sourceRef="H2_T_EscalarRevisao" targetRef="H2_End_SLA_Revisao"/>
    <bpmn:dataStoreReference id="DSR_INS_001_2" name="Central de preferências (preferências de canal e histórico de contato do cliente)" dataStoreRef="DS_INS_001">
      <bpmn:documentation>Insumo INS-001 · Origem: SUB-01 §2.1 Insumo (JIT); SUB-01 §2.1 · coluna Subprocesso genérico; SUB-01 §2.1 · coluna Entrada; CA_0 · SC_T_Preferencias · rótulo; CA_0 · SC_T_Preferencias · documentation ⚠️ AMBIGUIDADE — SUB-01 §2.1 nomeia como Entrada o 'Cadastro/histórico de interações do cliente'; o diagrama nomeia a fonte como 'central de preferências', cuja documentation lista categoria, canal, frequência, horário silencioso e opt-in, sem histórico de interações. Modelado como um único DS (leitura mais sustentada: a atividade que executa a consulta é SC_T_Preferencias). Alternativa: dois DS distintos (central de preferências; cadastro/histórico de interações do cliente).</bpmn:documentation>
    </bpmn:dataStoreReference>
  </bpmn:process>
  <bpmn:process id="Process_CA_H2_SelecionarCanal" name="H2.1 — Selecionar canal e momento" isExecutable="true" camunda:versionTag="3.0.0-arq01" camunda:historyTimeToLive="180">
    <bpmn:documentation>Entrada: clienteId, urgencia, categoriaMensagem. Saída: decisaoEnvio ∈ {ENVIAR, ADIAR, SUPRIMIR}, canalSelecionado, proximaJanela. Crítico = push + SMS sempre; acionável = in-app + follow-up; informativo = digest/e-mail; nunca push para marketing.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_Process_CA_H2_SelecionarCanal">
      <bpmn:lane id="LN_CA0_H21_CrmEComunicacao" name="CRM e comunicação">
        <bpmn:documentation>Dimensão: Staff · Origem: SUB-01 §2.1 (Staff) · Ref: H2_CA_Canal</bpmn:documentation>
        <bpmn:flowNodeRef>SC_T_Canal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SC_GW_Critico</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SC_GW_MergeEnviar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SC_End_Enviar</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LN_CA0_H21_AgendaECapacidade" name="Agenda e capacidade">
        <bpmn:documentation>Dimensão: Slot · Origem: SUB-01 §2.1 (Slot) · Ref: H2_CA_Canal</bpmn:documentation>
        <bpmn:flowNodeRef>SC_T_Capping</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SC_GW_Decisao</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SC_End_Adiar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SC_End_Suprimir</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LN_CA0_H21_DisponibilizacaoDeInsumos" name="Disponibilização de insumos">
        <bpmn:documentation>Dimensão: Insumo JIT · Origem: SUB-01 §2.1 (Insumo) · Ref: H2_CA_Canal</bpmn:documentation>
        <bpmn:flowNodeRef>SC_Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SC_T_Preferencias</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SC_GW_OptIn</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SC_End_OptOut</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="SC_Start" name="Mensagem pronta para envio">
      <bpmn:documentation>Origem: SC_Start</bpmn:documentation>
      <bpmn:outgoing>F_CA_H2_SelecionarCanal_01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="SC_T_Preferencias" name="Consultar central de preferências" camunda:delegateExpression="${preferenceCenterService}">
      <bpmn:documentation>Categoria × canal × frequência × horário silencioso × opt-in por finalidade (LGPD). Produz categoriaPermitida. | Origem: SC_T_Preferencias</bpmn:documentation>
      <bpmn:incoming>F_CA_H2_SelecionarCanal_01</bpmn:incoming>
      <bpmn:outgoing>F_CA_H2_SelecionarCanal_02</bpmn:outgoing>
      <bpmn:property id="Property_SC_T_Preferencias_targetRef" name="__targetRef_placeholder"/>
      <bpmn:dataInputAssociation id="DIA_INS_001_1">
        <bpmn:sourceRef>DSR_INS_001_1</bpmn:sourceRef>
        <bpmn:targetRef>Property_SC_T_Preferencias_targetRef</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="SC_GW_OptIn" name="Categoria permitida (opt-in / base legal)?" default="F_CA_H2_SelecionarCanal_04">
      <bpmn:documentation>Origem: SC_GW_OptIn</bpmn:documentation>
      <bpmn:documentation>Regra: só comunicar com opt-in/base legal da categoria; sem opt-in, suprimir — dono: Disponibilização de insumos</bpmn:documentation>
      <bpmn:incoming>F_CA_H2_SelecionarCanal_02</bpmn:incoming>
      <bpmn:outgoing>F_CA_H2_SelecionarCanal_03</bpmn:outgoing>
      <bpmn:outgoing>F_CA_H2_SelecionarCanal_04</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="SC_End_OptOut" name="Suprimido — sem opt-in">
      <bpmn:documentation>Origem: SC_End_OptOut</bpmn:documentation>
      <bpmn:extensionElements>
        <camunda:executionListener expression="${execution.setVariable('decisaoEnvio', 'SUPRIMIR')}" event="start"/>
      </bpmn:extensionElements>
      <bpmn:incoming>F_CA_H2_SelecionarCanal_04</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="SC_T_Canal" name="Mapear urgência para canal" camunda:delegateExpression="${channelRoutingService}">
      <bpmn:documentation>Produz canalSelecionado. | Origem: SC_T_Canal</bpmn:documentation>
      <bpmn:incoming>F_CA_H2_SelecionarCanal_03</bpmn:incoming>
      <bpmn:outgoing>F_CA_H2_SelecionarCanal_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="SC_GW_Critico" name="Urgência crítica?" default="F_CA_H2_SelecionarCanal_07">
      <bpmn:documentation>Origem: SC_GW_Critico</bpmn:documentation>
      <bpmn:documentation>Regra: urgência crítica usa o canal imediato, sem esperar janela — dono: CRM e comunicação</bpmn:documentation>
      <bpmn:incoming>F_CA_H2_SelecionarCanal_05</bpmn:incoming>
      <bpmn:outgoing>F_CA_H2_SelecionarCanal_06</bpmn:outgoing>
      <bpmn:outgoing>F_CA_H2_SelecionarCanal_07</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="SC_T_Capping" name="Aplicar frequency capping e horário silencioso" camunda:delegateExpression="${frequencyCappingService}">
      <bpmn:documentation>Produz envioPermitidoAgora e proximaJanela (batching: "10 novidades" em vez de 10 toques). | Origem: SC_T_Capping</bpmn:documentation>
      <bpmn:incoming>F_CA_H2_SelecionarCanal_07</bpmn:incoming>
      <bpmn:outgoing>F_CA_H2_SelecionarCanal_08</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="SC_GW_Decisao" name="Enviar agora?" default="F_CA_H2_SelecionarCanal_11">
      <bpmn:documentation>Origem: SC_GW_Decisao</bpmn:documentation>
      <bpmn:documentation>Regra: enviar somente dentro da janela permitida; fora dela, agendar para a próxima janela — dono: Agenda e capacidade</bpmn:documentation>
      <bpmn:incoming>F_CA_H2_SelecionarCanal_08</bpmn:incoming>
      <bpmn:outgoing>F_CA_H2_SelecionarCanal_09</bpmn:outgoing>
      <bpmn:outgoing>F_CA_H2_SelecionarCanal_10</bpmn:outgoing>
      <bpmn:outgoing>F_CA_H2_SelecionarCanal_11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="SC_GW_MergeEnviar" name="">
      <bpmn:incoming>F_CA_H2_SelecionarCanal_06</bpmn:incoming>
      <bpmn:incoming>F_CA_H2_SelecionarCanal_09</bpmn:incoming>
      <bpmn:outgoing>F_CA_H2_SelecionarCanal_12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="SC_End_Enviar" name="Enviar">
      <bpmn:documentation>Origem: SC_End_Enviar</bpmn:documentation>
      <bpmn:extensionElements>
        <camunda:executionListener expression="${execution.setVariable('decisaoEnvio', 'ENVIAR')}" event="start"/>
      </bpmn:extensionElements>
      <bpmn:incoming>F_CA_H2_SelecionarCanal_12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="SC_End_Adiar" name="Adiar até a próxima janela">
      <bpmn:documentation>Origem: SC_End_Adiar</bpmn:documentation>
      <bpmn:extensionElements>
        <camunda:executionListener expression="${execution.setVariable('decisaoEnvio', 'ADIAR')}" event="start"/>
      </bpmn:extensionElements>
      <bpmn:incoming>F_CA_H2_SelecionarCanal_10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="SC_End_Suprimir" name="Suprimir (cap atingido / agrupado)">
      <bpmn:documentation>Origem: SC_End_Suprimir</bpmn:documentation>
      <bpmn:extensionElements>
        <camunda:executionListener expression="${execution.setVariable('decisaoEnvio', 'SUPRIMIR')}" event="start"/>
      </bpmn:extensionElements>
      <bpmn:incoming>F_CA_H2_SelecionarCanal_11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_CA_H2_SelecionarCanal_01" sourceRef="SC_Start" targetRef="SC_T_Preferencias"/>
    <bpmn:sequenceFlow id="F_CA_H2_SelecionarCanal_02" sourceRef="SC_T_Preferencias" targetRef="SC_GW_OptIn"/>
    <bpmn:sequenceFlow id="F_CA_H2_SelecionarCanal_03" name="Sim" sourceRef="SC_GW_OptIn" targetRef="SC_T_Canal">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${categoriaPermitida == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_CA_H2_SelecionarCanal_04" name="Não" sourceRef="SC_GW_OptIn" targetRef="SC_End_OptOut"/>
    <bpmn:sequenceFlow id="F_CA_H2_SelecionarCanal_05" sourceRef="SC_T_Canal" targetRef="SC_GW_Critico"/>
    <bpmn:sequenceFlow id="F_CA_H2_SelecionarCanal_06" name="Sim — push + SMS, sem capping" sourceRef="SC_GW_Critico" targetRef="SC_GW_MergeEnviar">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${urgencia == "CRITICA"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_CA_H2_SelecionarCanal_07" name="Não" sourceRef="SC_GW_Critico" targetRef="SC_T_Capping"/>
    <bpmn:sequenceFlow id="F_CA_H2_SelecionarCanal_08" sourceRef="SC_T_Capping" targetRef="SC_GW_Decisao"/>
    <bpmn:sequenceFlow id="F_CA_H2_SelecionarCanal_09" name="Sim" sourceRef="SC_GW_Decisao" targetRef="SC_GW_MergeEnviar">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${envioPermitidoAgora == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_CA_H2_SelecionarCanal_10" name="Não — há janela" sourceRef="SC_GW_Decisao" targetRef="SC_End_Adiar">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${envioPermitidoAgora == false &amp;&amp; proximaJanela != null}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_CA_H2_SelecionarCanal_11" name="Não — suprimir" sourceRef="SC_GW_Decisao" targetRef="SC_End_Suprimir"/>
    <bpmn:sequenceFlow id="F_CA_H2_SelecionarCanal_12" sourceRef="SC_GW_MergeEnviar" targetRef="SC_End_Enviar"/>
    <bpmn:dataStoreReference id="DSR_INS_001_1" name="Central de preferências (preferências de canal e histórico de contato do cliente)" dataStoreRef="DS_INS_001">
      <bpmn:documentation>Insumo INS-001 · Origem: SUB-01 §2.1 Insumo (JIT); SUB-01 §2.1 · coluna Subprocesso genérico; SUB-01 §2.1 · coluna Entrada; CA_0 · SC_T_Preferencias · rótulo; CA_0 · SC_T_Preferencias · documentation ⚠️ AMBIGUIDADE — SUB-01 §2.1 nomeia como Entrada o 'Cadastro/histórico de interações do cliente'; o diagrama nomeia a fonte como 'central de preferências', cuja documentation lista categoria, canal, frequência, horário silencioso e opt-in, sem histórico de interações. Modelado como um único DS (leitura mais sustentada: a atividade que executa a consulta é SC_T_Preferencias). Alternativa: dois DS distintos (central de preferências; cadastro/histórico de interações do cliente).</bpmn:documentation>
    </bpmn:dataStoreReference>
  </bpmn:process>
  <bpmn:process id="Process_CA_H1_IdentidadeConsentimento" name="H1 — Identidade e consentimento" isExecutable="true" camunda:versionTag="3.0.0-arq01" camunda:historyTimeToLive="180">
    <bpmn:documentation>Serviço compartilhado (ARQ-01 §7). Entrada: clienteId, finalidade. Saída: consentimentoValido, identidadeUnificada. Negado → erro LGPD_CONSENT_NEGADO, capturado no chamador. Chamado por C1, S1 e H3-Enriquecer.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_Process_CA_H1_IdentidadeConsentimento">
      <bpmn:lane id="LN_CA0_H1_VerificadorDeIdentidade" name="Verificador de identidade">
        <bpmn:documentation>Dimensão: Staff · Origem: SUB-01 §2.3 (Staff) · Ref: EC_CA_H1, C1_CA_H1, S1_CA_H1</bpmn:documentation>
        <bpmn:flowNodeRef>H1_T_Auditoria</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>H1_End_Negado</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>H1_T_Diagnostico</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>H1_GW_Identidade</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>H1_T_Unificar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>H1_GW_Merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>H1_End_OK</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LN_CA0_H1_DisponibilizacaoDeInsumos" name="Disponibilização de insumos">
        <bpmn:documentation>Dimensão: Insumo JIT · Origem: SUB-01 §2.3 (Insumo) · Ref: EC_CA_H1</bpmn:documentation>
        <bpmn:flowNodeRef>H1_Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>H1_T_Consentimento</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>H1_GW_Consentimento</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="H1_Start" name="Verificação solicitada">
      <bpmn:documentation>Origem: M0_Start</bpmn:documentation>
      <bpmn:outgoing>F_CA_H1_IdentidadeConsentimento_01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="H1_T_Consentimento" name="Consultar consentimento por finalidade" camunda:delegateExpression="${lgpdConsentService}">
      <bpmn:documentation>LGPD art. 8º. Produz consentimentoValido. | Origem: M0_T_ConsultaConsentimento</bpmn:documentation>
      <bpmn:incoming>F_CA_H1_IdentidadeConsentimento_01</bpmn:incoming>
      <bpmn:outgoing>F_CA_H1_IdentidadeConsentimento_02</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="H1_GW_Consentimento" name="Consentimento válido?" default="F_CA_H1_IdentidadeConsentimento_04">
      <bpmn:documentation>Origem: M0_GW_Consentimento</bpmn:documentation>
      <bpmn:documentation>Regra: sem consentimento válido para a finalidade, não usar o dado e registrar a tentativa negada — dono: Disponibilização de insumos</bpmn:documentation>
      <bpmn:incoming>F_CA_H1_IdentidadeConsentimento_02</bpmn:incoming>
      <bpmn:outgoing>F_CA_H1_IdentidadeConsentimento_03</bpmn:outgoing>
      <bpmn:outgoing>F_CA_H1_IdentidadeConsentimento_04</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="H1_T_Auditoria" name="Registrar tentativa negada" camunda:delegateExpression="${lgpdAuditService}">
      <bpmn:documentation>Origem: M0_T_Auditoria</bpmn:documentation>
      <bpmn:incoming>F_CA_H1_IdentidadeConsentimento_04</bpmn:incoming>
      <bpmn:outgoing>F_CA_H1_IdentidadeConsentimento_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="H1_End_Negado" name="Consentimento negado">
      <bpmn:documentation>Origem: M0_End_Negado</bpmn:documentation>
      <bpmn:incoming>F_CA_H1_IdentidadeConsentimento_05</bpmn:incoming>
      <bpmn:errorEventDefinition errorRef="Error_CA_ConsentimentoNegado"/>
    </bpmn:endEvent>
    <bpmn:serviceTask id="H1_T_Diagnostico" name="Avaliar completude do perfil e identidade" camunda:delegateExpression="${profileAssessmentService}">
      <bpmn:documentation>Produz identidadeUnificada e perfilSuficiente. | Origem: EC_T_Diagnostico</bpmn:documentation>
      <bpmn:incoming>F_CA_H1_IdentidadeConsentimento_03</bpmn:incoming>
      <bpmn:outgoing>F_CA_H1_IdentidadeConsentimento_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="H1_GW_Identidade" name="Identidade digital já unificada?" default="F_CA_H1_IdentidadeConsentimento_08">
      <bpmn:documentation>Origem: M1_GW_Perfil</bpmn:documentation>
      <bpmn:documentation>Regra: identidade já unificada segue direto; caso contrário, executar a unificação — dono: Verificador de identidade</bpmn:documentation>
      <bpmn:incoming>F_CA_H1_IdentidadeConsentimento_06</bpmn:incoming>
      <bpmn:outgoing>F_CA_H1_IdentidadeConsentimento_07</bpmn:outgoing>
      <bpmn:outgoing>F_CA_H1_IdentidadeConsentimento_08</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="H1_T_Unificar" name="Unificar identidade digital" camunda:asyncBefore="true" camunda:delegateExpression="${identityResolutionService}">
      <bpmn:documentation>Origem: M1_T_Unificar</bpmn:documentation>
      <bpmn:incoming>F_CA_H1_IdentidadeConsentimento_08</bpmn:incoming>
      <bpmn:outgoing>F_CA_H1_IdentidadeConsentimento_09</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="H1_GW_Merge" name="">
      <bpmn:documentation>Origem: EC_GW_Merge</bpmn:documentation>
      <bpmn:incoming>F_CA_H1_IdentidadeConsentimento_07</bpmn:incoming>
      <bpmn:incoming>F_CA_H1_IdentidadeConsentimento_09</bpmn:incoming>
      <bpmn:outgoing>F_CA_H1_IdentidadeConsentimento_10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="H1_End_OK" name="Cliente identificado e autorizado">
      <bpmn:documentation>Origem: M0_End_OK</bpmn:documentation>
      <bpmn:incoming>F_CA_H1_IdentidadeConsentimento_10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_CA_H1_IdentidadeConsentimento_01" sourceRef="H1_Start" targetRef="H1_T_Consentimento"/>
    <bpmn:sequenceFlow id="F_CA_H1_IdentidadeConsentimento_02" sourceRef="H1_T_Consentimento" targetRef="H1_GW_Consentimento"/>
    <bpmn:sequenceFlow id="F_CA_H1_IdentidadeConsentimento_03" name="Sim" sourceRef="H1_GW_Consentimento" targetRef="H1_T_Diagnostico">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${consentimentoValido == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_CA_H1_IdentidadeConsentimento_04" name="Não / expirado" sourceRef="H1_GW_Consentimento" targetRef="H1_T_Auditoria"/>
    <bpmn:sequenceFlow id="F_CA_H1_IdentidadeConsentimento_05" sourceRef="H1_T_Auditoria" targetRef="H1_End_Negado"/>
    <bpmn:sequenceFlow id="F_CA_H1_IdentidadeConsentimento_06" sourceRef="H1_T_Diagnostico" targetRef="H1_GW_Identidade"/>
    <bpmn:sequenceFlow id="F_CA_H1_IdentidadeConsentimento_07" name="Sim" sourceRef="H1_GW_Identidade" targetRef="H1_GW_Merge">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${identidadeUnificada == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_CA_H1_IdentidadeConsentimento_08" name="Não — unificar" sourceRef="H1_GW_Identidade" targetRef="H1_T_Unificar"/>
    <bpmn:sequenceFlow id="F_CA_H1_IdentidadeConsentimento_09" sourceRef="H1_T_Unificar" targetRef="H1_GW_Merge"/>
    <bpmn:sequenceFlow id="F_CA_H1_IdentidadeConsentimento_10" sourceRef="H1_GW_Merge" targetRef="H1_End_OK"/>
  </bpmn:process>
  <bpmn:process id="Process_CA_H3_ConhecerCliente" name="H3 — Conhecer o cliente e aprender" isExecutable="true" camunda:versionTag="3.0.0-arq01" camunda:historyTimeToLive="180">
    <bpmn:documentation>Serviço compartilhado, rotina interna sem cliente na entrada (ARQ-01 §7). Trilha A: lote diário de enriquecimento + retreino com gate de métricas. Trilha C: ingestão dos eventos de negócio de COMPRA, UTILIZAÇÃO e SUPORTE (fecha os loops de aprendizado). Perfil publicado NÃO gera mensagem ao cliente (corrige I-06).</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_Process_CA_H3_ConhecerCliente">
      <bpmn:lane id="LN_CA0_H3_DadosECrm" name="Dados e CRM (consolidação de perfil)">
        <bpmn:documentation>Dimensão: Staff · Origem: SUB-01 §2.2 (Staff) · Ref: H3_CA_Lote</bpmn:documentation>
        <bpmn:flowNodeRef>H3_CA_Lote</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>H3_Start_Evento</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>H3_T_Registrar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>H3_GW_Nutrir</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>H3_EV_Recomendar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>H3_GW_MergeEvt</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>H3_End_Evento</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LN_CA0_H3_ModelagemEGrowth" name="Modelagem e growth (motor de recomendação)">
        <bpmn:documentation>Dimensão: Staff · Origem: rótulo dos elementos de retreino, promoção e alerta do modelo; SUB-01 §2.10 (Staff) · Ref: C1_CA_NBA</bpmn:documentation>
        <bpmn:flowNodeRef>H3_T_Retreinar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>H3_GW_Modelo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>H3_T_Promover</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>H3_End_Pipeline</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>H3_EV_AlertaDS</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>H3_End_ModeloRetido</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LN_CA0_H3_DisponibilizacaoDeInsumos" name="Disponibilização de insumos">
        <bpmn:documentation>Dimensão: Insumo JIT · Origem: SUB-01 §2.2 (Insumo) · Ref: H3_CA_Lote</bpmn:documentation>
        <bpmn:flowNodeRef>H3_Start_Ciclo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>H3_T_Lote</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="H3_Start_Ciclo" name="Ciclo diário de enriquecimento (03:00)">
      <bpmn:documentation>Origem: M1_Start_Ciclo</bpmn:documentation>
      <bpmn:outgoing>F_CA_H3_ConhecerCliente_01</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">0 0 3 * * ?</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:serviceTask id="H3_T_Lote" name="Selecionar lote de clientes elegíveis" camunda:asyncBefore="true" camunda:delegateExpression="${enrichmentBatchSelector}">
      <bpmn:documentation>Produz clientesLote. Lista vazia → multi-instância completa imediatamente. | Origem: M1_T_SelecionarLote</bpmn:documentation>
      <bpmn:incoming>F_CA_H3_ConhecerCliente_01</bpmn:incoming>
      <bpmn:outgoing>F_CA_H3_ConhecerCliente_02</bpmn:outgoing>
      <bpmn:property id="Property_H3_T_Lote_targetRef" name="__targetRef_placeholder"/>
      <bpmn:dataInputAssociation id="DIA_INS_002_1">
        <bpmn:sourceRef>DSR_INS_002_1</bpmn:sourceRef>
        <bpmn:targetRef>Property_H3_T_Lote_targetRef</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="DOA_INS_003_1">
        <bpmn:targetRef>DOR_INS_003_1</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:callActivity id="H3_CA_Lote" name="Enriquecer clientes do lote" camunda:asyncBefore="true" calledElement="Process_CA_H3_EnriquecerCliente">
      <bpmn:documentation>Origem: M1_CA_EnriquecerLote</bpmn:documentation>
      <bpmn:documentation>Contrato de variáveis a confirmar com a equipe: este passo pode produzir/consumir variáveis em execução (delegados/formulários) não declaradas no modelo; a lista explícita reflete o que o próprio modelo comprova.</bpmn:documentation>
      <bpmn:extensionElements>
        <camunda:in businessKey="#{execution.processBusinessKey}"/>
      </bpmn:extensionElements>
      <bpmn:incoming>F_CA_H3_ConhecerCliente_02</bpmn:incoming>
      <bpmn:outgoing>F_CA_H3_ConhecerCliente_03</bpmn:outgoing>
      <bpmn:property id="Property_H3_CA_Lote_targetRef" name="__targetRef_placeholder"/>
      <bpmn:dataInputAssociation id="DIA_INS_003_2">
        <bpmn:sourceRef>DOR_INS_003_1</bpmn:sourceRef>
        <bpmn:targetRef>Property_H3_CA_Lote_targetRef</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:multiInstanceLoopCharacteristics camunda:asyncBefore="true" camunda:collection="clientesLote" camunda:elementVariable="clienteId"/>
    </bpmn:callActivity>
    <bpmn:serviceTask id="H3_T_Retreinar" name="Retreinar modelo de recomendação" camunda:asyncBefore="true" camunda:class="br.amh.ced.m1.DataScienceTrainingJob">
      <bpmn:documentation>Uma vez por lote. Produz metricasModeloOK (precision@k, adesão prevista). | Origem: M1_T_Training</bpmn:documentation>
      <bpmn:incoming>F_CA_H3_ConhecerCliente_03</bpmn:incoming>
      <bpmn:outgoing>F_CA_H3_ConhecerCliente_04</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="H3_GW_Modelo" name="Modelo atingiu métricas mínimas?" default="F_CA_H3_ConhecerCliente_06">
      <bpmn:documentation>Origem: M1_GW_ModeloOK</bpmn:documentation>
      <bpmn:documentation>Regra: promover modelo somente com métricas mínimas atingidas; caso contrário, manter o modelo anterior — dono: Modelagem e growth (motor de recomendação)</bpmn:documentation>
      <bpmn:incoming>F_CA_H3_ConhecerCliente_04</bpmn:incoming>
      <bpmn:outgoing>F_CA_H3_ConhecerCliente_05</bpmn:outgoing>
      <bpmn:outgoing>F_CA_H3_ConhecerCliente_06</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="H3_T_Promover" name="Promover modelo ao registro de produção" camunda:asyncBefore="true" camunda:delegateExpression="${modelRegistryService}">
      <bpmn:documentation>Origem: M1_T_PromoverModelo</bpmn:documentation>
      <bpmn:incoming>F_CA_H3_ConhecerCliente_05</bpmn:incoming>
      <bpmn:outgoing>F_CA_H3_ConhecerCliente_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="H3_End_Pipeline" name="Pipeline diário concluído">
      <bpmn:documentation>Origem: M1_End_Pipeline</bpmn:documentation>
      <bpmn:incoming>F_CA_H3_ConhecerCliente_07</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateThrowEvent id="H3_EV_AlertaDS" name="Alertar cientistas de dados">
      <bpmn:documentation>Consumido por tooling externo do time de Data Science. | Origem: M1_EV_AlertaDS</bpmn:documentation>
      <bpmn:documentation>Sinal "Alerta Time Data Science" é consumido pelo monitoramento do time de Ciência de Dados, fora do conjunto de processos modelado. Contrato de payload: a definir pelo time de Ciência de Dados.</bpmn:documentation>
      <bpmn:documentation>Marco factual: registra o que ACONTECEU (evento de negócio consumido), não estimativa nem previsão.</bpmn:documentation>
      <bpmn:incoming>F_CA_H3_ConhecerCliente_06</bpmn:incoming>
      <bpmn:outgoing>F_CA_H3_ConhecerCliente_08</bpmn:outgoing>
      <bpmn:signalEventDefinition signalRef="Signal_CA_AlertaDS"/>
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="H3_End_ModeloRetido" name="Modelo anterior mantido">
      <bpmn:documentation>Origem: M1_End_ModeloRetido</bpmn:documentation>
      <bpmn:incoming>F_CA_H3_ConhecerCliente_08</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="H3_Start_Evento" name="Evento de negócio recebido">
      <bpmn:documentation>tipoEventoNegocio ∈ {SERVICO_ENTREGUE, VENDA_PERDIDA, FILA_NUTRICAO, PERFIL_INICIAL, APRENDIZADO_INTERACAO}. | Origem: M1_Start_ServicoEntregue + M1_Start_VendaPerdida + M1_Start_FilaNutricao + M1_Start_Aprendizado</bpmn:documentation>
      <bpmn:outgoing>F_CA_H3_ConhecerCliente_09</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_CA_EventoNegocio"/>
    </bpmn:startEvent>
    <bpmn:serviceTask id="H3_T_Registrar" name="Registrar evento de negócio no perfil 360" camunda:asyncBefore="true" camunda:delegateExpression="${businessEventIngestionService}">
      <bpmn:documentation>Desfecho (reward), motivo de perda/cancelamento, nutrição de conteúdo, aprendizado da IA. | Origem: M1_T_RegistrarEvento</bpmn:documentation>
      <bpmn:incoming>F_CA_H3_ConhecerCliente_09</bpmn:incoming>
      <bpmn:outgoing>F_CA_H3_ConhecerCliente_10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="H3_GW_Nutrir" name="Nutrir o cliente com conteúdo?" default="F_CA_H3_ConhecerCliente_12">
      <bpmn:documentation>Necessidade sem proposta vira recomendação/informação de valor via H2. | Origem: M2_End_SemProposta → M1_Start_FilaNutricao / M3_Start_Perfil</bpmn:documentation>
      <bpmn:documentation>Regra: somente eventos de fila de nutrição entram no fluxo de conteúdo; demais apenas enriquecem o perfil — dono: Dados e CRM (consolidação de perfil)</bpmn:documentation>
      <bpmn:incoming>F_CA_H3_ConhecerCliente_10</bpmn:incoming>
      <bpmn:outgoing>F_CA_H3_ConhecerCliente_11</bpmn:outgoing>
      <bpmn:outgoing>F_CA_H3_ConhecerCliente_12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateThrowEvent id="H3_EV_Recomendar" name="Enviar recomendação de valor ao cliente">
      <bpmn:documentation>"Seu plano cobre X". Se o cliente reagir, começa COMPRA (EV-C02). | Origem: M1_End_Recomendado → M3_Start_Recomendacao</bpmn:documentation>
      <bpmn:documentation>Marco factual: registra o que ACONTECEU (evento de negócio consumido), não estimativa nem previsão.</bpmn:documentation>
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="marcoJornada">RECOMENDACAO</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>F_CA_H3_ConhecerCliente_11</bpmn:incoming>
      <bpmn:outgoing>F_CA_H3_ConhecerCliente_13</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_CA_ComunicarCliente" camunda:delegateExpression="${comunicarClientePublisher}"/>
    </bpmn:intermediateThrowEvent>
    <bpmn:exclusiveGateway id="H3_GW_MergeEvt" name="">
      <bpmn:incoming>F_CA_H3_ConhecerCliente_12</bpmn:incoming>
      <bpmn:incoming>F_CA_H3_ConhecerCliente_13</bpmn:incoming>
      <bpmn:outgoing>F_CA_H3_ConhecerCliente_14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="H3_End_Evento" name="Evento incorporado ao perfil 360">
      <bpmn:documentation>Origem: M1_End_EventoRegistrado</bpmn:documentation>
      <bpmn:incoming>F_CA_H3_ConhecerCliente_14</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_CA_H3_ConhecerCliente_01" sourceRef="H3_Start_Ciclo" targetRef="H3_T_Lote"/>
    <bpmn:sequenceFlow id="F_CA_H3_ConhecerCliente_02" sourceRef="H3_T_Lote" targetRef="H3_CA_Lote"/>
    <bpmn:sequenceFlow id="F_CA_H3_ConhecerCliente_03" sourceRef="H3_CA_Lote" targetRef="H3_T_Retreinar"/>
    <bpmn:sequenceFlow id="F_CA_H3_ConhecerCliente_04" sourceRef="H3_T_Retreinar" targetRef="H3_GW_Modelo"/>
    <bpmn:sequenceFlow id="F_CA_H3_ConhecerCliente_05" name="Sim — aprovado" sourceRef="H3_GW_Modelo" targetRef="H3_T_Promover">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${metricasModeloOK == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_CA_H3_ConhecerCliente_06" name="Não — abaixo da meta" sourceRef="H3_GW_Modelo" targetRef="H3_EV_AlertaDS"/>
    <bpmn:sequenceFlow id="F_CA_H3_ConhecerCliente_07" sourceRef="H3_T_Promover" targetRef="H3_End_Pipeline"/>
    <bpmn:sequenceFlow id="F_CA_H3_ConhecerCliente_08" sourceRef="H3_EV_AlertaDS" targetRef="H3_End_ModeloRetido"/>
    <bpmn:sequenceFlow id="F_CA_H3_ConhecerCliente_09" sourceRef="H3_Start_Evento" targetRef="H3_T_Registrar"/>
    <bpmn:sequenceFlow id="F_CA_H3_ConhecerCliente_10" sourceRef="H3_T_Registrar" targetRef="H3_GW_Nutrir"/>
    <bpmn:sequenceFlow id="F_CA_H3_ConhecerCliente_11" name="Sim" sourceRef="H3_GW_Nutrir" targetRef="H3_EV_Recomendar">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${tipoEventoNegocio == "FILA_NUTRICAO"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_CA_H3_ConhecerCliente_12" name="Não" sourceRef="H3_GW_Nutrir" targetRef="H3_GW_MergeEvt"/>
    <bpmn:sequenceFlow id="F_CA_H3_ConhecerCliente_13" sourceRef="H3_EV_Recomendar" targetRef="H3_GW_MergeEvt"/>
    <bpmn:sequenceFlow id="F_CA_H3_ConhecerCliente_14" sourceRef="H3_GW_MergeEvt" targetRef="H3_End_Evento"/>
    <bpmn:dataStoreReference id="DSR_INS_002_1" name="Base de clientes elegíveis" dataStoreRef="DS_INS_002">
      <bpmn:documentation>Insumo INS-002 · Origem: SUB-01 §2.2 Insumo (JIT); SUB-01 §2.2 · coluna Entrada; SUB-01 §2.2 · coluna Subprocesso genérico; CA_0 · H3_T_Lote · rótulo</bpmn:documentation>
    </bpmn:dataStoreReference>
    <bpmn:dataObject id="DO_INS_003_1" name="Lote de clientes a enriquecer">
      <bpmn:documentation>Insumo INS-003 · Origem: SUB-01 §2.2 Insumo (JIT); SUB-01 §2.2 · coluna Saída; CA_0 · H3_T_Lote · documentation</bpmn:documentation>
    </bpmn:dataObject>
    <bpmn:dataObjectReference id="DOR_INS_003_1" name="Lote de clientes a enriquecer" dataObjectRef="DO_INS_003_1">
      <bpmn:documentation>Insumo INS-003 · Origem: SUB-01 §2.2 Insumo (JIT); SUB-01 §2.2 · coluna Saída; CA_0 · H3_T_Lote · documentation</bpmn:documentation>
    </bpmn:dataObjectReference>
    <bpmn:textAnnotation id="TextAnnotation_AlertaDSExterno">
      <bpmn:text>Consumo externo: monitoramento do time de Ciência de Dados (fora do conjunto modelado). Payload a definir pelo time.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_AlertaDSExterno" associationDirection="None" sourceRef="H3_EV_AlertaDS" targetRef="TextAnnotation_AlertaDSExterno"/>
  </bpmn:process>
  <bpmn:process id="Process_CA_H3_EnriquecerCliente" name="H3.1 — Enriquecer perfil 360 do cliente" isExecutable="true" camunda:versionTag="3.0.0-arq01" camunda:historyTimeToLive="180">
    <bpmn:documentation>Uma instância por cliente. Consentimento e identidade (H1) antes de qualquer coleta; fan-out paralelo de fontes. Chamado pelo lote diário (H3) e por C3 (novo beneficiário).</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_Process_CA_H3_EnriquecerCliente">
      <bpmn:lane id="LN_CA0_H31_VerificadorDeIdentidade" name="Verificador de identidade">
        <bpmn:documentation>Dimensão: Staff · Origem: SUB-01 §2.3 (Staff) · Ref: EC_CA_H1</bpmn:documentation>
        <bpmn:flowNodeRef>EC_Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EC_CA_H1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EC_B_Negado</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EC_End_Negado</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EC_GW_Split</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LN_CA0_H31_DadosECrm" name="Dados e CRM (consolidação de perfil)">
        <bpmn:documentation>Dimensão: Staff · Origem: SUB-01 §2.11 (Staff) · Ref: H3_CA_Lote, C3_CA_Perfil</bpmn:documentation>
        <bpmn:flowNodeRef>EC_T_Consolidar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EC_End</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LN_CA0_H31_DisponibilizacaoDeInsumos" name="Disponibilização de insumos">
        <bpmn:documentation>Dimensão: Insumo JIT · Origem: SUB-01 §2.11 (Insumo) · Ref: H3_CA_Lote, C3_CA_Perfil</bpmn:documentation>
        <bpmn:flowNodeRef>EC_T_Abertos</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EC_T_Uso</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EC_T_Digitais</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EC_T_Clinicos</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EC_T_Pesquisas</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EC_GW_Join</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="EC_Start" name="Cliente a enriquecer">
      <bpmn:documentation>Origem: EC_Start</bpmn:documentation>
      <bpmn:outgoing>F_CA_H3_EnriquecerCliente_01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:callActivity id="EC_CA_H1" name="Verificar identidade e consentimento" camunda:asyncBefore="true" calledElement="Process_CA_H1_IdentidadeConsentimento">
      <bpmn:documentation>Base legal por fonte mapeada no registro de tratamento (LGPD art. 37). | Origem: M1_CA_Consentimento</bpmn:documentation>
      <bpmn:documentation>Contrato de variáveis a confirmar com a equipe: este passo pode produzir/consumir variáveis em execução (delegados/formulários) não declaradas no modelo; a lista explícita reflete o que o próprio modelo comprova.</bpmn:documentation>
      <bpmn:extensionElements>
        <camunda:in businessKey="#{execution.processBusinessKey}"/>
        <camunda:in sourceExpression="enriquecimento" target="finalidade"/>
        <camunda:out source="consentimentoValido" target="consentimentoValido"/>
        <camunda:out source="identidadeUnificada" target="identidadeUnificada"/>
      </bpmn:extensionElements>
      <bpmn:incoming>F_CA_H3_EnriquecerCliente_01</bpmn:incoming>
      <bpmn:outgoing>F_CA_H3_EnriquecerCliente_02</bpmn:outgoing>
      <bpmn:property id="Property_EC_CA_H1_targetRef" name="__targetRef_placeholder"/>
      <bpmn:dataInputAssociation id="DIA_INS_004_1">
        <bpmn:sourceRef>DOR_INS_004_1</bpmn:sourceRef>
        <bpmn:targetRef>Property_EC_CA_H1_targetRef</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:callActivity>
    <bpmn:boundaryEvent id="EC_B_Negado" name="Consentimento negado" attachedToRef="EC_CA_H1">
      <bpmn:documentation>Origem: M1_Boundary_Negado</bpmn:documentation>
      <bpmn:outgoing>F_CA_H3_EnriquecerCliente_03</bpmn:outgoing>
      <bpmn:errorEventDefinition errorRef="Error_CA_ConsentimentoNegado"/>
    </bpmn:boundaryEvent>
    <bpmn:endEvent id="EC_End_Negado" name="Encerrado sem consentimento">
      <bpmn:documentation>Origem: M1_End_Negado</bpmn:documentation>
      <bpmn:incoming>F_CA_H3_EnriquecerCliente_03</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:parallelGateway id="EC_GW_Split" name="">
      <bpmn:documentation>Origem: M1_GW_Split</bpmn:documentation>
      <bpmn:incoming>F_CA_H3_EnriquecerCliente_02</bpmn:incoming>
      <bpmn:outgoing>F_CA_H3_EnriquecerCliente_04</bpmn:outgoing>
      <bpmn:outgoing>F_CA_H3_EnriquecerCliente_06</bpmn:outgoing>
      <bpmn:outgoing>F_CA_H3_EnriquecerCliente_08</bpmn:outgoing>
      <bpmn:outgoing>F_CA_H3_EnriquecerCliente_10</bpmn:outgoing>
      <bpmn:outgoing>F_CA_H3_EnriquecerCliente_12</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="EC_T_Abertos" name="Extrair dados abertos (DATASUS, ANS)" camunda:asyncBefore="true" camunda:delegateExpression="${openDataEnrichmentService}">
      <bpmn:documentation>Origem: M1_T_DadosAbertos</bpmn:documentation>
      <bpmn:incoming>F_CA_H3_EnriquecerCliente_04</bpmn:incoming>
      <bpmn:outgoing>F_CA_H3_EnriquecerCliente_05</bpmn:outgoing>
      <bpmn:property id="Property_EC_T_Abertos_targetRef" name="__targetRef_placeholder"/>
      <bpmn:dataInputAssociation id="DIA_INS_017_1">
        <bpmn:sourceRef>DSR_INS_017_1</bpmn:sourceRef>
        <bpmn:targetRef>Property_EC_T_Abertos_targetRef</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="EC_T_Uso" name="Coletar histórico de uso do plano" camunda:asyncBefore="true" camunda:delegateExpression="${planUsageCollector}">
      <bpmn:documentation>Origem: M1_T_HistoricoUso (boundary órfão Event_1mpy3m2 eliminado — I-02)</bpmn:documentation>
      <bpmn:incoming>F_CA_H3_EnriquecerCliente_06</bpmn:incoming>
      <bpmn:outgoing>F_CA_H3_EnriquecerCliente_07</bpmn:outgoing>
      <bpmn:property id="Property_EC_T_Uso_targetRef" name="__targetRef_placeholder"/>
      <bpmn:dataInputAssociation id="DIA_INS_018_1">
        <bpmn:sourceRef>DSR_INS_018_1</bpmn:sourceRef>
        <bpmn:targetRef>Property_EC_T_Uso_targetRef</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="EC_T_Digitais" name="Capturar sinais digitais próprios" camunda:asyncBefore="true" camunda:delegateExpression="${digitalSignalCollector}">
      <bpmn:documentation>Somente eventos de sessão próprios sob base legal mapeada; nunca cookies de terceiros. | Origem: M1_T_SinaisDigitais</bpmn:documentation>
      <bpmn:incoming>F_CA_H3_EnriquecerCliente_08</bpmn:incoming>
      <bpmn:outgoing>F_CA_H3_EnriquecerCliente_09</bpmn:outgoing>
      <bpmn:property id="Property_EC_T_Digitais_targetRef" name="__targetRef_placeholder"/>
      <bpmn:dataInputAssociation id="DIA_INS_019_1">
        <bpmn:sourceRef>DOR_INS_019_1</bpmn:sourceRef>
        <bpmn:targetRef>Property_EC_T_Digitais_targetRef</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="EC_T_Clinicos" name="Ingerir dados clínicos (HL7 FHIR)" camunda:asyncBefore="true" camunda:delegateExpression="${clinicalDataIngestion}">
      <bpmn:documentation>Origem: M1_T_DadosClinicos (boundary órfão Event_0ifnjgf eliminado — I-02)</bpmn:documentation>
      <bpmn:incoming>F_CA_H3_EnriquecerCliente_10</bpmn:incoming>
      <bpmn:outgoing>F_CA_H3_EnriquecerCliente_11</bpmn:outgoing>
      <bpmn:property id="Property_EC_T_Clinicos_targetRef" name="__targetRef_placeholder"/>
      <bpmn:dataInputAssociation id="DIA_INS_020_1">
        <bpmn:sourceRef>DOR_INS_020_1</bpmn:sourceRef>
        <bpmn:targetRef>Property_EC_T_Clinicos_targetRef</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="EC_T_Pesquisas" name="Coletar pesquisas já respondidas" camunda:delegateExpression="${surveyResponseCollector}">
      <bpmn:documentation>Lê o repositório das pesquisas coletadas em U4. | Origem: M1_T_Pesquisa</bpmn:documentation>
      <bpmn:incoming>F_CA_H3_EnriquecerCliente_12</bpmn:incoming>
      <bpmn:outgoing>F_CA_H3_EnriquecerCliente_13</bpmn:outgoing>
      <bpmn:property id="Property_EC_T_Pesquisas_targetRef" name="__targetRef_placeholder"/>
      <bpmn:dataInputAssociation id="DIA_INS_021_1">
        <bpmn:sourceRef>DSR_INS_021_1</bpmn:sourceRef>
        <bpmn:targetRef>Property_EC_T_Pesquisas_targetRef</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="EC_GW_Join" name="">
      <bpmn:documentation>Origem: M1_GW_Join</bpmn:documentation>
      <bpmn:incoming>F_CA_H3_EnriquecerCliente_05</bpmn:incoming>
      <bpmn:incoming>F_CA_H3_EnriquecerCliente_07</bpmn:incoming>
      <bpmn:incoming>F_CA_H3_EnriquecerCliente_09</bpmn:incoming>
      <bpmn:incoming>F_CA_H3_EnriquecerCliente_11</bpmn:incoming>
      <bpmn:incoming>F_CA_H3_EnriquecerCliente_13</bpmn:incoming>
      <bpmn:outgoing>F_CA_H3_EnriquecerCliente_14</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="EC_T_Consolidar" name="Consolidar e versionar perfil 360" camunda:asyncBefore="true" camunda:delegateExpression="${profileConsolidationService}">
      <bpmn:documentation>Produz versaoPerfil. | Origem: M1_T_Consolidar</bpmn:documentation>
      <bpmn:incoming>F_CA_H3_EnriquecerCliente_14</bpmn:incoming>
      <bpmn:outgoing>F_CA_H3_EnriquecerCliente_15</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DOA_INS_012_2">
        <bpmn:targetRef>DSR_INS_012_2</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EC_End" name="Perfil 360 publicado">
      <bpmn:documentation>Origem: M1_End_Enriquecido (sem disparo a H2 — I-06)</bpmn:documentation>
      <bpmn:incoming>F_CA_H3_EnriquecerCliente_15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_CA_H3_EnriquecerCliente_01" sourceRef="EC_Start" targetRef="EC_CA_H1"/>
    <bpmn:sequenceFlow id="F_CA_H3_EnriquecerCliente_02" sourceRef="EC_CA_H1" targetRef="EC_GW_Split"/>
    <bpmn:sequenceFlow id="F_CA_H3_EnriquecerCliente_03" sourceRef="EC_B_Negado" targetRef="EC_End_Negado"/>
    <bpmn:sequenceFlow id="F_CA_H3_EnriquecerCliente_04" sourceRef="EC_GW_Split" targetRef="EC_T_Abertos"/>
    <bpmn:sequenceFlow id="F_CA_H3_EnriquecerCliente_05" sourceRef="EC_T_Abertos" targetRef="EC_GW_Join"/>
    <bpmn:sequenceFlow id="F_CA_H3_EnriquecerCliente_06" sourceRef="EC_GW_Split" targetRef="EC_T_Uso"/>
    <bpmn:sequenceFlow id="F_CA_H3_EnriquecerCliente_07" sourceRef="EC_T_Uso" targetRef="EC_GW_Join"/>
    <bpmn:sequenceFlow id="F_CA_H3_EnriquecerCliente_08" sourceRef="EC_GW_Split" targetRef="EC_T_Digitais"/>
    <bpmn:sequenceFlow id="F_CA_H3_EnriquecerCliente_09" sourceRef="EC_T_Digitais" targetRef="EC_GW_Join"/>
    <bpmn:sequenceFlow id="F_CA_H3_EnriquecerCliente_10" sourceRef="EC_GW_Split" targetRef="EC_T_Clinicos"/>
    <bpmn:sequenceFlow id="F_CA_H3_EnriquecerCliente_11" sourceRef="EC_T_Clinicos" targetRef="EC_GW_Join"/>
    <bpmn:sequenceFlow id="F_CA_H3_EnriquecerCliente_12" sourceRef="EC_GW_Split" targetRef="EC_T_Pesquisas"/>
    <bpmn:sequenceFlow id="F_CA_H3_EnriquecerCliente_13" sourceRef="EC_T_Pesquisas" targetRef="EC_GW_Join"/>
    <bpmn:sequenceFlow id="F_CA_H3_EnriquecerCliente_14" sourceRef="EC_GW_Join" targetRef="EC_T_Consolidar"/>
    <bpmn:sequenceFlow id="F_CA_H3_EnriquecerCliente_15" sourceRef="EC_T_Consolidar" targetRef="EC_End"/>
    <bpmn:dataObject id="DO_INS_004_1" name="Dados de identificação do cliente (dado cadastral/documento de identificação)">
      <bpmn:documentation>Insumo INS-004 · Origem: SUB-01 §2.3, §2.9, §2.22 Insumo (JIT); §3; SUB-01 §2.3 · coluna Subprocesso genérico; SUB-01 §2.3 · coluna Entrada; SUB-01 §2.9 · coluna Observação; SUB-01 §2.22 · coluna Observação; SUB-01 §3 · coluna Caixas de origem</bpmn:documentation>
    </bpmn:dataObject>
    <bpmn:dataObjectReference id="DOR_INS_004_1" name="Dados de identificação do cliente (dado cadastral/documento de identificação)" dataObjectRef="DO_INS_004_1">
      <bpmn:documentation>Insumo INS-004 · Origem: SUB-01 §2.3, §2.9, §2.22 Insumo (JIT); §3; SUB-01 §2.3 · coluna Subprocesso genérico; SUB-01 §2.3 · coluna Entrada; SUB-01 §2.9 · coluna Observação; SUB-01 §2.22 · coluna Observação; SUB-01 §3 · coluna Caixas de origem</bpmn:documentation>
    </bpmn:dataObjectReference>
    <bpmn:dataStoreReference id="DSR_INS_012_2" name="Perfil 360 do cliente" dataStoreRef="DS_INS_012">
      <bpmn:documentation>Insumo INS-012 · Origem: SUB-01 §2.10 e §2.11 Insumo (JIT); SUB-01 §2.10 · coluna Entrada; SUB-01 §2.11 · coluna Saída; CA_0 · NBA_T_Contexto · rótulo; CA_0 · EC_T_Consolidar · rótulo; CA_0 · EC_T_Consolidar · documentation; CA_1 · C1_T_Cruzar · rótulo; CA_3 · S1_T_Contexto · rótulo ⚠️ AMBIGUIDADE — SUB-01 nomeia 'Perfil do cliente' (§2.10) e 'Perfil 360 inicial consolidado' (§2.11) sem declará-los idênticos; a identidade como um único repositório vem dos rótulos do diagrama ('perfil 360' em NBA_T_Contexto, EC_T_Consolidar, C1_T_Cruzar e '360' em S1_T_Contexto). A saída em EC_T_Consolidar usa 'Produz versaoPerfil' + rótulo 'versionar perfil 360'. Alternativa: DS separados por arquivo/finalidade.</bpmn:documentation>
    </bpmn:dataStoreReference>
    <bpmn:dataStoreReference id="DSR_INS_017_1" name="Dados abertos (DATASUS, ANS)" dataStoreRef="DS_INS_017">
      <bpmn:documentation>Insumo INS-017 · Origem: SUB-01 §2.11 Insumo (JIT) — fonte externa; SUB-01 §2.11 · coluna Subprocesso genérico; CA_0 · EC_T_Abertos · rótulo</bpmn:documentation>
    </bpmn:dataStoreReference>
    <bpmn:dataStoreReference id="DSR_INS_018_1" name="Histórico de uso do plano" dataStoreRef="DS_INS_018">
      <bpmn:documentation>Insumo INS-018 · Origem: SUB-01 §2.11 Insumo (JIT) — fonte interna; SUB-01 §2.11 · coluna Subprocesso genérico; CA_0 · EC_T_Uso · rótulo</bpmn:documentation>
    </bpmn:dataStoreReference>
    <bpmn:dataObject id="DO_INS_019_1" name="Sinais digitais próprios">
      <bpmn:documentation>Insumo INS-019 · Origem: SUB-01 §2.11 Insumo (JIT) — fonte interna; SUB-01 §2.11 · coluna Subprocesso genérico; CA_0 · EC_T_Digitais · rótulo; CA_0 · EC_T_Digitais · documentation ⚠️ AMBIGUIDADE — Natureza DS × DO dúbia: o rótulo nomeia o dado ('sinais digitais próprios', 'eventos de sessão próprios'), não o repositório de onde é capturado. Modelado como DO (dado capturado na execução); alternativa: DS, se houver repositório de eventos de sessão — não nomeado na origem.</bpmn:documentation>
    </bpmn:dataObject>
    <bpmn:dataObjectReference id="DOR_INS_019_1" name="Sinais digitais próprios" dataObjectRef="DO_INS_019_1">
      <bpmn:documentation>Insumo INS-019 · Origem: SUB-01 §2.11 Insumo (JIT) — fonte interna; SUB-01 §2.11 · coluna Subprocesso genérico; CA_0 · EC_T_Digitais · rótulo; CA_0 · EC_T_Digitais · documentation ⚠️ AMBIGUIDADE — Natureza DS × DO dúbia: o rótulo nomeia o dado ('sinais digitais próprios', 'eventos de sessão próprios'), não o repositório de onde é capturado. Modelado como DO (dado capturado na execução); alternativa: DS, se houver repositório de eventos de sessão — não nomeado na origem.</bpmn:documentation>
    </bpmn:dataObjectReference>
    <bpmn:dataObject id="DO_INS_020_1" name="Dados clínicos (HL7 FHIR)">
      <bpmn:documentation>Insumo INS-020 · Origem: SUB-01 §2.11 Insumo (JIT) — fonte; SUB-01 §2.11 · coluna Subprocesso genérico; CA_0 · EC_T_Clinicos · rótulo ⚠️ AMBIGUIDADE — Natureza DS × DO dúbia: HL7 FHIR é padrão de interoperabilidade, não nome de base; o sistema de origem dos dados clínicos não é nomeado. Modelado como DO (dado ingerido); alternativa: DS. Não se declara identidade com 'Registro do atendimento realizado (dados clínicos)' (INS-025, CA_2).</bpmn:documentation>
    </bpmn:dataObject>
    <bpmn:dataObjectReference id="DOR_INS_020_1" name="Dados clínicos (HL7 FHIR)" dataObjectRef="DO_INS_020_1">
      <bpmn:documentation>Insumo INS-020 · Origem: SUB-01 §2.11 Insumo (JIT) — fonte; SUB-01 §2.11 · coluna Subprocesso genérico; CA_0 · EC_T_Clinicos · rótulo ⚠️ AMBIGUIDADE — Natureza DS × DO dúbia: HL7 FHIR é padrão de interoperabilidade, não nome de base; o sistema de origem dos dados clínicos não é nomeado. Modelado como DO (dado ingerido); alternativa: DS. Não se declara identidade com 'Registro do atendimento realizado (dados clínicos)' (INS-025, CA_2).</bpmn:documentation>
    </bpmn:dataObjectReference>
    <bpmn:dataStoreReference id="DSR_INS_021_1" name="Repositório de pesquisas respondidas" dataStoreRef="DS_INS_021">
      <bpmn:documentation>Insumo INS-021 · Origem: SUB-01 §2.11 Insumo (JIT) — fonte interna; SUB-01 §2.11 · coluna Subprocesso genérico; CA_0 · EC_T_Pesquisas · rótulo; CA_0 · EC_T_Pesquisas · documentation</bpmn:documentation>
    </bpmn:dataStoreReference>
  </bpmn:process>
  <bpmn:process id="Process_CA_H3_ProximaMelhorAcao" name="H3.2 — Calcular próxima melhor ação" isExecutable="true" camunda:versionTag="3.0.0-arq01" camunda:historyTimeToLive="180">
    <bpmn:documentation>Cold start por popularidade corrigida; ranking item-item + bandit contextual; guardrails; explicação; humano no loop para risco clínico 3. Chamado por C1.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_Process_CA_H3_ProximaMelhorAcao">
      <bpmn:lane id="LN_CA0_H32_ModelagemEGrowth" name="Modelagem e growth (motor de recomendação)">
        <bpmn:documentation>Dimensão: Staff · Origem: SUB-01 §2.10 (Staff) · Ref: C1_CA_NBA</bpmn:documentation>
        <bpmn:flowNodeRef>NBA_T_Ranquear</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NBA_T_Popularidade</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NBA_GW_Merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NBA_T_Guardrails</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NBA_T_Explicar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NBA_GW_Clinico</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NBA_GW_MergeFim</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NBA_End</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LN_CA0_H32_GovernancaClinica" name="Governança clínica">
        <bpmn:documentation>Dimensão: Staff · Origem: candidateGroups da tarefa</bpmn:documentation>
        <bpmn:flowNodeRef>NBA_T_Revisao</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NBA_B_SLA_Revisao</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NBA_T_EscalarRevisao</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NBA_End_SLA_Revisao</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LN_CA0_H32_DisponibilizacaoDeInsumos" name="Disponibilização de insumos">
        <bpmn:documentation>Dimensão: Insumo JIT · Origem: SUB-01 §2.10 (Insumo) · Ref: C1_CA_NBA</bpmn:documentation>
        <bpmn:flowNodeRef>NBA_Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NBA_T_Contexto</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NBA_GW_ColdStart</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="NBA_Start" name="Cálculo solicitado">
      <bpmn:documentation>Origem: NBA_Start</bpmn:documentation>
      <bpmn:outgoing>F_CA_H3_ProximaMelhorAcao_01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="NBA_T_Contexto" name="Carregar perfil 360 e contexto de sessão" camunda:delegateExpression="${featureStoreService}">
      <bpmn:documentation>Produz historicoSuficiente. Latência alvo &lt; 300 ms. | Origem: NBA_T_Contexto</bpmn:documentation>
      <bpmn:incoming>F_CA_H3_ProximaMelhorAcao_01</bpmn:incoming>
      <bpmn:outgoing>F_CA_H3_ProximaMelhorAcao_02</bpmn:outgoing>
      <bpmn:property id="Property_NBA_T_Contexto_targetRef" name="__targetRef_placeholder"/>
      <bpmn:dataInputAssociation id="DIA_INS_012_1">
        <bpmn:sourceRef>DSR_INS_012_1</bpmn:sourceRef>
        <bpmn:targetRef>Property_NBA_T_Contexto_targetRef</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataInputAssociation id="DIA_INS_013_1">
        <bpmn:sourceRef>DOR_INS_013_1</bpmn:sourceRef>
        <bpmn:targetRef>Property_NBA_T_Contexto_targetRef</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="NBA_GW_ColdStart" name="Histórico suficiente?" default="F_CA_H3_ProximaMelhorAcao_04">
      <bpmn:documentation>Origem: NBA_GW_ColdStart</bpmn:documentation>
      <bpmn:documentation>Regra: sem histórico suficiente, usar fallback de popularidade em vez de recomendação personalizada — dono: Disponibilização de insumos</bpmn:documentation>
      <bpmn:incoming>F_CA_H3_ProximaMelhorAcao_02</bpmn:incoming>
      <bpmn:outgoing>F_CA_H3_ProximaMelhorAcao_03</bpmn:outgoing>
      <bpmn:outgoing>F_CA_H3_ProximaMelhorAcao_04</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="NBA_T_Ranquear" name="Ranquear candidatos (item-item + bandit)" camunda:delegateExpression="${recommendationRankingService}">
      <bpmn:documentation>Origem: NBA_T_Ranquear</bpmn:documentation>
      <bpmn:incoming>F_CA_H3_ProximaMelhorAcao_03</bpmn:incoming>
      <bpmn:outgoing>F_CA_H3_ProximaMelhorAcao_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="NBA_T_Popularidade" name="Aplicar fallback de cold start" camunda:delegateExpression="${coldStartFallbackService}">
      <bpmn:documentation>Popularidade corrigida — nunca popularidade pura. | Origem: NBA_T_Popularidade</bpmn:documentation>
      <bpmn:incoming>F_CA_H3_ProximaMelhorAcao_04</bpmn:incoming>
      <bpmn:outgoing>F_CA_H3_ProximaMelhorAcao_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="NBA_GW_Merge" name="">
      <bpmn:documentation>Origem: NBA_GW_Merge</bpmn:documentation>
      <bpmn:incoming>F_CA_H3_ProximaMelhorAcao_05</bpmn:incoming>
      <bpmn:incoming>F_CA_H3_ProximaMelhorAcao_06</bpmn:incoming>
      <bpmn:outgoing>F_CA_H3_ProximaMelhorAcao_07</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="NBA_T_Guardrails" name="Aplicar guardrails (elegibilidade, cobertura)" camunda:delegateExpression="${recommendationGuardrailService}">
      <bpmn:documentation>Produz recomendacaoRelevante e tierClinico (T1 informativo, T2 acionável, T3 consequência clínica). | Origem: NBA_T_Guardrails</bpmn:documentation>
      <bpmn:incoming>F_CA_H3_ProximaMelhorAcao_07</bpmn:incoming>
      <bpmn:outgoing>F_CA_H3_ProximaMelhorAcao_08</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="NBA_T_Explicar" name="Gerar explicação da recomendação" camunda:delegateExpression="${explanationService}">
      <bpmn:documentation>Origem: NBA_T_Explicar</bpmn:documentation>
      <bpmn:incoming>F_CA_H3_ProximaMelhorAcao_08</bpmn:incoming>
      <bpmn:outgoing>F_CA_H3_ProximaMelhorAcao_09</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="NBA_GW_Clinico" name="Consequência clínica (risco 3)?" default="F_CA_H3_ProximaMelhorAcao_11">
      <bpmn:documentation>Origem: NBA_GW_Clinico</bpmn:documentation>
      <bpmn:documentation>Regra: recomendação com consequência clínica exige revisão humana antes de seguir — dono: Modelagem e growth (motor de recomendação)</bpmn:documentation>
      <bpmn:incoming>F_CA_H3_ProximaMelhorAcao_09</bpmn:incoming>
      <bpmn:outgoing>F_CA_H3_ProximaMelhorAcao_10</bpmn:outgoing>
      <bpmn:outgoing>F_CA_H3_ProximaMelhorAcao_11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="NBA_T_Revisao" name="Revisar recomendação clínica" camunda:formKey="ced:revisao-nba" camunda:candidateGroups="governanca-clinica">
      <bpmn:documentation>Humano no loop obrigatório. | Origem: NBA_T_RevisaoHumana</bpmn:documentation>
      <bpmn:incoming>F_CA_H3_ProximaMelhorAcao_10</bpmn:incoming>
      <bpmn:outgoing>F_CA_H3_ProximaMelhorAcao_12</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="NBA_B_SLA_Revisao" name="SLA 24h sem revisão" cancelActivity="false" attachedToRef="NBA_T_Revisao">
      <bpmn:outgoing>F_CA_H3_ProximaMelhorAcao_14</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT24H</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="NBA_T_EscalarRevisao" name="Escalar revisão de recomendação pendente">
      <bpmn:incoming>F_CA_H3_ProximaMelhorAcao_14</bpmn:incoming>
      <bpmn:outgoing>F_CA_H3_ProximaMelhorAcao_15</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="NBA_End_SLA_Revisao" name="Revisão escalada — recomendação retida">
      <bpmn:incoming>F_CA_H3_ProximaMelhorAcao_15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="NBA_GW_MergeFim" name="">
      <bpmn:incoming>F_CA_H3_ProximaMelhorAcao_11</bpmn:incoming>
      <bpmn:incoming>F_CA_H3_ProximaMelhorAcao_12</bpmn:incoming>
      <bpmn:outgoing>F_CA_H3_ProximaMelhorAcao_13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="NBA_End" name="Recomendação calculada">
      <bpmn:documentation>Origem: NBA_End</bpmn:documentation>
      <bpmn:incoming>F_CA_H3_ProximaMelhorAcao_13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_CA_H3_ProximaMelhorAcao_01" sourceRef="NBA_Start" targetRef="NBA_T_Contexto"/>
    <bpmn:sequenceFlow id="F_CA_H3_ProximaMelhorAcao_02" sourceRef="NBA_T_Contexto" targetRef="NBA_GW_ColdStart"/>
    <bpmn:sequenceFlow id="F_CA_H3_ProximaMelhorAcao_03" name="Sim" sourceRef="NBA_GW_ColdStart" targetRef="NBA_T_Ranquear">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${historicoSuficiente == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_CA_H3_ProximaMelhorAcao_04" name="Não — cold start" sourceRef="NBA_GW_ColdStart" targetRef="NBA_T_Popularidade"/>
    <bpmn:sequenceFlow id="F_CA_H3_ProximaMelhorAcao_05" sourceRef="NBA_T_Ranquear" targetRef="NBA_GW_Merge"/>
    <bpmn:sequenceFlow id="F_CA_H3_ProximaMelhorAcao_06" sourceRef="NBA_T_Popularidade" targetRef="NBA_GW_Merge"/>
    <bpmn:sequenceFlow id="F_CA_H3_ProximaMelhorAcao_07" sourceRef="NBA_GW_Merge" targetRef="NBA_T_Guardrails"/>
    <bpmn:sequenceFlow id="F_CA_H3_ProximaMelhorAcao_08" sourceRef="NBA_T_Guardrails" targetRef="NBA_T_Explicar"/>
    <bpmn:sequenceFlow id="F_CA_H3_ProximaMelhorAcao_09" sourceRef="NBA_T_Explicar" targetRef="NBA_GW_Clinico"/>
    <bpmn:sequenceFlow id="F_CA_H3_ProximaMelhorAcao_10" name="Sim — revisão humana" sourceRef="NBA_GW_Clinico" targetRef="NBA_T_Revisao">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${tierClinico == "T3"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_CA_H3_ProximaMelhorAcao_11" name="Não (risco 1/2)" sourceRef="NBA_GW_Clinico" targetRef="NBA_GW_MergeFim"/>
