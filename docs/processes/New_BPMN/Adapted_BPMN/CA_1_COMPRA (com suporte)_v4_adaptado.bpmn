<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_CA_COMPRA" targetNamespace="http://central-atendimento/bpmn/arq01" exporter="Camunda Modeler" exporterVersion="5.36.1" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.24.0">
  <bpmn:collaboration id="Collaboration_CA_COMPRA" name="Central de Atendimento — 1 · COMPRA">
    <bpmn:documentation>COMPRA é o macroprocesso que obtém o direito; chama H1, H3.2 e H3.1 de serviços compartilhados e negocia autorização com a operadora por mensagens. Transições de jornada (T-01, T-02/T-03, T-06, T-07, T-09, T-10) são os contratos de fronteira com UTILIZAÇÃO e SUPORTE.</bpmn:documentation>
    <bpmn:participant id="Participant_Cliente" name="Cliente — necessidade · visão · intenção"/>
    <bpmn:participant id="Participant_CA_COMPRA" name="COMPRA — Obter o direito ao cuidado" processRef="Process_CA_COMPRA"/>
    <bpmn:participant id="Participant_Utilizacao" name="UTILIZAÇÃO (CA 2) — Receber o cuidado contratado"/>
    <bpmn:participant id="Participant_Suporte" name="SUPORTE (CA 3) — Ser ouvido e ter o problema resolvido"/>
    <bpmn:participant id="Participant_CA_COMPRA_C1_EntenderRecomendar" name="C1 — Entender a necessidade e recomendar" processRef="Process_CA_COMPRA_C1_EntenderRecomendar"/>
    <bpmn:participant id="Participant_CA_COMPRA_C2_DecidirContratar" name="C2 — Decidir e contratar" processRef="Process_CA_COMPRA_C2_DecidirContratar"/>
    <bpmn:participant id="Participant_CA_COMPRA_C3_HabilitarDireito" name="C3 — Habilitar o direito" processRef="Process_CA_COMPRA_C3_HabilitarDireito"/>
    <bpmn:participant id="Participant_Operadora" name="Operadora"/>
    <bpmn:participant id="Participant_CA_COMPRA_C4_ManterDireito" name="C4 — Manter o direito" processRef="Process_CA_COMPRA_C4_ManterDireito"/>
    <bpmn:messageFlow id="MF_CP_01" sourceRef="Participant_Cliente" targetRef="CP_Start_Necessidade"/>
    <bpmn:messageFlow id="MF_CP_02" sourceRef="Participant_Cliente" targetRef="CP_Start_Reacao"/>
    <bpmn:messageFlow id="MF_CP_03" sourceRef="Participant_Cliente" targetRef="CP_Start_NovoBeneficiario"/>
    <bpmn:messageFlow id="MF_CP_04" name="T-01 Direito habilitado" sourceRef="CP_End_DireitoHabilitado" targetRef="Participant_Utilizacao"/>
    <bpmn:messageFlow id="MF_CP_05" name="T-02 / T-03 Consumo não realizado" sourceRef="Participant_Utilizacao" targetRef="CP_Start_ConsumoNaoRealizado"/>
    <bpmn:messageFlow id="MF_CP_06" name="T-06 Próxima ação clínica" sourceRef="Participant_Utilizacao" targetRef="CP_Start_NovaNecessidade"/>
    <bpmn:messageFlow id="MF_CP_07" name="T-07 Intenção de compra" sourceRef="Participant_Suporte" targetRef="CP_Start_NovaNecessidade"/>
    <bpmn:messageFlow id="MF_CP_08" name="Requisição de autorização" sourceRef="C3_T_Requisitar" targetRef="Participant_Operadora"/>
    <bpmn:messageFlow id="MF_CP_09" name="Concedida" sourceRef="Participant_Operadora" targetRef="C3_EV_Concedida"/>
    <bpmn:messageFlow id="MF_CP_10" name="Pendência" sourceRef="Participant_Operadora" targetRef="C3_EV_Pendencia"/>
    <bpmn:messageFlow id="MF_CP_11" name="Negada" sourceRef="Participant_Operadora" targetRef="C3_EV_Negada"/>
    <bpmn:messageFlow id="MF_CP_12" name="Pedido de ajuda" sourceRef="Participant_Cliente" targetRef="CP_ES_Start_Ajuda"/>
    <bpmn:messageFlow id="MF_CP_13" name="T-09 Pedido de ajuda (compra segue)" sourceRef="CP_ES_End_Ajuda" targetRef="Participant_Suporte"/>
    <bpmn:messageFlow id="MF_CP_14" name="T-09 Dificuldade na compra" sourceRef="CP_End_Suporte" targetRef="Participant_Suporte"/>
    <bpmn:messageFlow id="MF_CP_15" name="T-10 Direito não mantido" sourceRef="CP_End_Recovery" targetRef="Participant_Suporte"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_CA_COMPRA" name="COMPRA — Obter o direito ao cuidado" isExecutable="true" camunda:versionTag="3.1.0-rt-suporte" camunda:historyTimeToLive="180">
    <bpmn:documentation>Macroprocesso 1 (ARQ-01 §4). Entrada: necessidade/intenção do cliente. Resultado: direito ao cuidado habilitado (agendado + autorizado + promessa de prazo). Variantes resolvidas por origemIntencao, tipoDireito e resultado de C4. Journey ID = business key. REDESENHO RT (v3.1): momentos de dificuldade roteados ao SUPORTE (CA 3) — RT-01 pedido de ajuda em qualquer etapa (subprocesso de evento, não interrompe) · RT-02 busca ativa sem oferta viável · RT-03 contestação da negativa / pedido de humano na renegociação · RT-04 sem slot equivalente no reagendamento. Novas transições propostas: T-09 (→ EV-S01) e T-10 (→ EV-S02). ⚠️ PD-RT-01: aceitar T-09 e T-10 — decisão pendente da Process Owner (Eliza).</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_Process_CA_COMPRA">
      <bpmn:lane id="LN_CA1_COMPRA_ConsultorComercial" name="Consultor comercial">
        <bpmn:documentation>Dimensão: Staff · Origem: SUB-01 §2.4 · Ref: CP_CA_C1</bpmn:documentation>
        <bpmn:flowNodeRef>CP_Start_Necessidade</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CP_Start_Reacao</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CP_Start_NovaNecessidade</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CP_GW_MergeIntencao</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CP_CA_C1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CP_B_ConsentimentoNegado</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CP_End_SemConsentimento</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CP_GW_Proposta</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CP_GW_SemOferta</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CP_End_Nutrir</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CP_GW_MergeSuporte</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CP_End_Suporte</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LN_CA1_COMPRA_ContratacaoBackOfficeComercial" name="Contratação e back-office comercial">
        <bpmn:documentation>Dimensão: Staff · Origem: SUB-01 §2.5 · Ref: CP_CA_C2</bpmn:documentation>
        <bpmn:flowNodeRef>CP_CA_C2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CP_GW_Decisao</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CP_End_Recusa</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CP_End_SemDecisao</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LN_CA1_COMPRA_CadastroOperacoes" name="Cadastro e operações">
        <bpmn:documentation>Dimensão: Staff · Origem: SUB-01 §2.6 · Ref: CP_CA_C3</bpmn:documentation>
        <bpmn:flowNodeRef>CP_Start_NovoBeneficiario</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CP_GW_MergeHabilitar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CP_CA_C3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CP_GW_Habilitado</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CP_End_VendaPerdida</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CP_GW_TipoDireito</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CP_End_Beneficiario</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CP_End_DireitoHabilitado</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LN_CA1_COMPRA_RetencaoRelacionamento" name="Retenção e relacionamento">
        <bpmn:documentation>Dimensão: Staff · Origem: SUB-01 §2.7 · Ref: CP_CA_C4</bpmn:documentation>
        <bpmn:flowNodeRef>CP_Start_ConsumoNaoRealizado</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CP_CA_C4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CP_GW_Manutencao</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CP_End_DireitoEncerrado</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CP_End_Recovery</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LN_CA1_COMPRA_AtendenteSuporte" name="Atendente de suporte">
        <bpmn:documentation>Dimensão: Staff · Origem: SUB-01 §2.8; §3 · Ref: CP_ES_Ajuda</bpmn:documentation>
        <bpmn:flowNodeRef>CP_ES_Ajuda</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="CP_Start_Necessidade" name="Cliente expressa necessidade de cuidado">
      <bpmn:documentation>EV-C01. Payload: clienteId, canal, intencao (sintoma/especialidade/procedimento), contextoInteracao. | Origem: M2_Start_Descoberta + M1_Start_NBA (consolidados — SO-01)</bpmn:documentation>
      <bpmn:extensionElements>
        <camunda:executionListener expression="${execution.setVariable('origemIntencao', 'BUSCA')}" event="start"/>
      </bpmn:extensionElements>
      <bpmn:outgoing>F_CA_COMPRA_01</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_CA_NecessidadeCliente"/>
    </bpmn:startEvent>
    <bpmn:startEvent id="CP_Start_Reacao" name="Cliente reage a recomendação">
      <bpmn:documentation>EV-C02. Fecha FR-05: a recomendação proativa (H2) só vira jornada quando o cliente reage. | Origem: [SEM ORIGEM] — ARQ-01 FR-05</bpmn:documentation>
      <bpmn:extensionElements>
        <camunda:executionListener expression="${execution.setVariable('origemIntencao', 'RECOMENDACAO')}" event="start"/>
      </bpmn:extensionElements>
      <bpmn:outgoing>F_CA_COMPRA_02</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_CA_ReacaoRecomendacao"/>
    </bpmn:startEvent>
    <bpmn:startEvent id="CP_Start_NovaNecessidade" name="Nova necessidade identificada">
      <bpmn:documentation>EV-C05. Recebe T-06 (próxima ação clínica, UTILIZAÇÃO) e T-07 (intenção de compra, SUPORTE). Transição proposta — PD-05. | Origem: [SEM ORIGEM] — ARQ-01 T-06/T-07</bpmn:documentation>
      <bpmn:extensionElements>
        <camunda:executionListener expression="${execution.setVariable('origemIntencao', 'CONTINUIDADE')}" event="start"/>
      </bpmn:extensionElements>
      <bpmn:outgoing>F_CA_COMPRA_03</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_CA_NovaNecessidade"/>
    </bpmn:startEvent>
    <bpmn:startEvent id="CP_Start_NovoBeneficiario" name="Novo beneficiário contratado">
      <bpmn:documentation>EV-C03. ⚠️ LA-01: a contratação do plano não está modelada nas fontes; o processo começa no cadastro. | Origem: M1_Start_ClienteNovo</bpmn:documentation>
      <bpmn:extensionElements>
        <camunda:executionListener expression="${execution.setVariable('tipoDireito', 'PLANO')}" event="start"/>
      </bpmn:extensionElements>
      <bpmn:outgoing>F_CA_COMPRA_13</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_CA_NovoBeneficiario"/>
    </bpmn:startEvent>
    <bpmn:startEvent id="CP_Start_ConsumoNaoRealizado" name="Consumo não realizado">
      <bpmn:documentation>EV-C04. Recebe T-02/T-03 da UTILIZAÇÃO. Payload: statusEntrega, agendamentoId. | Origem: ES_End_NoShow, ES_End_CancelPrestador, ES_End_CancelCliente</bpmn:documentation>
      <bpmn:outgoing>F_CA_COMPRA_20</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_CA_ConsumoNaoRealizado"/>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="CP_GW_MergeIntencao" name="">
      <bpmn:documentation>Junção dos inícios de busca</bpmn:documentation>
      <bpmn:incoming>F_CA_COMPRA_01</bpmn:incoming>
      <bpmn:incoming>F_CA_COMPRA_02</bpmn:incoming>
      <bpmn:incoming>F_CA_COMPRA_03</bpmn:incoming>
      <bpmn:outgoing>F_CA_COMPRA_04</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:callActivity id="CP_CA_C1" name="Entender a necessidade e recomendar" camunda:asyncBefore="true" calledElement="Process_CA_COMPRA_C1_EntenderRecomendar">
      <bpmn:documentation>Origem: ARQ-01 C1</bpmn:documentation>
      <bpmn:documentation>Contrato de variáveis a confirmar com a equipe: este passo pode produzir/consumir variáveis em execução (delegados/formulários) não declaradas no modelo; a lista explícita reflete o que o próprio modelo comprova.</bpmn:documentation>
      <bpmn:extensionElements>
        <camunda:in businessKey="#{execution.processBusinessKey}"/>
        <camunda:in source="propostaRelevante" target="propostaRelevante"/>
        <camunda:executionListener expression="${execution.setVariable('etapaCompra', 'C1')}" event="start"/>
      </bpmn:extensionElements>
      <bpmn:incoming>F_CA_COMPRA_04</bpmn:incoming>
      <bpmn:outgoing>F_CA_COMPRA_05</bpmn:outgoing>
      <bpmn:property id="Property_CP_CA_C1_targetRef" name="__targetRef_placeholder"/>
      <bpmn:dataInputAssociation id="DIA_INS_005_1">
        <bpmn:sourceRef>DSR_INS_005_1</bpmn:sourceRef>
        <bpmn:targetRef>Property_CP_CA_C1_targetRef</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:callActivity>
    <bpmn:boundaryEvent id="CP_B_ConsentimentoNegado" name="Consentimento negado" attachedToRef="CP_CA_C1">
      <bpmn:documentation>Origem: M2_Boundary_Negado + M1_Boundary_NegadoNBA</bpmn:documentation>
      <bpmn:outgoing>F_CA_COMPRA_06</bpmn:outgoing>
      <bpmn:errorEventDefinition errorRef="Error_CA_ConsentimentoNegado"/>
    </bpmn:boundaryEvent>
    <bpmn:endEvent id="CP_End_SemConsentimento" name="Cliente orientado a consentir">
      <bpmn:documentation>O canal de origem responde com o link de consentimento (sem contato proativo posterior). | Origem: M2_End_Negado + M1_End_NegadoNBA</bpmn:documentation>
      <bpmn:incoming>F_CA_COMPRA_06</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="CP_GW_Proposta" name="Proposta relevante e viável?" default="F_CA_COMPRA_08">
      <bpmn:documentation>Origem: M2_GW_Proposta + M1_GW_Relevancia (SO-03)</bpmn:documentation>
      <bpmn:documentation>Regra: seguir para proposta somente se relevante e viável; sem oferta, registrar a necessidade e encerrar — dono: Consultor comercial</bpmn:documentation>
      <bpmn:incoming>F_CA_COMPRA_05</bpmn:incoming>
      <bpmn:outgoing>F_CA_COMPRA_07</bpmn:outgoing>
      <bpmn:outgoing>F_CA_COMPRA_08</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="CP_GW_SemOferta" name="Busca ativa sem oferta viável?" default="F_CA_COMPRA_24">
      <bpmn:documentation>RT-02 [PROPOSTO]. Cliente buscou ativamente (EV-C01) ou veio de continuidade clínica (T-06) e C1 não compôs proposta relevante e viável: é necessidade de cuidado não atendida, não lead a nutrir. Sim → SUPORTE (T-09); Não (reação a recomendação) → nutrição, como na origem. Trava anti-loop: não devolve ao SUPORTE o que veio do SUPORTE (T-07). ⚠️ PD-RT-03: SUPORTE não deve reemitir T-07 para motivoDificuldade = SEM_OFERTA sem oferta nova. | Origem: CP_GW_Proposta (saída Não) + ARQ-01 §4.5</bpmn:documentation>
      <bpmn:documentation>Regra: sem oferta viável, ativar busca ativa; se não veio de recomendação nem de intenção de suporte, registrar venda perdida — dono: Consultor comercial</bpmn:documentation>
      <bpmn:incoming>F_CA_COMPRA_08</bpmn:incoming>
      <bpmn:outgoing>F_CA_COMPRA_24</bpmn:outgoing>
      <bpmn:outgoing>F_CA_COMPRA_25</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="CP_End_Nutrir" name="Necessidade registrada para nutrição">
      <bpmn:documentation>Publica evento de negócio FILA_NUTRICAO para H3. | Origem: M2_End_SemProposta + M1_End_SemNBA (SO-06)</bpmn:documentation>
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="tipoEventoNegocio">FILA_NUTRICAO</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>F_CA_COMPRA_24</bpmn:incoming>
      <bpmn:messageEventDefinition messageRef="Message_CA_EventoNegocio" camunda:delegateExpression="${businessEventPublisher}"/>
    </bpmn:endEvent>
    <bpmn:callActivity id="CP_CA_C2" name="Decidir e contratar" camunda:asyncBefore="true" calledElement="Process_CA_COMPRA_C2_DecidirContratar">
      <bpmn:documentation>Origem: ARQ-01 C2</bpmn:documentation>
      <bpmn:extensionElements>
        <camunda:in businessKey="#{execution.processBusinessKey}"/>
        <camunda:out source="decisaoCliente" target="decisaoCliente"/>
        <camunda:executionListener expression="${execution.setVariable('etapaCompra', 'C2')}" event="start"/>
      </bpmn:extensionElements>
      <bpmn:incoming>F_CA_COMPRA_07</bpmn:incoming>
      <bpmn:outgoing>F_CA_COMPRA_09</bpmn:outgoing>
      <bpmn:property id="Property_CP_CA_C2_targetRef" name="__targetRef_placeholder"/>
      <bpmn:dataInputAssociation id="DIA_INS_006_2">
        <bpmn:sourceRef>DOR_INS_006_2</bpmn:sourceRef>
        <bpmn:targetRef>Property_CP_CA_C2_targetRef</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataInputAssociation id="DIA_INS_007_1">
        <bpmn:sourceRef>DOR_INS_007_1</bpmn:sourceRef>
        <bpmn:targetRef>Property_CP_CA_C2_targetRef</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="CP_GW_Decisao" name="Decisão do cliente?" default="F_CA_COMPRA_12">
      <bpmn:documentation>Regra: aceite confirma o agendamento; recusa libera o slot; sem resposta no prazo encerra com slot liberado — dono: Contratação e back-office comercial</bpmn:documentation>
      <bpmn:documentation>Guard-rail de contratação: decisão de contratar é do cliente/humano; a automação prepara a decisão, nunca decide.</bpmn:documentation>
      <bpmn:incoming>F_CA_COMPRA_09</bpmn:incoming>
      <bpmn:outgoing>F_CA_COMPRA_10</bpmn:outgoing>
      <bpmn:outgoing>F_CA_COMPRA_11</bpmn:outgoing>
      <bpmn:outgoing>F_CA_COMPRA_12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="CP_End_Recusa" name="Recusa registrada — slot liberado">
      <bpmn:documentation>Publica evento de negócio VENDA_PERDIDA para H3. | Origem: M2_End_Cancelado</bpmn:documentation>
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="tipoEventoNegocio">VENDA_PERDIDA</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>F_CA_COMPRA_11</bpmn:incoming>
      <bpmn:messageEventDefinition messageRef="Message_CA_EventoNegocio" camunda:delegateExpression="${businessEventPublisher}"/>
    </bpmn:endEvent>
    <bpmn:endEvent id="CP_End_SemDecisao" name="Sem decisão no prazo — slot liberado">
      <bpmn:documentation>⚠️ PD-02: prazo máximo de espera pela decisão a definir. | Origem: M2_End_SLAceite (reposicionado)</bpmn:documentation>
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="tipoEventoNegocio">VENDA_PERDIDA</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>F_CA_COMPRA_12</bpmn:incoming>
      <bpmn:messageEventDefinition messageRef="Message_CA_EventoNegocio" camunda:delegateExpression="${businessEventPublisher}"/>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="CP_GW_MergeHabilitar" name="">
      <bpmn:incoming>F_CA_COMPRA_10</bpmn:incoming>
      <bpmn:incoming>F_CA_COMPRA_13</bpmn:incoming>
      <bpmn:incoming>F_CA_COMPRA_22</bpmn:incoming>
      <bpmn:outgoing>F_CA_COMPRA_14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:callActivity id="CP_CA_C3" name="Habilitar o direito" camunda:asyncBefore="true" calledElement="Process_CA_COMPRA_C3_HabilitarDireito">
      <bpmn:documentation>Origem: ARQ-01 C3</bpmn:documentation>
      <bpmn:documentation>Contrato de variáveis a confirmar com a equipe: este passo pode produzir/consumir variáveis em execução (delegados/formulários) não declaradas no modelo; a lista explícita reflete o que o próprio modelo comprova.</bpmn:documentation>
      <bpmn:extensionElements>
        <camunda:in businessKey="#{execution.processBusinessKey}"/>
        <camunda:in source="tipoDireito" target="tipoDireito"/>
        <camunda:in source="autorizacaoAutomatica" target="autorizacaoAutomatica"/>
        <camunda:in source="pendenciaResolvida" target="pendenciaResolvida"/>
        <camunda:in source="tentativasAutorizacao" target="tentativasAutorizacao"/>
        <camunda:in source="negativaDeCobertura" target="negativaDeCobertura"/>
        <camunda:in source="clienteAceitouAlternativa" target="clienteAceitouAlternativa"/>
        <camunda:in source="clienteSolicitouSuporte" target="clienteSolicitouSuporte"/>
        <camunda:out source="direitoHabilitado" target="direitoHabilitado"/>
        <camunda:out source="encaminharSuporte" target="encaminharSuporte"/>
        <camunda:out source="motivoDificuldade" target="motivoDificuldade"/>
        <camunda:out source="marcoJornada" target="marcoJornada"/>
        <camunda:executionListener expression="${execution.setVariable('etapaCompra', 'C3')}" event="start"/>
      </bpmn:extensionElements>
      <bpmn:incoming>F_CA_COMPRA_14</bpmn:incoming>
      <bpmn:outgoing>F_CA_COMPRA_15</bpmn:outgoing>
      <bpmn:property id="Property_CP_CA_C3_targetRef" name="__targetRef_placeholder"/>
      <bpmn:dataInputAssociation id="DIA_INS_008_1">
        <bpmn:sourceRef>DOR_INS_008_1</bpmn:sourceRef>
        <bpmn:targetRef>Property_CP_CA_C3_targetRef</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="CP_GW_Habilitado" name="Direito habilitado?" default="F_CA_COMPRA_17">
      <bpmn:documentation>RT-03: C3 devolve encaminharSuporte = true quando o cliente pede contestação ou atendimento humano na renegociação. | Origem: ARQ-01 GW-C09 + LA-04</bpmn:documentation>
      <bpmn:documentation>Regra: direito habilitado segue para uso; contestação ou pedido de humano encaminha ao suporte com contexto — dono: Cadastro e operações</bpmn:documentation>
      <bpmn:incoming>F_CA_COMPRA_15</bpmn:incoming>
      <bpmn:outgoing>F_CA_COMPRA_16</bpmn:outgoing>
      <bpmn:outgoing>F_CA_COMPRA_17</bpmn:outgoing>
      <bpmn:outgoing>F_CA_COMPRA_26</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="CP_End_VendaPerdida" name="Venda perdida — motivo registrado">
      <bpmn:documentation>Publica evento de negócio VENDA_PERDIDA para H3. | Origem: M2_End_Perdeu</bpmn:documentation>
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="tipoEventoNegocio">VENDA_PERDIDA</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>F_CA_COMPRA_17</bpmn:incoming>
      <bpmn:messageEventDefinition messageRef="Message_CA_EventoNegocio" camunda:delegateExpression="${businessEventPublisher}"/>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="CP_GW_TipoDireito" name="Tipo de direito?" default="F_CA_COMPRA_19">
      <bpmn:documentation>Regra: trilha de habilitação depende do tipo de direito — dono: Cadastro e operações</bpmn:documentation>
      <bpmn:incoming>F_CA_COMPRA_16</bpmn:incoming>
      <bpmn:outgoing>F_CA_COMPRA_18</bpmn:outgoing>
      <bpmn:outgoing>F_CA_COMPRA_19</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="CP_End_Beneficiario" name="Beneficiário habilitado">
      <bpmn:documentation>⚠️ LA-06: boas-vindas ao novo beneficiário não modelada nas fontes. | Origem: M1_End_NovoEnriquecido</bpmn:documentation>
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="tipoEventoNegocio">PERFIL_INICIAL</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>F_CA_COMPRA_18</bpmn:incoming>
      <bpmn:messageEventDefinition messageRef="Message_CA_EventoNegocio" camunda:delegateExpression="${businessEventPublisher}"/>
    </bpmn:endEvent>
    <bpmn:endEvent id="CP_End_DireitoHabilitado" name="Direito habilitado">
      <bpmn:documentation>T-01 → UTILIZAÇÃO. Payload: journeyId, clienteId, agendamentoId, autorizacaoId, dataHoraServico, prestadorId, procedimentoId, promessaResultado, geraResultado. | Origem: M2_EV_MarcoAutorizado → M2_CA_Entrega</bpmn:documentation>
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="transicao">T-01</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>F_CA_COMPRA_19</bpmn:incoming>
      <bpmn:messageEventDefinition messageRef="Message_CA_DireitoHabilitado" camunda:delegateExpression="${journeyTransitionPublisher}"/>
    </bpmn:endEvent>
    <bpmn:callActivity id="CP_CA_C4" name="Manter o direito" camunda:asyncBefore="true" calledElement="Process_CA_COMPRA_C4_ManterDireito">
      <bpmn:documentation>Origem: ARQ-01 C4</bpmn:documentation>
      <bpmn:documentation>Contrato de variáveis a confirmar com a equipe: este passo pode produzir/consumir variáveis em execução (delegados/formulários) não declaradas no modelo; a lista explícita reflete o que o próprio modelo comprova.</bpmn:documentation>
      <bpmn:extensionElements>
        <camunda:in businessKey="#{execution.processBusinessKey}"/>
        <camunda:in source="statusEntrega" target="statusEntrega"/>
        <camunda:executionListener expression="${execution.setVariable('etapaCompra', 'C4')}" event="start"/>
      </bpmn:extensionElements>
      <bpmn:incoming>F_CA_COMPRA_20</bpmn:incoming>
      <bpmn:outgoing>F_CA_COMPRA_21</bpmn:outgoing>
      <bpmn:property id="Property_CP_CA_C4_targetRef" name="__targetRef_placeholder"/>
      <bpmn:dataInputAssociation id="DIA_INS_009_1">
        <bpmn:sourceRef>DOR_INS_009_1</bpmn:sourceRef>
        <bpmn:targetRef>Property_CP_CA_C4_targetRef</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataInputAssociation id="DIA_INS_010_1">
        <bpmn:sourceRef>DSR_INS_010_1</bpmn:sourceRef>
        <bpmn:targetRef>Property_CP_CA_C4_targetRef</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="CP_GW_Manutencao" name="Resultado da manutenção?" default="F_CA_COMPRA_23">
      <bpmn:documentation>Regra: remarcado segue novo ciclo de confirmação; sem slot dispara reagendamento automático; demais desfechos encerram a manutenção — dono: Retenção e relacionamento</bpmn:documentation>
      <bpmn:incoming>F_CA_COMPRA_21</bpmn:incoming>
      <bpmn:outgoing>F_CA_COMPRA_22</bpmn:outgoing>
      <bpmn:outgoing>F_CA_COMPRA_23</bpmn:outgoing>
      <bpmn:outgoing>F_CA_COMPRA_28</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="CP_End_DireitoEncerrado" name="Direito encerrado — slot liberado">
      <bpmn:documentation>Publica evento de negócio VENDA_PERDIDA para H3. | Origem: M2_End_CanceladoEntrega, M2_End_SemConfirmacao</bpmn:documentation>
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="tipoEventoNegocio">VENDA_PERDIDA</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>F_CA_COMPRA_23</bpmn:incoming>
      <bpmn:messageEventDefinition messageRef="Message_CA_EventoNegocio" camunda:delegateExpression="${businessEventPublisher}"/>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_CA_COMPRA_01" sourceRef="CP_Start_Necessidade" targetRef="CP_GW_MergeIntencao"/>
    <bpmn:sequenceFlow id="F_CA_COMPRA_02" sourceRef="CP_Start_Reacao" targetRef="CP_GW_MergeIntencao"/>
    <bpmn:sequenceFlow id="F_CA_COMPRA_03" sourceRef="CP_Start_NovaNecessidade" targetRef="CP_GW_MergeIntencao"/>
    <bpmn:sequenceFlow id="F_CA_COMPRA_04" sourceRef="CP_GW_MergeIntencao" targetRef="CP_CA_C1"/>
    <bpmn:sequenceFlow id="F_CA_COMPRA_05" sourceRef="CP_CA_C1" targetRef="CP_GW_Proposta"/>
    <bpmn:sequenceFlow id="F_CA_COMPRA_06" sourceRef="CP_B_ConsentimentoNegado" targetRef="CP_End_SemConsentimento"/>
    <bpmn:sequenceFlow id="F_CA_COMPRA_07" name="Sim" sourceRef="CP_GW_Proposta" targetRef="CP_CA_C2">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${propostaRelevante == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_CA_COMPRA_08" name="Não" sourceRef="CP_GW_Proposta" targetRef="CP_GW_SemOferta"/>
    <bpmn:sequenceFlow id="F_CA_COMPRA_09" sourceRef="CP_CA_C2" targetRef="CP_GW_Decisao"/>
    <bpmn:sequenceFlow id="F_CA_COMPRA_10" name="Aceite" sourceRef="CP_GW_Decisao" targetRef="CP_GW_MergeHabilitar">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${decisaoCliente == "ACEITE"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_CA_COMPRA_11" name="Recusa" sourceRef="CP_GW_Decisao" targetRef="CP_End_Recusa">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${decisaoCliente == "RECUSA"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_CA_COMPRA_12" name="Sem resposta" sourceRef="CP_GW_Decisao" targetRef="CP_End_SemDecisao"/>
    <bpmn:sequenceFlow id="F_CA_COMPRA_13" sourceRef="CP_Start_NovoBeneficiario" targetRef="CP_GW_MergeHabilitar"/>
    <bpmn:sequenceFlow id="F_CA_COMPRA_14" sourceRef="CP_GW_MergeHabilitar" targetRef="CP_CA_C3"/>
    <bpmn:sequenceFlow id="F_CA_COMPRA_15" sourceRef="CP_CA_C3" targetRef="CP_GW_Habilitado"/>
    <bpmn:sequenceFlow id="F_CA_COMPRA_16" name="Sim" sourceRef="CP_GW_Habilitado" targetRef="CP_GW_TipoDireito">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${direitoHabilitado == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_CA_COMPRA_17" name="Não" sourceRef="CP_GW_Habilitado" targetRef="CP_End_VendaPerdida"/>
    <bpmn:sequenceFlow id="F_CA_COMPRA_18" name="Plano" sourceRef="CP_GW_TipoDireito" targetRef="CP_End_Beneficiario">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${execution.getVariable("tipoDireito") == "PLANO"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_CA_COMPRA_19" name="Serviço" sourceRef="CP_GW_TipoDireito" targetRef="CP_End_DireitoHabilitado"/>
    <bpmn:sequenceFlow id="F_CA_COMPRA_20" sourceRef="CP_Start_ConsumoNaoRealizado" targetRef="CP_CA_C4"/>
    <bpmn:sequenceFlow id="F_CA_COMPRA_21" sourceRef="CP_CA_C4" targetRef="CP_GW_Manutencao"/>
    <bpmn:sequenceFlow id="F_CA_COMPRA_22" name="Novo slot confirmado" sourceRef="CP_GW_Manutencao" targetRef="CP_GW_MergeHabilitar">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${resultadoManutencao == "REMARCADO"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_CA_COMPRA_23" name="Cancelado / sem confirmação" sourceRef="CP_GW_Manutencao" targetRef="CP_End_DireitoEncerrado"/>
    <bpmn:sequenceFlow id="F_CA_COMPRA_24" name="Não — nutrir" sourceRef="CP_GW_SemOferta" targetRef="CP_End_Nutrir"/>
    <bpmn:sequenceFlow id="F_CA_COMPRA_25" name="Sim — necessidade não atendida" sourceRef="CP_GW_SemOferta" targetRef="CP_GW_MergeSuporte">
      <bpmn:extensionElements>
        <camunda:executionListener expression="${execution.setVariable('motivoDificuldade', 'SEM_OFERTA')}" event="take"/>
      </bpmn:extensionElements>
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${origemIntencao != "RECOMENDACAO" &amp;&amp; execution.getVariable("transicao") != "T-07"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_CA_COMPRA_26" name="Contestar / falar com humano" sourceRef="CP_GW_Habilitado" targetRef="CP_GW_MergeSuporte">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${execution.getVariable("encaminharSuporte") == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_CA_COMPRA_27" sourceRef="CP_GW_MergeSuporte" targetRef="CP_End_Suporte"/>
    <bpmn:sequenceFlow id="F_CA_COMPRA_28" name="Sem slot equivalente" sourceRef="CP_GW_Manutencao" targetRef="CP_End_Recovery">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${resultadoManutencao == "SEM_SLOT"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:exclusiveGateway id="CP_GW_MergeSuporte" name="">
      <bpmn:documentation>Junção dos encaminhamentos interruptivos ao SUPORTE (RT-02, RT-03).</bpmn:documentation>
      <bpmn:incoming>F_CA_COMPRA_25</bpmn:incoming>
      <bpmn:incoming>F_CA_COMPRA_26</bpmn:incoming>
      <bpmn:outgoing>F_CA_COMPRA_27</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="CP_End_Suporte" name="Encaminhado ao SUPORTE com contexto da compra">
      <bpmn:documentation>T-09 → SUPORTE EV-S01 (SP_Start_Contato, origemSuporte = CLIENTE → S1 contexto → S2 triagem). A jornada de compra encerra aqui; o caso passa a ser do SUPORTE e, se a compra puder seguir, volta por T-07 → EV-C05 com o mesmo Journey ID (o cliente não recomeça). Payload: journeyId, clienteId, canal, mensagemCliente, etapaCompra, motivoDificuldade ∈ {SEM_OFERTA, CONTESTACAO_NEGATIVA}, contextoCompra (proposta, agendamentoId, autorizacaoId, motivoNegativa). ⚠️ PD-RT-03: contestação deve ir a HUMANO em S2 (regra a incluir em CA 3). ⚠️ LA-04: o processo de recurso/contestação continua sem modelagem. | Origem: [PROPOSTO] — RT-02, RT-03</bpmn:documentation>
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="transicao">T-09</camunda:inputParameter>
          <camunda:inputParameter name="mensagemCliente">${motivoDificuldade}</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>F_CA_COMPRA_27</bpmn:incoming>
      <bpmn:messageEventDefinition messageRef="Message_CA_ContatoCliente" camunda:delegateExpression="${journeyTransitionPublisher}"/>
    </bpmn:endEvent>
    <bpmn:endEvent id="CP_End_Recovery" name="Encaminhado ao SUPORTE para recuperar o direito">
      <bpmn:documentation>RT-04 [PROPOSTO]. T-10 → SUPORTE EV-S02 (SP_Start_Insatisfacao, origemSuporte = RECOVERY): S1 avisa "estamos cuidando" (H2) e S3 faz service recovery humano em até 2h, com escalonamento ao supervisor. Motivo: o consumo não aconteceu (T-02) e a organização não conseguiu oferecer slot equivalente — o cliente ficou sem o cuidado. Payload: journeyId, clienteId, statusEntrega, agendamentoId, motivoDificuldade = SEM_SLOT_EQUIVALENTE. | Origem: [PROPOSTO] — C4_T_Reagendar sem caminho de falha na origem</bpmn:documentation>
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="transicao">T-10</camunda:inputParameter>
          <camunda:inputParameter name="motivoDificuldade">SEM_SLOT_EQUIVALENTE</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>F_CA_COMPRA_28</bpmn:incoming>
      <bpmn:messageEventDefinition messageRef="Message_CA_ExperienciaInsatisfatoria" camunda:delegateExpression="${journeyTransitionPublisher}"/>
    </bpmn:endEvent>
    <bpmn:subProcess id="CP_ES_Ajuda" name="Atender pedido de ajuda durante a compra" triggeredByEvent="true">
      <bpmn:documentation>RT-01 [PROPOSTO]. Vale enquanto a instância de COMPRA estiver ativa (C1, C2, C3 ou C4): dúvida sobre a proposta, cobertura, prazo de autorização "em análise", falha no aceite de 1 clique, dificuldade com o novo slot. O cliente aciona "falar com atendimento" no canal da jornada (app, link do lembrete H2, tela de erro). Não interrompe: a compra continua esperando a decisão do cliente com o mesmo Journey ID. ⚠️ PD-RT-02: definir se o pedido de ajuda suspende/estende prazoMaximoDecisao (C2/C4); hoje o slot pode ser liberado enquanto o caso está no SUPORTE (depende também de PD-02).</bpmn:documentation>
      <bpmn:property id="Property_CP_ES_Ajuda_targetRef" name="__targetRef_placeholder"/>
      <bpmn:dataInputAssociation id="DIA_INS_011_1">
        <bpmn:sourceRef>DOR_INS_011_1</bpmn:sourceRef>
        <bpmn:targetRef>Property_CP_ES_Ajuda_targetRef</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:startEvent id="CP_ES_Start_Ajuda" name="Cliente pede ajuda" isInterrupting="false">
        <bpmn:documentation>Mensagem correlacionada pelo Journey ID (business key). Payload: clienteId, canal, mensagemCliente.</bpmn:documentation>
        <bpmn:outgoing>F_CA_COMPRA_29</bpmn:outgoing>
        <bpmn:messageEventDefinition messageRef="Message_CA_PedidoAjudaCompra"/>
      </bpmn:startEvent>
      <bpmn:endEvent id="CP_ES_End_Ajuda" name="Pedido encaminhado ao SUPORTE — compra segue">
        <bpmn:documentation>T-09 → SUPORTE EV-S01 (origemSuporte = CLIENTE) com etapaCompra e motivoDificuldade = PEDIDO_AJUDA. O caso de SUPORTE nasce com o contexto da compra (o cliente não repete a história).</bpmn:documentation>
        <bpmn:extensionElements>
          <camunda:inputOutput>
            <camunda:inputParameter name="transicao">T-09</camunda:inputParameter>
            <camunda:inputParameter name="motivoDificuldade">PEDIDO_AJUDA</camunda:inputParameter>
          </camunda:inputOutput>
        </bpmn:extensionElements>
        <bpmn:incoming>F_CA_COMPRA_29</bpmn:incoming>
        <bpmn:messageEventDefinition messageRef="Message_CA_ContatoCliente" camunda:delegateExpression="${journeyTransitionPublisher}"/>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="F_CA_COMPRA_29" sourceRef="CP_ES_Start_Ajuda" targetRef="CP_ES_End_Ajuda"/>
    </bpmn:subProcess>
    <bpmn:dataStoreReference id="DSR_INS_005_1" name="Catálogo comercial vigente (produtos/planos e regras comerciais)" dataStoreRef="DS_INS_005">
      <bpmn:documentation>Insumo INS-005 · Origem: SUB-01 §2.4 Insumo (JIT); SUB-01 §2.4 · coluna Subprocesso genérico; SUB-01 §2.4 · coluna Entrada</bpmn:documentation>
    </bpmn:dataStoreReference>
    <bpmn:dataObject id="DO_INS_006_2" name="Proposta (elegível / validada)">
      <bpmn:documentation>Insumo INS-006 · Origem: SUB-01 §2.4 e §2.5 Insumo (JIT); SUB-01 §2.4 · coluna Saída; SUB-01 §2.5 · coluna Entrada; CA_1 · C1_T_Cruzar · documentation ⚠️ AMBIGUIDADE — SUB-01 usa 'Proposta elegível' (§2.4, Saída) e 'Proposta validada' (§2.5, Entrada); tratadas como o mesmo objeto em estados diferentes. A saída foi ligada a C1_T_Cruzar (documentation declara 'Produz ... a proposta'), e não à callActivity CP_CA_C1, cuja documentation não declara produção. Alternativas: dois DO distintos; ou saída também em CP_CA_C1.</bpmn:documentation>
    </bpmn:dataObject>
    <bpmn:dataObjectReference id="DOR_INS_006_2" name="Proposta (elegível / validada)" dataObjectRef="DO_INS_006_2">
      <bpmn:documentation>Insumo INS-006 · Origem: SUB-01 §2.4 e §2.5 Insumo (JIT); SUB-01 §2.4 · coluna Saída; SUB-01 §2.5 · coluna Entrada; CA_1 · C1_T_Cruzar · documentation ⚠️ AMBIGUIDADE — SUB-01 usa 'Proposta elegível' (§2.4, Saída) e 'Proposta validada' (§2.5, Entrada); tratadas como o mesmo objeto em estados diferentes. A saída foi ligada a C1_T_Cruzar (documentation declara 'Produz ... a proposta'), e não à callActivity CP_CA_C1, cuja documentation não declara produção. Alternativas: dois DO distintos; ou saída também em CP_CA_C1.</bpmn:documentation>
    </bpmn:dataObjectReference>
    <bpmn:dataObject id="DO_INS_007_1" name="Documentação contratual e condições comerciais aprovadas">
      <bpmn:documentation>Insumo INS-007 · Origem: SUB-01 §2.5 Insumo (JIT); SUB-01 §2.5 · coluna Subprocesso genérico</bpmn:documentation>
    </bpmn:dataObject>
    <bpmn:dataObjectReference id="DOR_INS_007_1" name="Documentação contratual e condições comerciais aprovadas" dataObjectRef="DO_INS_007_1">
      <bpmn:documentation>Insumo INS-007 · Origem: SUB-01 §2.5 Insumo (JIT); SUB-01 §2.5 · coluna Subprocesso genérico</bpmn:documentation>
    </bpmn:dataObjectReference>
    <bpmn:dataObject id="DO_INS_008_1" name="Dados cadastrais e documentos para habilitação">
      <bpmn:documentation>Insumo INS-008 · Origem: SUB-01 §2.6 Insumo (JIT); SUB-01 §2.6 · coluna Subprocesso genérico; SUB-01 §2.6 · coluna Entrada</bpmn:documentation>
    </bpmn:dataObject>
    <bpmn:dataObjectReference id="DOR_INS_008_1" name="Dados cadastrais e documentos para habilitação" dataObjectRef="DO_INS_008_1">
      <bpmn:documentation>Insumo INS-008 · Origem: SUB-01 §2.6 Insumo (JIT); SUB-01 §2.6 · coluna Subprocesso genérico; SUB-01 §2.6 · coluna Entrada</bpmn:documentation>
    </bpmn:dataObjectReference>
    <bpmn:dataObject id="DO_INS_009_1" name="Dados de vigência e regras de manutenção/renovação">
      <bpmn:documentation>Insumo INS-009 · Origem: SUB-01 §2.7 Insumo (JIT); SUB-01 §2.7 · coluna Subprocesso genérico ⚠️ AMBIGUIDADE — Natureza DS × DO dúbia: 'dados de vigência' são dados do contrato instanciado (DO), mas 'regras de manutenção/renovação' podem residir em repositório de regras (DS). A fonte não nomeia base. Modelado como DO; alternativa: DS para as regras e DO para os dados de vigência.</bpmn:documentation>
    </bpmn:dataObject>
    <bpmn:dataObjectReference id="DOR_INS_009_1" name="Dados de vigência e regras de manutenção/renovação" dataObjectRef="DO_INS_009_1">
      <bpmn:documentation>Insumo INS-009 · Origem: SUB-01 §2.7 Insumo (JIT); SUB-01 §2.7 · coluna Subprocesso genérico ⚠️ AMBIGUIDADE — Natureza DS × DO dúbia: 'dados de vigência' são dados do contrato instanciado (DO), mas 'regras de manutenção/renovação' podem residir em repositório de regras (DS). A fonte não nomeia base. Modelado como DO; alternativa: DS para as regras e DO para os dados de vigência.</bpmn:documentation>
    </bpmn:dataObjectReference>
    <bpmn:dataStoreReference id="DSR_INS_010_1" name="Histórico de consumo" dataStoreRef="DS_INS_010">
      <bpmn:documentation>Insumo INS-010 · Origem: SUB-01 §2.7 Insumo (JIT); SUB-01 §2.7 · coluna Entrada</bpmn:documentation>
    </bpmn:dataStoreReference>
    <bpmn:dataObject id="DO_INS_011_1" name="Contexto da jornada de compra em andamento">
      <bpmn:documentation>Insumo INS-011 · Origem: SUB-01 §2.8 Insumo (JIT); SUB-01 §2.8 · coluna Subprocesso genérico; SUB-01 §2.8 · coluna Entrada; CA_1 · CP_ES_End_Ajuda · documentation ⚠️ AMBIGUIDADE — CP_ES_Ajuda é subprocesso de evento (triggeredByEvent) expandido; associação de entrada ao próprio subprocesso segue o mapeamento caixa → elemento do SUB-01 §1. Alternativa: entrada no evento de fim interno CP_ES_End_Ajuda, cuja documentation diz que o caso de SUPORTE nasce com o contexto da compra.</bpmn:documentation>
    </bpmn:dataObject>
    <bpmn:dataObjectReference id="DOR_INS_011_1" name="Contexto da jornada de compra em andamento" dataObjectRef="DO_INS_011_1">
      <bpmn:documentation>Insumo INS-011 · Origem: SUB-01 §2.8 Insumo (JIT); SUB-01 §2.8 · coluna Subprocesso genérico; SUB-01 §2.8 · coluna Entrada; CA_1 · CP_ES_End_Ajuda · documentation ⚠️ AMBIGUIDADE — CP_ES_Ajuda é subprocesso de evento (triggeredByEvent) expandido; associação de entrada ao próprio subprocesso segue o mapeamento caixa → elemento do SUB-01 §1. Alternativa: entrada no evento de fim interno CP_ES_End_Ajuda, cuja documentation diz que o caso de SUPORTE nasce com o contexto da compra.</bpmn:documentation>
    </bpmn:dataObjectReference>
  </bpmn:process>
  <bpmn:process id="Process_CA_COMPRA_C1_EntenderRecomendar" name="C1 — Entender a necessidade e recomendar" isExecutable="true" camunda:versionTag="3.1.0-rt-suporte" camunda:historyTimeToLive="180">
    <bpmn:documentation>Compor UMA proposta de cuidado relevante, explicável e viável (ARQ-01 §4.3). Consentimento verificado uma única vez com as duas finalidades (SO-02).</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_Process_CA_COMPRA_C1_EntenderRecomendar">
      <bpmn:lane id="LN_CA1_C1_VerificadorIdentidade" name="Verificador de identidade">
        <bpmn:documentation>Dimensão: Staff · Origem: SUB-01 §2.9; §3 · Ref: C1_CA_H1</bpmn:documentation>
        <bpmn:flowNodeRef>C1_Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C1_CA_H1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LN_CA1_C1_ModelagemGrowth" name="Modelagem e growth (motor de recomendação)">
        <bpmn:documentation>Dimensão: Staff · Origem: SUB-01 §2.10 · Ref: C1_CA_NBA</bpmn:documentation>
        <bpmn:flowNodeRef>C1_CA_NBA</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C1_T_Reward</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C1_End_Proposta</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LN_CA1_C1_ConsultorComercial" name="Consultor comercial">
        <bpmn:documentation>Dimensão: Staff · Origem: SUB-01 §2.4 · Ref: CP_CA_C1</bpmn:documentation>
        <bpmn:flowNodeRef>C1_T_Cruzar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C1_GW_Proposta</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C1_End_SemProposta</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LN_CA1_C1_AgendaCapacidade" name="Agenda e capacidade">
        <bpmn:documentation>Dimensão: Slot · Origem: Rótulo (agenda e capacidade de acesso) + SUB-01 §3 (vaga na rede credenciada) · Ref: UT_CA_U1</bpmn:documentation>
        <bpmn:flowNodeRef>C1_T_Agenda</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C1_T_Capacidade</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="C1_Start" name="Intenção do cliente recebida">
      <bpmn:outgoing>F_CA_COMPRA_C1_EntenderRecomendar_01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:callActivity id="C1_CA_H1" name="Verificar identidade e consentimento" camunda:asyncBefore="true" calledElement="Process_CA_H1_IdentidadeConsentimento">
      <bpmn:documentation>Origem: M2_CA_Consentimento + M1_CA_ConsentimentoNBA (SO-02)</bpmn:documentation>
      <bpmn:documentation>Contrato de variáveis a confirmar com a equipe: este passo pode produzir/consumir variáveis em execução (delegados/formulários) não declaradas no modelo; a lista explícita reflete o que o próprio modelo comprova.</bpmn:documentation>
      <bpmn:extensionElements>
        <camunda:in businessKey="#{execution.processBusinessKey}"/>
        <camunda:in sourceExpression="personalizacao,agendamento" target="finalidade"/>
        <camunda:out source="consentimentoValido" target="consentimentoValido"/>
        <camunda:out source="identidadeUnificada" target="identidadeUnificada"/>
      </bpmn:extensionElements>
      <bpmn:incoming>F_CA_COMPRA_C1_EntenderRecomendar_01</bpmn:incoming>
      <bpmn:outgoing>F_CA_COMPRA_C1_EntenderRecomendar_02</bpmn:outgoing>
      <bpmn:property id="Property_C1_CA_H1_targetRef" name="__targetRef_placeholder"/>
      <bpmn:dataInputAssociation id="DIA_INS_004_1">
        <bpmn:sourceRef>DOR_INS_004_1</bpmn:sourceRef>
        <bpmn:targetRef>Property_C1_CA_H1_targetRef</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:callActivity>
    <bpmn:callActivity id="C1_CA_NBA" name="Calcular próxima melhor ação" camunda:asyncBefore="true" calledElement="Process_CA_H3_ProximaMelhorAcao">
      <bpmn:documentation>Origem: M1_CA_NBA</bpmn:documentation>
      <bpmn:documentation>Contrato de variáveis a confirmar com a equipe: este passo pode produzir/consumir variáveis em execução (delegados/formulários) não declaradas no modelo; a lista explícita reflete o que o próprio modelo comprova.</bpmn:documentation>
      <bpmn:documentation>Guard-rail: a IA apenas recomenda — negativa, decisão clínica e suspeita de fraude são sempre humanas. Proibido usar dados de saúde para seleção de risco (LGPD art. 11 §5º).</bpmn:documentation>
      <bpmn:extensionElements>
        <camunda:in businessKey="#{execution.processBusinessKey}"/>
        <camunda:in source="historicoSuficiente" target="historicoSuficiente"/>
        <camunda:in source="tierClinico" target="tierClinico"/>
      </bpmn:extensionElements>
      <bpmn:incoming>F_CA_COMPRA_C1_EntenderRecomendar_02</bpmn:incoming>
      <bpmn:outgoing>F_CA_COMPRA_C1_EntenderRecomendar_03</bpmn:outgoing>
      <bpmn:property id="Property_C1_CA_NBA_targetRef" name="__targetRef_placeholder"/>
      <bpmn:dataInputAssociation id="DIA_INS_012_1">
        <bpmn:sourceRef>DSR_INS_012_1</bpmn:sourceRef>
        <bpmn:targetRef>Property_C1_CA_NBA_targetRef</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataInputAssociation id="DIA_INS_013_1">
        <bpmn:sourceRef>DOR_INS_013_1</bpmn:sourceRef>
        <bpmn:targetRef>Property_C1_CA_NBA_targetRef</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataInputAssociation id="DIA_INS_014_1">
        <bpmn:sourceRef>DSR_INS_014_1</bpmn:sourceRef>
        <bpmn:targetRef>Property_C1_CA_NBA_targetRef</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:callActivity>
    <bpmn:serviceTask id="C1_T_Agenda" name="Consultar agenda em tempo real" camunda:asyncBefore="true" camunda:delegateExpression="${schedulingAIAgent}">
      <bpmn:documentation>Prestadores próprios + credenciados integrados (webhooks normalizados). | Origem: M2_T_AgendaIA</bpmn:documentation>
      <bpmn:incoming>F_CA_COMPRA_C1_EntenderRecomendar_03</bpmn:incoming>
      <bpmn:outgoing>F_CA_COMPRA_C1_EntenderRecomendar_04</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="C1_T_Cruzar" name="Cruzar perfil 360 com oferta de cuidado" camunda:asyncBefore="true" camunda:delegateExpression="${offerMatcherService}">
      <bpmn:documentation>Produz propostaRelevante e a proposta (slots candidatos, prestador, promessa de prazo de resultado), usando a recomendação da NBA. | Origem: M2_T_Cruzamento (consolidado com a NBA — SO-03)</bpmn:documentation>
      <bpmn:incoming>F_CA_COMPRA_C1_EntenderRecomendar_04</bpmn:incoming>
      <bpmn:outgoing>F_CA_COMPRA_C1_EntenderRecomendar_05</bpmn:outgoing>
      <bpmn:property id="Property_C1_T_Cruzar_targetRef" name="__targetRef_placeholder"/>
      <bpmn:dataInputAssociation id="DIA_INS_012_2">
        <bpmn:sourceRef>DSR_INS_012_1</bpmn:sourceRef>
        <bpmn:targetRef>Property_C1_T_Cruzar_targetRef</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="DOA_INS_006_1">
        <bpmn:targetRef>DOR_INS_006_1</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="C1_T_Capacidade" name="Aplicar política de capacidade de acesso" camunda:delegateExpression="${capacityPolicyService}">
      <bpmn:documentation>Booking limits por segmento clínico, overbooking calibrado por no-show, alocação por criticidade clínica — jamais por preço. | Origem: M2_T_Capacidade</bpmn:documentation>
      <bpmn:incoming>F_CA_COMPRA_C1_EntenderRecomendar_05</bpmn:incoming>
      <bpmn:outgoing>F_CA_COMPRA_C1_EntenderRecomendar_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="C1_GW_Proposta" name="Proposta composta?" default="F_CA_COMPRA_C1_EntenderRecomendar_08">
      <bpmn:documentation>Origem: M1_GW_Relevancia</bpmn:documentation>
      <bpmn:documentation>Regra: recomendar somente proposta relevante; sem relevância, encerrar sem proposta — dono: Consultor comercial</bpmn:documentation>
      <bpmn:documentation>Guard-rail de contratação: decisão de contratar é do cliente/humano; a automação prepara a decisão, nunca decide.</bpmn:documentation>
      <bpmn:incoming>F_CA_COMPRA_C1_EntenderRecomendar_06</bpmn:incoming>
      <bpmn:outgoing>F_CA_COMPRA_C1_EntenderRecomendar_07</bpmn:outgoing>
      <bpmn:outgoing>F_CA_COMPRA_C1_EntenderRecomendar_08</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="C1_T_Reward" name="Registrar recomendação para medir adesão" camunda:delegateExpression="${rewardTrackingService}">
      <bpmn:documentation>Reward fechado pela adesão real (desfecho em U4). | Origem: M1_T_RegistrarReward</bpmn:documentation>
      <bpmn:incoming>F_CA_COMPRA_C1_EntenderRecomendar_07</bpmn:incoming>
      <bpmn:outgoing>F_CA_COMPRA_C1_EntenderRecomendar_09</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="C1_End_Proposta" name="Proposta pronta para o cliente">
      <bpmn:incoming>F_CA_COMPRA_C1_EntenderRecomendar_09</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="C1_End_SemProposta" name="Sem proposta relevante">
      <bpmn:incoming>F_CA_COMPRA_C1_EntenderRecomendar_08</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_CA_COMPRA_C1_EntenderRecomendar_01" sourceRef="C1_Start" targetRef="C1_CA_H1"/>
    <bpmn:sequenceFlow id="F_CA_COMPRA_C1_EntenderRecomendar_02" sourceRef="C1_CA_H1" targetRef="C1_CA_NBA"/>
    <bpmn:sequenceFlow id="F_CA_COMPRA_C1_EntenderRecomendar_03" sourceRef="C1_CA_NBA" targetRef="C1_T_Agenda"/>
    <bpmn:sequenceFlow id="F_CA_COMPRA_C1_EntenderRecomendar_04" sourceRef="C1_T_Agenda" targetRef="C1_T_Cruzar"/>
    <bpmn:sequenceFlow id="F_CA_COMPRA_C1_EntenderRecomendar_05" sourceRef="C1_T_Cruzar" targetRef="C1_T_Capacidade"/>
    <bpmn:sequenceFlow id="F_CA_COMPRA_C1_EntenderRecomendar_06" sourceRef="C1_T_Capacidade" targetRef="C1_GW_Proposta"/>
    <bpmn:sequenceFlow id="F_CA_COMPRA_C1_EntenderRecomendar_07" name="Sim" sourceRef="C1_GW_Proposta" targetRef="C1_T_Reward">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${propostaRelevante == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_CA_COMPRA_C1_EntenderRecomendar_08" name="Não" sourceRef="C1_GW_Proposta" targetRef="C1_End_SemProposta"/>
    <bpmn:sequenceFlow id="F_CA_COMPRA_C1_EntenderRecomendar_09" sourceRef="C1_T_Reward" targetRef="C1_End_Proposta"/>
    <bpmn:dataObject id="DO_INS_004_1" name="Dados de identificação do cliente (dado cadastral/documento de identificação)">
      <bpmn:documentation>Insumo INS-004 · Origem: SUB-01 §2.3, §2.9, §2.22 Insumo (JIT); §3; SUB-01 §2.3 · coluna Subprocesso genérico; SUB-01 §2.3 · coluna Entrada; SUB-01 §2.9 · coluna Observação; SUB-01 §2.22 · coluna Observação; SUB-01 §3 · coluna Caixas de origem</bpmn:documentation>
    </bpmn:dataObject>
    <bpmn:dataObjectReference id="DOR_INS_004_1" name="Dados de identificação do cliente (dado cadastral/documento de identificação)" dataObjectRef="DO_INS_004_1">
      <bpmn:documentation>Insumo INS-004 · Origem: SUB-01 §2.3, §2.9, §2.22 Insumo (JIT); §3; SUB-01 §2.3 · coluna Subprocesso genérico; SUB-01 §2.3 · coluna Entrada; SUB-01 §2.9 · coluna Observação; SUB-01 §2.22 · coluna Observação; SUB-01 §3 · coluna Caixas de origem</bpmn:documentation>
    </bpmn:dataObjectReference>
    <bpmn:dataObject id="DO_INS_006_1" name="Proposta (elegível / validada)">
      <bpmn:documentation>Insumo INS-006 · Origem: SUB-01 §2.4 e §2.5 Insumo (JIT); SUB-01 §2.4 · coluna Saída; SUB-01 §2.5 · coluna Entrada; CA_1 · C1_T_Cruzar · documentation ⚠️ AMBIGUIDADE — SUB-01 usa 'Proposta elegível' (§2.4, Saída) e 'Proposta validada' (§2.5, Entrada); tratadas como o mesmo objeto em estados diferentes. A saída foi ligada a C1_T_Cruzar (documentation declara 'Produz ... a proposta'), e não à callActivity CP_CA_C1, cuja documentation não declara produção. Alternativas: dois DO distintos; ou saída também em CP_CA_C1.</bpmn:documentation>
    </bpmn:dataObject>
    <bpmn:dataObjectReference id="DOR_INS_006_1" name="Proposta (elegível / validada)" dataObjectRef="DO_INS_006_1">
      <bpmn:documentation>Insumo INS-006 · Origem: SUB-01 §2.4 e §2.5 Insumo (JIT); SUB-01 §2.4 · coluna Saída; SUB-01 §2.5 · coluna Entrada; CA_1 · C1_T_Cruzar · documentation ⚠️ AMBIGUIDADE — SUB-01 usa 'Proposta elegível' (§2.4, Saída) e 'Proposta validada' (§2.5, Entrada); tratadas como o mesmo objeto em estados diferentes. A saída foi ligada a C1_T_Cruzar (documentation declara 'Produz ... a proposta'), e não à callActivity CP_CA_C1, cuja documentation não declara produção. Alternativas: dois DO distintos; ou saída também em CP_CA_C1.</bpmn:documentation>
    </bpmn:dataObjectReference>
    <bpmn:dataStoreReference id="DSR_INS_012_1" name="Perfil 360 do cliente" dataStoreRef="DS_INS_012">
      <bpmn:documentation>Insumo INS-012 · Origem: SUB-01 §2.10 e §2.11 Insumo (JIT); SUB-01 §2.10 · coluna Entrada; SUB-01 §2.11 · coluna Saída; CA_0 · NBA_T_Contexto · rótulo; CA_0 · EC_T_Consolidar · rótulo; CA_0 · EC_T_Consolidar · documentation; CA_1 · C1_T_Cruzar · rótulo; CA_3 · S1_T_Contexto · rótulo ⚠️ AMBIGUIDADE — SUB-01 nomeia 'Perfil do cliente' (§2.10) e 'Perfil 360 inicial consolidado' (§2.11) sem declará-los idênticos; a identidade como um único repositório vem dos rótulos do diagrama ('perfil 360' em NBA_T_Contexto, EC_T_Consolidar, C1_T_Cruzar e '360' em S1_T_Contexto). A saída em EC_T_Consolidar usa 'Produz versaoPerfil' + rótulo 'versionar perfil 360'. Alternativa: DS separados por arquivo/finalidade.</bpmn:documentation>
    </bpmn:dataStoreReference>
    <bpmn:dataObject id="DO_INS_013_1" name="Dados de contexto do cliente (contexto de sessão)">
      <bpmn:documentation>Insumo INS-013 · Origem: SUB-01 §2.10 Insumo (JIT); SUB-01 §2.10 · coluna Subprocesso genérico; CA_0 · NBA_T_Contexto · rótulo</bpmn:documentation>
    </bpmn:dataObject>
    <bpmn:dataObjectReference id="DOR_INS_013_1" name="Dados de contexto do cliente (contexto de sessão)" dataObjectRef="DO_INS_013_1">
      <bpmn:documentation>Insumo INS-013 · Origem: SUB-01 §2.10 Insumo (JIT); SUB-01 §2.10 · coluna Subprocesso genérico; CA_0 · NBA_T_Contexto · rótulo</bpmn:documentation>
    </bpmn:dataObjectReference>
    <bpmn:dataStoreReference id="DSR_INS_014_1" name="Catálogo de ofertas" dataStoreRef="DS_INS_014">
      <bpmn:documentation>Insumo INS-014 · Origem: SUB-01 §2.10 Insumo (JIT); SUB-01 §2.10 · coluna Subprocesso genérico; SUB-01 §2.10 · coluna Entrada ⚠️ AMBIGUIDADE — SUB-01 §2.10 cita 'catálogo de ofertas' e §2.4 cita 'catálogo de produtos/planos e regras comerciais vigentes' (INS-005), ambos no arquivo CA_1, sem declará-los idênticos. Modelados como dois DS; alternativa: um único DS no CA_1 com duas referências.</bpmn:documentation>
    </bpmn:dataStoreReference>
  </bpmn:process>
  <bpmn:process id="Process_CA_COMPRA_C2_DecidirContratar" name="C2 — Decidir e contratar" isExecutable="true" camunda:versionTag="3.1.0-rt-suporte" camunda:historyTimeToLive="180">
    <bpmn:documentation>Levar o cliente à decisão com o menor atrito (1 clique, sem checkout). Timer de 24h passa a lembrar e continuar esperando (FR-01).</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_Process_CA_COMPRA_C2_DecidirContratar">
      <bpmn:lane id="LN_CA1_C2_ContratacaoBackOfficeComercial" name="Contratação e back-office comercial">
        <bpmn:documentation>Dimensão: Staff · Origem: SUB-01 §2.5 · Ref: CP_CA_C2</bpmn:documentation>
        <bpmn:flowNodeRef>C2_Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C2_EV_Lembrete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C2_End_Lembrete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C2_EV_Agendado</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C2_End_Aceite</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C2_End_Recusa</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C2_End_SemResposta</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C2_T_Aceite</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C2_B_PrazoMax</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C2_B_Lembrete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C2_B_Recusa</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="C2_Start" name="Proposta apresentada">
      <bpmn:outgoing>F_CA_COMPRA_C2_DecidirContratar_01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:intermediateThrowEvent id="C2_EV_Lembrete" name="Lembrar cliente da proposta">
      <bpmn:documentation>Aciona H2 (Comunicar o cliente) com o Journey ID. Marco: REENGAJAR_PROPOSTA. | Origem: M2_End_SLAceite → M3_Start_Reengajar</bpmn:documentation>
      <bpmn:documentation>Lembrete agendado (previsão de ciclo): distinto de marco factual.</bpmn:documentation>
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="marcoJornada">REENGAJAR_PROPOSTA</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>F_CA_COMPRA_C2_DecidirContratar_05</bpmn:incoming>
      <bpmn:outgoing>F_CA_COMPRA_C2_DecidirContratar_06</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_CA_ComunicarCliente" camunda:delegateExpression="${comunicarClientePublisher}"/>
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="C2_End_Lembrete" name="Lembrete enviado — segue aguardando">
      <bpmn:incoming>F_CA_COMPRA_C2_DecidirContratar_06</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateThrowEvent id="C2_EV_Agendado" name="Marco: agendado">
      <bpmn:documentation>Promessa de data/hora e prazo. Cada marco distingue estado factual de estimativa. | Origem: M2_EV_MarcoAgendado</bpmn:documentation>
      <bpmn:documentation>Marco factual: registra o que ACONTECEU com o cliente, não estimativa nem previsão.</bpmn:documentation>
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="marcoJornada">AGENDADO</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>F_CA_COMPRA_C2_DecidirContratar_02</bpmn:incoming>
      <bpmn:outgoing>F_CA_COMPRA_C2_DecidirContratar_03</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_CA_ComunicarCliente" camunda:delegateExpression="${comunicarClientePublisher}"/>
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="C2_End_Aceite" name="Agendamento confirmado">
      <bpmn:extensionElements>
        <camunda:executionListener expression="${execution.setVariable('decisaoCliente', 'ACEITE')}" event="start"/>
      </bpmn:extensionElements>
      <bpmn:incoming>F_CA_COMPRA_C2_DecidirContratar_03</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="C2_End_Recusa" name="Recusa registrada">
      <bpmn:extensionElements>
        <camunda:executionListener expression="${execution.setVariable('decisaoCliente', 'RECUSA')}" event="start"/>
      </bpmn:extensionElements>
      <bpmn:incoming>F_CA_COMPRA_C2_DecidirContratar_04</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="C2_End_SemResposta" name="Sem decisão no prazo">
      <bpmn:extensionElements>
        <camunda:executionListener expression="${execution.setVariable('decisaoCliente', 'SEM_RESPOSTA')}" event="start"/>
      </bpmn:extensionElements>
      <bpmn:incoming>F_CA_COMPRA_C2_DecidirContratar_07</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_CA_COMPRA_C2_DecidirContratar_01" sourceRef="C2_Start" targetRef="C2_T_Aceite"/>
    <bpmn:sequenceFlow id="F_CA_COMPRA_C2_DecidirContratar_02" sourceRef="C2_T_Aceite" targetRef="C2_EV_Agendado"/>
    <bpmn:sequenceFlow id="F_CA_COMPRA_C2_DecidirContratar_03" sourceRef="C2_EV_Agendado" targetRef="C2_End_Aceite"/>
    <bpmn:sequenceFlow id="F_CA_COMPRA_C2_DecidirContratar_04" sourceRef="C2_B_Recusa" targetRef="C2_End_Recusa"/>
    <bpmn:sequenceFlow id="F_CA_COMPRA_C2_DecidirContratar_05" sourceRef="C2_B_Lembrete" targetRef="C2_EV_Lembrete"/>
    <bpmn:sequenceFlow id="F_CA_COMPRA_C2_DecidirContratar_06" sourceRef="C2_EV_Lembrete" targetRef="C2_End_Lembrete"/>
    <bpmn:sequenceFlow id="F_CA_COMPRA_C2_DecidirContratar_07" sourceRef="C2_B_PrazoMax" targetRef="C2_End_SemResposta"/>
    <bpmn:userTask id="C2_T_Aceite" name="Decidir sobre a proposta (1 clique)" camunda:formKey="ced:aceite-slot" camunda:assignee="${clienteId}">
      <bpmn:documentation>Formulário produz: agendamentoId, dataHoraServico, prestadorId, procedimentoId, promessaResultado. | Origem: M2_T_Aceite</bpmn:documentation>
      <bpmn:documentation>Guard-rail de contratação: decisão de contratar é do cliente/humano; a automação prepara a decisão, nunca decide.</bpmn:documentation>
      <bpmn:incoming>F_CA_COMPRA_C2_DecidirContratar_01</bpmn:incoming>
      <bpmn:outgoing>F_CA_COMPRA_C2_DecidirContratar_02</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="C2_B_PrazoMax" name="Prazo máximo de decisão" attachedToRef="C2_T_Aceite">
      <bpmn:documentation>⚠️ PD-02 [PENDENTE]: limite de espera/lembretes a definir pela Process Owner. | Origem: [SEM ORIGEM] — ARQ-01 FR-01</bpmn:documentation>
      <bpmn:documentation>Guard-rail de contratação: decisão de contratar é do cliente/humano; a automação prepara a decisão, nunca decide.</bpmn:documentation>
      <bpmn:outgoing>F_CA_COMPRA_C2_DecidirContratar_07</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">${prazoMaximoDecisao}</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="C2_B_Lembrete" name="24h sem resposta" cancelActivity="false" attachedToRef="C2_T_Aceite">
      <bpmn:documentation>Origem: M2_Boundary_SLAAceite (reposicionado)</bpmn:documentation>
      <bpmn:documentation>Guard-rail de contratação: decisão de contratar é do cliente/humano; a automação prepara a decisão, nunca decide.</bpmn:documentation>
      <bpmn:outgoing>F_CA_COMPRA_C2_DecidirContratar_05</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R/PT24H</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="C2_B_Recusa" name="Cliente recusou" attachedToRef="C2_T_Aceite">
      <bpmn:documentation>Origem: M2_Boundary_Cancelamento</bpmn:documentation>
      <bpmn:documentation>Guard-rail de contratação: decisão de contratar é do cliente/humano; a automação prepara a decisão, nunca decide.</bpmn:documentation>
      <bpmn:outgoing>F_CA_COMPRA_C2_DecidirContratar_04</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_CA_RecusaProposta"/>
    </bpmn:boundaryEvent>
  </bpmn:process>
  <bpmn:process id="Process_CA_COMPRA_C3_HabilitarDireito" name="C3 — Habilitar o direito" isExecutable="true" camunda:versionTag="3.1.0-rt-suporte" camunda:historyTimeToLive="180">
    <bpmn:documentation>Garantir cobertura e autorização, de preferência invisível ao cliente. Variante tipoDireito = PLANO (novo beneficiário) habilita o direito-base com perfil 360 inicial.</bpmn:documentation>
    <bpmn:documentation>C3 separa duas preocupações: habilitação da base do direito (tipo de direito, elegibilidade, direito ao plano) e autorização do serviço (autorização automática, requisição à operadora, pendências, negativas e parecer médico). Alterações de autorização não devem reusar caminhos de base, e vice-versa.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_Process_CA_COMPRA_C3_HabilitarDireito">
      <bpmn:lane id="LN_CA1_C3_CadastroOperacoes" name="Cadastro e operações">
        <bpmn:documentation>Dimensão: Staff · Origem: SUB-01 §2.6 · Ref: CP_CA_C3</bpmn:documentation>
        <bpmn:flowNodeRef>C3_Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C3_GW_Tipo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C3_GW_MergeEleg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C3_T_Elegibilidade</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C3_GW_Auto</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C3_T_AutoAutorizar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C3_GW_MergeAut</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C3_EV_Autorizado</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C3_End_Habilitado</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C3_GW_MergeReq</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C3_T_Requisitar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C3_EV_EmAnalise</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C3_GW_Espera</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C3_EV_Concedida</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C3_EV_Pendencia</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C3_EV_Negada</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C3_EV_Expirou</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C3_GW_Pendencia</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C3_GW_TipoNegativa</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LN_CA1_C3_DadosCRM" name="Dados e CRM (consolidação de perfil)">
        <bpmn:documentation>Dimensão: Staff · Origem: SUB-01 §2.11; §3 · Ref: C3_CA_Perfil</bpmn:documentation>
        <bpmn:flowNodeRef>C3_CA_Perfil</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C3_End_Plano</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LN_CA1_C3_GovernancaClinica" name="Governança clínica">
        <bpmn:documentation>Dimensão: Staff · Origem: Rótulo e grupo executor de C3_T_Parecer</bpmn:documentation>
        <bpmn:flowNodeRef>C3_T_Parecer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C3_B_SLA_Parecer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C3_T_EscalarParecer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C3_End_SLA_Parecer</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LN_CA1_C3_CentraisExperiencia" name="Centrais de experiência">
        <bpmn:documentation>Dimensão: Staff · Origem: Rótulo e grupo executor de C3_T_Renegociar</bpmn:documentation>
        <bpmn:flowNodeRef>C3_GW_MergeReneg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C3_T_Renegociar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C3_GW_Alternativa</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C3_End_Perdida</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C3_End_Suporte</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C3_B_SLA_Renegociar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C3_T_EscalarRenegociar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C3_End_SLA_Renegociar</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="C3_Start" name="Direito a habilitar">
      <bpmn:outgoing>F_CA_COMPRA_C3_HabilitarDireito_01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="C3_GW_Tipo" name="Tipo de direito?" default="F_CA_COMPRA_C3_HabilitarDireito_03">
      <bpmn:documentation>Regra: trilha de habilitação por tipo de direito dentro da etapa C3 — dono: Cadastro e operações</bpmn:documentation>
      <bpmn:incoming>F_CA_COMPRA_C3_HabilitarDireito_01</bpmn:incoming>
      <bpmn:outgoing>F_CA_COMPRA_C3_HabilitarDireito_02</bpmn:outgoing>
      <bpmn:outgoing>F_CA_COMPRA_C3_HabilitarDireito_03</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:callActivity id="C3_CA_Perfil" name="Enriquecer perfil 360 inicial" camunda:asyncBefore="true" calledElement="Process_CA_H3_EnriquecerCliente">
      <bpmn:documentation>Origem: M1_CA_EnriquecerCliente</bpmn:documentation>
      <bpmn:documentation>Contrato de variáveis a confirmar com a equipe: este passo pode produzir/consumir variáveis em execução (delegados/formulários) não declaradas no modelo; a lista explícita reflete o que o próprio modelo comprova.</bpmn:documentation>
      <bpmn:extensionElements>
        <camunda:in businessKey="#{execution.processBusinessKey}"/>
      </bpmn:extensionElements>
      <bpmn:incoming>F_CA_COMPRA_C3_HabilitarDireito_02</bpmn:incoming>
      <bpmn:outgoing>F_CA_COMPRA_C3_HabilitarDireito_04</bpmn:outgoing>
      <bpmn:property id="Property_C3_CA_Perfil_targetRef" name="__targetRef_placeholder"/>
      <bpmn:dataInputAssociation id="DIA_INS_015_1">
        <bpmn:sourceRef>DOR_INS_015_1</bpmn:sourceRef>
        <bpmn:targetRef>Property_C3_CA_Perfil_targetRef</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataInputAssociation id="DIA_INS_016_1">
        <bpmn:sourceRef>DSR_INS_016_1</bpmn:sourceRef>
        <bpmn:targetRef>Property_C3_CA_Perfil_targetRef</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:callActivity>
    <bpmn:endEvent id="C3_End_Plano" name="Direito ao plano habilitado">
      <bpmn:extensionElements>
        <camunda:executionListener expression="${execution.setVariable('direitoHabilitado', true)}" event="start"/>
      </bpmn:extensionElements>
      <bpmn:incoming>F_CA_COMPRA_C3_HabilitarDireito_04</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="C3_GW_MergeEleg" name="">
      <bpmn:incoming>F_CA_COMPRA_C3_HabilitarDireito_03</bpmn:incoming>
      <bpmn:incoming>F_CA_COMPRA_C3_HabilitarDireito_30</bpmn:incoming>
      <bpmn:outgoing>F_CA_COMPRA_C3_HabilitarDireito_05</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="C3_T_Elegibilidade" name="Avaliar elegibilidade" camunda:asyncBefore="true" camunda:delegateExpression="${coverageRulesEngine}">
      <bpmn:documentation>Motor de regras. Produz autorizacaoAutomatica e decisaoAuditavel. | Origem: M2_T_Elegibilidade</bpmn:documentation>
      <bpmn:incoming>F_CA_COMPRA_C3_HabilitarDireito_05</bpmn:incoming>
      <bpmn:outgoing>F_CA_COMPRA_C3_HabilitarDireito_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="C3_GW_Auto" name="Autorização automática possível?" default="F_CA_COMPRA_C3_HabilitarDireito_08">
      <bpmn:documentation>Origem: M2_GW_RequerAutorizacao</bpmn:documentation>
      <bpmn:documentation>Regra: autorização automática quando a elegibilidade permitir; caso contrário, submeter requisição à operadora — dono: Cadastro e operações</bpmn:documentation>
      <bpmn:incoming>F_CA_COMPRA_C3_HabilitarDireito_06</bpmn:incoming>
      <bpmn:outgoing>F_CA_COMPRA_C3_HabilitarDireito_07</bpmn:outgoing>
      <bpmn:outgoing>F_CA_COMPRA_C3_HabilitarDireito_08</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="C3_T_AutoAutorizar" name="Emitir autorização automática" camunda:asyncBefore="true" camunda:delegateExpression="${autoAuthorizationService}">
      <bpmn:documentation>Produz autorizacaoId. Sem formulário, sem fila de guia. | Origem: M2_T_AutorizarAuto</bpmn:documentation>
      <bpmn:incoming>F_CA_COMPRA_C3_HabilitarDireito_07</bpmn:incoming>
      <bpmn:outgoing>F_CA_COMPRA_C3_HabilitarDireito_09</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="C3_GW_MergeAut" name="">
      <bpmn:documentation>Origem: M2_GW_JoinAutorizado</bpmn:documentation>
      <bpmn:incoming>F_CA_COMPRA_C3_HabilitarDireito_09</bpmn:incoming>
      <bpmn:incoming>F_CA_COMPRA_C3_HabilitarDireito_19</bpmn:incoming>
      <bpmn:outgoing>F_CA_COMPRA_C3_HabilitarDireito_10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateThrowEvent id="C3_EV_Autorizado" name="Marco: autorizado">
      <bpmn:documentation>Aciona H2 (Comunicar o cliente) com o Journey ID. Marco: AUTORIZADO. | Origem: M2_EV_MarcoAutorizado</bpmn:documentation>
      <bpmn:documentation>Marco factual: registra o que ACONTECEU com o cliente, não estimativa nem previsão.</bpmn:documentation>
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="marcoJornada">AUTORIZADO</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>F_CA_COMPRA_C3_HabilitarDireito_10</bpmn:incoming>
      <bpmn:outgoing>F_CA_COMPRA_C3_HabilitarDireito_11</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_CA_ComunicarCliente" camunda:delegateExpression="${comunicarClientePublisher}"/>
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="C3_End_Habilitado" name="Direito habilitado">
      <bpmn:extensionElements>
        <camunda:executionListener expression="${execution.setVariable('direitoHabilitado', true)}" event="start"/>
      </bpmn:extensionElements>
      <bpmn:incoming>F_CA_COMPRA_C3_HabilitarDireito_11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="C3_GW_MergeReq" name="">
      <bpmn:incoming>F_CA_COMPRA_C3_HabilitarDireito_08</bpmn:incoming>
      <bpmn:incoming>F_CA_COMPRA_C3_HabilitarDireito_21</bpmn:incoming>
      <bpmn:outgoing>F_CA_COMPRA_C3_HabilitarDireito_12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="C3_T_Requisitar" name="Submeter requisição de autorização" camunda:asyncBefore="true" camunda:delegateExpression="${authorizationRequestService}">
      <bpmn:documentation>Incrementa tentativasAutorizacao (teto = 3). | Origem: M2_T_ReqAutorizacao</bpmn:documentation>
      <bpmn:incoming>F_CA_COMPRA_C3_HabilitarDireito_12</bpmn:incoming>
      <bpmn:outgoing>F_CA_COMPRA_C3_HabilitarDireito_13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateThrowEvent id="C3_EV_EmAnalise" name="Marco: em análise">
      <bpmn:documentation>"Sua autorização está em análise; respondemos até &lt;prazo&gt;" — só se cumprível. | Origem: M2_EV_MarcoEmAnalise</bpmn:documentation>
      <bpmn:documentation>Marco factual: registra o que ACONTECEU com o cliente, não estimativa nem previsão.</bpmn:documentation>
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="marcoJornada">EM_ANALISE</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>F_CA_COMPRA_C3_HabilitarDireito_13</bpmn:incoming>
      <bpmn:outgoing>F_CA_COMPRA_C3_HabilitarDireito_14</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_CA_ComunicarCliente" camunda:delegateExpression="${comunicarClientePublisher}"/>
    </bpmn:intermediateThrowEvent>
    <bpmn:eventBasedGateway id="C3_GW_Espera" name="Aguardar desfecho da autorização">
      <bpmn:documentation>Origem: M2_GW_EsperaAutorizacao</bpmn:documentation>
      <bpmn:incoming>F_CA_COMPRA_C3_HabilitarDireito_14</bpmn:incoming>
      <bpmn:outgoing>F_CA_COMPRA_C3_HabilitarDireito_15</bpmn:outgoing>
      <bpmn:outgoing>F_CA_COMPRA_C3_HabilitarDireito_16</bpmn:outgoing>
      <bpmn:outgoing>F_CA_COMPRA_C3_HabilitarDireito_17</bpmn:outgoing>
      <bpmn:outgoing>F_CA_COMPRA_C3_HabilitarDireito_18</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="C3_EV_Concedida" name="Autorização concedida">
      <bpmn:documentation>Mensagem da Operadora. Payload: autorizacaoId. | Origem: M2_EV_Autorizado</bpmn:documentation>
      <bpmn:incoming>F_CA_COMPRA_C3_HabilitarDireito_15</bpmn:incoming>
      <bpmn:outgoing>F_CA_COMPRA_C3_HabilitarDireito_19</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_CA_AutorizacaoConcedida"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="C3_EV_Pendencia" name="Pendência documental">
      <bpmn:documentation>Origem: M2_EV_Excecao</bpmn:documentation>
      <bpmn:incoming>F_CA_COMPRA_C3_HabilitarDireito_16</bpmn:incoming>
      <bpmn:outgoing>F_CA_COMPRA_C3_HabilitarDireito_20</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_CA_AutorizacaoPendencia"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="C3_EV_Negada" name="Autorização negada">
      <bpmn:documentation>Payload: negativaDeCobertura, motivoNegativa. | Origem: M2_EV_Negada</bpmn:documentation>
      <bpmn:incoming>F_CA_COMPRA_C3_HabilitarDireito_17</bpmn:incoming>
      <bpmn:outgoing>F_CA_COMPRA_C3_HabilitarDireito_23</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_CA_AutorizacaoNegada"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="C3_EV_Expirou" name="Prazo de resposta expirado">
      <bpmn:documentation>⚠️ PD-01 / I-01: a origem rotula 72h e configura PT48H; valor mantido da origem até decisão, alinhado à RN 395/2016 (pergunta aberta Q3). | Origem: M2_EV_Expirou</bpmn:documentation>
      <bpmn:incoming>F_CA_COMPRA_C3_HabilitarDireito_18</bpmn:incoming>
      <bpmn:outgoing>F_CA_COMPRA_C3_HabilitarDireito_27</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT48H</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="C3_GW_Pendencia" name="Pendência resolvida e tentativas &lt; 3?" default="F_CA_COMPRA_C3_HabilitarDireito_22">
      <bpmn:documentation>Origem: M2_GW_PosExcecao</bpmn:documentation>
      <bpmn:documentation>Regra: pendência resolvida com menos de três tentativas segue nova verificação; acima do limite, encaminhar ao suporte — dono: Cadastro e operações</bpmn:documentation>
      <bpmn:incoming>F_CA_COMPRA_C3_HabilitarDireito_20</bpmn:incoming>
      <bpmn:outgoing>F_CA_COMPRA_C3_HabilitarDireito_21</bpmn:outgoing>
      <bpmn:outgoing>F_CA_COMPRA_C3_HabilitarDireito_22</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="C3_GW_TipoNegativa" name="Negativa de cobertura assistencial?" default="F_CA_COMPRA_C3_HabilitarDireito_25">
      <bpmn:documentation>Origem: M2_GW_TipoNegativa</bpmn:documentation>
      <bpmn:documentation>Regra: negativa de cobertura assistencial exige parecer médico; demais negativas seguem para alternativa — dono: Cadastro e operações</bpmn:documentation>
      <bpmn:incoming>F_CA_COMPRA_C3_HabilitarDireito_23</bpmn:incoming>
      <bpmn:outgoing>F_CA_COMPRA_C3_HabilitarDireito_24</bpmn:outgoing>
      <bpmn:outgoing>F_CA_COMPRA_C3_HabilitarDireito_25</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="C3_T_Parecer" name="Emitir parecer médico da negativa" camunda:formKey="ced:parecer-medico" camunda:candidateGroups="governanca-clinica">
      <bpmn:documentation>RN 424/2017 ANS — junta médica/desempatador em caso de divergência. | Origem: M2_T_ParecerMedico</bpmn:documentation>
      <bpmn:incoming>F_CA_COMPRA_C3_HabilitarDireito_24</bpmn:incoming>
      <bpmn:outgoing>F_CA_COMPRA_C3_HabilitarDireito_26</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="C3_B_SLA_Parecer" name="SLA 48h sem parecer" cancelActivity="false" attachedToRef="C3_T_Parecer">
      <bpmn:documentation>SLA proposto — confirmar com a equipe (valor ausente das fontes): 48h, mesmo prazo do catch de autorização (C3_EV_Expirou, PT48H). RN 424/2017: prazo contratual/regulatório a confirmar.</bpmn:documentation>
      <bpmn:outgoing>F_CA_COMPRA_C3_HabilitarDireito_33</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT48H</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="C3_T_EscalarParecer" name="Escalar parecer médico pendente">
      <bpmn:incoming>F_CA_COMPRA_C3_HabilitarDireito_33</bpmn:incoming>
      <bpmn:outgoing>F_CA_COMPRA_C3_HabilitarDireito_34</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="C3_End_SLA_Parecer" name="Parecer escalado — negativa retida">
      <bpmn:incoming>F_CA_COMPRA_C3_HabilitarDireito_34</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="C3_GW_MergeReneg" name="">
      <bpmn:documentation>Origem: M2_GW_MergeRenegociar</bpmn:documentation>
      <bpmn:incoming>F_CA_COMPRA_C3_HabilitarDireito_22</bpmn:incoming>
      <bpmn:incoming>F_CA_COMPRA_C3_HabilitarDireito_25</bpmn:incoming>
      <bpmn:incoming>F_CA_COMPRA_C3_HabilitarDireito_26</bpmn:incoming>
      <bpmn:incoming>F_CA_COMPRA_C3_HabilitarDireito_27</bpmn:incoming>
      <bpmn:outgoing>F_CA_COMPRA_C3_HabilitarDireito_28</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="C3_T_Renegociar" name="Oferecer alternativa ao cliente" camunda:formKey="ced:renegociar-servico" camunda:candidateGroups="centrais-experiencia">
      <bpmn:documentation>Toda negativa/expiração carrega caminho imediato: recurso, alternativa credenciada ou humano. RT-03: os caminhos "recurso" e "humano" passam a ser atendidos pelo SUPORTE (CA 3). ⚠️ LA-04: o recurso/contestação em si continua não modelado nas fontes. | Origem: M2_T_Renegociar</bpmn:documentation>
      <bpmn:incoming>F_CA_COMPRA_C3_HabilitarDireito_28</bpmn:incoming>
      <bpmn:outgoing>F_CA_COMPRA_C3_HabilitarDireito_29</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="C3_B_SLA_Renegociar" name="SLA 24h sem alternativa" cancelActivity="false" attachedToRef="C3_T_Renegociar">
      <bpmn:documentation>SLA proposto — confirmar com a equipe (valor ausente das fontes): 24h, ritmo de lembrete do corpus (C2_B_Lembrete / C4_B_Lembrete, R/PT24H).</bpmn:documentation>
      <bpmn:outgoing>F_CA_COMPRA_C3_HabilitarDireito_35</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT24H</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="C3_T_EscalarRenegociar" name="Escalar oferta de alternativa pendente">
      <bpmn:incoming>F_CA_COMPRA_C3_HabilitarDireito_35</bpmn:incoming>
      <bpmn:outgoing>F_CA_COMPRA_C3_HabilitarDireito_36</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="C3_End_SLA_Renegociar" name="Alternativa escalada — negativa retida">
      <bpmn:incoming>F_CA_COMPRA_C3_HabilitarDireito_36</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="C3_GW_Alternativa" name="Cliente aceitou alternativa?" default="F_CA_COMPRA_C3_HabilitarDireito_31">
      <bpmn:documentation>Três saídas (RT-03): aceitou alternativa → reavaliar elegibilidade; pediu contestação ou atendimento humano → SUPORTE; não aceitou → direito não habilitado. O formulário ced:renegociar-servico passa a produzir clienteSolicitouSuporte. | Origem: M2_GW_Renegociacao + M2_T_Renegociar ("recurso, alternativa credenciada ou humano")</bpmn:documentation>
      <bpmn:documentation>Regra: alternativa aceita segue habilitação; pedido de suporte encaminha ao suporte; sem resposta encerra — dono: Centrais de experiência</bpmn:documentation>
      <bpmn:incoming>F_CA_COMPRA_C3_HabilitarDireito_29</bpmn:incoming>
      <bpmn:outgoing>F_CA_COMPRA_C3_HabilitarDireito_30</bpmn:outgoing>
      <bpmn:outgoing>F_CA_COMPRA_C3_HabilitarDireito_31</bpmn:outgoing>
      <bpmn:outgoing>F_CA_COMPRA_C3_HabilitarDireito_32</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="C3_End_Perdida" name="Direito não habilitado">
      <bpmn:extensionElements>
        <camunda:executionListener expression="${execution.setVariable('direitoHabilitado', false)}" event="start"/>
      </bpmn:extensionElements>
      <bpmn:incoming>F_CA_COMPRA_C3_HabilitarDireito_31</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="C3_End_Suporte" name="Contestação / humano solicitado">
      <bpmn:documentation>RT-03 [PROPOSTO]. Devolve ao processo principal direitoHabilitado = false e encaminharSuporte = true. | Origem: ARQ-01 LA-04 (COMPRA · C3 → SUPORTE)</bpmn:documentation>
      <bpmn:extensionElements>
        <camunda:executionListener expression="${execution.setVariable('direitoHabilitado', false)}" event="start"/>
        <camunda:executionListener expression="${execution.setVariable('encaminharSuporte', true)}" event="start"/>
        <camunda:executionListener expression="${execution.setVariable('motivoDificuldade', 'CONTESTACAO_NEGATIVA')}" event="start"/>
      </bpmn:extensionElements>
      <bpmn:incoming>F_CA_COMPRA_C3_HabilitarDireito_32</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_CA_COMPRA_C3_HabilitarDireito_01" sourceRef="C3_Start" targetRef="C3_GW_Tipo"/>
    <bpmn:sequenceFlow id="F_CA_COMPRA_C3_HabilitarDireito_02" name="Plano (novo beneficiário)" sourceRef="C3_GW_Tipo" targetRef="C3_CA_Perfil">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${execution.getVariable("tipoDireito") == "PLANO"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_CA_COMPRA_C3_HabilitarDireito_03" name="Serviço" sourceRef="C3_GW_Tipo" targetRef="C3_GW_MergeEleg"/>
    <bpmn:sequenceFlow id="F_CA_COMPRA_C3_HabilitarDireito_04" sourceRef="C3_CA_Perfil" targetRef="C3_End_Plano"/>
    <bpmn:sequenceFlow id="F_CA_COMPRA_C3_HabilitarDireito_05" sourceRef="C3_GW_MergeEleg" targetRef="C3_T_Elegibilidade"/>
    <bpmn:sequenceFlow id="F_CA_COMPRA_C3_HabilitarDireito_06" sourceRef="C3_T_Elegibilidade" targetRef="C3_GW_Auto"/>
    <bpmn:sequenceFlow id="F_CA_COMPRA_C3_HabilitarDireito_07" name="Sim — autorização invisível" sourceRef="C3_GW_Auto" targetRef="C3_T_AutoAutorizar">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${autorizacaoAutomatica == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_CA_COMPRA_C3_HabilitarDireito_08" name="Não — análise prévia" sourceRef="C3_GW_Auto" targetRef="C3_GW_MergeReq"/>
    <bpmn:sequenceFlow id="F_CA_COMPRA_C3_HabilitarDireito_09" sourceRef="C3_T_AutoAutorizar" targetRef="C3_GW_MergeAut"/>
    <bpmn:sequenceFlow id="F_CA_COMPRA_C3_HabilitarDireito_10" sourceRef="C3_GW_MergeAut" targetRef="C3_EV_Autorizado"/>
    <bpmn:sequenceFlow id="F_CA_COMPRA_C3_HabilitarDireito_11" sourceRef="C3_EV_Autorizado" targetRef="C3_End_Habilitado"/>
    <bpmn:sequenceFlow id="F_CA_COMPRA_C3_HabilitarDireito_12" sourceRef="C3_GW_MergeReq" targetRef="C3_T_Requisitar"/>
    <bpmn:sequenceFlow id="F_CA_COMPRA_C3_HabilitarDireito_13" sourceRef="C3_T_Requisitar" targetRef="C3_EV_EmAnalise"/>
    <bpmn:sequenceFlow id="F_CA_COMPRA_C3_HabilitarDireito_14" sourceRef="C3_EV_EmAnalise" targetRef="C3_GW_Espera"/>
    <bpmn:sequenceFlow id="F_CA_COMPRA_C3_HabilitarDireito_15" sourceRef="C3_GW_Espera" targetRef="C3_EV_Concedida"/>
    <bpmn:sequenceFlow id="F_CA_COMPRA_C3_HabilitarDireito_16" sourceRef="C3_GW_Espera" targetRef="C3_EV_Pendencia"/>
    <bpmn:sequenceFlow id="F_CA_COMPRA_C3_HabilitarDireito_17" sourceRef="C3_GW_Espera" targetRef="C3_EV_Negada"/>
    <bpmn:sequenceFlow id="F_CA_COMPRA_C3_HabilitarDireito_18" sourceRef="C3_GW_Espera" targetRef="C3_EV_Expirou"/>
    <bpmn:sequenceFlow id="F_CA_COMPRA_C3_HabilitarDireito_19" sourceRef="C3_EV_Concedida" targetRef="C3_GW_MergeAut"/>
    <bpmn:sequenceFlow id="F_CA_COMPRA_C3_HabilitarDireito_20" sourceRef="C3_EV_Pendencia" targetRef="C3_GW_Pendencia"/>
    <bpmn:sequenceFlow id="F_CA_COMPRA_C3_HabilitarDireito_21" name="Sim — reenviar" sourceRef="C3_GW_Pendencia" targetRef="C3_GW_MergeReq">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${pendenciaResolvida == true &amp;&amp; tentativasAutorizacao &lt; 3}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_CA_COMPRA_C3_HabilitarDireito_22" name="Não — renegociar" sourceRef="C3_GW_Pendencia" targetRef="C3_GW_MergeReneg"/>
    <bpmn:sequenceFlow id="F_CA_COMPRA_C3_HabilitarDireito_23" sourceRef="C3_EV_Negada" targetRef="C3_GW_TipoNegativa"/>
    <bpmn:sequenceFlow id="F_CA_COMPRA_C3_HabilitarDireito_24" name="Sim — cobertura" sourceRef="C3_GW_TipoNegativa" targetRef="C3_T_Parecer">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${negativaDeCobertura == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_CA_COMPRA_C3_HabilitarDireito_25" name="Não — administrativa" sourceRef="C3_GW_TipoNegativa" targetRef="C3_GW_MergeReneg"/>
    <bpmn:sequenceFlow id="F_CA_COMPRA_C3_HabilitarDireito_26" sourceRef="C3_T_Parecer" targetRef="C3_GW_MergeReneg"/>
    <bpmn:sequenceFlow id="F_CA_COMPRA_C3_HabilitarDireito_27" sourceRef="C3_EV_Expirou" targetRef="C3_GW_MergeReneg"/>
    <bpmn:sequenceFlow id="F_CA_COMPRA_C3_HabilitarDireito_28" sourceRef="C3_GW_MergeReneg" targetRef="C3_T_Renegociar"/>
    <bpmn:sequenceFlow id="F_CA_COMPRA_C3_HabilitarDireito_29" sourceRef="C3_T_Renegociar" targetRef="C3_GW_Alternativa"/>
    <bpmn:sequenceFlow id="F_CA_COMPRA_C3_HabilitarDireito_30" name="Sim — reavaliar" sourceRef="C3_GW_Alternativa" targetRef="C3_GW_MergeEleg">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${clienteAceitouAlternativa == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_CA_COMPRA_C3_HabilitarDireito_31" name="Não" sourceRef="C3_GW_Alternativa" targetRef="C3_End_Perdida"/>
    <bpmn:sequenceFlow id="F_CA_COMPRA_C3_HabilitarDireito_32" name="Não — contestar / humano" sourceRef="C3_GW_Alternativa" targetRef="C3_End_Suporte">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${execution.getVariable("clienteSolicitouSuporte") == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_CA_COMPRA_C3_HabilitarDireito_33" sourceRef="C3_B_SLA_Parecer" targetRef="C3_T_EscalarParecer"/>
    <bpmn:sequenceFlow id="F_CA_COMPRA_C3_HabilitarDireito_34" sourceRef="C3_T_EscalarParecer" targetRef="C3_End_SLA_Parecer"/>
    <bpmn:sequenceFlow id="F_CA_COMPRA_C3_HabilitarDireito_35" sourceRef="C3_B_SLA_Renegociar" targetRef="C3_T_EscalarRenegociar"/>
    <bpmn:sequenceFlow id="F_CA_COMPRA_C3_HabilitarDireito_36" sourceRef="C3_T_EscalarRenegociar" targetRef="C3_End_SLA_Renegociar"/>
    <bpmn:dataObject id="DO_INS_015_1" name="Dados cadastrais do cliente">
      <bpmn:documentation>Insumo INS-015 · Origem: SUB-01 §2.11 Insumo (JIT); SUB-01 §2.11 · coluna Entrada</bpmn:documentation>
    </bpmn:dataObject>
    <bpmn:dataObjectReference id="DOR_INS_015_1" name="Dados cadastrais do cliente" dataObjectRef="DO_INS_015_1">
      <bpmn:documentation>Insumo INS-015 · Origem: SUB-01 §2.11 Insumo (JIT); SUB-01 §2.11 · coluna Entrada</bpmn:documentation>
    </bpmn:dataObjectReference>
    <bpmn:dataStoreReference id="DSR_INS_016_1" name="Fontes de dados internas e externas" dataStoreRef="DS_INS_016">
      <bpmn:documentation>Insumo INS-016 · Origem: SUB-01 §2.11 Insumo (JIT); §3; SUB-01 §2.11 · coluna Subprocesso genérico; SUB-01 §2.11 · coluna Observação; SUB-01 §3 · coluna Subprocesso genérico ⚠️ AMBIGUIDADE — Insumo agregado: no CA_1 a callActivity C3_CA_Perfil recebe as 'fontes' como um único DS; no CA_0 as mesmas fontes aparecem discriminadas nas tarefas do processo chamado (INS-017 a INS-021). Além disso, SUB-01 §3 atribui 'consultar fontes' também a H3_CA_Lote, mas a linha Insumo de §2.2 descreve a seleção do lote — divergência interna do SUB-01, não resolvida. Alternativa: desenhar no CA_1 as cinco fontes discriminadas.</bpmn:documentation>
    </bpmn:dataStoreReference>
  </bpmn:process>
  <bpmn:process id="Process_CA_COMPRA_C4_ManterDireito" name="C4 — Manter o direito" isExecutable="true" camunda:versionTag="3.1.0-rt-suporte" camunda:historyTimeToLive="180">
    <bpmn:documentation>Manter o direito válido quando o uso não acontece como planejado. ⚠️ LA-03: manutenção do direito-base (carência, inadimplência, portabilidade, revogação de consentimento) sem origem.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_Process_CA_COMPRA_C4_ManterDireito">
      <bpmn:lane id="LN_CA1_C4_RetencaoRelacionamento" name="Retenção e relacionamento">
        <bpmn:documentation>Dimensão: Staff · Origem: SUB-01 §2.7 · Ref: CP_CA_C4</bpmn:documentation>
        <bpmn:flowNodeRef>C4_Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C4_GW_Motivo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C4_End_Cancelado</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LN_CA1_C4_AgendaCapacidade" name="Agenda e capacidade">
        <bpmn:documentation>Dimensão: Slot · Origem: Rótulo (reagendar e confirmar slot) + SUB-01 §3 (vaga e realocação) · Ref: UT_CA_U1, UT_ES_Cancelamento</bpmn:documentation>
        <bpmn:flowNodeRef>C4_T_Reagendar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C4_B_SemSlot</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C4_T_Confirmar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C4_B_Lembrete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C4_B_PrazoMax</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C4_EV_Lembrete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C4_End_Lembrete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C4_EV_Agendado</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C4_End_Remarcado</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C4_End_SemConfirmacao</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C4_End_SemSlot</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="C4_Start" name="Manutenção solicitada">
      <bpmn:outgoing>F_CA_COMPRA_C4_ManterDireito_01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="C4_GW_Motivo" name="Motivo da manutenção?" default="F_CA_COMPRA_C4_ManterDireito_03">
      <bpmn:documentation>Origem: M2_GW_JoinEntrega (parte)</bpmn:documentation>
      <bpmn:documentation>Regra: no-show ou cancelamento do prestador reabre a manutenção com reagendamento; entrega realizada encerra — dono: Retenção e relacionamento</bpmn:documentation>
      <bpmn:incoming>F_CA_COMPRA_C4_ManterDireito_01</bpmn:incoming>
      <bpmn:outgoing>F_CA_COMPRA_C4_ManterDireito_02</bpmn:outgoing>
      <bpmn:outgoing>F_CA_COMPRA_C4_ManterDireito_03</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="C4_T_Reagendar" name="Reagendar automaticamente em slot equivalente" camunda:asyncBefore="true" camunda:delegateExpression="${autoRebookingService}">
      <bpmn:documentation>Rebooking antes do pedido do cliente; produz novo agendamentoId/dataHoraServico e política de compensação. | Origem: M2_T_Reagendar</bpmn:documentation>
      <bpmn:incoming>F_CA_COMPRA_C4_ManterDireito_02</bpmn:incoming>
      <bpmn:outgoing>F_CA_COMPRA_C4_ManterDireito_04</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="C4_B_SemSlot" name="Sem slot equivalente" attachedToRef="C4_T_Reagendar">
      <bpmn:documentation>RT-04 [PROPOSTO]. O rebooking automático não encontra slot equivalente (prestador, prazo ou local). Na origem a tarefa não tinha caminho de falha e o cliente ficaria sem o cuidado e sem aviso. autoRebookingService lança BpmnError SEM_SLOT_EQUIVALENTE.</bpmn:documentation>
      <bpmn:documentation>Contrato do erro (externo ao fluxo): o serviço de reagendamento automático (autoRebookingService) lança BpmnError com código SEM_SLOT_EQUIVALENTE quando não há slot equivalente; errorCode declarado nas definições. Produção por serviço externo — teste de erro pendente pela equipe antes de implantar.</bpmn:documentation>
      <bpmn:outgoing>F_CA_COMPRA_C4_ManterDireito_10</bpmn:outgoing>
      <bpmn:errorEventDefinition errorRef="Error_CA_SemSlotEquivalente"/>
    </bpmn:boundaryEvent>
    <bpmn:userTask id="C4_T_Confirmar" name="Confirmar ou ajustar novo slot (1 toque)" camunda:formKey="ced:confirmar-novo-slot" camunda:assignee="${clienteId}">
      <bpmn:documentation>Origem: M2_T_ConfirmarNovoSlot</bpmn:documentation>
      <bpmn:incoming>F_CA_COMPRA_C4_ManterDireito_04</bpmn:incoming>
      <bpmn:outgoing>F_CA_COMPRA_C4_ManterDireito_05</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="C4_B_Lembrete" name="24h sem resposta" cancelActivity="false" attachedToRef="C4_T_Confirmar">
      <bpmn:documentation>Origem: M2_Boundary_SLANovoSlot (reposicionado)</bpmn:documentation>
      <bpmn:outgoing>F_CA_COMPRA_C4_ManterDireito_07</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R/PT24H</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="C4_B_PrazoMax" name="Prazo máximo de confirmação" attachedToRef="C4_T_Confirmar">
      <bpmn:documentation>⚠️ PD-02 [PENDENTE]. | Origem: [SEM ORIGEM] — ARQ-01 FR-01</bpmn:documentation>
      <bpmn:outgoing>F_CA_COMPRA_C4_ManterDireito_09</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">${prazoMaximoDecisao}</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:intermediateThrowEvent id="C4_EV_Lembrete" name="Lembrar cliente do novo slot">
      <bpmn:documentation>Aciona H2 (Comunicar o cliente) com o Journey ID. Marco: REENGAJAR_NOVO_SLOT. | Origem: M2_End_SemConfirmacao → M3_Start_Reengajar</bpmn:documentation>
      <bpmn:documentation>Marco factual: registra o que ACONTECEU com o cliente, não estimativa nem previsão.</bpmn:documentation>
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="marcoJornada">REENGAJAR_NOVO_SLOT</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>F_CA_COMPRA_C4_ManterDireito_07</bpmn:incoming>
      <bpmn:outgoing>F_CA_COMPRA_C4_ManterDireito_08</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_CA_ComunicarCliente" camunda:delegateExpression="${comunicarClientePublisher}"/>
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="C4_End_Lembrete" name="Lembrete enviado — segue aguardando">
      <bpmn:incoming>F_CA_COMPRA_C4_ManterDireito_08</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateThrowEvent id="C4_EV_Agendado" name="Marco: reagendado">
      <bpmn:documentation>Aciona H2 (Comunicar o cliente) com o Journey ID. Marco: AGENDADO. | Origem: M2_F38 → M2_EV_MarcoAgendado</bpmn:documentation>
      <bpmn:documentation>Marco factual: registra o que ACONTECEU com o cliente, não estimativa nem previsão.</bpmn:documentation>
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="marcoJornada">AGENDADO</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>F_CA_COMPRA_C4_ManterDireito_05</bpmn:incoming>
      <bpmn:outgoing>F_CA_COMPRA_C4_ManterDireito_06</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_CA_ComunicarCliente" camunda:delegateExpression="${comunicarClientePublisher}"/>
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="C4_End_Remarcado" name="Novo slot confirmado">
      <bpmn:extensionElements>
        <camunda:executionListener expression="${execution.setVariable('resultadoManutencao', 'REMARCADO')}" event="start"/>
      </bpmn:extensionElements>
      <bpmn:incoming>F_CA_COMPRA_C4_ManterDireito_06</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="C4_End_SemConfirmacao" name="Sem confirmação no prazo">
      <bpmn:extensionElements>
        <camunda:executionListener expression="${execution.setVariable('resultadoManutencao', 'SEM_CONFIRMACAO')}" event="start"/>
      </bpmn:extensionElements>
      <bpmn:incoming>F_CA_COMPRA_C4_ManterDireito_09</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="C4_End_Cancelado" name="Cancelado pelo cliente">
      <bpmn:documentation>Origem: M2_End_CanceladoEntrega</bpmn:documentation>
      <bpmn:extensionElements>
        <camunda:executionListener expression="${execution.setVariable('resultadoManutencao', 'CANCELADO')}" event="start"/>
      </bpmn:extensionElements>
      <bpmn:incoming>F_CA_COMPRA_C4_ManterDireito_03</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="C4_End_SemSlot" name="Sem slot equivalente">
      <bpmn:extensionElements>
        <camunda:executionListener expression="${execution.setVariable('resultadoManutencao', 'SEM_SLOT')}" event="start"/>
      </bpmn:extensionElements>
      <bpmn:incoming>F_CA_COMPRA_C4_ManterDireito_10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_CA_COMPRA_C4_ManterDireito_01" sourceRef="C4_Start" targetRef="C4_GW_Motivo"/>
    <bpmn:sequenceFlow id="F_CA_COMPRA_C4_ManterDireito_02" name="No-show / prestador cancelou" sourceRef="C4_GW_Motivo" targetRef="C4_T_Reagendar">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${statusEntrega == "NO_SHOW" || statusEntrega == "CANCELADO_PRESTADOR"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_CA_COMPRA_C4_ManterDireito_03" name="Cliente cancelou" sourceRef="C4_GW_Motivo" targetRef="C4_End_Cancelado"/>
    <bpmn:sequenceFlow id="F_CA_COMPRA_C4_ManterDireito_04" sourceRef="C4_T_Reagendar" targetRef="C4_T_Confirmar"/>
    <bpmn:sequenceFlow id="F_CA_COMPRA_C4_ManterDireito_05" sourceRef="C4_T_Confirmar" targetRef="C4_EV_Agendado"/>
    <bpmn:sequenceFlow id="F_CA_COMPRA_C4_ManterDireito_06" sourceRef="C4_EV_Agendado" targetRef="C4_End_Remarcado"/>
    <bpmn:sequenceFlow id="F_CA_COMPRA_C4_ManterDireito_07" sourceRef="C4_B_Lembrete" targetRef="C4_EV_Lembrete"/>
    <bpmn:sequenceFlow id="F_CA_COMPRA_C4_ManterDireito_08" sourceRef="C4_EV_Lembrete" targetRef="C4_End_Lembrete"/>
    <bpmn:sequenceFlow id="F_CA_COMPRA_C4_ManterDireito_09" sourceRef="C4_B_PrazoMax" targetRef="C4_End_SemConfirmacao"/>
    <bpmn:sequenceFlow id="F_CA_COMPRA_C4_ManterDireito_10" sourceRef="C4_B_SemSlot" targetRef="C4_End_SemSlot"/>
  </bpmn:process>
  <bpmn:dataStore id="DS_INS_005" name="Catálogo comercial vigente (produtos/planos e regras comerciais)">
    <bpmn:documentation>Insumo INS-005 · Origem: SUB-01 §2.4 Insumo (JIT); SUB-01 §2.4 · coluna Subprocesso genérico; SUB-01 §2.4 · coluna Entrada</bpmn:documentation>
  </bpmn:dataStore>
  <bpmn:dataStore id="DS_INS_010" name="Histórico de consumo">
    <bpmn:documentation>Insumo INS-010 · Origem: SUB-01 §2.7 Insumo (JIT); SUB-01 §2.7 · coluna Entrada</bpmn:documentation>
  </bpmn:dataStore>
  <bpmn:dataStore id="DS_INS_012" name="Perfil 360 do cliente">
    <bpmn:documentation>Insumo INS-012 · Origem: SUB-01 §2.10 e §2.11 Insumo (JIT); SUB-01 §2.10 · coluna Entrada; SUB-01 §2.11 · coluna Saída; CA_0 · NBA_T_Contexto · rótulo; CA_0 · EC_T_Consolidar · rótulo; CA_0 · EC_T_Consolidar · documentation; CA_1 · C1_T_Cruzar · rótulo; CA_3 · S1_T_Contexto · rótulo ⚠️ AMBIGUIDADE — SUB-01 nomeia 'Perfil do cliente' (§2.10) e 'Perfil 360 inicial consolidado' (§2.11) sem declará-los idênticos; a identidade como um único repositório vem dos rótulos do diagrama ('perfil 360' em NBA_T_Contexto, EC_T_Consolidar, C1_T_Cruzar e '360' em S1_T_Contexto). A saída em EC_T_Consolidar usa 'Produz versaoPerfil' + rótulo 'versionar perfil 360'. Alternativa: DS separados por arquivo/finalidade.</bpmn:documentation>
  </bpmn:dataStore>
  <bpmn:dataStore id="DS_INS_014" name="Catálogo de ofertas">
    <bpmn:documentation>Insumo INS-014 · Origem: SUB-01 §2.10 Insumo (JIT); SUB-01 §2.10 · coluna Subprocesso genérico; SUB-01 §2.10 · coluna Entrada ⚠️ AMBIGUIDADE — SUB-01 §2.10 cita 'catálogo de ofertas' e §2.4 cita 'catálogo de produtos/planos e regras comerciais vigentes' (INS-005), ambos no arquivo CA_1, sem declará-los idênticos. Modelados como dois DS; alternativa: um único DS no CA_1 com duas referências.</bpmn:documentation>
  </bpmn:dataStore>
  <bpmn:dataStore id="DS_INS_016" name="Fontes de dados internas e externas">
    <bpmn:documentation>Insumo INS-016 · Origem: SUB-01 §2.11 Insumo (JIT); §3; SUB-01 §2.11 · coluna Subprocesso genérico; SUB-01 §2.11 · coluna Observação; SUB-01 §3 · coluna Subprocesso genérico ⚠️ AMBIGUIDADE — Insumo agregado: no CA_1 a callActivity C3_CA_Perfil recebe as 'fontes' como um único DS; no CA_0 as mesmas fontes aparecem discriminadas nas tarefas do processo chamado (INS-017 a INS-021). Além disso, SUB-01 §3 atribui 'consultar fontes' também a H3_CA_Lote, mas a linha Insumo de §2.2 descreve a seleção do lote — divergência interna do SUB-01, não resolvida. Alternativa: desenhar no CA_1 as cinco fontes discriminadas.</bpmn:documentation>
  </bpmn:dataStore>
