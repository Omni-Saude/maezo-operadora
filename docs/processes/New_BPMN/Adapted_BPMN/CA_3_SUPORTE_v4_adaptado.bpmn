      <bpmn:incoming>F_CA_SUPORTE_S3_ResolverEncaminhar_07</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="S3_GW_MergeHumano" name="">
      <bpmn:documentation>Origem: M3_GW_MergeHumano + M3_CA_Humano + AH_Start (atendimento humano incorporado a S3)</bpmn:documentation>
