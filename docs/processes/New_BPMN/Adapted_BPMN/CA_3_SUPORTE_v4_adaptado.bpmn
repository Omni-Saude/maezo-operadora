    <bpmn:sequenceFlow id="F_CA_SUPORTE_S3_ResolverEncaminhar_01" sourceRef="S3_Start" targetRef="S3_GW_Origem"/>
    <bpmn:sequenceFlow id="F_CA_SUPORTE_S3_ResolverEncaminhar_02" name="IA" sourceRef="S3_GW_Origem" targetRef="S3_T_IA">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${origemSuporte == "CLIENTE" &amp;&amp; rotaAtendimento == "IA"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_CA_SUPORTE_S3_ResolverEncaminhar_03" name="Service recovery" sourceRef="S3_GW_Origem" targetRef="S3_T_Recovery">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${origemSuporte == "RECOVERY"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_CA_SUPORTE_S3_ResolverEncaminhar_04" name="SLA de entrega" sourceRef="S3_GW_Origem" targetRef="S3_T_Intervencao"/>
    <bpmn:sequenceFlow id="F_CA_SUPORTE_S3_ResolverEncaminhar_05" name="Especialista" sourceRef="S3_GW_Origem" targetRef="S3_GW_MergeHumano">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${origemSuporte == "CLIENTE" &amp;&amp; rotaAtendimento == "HUMANO"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_CA_SUPORTE_S3_ResolverEncaminhar_06" sourceRef="S3_T_IA" targetRef="S3_GW_Confianca"/>
    <bpmn:sequenceFlow id="F_CA_SUPORTE_S3_ResolverEncaminhar_07" name="Sim — responder" sourceRef="S3_GW_Confianca" targetRef="S3_End_IA">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${confiancaIA &gt;= limiarConfianca &amp;&amp; respostaVerificada == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_CA_SUPORTE_S3_ResolverEncaminhar_08" name="Não — escalar" sourceRef="S3_GW_Confianca" targetRef="S3_GW_MergeHumano"/>
    <bpmn:sequenceFlow id="F_CA_SUPORTE_S3_ResolverEncaminhar_09" sourceRef="S3_GW_MergeHumano" targetRef="S3_GW_Natureza"/>
    <bpmn:sequenceFlow id="F_CA_SUPORTE_S3_ResolverEncaminhar_10" name="Clínico" sourceRef="S3_GW_Natureza" targetRef="S3_T_Enfermagem">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${naturezaCaso == "clinico"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_CA_SUPORTE_S3_ResolverEncaminhar_11" name="Administrativo" sourceRef="S3_GW_Natureza" targetRef="S3_T_Especialista"/>
    <bpmn:sequenceFlow id="F_CA_SUPORTE_S3_ResolverEncaminhar_12" sourceRef="S3_T_Especialista" targetRef="S3_GW_MergeAtend"/>
    <bpmn:sequenceFlow id="F_CA_SUPORTE_S3_ResolverEncaminhar_13" sourceRef="S3_T_Enfermagem" targetRef="S3_GW_MergeAtend"/>
    <bpmn:sequenceFlow id="F_CA_SUPORTE_S3_ResolverEncaminhar_14" sourceRef="S3_GW_MergeAtend" targetRef="S3_GW_PrimeiroContato"/>
    <bpmn:sequenceFlow id="F_CA_SUPORTE_S3_ResolverEncaminhar_15" name="Sim" sourceRef="S3_GW_PrimeiroContato" targetRef="S3_End_Resolvido">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${resolvidoPrimeiroContato == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_CA_SUPORTE_S3_ResolverEncaminhar_16" name="Não" sourceRef="S3_GW_PrimeiroContato" targetRef="S3_T_Protocolo"/>
    <bpmn:sequenceFlow id="F_CA_SUPORTE_S3_ResolverEncaminhar_17" sourceRef="S3_T_Protocolo" targetRef="S3_T_Cumprir"/>
    <bpmn:sequenceFlow id="F_CA_SUPORTE_S3_ResolverEncaminhar_18" sourceRef="S3_T_Cumprir" targetRef="S3_End_Retorno"/>
    <bpmn:sequenceFlow id="F_CA_SUPORTE_S3_ResolverEncaminhar_19" sourceRef="S3_B_D1" targetRef="S3_T_Priorizar"/>
    <bpmn:sequenceFlow id="F_CA_SUPORTE_S3_ResolverEncaminhar_20" sourceRef="S3_T_Priorizar" targetRef="S3_End_Priorizado"/>
    <bpmn:sequenceFlow id="F_CA_SUPORTE_S3_ResolverEncaminhar_21" sourceRef="S3_T_Recovery" targetRef="S3_End_Recovery"/>
    <bpmn:sequenceFlow id="F_CA_SUPORTE_S3_ResolverEncaminhar_22" sourceRef="S3_B_SLARecovery" targetRef="S3_T_Supervisor"/>
    <bpmn:sequenceFlow id="F_CA_SUPORTE_S3_ResolverEncaminhar_23" sourceRef="S3_T_Supervisor" targetRef="S3_End_Supervisor"/>
    <bpmn:sequenceFlow id="F_CA_SUPORTE_S3_ResolverEncaminhar_24" sourceRef="S3_T_Intervencao" targetRef="S3_End_Intervencao"/>
    <bpmn:sequenceFlow id="F_CA_SUPORTE_S3_ResolverEncaminhar_25" sourceRef="S3_B_SLA_Especialista" targetRef="S3_T_EscalarEspecialista"/>
    <bpmn:sequenceFlow id="F_CA_SUPORTE_S3_ResolverEncaminhar_26" sourceRef="S3_T_EscalarEspecialista" targetRef="S3_End_SLA_Especialista"/>
    <bpmn:sequenceFlow id="F_CA_SUPORTE_S3_ResolverEncaminhar_27" sourceRef="S3_B_SLA_Enfermagem" targetRef="S3_T_EscalarEnfermagem"/>
    <bpmn:sequenceFlow id="F_CA_SUPORTE_S3_ResolverEncaminhar_28" sourceRef="S3_T_EscalarEnfermagem" targetRef="S3_End_SLA_Enfermagem"/>
    <bpmn:sequenceFlow id="F_CA_SUPORTE_S3_ResolverEncaminhar_29" sourceRef="S3_B_SLA_Protocolo" targetRef="S3_T_EscalarProtocolo"/>
    <bpmn:sequenceFlow id="F_CA_SUPORTE_S3_ResolverEncaminhar_30" sourceRef="S3_T_EscalarProtocolo" targetRef="S3_End_SLA_Protocolo"/>
    <bpmn:sequenceFlow id="F_CA_SUPORTE_S3_ResolverEncaminhar_31" sourceRef="S3_B_SLA_Priorizar" targetRef="S3_T_EscalarPriorizar"/>
    <bpmn:sequenceFlow id="F_CA_SUPORTE_S3_ResolverEncaminhar_32" sourceRef="S3_T_EscalarPriorizar" targetRef="S3_End_SLA_Priorizar"/>
    <bpmn:sequenceFlow id="F_CA_SUPORTE_S3_ResolverEncaminhar_33" sourceRef="S3_B_SLA_Supervisor" targetRef="S3_T_EscalarSupervisao"/>
    <bpmn:sequenceFlow id="F_CA_SUPORTE_S3_ResolverEncaminhar_34" sourceRef="S3_T_EscalarSupervisao" targetRef="S3_End_SLA_Supervisao"/>
    <bpmn:sequenceFlow id="F_CA_SUPORTE_S3_ResolverEncaminhar_35" sourceRef="S3_B_SLA_Intervencao" targetRef="S3_T_EscalarIntervencao"/>
    <bpmn:sequenceFlow id="F_CA_SUPORTE_S3_ResolverEncaminhar_36" sourceRef="S3_T_EscalarIntervencao" targetRef="S3_End_SLA_Intervencao"/>
  </bpmn:process>
  <bpmn:process id="Process_CA_SUPORTE_S4_ConfirmarEncerrar" name="S4 — Confirmar, encerrar e aprender" isExecutable="true" camunda:versionTag="3.0.0-arq01" camunda:historyTimeToLive="180">
    <bpmn:documentation>Só encerra com a confirmação do cliente. Não resolvido pela IA volta ao especialista; não resolvido pelo especialista vai à ouvidoria/ANS. Todo encerramento vira aprendizado (H3).</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_Process_CA_SUPORTE_S4_ConfirmarEncerrar">
      <bpmn:lane id="LN_CA3_S4_Qualidade" name="Qualidade e melhoria contínua">
        <bpmn:documentation>Dimensão: Staff · Origem: SUB-01 §2.21 · Ref: SP_CA_S4</bpmn:documentation>
        <bpmn:flowNodeRef>S4_Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S4_T_Confirmar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S4_GW_Resolvido</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S4_GW_Rota</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S4_GW_MergeAprender</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S4_T_Aprender</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S4_EV_Aprendizado</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S4_End</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S4_End_Reencaminhar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S4_B_Silencio</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LN_CA3_S4_Resolucao" name="Resolução e encaminhamento">
        <bpmn:documentation>Dimensão: Staff · Origem: label (verbo 'encaminhar' em S4_T_Ouvidoria); vocabulário canônico; §2.20 é de SP_CA_S3, não de SP_CA_S4</bpmn:documentation>
        <bpmn:flowNodeRef>S4_T_Ouvidoria</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S4_Start" name="Solução entregue">
      <bpmn:outgoing>F_CA_SUPORTE_S4_ConfirmarEncerrar_01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="S4_T_Confirmar" name="Confirmar a resolução (1 toque)" camunda:formKey="ced:confirmacao-resolucao" camunda:assignee="${clienteId}">
      <bpmn:documentation>Produz clienteConfirmouResolucao. | Origem: M3_T_RespostaEnviada + M3_GW_ResolvidoHumano + M2_GW_RecoveryOK (SO-05)</bpmn:documentation>
      <bpmn:incoming>F_CA_SUPORTE_S4_ConfirmarEncerrar_01</bpmn:incoming>
      <bpmn:outgoing>F_CA_SUPORTE_S4_ConfirmarEncerrar_02</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="S4_GW_Resolvido" name="Cliente confirmou a resolução?" default="F_CA_SUPORTE_S4_ConfirmarEncerrar_04">
      <bpmn:documentation>Origem: M3_GW_Resolvido</bpmn:documentation>
      <bpmn:documentation>Regra: sem confirmação do cliente, reabrir conforme a rota anterior — dono: Qualidade e melhoria contínua</bpmn:documentation>
      <bpmn:incoming>F_CA_SUPORTE_S4_ConfirmarEncerrar_02</bpmn:incoming>
      <bpmn:outgoing>F_CA_SUPORTE_S4_ConfirmarEncerrar_03</bpmn:outgoing>
      <bpmn:outgoing>F_CA_SUPORTE_S4_ConfirmarEncerrar_04</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="S4_GW_Rota" name="Já passou por especialista?" default="F_CA_SUPORTE_S4_ConfirmarEncerrar_06">
      <bpmn:documentation>Regra: caso originado em resposta de IA reabre com reencaminhamento; demais encerram sem confirmação — dono: Qualidade e melhoria contínua</bpmn:documentation>
      <bpmn:incoming>F_CA_SUPORTE_S4_ConfirmarEncerrar_04</bpmn:incoming>
      <bpmn:outgoing>F_CA_SUPORTE_S4_ConfirmarEncerrar_05</bpmn:outgoing>
      <bpmn:outgoing>F_CA_SUPORTE_S4_ConfirmarEncerrar_06</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="S4_T_Ouvidoria" name="Encaminhar à ouvidoria/ANS com retorno">
      <bpmn:documentation>⚠️ LACUNA LA-05 [SEM ORIGEM]: ouvidoria citada como destino nas fontes, sem processo. Tarefa abstrata mantida para a visão E2E. | Origem: M2_End_NaoRecuperado, AH_T_CumprirProtocolo</bpmn:documentation>
      <bpmn:incoming>F_CA_SUPORTE_S4_ConfirmarEncerrar_06</bpmn:incoming>
      <bpmn:outgoing>F_CA_SUPORTE_S4_ConfirmarEncerrar_07</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="S4_GW_MergeAprender" name="">
      <bpmn:incoming>F_CA_SUPORTE_S4_ConfirmarEncerrar_03</bpmn:incoming>
      <bpmn:incoming>F_CA_SUPORTE_S4_ConfirmarEncerrar_07</bpmn:incoming>
      <bpmn:incoming>F_CA_SUPORTE_S4_ConfirmarEncerrar_08</bpmn:incoming>
      <bpmn:outgoing>F_CA_SUPORTE_S4_ConfirmarEncerrar_09</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="S4_T_Aprender" name="Registrar interação para treinar a IA" camunda:asyncBefore="true" camunda:delegateExpression="${interactionLearningService}">
      <bpmn:documentation>Passa a valer para todo encerramento (I-04). | Origem: M3_T_Aprender</bpmn:documentation>
      <bpmn:incoming>F_CA_SUPORTE_S4_ConfirmarEncerrar_09</bpmn:incoming>
      <bpmn:outgoing>F_CA_SUPORTE_S4_ConfirmarEncerrar_10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateThrowEvent id="S4_EV_Aprendizado" name="Caso convertido em aprendizado">
      <bpmn:documentation>Origem: M3_End_Aprendizado</bpmn:documentation>
      <bpmn:documentation>Marco factual: registra o que ACONTECEU, não estimativa nem previsão.</bpmn:documentation>
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="tipoEventoNegocio">APRENDIZADO_INTERACAO</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>F_CA_SUPORTE_S4_ConfirmarEncerrar_10</bpmn:incoming>
      <bpmn:outgoing>F_CA_SUPORTE_S4_ConfirmarEncerrar_11</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_CA_EventoNegocio" camunda:delegateExpression="${businessEventPublisher}"/>
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="S4_End" name="Caso encerrado">
      <bpmn:incoming>F_CA_SUPORTE_S4_ConfirmarEncerrar_11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="S4_End_Reencaminhar" name="Reencaminhar ao especialista">
      <bpmn:documentation>Ajusta rotaAtendimento para HUMANO no processo principal. | Origem: M3_F16</bpmn:documentation>
      <bpmn:extensionElements>
        <camunda:executionListener expression="${execution.setVariable('desfechoSuporte', 'REENCAMINHAR')}" event="start"/>
        <camunda:executionListener expression="${execution.setVariable('rotaAtendimento', 'HUMANO')}" event="start"/>
      </bpmn:extensionElements>
      <bpmn:incoming>F_CA_SUPORTE_S4_ConfirmarEncerrar_05</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:boundaryEvent id="S4_B_Silencio" name="24h sem reação" attachedToRef="S4_T_Confirmar">
      <bpmn:documentation>⚠️ PD-03 / I-07 [PENDENTE]. | Origem: M3_Boundary_SemConfirmacao</bpmn:documentation>
      <bpmn:outgoing>F_CA_SUPORTE_S4_ConfirmarEncerrar_08</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT24H</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="F_CA_SUPORTE_S4_ConfirmarEncerrar_01" sourceRef="S4_Start" targetRef="S4_T_Confirmar"/>
    <bpmn:sequenceFlow id="F_CA_SUPORTE_S4_ConfirmarEncerrar_02" sourceRef="S4_T_Confirmar" targetRef="S4_GW_Resolvido"/>
    <bpmn:sequenceFlow id="F_CA_SUPORTE_S4_ConfirmarEncerrar_03" name="Sim" sourceRef="S4_GW_Resolvido" targetRef="S4_GW_MergeAprender">
      <bpmn:extensionElements>
        <camunda:executionListener expression="${execution.setVariable('desfechoSuporte', 'RESOLVIDO')}" event="take"/>
      </bpmn:extensionElements>
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${clienteConfirmouResolucao == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_CA_SUPORTE_S4_ConfirmarEncerrar_04" name="Não" sourceRef="S4_GW_Resolvido" targetRef="S4_GW_Rota"/>
    <bpmn:sequenceFlow id="F_CA_SUPORTE_S4_ConfirmarEncerrar_05" name="Não — tentar especialista" sourceRef="S4_GW_Rota" targetRef="S4_End_Reencaminhar">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${origemSuporte == "CLIENTE" &amp;&amp; rotaAtendimento == "IA"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_CA_SUPORTE_S4_ConfirmarEncerrar_06" name="Sim — ouvidoria" sourceRef="S4_GW_Rota" targetRef="S4_T_Ouvidoria"/>
    <bpmn:sequenceFlow id="F_CA_SUPORTE_S4_ConfirmarEncerrar_07" sourceRef="S4_T_Ouvidoria" targetRef="S4_GW_MergeAprender">
      <bpmn:extensionElements>
        <camunda:executionListener expression="${execution.setVariable('desfechoSuporte', 'OUVIDORIA')}" event="take"/>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_CA_SUPORTE_S4_ConfirmarEncerrar_08" sourceRef="S4_B_Silencio" targetRef="S4_GW_MergeAprender">
      <bpmn:extensionElements>
        <camunda:executionListener expression="${execution.setVariable('desfechoSuporte', 'SEM_CONFIRMACAO')}" event="take"/>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_CA_SUPORTE_S4_ConfirmarEncerrar_09" sourceRef="S4_GW_MergeAprender" targetRef="S4_T_Aprender"/>
    <bpmn:sequenceFlow id="F_CA_SUPORTE_S4_ConfirmarEncerrar_10" sourceRef="S4_T_Aprender" targetRef="S4_EV_Aprendizado"/>
    <bpmn:sequenceFlow id="F_CA_SUPORTE_S4_ConfirmarEncerrar_11" sourceRef="S4_EV_Aprendizado" targetRef="S4_End"/>
  </bpmn:process>
  <bpmn:dataStore id="DS_INS_012" name="Perfil 360 do cliente">
    <bpmn:documentation>Insumo INS-012 · Origem: SUB-01 §2.10 e §2.11 Insumo (JIT); SUB-01 §2.10 · coluna Entrada; SUB-01 §2.11 · coluna Saída; CA_0 · NBA_T_Contexto · rótulo; CA_0 · EC_T_Consolidar · rótulo; CA_0 · EC_T_Consolidar · documentation; CA_1 · C1_T_Cruzar · rótulo; CA_3 · S1_T_Contexto · rótulo ⚠️ AMBIGUIDADE — SUB-01 nomeia 'Perfil do cliente' (§2.10) e 'Perfil 360 inicial consolidado' (§2.11) sem declará-los idênticos; a identidade como um único repositório vem dos rótulos do diagrama ('perfil 360' em NBA_T_Contexto, EC_T_Consolidar, C1_T_Cruzar e '360' em S1_T_Contexto). A saída em EC_T_Consolidar usa 'Produz versaoPerfil' + rótulo 'versionar perfil 360'. Alternativa: DS separados por arquivo/finalidade.</bpmn:documentation>
  </bpmn:dataStore>
  <bpmn:dataStore id="DS_INS_030" name="Histórico do cliente">
    <bpmn:documentation>Insumo INS-030 · Origem: SUB-01 §2.18 Insumo (JIT); SUB-01 §2.18 · coluna Subprocesso genérico; SUB-01 §2.18 · coluna Entrada; CA_3 · S1_T_Contexto · rótulo</bpmn:documentation>
  </bpmn:dataStore>
  <bpmn:dataStore id="DS_INS_031" name="Base de conhecimento/regras de triagem">
    <bpmn:documentation>Insumo INS-031 · Origem: SUB-01 §2.19 Insumo (JIT); SUB-01 §2.19 · coluna Subprocesso genérico</bpmn:documentation>
  </bpmn:dataStore>
  <bpmn:dataStore id="DS_INS_032" name="Recursos de resolução (scripts, alçadas, sistemas)">
    <bpmn:documentation>Insumo INS-032 · Origem: SUB-01 §2.20 Insumo (JIT); SUB-01 §2.20 · coluna Subprocesso genérico ⚠️ AMBIGUIDADE — Natureza DS × DO dúbia: scripts e alçadas são material de referência consultado (DS), mas 'sistemas' não é dado nem documento. Modelado como DS de referência; alternativa: DO por caso, ou excluir 'sistemas' do elemento de dado.</bpmn:documentation>
  </bpmn:dataStore>
