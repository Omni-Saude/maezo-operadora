<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_CA_SUPORTE" targetNamespace="http://central-atendimento/bpmn/arq01" exporter="Camunda Modeler" exporterVersion="5.36.1" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.24.0">
  <bpmn:collaboration id="Collaboration_CA_SUPORTE" name="Central de Atendimento — 3 · SUPORTE">
    <bpmn:documentation>SUPORTE escuta, diagnostica, resolve e encerra, com entrada por contato do cliente ou por transições das demais jornadas (T-05, T-07, T-09, T-10); chama H1 de serviços compartilhados e encaminha à ouvidoria fora do conjunto modelado.</bpmn:documentation>
    <bpmn:participant id="Participant_Cliente" name="Cliente — necessidade · visão · intenção"/>
    <bpmn:participant id="Participant_CA_SUPORTE" name="SUPORTE — Ser ouvido e ter o problema resolvido" processRef="Process_CA_SUPORTE"/>
    <bpmn:participant id="Participant_CompraUtil" name="Macroprocessos COMPRA · UTILIZAÇÃO"/>
    <bpmn:participant id="Participant_CA_SUPORTE_S1_OuvirRegistrar" name="S1 — Ouvir e registrar o caso" processRef="Process_CA_SUPORTE_S1_OuvirRegistrar"/>
    <bpmn:participant id="Participant_CA_SUPORTE_S2_DiagnosticarRotear" name="S2 — Diagnosticar e rotear o caso" processRef="Process_CA_SUPORTE_S2_DiagnosticarRotear"/>
    <bpmn:participant id="Participant_CA_SUPORTE_S3_ResolverEncaminhar" name="S3 — Resolver ou encaminhar o caso" processRef="Process_CA_SUPORTE_S3_ResolverEncaminhar"/>
    <bpmn:participant id="Participant_CA_SUPORTE_S4_ConfirmarEncerrar" name="S4 — Confirmar, encerrar e aprender" processRef="Process_CA_SUPORTE_S4_ConfirmarEncerrar"/>
    <bpmn:participant id="Participant_Ouvidoria" name="Ouvidoria / ANS"/>
    <bpmn:messageFlow id="MF_SP_01" sourceRef="Participant_Cliente" targetRef="SP_Start_Contato"/>
    <bpmn:messageFlow id="MF_SP_02" sourceRef="Participant_CompraUtil" targetRef="SP_Start_Insatisfacao"/>
    <bpmn:messageFlow id="MF_SP_03" sourceRef="Participant_CompraUtil" targetRef="SP_Start_SLA"/>
    <bpmn:messageFlow id="MF_SP_04" name="T-07 Intenção de compra" sourceRef="SP_End_Compra" targetRef="Participant_CompraUtil"/>
    <bpmn:messageFlow id="MF_SP_05" name="Manifestação" sourceRef="S4_T_Ouvidoria" targetRef="Participant_Ouvidoria"/>
    <bpmn:textAnnotation id="TextAnnotation_16ktuur">
      <bpmn:text>* Reclame Aqui</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_11mohme" associationDirection="None" sourceRef="SP_Start_Insatisfacao" targetRef="TextAnnotation_16ktuur"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_CA_SUPORTE" name="SUPORTE — Ser ouvido e ter o problema resolvido" isExecutable="true" camunda:versionTag="3.0.0-arq01" camunda:historyTimeToLive="180">
    <bpmn:documentation>Macroprocesso 3 (ARQ-01 §6). Um único caso por problema (FR-04), seja o contato iniciado pelo cliente ou pela organização. Só encerra com confirmação do cliente; não resolvido vai à ouvidoria. Variantes: origemSuporte, rotaAtendimento, naturezaCaso.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_Process_CA_SUPORTE">
      <bpmn:lane id="LN_CA3_SUPORTE_Atendente" name="Atendente de suporte">
        <bpmn:documentation>Dimensão: Staff · Origem: SUB-01 §2.18 · Ref: SP_CA_S1</bpmn:documentation>
        <bpmn:flowNodeRef>SP_Start_Contato</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP_Start_Insatisfacao</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP_Start_SLA</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP_GW_MergeInicio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP_CA_S1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP_GW_Origem</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LN_CA3_SUPORTE_Triagem" name="Analista de triagem e roteamento">
        <bpmn:documentation>Dimensão: Staff · Origem: SUB-01 §2.19 · Ref: SP_CA_S2</bpmn:documentation>
        <bpmn:flowNodeRef>SP_CA_S2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP_GW_Compra</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP_End_Compra</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LN_CA3_SUPORTE_Resolucao" name="Resolução e encaminhamento">
        <bpmn:documentation>Dimensão: Staff · Origem: SUB-01 §2.20 · Ref: SP_CA_S3</bpmn:documentation>
        <bpmn:flowNodeRef>SP_GW_MergeResolver</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP_CA_S3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LN_CA3_SUPORTE_Qualidade" name="Qualidade e melhoria contínua">
        <bpmn:documentation>Dimensão: Staff · Origem: SUB-01 §2.21 · Ref: SP_CA_S4</bpmn:documentation>
        <bpmn:flowNodeRef>SP_CA_S4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP_GW_Desfecho</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP_End_Resolvido</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP_End_Ouvidoria</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP_End_SemConfirmacao</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="SP_Start_Contato" name="Cliente procura atendimento">
      <bpmn:documentation>EV-S01. Qualquer canal. Payload: clienteId, canal, mensagemCliente. | Origem: M3_Start_Contato</bpmn:documentation>
      <bpmn:extensionElements>
        <camunda:executionListener expression="${execution.setVariable('origemSuporte', 'CLIENTE')}" event="start"/>
      </bpmn:extensionElements>
      <bpmn:outgoing>F_CA_SUPORTE_01</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_CA_ContatoCliente"/>
    </bpmn:startEvent>
    <bpmn:startEvent id="SP_Start_Insatisfacao" name="Experiência insatisfatória">
      <bpmn:documentation>EV-S02 (T-04). | Origem: M2_EV_ServiceRecovery + M3_Start_ServiceRecovery (SO-04)</bpmn:documentation>
      <bpmn:extensionElements>
        <camunda:executionListener expression="${execution.setVariable('origemSuporte', 'RECOVERY')}" event="start"/>
      </bpmn:extensionElements>
      <bpmn:outgoing>F_CA_SUPORTE_02</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_CA_ExperienciaInsatisfatoria"/>
    </bpmn:startEvent>
    <bpmn:startEvent id="SP_Start_SLA" name="SLA de entrega violado">
      <bpmn:documentation>EV-S03 (T-05). | Origem: M2_Boundary_Escalacao + ES_EV_EscalarSLA</bpmn:documentation>
      <bpmn:extensionElements>
        <camunda:executionListener expression="${execution.setVariable('origemSuporte', 'SLA')}" event="start"/>
      </bpmn:extensionElements>
      <bpmn:outgoing>F_CA_SUPORTE_03</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_CA_SLAEntregaViolado"/>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="SP_GW_MergeInicio" name="">
      <bpmn:incoming>F_CA_SUPORTE_01</bpmn:incoming>
      <bpmn:incoming>F_CA_SUPORTE_02</bpmn:incoming>
      <bpmn:incoming>F_CA_SUPORTE_03</bpmn:incoming>
      <bpmn:outgoing>F_CA_SUPORTE_04</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:callActivity id="SP_CA_S1" name="Ouvir e registrar o caso" camunda:asyncBefore="true" calledElement="Process_CA_SUPORTE_S1_OuvirRegistrar">
      <bpmn:documentation>Origem: ARQ-01 S1</bpmn:documentation>
      <bpmn:documentation>Contrato de variáveis a confirmar com a equipe: este passo pode produzir/consumir variáveis em execução (delegados/formulários) não declaradas no modelo; a lista explícita reflete o que o próprio modelo comprova.</bpmn:documentation>
      <bpmn:extensionElements>
        <camunda:in businessKey="#{execution.processBusinessKey}"/>
        <camunda:in source="origemSuporte" target="origemSuporte"/>
        <camunda:out source="urgenciaSugerida" target="urgenciaSugerida"/>
      </bpmn:extensionElements>
      <bpmn:incoming>F_CA_SUPORTE_04</bpmn:incoming>
      <bpmn:outgoing>F_CA_SUPORTE_05</bpmn:outgoing>
      <bpmn:property id="Property_SP_CA_S1_targetRef" name="__targetRef_placeholder"/>
      <bpmn:dataInputAssociation id="DIA_INS_030_1">
        <bpmn:sourceRef>DSR_INS_030_1</bpmn:sourceRef>
        <bpmn:targetRef>Property_SP_CA_S1_targetRef</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="SP_GW_Origem" name="Origem do suporte?" default="F_CA_SUPORTE_07">
      <bpmn:documentation>Origem: [SEM ORIGEM] — ARQ-01 GW-S01</bpmn:documentation>
      <bpmn:documentation>Regra: contato do cliente abre atendimento pleno; eventos internos seguem trilha reduzida — dono: Atendente de suporte</bpmn:documentation>
      <bpmn:incoming>F_CA_SUPORTE_05</bpmn:incoming>
      <bpmn:outgoing>F_CA_SUPORTE_06</bpmn:outgoing>
      <bpmn:outgoing>F_CA_SUPORTE_07</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:callActivity id="SP_CA_S2" name="Diagnosticar e rotear o caso" camunda:asyncBefore="true" calledElement="Process_CA_SUPORTE_S2_DiagnosticarRotear">
      <bpmn:documentation>Origem: ARQ-01 S2</bpmn:documentation>
      <bpmn:documentation>Contrato de variáveis a confirmar com a equipe: este passo pode produzir/consumir variáveis em execução (delegados/formulários) não declaradas no modelo; a lista explícita reflete o que o próprio modelo comprova.</bpmn:documentation>
      <bpmn:extensionElements>
        <camunda:in businessKey="#{execution.processBusinessKey}"/>
        <camunda:in source="questaoClinica" target="questaoClinica"/>
        <camunda:out source="rotaAtendimento" target="rotaAtendimento"/>
      </bpmn:extensionElements>
      <bpmn:incoming>F_CA_SUPORTE_06</bpmn:incoming>
      <bpmn:outgoing>F_CA_SUPORTE_08</bpmn:outgoing>
      <bpmn:property id="Property_SP_CA_S2_targetRef" name="__targetRef_placeholder"/>
      <bpmn:dataInputAssociation id="DIA_INS_031_1">
        <bpmn:sourceRef>DSR_INS_031_1</bpmn:sourceRef>
        <bpmn:targetRef>Property_SP_CA_S2_targetRef</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="SP_GW_Compra" name="Intenção de compra?" default="F_CA_SUPORTE_10">
      <bpmn:documentation>Origem: [SEM ORIGEM] — ARQ-01 GW-S02 (PD-05)</bpmn:documentation>
      <bpmn:documentation>Regra: sinal de intenção de compra dentro do suporte devolve o caso à compra — dono: Analista de triagem e roteamento</bpmn:documentation>
      <bpmn:incoming>F_CA_SUPORTE_08</bpmn:incoming>
      <bpmn:outgoing>F_CA_SUPORTE_09</bpmn:outgoing>
      <bpmn:outgoing>F_CA_SUPORTE_10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="SP_End_Compra" name="Encaminhado à COMPRA">
      <bpmn:documentation>T-07 → COMPRA C1 (proposto — PD-05). O caso é encerrado sem o cliente recomeçar. | Origem: [SEM ORIGEM] — ARQ-01 T-07</bpmn:documentation>
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="transicao">T-07</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>F_CA_SUPORTE_09</bpmn:incoming>
      <bpmn:messageEventDefinition messageRef="Message_CA_NovaNecessidade" camunda:delegateExpression="${journeyTransitionPublisher}"/>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="SP_GW_MergeResolver" name="">
      <bpmn:incoming>F_CA_SUPORTE_07</bpmn:incoming>
      <bpmn:incoming>F_CA_SUPORTE_10</bpmn:incoming>
      <bpmn:incoming>F_CA_SUPORTE_16</bpmn:incoming>
      <bpmn:outgoing>F_CA_SUPORTE_11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:callActivity id="SP_CA_S3" name="Resolver ou encaminhar o caso" camunda:asyncBefore="true" calledElement="Process_CA_SUPORTE_S3_ResolverEncaminhar">
      <bpmn:documentation>Origem: ARQ-01 S3</bpmn:documentation>
      <bpmn:documentation>Contrato de variáveis a confirmar com a equipe: este passo pode produzir/consumir variáveis em execução (delegados/formulários) não declaradas no modelo; a lista explícita reflete o que o próprio modelo comprova.</bpmn:documentation>
      <bpmn:extensionElements>
        <camunda:in businessKey="#{execution.processBusinessKey}"/>
        <camunda:in source="origemSuporte" target="origemSuporte"/>
        <camunda:in source="rotaAtendimento" target="rotaAtendimento"/>
        <camunda:in source="confiancaIA" target="confiancaIA"/>
        <camunda:in source="limiarConfianca" target="limiarConfianca"/>
        <camunda:in source="respostaVerificada" target="respostaVerificada"/>
        <camunda:in source="naturezaCaso" target="naturezaCaso"/>
        <camunda:in source="resolvidoPrimeiroContato" target="resolvidoPrimeiroContato"/>
      </bpmn:extensionElements>
      <bpmn:incoming>F_CA_SUPORTE_11</bpmn:incoming>
      <bpmn:outgoing>F_CA_SUPORTE_12</bpmn:outgoing>
      <bpmn:property id="Property_SP_CA_S3_targetRef" name="__targetRef_placeholder"/>
      <bpmn:dataInputAssociation id="DIA_INS_032_1">
        <bpmn:sourceRef>DSR_INS_032_1</bpmn:sourceRef>
        <bpmn:targetRef>Property_SP_CA_S3_targetRef</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:callActivity>
    <bpmn:callActivity id="SP_CA_S4" name="Confirmar, encerrar e aprender" camunda:asyncBefore="true" calledElement="Process_CA_SUPORTE_S4_ConfirmarEncerrar">
      <bpmn:documentation>Origem: ARQ-01 S4</bpmn:documentation>
      <bpmn:documentation>Contrato de variáveis a confirmar com a equipe: este passo pode produzir/consumir variáveis em execução (delegados/formulários) não declaradas no modelo; a lista explícita reflete o que o próprio modelo comprova.</bpmn:documentation>
      <bpmn:extensionElements>
        <camunda:in businessKey="#{execution.processBusinessKey}"/>
        <camunda:in source="origemSuporte" target="origemSuporte"/>
        <camunda:in source="rotaAtendimento" target="rotaAtendimento"/>
        <camunda:in source="clienteConfirmouResolucao" target="clienteConfirmouResolucao"/>
        <camunda:out source="desfechoSuporte" target="desfechoSuporte"/>
        <camunda:out source="rotaAtendimento" target="rotaAtendimento"/>
        <camunda:out source="tipoEventoNegocio" target="tipoEventoNegocio"/>
      </bpmn:extensionElements>
      <bpmn:incoming>F_CA_SUPORTE_12</bpmn:incoming>
      <bpmn:outgoing>F_CA_SUPORTE_13</bpmn:outgoing>
      <bpmn:property id="Property_SP_CA_S4_targetRef" name="__targetRef_placeholder"/>
      <bpmn:dataInputAssociation id="DIA_INS_033_1">
        <bpmn:sourceRef>DOR_INS_033_1</bpmn:sourceRef>
        <bpmn:targetRef>Property_SP_CA_S4_targetRef</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataInputAssociation id="DIA_INS_034_1">
        <bpmn:sourceRef>DOR_INS_034_1</bpmn:sourceRef>
        <bpmn:targetRef>Property_SP_CA_S4_targetRef</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="SP_GW_Desfecho" name="Desfecho do caso?" default="F_CA_SUPORTE_17">
      <bpmn:documentation>Regra: reencaminhar devolve ao especialista; resolvido confirma; ouvidoria registra manifestação; sem confirmação encerra — dono: Qualidade e melhoria contínua</bpmn:documentation>
      <bpmn:incoming>F_CA_SUPORTE_13</bpmn:incoming>
      <bpmn:outgoing>F_CA_SUPORTE_14</bpmn:outgoing>
      <bpmn:outgoing>F_CA_SUPORTE_15</bpmn:outgoing>
      <bpmn:outgoing>F_CA_SUPORTE_16</bpmn:outgoing>
      <bpmn:outgoing>F_CA_SUPORTE_17</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="SP_End_Resolvido" name="Problema resolvido e confirmado">
      <bpmn:documentation>Origem: M3_End_Reativo_OK + M3_End_Reativo_Humano + M2_End_Recuperado (SO-05)</bpmn:documentation>
      <bpmn:incoming>F_CA_SUPORTE_14</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="SP_End_Ouvidoria" name="Encaminhado à ouvidoria/ANS com retorno">
      <bpmn:documentation>Origem: M2_End_NaoRecuperado</bpmn:documentation>
      <bpmn:incoming>F_CA_SUPORTE_15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="SP_End_SemConfirmacao" name="Encerrado sem confirmação do cliente">
      <bpmn:documentation>⚠️ PD-03 / I-07 [PENDENTE]: decidir se silêncio de 24h conta como resolvido ou reabre. | Origem: M3_Boundary_SemConfirmacao → M3_End_Aprendizado</bpmn:documentation>
      <bpmn:incoming>F_CA_SUPORTE_17</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_CA_SUPORTE_01" sourceRef="SP_Start_Contato" targetRef="SP_GW_MergeInicio"/>
    <bpmn:sequenceFlow id="F_CA_SUPORTE_02" sourceRef="SP_Start_Insatisfacao" targetRef="SP_GW_MergeInicio"/>
    <bpmn:sequenceFlow id="F_CA_SUPORTE_03" sourceRef="SP_Start_SLA" targetRef="SP_GW_MergeInicio"/>
    <bpmn:sequenceFlow id="F_CA_SUPORTE_04" sourceRef="SP_GW_MergeInicio" targetRef="SP_CA_S1"/>
    <bpmn:sequenceFlow id="F_CA_SUPORTE_05" sourceRef="SP_CA_S1" targetRef="SP_GW_Origem"/>
    <bpmn:sequenceFlow id="F_CA_SUPORTE_06" name="Cliente" sourceRef="SP_GW_Origem" targetRef="SP_CA_S2">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${origemSuporte == "CLIENTE"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_CA_SUPORTE_07" name="Recovery / SLA" sourceRef="SP_GW_Origem" targetRef="SP_GW_MergeResolver"/>
    <bpmn:sequenceFlow id="F_CA_SUPORTE_08" sourceRef="SP_CA_S2" targetRef="SP_GW_Compra"/>
    <bpmn:sequenceFlow id="F_CA_SUPORTE_09" name="Sim" sourceRef="SP_GW_Compra" targetRef="SP_End_Compra">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${execution.getVariable("intencaoCompra") == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_CA_SUPORTE_10" name="Não" sourceRef="SP_GW_Compra" targetRef="SP_GW_MergeResolver"/>
    <bpmn:sequenceFlow id="F_CA_SUPORTE_16" name="Não resolvido pela IA — especialista" sourceRef="SP_GW_Desfecho" targetRef="SP_GW_MergeResolver">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${desfechoSuporte == "REENCAMINHAR"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_CA_SUPORTE_11" sourceRef="SP_GW_MergeResolver" targetRef="SP_CA_S3"/>
    <bpmn:sequenceFlow id="F_CA_SUPORTE_12" sourceRef="SP_CA_S3" targetRef="SP_CA_S4"/>
    <bpmn:sequenceFlow id="F_CA_SUPORTE_13" sourceRef="SP_CA_S4" targetRef="SP_GW_Desfecho"/>
    <bpmn:sequenceFlow id="F_CA_SUPORTE_14" name="Resolvido" sourceRef="SP_GW_Desfecho" targetRef="SP_End_Resolvido">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${desfechoSuporte == "RESOLVIDO"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_CA_SUPORTE_15" name="Ouvidoria" sourceRef="SP_GW_Desfecho" targetRef="SP_End_Ouvidoria">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${desfechoSuporte == "OUVIDORIA"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_CA_SUPORTE_17" name="Sem confirmação" sourceRef="SP_GW_Desfecho" targetRef="SP_End_SemConfirmacao"/>
    <bpmn:dataStoreReference id="DSR_INS_030_1" name="Histórico do cliente" dataStoreRef="DS_INS_030">
      <bpmn:documentation>Insumo INS-030 · Origem: SUB-01 §2.18 Insumo (JIT); SUB-01 §2.18 · coluna Subprocesso genérico; SUB-01 §2.18 · coluna Entrada; CA_3 · S1_T_Contexto · rótulo</bpmn:documentation>
    </bpmn:dataStoreReference>
    <bpmn:dataStoreReference id="DSR_INS_031_1" name="Base de conhecimento/regras de triagem" dataStoreRef="DS_INS_031">
      <bpmn:documentation>Insumo INS-031 · Origem: SUB-01 §2.19 Insumo (JIT); SUB-01 §2.19 · coluna Subprocesso genérico</bpmn:documentation>
    </bpmn:dataStoreReference>
    <bpmn:dataStoreReference id="DSR_INS_032_1" name="Recursos de resolução (scripts, alçadas, sistemas)" dataStoreRef="DS_INS_032">
      <bpmn:documentation>Insumo INS-032 · Origem: SUB-01 §2.20 Insumo (JIT); SUB-01 §2.20 · coluna Subprocesso genérico ⚠️ AMBIGUIDADE — Natureza DS × DO dúbia: scripts e alçadas são material de referência consultado (DS), mas 'sistemas' não é dado nem documento. Modelado como DS de referência; alternativa: DO por caso, ou excluir 'sistemas' do elemento de dado.</bpmn:documentation>
    </bpmn:dataStoreReference>
    <bpmn:dataObject id="DO_INS_033_1" name="Dados do desfecho do caso (registro de resolução)">
      <bpmn:documentation>Insumo INS-033 · Origem: SUB-01 §2.21 Insumo (JIT); SUB-01 §2.21 · coluna Subprocesso genérico; SUB-01 §2.21 · coluna Entrada</bpmn:documentation>
    </bpmn:dataObject>
    <bpmn:dataObjectReference id="DOR_INS_033_1" name="Dados do desfecho do caso (registro de resolução)" dataObjectRef="DO_INS_033_1">
      <bpmn:documentation>Insumo INS-033 · Origem: SUB-01 §2.21 Insumo (JIT); SUB-01 §2.21 · coluna Subprocesso genérico; SUB-01 §2.21 · coluna Entrada</bpmn:documentation>
    </bpmn:dataObjectReference>
    <bpmn:dataObject id="DO_INS_034_1" name="Formulário de satisfação">
      <bpmn:documentation>Insumo INS-034 · Origem: SUB-01 §2.21 Insumo (JIT); SUB-01 §2.21 · coluna Subprocesso genérico</bpmn:documentation>
    </bpmn:dataObject>
    <bpmn:dataObjectReference id="DOR_INS_034_1" name="Formulário de satisfação" dataObjectRef="DO_INS_034_1">
      <bpmn:documentation>Insumo INS-034 · Origem: SUB-01 §2.21 Insumo (JIT); SUB-01 §2.21 · coluna Subprocesso genérico</bpmn:documentation>
    </bpmn:dataObjectReference>
  </bpmn:process>
  <bpmn:process id="Process_CA_SUPORTE_S1_OuvirRegistrar" name="S1 — Ouvir e registrar o caso" isExecutable="true" camunda:versionTag="3.0.0-arq01" camunda:historyTimeToLive="180">
    <bpmn:documentation>Receber o cliente com contexto completo (o cliente não repete a história) e registrar o caso na jornada certa. Quando a iniciativa é da organização, o cliente é avisado de imediato.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_Process_CA_SUPORTE_S1_OuvirRegistrar">
      <bpmn:lane id="LN_CA3_S1_Verificador" name="Verificador de identidade">
        <bpmn:documentation>Dimensão: Staff · Origem: SUB-01 §2.22 · Ref: S1_CA_H1</bpmn:documentation>
        <bpmn:flowNodeRef>S1_Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S1_CA_H1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S1_GW_MergeCons</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S1_B_Consent</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LN_CA3_S1_Insumos" name="Disponibilização de insumos">
        <bpmn:documentation>Dimensão: Insumo JIT · Origem: SUB-01 §2.18 · Ref: SP_CA_S1</bpmn:documentation>
        <bpmn:flowNodeRef>S1_T_Contexto</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S1_GW_Iniciativa</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LN_CA3_S1_Atendente" name="Atendente de suporte">
        <bpmn:documentation>Dimensão: Staff · Origem: SUB-01 §2.18 · Ref: SP_CA_S1</bpmn:documentation>
        <bpmn:flowNodeRef>S1_EV_Cuidando</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S1_GW_Merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S1_End</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S1_Start" name="Caso a registrar">
      <bpmn:outgoing>F_CA_SUPORTE_S1_OuvirRegistrar_01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:callActivity id="S1_CA_H1" name="Identificar cliente e verificar consentimento" camunda:asyncBefore="true" calledElement="Process_CA_H1_IdentidadeConsentimento">
      <bpmn:documentation>Origem: [SEM ORIGEM] — ARQ-01 §7 H1 (chamado por S1)</bpmn:documentation>
      <bpmn:documentation>Contrato de variáveis a confirmar com a equipe: este passo pode produzir/consumir variáveis em execução (delegados/formulários) não declaradas no modelo; a lista explícita reflete o que o próprio modelo comprova.</bpmn:documentation>
      <bpmn:extensionElements>
        <camunda:in businessKey="#{execution.processBusinessKey}"/>
        <camunda:in sourceExpression="atendimento" target="finalidade"/>
        <camunda:out source="consentimentoValido" target="consentimentoValido"/>
        <camunda:out source="identidadeUnificada" target="identidadeUnificada"/>
      </bpmn:extensionElements>
      <bpmn:incoming>F_CA_SUPORTE_S1_OuvirRegistrar_01</bpmn:incoming>
      <bpmn:outgoing>F_CA_SUPORTE_S1_OuvirRegistrar_02</bpmn:outgoing>
      <bpmn:property id="Property_S1_CA_H1_targetRef" name="__targetRef_placeholder"/>
      <bpmn:dataInputAssociation id="DIA_INS_004_1">
        <bpmn:sourceRef>DOR_INS_004_1</bpmn:sourceRef>
        <bpmn:targetRef>Property_S1_CA_H1_targetRef</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="S1_GW_MergeCons" name="">
      <bpmn:incoming>F_CA_SUPORTE_S1_OuvirRegistrar_02</bpmn:incoming>
      <bpmn:incoming>F_CA_SUPORTE_S1_OuvirRegistrar_05</bpmn:incoming>
      <bpmn:outgoing>F_CA_SUPORTE_S1_OuvirRegistrar_03</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="S1_T_Contexto" name="Montar contexto completo (360 + histórico)" camunda:asyncBefore="true" camunda:delegateExpression="${contextAssemblyService}">
      <bpmn:documentation>Produz contextoCliente e protocoloId (se houver caso aberto). | Origem: M3_T_Contexto</bpmn:documentation>
      <bpmn:incoming>F_CA_SUPORTE_S1_OuvirRegistrar_03</bpmn:incoming>
      <bpmn:outgoing>F_CA_SUPORTE_S1_OuvirRegistrar_04</bpmn:outgoing>
      <bpmn:property id="Property_S1_T_Contexto_targetRef" name="__targetRef_placeholder"/>
      <bpmn:dataInputAssociation id="DIA_INS_012_1">
        <bpmn:sourceRef>DSR_INS_012_1</bpmn:sourceRef>
        <bpmn:targetRef>Property_S1_T_Contexto_targetRef</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataInputAssociation id="DIA_INS_030_2">
        <bpmn:sourceRef>DSR_INS_030_2</bpmn:sourceRef>
        <bpmn:targetRef>Property_S1_T_Contexto_targetRef</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="S1_GW_Iniciativa" name="Iniciativa da organização?" default="F_CA_SUPORTE_S1_OuvirRegistrar_07">
      <bpmn:documentation>Regra: caso iniciado pela própria organização dispensa nova verificação pelo cliente; contato do cliente passa pela verificação — dono: Disponibilização de insumos</bpmn:documentation>
      <bpmn:incoming>F_CA_SUPORTE_S1_OuvirRegistrar_04</bpmn:incoming>
      <bpmn:outgoing>F_CA_SUPORTE_S1_OuvirRegistrar_06</bpmn:outgoing>
      <bpmn:outgoing>F_CA_SUPORTE_S1_OuvirRegistrar_07</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateThrowEvent id="S1_EV_Cuidando" name="Avisar que estamos cuidando">
      <bpmn:documentation>Contato proativo imediato; a Central assume em até 2h. | Origem: M3_Start_ServiceRecovery</bpmn:documentation>
      <bpmn:documentation>Marco factual: registra o que ACONTECEU, não estimativa nem previsão.</bpmn:documentation>
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="marcoJornada">SERVICE_RECOVERY</camunda:inputParameter>
          <camunda:inputParameter name="urgenciaSugerida">CRITICA</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>F_CA_SUPORTE_S1_OuvirRegistrar_06</bpmn:incoming>
      <bpmn:outgoing>F_CA_SUPORTE_S1_OuvirRegistrar_08</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_CA_ComunicarCliente" camunda:delegateExpression="${comunicarClientePublisher}"/>
    </bpmn:intermediateThrowEvent>
    <bpmn:exclusiveGateway id="S1_GW_Merge" name="">
      <bpmn:incoming>F_CA_SUPORTE_S1_OuvirRegistrar_07</bpmn:incoming>
      <bpmn:incoming>F_CA_SUPORTE_S1_OuvirRegistrar_08</bpmn:incoming>
      <bpmn:outgoing>F_CA_SUPORTE_S1_OuvirRegistrar_09</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="S1_End" name="Caso registrado">
      <bpmn:incoming>F_CA_SUPORTE_S1_OuvirRegistrar_09</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:boundaryEvent id="S1_B_Consent" name="Consentimento negado" attachedToRef="S1_CA_H1">
      <bpmn:documentation>Atendimento segue sem personalização (contexto mínimo).</bpmn:documentation>
      <bpmn:outgoing>F_CA_SUPORTE_S1_OuvirRegistrar_05</bpmn:outgoing>
      <bpmn:errorEventDefinition errorRef="Error_CA_ConsentimentoNegado"/>
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="F_CA_SUPORTE_S1_OuvirRegistrar_01" sourceRef="S1_Start" targetRef="S1_CA_H1"/>
    <bpmn:sequenceFlow id="F_CA_SUPORTE_S1_OuvirRegistrar_02" sourceRef="S1_CA_H1" targetRef="S1_GW_MergeCons"/>
    <bpmn:sequenceFlow id="F_CA_SUPORTE_S1_OuvirRegistrar_05" sourceRef="S1_B_Consent" targetRef="S1_GW_MergeCons"/>
    <bpmn:sequenceFlow id="F_CA_SUPORTE_S1_OuvirRegistrar_03" sourceRef="S1_GW_MergeCons" targetRef="S1_T_Contexto"/>
    <bpmn:sequenceFlow id="F_CA_SUPORTE_S1_OuvirRegistrar_04" sourceRef="S1_T_Contexto" targetRef="S1_GW_Iniciativa"/>
    <bpmn:sequenceFlow id="F_CA_SUPORTE_S1_OuvirRegistrar_06" name="Sim" sourceRef="S1_GW_Iniciativa" targetRef="S1_EV_Cuidando">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${origemSuporte != "CLIENTE"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_CA_SUPORTE_S1_OuvirRegistrar_07" name="Não" sourceRef="S1_GW_Iniciativa" targetRef="S1_GW_Merge"/>
    <bpmn:sequenceFlow id="F_CA_SUPORTE_S1_OuvirRegistrar_08" sourceRef="S1_EV_Cuidando" targetRef="S1_GW_Merge"/>
    <bpmn:sequenceFlow id="F_CA_SUPORTE_S1_OuvirRegistrar_09" sourceRef="S1_GW_Merge" targetRef="S1_End"/>
    <bpmn:dataObject id="DO_INS_004_1" name="Dados de identificação do cliente (dado cadastral/documento de identificação)">
      <bpmn:documentation>Insumo INS-004 · Origem: SUB-01 §2.3, §2.9, §2.22 Insumo (JIT); §3; SUB-01 §2.3 · coluna Subprocesso genérico; SUB-01 §2.3 · coluna Entrada; SUB-01 §2.9 · coluna Observação; SUB-01 §2.22 · coluna Observação; SUB-01 §3 · coluna Caixas de origem</bpmn:documentation>
    </bpmn:dataObject>
    <bpmn:dataObjectReference id="DOR_INS_004_1" name="Dados de identificação do cliente (dado cadastral/documento de identificação)" dataObjectRef="DO_INS_004_1">
      <bpmn:documentation>Insumo INS-004 · Origem: SUB-01 §2.3, §2.9, §2.22 Insumo (JIT); §3; SUB-01 §2.3 · coluna Subprocesso genérico; SUB-01 §2.3 · coluna Entrada; SUB-01 §2.9 · coluna Observação; SUB-01 §2.22 · coluna Observação; SUB-01 §3 · coluna Caixas de origem</bpmn:documentation>
    </bpmn:dataObjectReference>
    <bpmn:dataStoreReference id="DSR_INS_012_1" name="Perfil 360 do cliente" dataStoreRef="DS_INS_012">
      <bpmn:documentation>Insumo INS-012 · Origem: SUB-01 §2.10 e §2.11 Insumo (JIT); SUB-01 §2.10 · coluna Entrada; SUB-01 §2.11 · coluna Saída; CA_0 · NBA_T_Contexto · rótulo; CA_0 · EC_T_Consolidar · rótulo; CA_0 · EC_T_Consolidar · documentation; CA_1 · C1_T_Cruzar · rótulo; CA_3 · S1_T_Contexto · rótulo ⚠️ AMBIGUIDADE — SUB-01 nomeia 'Perfil do cliente' (§2.10) e 'Perfil 360 inicial consolidado' (§2.11) sem declará-los idênticos; a identidade como um único repositório vem dos rótulos do diagrama ('perfil 360' em NBA_T_Contexto, EC_T_Consolidar, C1_T_Cruzar e '360' em S1_T_Contexto). A saída em EC_T_Consolidar usa 'Produz versaoPerfil' + rótulo 'versionar perfil 360'. Alternativa: DS separados por arquivo/finalidade.</bpmn:documentation>
    </bpmn:dataStoreReference>
    <bpmn:dataStoreReference id="DSR_INS_030_2" name="Histórico do cliente" dataStoreRef="DS_INS_030">
      <bpmn:documentation>Insumo INS-030 · Origem: SUB-01 §2.18 Insumo (JIT); SUB-01 §2.18 · coluna Subprocesso genérico; SUB-01 §2.18 · coluna Entrada; CA_3 · S1_T_Contexto · rótulo</bpmn:documentation>
    </bpmn:dataStoreReference>
  </bpmn:process>
  <bpmn:process id="Process_CA_SUPORTE_S2_DiagnosticarRotear" name="S2 — Diagnosticar e rotear o caso" isExecutable="true" camunda:versionTag="3.0.0-arq01" camunda:historyTimeToLive="180">
    <bpmn:documentation>Entender a natureza do caso e mandá-lo para quem resolve. Fronteira clínica: 100% do clínico vai a humano (corrige I-03).</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_Process_CA_SUPORTE_S2_DiagnosticarRotear">
      <bpmn:lane id="LN_CA3_S2_Triagem" name="Analista de triagem e roteamento">
        <bpmn:documentation>Dimensão: Staff · Origem: SUB-01 §2.19 · Ref: SP_CA_S2</bpmn:documentation>
        <bpmn:flowNodeRef>S2_Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S2_T_Triagem</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S2_GW_Clinico</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S2_End_Humano</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S2_End_IA</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S2_Start" name="Caso registrado">
      <bpmn:outgoing>F_CA_SUPORTE_S2_DiagnosticarRotear_01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="S2_T_Triagem" name="Triar intenção (IA): administrativa × clínica" camunda:asyncBefore="true" camunda:delegateExpression="${intentTriageAI}">
      <bpmn:documentation>Produz questaoClinica, naturezaCaso ∈ {administrativo, clinico} e intencaoCompra. | Origem: M3_T_Triagem</bpmn:documentation>
      <bpmn:incoming>F_CA_SUPORTE_S2_DiagnosticarRotear_01</bpmn:incoming>
      <bpmn:outgoing>F_CA_SUPORTE_S2_DiagnosticarRotear_02</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="S2_GW_Clinico" name="Questão clínica?" default="F_CA_SUPORTE_S2_DiagnosticarRotear_04">
      <bpmn:documentation>Origem: M3_GW_Clinico</bpmn:documentation>
      <bpmn:documentation>Regra: questão clínica vai a trilha assistencial; questão administrativa segue rota de atendimento — dono: Analista de triagem e roteamento</bpmn:documentation>
      <bpmn:documentation>Guard-rail: a IA apenas recomenda — triagem clínica, negativa e suspeita de fraude são sempre humanas. Proibido usar dados de saúde para seleção de risco (LGPD art. 11 §5º).</bpmn:documentation>
      <bpmn:incoming>F_CA_SUPORTE_S2_DiagnosticarRotear_02</bpmn:incoming>
      <bpmn:outgoing>F_CA_SUPORTE_S2_DiagnosticarRotear_03</bpmn:outgoing>
      <bpmn:outgoing>F_CA_SUPORTE_S2_DiagnosticarRotear_04</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="S2_End_Humano" name="Rota: especialista clínico">
      <bpmn:documentation>Corrige I-03: a origem mandava o ramo clínico a uma tarefa de IA duplicada (Activity_1q3x2fz). | Origem: M3_F10c (corrigido)</bpmn:documentation>
      <bpmn:extensionElements>
        <camunda:executionListener expression="${execution.setVariable('rotaAtendimento', 'HUMANO')}" event="start"/>
      </bpmn:extensionElements>
      <bpmn:incoming>F_CA_SUPORTE_S2_DiagnosticarRotear_03</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="S2_End_IA" name="Rota: IA de atendimento">
      <bpmn:documentation>Origem: M3_F10d</bpmn:documentation>
      <bpmn:extensionElements>
        <camunda:executionListener expression="${execution.setVariable('rotaAtendimento', 'IA')}" event="start"/>
      </bpmn:extensionElements>
      <bpmn:incoming>F_CA_SUPORTE_S2_DiagnosticarRotear_04</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_CA_SUPORTE_S2_DiagnosticarRotear_01" sourceRef="S2_Start" targetRef="S2_T_Triagem"/>
    <bpmn:sequenceFlow id="F_CA_SUPORTE_S2_DiagnosticarRotear_02" sourceRef="S2_T_Triagem" targetRef="S2_GW_Clinico"/>
    <bpmn:sequenceFlow id="F_CA_SUPORTE_S2_DiagnosticarRotear_03" name="Sim — 100% humano" sourceRef="S2_GW_Clinico" targetRef="S2_End_Humano">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${questaoClinica == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_CA_SUPORTE_S2_DiagnosticarRotear_04" name="Não — administrativa" sourceRef="S2_GW_Clinico" targetRef="S2_End_IA"/>
  </bpmn:process>
  <bpmn:process id="Process_CA_SUPORTE_S3_ResolverEncaminhar" name="S3 — Resolver ou encaminhar o caso" isExecutable="true" camunda:versionTag="3.0.0-arq01" camunda:historyTimeToLive="180">
    <bpmn:documentation>Resolver no primeiro contato; se não der, comprometer prazo e cumprir. Concentra todo tratamento humano de exceção: IA, especialista, enfermagem de navegação, service recovery e intervenção por SLA.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_Process_CA_SUPORTE_S3_ResolverEncaminhar">
      <bpmn:lane id="LN_CA3_S3_Resolucao" name="Resolução e encaminhamento">
        <bpmn:documentation>Dimensão: Staff · Origem: SUB-01 §2.20 · Ref: SP_CA_S3</bpmn:documentation>
        <bpmn:flowNodeRef>S3_Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S3_GW_Origem</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S3_T_IA</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S3_GW_Confianca</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S3_End_IA</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S3_GW_MergeHumano</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S3_GW_Natureza</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S3_T_Especialista</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S3_GW_MergeAtend</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S3_GW_PrimeiroContato</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S3_End_Resolvido</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S3_T_Protocolo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S3_T_Cumprir</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S3_End_Priorizado</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S3_End_Retorno</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S3_T_Recovery</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S3_End_Supervisor</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S3_End_Recovery</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S3_T_Intervencao</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S3_End_Intervencao</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S3_B_SLARecovery</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S3_B_D1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S3_B_SLA_Especialista</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S3_T_EscalarEspecialista</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S3_End_SLA_Especialista</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S3_B_SLA_Protocolo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S3_T_EscalarProtocolo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S3_End_SLA_Protocolo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S3_B_SLA_Intervencao</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S3_T_EscalarIntervencao</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S3_End_SLA_Intervencao</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LN_CA3_S3_Supervisao" name="Supervisão da experiência">
        <bpmn:documentation>Dimensão: Staff · Origem: candidateGroups da tarefa (supervisao-experiencia) e rótulo de S3_T_Supervisor</bpmn:documentation>
        <bpmn:flowNodeRef>S3_T_Priorizar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S3_T_Supervisor</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S3_B_SLA_Priorizar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S3_T_EscalarPriorizar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S3_End_SLA_Priorizar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S3_B_SLA_Supervisor</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S3_T_EscalarSupervisao</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S3_End_SLA_Supervisao</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LN_CA3_S3_Enfermagem" name="Enfermagem de navegação">
        <bpmn:documentation>Dimensão: Staff · Origem: label (rótulo de S3_T_Enfermagem)</bpmn:documentation>
        <bpmn:flowNodeRef>S3_T_Enfermagem</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S3_B_SLA_Enfermagem</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S3_T_EscalarEnfermagem</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S3_End_SLA_Enfermagem</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S3_Start" name="Caso roteado">
      <bpmn:outgoing>F_CA_SUPORTE_S3_ResolverEncaminhar_01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="S3_GW_Origem" name="Tipo de tratamento?" default="F_CA_SUPORTE_S3_ResolverEncaminhar_04">
      <bpmn:documentation>Regra: rota por origem do caso — resposta por IA, recuperação de experiência ou atendimento humano — dono: Resolução e encaminhamento</bpmn:documentation>
      <bpmn:incoming>F_CA_SUPORTE_S3_ResolverEncaminhar_01</bpmn:incoming>
      <bpmn:outgoing>F_CA_SUPORTE_S3_ResolverEncaminhar_02</bpmn:outgoing>
      <bpmn:outgoing>F_CA_SUPORTE_S3_ResolverEncaminhar_03</bpmn:outgoing>
      <bpmn:outgoing>F_CA_SUPORTE_S3_ResolverEncaminhar_04</bpmn:outgoing>
      <bpmn:outgoing>F_CA_SUPORTE_S3_ResolverEncaminhar_05</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="S3_T_IA" name="Responder com contexto (IA de atendimento)" camunda:asyncBefore="true" camunda:delegateExpression="${contactCenterAI}">
      <bpmn:documentation>Produz confiancaIA, respostaVerificada, resposta. | Origem: M3_T_IAResponde</bpmn:documentation>
      <bpmn:documentation>Guard-rail: a IA apenas recomenda — triagem clínica, negativa e suspeita de fraude são sempre humanas. Proibido usar dados de saúde para seleção de risco (LGPD art. 11 §5º).</bpmn:documentation>
      <bpmn:incoming>F_CA_SUPORTE_S3_ResolverEncaminhar_02</bpmn:incoming>
      <bpmn:outgoing>F_CA_SUPORTE_S3_ResolverEncaminhar_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="S3_GW_Confianca" name="Confiança suficiente e resposta verificada?" default="F_CA_SUPORTE_S3_ResolverEncaminhar_08">
      <bpmn:documentation>Origem: M3_GW_Confianca</bpmn:documentation>
      <bpmn:documentation>Regra: resposta da IA só é entregue com confiança suficiente e verificação; caso contrário, vai a humano — dono: Resolução e encaminhamento</bpmn:documentation>
      <bpmn:documentation>Guard-rail: a IA apenas recomenda — triagem clínica, negativa e suspeita de fraude são sempre humanas. Proibido usar dados de saúde para seleção de risco (LGPD art. 11 §5º).</bpmn:documentation>
      <bpmn:incoming>F_CA_SUPORTE_S3_ResolverEncaminhar_06</bpmn:incoming>
      <bpmn:outgoing>F_CA_SUPORTE_S3_ResolverEncaminhar_07</bpmn:outgoing>
      <bpmn:outgoing>F_CA_SUPORTE_S3_ResolverEncaminhar_08</bpmn:outgoing>
    </bpmn:exclusiveGateway>
