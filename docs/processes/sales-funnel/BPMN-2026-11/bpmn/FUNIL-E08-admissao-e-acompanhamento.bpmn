<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="Definitions_FUNIL_E08" targetNamespace="urn:funil:descritivo:etapa8" exporter="build_etapa08.py" exporterVersion="1.0.0">
  <bpmn:collaboration id="Collaboration_FUNIL_E08" name="Etapa 8 — Admissão e acompanhamento">
    <bpmn:participant id="Participant_Comprador" name="Comprador"><bpmn:documentation>Papel do contratante. Pool externo (caixa-preta): consulta o andamento (RN 623 art. 13 §ú, baseline L68) e recebe resposta à própria consulta. NENHUMA mensagem proativa (RT-D4 herdado; GAP-CONSENT-ADMISSAO). Nenhuma tarefa inventada neste pool.</bpmn:documentation></bpmn:participant>
    <bpmn:participant id="Participant_Operadora" name="Plataforma da operadora" processRef="Process_Operadora"><bpmn:documentation>Plataforma da operadora (maezo-operadora). Lanes: cadastro, comercial. Rastreador de 7 estágios, catálogo de prazos (DMN funnel_deadline_catalog), regra prazo-só-norma-nomeada (RL-SF-035/RL-REG-27), aviso INTERNO de estágio estourado, cobertura vigente A4 (RL-SF-003 FECHADO). Épicos E-SF-08 (mesclado PR 1271), E-SF-05r, E-SF-47.</bpmn:documentation></bpmn:participant>
    <bpmn:participant id="Participant_ExecutorAMH" name="Executor comercial e lago" processRef="Process_ExecutorAMH"><bpmn:documentation>Executor comercial e lago (amh-data-platform). Fonte competente do vínculo/cobertura (campos vigencia_inicio, cancelamento, situacao_cadastral — RL-SF-003, RLR:11); leitura, nenhum comando. isExecutable=false.</bpmn:documentation></bpmn:participant>
    <bpmn:messageFlow id="MsgFlow_AdmissaoIniciada" name="Admissão iniciada — contrato emitido" sourceRef="Participant_ExecutorAMH" targetRef="StartEvent_AdmissaoIniciada" />
    <bpmn:messageFlow id="MsgFlow_ConsultaAndamento" name="Consulta de andamento — iniciada pelo beneficiário" sourceRef="Participant_Comprador" targetRef="StartEvent_ConsultaBeneficiario" />
    <bpmn:messageFlow id="MsgFlow_RespostaAndamento" name="Andamento e datas — resposta à consulta (nunca proativa)" sourceRef="Task_RespondeAndamento" targetRef="Participant_Comprador" />
    <bpmn:messageFlow id="MsgFlow_A4Registro" name="customer-coverage.proposed.v1 (leitura — sem comando)" sourceRef="Task_RegistraVigenciaNaFonte" targetRef="Task_ConsultaCoberturaFonte" />
    <bpmn:textAnnotation id="Annotation_Legenda"><bpmn:text>LEGENDA — contorno/fundo vermelho = PORTÃO FECHADO / caminho fechado ativo (RL-SF-035/RL-REG-27 prazo-só-norma-nomeada; RL-SF-003/A4 cobertura vigente). A informação nunca depende só da cor: ids nos nomes, nas anotações e na documentation.</bpmn:text></bpmn:textAnnotation>
  </bpmn:collaboration>
  <bpmn:process id="Process_Operadora" isExecutable="false">
    <bpmn:documentation>Plataforma da operadora (maezo-operadora). Lanes: cadastro, comercial. Rastreador de 7 estágios, catálogo de prazos (DMN funnel_deadline_catalog), regra prazo-só-norma-nomeada (RL-SF-035/RL-REG-27), aviso INTERNO de estágio estourado, cobertura vigente A4 (RL-SF-003 FECHADO). Épicos E-SF-08 (mesclado PR 1271), E-SF-05r, E-SF-47.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_Process_Operadora">
      <bpmn:lane id="Lane_Cadastro" name="Cadastro">
        <bpmn:flowNodeRef>StartEvent_AdmissaoIniciada</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RegistraProtocolo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_JoinCiclo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RastreiaEstagios</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_CicloEstagios</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ConsultaCatalogo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_PrazoNormaNomeada</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AguardaFimEstagio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_TimerEstouro</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RegistraSoDatas</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EmiteAvisoInterno</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ConsultaCoberturaFonte</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_CoberturaA4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RegistraEstagio7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Estagio7Registrado</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_TrackerEstagio6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RecebeConsultaAndamento</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RespondeAndamento</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>StartEvent_CicloMensalSib</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EnviaSibMensal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_SibEnviado</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>StartEvent_ConsultaBeneficiario</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_RespostaEnviada</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_EmiteES1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_EmiteES2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_EmiteES3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_EmiteES4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_EmiteES5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_EmiteES6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_EmiteES7</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Comercial" name="Comercial">
        <bpmn:flowNodeRef>Task_TrataAviso</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_AvisoTratado</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
      <bpmn:startEvent id="StartEvent_AdmissaoIniciada" name="Contrato emitido (etapa 6)"><bpmn:documentation>Message start: resultado da etapa 6 (RN 413 art. 5º §2º, baseline L118: contratação concluída em ≤25 dias corridos). Início do dever de acompanhamento da etapa 8. T0 do relógio de 25 dias segue FECHADO (RL-SF-038, RLR:46; NORM-GAP-8).</bpmn:documentation><bpmn:outgoing>Flow_S1_Inicia</bpmn:outgoing><bpmn:messageEventDefinition id="MsgDef_StartEvent_AdmissaoIniciada" messageRef="Message_AdmContratoEmitido" /></bpmn:startEvent>
      <bpmn:serviceTask id="Task_RegistraProtocolo" name="Registra protocolo — primeira ação"><bpmn:documentation>RN 623 art. 10, caput (baseline L62, verbatim: 'deverá ser fornecido número de protocolo como primeira ação, no início do atendimento') — dever VIGENTE para toda demanda recebida, independente de canal. Épico mais próximo: E-SF-47 (walk em staging, onda 2).</bpmn:documentation><bpmn:incoming>Flow_S1_Inicia</bpmn:incoming><bpmn:outgoing>Flow_S2_Protocolo</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:exclusiveGateway id="Gateway_JoinCiclo" name="Ciclo — entrada" default="Flow_S3_Ciclo"><bpmn:documentation>Junção do ciclo do rastreador: entrada da primeira ação, retorno do registro de datas e retorno da espera concluída.</bpmn:documentation><bpmn:incoming>Flow_S2_Protocolo</bpmn:incoming><bpmn:incoming>Flow_S10_VoltaEspera</bpmn:incoming><bpmn:incoming>Flow_S16_VoltaDatas</bpmn:incoming><bpmn:outgoing>Flow_S3_Ciclo</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:serviceTask id="Task_RastreiaEstagios" name="Rastreia os 7 estágios (contador)"><bpmn:documentation>PADRÃO ESCOLHIDO: task única com contador de estágio (alternativa: subprocesso recolhido por estágio — menos legível para o nível 1; ver AUTORIA). Estágios conforme o tracker da fonte: catálogo dá prazo só aos estágios 1–3 (r_rn413_art5_par2, estagios_tracker '1,2,3'); estágios 4–7 do tracker NÃO têm prazo (DMN L22). A9/OS-04: NENHUM caminho emite evento de medição (anotação anexa). GAP: nenhum SP-OP-* de tracker existe; épicos que o criam: E-SF-07 (relógio de 25 d, alarmes, 26º dia — maezo, onda 2) e E-SF-42 (tracker de 7 estágios no portal — omni, onda 2). Estágios (fonte: RL-SF-062/RLR:70; estágio 7 = RL-SF-003/RLR:11; nomes canônicos: DEC-CORE.md:1965-1973, registro CORE-13a): 1 Proposta registrada · 2 Contrato emitido · 3 Financeiro confirmado · 4 Declaração de saúde recebida (só se CPT/agravo E DEC-14 E não-portabilidade; senão omitido) · 5 Matrícula em curso (NUNCA 'em análise') · 6 Matrícula emitida ('não confirma cobertura ativa') · 7 Cobertura vigente (só com A4; senão omitido).</bpmn:documentation><bpmn:incoming>Flow_S3_Ciclo</bpmn:incoming><bpmn:outgoing>Flow_S4_Conta</bpmn:outgoing><bpmn:outgoing>Flow_EmiteES1</bpmn:outgoing><bpmn:outgoing>Flow_EmiteES2</bpmn:outgoing><bpmn:outgoing>Flow_EmiteES3</bpmn:outgoing><bpmn:outgoing>Flow_EmiteES4</bpmn:outgoing><bpmn:outgoing>Flow_EmiteES5</bpmn:outgoing><bpmn:outgoing>Flow_EmiteES6</bpmn:outgoing><bpmn:outgoing>Flow_EmiteES7</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:exclusiveGateway id="Gateway_CicloEstagios" name="Estágios 1–6 completos?" default="Flow_S5_Proximo"><bpmn:documentation>Divisão do ciclo: próximo estágio (default) x ciclo de seis estágios completo, que segue à leitura do registro de cobertura na fonte.</bpmn:documentation><bpmn:incoming>Flow_S4_Conta</bpmn:incoming><bpmn:incoming>Flow_ES1_Conta</bpmn:incoming><bpmn:incoming>Flow_ES2_Conta</bpmn:incoming><bpmn:incoming>Flow_ES3_Conta</bpmn:incoming><bpmn:incoming>Flow_ES4_Conta</bpmn:incoming><bpmn:incoming>Flow_ES5_Conta</bpmn:incoming><bpmn:incoming>Flow_ES6_Conta</bpmn:incoming><bpmn:incoming>Flow_ES7_Conta</bpmn:incoming><bpmn:outgoing>Flow_S5_Proximo</bpmn:outgoing><bpmn:outgoing>Flow_S11_Completos</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:businessRuleTask id="Task_ConsultaCatalogo" name="Consulta catálogo de prazos (deadline_ref)"><bpmn:documentation>businessRuleTask → decisão funnel_deadline_catalog (spec/processes/dmn/funnel_deadline_catalog.dmn), entrada deadline_ref (DMN L29-31): RN413-art5-par2 (25 corridos, L47-65), RN413-art5-par7 (5 úteis, L66-84), Lei9656-art12-VI (fora do tracker). GAP-WIRE: catálogo DRAFT e SEM CONSUMIDOR nesta onda (L23-24; EXECUTION-LOG L126, CD-24). Épico E-SF-08 mesclado (PR 1271). Timer nunca construído de DRAFT (L16-19).</bpmn:documentation><bpmn:incoming>Flow_S5_Proximo</bpmn:incoming><bpmn:outgoing>Flow_S6_Deadline</bpmn:outgoing></bpmn:businessRuleTask>
      <bpmn:exclusiveGateway id="Gateway_PrazoNormaNomeada" name="Prazo de norma nomeada (RATIFIED)?" default="Flow_S7_SoDatas"><bpmn:documentation>PORTÃO FECHADO RL-SF-035 / RL-REG-27 (RLR:43/:235; missão §5.1 linha 8): 'prazo só aparece quando vem de norma nomeada'. Default = sem entrada RATIFIED (com regulatory_approval_ref + evento-âncora observado, DMN L16-21) → SÓ DATAS, sem ETA. Todas as entradas estão DRAFT hoje (DMN L9/L18-19).</bpmn:documentation><bpmn:incoming>Flow_S6_Deadline</bpmn:incoming><bpmn:outgoing>Flow_S7_SoDatas</bpmn:outgoing><bpmn:outgoing>Flow_S8_Ratified</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:receiveTask id="Task_AguardaFimEstagio" name="Aguarda fim do estágio (só com prazo RATIFIED)"><bpmn:documentation>Caminho variante: só com entrada RATIFIED + refs + evento-âncora observado na fonte (DMN L16-21). Host do timer de borda (alarme não-interruptivo). Sem prazo confirmado em norma nomeada → sem timer, só datas (RL-SF-035/RL-REG-27, RLR:43/:235).</bpmn:documentation><bpmn:incoming>Flow_S8_Ratified</bpmn:incoming><bpmn:outgoing>Flow_S10_VoltaEspera</bpmn:outgoing></bpmn:receiveTask>
      <bpmn:boundaryEvent id="Event_TimerEstouro" name="Prazo do estágio vencido (P?D — só do catálogo)" attachedToRef="Task_AguardaFimEstagio" cancelActivity="false"><bpmn:documentation>Timer de borda NÃO-interruptivo (cancelActivity=false): valor SEMPRE do catálogo (${funnel_deadline_catalog[deadline_ref]}) ou ISO 8601 de norma citada com linha — nunca número solto (missão §6). HOJE não instanciável: todas as entradas DRAFT (DMN L18-19) e âncora do §3º indefinida (NORM-GAP-8/RL-SF-038, RLR:46). GAP-WIRE: catálogo sem consumidor (DMN L23-24). Alarme dispara aviso INTERNO — nunca mensagem a beneficiário.</bpmn:documentation><bpmn:outgoing>Flow_S9_Alarme</bpmn:outgoing><bpmn:timerEventDefinition id="TimerDef_Event_TimerEstouro"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">${funnel_deadline_catalog[deadline_ref]}</bpmn:timeDuration></bpmn:timerEventDefinition></bpmn:boundaryEvent>
      <bpmn:serviceTask id="Task_RegistraSoDatas" name="Registra só datas observadas — sem ETA"><bpmn:documentation>RL-SF-035/RL-REG-27 (RLR:43/:235): sem prazo de norma nomeada RATIFIED → nenhum prazo exibido; só timestamps observados (DMN L18-19). B-13: nenhum prazo da RN 566 em estágio de contratação (RLR:235). O teto de 25 dias (RN 413 art. 5º §2º, baseline L118) vive no catálogo DRAFT — não vira ETA em tela.</bpmn:documentation><bpmn:incoming>Flow_S7_SoDatas</bpmn:incoming><bpmn:outgoing>Flow_S16_VoltaDatas</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:sendTask id="Task_EmiteAvisoInterno" name="Emite aviso interno de estágio estourado"><bpmn:documentation>Aviso INTERNO → raia Comercial da própria operadora (fluxo de sequência interno) — NUNCA mensagem proativa a beneficiário (missão §8; RT-D4 herdado). Teto observado: RN 413 art. 5º §2º (baseline L118). Alarme não-interruptivo: a espera pelo fim do estágio continua.</bpmn:documentation><bpmn:incoming>Flow_S9_Alarme</bpmn:incoming><bpmn:outgoing>Flow_A1_Aviso</bpmn:outgoing></bpmn:sendTask>
      <bpmn:receiveTask id="Task_ConsultaCoberturaFonte" name="Recebe leitura de cobertura da fonte (A4)" messageRef="Message_RegistroCoberturaA4"><bpmn:documentation>Registro customer-coverage.proposed.v1: leitura, NENHUM comando, finalidade comercial própria, expiração ligada ao pin d1d796b8… (RL-SF-003, RLR:11). Portão A4 FECHADO: registro refused → cartão unknown/source_unavailable → estágio 7 omitido. Bind das admissões A1–A4 = E-SF-05r (AGUARDA-RATIFICAÇÃO).</bpmn:documentation><bpmn:incoming>Flow_S11_Completos</bpmn:incoming><bpmn:outgoing>Flow_S12_LeA4</bpmn:outgoing></bpmn:receiveTask>
      <bpmn:exclusiveGateway id="Gateway_CoberturaA4" name="Cobertura vigente na fonte (A4)?" default="Flow_S13_Estagio6"><bpmn:documentation>PORTÃO FECHADO RL-SF-003 / A4 (RLR:11; CORE-03/D-SF-004; jurídico ratifica — direito signatário; ato DPO lado AMH): default = situação de cobertura DESCONHECIDA, sem qualquer inferência pelo sistema — tracker termina no estágio 6. Ratificado (variante) → estágio 7 registrado.</bpmn:documentation><bpmn:incoming>Flow_S12_LeA4</bpmn:incoming><bpmn:outgoing>Flow_S13_Estagio6</bpmn:outgoing><bpmn:outgoing>Flow_S14_Estagio7</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:serviceTask id="Task_RegistraEstagio7" name="Registra estágio 7 — cobertura vigente"><bpmn:documentation>VARIANTE NÃO ATIVA: só com A4 ratificado (RL-SF-003, RLR:11). Leitura na fonte AMH: vigencia_inicio, cancelamento, situacao_cadastral (fonte competente, distinta do recibo de emissão — pergunta (1) do registro). Épico E-SF-05r (AGUARDA-RATIFICAÇÃO).</bpmn:documentation><bpmn:incoming>Flow_S14_Estagio7</bpmn:incoming><bpmn:outgoing>Flow_S15_Registra7</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:endEvent id="EndEvent_Estagio7Registrado" name="Estágio 7 registrado (A4)"><bpmn:documentation>Fim nomeado da variante A4 (não ativa enquanto RL-SF-003 pendente).</bpmn:documentation><bpmn:incoming>Flow_S15_Registra7</bpmn:incoming></bpmn:endEvent>
      <bpmn:endEvent id="EndEvent_TrackerEstagio6" name="Tracker termina no estágio 6"><bpmn:documentation>Fim nomeado do fallback literal A4 (RLR:11): 'situação de cobertura desconhecida' — 'desconhecida não significa sem cobertura', sem inferência; estágio 7 omitido. Épico E-SF-05r (AGUARDA-RATIFICAÇÃO).</bpmn:documentation><bpmn:incoming>Flow_S13_Estagio6</bpmn:incoming></bpmn:endEvent>
      <bpmn:receiveTask id="Task_RecebeConsultaAndamento" name="Recebe consulta de andamento" messageRef="Message_ConsultaAndamento"><bpmn:documentation>RN 623 art. 13 §ú (baseline L68): acesso ao andamento por meio virtual obrigatório. Consulta INICIADA pelo beneficiário (start de mensagem reativo StartEvent_ConsultaBeneficiario) — nenhuma mensagem proativa (RT-D4 herdado; GAP-CONSENT-ADMISSAO: beneficiários já admitidos sem consentimento de contato demonstrável, RT-D4.md:73).</bpmn:documentation><bpmn:incoming>Flow_Q0_ConsultaChega</bpmn:incoming><bpmn:outgoing>Flow_Q1_ConsultaRecebida</bpmn:outgoing></bpmn:receiveTask>
      <bpmn:sendTask id="Task_RespondeAndamento" name="Responde andamento com datas observadas"><bpmn:documentation>Resposta à consulta do beneficiário (nunca proativa): andamento + timestamps observados, SEM ETA (RL-SF-035/RL-REG-27, RLR:43/:235; DMN L18-19). RN 623 art. 13 §ú (L68); art. 19: registros e gravações em até 72 h (L72) — ver anotação RN 623.</bpmn:documentation><bpmn:incoming>Flow_Q1_ConsultaRecebida</bpmn:incoming><bpmn:outgoing>Flow_Q2_RespostaRegistrada</bpmn:outgoing></bpmn:sendTask>
      <bpmn:startEvent id="StartEvent_CicloMensalSib" name="Ciclo mensal SIB — dia 5"><bpmn:documentation>Job interno de admissão/agregação cadastral (RN 500 art. 6º/7º, baseline L308: mensal, até o dia 5). NUNCA exibido ao comprador como prazo (regra prazo-só-norma; RLR:235).</bpmn:documentation><bpmn:outgoing>Flow_B1_Mensal</bpmn:outgoing></bpmn:startEvent>
      <bpmn:serviceTask id="Task_EnviaSibMensal" name="Envia atualização cadastral SIB (mensal)"><bpmn:documentation>RN 500 art. 3º §1º (baseline L307): responsabilidade da OPERADORA em manter os dados atualizados, corretos e fidedignos na ANS; arts. 6º/7º: periodicidade mensal, envio até o dia 5 (L308); art. 16: campos mínimos nome/CPF/nome da mãe (L309). GAP-4 residual: RN 590/2023 (alteração da RN 500/SIB) sem pin — baseline L364; leitura RL-REG-28/RL-SF-031 (RLR:35).</bpmn:documentation><bpmn:incoming>Flow_B1_Mensal</bpmn:incoming><bpmn:outgoing>Flow_B2_Sib</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:endEvent id="EndEvent_SibEnviado" name="SIB enviado"><bpmn:documentation>Fim nomeado do job mensal de atualização cadastral.</bpmn:documentation><bpmn:incoming>Flow_B2_Sib</bpmn:incoming></bpmn:endEvent>
      <bpmn:userTask id="Task_TrataAviso" name="Trata aviso de estágio estourado"><bpmn:documentation>Ato humano na raia competente (regra transversal 2): tratamento e escalação INTERNA do atraso — NUNCA mensagem proativa a beneficiário (RT-D4 herdado). Sem ETA ao comprador enquanto RL-SF-035/RL-REG-27 vigente (RLR:43/:235); teto regulatório observado em RN 413 art. 5º §2º (baseline L118).</bpmn:documentation><bpmn:incoming>Flow_A1_Aviso</bpmn:incoming><bpmn:outgoing>Flow_A2_Tratado</bpmn:outgoing></bpmn:userTask>
      <bpmn:endEvent id="EndEvent_AvisoTratado" name="Aviso tratado internamente"><bpmn:documentation>Fim nomeado: tratamento interno do aviso registrado; nenhum caminho termina em silêncio.</bpmn:documentation><bpmn:incoming>Flow_A2_Tratado</bpmn:incoming></bpmn:endEvent>
      <bpmn:startEvent id="StartEvent_ConsultaBeneficiario" name="Consulta de andamento iniciada pelo beneficiário (reativa)"><bpmn:documentation>Start de mensagem REATIVO (missão §8; RT-D4.md:23/91-92): instancia o atendimento só quando o beneficiário consulta — NENHUMA mensagem proativa (GAP-CONSENT-ADMISSAO, RT-D4.md:73). MsgFlow_ConsultaAndamento traz Message_ConsultaAndamento do pool Comprador; RN 623 art. 13 §ú (baseline L68).</bpmn:documentation><bpmn:outgoing>Flow_Q0_ConsultaChega</bpmn:outgoing><bpmn:messageEventDefinition id="MsgDef_StartEvent_ConsultaBeneficiario" messageRef="Message_ConsultaAndamento" /></bpmn:startEvent>
      <bpmn:endEvent id="EndEvent_RespostaEnviada" name="Resposta enviada ao beneficiário (reativa)"><bpmn:documentation>Fim nomeado do atendimento reativo à consulta: resposta enviada (só em conversa iniciada por ele — RT-D4) e registrada (RN 623 art. 19, baseline L72: registros e gravações em até 72 h). Sem ETA — só datas observadas (RL-SF-035/RL-REG-27).</bpmn:documentation><bpmn:incoming>Flow_Q2_RespostaRegistrada</bpmn:incoming></bpmn:endEvent>
