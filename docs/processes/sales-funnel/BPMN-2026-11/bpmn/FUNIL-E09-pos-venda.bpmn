<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="Definitions_FUNIL_E09" targetNamespace="urn:funil:descritivo:etapa9" exporter="build_etapa09.py" exporterVersion="1.0.0">
  <bpmn:collaboration id="Collaboration_FUNIL_E09" name="Etapa 9 — Pós-venda">
    <bpmn:participant id="Participant_Beneficiario" name="Beneficiário/Comprador"><bpmn:documentation>Papel do beneficiário/contratante. Pool externo (caixa-preta): INICIA arrependimento (CDC art.49 L222 / RN 413 art.8º L124), cancelamento 2 toques (RN 561 art.4º III L291), reembolso (wizard só beneficiário — RL-SF-043) e oposição a contato; RECEBE protocolo imediato (RN 623 art.10 L62), comprovante (RN 561 art.18 L295 — teto NÃO exibido), recibo do arrependimento (sem prazo regulatório afirmado — RL-SF-015, RLR:215), andamento datado sem ETA e resposta a contato. NENHUMA mensagem proativa a beneficiário (RT-D4; missão §8). Nenhuma tarefa neste pool.</bpmn:documentation></bpmn:participant>
    <bpmn:participant id="Participant_Omni" name="Superfície de vendas" processRef="Process_Omni"><bpmn:documentation>Superfície de vendas (omni_sales_platform). Lane Portal: telas de arrependimento, cancelamento toque 1 (superfície Meu plano — E-SF-RT-04, casa provisória GAP-RT-06), wizard de reembolso (só beneficiário — RL-SF-043/REG-01) e registro de oposição (E-SF-11). isExecutable=false.</bpmn:documentation></bpmn:participant>
    <bpmn:participant id="Participant_Operadora" name="Plataforma da operadora" processRef="Process_Operadora"><bpmn:documentation>Plataforma da operadora (maezo-operadora). Lanes: Comercial, Financeiro, Jurídico. Arrependimento (GAP E-SF-09; E-SF-09r aguarda ratificação — RL-SF-015, RLR:215), cancelamento a pedido 2 toques (RN 561; RT-J2), reembolso (RL-SF-043/RL-REG-44, RLR:248; Lei 9.656 art.12 VI L91/L101), boas-vindas REATIVA (RT-D4, RT-D4.md:91-92), oposição (E-SF-11; SP-OP-SUPP-001). isExecutable=false.</bpmn:documentation></bpmn:participant>
    <bpmn:participant id="Participant_ExecutorAMH" name="Executor comercial e lago" processRef="Process_ExecutorAMH"><bpmn:documentation>Executor comercial e lago (amh-data-platform). Fonte do vínculo: registra o cancelamento efetivo (campos cancelamento/situacao_cadastral — RL-SF-003, RLR:11). Leitura pela operadora, nenhum comando reverso. isExecutable=false.</bpmn:documentation></bpmn:participant>
    <bpmn:messageFlow id="MsgFlow_PedidoArrependimento" name="Exerce arrependimento (CDC art.49 L222 / RN 413 art.8º L124)" sourceRef="Participant_Beneficiario" targetRef="StartEvent_ArrependimentoPortal" />
    <bpmn:messageFlow id="MsgFlow_PedidoCancelamentoToque1" name="Cancelamento a pedido — toque 1 (RN 561 art.4º III L291)" sourceRef="Participant_Beneficiario" targetRef="StartEvent_CancelamentoToque1" />
    <bpmn:messageFlow id="MsgFlow_PedidoReembolso" name="Pedido de reembolso (wizard só beneficiário — RL-SF-043)" sourceRef="Participant_Beneficiario" targetRef="StartEvent_ReembolsoWizard" />
    <bpmn:messageFlow id="MsgFlow_OposicaoContato" name="Oposição a contato (E-SF-11)" sourceRef="Participant_Beneficiario" targetRef="StartEvent_OposicaoContato" />
    <bpmn:messageFlow id="MsgFlow_ContatoBeneficiario" name="Contato iniciado pelo beneficiário (reativo — RT-D4)" sourceRef="Participant_Beneficiario" targetRef="StartEvent_ContatoReativo" />
    <bpmn:messageFlow id="MsgFlow_PedidoArrependimentoOp" name="Pedido com âncoras signed_at/vigencia_start (RLR:215)" sourceRef="Task_PersisteAncorasArrependimento" targetRef="StartEvent_PedidoArrependimentoOp" />
    <bpmn:messageFlow id="MsgFlow_Toque1Op" name="Pedido do toque 1 com bloco art.15 (L293)" sourceRef="Task_TelaCancelamentoToque1" targetRef="StartEvent_PedidoCancelamentoOp" />
    <bpmn:messageFlow id="MsgFlow_WizardOp" name="Documentação entregue (termo inicial — Lei 9.656 art.12 VI L101)" sourceRef="Task_WizardReembolso" targetRef="StartEvent_PedidoReembolsoOp" />
    <bpmn:messageFlow id="MsgFlow_OposicaoOp" name="Oposição para aplicação (E-SF-11; SP-OP-SUPP-001)" sourceRef="Task_RegistraOposicao" targetRef="StartEvent_OposicaoOp" />
    <bpmn:messageFlow id="MsgFlow_ReciboArrependimento" name="Recibo — janela exibida sem prazo regulatório afirmado (C13/Q3)" sourceRef="Task_EnviaReciboArrependimento" targetRef="Participant_Beneficiario" />
    <bpmn:messageFlow id="MsgFlow_ProtocoloImediato" name="Protocolo imediato (RN 623 art.10 L62; RN 561 art.6º §3º L292)" sourceRef="Task_EmiteProtocoloImediato" targetRef="Participant_Beneficiario" />
    <bpmn:messageFlow id="MsgFlow_ComprovanteEfetivo" name="Comprovante do efetivo cancelamento — teto art.18 (L295) NÃO exibido" sourceRef="Task_EmiteComprovanteEfetivo" targetRef="Participant_Beneficiario" />
    <bpmn:messageFlow id="MsgFlow_AndamentoReembolso" name="Protocolo + andamento datado — sem ETA (RL-SF-043 fallback B)" sourceRef="Task_InformaAndamentoSemETA" targetRef="Participant_Beneficiario" />
    <bpmn:messageFlow id="MsgFlow_TimestampsReembolso" name="Protocolo + timestamps — sem prazo (fallback B, RLR:248)" sourceRef="Task_InformaTimestampsSemPrazo" targetRef="Participant_Beneficiario" />
    <bpmn:messageFlow id="MsgFlow_FonteCancelamento" name="Cancelamento efetivo — atualiza fonte (RL-SF-003, RLR:11)" sourceRef="Task_NoticiaFonteCancelamento" targetRef="StartEvent_FonteCancelada" />
    <bpmn:textAnnotation id="Annotation_Legenda"><bpmn:text>LEGENDA — contorno/fundo vermelho = PORTÃO FECHADO / caminho FECHADO ativo (RL-SF-015 contagem do arrependimento; RT-J2 comprovante; RL-SF-043 reembolso; PROC-06 exibição do P30D; RT-D4 proatividade). A informação nunca depende só da cor: ids nos nomes, nas anotações e na documentation.</bpmn:text></bpmn:textAnnotation>
  </bpmn:collaboration>
  <bpmn:process id="Process_Omni" isExecutable="false">
    <bpmn:documentation>Superfície de vendas (omni_sales_platform). Lane Portal: telas de arrependimento, cancelamento toque 1 (superfície Meu plano — E-SF-RT-04, casa provisória GAP-RT-06), wizard de reembolso (só beneficiário — RL-SF-043/REG-01) e registro de oposição (E-SF-11). isExecutable=false.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_Process_Omni">
      <bpmn:lane id="Lane_Portal" name="Portal">
        <bpmn:flowNodeRef>StartEvent_ArrependimentoPortal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PersisteAncorasArrependimento</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>StartEvent_CancelamentoToque1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TelaCancelamentoToque1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>StartEvent_ReembolsoWizard</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_WizardReembolso</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>StartEvent_OposicaoContato</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RegistraOposicao</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_ArrependimentoRegistrado</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Toque1Enviado</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_WizardEnviado</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_OposicaoRegistrada</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
      <bpmn:startEvent id="StartEvent_ArrependimentoPortal" name="Pedido de arrependimento (CDC art.49 L222 / RN 413 art.8º L124)"><bpmn:documentation>Start de mensagem REATIVO: instanciado só pelo pedido do beneficiário. DUAS contagens possíveis do prazo de 7 dias (CDC art.49 L222: desde a ASSINATURA × RN 413 art.8º L124: desde a VIGÊNCIA) — a escolha é do jurídico (missão §5.1 linha 9; RL-SF-015, RLR:215).</bpmn:documentation><bpmn:outgoing>Flow_O1_Registra</bpmn:outgoing><bpmn:messageEventDefinition id="MsgDef_StartEvent_ArrependimentoPortal" messageRef="Message_PedidoArrependimento" /></bpmn:startEvent>
      <bpmn:serviceTask id="Task_PersisteAncorasArrependimento" name="Registra pedido e persiste âncoras signed_at e vigencia_start"><bpmn:documentation>RL-SF-015 (RLR:215, postura C): as duas âncoras persistem desde o 1º aceite como receipts autenticados; termo final NUNCA em código (política versionada withdrawal_window_policy); nenhuma negativa automática por intempestividade. Promessa na tela SEM prazo numérico até Q3 (C13). Épico GAP E-SF-09 (EXECUTION-LOG §7 L128: não iniciado); E-SF-09r AGUARDA-RATIFICAÇÃO.</bpmn:documentation><bpmn:incoming>Flow_O1_Registra</bpmn:incoming><bpmn:outgoing>Flow_O1f_Fim</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:startEvent id="StartEvent_CancelamentoToque1" name="Cancelamento a pedido — toque 1 na página"><bpmn:documentation>RN 561 art.4º III (baseline L291): cancelamento pode ser solicitado pela página da internet — toque 1 do fluxo de 2 toques. Start de mensagem reativo (beneficiário inicia).</bpmn:documentation><bpmn:outgoing>Flow_O2_Tela</bpmn:outgoing><bpmn:messageEventDefinition id="MsgDef_StartEvent_CancelamentoToque1" messageRef="Message_PedidoCancelamentoToque1" /></bpmn:startEvent>
      <bpmn:serviceTask id="Task_TelaCancelamentoToque1" name="Exibe ecrã do pedido — bloco RN 561 art.15 II (L293) efeito imediato e irrevogável"><bpmn:documentation>Ecrã do toque 1 com bloco do art.15 (L293: efeito imediato e caráter irrevogável a partir da ciência; art.16 L294: na solicitação ou no comprovante). Motivo em LISTA FECHADA (E-SF-RT-02, portão RT-D1). Superfície 'Meu plano' (E-SF-RT-04) provisória — GAP-RT-06 (RT-J2.md:67; RT-J3.md:62). Anotação RT-J3a: linha única OS-08 GATED (default SEM a linha).</bpmn:documentation><bpmn:incoming>Flow_O2_Tela</bpmn:incoming><bpmn:outgoing>Flow_O2f_Envia</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:startEvent id="StartEvent_ReembolsoWizard" name="Pedido de reembolso pelo wizard"><bpmn:documentation>RL-SF-043 / RL-REG-44 (RLR:248, postura C): wizard RESTRITO A BENEFICIÁRIO (REG-01). Start de mensagem reativo. Enquadramento urgência/emergência NUNCA por autodeclaração.</bpmn:documentation><bpmn:outgoing>Flow_O3_Wizard</bpmn:outgoing><bpmn:messageEventDefinition id="MsgDef_StartEvent_ReembolsoWizard" messageRef="Message_PedidoReembolso" /></bpmn:startEvent>
      <bpmn:serviceTask id="Task_WizardReembolso" name="Recebe documentação do reembolso (entrega da documentação)"><bpmn:documentation>Termo inicial do prazo legal: Lei 9.656 art.12 VI (baseline L101, verbatim: 'pagáveis no prazo máximo de trinta dias após a ENTREGA DA DOCUMENTAÇÃO adequada'). A documentação seguir à operadora por messageFlow; escopo decidido por brT + DMN (fato assistencial).</bpmn:documentation><bpmn:incoming>Flow_O3_Wizard</bpmn:incoming><bpmn:outgoing>Flow_O3f_Envia</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:startEvent id="StartEvent_OposicaoContato" name="Oposição a contato registrada pelo beneficiário"><bpmn:documentation>Direito de oposição (RL-SF-093(ii)); DSR no funil e pós-venda = E-SF-11 (onda 2). Executável existente: SP-OP-SUPP-001_Direitos_de_Nao_Contato.bpmn (anotação Nivel2).</bpmn:documentation><bpmn:outgoing>Flow_O4_Opos</bpmn:outgoing><bpmn:messageEventDefinition id="MsgDef_StartEvent_OposicaoContato" messageRef="Message_OposicaoContato" /></bpmn:startEvent>
      <bpmn:serviceTask id="Task_RegistraOposicao" name="Registra oposição a contato (E-SF-11)"><bpmn:documentation>Registro da oposição e envio à operadora para aplicação (SP-OP-SUPP-001 na oposição — ver Annotation_Nivel2). Reativo: só existe se o beneficiário pedir. E-SF-11 (onda 2).</bpmn:documentation><bpmn:incoming>Flow_O4_Opos</bpmn:incoming><bpmn:outgoing>Flow_O4f_Registrada</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:endEvent id="EndEvent_ArrependimentoRegistrado" name="Pedido de arrependimento registrado"><bpmn:documentation>Fim nomeado: pedido + âncoras persistidas; segue à operadora por messageFlow (nunca proativo).</bpmn:documentation><bpmn:incoming>Flow_O1f_Fim</bpmn:incoming></bpmn:endEvent>
      <bpmn:endEvent id="EndEvent_Toque1Enviado" name="Toque 1 enviado à operadora"><bpmn:documentation>Fim nomeado do toque 1: pedido com bloco art.15 segue por messageFlow; protocolo imediato é dever da operadora (RN 623 art.10, baseline L62).</bpmn:documentation><bpmn:incoming>Flow_O2f_Envia</bpmn:incoming></bpmn:endEvent>
      <bpmn:endEvent id="EndEvent_WizardEnviado" name="Documentação enviada à operadora"><bpmn:documentation>Fim nomeado: wizard entrega a documentação — termo inicial do prazo de Lei 9.656 art.12 VI (L101) no lado da operadora.</bpmn:documentation><bpmn:incoming>Flow_O3f_Envia</bpmn:incoming></bpmn:endEvent>
      <bpmn:endEvent id="EndEvent_OposicaoRegistrada" name="Oposição registrada"><bpmn:documentation>Fim nomeado: oposição registrada na superfície e encaminhada à operadora (E-SF-11).</bpmn:documentation><bpmn:incoming>Flow_O4f_Registrada</bpmn:incoming></bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_O1_Registra" name="Pedido recebido" sourceRef="StartEvent_ArrependimentoPortal" targetRef="Task_PersisteAncorasArrependimento" />
      <bpmn:sequenceFlow id="Flow_O1f_Fim" name="Registrado" sourceRef="Task_PersisteAncorasArrependimento" targetRef="EndEvent_ArrependimentoRegistrado" />
      <bpmn:sequenceFlow id="Flow_O2_Tela" name="Abre ecrã do toque 1" sourceRef="StartEvent_CancelamentoToque1" targetRef="Task_TelaCancelamentoToque1" />
      <bpmn:sequenceFlow id="Flow_O2f_Envia" name="Enviado" sourceRef="Task_TelaCancelamentoToque1" targetRef="EndEvent_Toque1Enviado" />
      <bpmn:sequenceFlow id="Flow_O3_Wizard" name="Abre wizard" sourceRef="StartEvent_ReembolsoWizard" targetRef="Task_WizardReembolso" />
      <bpmn:sequenceFlow id="Flow_O3f_Envia" name="Enviado" sourceRef="Task_WizardReembolso" targetRef="EndEvent_WizardEnviado" />
      <bpmn:sequenceFlow id="Flow_O4_Opos" name="Oposição recebida" sourceRef="StartEvent_OposicaoContato" targetRef="Task_RegistraOposicao" />
      <bpmn:sequenceFlow id="Flow_O4f_Registrada" name="Registrada" sourceRef="Task_RegistraOposicao" targetRef="EndEvent_OposicaoRegistrada" />
      <bpmn:textAnnotation id="Annotation_RTJ3a"><bpmn:text>PORTÃO RT-J3a (RT-J3.md:22/24/31/81-82; OS-08): linha única de alternativa no 'quero cancelar' — DEFAULT SEM a linha; variante: exibida UMA vez no toque 1, nunca no caminho, cancelar primário, nunca condicionada (CDC art.39 I, L221).</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_RTJ3a" sourceRef="Task_TelaCancelamentoToque1" targetRef="Annotation_RTJ3a" />
  </bpmn:process>
  <bpmn:process id="Process_Operadora" isExecutable="false">
    <bpmn:documentation>Plataforma da operadora (maezo-operadora). Lanes: Comercial, Financeiro, Jurídico. Arrependimento (GAP E-SF-09; E-SF-09r aguarda ratificação — RL-SF-015, RLR:215), cancelamento a pedido 2 toques (RN 561; RT-J2), reembolso (RL-SF-043/RL-REG-44, RLR:248; Lei 9.656 art.12 VI L91/L101), boas-vindas REATIVA (RT-D4, RT-D4.md:91-92), oposição (E-SF-11; SP-OP-SUPP-001). isExecutable=false.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_Process_Operadora">
      <bpmn:lane id="Lane_Comercial" name="Comercial">
        <bpmn:flowNodeRef>StartEvent_ContatoReativo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PreparaRespostaBoasVindas</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Gate_RTD4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RespondeNaConversa</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_SemProatividade</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EnviaBoasVindasProativa</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_ProativaVariante</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_LinkF4Renovacao</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>StartEvent_PedidoArrependimentoOp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TrataArrependimento</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Gate_RLSF015</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AvaliaTempestividadeHumana</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EnviaReciboArrependimento</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_ArrependimentoSemPrazoAfirmado</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AguardaJanelaP7D</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_TimerP7DParam</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_JanelaVarianteRLSF015</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>StartEvent_PedidoCancelamentoOp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_LinkF4Cancelamento</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ConfirmaCancelamentoToque2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Gate_RTJ2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EmiteProtocoloImediato</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EmiteComprovanteEfetivo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NoticiaFonteCancelamento</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_ThrowE9CicloVigente</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_CicloRemetidoF4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_CancelamentoSemPrazoExibido</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>StartEvent_PedidoReembolsoOp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ConsultaDMNReembolso</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Gate_RLSF043</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RegistraCanalHumano</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InformaAndamentoSemETA</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_ReembolsoCanalSemPrazo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>StartEvent_OposicaoOp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AplicaOposicao</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_OposicaoAplicada</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Financeiro" name="Financeiro">
        <bpmn:flowNodeRef>Task_ApuraCusteioArrependimento</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AnalisaReembolsoFinanceiro</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_TimerP30D</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TrataEstouroP30D</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_EstouroP30DTratado</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Gate_PROC06</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InformaTimestampsSemPrazo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_ReembolsoUrgenciaSemPrazo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InformaReembolsoComPrazo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_ReembolsoComPrazoVariante</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Juridico" name="Jurídico">
        <bpmn:flowNodeRef>Task_JuridicoDecideContagem</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_JuridicoRatificaTeto</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EmiteComprovanteComTeto</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_ComprovanteComTetoVariante</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_JuridicoRatificaP30D</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
      <bpmn:startEvent id="StartEvent_ContatoReativo" name="Contato iniciado pelo beneficiário (reativo)"><bpmn:documentation>PORTÃO RT-D4 (RT-D4.md:23/91-92): nenhuma mensagem proativa — boas-vindas existe só como RESPOSTA a conversa iniciada pelo beneficiário; GAP-CONSENT-ADMISSAO (RT-D4.md:73). Medição A9/OS-04: nenhum caminho emite evento de medição (Annotation_MedicaoA9).</bpmn:documentation><bpmn:outgoing>Flow_C1_Contato</bpmn:outgoing><bpmn:messageEventDefinition id="MsgDef_StartEvent_ContatoReativo" messageRef="Message_ContatoBeneficiario" /></bpmn:startEvent>
      <bpmn:userTask id="Task_PreparaRespostaBoasVindas" name="Prepara resposta de boas-vindas"><bpmn:documentation>GTM-07 (DECISIONS-AND-ANSWERS.md:149, D-SF-079): conteúdo fechado não clínico; jornada AGJ não BPMN; papel Relacionamento e renovação = E-SF-RT-03 (portão RT-D3 — assistente lendo dado do beneficiário, fora do escopo deste caminho). Nenhum dado de saúde (missão §8).</bpmn:documentation><bpmn:incoming>Flow_C1_Contato</bpmn:incoming><bpmn:outgoing>Flow_C2_Preparado</bpmn:outgoing></bpmn:userTask>
      <bpmn:exclusiveGateway id="Gateway_Gate_RTD4" name="Envio proativo a beneficiário — RT-D4 (DPO)?" default="Flow_C3_SoResposta"><bpmn:documentation>PORTÃO FECHADO RT-D4 (RLR:120-124; RT-D4.md:91-92; AD §7 (q)): default = flag desligada, só resposta a conversa iniciada pelo beneficiário; variante (cond) só com assinatura do encarregado (ato de indicação não assinado, RT-D4.md:17). Cita E-SF-62, RL-SF-093(ii) e OS05-J1 (Annotation_RTD4). Lembrete de cobrança NUNCA (MAEZO_LEMBRETE_COBRANCA=false, RT-D4.md:54; missão §8).</bpmn:documentation><bpmn:incoming>Flow_C2_Preparado</bpmn:incoming><bpmn:incoming>Flow_LinkF4RenovacaoBoas</bpmn:incoming><bpmn:outgoing>Flow_C3_SoResposta</bpmn:outgoing><bpmn:outgoing>Flow_C5_ProativaVariante</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:sendTask id="Task_RespondeNaConversa" name="Responde na conversa iniciada pelo beneficiário"><bpmn:documentation>Resposta REATIVA — permitida (RT-D4.md:91: 2ª via e vencimento só em resposta a conversa iniciada pelo beneficiário). Nunca proativa; nunca conteúdo clínico.</bpmn:documentation><bpmn:incoming>Flow_C3_SoResposta</bpmn:incoming><bpmn:outgoing>Flow_C4_Resposta</bpmn:outgoing></bpmn:sendTask>
      <bpmn:endEvent id="EndEvent_SemProatividade" name="Resposta enviada — sem proatividade"><bpmn:documentation>Fim nomeado do caminho FECHADO RT-D4: nenhuma mensagem proativa a beneficiário (missão §8).</bpmn:documentation><bpmn:incoming>Flow_C4_Resposta</bpmn:incoming></bpmn:endEvent>
      <bpmn:sendTask id="Task_EnviaBoasVindasProativa" name="Envia boas-vindas proativa (variante RT-D4 ratificada)"><bpmn:documentation>VARIANTE NÃO ATIVA: só com ratificação DPO (RT-D4.md:91-92) — mesma guarda de GTM-07 (conteúdo fechado a-f; E-SF-62). Check-in único D+7 por tempo de casa (carteirinha, app, rede, canais) = GTM-07.D1 / RT-08 (ADD-RETENTION.md:319/323/325) — RATIFY-LATER-DPO; épico E-SF-22r. Lembrete de cobrança NUNCA neste fluxo (missão §8).</bpmn:documentation><bpmn:incoming>Flow_C5_ProativaVariante</bpmn:incoming><bpmn:outgoing>Flow_C6_EnviadaVariante</bpmn:outgoing></bpmn:sendTask>
      <bpmn:endEvent id="EndEvent_ProativaVariante" name="Boas-vindas proativa enviada (variante)"><bpmn:documentation>Fim nomeado da VARIANTE (não ativa enquanto RT-D4 pendente).</bpmn:documentation><bpmn:incoming>Flow_C6_EnviadaVariante</bpmn:incoming></bpmn:endEvent>
      <bpmn:startEvent id="StartEvent_PedidoArrependimentoOp" name="Pedido de arrependimento chega com as duas âncoras"><bpmn:documentation>Message start com âncoras signed_at/vigencia_start persistidas desde o 1º aceite (RL-SF-015, RLR:215). GAP E-SF-09 (não iniciado); E-SF-09r AGUARDA-RATIFICAÇÃO.</bpmn:documentation><bpmn:outgoing>Flow_SA0_Analisa</bpmn:outgoing><bpmn:messageEventDefinition id="MsgDef_StartEvent_PedidoArrependimentoOp" messageRef="Message_PedidoArrependimentoOp" /></bpmn:startEvent>
      <bpmn:userTask id="Task_TrataArrependimento" name="Trata pedido de arrependimento (CDC art.49 / RN 413 art.8º)"><bpmn:documentation>ATO HUMANO (missão §6: decisão humana nunca sai de service/agente). RN 413 art.8º caput (L124): direito de arrependimento/rescisão unilateral em 7 dias; §1º (L124): formulário com declaração destacada de ciência de que a rescisão sem ônus está condicionada à não utilização do plano.</bpmn:documentation><bpmn:incoming>Flow_SA0_Analisa</bpmn:incoming><bpmn:outgoing>Flow_A1_Gate</bpmn:outgoing></bpmn:userTask>
      <bpmn:exclusiveGateway id="Gateway_Gate_RLSF015" name="Contagem do arrependimento — RL-SF-015 (jurídico)?" default="Flow_A2_SemContagem"><bpmn:documentation>PORTÃO FECHADO RL-SF-015 = RL-REG-03, Q3 (RATIFY-LATER-REGISTER.md:23; RLR:215; missão §5.1 linha 9; §8: contagem do arrependimento é do jurídico). DUAS contagens possíveis: CDC art.49 (L222, desde a ASSINATURA) × RN 413 art.8º (L124, desde a VIGÊNCIA — dia do pagamento do art.6º caput L122). Default FECHADO: janela exibida sem prazo regulatório afirmado; variantes (cond) NUNCA ativas até ratificação.</bpmn:documentation><bpmn:incoming>Flow_A1_Gate</bpmn:incoming><bpmn:outgoing>Flow_A2_SemContagem</bpmn:outgoing><bpmn:outgoing>Flow_A6_VarianteAssinatura</bpmn:outgoing><bpmn:outgoing>Flow_A7_VarianteVigencia</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:userTask id="Task_AvaliaTempestividadeHumana" name="Avalia tempestividade por decisão humana"><bpmn:documentation>RLR:215: NENHUMA negativa automática por intempestividade — encaminha a humano; recebe tanto o caminho FECHADO (contagem indefinida) quanto o alarme do timer P7D parametrizado. Postura C: tempestivo qualquer pedido entre assinatura+7 e vigência+7.</bpmn:documentation><bpmn:incoming>Flow_A2_SemContagem</bpmn:incoming><bpmn:incoming>Flow_A10_AlarmeP7D</bpmn:incoming><bpmn:outgoing>Flow_A3_Custeio</bpmn:outgoing></bpmn:userTask>
      <bpmn:sendTask id="Task_EnviaReciboArrependimento" name="Envia recibo — janela exibida sem prazo regulatório afirmado"><bpmn:documentation>C13/Q3 (RLR:215): promessa na tela só depois de resolvida a contagem; até lá recibo SEM prazo regulatório afirmado. RN 413 art.8º §1º (L124): declaração destacada de não utilização. Custeio/estorno apurado por humano na Financeiro (valores em dinheiro).</bpmn:documentation><bpmn:incoming>Flow_A4_Custeio</bpmn:incoming><bpmn:outgoing>Flow_A5_Recibo</bpmn:outgoing></bpmn:sendTask>
      <bpmn:endEvent id="EndEvent_ArrependimentoSemPrazoAfirmado" name="Arrependimento registrado — sem prazo afirmado (FECHADO)"><bpmn:documentation>Fim nomeado do caminho FECHADO RL-SF-015 (RLR:215).</bpmn:documentation><bpmn:incoming>Flow_A5_Recibo</bpmn:incoming></bpmn:endEvent>
      <bpmn:receiveTask id="Task_AguardaJanelaP7D" name="Aguarda fim da janela — P7D parametrizado (variantes)"><bpmn:documentation>VARIANTE NÃO ATIVA: host do timer de borda não-interruptivo; valor SEMPRE parametrizado (${withdrawal_window_policy[ancora_arrependimento]} — política versionada com âncoras signed_at/vigencia_start; termo final nunca em código; RLR:215). Sem ratificação RL-SF-015 não instanciado.</bpmn:documentation><bpmn:incoming>Flow_A8_Aguarda</bpmn:incoming><bpmn:outgoing>Flow_A9_Janela</bpmn:outgoing></bpmn:receiveTask>
      <bpmn:boundaryEvent id="Event_TimerP7DParam" name="P7D vencido (parametrizado — RL-SF-015)" attachedToRef="Task_AguardaJanelaP7D" cancelActivity="false"><bpmn:documentation>Timer de borda NÃO-INTERRUPTIVO (missão §6: prazo parametrizado + portão anotado). Valor: ${withdrawal_window_policy[ancora_arrependimento]} — NUNCA número solto; as duas âncoras possíveis estão nas variantes anotadas do Gateway_Gate_RLSF015 (CDC L222 × RN 413 L124). Alarme dispara avaliação HUMANA (nenhuma negativa automática, RLR:215).</bpmn:documentation><bpmn:outgoing>Flow_A10_AlarmeP7D</bpmn:outgoing><bpmn:timerEventDefinition id="TimerDef_Event_TimerP7DParam"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">${withdrawal_window_policy[ancora_arrependimento]}</bpmn:timeDuration></bpmn:timerEventDefinition></bpmn:boundaryEvent>
      <bpmn:endEvent id="EndEvent_JanelaVarianteRLSF015" name="Janela vigente controlada (variante RL-SF-015)"><bpmn:documentation>Fim nomeado da VARIANTE (não ativa): controle da janela com contagem ratificada.</bpmn:documentation><bpmn:incoming>Flow_A9_Janela</bpmn:incoming></bpmn:endEvent>
      <bpmn:startEvent id="StartEvent_PedidoCancelamentoOp" name="Pedido de cancelamento (toque 1 registrado)"><bpmn:documentation>Message start do toque 2. RN 561 art.4º III (L291): canal página da internet; art.6º §3º (L292): pedido online ⇒ resposta automática + PROTOCOLO ao beneficiário. RN 623 art.10 (L62): protocolo como PRIMEIRA AÇÃO.</bpmn:documentation><bpmn:outgoing>Flow_SK0_Confirma</bpmn:outgoing><bpmn:messageEventDefinition id="MsgDef_StartEvent_PedidoCancelamentoOp" messageRef="Message_PedidoCancelamentoOp" /></bpmn:startEvent>
      <bpmn:userTask id="Task_ConfirmaCancelamentoToque2" name="Confirma pedido — toque 2 com atendente (RN 561 arts.15/16)"><bpmn:documentation>RN 561 art.15 II (baseline L293, verbatim: 'efeito imediato e caráter irrevogável da solicitação de cancelamento… a partir da ciência da operadora'); art.16 (L294): na solicitação ou no comprovante. Motivo em lista fechada (E-SF-RT-02, RT-D1). RN 561 art.21 (L297): rescisão INDEPENDE do adimplemento — NUNCA recusado por débito (Annotation_Art21). Superfície do toque 1 = E-SF-RT-04 (GAP-RT-06).</bpmn:documentation><bpmn:incoming>Flow_SK0_Confirma</bpmn:incoming><bpmn:incoming>Flow_LinkF4CancelToque2</bpmn:incoming><bpmn:outgoing>Flow_K1_Gate</bpmn:outgoing></bpmn:userTask>
      <bpmn:exclusiveGateway id="Gateway_Gate_RTJ2" name="Prazo do comprovante exibido? — RT-J2 (jurídico)" default="Flow_K2_SemPrazo"><bpmn:documentation>PORTÃO FECHADO RT-J2 (RT-J2.md:22/80-81; adjacente RL-SF-035/RL-REG-27, RLR:43/235): default = 'Pedido com protocolo, sem prazo exibido'; teto de 10 dias úteis do comprovante (RN 561 art.18, baseline L295) NÃO exibido até ratificação; declaração de conformidade do ecrã pendente (EP-REG-27b). Variante (cond) nunca ativa.</bpmn:documentation><bpmn:incoming>Flow_K1_Gate</bpmn:incoming><bpmn:outgoing>Flow_K2_SemPrazo</bpmn:outgoing><bpmn:outgoing>Flow_K6_VarianteTeto</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:sendTask id="Task_EmiteProtocoloImediato" name="Emite protocolo imediato + comprovante SEM prazo exibido"><bpmn:documentation>RN 623 art.10 (baseline L62, verbatim: 'número de protocolo como primeira ação'); RN 561 art.6º §3º (L292): resposta automática + protocolo. FECHADO RT-J2: sem prazo exibido (RT-J2.md:80-81). Recibo imediato do toque 2.</bpmn:documentation><bpmn:incoming>Flow_K2_SemPrazo</bpmn:incoming><bpmn:outgoing>Flow_K3_Comprovante</bpmn:outgoing></bpmn:sendTask>
      <bpmn:sendTask id="Task_EmiteComprovanteEfetivo" name="Emite comprovante do efetivo cancelamento — teto art.18 NÃO exibido"><bpmn:documentation>RN 561 art.18 (baseline L295, verbatim: 'no prazo de dez dias úteis, o comprovante do efetivo cancelamento… por qualquer meio que assegure sua ciência'). Teto NÃO exibido (RL-SF-035/RL-REG-27, RLR:235; RT-J2.md:81); tracker 'aguardando o comprovante' sem ETA.</bpmn:documentation><bpmn:incoming>Flow_K3_Comprovante</bpmn:incoming><bpmn:outgoing>Flow_K4_Fonte</bpmn:outgoing></bpmn:sendTask>
      <bpmn:sendTask id="Task_NoticiaFonteCancelamento" name="Noticia cancelamento efetivo à fonte (AMH)"><bpmn:documentation>Comunica o cancelamento efetivo à fonte competente (campos cancelamento/situacao_cadastral — RL-SF-003, RLR:11). MessageFlow para o pool AMH (vertical). RN 561 art.21 (L297): independe do adimplemento — nenhuma cobrança/condição antes do protocolo.</bpmn:documentation><bpmn:incoming>Flow_K4_Fonte</bpmn:incoming><bpmn:outgoing>Flow_K5_Fim</bpmn:outgoing><bpmn:outgoing>Flow_ThrowCiclo</bpmn:outgoing></bpmn:sendTask>
      <bpmn:endEvent id="EndEvent_CancelamentoSemPrazoExibido" name="Cancelamento registrado — protocolo sem prazo exibido (FECHADO)"><bpmn:documentation>Fim nomeado do caminho FECHADO RT-J2 (RT-J2.md:80-81): protocolo sem prazo exibido.</bpmn:documentation><bpmn:incoming>Flow_K5_Fim</bpmn:incoming></bpmn:endEvent>
      <bpmn:intermediateThrowEvent id="Event_ThrowE9CicloVigente" name="Ciclo vigente (LINK↔F4)"><bpmn:documentation>LINK↔ETAPA9-CICLO-VIGENTE (linkEventDefinition): par de link com a frente F4 (FUNIL-F04-retencao.bpmn, catch Event_LinkE9Ciclo, LinkDef_Event_LinkE9Ciclo) — convenção da missão §5.2: a etapa LIGA à frente e não duplica tarefas. Entrada do ciclo de renovação/reajuste. Épico E-SF-RT-04 | OS-07.</bpmn:documentation><bpmn:incoming>Flow_ThrowCiclo</bpmn:incoming><bpmn:outgoing>Flow_ThrowCicloFim</bpmn:outgoing><bpmn:linkEventDefinition id="LinkDef_Event_ThrowE9CicloVigente" name="ETAPA9-CICLO-VIGENTE" /></bpmn:intermediateThrowEvent>
      <bpmn:endEvent id="EndEvent_CicloRemetidoF4" name="Ciclo remetido à F4"><bpmn:documentation>Fim nomeado do remetimento por link ETAPA9-CICLO-VIGENTE: o ciclo vigente segue à frente F4 (catch Event_LinkE9Ciclo — FUNIL-F04-retencao.bpmn); a etapa LIGA, não duplica (missão §5.2); nenhum caminho termina em silêncio. Épico E-SF-RT-04 | OS-07.</bpmn:documentation><bpmn:incoming>Flow_ThrowCicloFim</bpmn:incoming></bpmn:endEvent>
      <bpmn:intermediateCatchEvent id="Event_LinkF4Cancelamento" name="Pedido protocolado pela F4 (LINK↔F4)"><bpmn:documentation>LINK↔F4-ETAPA9-CANCELAMENTO (linkEventDefinition): par de link com o throw Event_ThrowCancelE9 (FUNIL-F04) — pedido protocolado remetido pela frente; a execução no cadastro e o comprovante do efetivo (RN 561 art. 18, L295, SEM prazo até RT-J2) pertencem à etapa 9 (missão §5.2). Épico E-SF-RT-02/04 | RN 561.</bpmn:documentation><bpmn:outgoing>Flow_LinkF4CancelToque2</bpmn:outgoing><bpmn:linkEventDefinition id="LinkDef_Event_LinkF4Cancelamento" name="F4-ETAPA9-CANCELAMENTO" /></bpmn:intermediateCatchEvent>
      <bpmn:intermediateCatchEvent id="Event_LinkF4Renovacao" name="Renovação efetivada pela F4 (LINK↔F4)"><bpmn:documentation>LINK↔F4-ETAPA9-RENOVACAO (linkEventDefinition): par de link com o throw Event_ThrowRenovacaoE9 (FUNIL-F04) — renovação efetivada remetida pela frente à etapa 9 (missão §5.2). Épico E-SF-RT-01/04 | OS-07.</bpmn:documentation><bpmn:outgoing>Flow_LinkF4RenovacaoBoas</bpmn:outgoing><bpmn:linkEventDefinition id="LinkDef_Event_LinkF4Renovacao" name="F4-ETAPA9-RENOVACAO" /></bpmn:intermediateCatchEvent>
      <bpmn:startEvent id="StartEvent_PedidoReembolsoOp" name="Documentação do reembolso entregue"><bpmn:documentation>Entrega da documentação adequada = termo inicial do teto de 30 dias (Lei 9.656 art.12 VI, baseline L101). RL-SF-043/RL-REG-44 (RLR:248): wizard restrito a beneficiário; enquadramento urgência/emergência nunca autodeclarado.</bpmn:documentation><bpmn:outgoing>Flow_SR0_DMN</bpmn:outgoing><bpmn:messageEventDefinition id="MsgDef_StartEvent_PedidoReembolsoOp" messageRef="Message_PedidoReembolsoOp" /></bpmn:startEvent>
      <bpmn:businessRuleTask id="Task_ConsultaDMNReembolso" name="Consulta DMN r_lei9656_art12_vi — escopo do fato assistencial"><bpmn:documentation>businessRuleTask → decisão do catálogo: regra r_lei9656_art12_vi (DMN L85-103; valor 30 L92; calendário INDEFINIDO L93; DRAFT L102). Entrada = FATO assistencial 'urgência/emergência' (existe/não + escopo), produzido por decisão humana — NUNCA autodeclarado (RLR:248; guardas test_refund_emergency_flag_not_self_declared). NENHUM dado clínico no funil (Annotation_ZeroSaude). GAP-G2: se não fechar, nem urgência/emergência exibe prazo.</bpmn:documentation><bpmn:incoming>Flow_SR0_DMN</bpmn:incoming><bpmn:outgoing>Flow_R1_Gate</bpmn:outgoing></bpmn:businessRuleTask>
      <bpmn:exclusiveGateway id="Gateway_Gate_RLSF043" name="Urgência/emergência no fato assistencial? — RL-SF-043" default="Flow_R2_CanalHumano"><bpmn:documentation>PORTÃO FECHADO RL-SF-043 / RL-REG-44 (RLR:51/248): default = FORA de urgência/emergência → canal humano com protocolo como primeira ação e andamento datado SEM prazo (fallback B). Variante (cond): urgência/emergência enquadrada pelo registro assistencial (não autodeclarada) → relógio P30D sob Gateway_Gate_PROC06. B-13/RLR:235: nenhum prazo da RN 566 vira ETA de estágio; RN 566 art.16 I (L259): RN 259/2011 revogada desde 01/02/2023 — nenhum nó cita norma morta.</bpmn:documentation><bpmn:incoming>Flow_R1_Gate</bpmn:incoming><bpmn:outgoing>Flow_R2_CanalHumano</bpmn:outgoing><bpmn:outgoing>Flow_R5_VarianteUrgencia</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:userTask id="Task_RegistraCanalHumano" name="Registra por canal humano — protocolo + andamento datado"><bpmn:documentation>RL-SF-043 fallback B (RLR:248, verbatim: 'Os demais reembolsos vão por canal humano com protocolo como primeira ação, sem ETA'). RN 623 art.10 (L62): protocolo como primeira ação. Sem prazo exibido (DMN L18-19 DRAFT; RL-SF-035/RL-REG-27 RLR:235).</bpmn:documentation><bpmn:incoming>Flow_R2_CanalHumano</bpmn:incoming><bpmn:outgoing>Flow_R3_Informa</bpmn:outgoing></bpmn:userTask>
      <bpmn:sendTask id="Task_InformaAndamentoSemETA" name="Informa protocolo e andamento datado (sem ETA)"><bpmn:documentation>Resposta ao beneficiário: protocolo + timestamps observados, SEM ETA (RL-SF-043, RLR:248; RL-SF-035/RL-REG-27, RLR:235). Nenhuma mensagem proativa — resposta ao pedido dele (RT-D4 herdado).</bpmn:documentation><bpmn:incoming>Flow_R3_Informa</bpmn:incoming><bpmn:outgoing>Flow_R4_Fim</bpmn:outgoing></bpmn:sendTask>
      <bpmn:endEvent id="EndEvent_ReembolsoCanalSemPrazo" name="Reembolso por canal humano — sem prazo (FECHADO)"><bpmn:documentation>Fim nomeado do caminho FECHADO RL-SF-043 (RLR:248).</bpmn:documentation><bpmn:incoming>Flow_R4_Fim</bpmn:incoming></bpmn:endEvent>
      <bpmn:startEvent id="StartEvent_OposicaoOp" name="Oposição a contato para aplicação"><bpmn:documentation>E-SF-11 (onda 2): direitos do titular (DSR) no funil e pós-venda. Reativo (iniciado pelo beneficiário — RT-D4 intocado). Executável: SP-OP-SUPP-001 (Annotation_Nivel2).</bpmn:documentation><bpmn:outgoing>Flow_SP0_Aplica</bpmn:outgoing><bpmn:messageEventDefinition id="MsgDef_StartEvent_OposicaoOp" messageRef="Message_OposicaoOp" /></bpmn:startEvent>
      <bpmn:userTask id="Task_AplicaOposicao" name="Aplica oposição — desliga contato proativo"><bpmn:documentation>Aplicação da oposição (RL-SF-093(ii)); SP-OP-SUPP-001_Direitos_de_Nao_Contato.bpmn existe (nível 2, citado por anotação — Annotation_Nivel2). Efeito: nenhuma mensagem proativa, boas-vindas proativa (variante RT-D4) bloqueada para o titular oponente.</bpmn:documentation><bpmn:incoming>Flow_SP0_Aplica</bpmn:incoming><bpmn:outgoing>Flow_P1_Fim</bpmn:outgoing></bpmn:userTask>
      <bpmn:endEvent id="EndEvent_OposicaoAplicada" name="Oposição aplicada — nenhuma mensagem proativa"><bpmn:documentation>Fim nomeado: oposição vigente; alinha com RT-D4 (nenhuma proatividade) e E-SF-11.</bpmn:documentation><bpmn:incoming>Flow_P1_Fim</bpmn:incoming></bpmn:endEvent>
      <bpmn:userTask id="Task_ApuraCusteioArrependimento" name="Apura custeio/estorno — valores em dinheiro por decisão humana"><bpmn:documentation>VALORES EM DINHEIRO = userTask na raia competente (missão §6: nunca service/agente). RN 413 art.8º §2º (baseline L124): custeio dos procedimentos efetuados até o limite do valor da multa rescisória prevista contratualmente; rescisão sem ônus condicionada à não utilização (§1º).</bpmn:documentation><bpmn:incoming>Flow_A3_Custeio</bpmn:incoming><bpmn:outgoing>Flow_A4_Custeio</bpmn:outgoing></bpmn:userTask>
      <bpmn:userTask id="Task_AnalisaReembolsoFinanceiro" name="Analisa reembolso — apura valor por decisão humana"><bpmn:documentation>VALORES EM DINHEIRO = userTask (missão §6). Lei 9.656 art.12 VI (baseline L101): reembolso nos limites das obrigações contratuais, de acordo com a relação de preços do respectivo produto. Host do timer P30D; caminho de urgência/emergência (variante RL-SF-043).</bpmn:documentation><bpmn:incoming>Flow_R5_VarianteUrgencia</bpmn:incoming><bpmn:outgoing>Flow_R8_GateProc06</bpmn:outgoing></bpmn:userTask>
      <bpmn:boundaryEvent id="Event_TimerP30D" name="P30D da entrega da documentação" attachedToRef="Task_AnalisaReembolsoFinanceiro" cancelActivity="false"><bpmn:documentation>Timer de borda NÃO-INTERRUPTIVO: valor ISO 8601 do FATO NORMATIVO com linha — Lei 9.656 art.12 VI (baseline L91/L101: 'pagáveis no prazo máximo de trinta dias após a entrega da documentação adequada'). DMN r_lei9656_art12_vi DRAFT (L102) com calendário indefinido (L93) — exibição depende de Gateway_Gate_PROC06 (PROC-06, DEC-PROC.md:63). Alarme interno.</bpmn:documentation><bpmn:outgoing>Flow_R6_AlarmeP30D</bpmn:outgoing><bpmn:timerEventDefinition id="TimerDef_Event_TimerP30D"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P30D</bpmn:timeDuration></bpmn:timerEventDefinition></bpmn:boundaryEvent>
      <bpmn:userTask id="Task_TrataEstouroP30D" name="Trata estouro de P30D — alarme interno, tratativa humana"><bpmn:documentation>Estouro do teto legal (Lei 9.656 art.12 VI, L91/L101): alarme INTERNO e tratativa humana na raia Financeiro — NUNCA mensagem proativa ao beneficiário (RT-D4 herdado; missão §8).</bpmn:documentation><bpmn:incoming>Flow_R6_AlarmeP30D</bpmn:incoming><bpmn:outgoing>Flow_R7_Tratado</bpmn:outgoing></bpmn:userTask>
      <bpmn:endEvent id="EndEvent_EstouroP30DTratado" name="Estouro de P30D tratado internamente"><bpmn:documentation>Fim nomeado do alarme: registro interno do estouro e tratativa; sem ETA ao beneficiário (RL-SF-035/RL-REG-27, RLR:235).</bpmn:documentation><bpmn:incoming>Flow_R7_Tratado</bpmn:incoming></bpmn:endEvent>
      <bpmn:exclusiveGateway id="Gateway_Gate_PROC06" name="P30D exibido? (PROC-06)" default="Flow_R9_SoTimestamps"><bpmn:documentation>Nome completo: Prazo P30D exibido? — PROC-06 ratificado (jurídico)?. PORTÃO FECHADO PROC-06 (working/DEC-PROC.md:63: 'T7: relógio legal de 30 dias do reembolso… RATIFY-LATER-jurídico; deploy OWNER-DEPLOY') no âmbito de RL-SF-043 (RLR:248): default = sem ratificação → SÓ TIMESTAMPS, sem prazo exibido (fallback B); variante (cond) → jurídico ratifica → prazo P30D exibido. DMN DRAFT (L102) não instanciável.</bpmn:documentation><bpmn:incoming>Flow_R8_GateProc06</bpmn:incoming><bpmn:outgoing>Flow_R9_SoTimestamps</bpmn:outgoing><bpmn:outgoing>Flow_R11_VarianteProc06</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:sendTask id="Task_InformaTimestampsSemPrazo" name="Informa protocolo + timestamps — sem prazo (fallback B)"><bpmn:documentation>RL-SF-043 fallback B (RLR:248, verbatim: 'Se o GAP-G2 não fechar, mesmo a urgência/emergência sai sem prazo exibido (só timestamps)'). DMN DRAFT (L102) nunca instanciado.</bpmn:documentation><bpmn:incoming>Flow_R9_SoTimestamps</bpmn:incoming><bpmn:outgoing>Flow_R10_FimTs</bpmn:outgoing></bpmn:sendTask>
      <bpmn:endEvent id="EndEvent_ReembolsoUrgenciaSemPrazo" name="Urgência/emergência — sem prazo exibido (FECHADO)"><bpmn:documentation>Fim nomeado do caminho FECHADO PROC-06/RL-SF-043 (RLR:248).</bpmn:documentation><bpmn:incoming>Flow_R10_FimTs</bpmn:incoming></bpmn:endEvent>
      <bpmn:sendTask id="Task_InformaReembolsoComPrazo" name="Informa reembolso com prazo P30D exibido (variante)"><bpmn:documentation>VARIANTE NÃO ATIVA: PROC-06 ratificado (DEC-PROC.md:63) + RL-SF-043 — prazo exibido = Lei 9.656 art.12 VI (L91/L101), teto de 30 dias desde a ENTREGA da documentação. Missão §5.1 linha 9: 'reembolso com prazo exibido' só neste ramo ratificado.</bpmn:documentation><bpmn:incoming>Flow_R12_ComPrazo</bpmn:incoming><bpmn:outgoing>Flow_R13_FimPrazo</bpmn:outgoing></bpmn:sendTask>
      <bpmn:endEvent id="EndEvent_ReembolsoComPrazoVariante" name="Reembolso com prazo P30D exibido (variante)"><bpmn:documentation>Fim nomeado da VARIANTE (não ativa enquanto PROC-06/RL-SF-043 pendentes).</bpmn:documentation><bpmn:incoming>Flow_R13_FimPrazo</bpmn:incoming></bpmn:endEvent>
      <bpmn:userTask id="Task_JuridicoDecideContagem" name="Define contagem do arrependimento — RL-SF-015"><bpmn:documentation>ATO DO DONO que abre o portão RL-SF-015 (RLR:215; missão §8: contagem do arrependimento é do jurídico). Recebe as DUAS variantes (cond): CDC art.49 L222 (assinatura) × RN 413 art.8º L124 (vigência). Pendente — caminhos nunca ativos. Épicos: E-SF-09 (GAP) / E-SF-09r (AGUARDA-RATIFICAÇÃO).</bpmn:documentation><bpmn:incoming>Flow_A6_VarianteAssinatura</bpmn:incoming><bpmn:incoming>Flow_A7_VarianteVigencia</bpmn:incoming><bpmn:outgoing>Flow_A8_Aguarda</bpmn:outgoing></bpmn:userTask>
      <bpmn:userTask id="Task_JuridicoRatificaTeto" name="Ratifica teto de 10 dias úteis + conformidade do ecrã — RT-J2"><bpmn:documentation>Abre o portão RT-J2 (RT-J2.md:81): exibição do teto de 10 dias úteis (RN 561 art.18, baseline L295) e declaração de conformidade do ecrã (EP-REG-27b). Variante nunca ativa; RL-SF-035/RL-REG-27 (RLR:43/235).</bpmn:documentation><bpmn:incoming>Flow_K6_VarianteTeto</bpmn:incoming><bpmn:outgoing>Flow_K7_ComTeto</bpmn:outgoing></bpmn:userTask>
      <bpmn:sendTask id="Task_EmiteComprovanteComTeto" name="Comprovante com teto de 10 dias úteis exibido (variante)"><bpmn:documentation>VARIANTE NÃO ATIVA (RT-J2.md:80-81): comprovante do efetivo cancelamento (RN 561 art.18, L295) COM teto exibido — só após ratificação.</bpmn:documentation><bpmn:incoming>Flow_K7_ComTeto</bpmn:incoming><bpmn:outgoing>Flow_K8_FimVariante</bpmn:outgoing></bpmn:sendTask>
      <bpmn:endEvent id="EndEvent_ComprovanteComTetoVariante" name="Comprovante com teto exibido (variante RT-J2)"><bpmn:documentation>Fim nomeado da VARIANTE RT-J2 (não ativa).</bpmn:documentation><bpmn:incoming>Flow_K8_FimVariante</bpmn:incoming></bpmn:endEvent>
      <bpmn:userTask id="Task_JuridicoRatificaP30D" name="Ratifica exibição do prazo P30D — PROC-06"><bpmn:documentation>Abre o portão PROC-06 (DEC-PROC.md:63) no âmbito RL-SF-043 (RLR:248): relógio legal de 30 dias do wizard (T7) vira exibível; deploy OWNER-DEPLOY. Variante nunca ativa.</bpmn:documentation><bpmn:incoming>Flow_R11_VarianteProc06</bpmn:incoming><bpmn:outgoing>Flow_R12_ComPrazo</bpmn:outgoing></bpmn:userTask>
      <bpmn:sequenceFlow id="Flow_C1_Contato" name="Contato recebido" sourceRef="StartEvent_ContatoReativo" targetRef="Task_PreparaRespostaBoasVindas" />
      <bpmn:sequenceFlow id="Flow_C2_Preparado" name="Conteúdo preparado" sourceRef="Task_PreparaRespostaBoasVindas" targetRef="Gateway_Gate_RTD4" />
      <bpmn:sequenceFlow id="Flow_C3_SoResposta" name="Sem proatividade — só resposta (FECHADO)" sourceRef="Gateway_Gate_RTD4" targetRef="Task_RespondeNaConversa" />
      <bpmn:sequenceFlow id="Flow_C4_Resposta" name="Resposta enviada" sourceRef="Task_RespondeNaConversa" targetRef="EndEvent_SemProatividade" />
      <bpmn:sequenceFlow id="Flow_C5_ProativaVariante" name="DPO ratifica proatividade (variante não ativa — RT-D4)" sourceRef="Gateway_Gate_RTD4" targetRef="Task_EnviaBoasVindasProativa"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">encarregado (DPO) ratifica envio proativo (RT-D4 — assinatura pendente)</bpmn:conditionExpression></bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_C6_EnviadaVariante" name="Boas-vindas proativa enviada (variante)" sourceRef="Task_EnviaBoasVindasProativa" targetRef="EndEvent_ProativaVariante" />
      <bpmn:sequenceFlow id="Flow_LinkF4RenovacaoBoas" name="Renovação efetivada pela F4 — boas-vindas/recibo D0 continuam gated (RT-D4)" sourceRef="Event_LinkF4Renovacao" targetRef="Gateway_Gate_RTD4" />
      <bpmn:sequenceFlow id="Flow_SA0_Analisa" name="Trata pedido" sourceRef="StartEvent_PedidoArrependimentoOp" targetRef="Task_TrataArrependimento" />
      <bpmn:sequenceFlow id="Flow_A1_Gate" name="Contagem do prazo?" sourceRef="Task_TrataArrependimento" targetRef="Gateway_Gate_RLSF015" />
      <bpmn:sequenceFlow id="Flow_A2_SemContagem" name="Contagem a definir pelo jurídico — janela exibida sem prazo regulatório afirmado (FECHADO)" sourceRef="Gateway_Gate_RLSF015" targetRef="Task_AvaliaTempestividadeHumana" />
      <bpmn:sequenceFlow id="Flow_A6_VarianteAssinatura" name="Variante A: contagem desde a ASSINATURA (CDC art.49, L222) — nunca ativa" sourceRef="Gateway_Gate_RLSF015" targetRef="Task_JuridicoDecideContagem"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">jurídico ratifica contagem desde a ASSINATURA (CDC art.49, baseline L222 — RL-SF-015)</bpmn:conditionExpression></bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_A7_VarianteVigencia" name="Variante B: contagem desde a VIGÊNCIA (RN 413 art.8º, L124) — nunca ativa" sourceRef="Gateway_Gate_RLSF015" targetRef="Task_JuridicoDecideContagem"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">jurídico ratifica contagem desde a VIGÊNCIA (RN 413 art.8º, baseline L124 — RL-SF-015)</bpmn:conditionExpression></bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_A8_Aguarda" name="Contagem definida — janela P7D controlada" sourceRef="Task_JuridicoDecideContagem" targetRef="Task_AguardaJanelaP7D" />
      <bpmn:sequenceFlow id="Flow_A3_Custeio" name="Tempestividade avaliada — apura custeio (humano)" sourceRef="Task_AvaliaTempestividadeHumana" targetRef="Task_ApuraCusteioArrependimento" />
      <bpmn:sequenceFlow id="Flow_A4_Custeio" name="Custeio/estorno apurado (humano)" sourceRef="Task_ApuraCusteioArrependimento" targetRef="Task_EnviaReciboArrependimento" />
      <bpmn:sequenceFlow id="Flow_A5_Recibo" name="Recibo enviado" sourceRef="Task_EnviaReciboArrependimento" targetRef="EndEvent_ArrependimentoSemPrazoAfirmado" />
      <bpmn:sequenceFlow id="Flow_A9_Janela" name="Janela vigente (variante)" sourceRef="Task_AguardaJanelaP7D" targetRef="EndEvent_JanelaVarianteRLSF015" />
      <bpmn:sequenceFlow id="Flow_A10_AlarmeP7D" name="P7D vencido — avaliação humana" sourceRef="Event_TimerP7DParam" targetRef="Task_AvaliaTempestividadeHumana" />
      <bpmn:sequenceFlow id="Flow_SK0_Confirma" name="Toque 2 — confirma com atendente" sourceRef="StartEvent_PedidoCancelamentoOp" targetRef="Task_ConfirmaCancelamentoToque2" />
      <bpmn:sequenceFlow id="Flow_K1_Gate" name="Prazo do comprovante?" sourceRef="Task_ConfirmaCancelamentoToque2" targetRef="Gateway_Gate_RTJ2" />
      <bpmn:sequenceFlow id="Flow_K2_SemPrazo" name="Protocolo sem prazo exibido (FECHADO)" sourceRef="Gateway_Gate_RTJ2" targetRef="Task_EmiteProtocoloImediato" />
      <bpmn:sequenceFlow id="Flow_K3_Comprovante" name="Comprovante do efetivo" sourceRef="Task_EmiteProtocoloImediato" targetRef="Task_EmiteComprovanteEfetivo" />
      <bpmn:sequenceFlow id="Flow_K4_Fonte" name="Noticia à fonte" sourceRef="Task_EmiteComprovanteEfetivo" targetRef="Task_NoticiaFonteCancelamento" />
      <bpmn:sequenceFlow id="Flow_K5_Fim" name="Cancelamento efetivo" sourceRef="Task_NoticiaFonteCancelamento" targetRef="EndEvent_CancelamentoSemPrazoExibido" />
      <bpmn:sequenceFlow id="Flow_ThrowCiclo" name="Ciclo vigente — remete à F4 (LINK↔F4)" sourceRef="Task_NoticiaFonteCancelamento" targetRef="Event_ThrowE9CicloVigente" />
      <bpmn:sequenceFlow id="Flow_ThrowCicloFim" name="Ciclo remetido à F4" sourceRef="Event_ThrowE9CicloVigente" targetRef="EndEvent_CicloRemetidoF4" />
      <bpmn:sequenceFlow id="Flow_LinkF4CancelToque2" name="Pedido protocolado pela F4 — alimenta o toque 2" sourceRef="Event_LinkF4Cancelamento" targetRef="Task_ConfirmaCancelamentoToque2" />
      <bpmn:sequenceFlow id="Flow_K6_VarianteTeto" name="RATIFICADO: teto de 10 dias úteis exibido (variante não ativa — RT-J2)" sourceRef="Gateway_Gate_RTJ2" targetRef="Task_JuridicoRatificaTeto"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">jurídico ratifica exibição do teto de 10 dias úteis e conformidade do ecrã (RT-J2)</bpmn:conditionExpression></bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_K7_ComTeto" name="Teto exibido (variante)" sourceRef="Task_JuridicoRatificaTeto" targetRef="Task_EmiteComprovanteComTeto" />
      <bpmn:sequenceFlow id="Flow_K8_FimVariante" name="Comprovante com teto (variante)" sourceRef="Task_EmiteComprovanteComTeto" targetRef="EndEvent_ComprovanteComTetoVariante" />
      <bpmn:sequenceFlow id="Flow_SR0_DMN" name="Consulta escopo" sourceRef="StartEvent_PedidoReembolsoOp" targetRef="Task_ConsultaDMNReembolso" />
      <bpmn:sequenceFlow id="Flow_R1_Gate" name="Escopo do fato assistencial" sourceRef="Task_ConsultaDMNReembolso" targetRef="Gateway_Gate_RLSF043" />
      <bpmn:sequenceFlow id="Flow_R2_CanalHumano" name="Fora de urgência/emergência — canal humano, sem prazo (FECHADO)" sourceRef="Gateway_Gate_RLSF043" targetRef="Task_RegistraCanalHumano" />
      <bpmn:sequenceFlow id="Flow_R3_Informa" name="Protocolo + andamento datado" sourceRef="Task_RegistraCanalHumano" targetRef="Task_InformaAndamentoSemETA" />
      <bpmn:sequenceFlow id="Flow_R4_Fim" name="Sem ETA (FECHADO)" sourceRef="Task_InformaAndamentoSemETA" targetRef="EndEvent_ReembolsoCanalSemPrazo" />
      <bpmn:sequenceFlow id="Flow_R5_VarianteUrgencia" name="Urgência/emergência no fato assistencial (não autodeclarada — variante)" sourceRef="Gateway_Gate_RLSF043" targetRef="Task_AnalisaReembolsoFinanceiro"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">fato assistencial marca urgência/emergência (produzido por decisão humana — RL-SF-043)</bpmn:conditionExpression></bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_R6_AlarmeP30D" name="P30D vencido — alarme interno" sourceRef="Event_TimerP30D" targetRef="Task_TrataEstouroP30D" />
      <bpmn:sequenceFlow id="Flow_R7_Tratado" name="Tratado internamente" sourceRef="Task_TrataEstouroP30D" targetRef="EndEvent_EstouroP30DTratado" />
      <bpmn:sequenceFlow id="Flow_R8_GateProc06" name="Análise concluída" sourceRef="Task_AnalisaReembolsoFinanceiro" targetRef="Gateway_Gate_PROC06" />
      <bpmn:sequenceFlow id="Flow_R9_SoTimestamps" name="PROC-06 não ratificado — só timestamps (FECHADO)" sourceRef="Gateway_Gate_PROC06" targetRef="Task_InformaTimestampsSemPrazo" />
      <bpmn:sequenceFlow id="Flow_R10_FimTs" name="Sem prazo exibido" sourceRef="Task_InformaTimestampsSemPrazo" targetRef="EndEvent_ReembolsoUrgenciaSemPrazo" />
      <bpmn:sequenceFlow id="Flow_R11_VarianteProc06" name="RATIFICADO: relógio P30D exibível (variante não ativa — PROC-06)" sourceRef="Gateway_Gate_PROC06" targetRef="Task_JuridicoRatificaP30D"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">jurídico ratifica relógio legal de 30 dias do wizard (PROC-06 — DEC-PROC.md:63)</bpmn:conditionExpression></bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_R12_ComPrazo" name="P30D exibido (variante)" sourceRef="Task_JuridicoRatificaP30D" targetRef="Task_InformaReembolsoComPrazo" />
      <bpmn:sequenceFlow id="Flow_R13_FimPrazo" name="Reembolso informado com prazo (variante)" sourceRef="Task_InformaReembolsoComPrazo" targetRef="EndEvent_ReembolsoComPrazoVariante" />
      <bpmn:sequenceFlow id="Flow_SP0_Aplica" name="Aplica oposição" sourceRef="StartEvent_OposicaoOp" targetRef="Task_AplicaOposicao" />
      <bpmn:sequenceFlow id="Flow_P1_Fim" name="Oposição aplicada" sourceRef="Task_AplicaOposicao" targetRef="EndEvent_OposicaoAplicada" />
      <bpmn:textAnnotation id="Annotation_RLSF015"><bpmn:text>PORTÃO RL-SF-015 = RL-REG-03/Q3 (RLR:215): DUAS contagens — CDC art.49 (L222: desde a ASSINATURA) × RN 413 art.8º (L124: desde a VIGÊNCIA). withdrawal_window_policy; NENHUMA negativa automática; janela exibida sem prazo regulatório afirmado.</bpmn:text></bpmn:textAnnotation>
      <bpmn:textAnnotation id="Annotation_Art21"><bpmn:text>RN 561 art.21 (baseline L297): 'A rescisão do contrato ou a exclusão do beneficiário INDEPENDE do adimplemento contratual' — cancelamento NUNCA recusado por débito; nenhuma cobrança/condição antes do protocolo. RL-SF-035 / RL-REG-27 (RLR:43/235): teto de 10 dias úteis do comprovante (RN 561 art.18, L295) NÃO exibido até RT-J2.</bpmn:text></bpmn:textAnnotation>
      <bpmn:textAnnotation id="Annotation_Nivel2"><bpmn:text>NÍVEL 2: SP-OP-CANCEL-001_Cancelamento_Contrato.bpmn e SP-OP-REEMBOLSO-001_Reembolso_Beneficiario.bpmn EXISTEM (spec/processes/bpmn/, citados por anotação — nenhum executável criado); oposição = SP-OP-SUPP-001_Direitos_de_Nao_Contato.bpmn; arrependimento = GAP E-SF-09 (EXECUTION-LOG §7 L128) — E-SF-09r AGUARDA-RATIFICAÇÃO; E-SF-RT-02/03/04 (adendo).</bpmn:text></bpmn:textAnnotation>
      <bpmn:textAnnotation id="Annotation_MedicaoA9"><bpmn:text>MEDIÇÃO A9/OS-04 (AD §3.1 L23/37/46/52): DECIDIDA e NÃO EXECUTÁVEL — NENHUM caminho deste diagrama emite evento de medição (zero medição; walk em hml = E-SF-47, UNMEASURED).</bpmn:text></bpmn:textAnnotation>
      <bpmn:textAnnotation id="Annotation_RTD4"><bpmn:text>PORTÃO RT-D4 (RT-D4.md:23/54/91-92; RLR:120-124): NENHUMA mensagem proativa a beneficiário — lembrete de cobrança NUNCA (missão §8); boas-vindas só em resposta a contato dele. E-SF-62; RL-SF-093(ii); OS05-J1. GTM-07.D1: check-in único D+7 por tempo de casa ANOTADO (ADD-RETENTION.md:319/323/325; E-SF-22r) — RATIFY-LATER-DPO.</bpmn:text></bpmn:textAnnotation>
      <bpmn:textAnnotation id="Annotation_ZeroSaude"><bpmn:text>ZERO SAÚDE: a entrada do DMN é um FATO assistencial binário (urgência/emergência: existe/não + escopo), produzido por DECISÃO HUMANA na área assistencial — nunca autodeclarado (RLR:248); NENHUM dado clínico entra no funil comercial (missão §6/§8). Wizard só beneficiário (RL-SF-043).</bpmn:text></bpmn:textAnnotation>
      <bpmn:textAnnotation id="Annotation_RLSF043"><bpmn:text>PORTÃO RL-SF-043 / RL-REG-44 (RLR:51/248): postura C restrita a beneficiário; default (fallback B): canal humano com protocolo + andamento datado SEM prazo; mesmo urgência/emergência só timestamps até PROC-06 (DEC-PROC.md:63) e GAP-G2 fecharem. DMN DRAFT (L102).</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_RLSF015" sourceRef="Gateway_Gate_RLSF015" targetRef="Annotation_RLSF015" />
    <bpmn:association id="Association_Art21" sourceRef="Gateway_Gate_RTJ2" targetRef="Annotation_Art21" />
    <bpmn:association id="Association_Nivel2" sourceRef="Task_JuridicoDecideContagem" targetRef="Annotation_Nivel2" />
    <bpmn:association id="Association_MedicaoA9" sourceRef="StartEvent_ContatoReativo" targetRef="Annotation_MedicaoA9" />
    <bpmn:association id="Association_RTD4" sourceRef="StartEvent_ContatoReativo" targetRef="Annotation_RTD4" />
    <bpmn:association id="Association_RTD4_Gate" sourceRef="Gateway_Gate_RTD4" targetRef="Annotation_RTD4" />
    <bpmn:association id="Association_RLSF043_PROC06" sourceRef="Gateway_Gate_PROC06" targetRef="Annotation_RLSF043" />
    <bpmn:association id="Association_ZeroSaude" sourceRef="Task_ConsultaDMNReembolso" targetRef="Annotation_ZeroSaude" />
    <bpmn:association id="Association_RLSF043" sourceRef="Gateway_Gate_RLSF043" targetRef="Annotation_RLSF043" />
  </bpmn:process>
  <bpmn:process id="Process_ExecutorAMH" isExecutable="false">
    <bpmn:documentation>Executor comercial e lago (amh-data-platform). Fonte do vínculo: registra o cancelamento efetivo (campos cancelamento/situacao_cadastral — RL-SF-003, RLR:11). Leitura pela operadora, nenhum comando reverso. isExecutable=false.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_Process_ExecutorAMH">
      <bpmn:lane id="Lane_AMH" name="Executor">
        <bpmn:flowNodeRef>StartEvent_FonteCancelada</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RegistraCancelamentoFonte</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_FonteAtualizada</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
      <bpmn:startEvent id="StartEvent_FonteCancelada" name="Cancelamento efetivo noticiado pela operadora"><bpmn:documentation>Fato interno do executor vindo da operadora (messageFlow vertical). Fonte competente do vínculo (RL-SF-003, RLR:11).</bpmn:documentation><bpmn:outgoing>Flow_M1_Registra</bpmn:outgoing><bpmn:messageEventDefinition id="MsgDef_StartEvent_FonteCancelada" messageRef="Message_OpFonteCancelamento" /></bpmn:startEvent>
      <bpmn:serviceTask id="Task_RegistraCancelamentoFonte" name="Registra cancelamento na fonte"><bpmn:documentation>Campos da fonte competente (RL-SF-003, RLR:11): cancelamento e situacao_cadastral passam a refletir o cancelamento efetivo; leitura posterior pela operadora, nenhum comando reverso.</bpmn:documentation><bpmn:incoming>Flow_M1_Registra</bpmn:incoming><bpmn:outgoing>Flow_M2_Fonte</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:endEvent id="EndEvent_FonteAtualizada" name="Fonte atualizada (pós-cancelamento)"><bpmn:documentation>Fim nomeado: fonte consistente com o cancelamento efetivo.</bpmn:documentation><bpmn:incoming>Flow_M2_Fonte</bpmn:incoming></bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_M1_Registra" name="Notícia recebida" sourceRef="StartEvent_FonteCancelada" targetRef="Task_RegistraCancelamentoFonte" />
      <bpmn:sequenceFlow id="Flow_M2_Fonte" name="Fonte atualizada" sourceRef="Task_RegistraCancelamentoFonte" targetRef="EndEvent_FonteAtualizada" />
  </bpmn:process>
