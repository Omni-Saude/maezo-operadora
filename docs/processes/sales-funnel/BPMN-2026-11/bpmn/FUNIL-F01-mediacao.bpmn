      <bpmn:sequenceFlow id="Flow_ES2_Fechado" name="Nada emite evento (FECHADO)" sourceRef="Gateway_PortaoA9_ES2" targetRef="EndEvent_NadaEmite_ES2" />
      <bpmn:sequenceFlow id="Flow_ES2_Variante" name="A9 operante — emite (variante não ativa)" sourceRef="Gateway_PortaoA9_ES2" targetRef="Event_Emite_ES2"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">variante não ativa: A9 operante (G4 + RL-SF-045 + resíduos RL-SF-005/RL-SF-044)</bpmn:conditionExpression></bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_Branch_ES3" name="Estágio 3" sourceRef="Gateway_DistribuiEstagios" targetRef="Event_LinkES3"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">fato do estágio 3 observado no rastreador (Financeiro confirmado)</bpmn:conditionExpression></bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_LinkGate_ES3" name="Ponto de medição" sourceRef="Event_LinkES3" targetRef="Gateway_PortaoA9_ES3" />
      <bpmn:sequenceFlow id="Flow_ES3_Fechado" name="Nada emite evento (FECHADO)" sourceRef="Gateway_PortaoA9_ES3" targetRef="EndEvent_NadaEmite_ES3" />
      <bpmn:sequenceFlow id="Flow_ES3_Variante" name="A9 operante — emite (variante não ativa)" sourceRef="Gateway_PortaoA9_ES3" targetRef="Event_Emite_ES3"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">variante não ativa: A9 operante (G4 + RL-SF-045 + resíduos RL-SF-005/RL-SF-044)</bpmn:conditionExpression></bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_Branch_ES4" name="Estágio 4" sourceRef="Gateway_DistribuiEstagios" targetRef="Event_LinkES4"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">fato do estágio 4 observado no rastreador (Declaração de saúde recebida)</bpmn:conditionExpression></bpmn:sequenceFlow>
