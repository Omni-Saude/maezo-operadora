    <bpmn:association id="Association_PortaoES5" sourceRef="Gateway_PortaoA9_ES5" targetRef="Annotation_EstagioES5" />
    <bpmn:association id="Association_PortaoES6" sourceRef="Gateway_PortaoA9_ES6" targetRef="Annotation_EstagioES6" />
    <bpmn:association id="Association_PortaoES7" sourceRef="Gateway_PortaoA9_ES7" targetRef="Annotation_EstagioES7" />
