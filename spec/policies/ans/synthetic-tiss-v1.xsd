<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:tiss="urn:maezo:synthetic:tiss-schema-pin:v1"
           targetNamespace="urn:maezo:synthetic:tiss-schema-pin:v1"
           elementFormDefault="qualified">

  <xs:annotation>
    <xs:documentation>
      SYNTHETIC — structure-only. See the file-header XML comment above.
      Root element LoteGuiasSintetico models, in miniature, the four
      violation classes the T2.6-2 TISS-schema-pin gate's test suite proves
      (tests/unit/tools/workers/test_tiss_schema_pin.py): a missing required
      scalar element, a wrong-typed element, a cardinality (occurs-count)
      violation, and a namespace mismatch.
    </xs:documentation>
  </xs:annotation>

  <xs:element name="LoteGuiasSintetico">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="numeroLoteSintetico" type="xs:string" minOccurs="1" maxOccurs="1"/>
        <xs:element name="competenciaSintetica" type="xs:string" minOccurs="1" maxOccurs="1"/>
        <xs:element name="totalGuiasSintetico" type="xs:integer" minOccurs="1" maxOccurs="1"/>
        <xs:element name="guiaSintetica" type="xs:string" minOccurs="1" maxOccurs="2"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

</xs:schema>
