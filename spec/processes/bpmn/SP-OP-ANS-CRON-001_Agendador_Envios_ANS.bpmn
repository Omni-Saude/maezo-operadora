    <bpmn:sequenceFlow id="Flow_Rn209_End" sourceRef="ST_PublishCronDueRn209" targetRef="End_CronRn209"/>
  </bpmn:process>

  <bpmn:process id="SP-OP-ANS-CRON-001-RN388" name="Cron ANS RN 388 Qualidade (anual)"
