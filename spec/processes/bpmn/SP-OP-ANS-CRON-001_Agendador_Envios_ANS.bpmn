  <bpmndi:BPMNDiagram id="Diagram_SP-OP-ANS-CRON-001-RN209">
    <bpmndi:BPMNPlane id="Plane_SP-OP-ANS-CRON-001-RN209" bpmnElement="SP-OP-ANS-CRON-001-RN209">
      <bpmndi:BPMNShape id="Shape_Start_CronRn209" bpmnElement="Start_CronRn209">
        <dc:Bounds x="40" y="62" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_ST_ResolverCompetenciaRn209" bpmnElement="ST_ResolverCompetenciaRn209">
        <dc:Bounds x="156" y="40" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_ST_PublishCronDueRn209" bpmnElement="ST_PublishCronDueRn209">
        <dc:Bounds x="316" y="40" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_CronRn209" bpmnElement="End_CronRn209">
        <dc:Bounds x="496" y="62" width="36" height="36"/>
