<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_SP_OP_ANS_CRON_001"
                  targetNamespace="http://maezo.health/operadora/anscron"
                  exporter="Maezo W1-ANS"
                  exporterVersion="0.2.0-draft">

  <!-- =====================================================================================
       SP-OP-ANS-CRON-001 — Agendador per-report_type dos Envios Periodicos ANS (GAP-ANS-1).
       Status: DRAFT — todas as periodicidades (timeCycle) sao DRAFT/verify regulatorio.

       POR QUE um arquivo com CINCO process definitions: o CIB Seven 2.1.0 rejeita no deploy
       (a) multiplos none/timer start events num MESMO process definition ("multiple none start
       events or timer start events not supported") e (b) camunda:inputOutput em startEvent
       ("camunda:inputOutput mapping unsupported for element type 'startEvent'") — verificado
       empiricamente contra o engine real (ENGINE-09005). Logo "um TimerStartEvent por
       report_type" so e engine-deployavel como UM process definition por report_type, cada um
       com um UNICO TimerStartEvent proprio (periodicidade propria).

       DISPATCH POR FATO (ADR-0003 — event-choreographed, ZERO call-activity no repo, ver
       docs/audits/bpmn-process-completeness.md §4): cada tick publica um FATO TIPADO
       `type=ans.cron_due` no topico `operadora.notifications.internal` via o worker generico
       `operadora.events.publish` (inputParameter literal `event_type` -> payload.type; espelha
       event_fase/event_desfecho). O `notifications_bridge` (consumidor unico do topico) mapeia
       `ans.cron_due` -> start de SP-OP-ANS-SUBMIT-001 com BUSINESS KEY DETERMINISTICA
       ANSSUB-{tenant}-{report_type}-{competencia} (idempotente: find_active_instance antes do
       start — a reentrega/re-tick reconverge para a instancia ativa; nunca duplica ciclo).

       PAYLOAD (identificadores nao-PHI, literais por tipo): report_type / periodicidade /
       origem_envio=calendario / competencia=COMPETENCIA_PENDENTE (sentinela — o calendario nao
       e computavel em JUEL puro; a competencia REAL e resolvida pelo humano em
       UT_CorrigirPendenciaEnvio no processo de envio; um scheduler futuro pode publicar o fato
       com a competencia real, e a business key vira a calendar-key verdadeira). O tenant NAO
       viaja no fato: a ponte (deployment per-tenant) injeta o SEU tenant no plano de start.
       Os fatos de admissibilidade (dataset_complete/schema_valid/lgpd_anonimizado=false,
       fail-closed => PENDENTE => humano; NUNCA auto-transmite) sao seedados pela PONTE no start
       (ans_cron_variables), nao viajam no fato — ENGINE-16004-safe em todo start path.

       NAO negativa-like: agendador puro (operadora -> regulador); nenhum efeito adverso; todos
       os terminais sao NEUTROS (fato de despacho publicado). O HITL pre-filing vive no processo
       de envio (SP-OP-ANS-SUBMIT-001) e nao e contornavel por aqui (guard no worker submit).
       ===================================================================================== -->

  <bpmn:process id="SP-OP-ANS-CRON-001-RN124SIP" name="Cron ANS RN 124 SIP (mensal)"
                isExecutable="true" camunda:historyTimeToLive="180">
    <bpmn:documentation>Dispara mensalmente (R/P1M — DRAFT/verify) o fato ans.cron_due do envio periodico RN 124 SIP (report_type=RN_124_SIP, periodicidade=mensal) em operadora.notifications.internal; o notifications_bridge inicia SP-OP-ANS-SUBMIT-001 (bk deterministica).</bpmn:documentation>
    <bpmn:startEvent id="Start_CronRn124Sip" name="Cron mensal RN 124 SIP (R/P1M — DRAFT/verify)">
      <bpmn:outgoing>Flow_Rn124_Call</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TD_CronRn124Sip">
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R/P1M</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:serviceTask id="ST_PublishCronDueRn124Sip" name="Publicar fato: ans.cron_due (RN_124_SIP)"
                      camunda:type="external" camunda:topic="operadora.events.publish">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="event_topic">operadora.notifications.internal</camunda:inputParameter>
          <camunda:inputParameter name="event_type">ans.cron_due</camunda:inputParameter>
          <camunda:inputParameter name="event_payload_vars">report_type,periodicidade,origem_envio,competencia</camunda:inputParameter>
          <camunda:inputParameter name="report_type">RN_124_SIP</camunda:inputParameter>
          <camunda:inputParameter name="periodicidade">mensal</camunda:inputParameter>
          <camunda:inputParameter name="origem_envio">calendario</camunda:inputParameter>
          <camunda:inputParameter name="competencia">COMPETENCIA_PENDENTE</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Rn124_Call</bpmn:incoming>
      <bpmn:outgoing>Flow_Rn124_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_CronRn124Sip" name="Ciclo RN 124 SIP concluido">
      <bpmn:incoming>Flow_Rn124_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Rn124_Call" sourceRef="Start_CronRn124Sip" targetRef="ST_PublishCronDueRn124Sip"/>
    <bpmn:sequenceFlow id="Flow_Rn124_End" sourceRef="ST_PublishCronDueRn124Sip" targetRef="End_CronRn124Sip"/>
  </bpmn:process>

