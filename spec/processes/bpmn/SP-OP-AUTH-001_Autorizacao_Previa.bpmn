<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_SP_OP_AUTH_001"
                  targetNamespace="http://maezo.health/operadora/auth"
                  exporter="Maezo W5-PROC"
                  exporterVersion="0.1.0-draft">

  <bpmn:message id="Msg_AuthDocsRecebidos" name="msg.auth.docs_received"/>
  <bpmn:error id="Error_AuthGuiaInvalida" name="Guia TISS invalida/incompleta na origem" errorCode="ERR_AUTH_INVALID_GUIA"/>
  <!-- GAP-AUTH-2 (defesa-em-profundidade, NAO um bypass ativo): o worker send_denial_notice ja
       lanca ERR_AUTH_DENIAL_INCOMPLETE (guard L0, auth.py) quando a negativa formal chega sem
       fundamentacao completa (justificativa_clinica / cid10_referencia / fundamentacao_dut) — mas
       o erro nao era DECLARADO nem CAPTURADO, virando incidente travado na mainline. Declarado aqui
       + capturado por boundary event em ST_EnviarNegativaFormal (abaixo). O guard do worker PERMANECE
       o mecanismo de enforcement (ADR-0018) — este catch NAO o enfraquece. -->
  <bpmn:error id="Error_AuthDenialIncompleta" name="Negativa formal com fundamentacao incompleta (guard L0)" errorCode="ERR_AUTH_DENIAL_INCOMPLETE"/>
  <!-- GAP-AUTH-3 (fail-safe, M2a): GW_DecisaoAuditor default roteava para APROVAR — decisao_auditor
       ausente/corrompida aprovaria por omissao. Agora default vai para terminal de erro
       ERR_AUTH_DECISION_INVALID (fail-closed, espelha padrao LGPD-DSR End_ErrDecisaoInvalida). -->
  <bpmn:error id="Error_AuthDecisaoInvalida" name="Decisao do auditor ausente ou desconhecida" errorCode="ERR_AUTH_DECISION_INVALID"/>

  <bpmn:process id="SP-OP-AUTH-001" name="SP-OP-AUTH-001 Autorizacao Previa"
                isExecutable="true" camunda:historyTimeToLive="1825">
    <bpmn:documentation><![CDATA[
SP-OP-AUTH-001 — Autorizacao previa. Status: DRAFT (v0.1.0) — Phase 1, modelado uma fase
a frente. DI (diagrama) sera adicionado na promocao a FINAL. Requer revisao humana
(medico auditor + regulatorio) antes de qualquer deploy — ver docs/review-queue.md.

GATILHO REGULATORIO: RN 259/2011 (garantia de atendimento; consolidacao posterior ANS —
DRAFT/verify), RN 395/2016 (prazo de resposta a solicitacoes e negativa por escrito —
DRAFT/verify), RN 424/2017 (junta medica em divergencia — DRAFT/verify), Lei 9.656/1998
art. 35-C (urgencia/emergencia).

INVARIANTE L0 HARD (ADR-0005/0008, L0-core.yaml: authorization_denial): NEGATIVA de
cobertura SO existe como saida da User Task do medico auditor (UT_AnaliseMedicoAuditor /
UT_RegistrarParecerJunta / UT_CoordenacaoAssume). NAO HA caminho automatizado que resulte
em negativa: toda regra DMN desfavoravel, pendencia nao resolvida ou inelegibilidade
converge para analise humana. Aprovacao automatica (L2) existe apenas sob DMN favoravel
e teto do tenant (auth_auto_approval).

BUSINESS KEY (idempotente): "AUTH-{tenant_id}-{numero_guia_tiss}"
  — uma instancia por guia TISS. Reenvio da mesma guia NAO cria nova instancia
  (mcp-cibseven.start_process consulta business key antes de iniciar).

EVENTOS DE DOMINIO (worker operadora.events.publish):
  inicio -> agents.events.auth.received
  pendencia -> agents.events.auth.pended
  breach -> agents.events.auth.sla_breached
  fim -> agents.events.auth.completed (payload.desfecho = aprovada_automatica |
         aprovada_auditor | negada_auditor | nao_requer_autorizacao | cancelada_pendencia)

VARIAVEIS DE ENTRADA: tenant_id, numero_guia_tiss, beneficiario_pseudo_id (ADR-0006),
prestador_id, codigo_procedimento_tuss, carater_atendimento (urgencia|eletivo),
categoria_procedimento, valor_estimado_brl, cid10 (opcional), documentos_refs.
Contrato completo: docs/processes/contracts/SP-OP-AUTH-001.md.
]]></bpmn:documentation>

    <bpmn:startEvent id="Start_SolicitacaoRecebida" name="Solicitacao de autorizacao recebida">
      <bpmn:outgoing>Flow_Start_PubReceived</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:serviceTask id="ST_PublishReceived" name="Publicar evento: auth.received"
                      camunda:type="external" camunda:topic="operadora.events.publish">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="event_topic">agents.events.auth.received</camunda:inputParameter>
          <camunda:inputParameter name="event_payload_vars">tenant_id,numero_guia_tiss,prestador_id,codigo_procedimento_tuss,carater_atendimento</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Start_PubReceived</bpmn:incoming>
      <bpmn:outgoing>Flow_PubReceived_Admiss</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- DMN: admissibilidade (nunca nega — apenas roteia) -->
    <bpmn:businessRuleTask id="BRT_Admissibilidade" name="Avaliar admissibilidade (DMN auth_admissibility)"
                           camunda:decisionRef="auth_admissibility"
                           camunda:mapDecisionResult="singleResult"
                           camunda:resultVariable="admissibilidade">
      <bpmn:documentation>Saidas possiveis: NAO_REQUER | PENDENTE_DOCUMENTACAO | SEGUE_ANALISE. Por design NAO existe saida de negativa nesta DMN (L0 hard).</bpmn:documentation>
      <bpmn:incoming>Flow_PubReceived_Admiss</bpmn:incoming>
      <bpmn:incoming>Flow_DocsOk_Admiss</bpmn:incoming>
      <bpmn:outgoing>Flow_Admiss_GW</bpmn:outgoing>
    </bpmn:businessRuleTask>

    <bpmn:exclusiveGateway id="GW_Admissibilidade" name="Resultado admissibilidade" default="Flow_GW_SegueAnalise">
      <bpmn:incoming>Flow_Admiss_GW</bpmn:incoming>
      <bpmn:outgoing>Flow_GW_NaoRequer</bpmn:outgoing>
      <bpmn:outgoing>Flow_GW_Pendencia</bpmn:outgoing>
      <bpmn:outgoing>Flow_GW_SegueAnalise</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Ramo: procedimento nao requer autorizacao -->
    <bpmn:serviceTask id="ST_PublishNaoRequer" name="Publicar evento: auth.completed (nao_requer)"
                      camunda:type="external" camunda:topic="operadora.events.publish">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="event_topic">agents.events.auth.completed</camunda:inputParameter>
          <camunda:inputParameter name="event_desfecho">nao_requer_autorizacao</camunda:inputParameter>
          <camunda:inputParameter name="event_payload_vars">tenant_id,numero_guia_tiss</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_GW_NaoRequer</bpmn:incoming>
      <bpmn:outgoing>Flow_PubNaoRequer_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_NaoRequerAutorizacao" name="Nao requer autorizacao">
      <bpmn:incoming>Flow_PubNaoRequer_End</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Ramo: pendencia de documentacao -->
    <bpmn:serviceTask id="ST_SolicitarDocumentos" name="Solicitar documentacao ao prestador"
                      camunda:type="external" camunda:topic="operadora.auth.request_documents">
      <bpmn:documentation>Suspensao de prazo durante pendencia (regra RN — DRAFT/verify com regulatorio). Worker dict-first (ADR-0026, del kafka): NAO publica agents.events.auth.pended diretamente — ver ST_PublishAuthPended logo a seguir (T3.1 Wave 1 remedy B, event-gap design doc §2.3).</bpmn:documentation>
      <bpmn:incoming>Flow_GW_Pendencia</bpmn:incoming>
      <bpmn:incoming>Flow_GWDec_SolicitarInfo</bpmn:incoming>
      <bpmn:outgoing>Flow_Solicitar_PubPended</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- T3.1 Wave 1 remedy B (event-gap design doc §2.3; contract SP-OP-AUTH-001.md:60 "produz"
         agents.events.auth.pended na pendencia de documentacao). ST_SolicitarDocumentos e'
         dict-first (ADR-0026) e nao publica; o generico operadora.events.publish fecha o gap
         aqui, mirror byte-a-byte de ST_PublishReceived acima (mesmo padrao event_topic/
         event_payload_vars, boundary-free por convencao 15/16 — check-bpmn-error-allowlist §0.4).
         event_payload_vars so' chaves de negocio (tenant_id, numero_guia_tiss, prestador_id) —
         sem PHI (beneficiario_pseudo_id deliberadamente NAO incluido). Alcancado por AMBOS os
         ramos que levam a ST_SolicitarDocumentos (pendencia inicial + SOLICITAR_INFO do auditor). -->
    <bpmn:serviceTask id="ST_PublishAuthPended" name="Publicar evento: auth.pended"
                      camunda:type="external" camunda:topic="operadora.events.publish">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="event_topic">agents.events.auth.pended</camunda:inputParameter>
          <camunda:inputParameter name="event_payload_vars">tenant_id,numero_guia_tiss,prestador_id</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Solicitar_PubPended</bpmn:incoming>
      <bpmn:outgoing>Flow_PubPended_WaitDocs</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Corrida: documentacao chega OU prazo de pendencia expira -->
    <bpmn:eventBasedGateway id="GW_AguardarDocs" name="Aguardar documentacao">
      <bpmn:incoming>Flow_PubPended_WaitDocs</bpmn:incoming>
      <bpmn:outgoing>Flow_Wait_DocsMsg</bpmn:outgoing>
      <bpmn:outgoing>Flow_Wait_Timer</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="ICE_DocsRecebidos" name="Documentacao recebida">
      <bpmn:incoming>Flow_Wait_DocsMsg</bpmn:incoming>
      <bpmn:outgoing>Flow_DocsOk_Admiss</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_DocsRecebidos" messageRef="Msg_AuthDocsRecebidos"/>
    </bpmn:intermediateCatchEvent>
    <!-- Timer: prestador nao respondeu a pendencia — encerramento e decisao HUMANA -->
    <bpmn:intermediateCatchEvent id="ICE_PrazoPendencia" name="Prazo de pendencia (P5D — DRAFT/verify)">
      <bpmn:incoming>Flow_Wait_Timer</bpmn:incoming>
      <bpmn:outgoing>Flow_PrazoPendencia_UT</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TD_PrazoPendencia">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P5D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="UT_DecidirPendenciaExpirada" name="Decidir destino da guia com pendencia expirada"
                   camunda:candidateGroups="medico-auditor">
      <bpmn:documentation>Conservador (L0 hard): nem o cancelamento administrativo por pendencia e automatizado. Saidas: decisao_pendencia in {cancelar_guia, conceder_prazo_extra, seguir_analise}.</bpmn:documentation>
      <bpmn:incoming>Flow_PrazoPendencia_UT</bpmn:incoming>
      <bpmn:outgoing>Flow_UTPend_GW</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_PendenciaExpirada" name="Decisao pendencia" default="Flow_GWPend_SegueAnalise">
      <bpmn:incoming>Flow_UTPend_GW</bpmn:incoming>
      <bpmn:outgoing>Flow_GWPend_Cancelar</bpmn:outgoing>
      <bpmn:outgoing>Flow_GWPend_PrazoExtra</bpmn:outgoing>
      <bpmn:outgoing>Flow_GWPend_SegueAnalise</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="ST_PublishCancelada" name="Publicar evento: auth.completed (cancelada_pendencia)"
                      camunda:type="external" camunda:topic="operadora.events.publish">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="event_topic">agents.events.auth.completed</camunda:inputParameter>
          <camunda:inputParameter name="event_desfecho">cancelada_pendencia</camunda:inputParameter>
          <camunda:inputParameter name="event_payload_vars">tenant_id,numero_guia_tiss,decisao_pendencia</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_GWPend_Cancelar</bpmn:incoming>
      <bpmn:outgoing>Flow_PubCancelada_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_CanceladaPendencia" name="Cancelada por pendencia (decisao humana)">
      <bpmn:incoming>Flow_PubCancelada_End</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Ramo: segue analise -->
    <bpmn:businessRuleTask id="BRT_SlaAnalise" name="Determinar SLA de analise (DMN auth_sla)"
                           camunda:decisionRef="auth_sla"
                           camunda:mapDecisionResult="singleResult"
                           camunda:resultVariable="sla">
      <bpmn:incoming>Flow_GW_SegueAnalise</bpmn:incoming>
      <bpmn:incoming>Flow_GWPend_SegueAnalise</bpmn:incoming>
      <bpmn:incoming>Flow_GWPend_PrazoExtra</bpmn:incoming>
      <bpmn:outgoing>Flow_Sla_ValidateCriteria</bpmn:outgoing>
    </bpmn:businessRuleTask>

    <!-- GAP-AUTH-4: o worker deterministico roda ANTES de BRT_AutoApproval, exatamente como
         SP-OP-REEMBOLSO-001 roda ST_CalculateAmount antes da sua BRT_AutoApproval
         (GAP-REEMBOLSO-5). Sem esta task, os fatos que a DMN consome chegavam SEMEADOS no
         payload de start e nenhum codigo os verificava na rota automatica. -->
    <bpmn:serviceTask id="ST_ValidateAutoApprovalCriteria" name="Validar criterios de aprovacao automatica (worker deterministico)"
                      camunda:type="external" camunda:topic="operadora.auth.validate_auto_criteria">
      <bpmn:documentation>PORTAO DE CRITERIOS (GAP-AUTH-4). Worker DETERMINISTICO (nunca LLM) que COMPUTA os quatro criterios que BRT_AutoApproval passa a consumir: criterio_tecnico_ok (DMN dut_rol_coverage + a dut_criteria_* do procedimento), criterio_financeiro_ok (CeilingResolver.within_l2_ceiling sobre authorization_approval.max_value_brl), criterio_regulatorio_ok (DMN carencia_check) e criterio_contratual_ok (DMN auth_criteria_contratual). Escreve tambem auto_criteria_verificado=true — PROVA DE EXECUCAO que a regra r1 da DMN exige: pular esta task faz o token cair no catch-all -> ANALISE_HUMANA. Evidencia limitada e nao-PHI em auto_criteria_falhas / auto_criteria_shadow / motivo_bloqueio_criterios. PORTAO DE RATIFICACAO: as tabelas clinicas/regulatorias/contratuais sao SINTETICAS/DRAFT — um criterio so pode contribuir com PASS se sua fonte estiver ratificada em spec/processes/dmn/auth-criteria-ratification.yaml; fonte DRAFT devolve false com *_FONTE_NAO_RATIFICADA independentemente do que a tabela computou, e o que ela TERIA decidido fica registrado em modo SOMBRA para o revisor medico/ANS ratificar contra dados reais. NUNCA nega (L0 hard): todo caminho fail-closed leva a ANALISE_HUMANA. NAO declara boundary de erro, e o worker NUNCA levanta bpmnError (ADR-0030 — um bpmnError nao modelado encerra o escopo em silencio no CIB Seven 2.1.0); falha do proprio validador devolve os quatro criterios false + VALIDADOR_INDISPONIVEL, porque um incidente ESTAGNARIA o pedido de autorizacao, pior para o cuidado que a revisao humana.</bpmn:documentation>
      <bpmn:incoming>Flow_Sla_ValidateCriteria</bpmn:incoming>
      <bpmn:outgoing>Flow_ValidateCriteria_AutoApproval</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:businessRuleTask id="BRT_AutoApproval" name="Avaliar aprovacao automatica (DMN auth_auto_approval)"
                           camunda:decisionRef="auth_auto_approval"
                           camunda:mapDecisionResult="singleResult"
                           camunda:resultVariable="auto_aprovacao">
      <bpmn:documentation>L2 (ADR-0008): so AUTO_APROVAR quando os QUATRO criterios computados por ST_ValidateAutoApprovalCriteria forem true (tecnico, financeiro, regulatorio, contratual) E auto_criteria_verificado for true. Catch-all da DMN = ANALISE_HUMANA (fail-safe). Negativa automatica NAO e saida possivel. carater_atendimento continua como input (hoje "-" na regra r1) para que um SME possa diferenciar urgencia/emergencia sem mudanca de codigo — ADR-0012 mantem a politica de combinacao na DMN. GAP-AUTH-4 (FECHADO ESTRUTURALMENTE): antes, dut_atendida/dentro_teto_l2/rede_credenciada chegavam SEMEADOS NO START e nenhum worker os computava nesta rota; agora nenhum fato semeado alcanca esta BRT — o worker sobrescreve os quatro criterios em TODO caminho, inclusive na degradacao, e a exigencia de auto_criteria_verificado=true e a cerca contra pular o validador. O que permanece ABERTO e' de DADOS, nao de estrutura: as tabelas clinicas/regulatorias/contratuais sao SINTETICAS e NAO ratificadas, e authorization_approval.max_value_brl e 0 (D-07) — logo HOJE nada auto-aprova e todo pedido vai para analise humana, por quatro motivos explicitos e auditaveis. Cada criterio passa a valer sozinho conforme sua fonte for ratificada/populada, sem mudanca de codigo. Contraste/precedente: SP-OP-REEMBOLSO-001 roda o calculo ANTES da sua BRT (GAP-REEMBOLSO-5).</bpmn:documentation>
      <bpmn:incoming>Flow_ValidateCriteria_AutoApproval</bpmn:incoming>
      <bpmn:outgoing>Flow_AutoApproval_GW</bpmn:outgoing>
    </bpmn:businessRuleTask>

    <bpmn:exclusiveGateway id="GW_AutoAprovacao" name="Aprovacao automatica?" default="Flow_GW_AnaliseHumana">
      <bpmn:incoming>Flow_AutoApproval_GW</bpmn:incoming>
      <bpmn:outgoing>Flow_GW_AutoAprovar</bpmn:outgoing>
      <bpmn:outgoing>Flow_GW_AnaliseHumana</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Aprovacao automatica (L2) -->
    <bpmn:serviceTask id="ST_EmitirAutorizacaoAuto" name="Emitir autorizacao (numero de autorizacao na guia TISS)"
                      camunda:type="external" camunda:topic="operadora.auth.issue_authorization">
      <bpmn:documentation>Canal de sancao auto-L2 (item-9): `auto_aprovacao` e' o resultVariable de BRT_AutoApproval (mapDecisionResult=singleResult) — um Map JAVA, entregue ao external task como valor Object NAO desserializado (fetchAndLock: deserializeValues default=false), nunca como objeto estruturado. O worker recebia um opaco e falhava FECHADO (auth_issue_blocked_by_guard) mesmo com a DMN tendo sancionado. O inputParameter abaixo ACHATA a sancao para uma String simples, LOCAL a esta task, avaliada pelo motor a partir da MESMA expressao que Flow_GW_AutoAprovar acabou de avaliar. Espelha ST_IssuePaymentAuto de SP-OP-REEMBOLSO-001 (`valor_reembolso_aprovado_cents = ${calculo.valor_calculado_tabela_cents}`). NAO-SPOOFAVEL: variavel LOCAL da activity — sombreia qualquer homonima de escopo de processo (inclusive semeada no start) e e' reescrita a cada entrada na task a partir de auto_aprovacao, que por sua vez so' existe apos BRT_AutoApproval (unico predecessor de GW_AutoAprovacao).</bpmn:documentation>
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="auto_aprovacao_recomendacao">${auto_aprovacao.recomendacao}</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_GW_AutoAprovar</bpmn:incoming>
      <bpmn:outgoing>Flow_EmitirAuto_Pub</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ST_PublishAprovadaAuto" name="Publicar evento: auth.completed (aprovada_automatica)"
                      camunda:type="external" camunda:topic="operadora.events.publish">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="event_topic">agents.events.auth.completed</camunda:inputParameter>
          <camunda:inputParameter name="event_desfecho">aprovada_automatica</camunda:inputParameter>
          <camunda:inputParameter name="event_payload_vars">tenant_id,numero_guia_tiss,codigo_procedimento_tuss,numero_autorizacao</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_EmitirAuto_Pub</bpmn:incoming>
      <bpmn:outgoing>Flow_PubAuto_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_AprovadaAutomatica" name="Aprovada automaticamente (L2)">
      <bpmn:incoming>Flow_PubAuto_End</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Analise humana: dossie do agente + medico auditor -->
    <bpmn:serviceTask id="ST_PrepararDossie" name="Preparar dossie de analise (agente Rafael)"
                      camunda:type="external" camunda:topic="operadora.auth.analyze_request">
      <bpmn:documentation>Convoca Rafael (ADR-0005): recomendacao estruturada + evidencias + regras DMN avaliadas. O dossie OTIMIZA a decisao humana, nunca a substitui.</bpmn:documentation>
      <bpmn:incoming>Flow_GW_AnaliseHumana</bpmn:incoming>
      <bpmn:outgoing>Flow_Dossie_UTAuditor</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:userTask id="UT_AnaliseMedicoAuditor" name="Analise do medico auditor"
                   camunda:candidateGroups="medico-auditor">
      <bpmn:documentation><![CDATA[
HITL L0 hard (RN 259 / ADR-0005): UNICO ponto onde negativa pode nascer. Saidas:
decisao_auditor in {APROVAR, NEGAR, SOLICITAR_INFO, JUNTA_MEDICA};
NEGAR exige justificativa_clinica, cid10_referencia, fundamentacao_dut e auditor_id (campos
obrigatorios — validacao de formulario + guards do worker send_denial_notice:
ERR_AUTH_DENIAL_INCOMPLETE para a fundamentacao, ERR_DENIAL_NOT_HUMAN para a proveniencia).
SLA: `sla.sla_analise` (DMN auth_sla; RN 259/RN 395 — valores DRAFT/verify).
A decisao sai em nome do medico auditor (auditor_id na trilha de auditoria, ADR-0007 — espelha
analista_id/auditor_id de SP-OP-RECURSO-001 e SP-OP-REEMBOLSO-001).
]]></bpmn:documentation>
      <bpmn:extensionElements>
        <!-- GAP-AUTH-2 (defesa-em-profundidade UX, NAO enforcement): formData estrutura o formulario
             do auditor. `decisao_auditor` e enum (as 4 saidas do contrato) + required (uma decisao
             SEMPRE deve ser tomada). Os 3 campos de fundamentacao clinica + `auditor_id` sao
             declarados aqui para que a Tasklist os apresente; ficam marcados required-if-NEGAR via
             `camunda:properties` (label `requiredIf`). A requiredness CONDICIONAL-por-decisao NAO e
             expressavel em constraints de formData do Camunda (constraint `required` seria
             incondicional e barraria indevidamente APROVAR/SOLICITAR_INFO/JUNTA_MEDICA, que
             compartilham esta UT) — por isso o ENFORCEMENT real permanece nos guards do worker
             send_denial_notice (ERR_AUTH_DENIAL_INCOMPLETE, capturado pelo boundary
             BE_NegativaIncompleta; ERR_DENIAL_NOT_HUMAN para a proveniencia humana). Este formData e
             UX-level; NAO enfraquece o guard do worker (ADR-0018).
             `auditor_id` (ADR-0007, GK-w4): o campo de accountability que a UT humana PRODUZ e o
             guard de proveniencia CONSOME. Sem esta declaracao um cliente Tasklist conforme ao
             modelo submeteria so os 4 campos declarados e a negativa genuinamente humana seria
             bloqueada (ERR_DENIAL_NOT_HUMAN), alem de deixar a variavel start-seedable sem nenhuma
             task modelada que a sobrescreva. Mesmo idioma de SP-OP-RECURSO-001 (analista_id/
             auditor_id) e SP-OP-REEMBOLSO-001 (analista_id|auditor_id): campo de identidade string,
             enforcement no guard do worker. Conteudo clinico dos campos: DRAFT — ver
             docs/review-queue.md. -->
        <camunda:formData>
          <camunda:formField id="decisao_auditor" label="Decisao do auditor" type="enum">
            <camunda:value id="APROVAR" name="Aprovar autorizacao"/>
            <camunda:value id="NEGAR" name="Negar (exige fundamentacao clinica completa)"/>
            <camunda:value id="SOLICITAR_INFO" name="Solicitar informacao/documentacao"/>
            <camunda:value id="JUNTA_MEDICA" name="Encaminhar a junta medica (RN 424)"/>
            <camunda:validation>
              <camunda:constraint name="required"/>
            </camunda:validation>
          </camunda:formField>
          <camunda:formField id="justificativa_clinica" label="Justificativa clinica (obrigatoria se NEGAR)" type="string">
            <camunda:properties>
              <camunda:property name="requiredIf" value="decisao_auditor == NEGAR"/>
              <camunda:property name="enforcedBy" value="worker send_denial_notice guard ERR_AUTH_DENIAL_INCOMPLETE"/>
              <camunda:property name="zona" value="PHI — texto livre clinico (nao difundir na Zona Geral, ADR-0006)"/>
            </camunda:properties>
          </camunda:formField>
          <camunda:formField id="cid10_referencia" label="CID-10 de referencia (obrigatorio se NEGAR)" type="string">
            <camunda:properties>
              <camunda:property name="requiredIf" value="decisao_auditor == NEGAR"/>
              <camunda:property name="enforcedBy" value="worker send_denial_notice guard ERR_AUTH_DENIAL_INCOMPLETE"/>
            </camunda:properties>
          </camunda:formField>
          <camunda:formField id="fundamentacao_dut" label="Fundamentacao na DUT/ROL (obrigatoria se NEGAR)" type="string">
            <camunda:properties>
              <camunda:property name="requiredIf" value="decisao_auditor == NEGAR"/>
              <camunda:property name="enforcedBy" value="worker send_denial_notice guard ERR_AUTH_DENIAL_INCOMPLETE"/>
            </camunda:properties>
          </camunda:formField>
          <camunda:formField id="auditor_id" label="Id do medico auditor responsavel (obrigatorio se NEGAR)" type="string">
            <camunda:properties>
              <camunda:property name="requiredIf" value="decisao_auditor == NEGAR"/>
              <camunda:property name="enforcedBy" value="worker send_denial_notice guard ERR_DENIAL_NOT_HUMAN"/>
              <camunda:property name="adr" value="ADR-0007 — identidade do decisor humano na trilha de auditoria"/>
            </camunda:properties>
          </camunda:formField>
        </camunda:formData>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Dossie_UTAuditor</bpmn:incoming>
      <bpmn:outgoing>Flow_UTAuditor_GW</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Timer nao-interruptivo: alerta de risco de SLA -->
    <bpmn:boundaryEvent id="BT_AlertaSla" name="Alerta de risco de SLA" cancelActivity="false" attachedToRef="UT_AnaliseMedicoAuditor">
      <bpmn:outgoing>Flow_Alerta_Notify</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TD_AlertaSla">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">${sla.sla_alerta}</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="ST_NotificarRiscoSla" name="Notificar risco de SLA (coordenacao)"
                      camunda:type="external" camunda:topic="operadora.auth.notify_sla_risk">
      <bpmn:incoming>Flow_Alerta_Notify</bpmn:incoming>
      <bpmn:outgoing>Flow_Notify_EndAlerta</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_RiscoSlaNotificado" name="Risco de SLA notificado (analise segue)">
      <bpmn:incoming>Flow_Notify_EndAlerta</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Timer interruptivo: SLA estourado -> coordenacao de auditoria assume (continua humano) -->
    <bpmn:boundaryEvent id="BT_SlaAnalise" name="SLA de analise (RN 259 — DRAFT/verify)" cancelActivity="true" attachedToRef="UT_AnaliseMedicoAuditor">
      <bpmn:outgoing>Flow_SlaEstourado_Pub</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TD_SlaAnalise">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">${sla.sla_analise}</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="ST_PublishSlaBreach" name="Publicar evento: auth.sla_breached"
                      camunda:type="external" camunda:topic="operadora.events.publish">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="event_topic">agents.events.auth.sla_breached</camunda:inputParameter>
          <camunda:inputParameter name="event_payload_vars">tenant_id,numero_guia_tiss,carater_atendimento</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_SlaEstourado_Pub</bpmn:incoming>
      <bpmn:outgoing>Flow_PubBreach_UTCoord</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="UT_CoordenacaoAssume" name="Coordenacao de auditoria medica assume"
                   camunda:candidateGroups="coordenacao-auditoria-medica">
      <bpmn:documentation>Escalation path do SLA: caso reatribuido. Mesmas saidas e mesmos campos obrigatorios da analise do auditor (continua decisao medica humana) — inclusive auditor_id, a identidade do decisor humano na trilha de auditoria (ADR-0007).</bpmn:documentation>
      <!-- GAP-AUTH-3 (M2a): formData estrutural identico ao de UT_AnaliseMedicoAuditor —
           coordenacao produz as mesmas saidas contratuais (decisao_auditor, justificativa_clinica,
           cid10_referencia, fundamentacao_dut, auditor_id). Enforcement real nos guards do worker
           (ADR-0018): ERR_AUTH_DENIAL_INCOMPLETE (fundamentacao) e ERR_DENIAL_NOT_HUMAN
           (proveniencia via auditor_id, ADR-0007 — GK-w4). -->
      <bpmn:extensionElements>
        <camunda:formData>
          <camunda:formField id="decisao_auditor" label="Decisao do auditor" type="enum">
            <camunda:value id="APROVAR" name="Aprovar autorizacao"/>
            <camunda:value id="NEGAR" name="Negar (exige fundamentacao clinica completa)"/>
            <camunda:value id="SOLICITAR_INFO" name="Solicitar informacao/documentacao"/>
            <camunda:value id="JUNTA_MEDICA" name="Encaminhar a junta medica (RN 424)"/>
            <camunda:validation>
              <camunda:constraint name="required"/>
            </camunda:validation>
          </camunda:formField>
          <camunda:formField id="justificativa_clinica" label="Justificativa clinica (obrigatoria se NEGAR)" type="string">
            <camunda:properties>
              <camunda:property name="requiredIf" value="decisao_auditor == NEGAR"/>
              <camunda:property name="enforcedBy" value="worker send_denial_notice guard ERR_AUTH_DENIAL_INCOMPLETE"/>
              <camunda:property name="zona" value="PHI — texto livre clinico (nao difundir na Zona Geral, ADR-0006)"/>
            </camunda:properties>
          </camunda:formField>
          <camunda:formField id="cid10_referencia" label="CID-10 de referencia (obrigatorio se NEGAR)" type="string">
            <camunda:properties>
              <camunda:property name="requiredIf" value="decisao_auditor == NEGAR"/>
              <camunda:property name="enforcedBy" value="worker send_denial_notice guard ERR_AUTH_DENIAL_INCOMPLETE"/>
            </camunda:properties>
          </camunda:formField>
          <camunda:formField id="fundamentacao_dut" label="Fundamentacao na DUT/ROL (obrigatoria se NEGAR)" type="string">
            <camunda:properties>
              <camunda:property name="requiredIf" value="decisao_auditor == NEGAR"/>
              <camunda:property name="enforcedBy" value="worker send_denial_notice guard ERR_AUTH_DENIAL_INCOMPLETE"/>
            </camunda:properties>
          </camunda:formField>
          <camunda:formField id="auditor_id" label="Id do medico auditor responsavel (obrigatorio se NEGAR)" type="string">
            <camunda:properties>
              <camunda:property name="requiredIf" value="decisao_auditor == NEGAR"/>
              <camunda:property name="enforcedBy" value="worker send_denial_notice guard ERR_DENIAL_NOT_HUMAN"/>
              <camunda:property name="adr" value="ADR-0007 — identidade do decisor humano na trilha de auditoria"/>
            </camunda:properties>
          </camunda:formField>
        </camunda:formData>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_PubBreach_UTCoord</bpmn:incoming>
      <bpmn:outgoing>Flow_UTCoord_GW</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="GW_DecisaoAuditor" name="Decisao do auditor" default="Flow_GWDec_Invalida">
      <bpmn:incoming>Flow_UTAuditor_GW</bpmn:incoming>
      <bpmn:incoming>Flow_UTCoord_GW</bpmn:incoming>
      <bpmn:incoming>Flow_Junta_GWDec</bpmn:incoming>
      <bpmn:outgoing>Flow_GWDec_Aprovar</bpmn:outgoing>
      <bpmn:outgoing>Flow_GWDec_Negar</bpmn:outgoing>
      <bpmn:outgoing>Flow_GWDec_SolicitarInfo</bpmn:outgoing>
      <bpmn:outgoing>Flow_GWDec_Junta</bpmn:outgoing>
      <bpmn:outgoing>Flow_GWDec_Invalida</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Aprovada pelo auditor -->
    <bpmn:serviceTask id="ST_EmitirAutorizacaoAuditor" name="Emitir autorizacao (decisao do auditor)"
                      camunda:type="external" camunda:topic="operadora.auth.issue_authorization">
      <bpmn:incoming>Flow_GWDec_Aprovar</bpmn:incoming>
      <bpmn:outgoing>Flow_EmitirAuditor_Pub</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ST_PublishAprovadaAuditor" name="Publicar evento: auth.completed (aprovada_auditor)"
                      camunda:type="external" camunda:topic="operadora.events.publish">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="event_topic">agents.events.auth.completed</camunda:inputParameter>
          <camunda:inputParameter name="event_desfecho">aprovada_auditor</camunda:inputParameter>
          <camunda:inputParameter name="event_payload_vars">tenant_id,numero_guia_tiss,numero_autorizacao</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_EmitirAuditor_Pub</bpmn:incoming>
      <bpmn:outgoing>Flow_PubAuditor_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_AprovadaAuditor" name="Aprovada pelo medico auditor">
      <bpmn:incoming>Flow_PubAuditor_End</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Negada pelo auditor (UNICA origem possivel de negativa) -->
    <bpmn:serviceTask id="ST_EnviarNegativaFormal" name="Enviar negativa formal por escrito"
                      camunda:type="external" camunda:topic="operadora.auth.send_denial_notice">
      <bpmn:documentation>COMPOE o registro da negativa por escrito com justificativa clinica, em nome do medico auditor (RN 395 art. 10 — prazo de 24h para negativa por escrito: DRAFT/verify), e devolve-o com o conteudo clinico REDIGIDO (ADR-0006) ao escopo do processo. Inclui orientacao de recurso/junta (RN 424 — DRAFT/verify). AUTH-SEND-DENIAL-NOTICE-STATUS-LITERAL: o worker send_denial_notice e SINCRONO e nao abre canal nenhum — ele NAO transmite a negativa ao beneficiario/prestador e NAO afirma mais um status de envio; o canal seguro real e de Fase 1. O fato agents.events.auth.completed (desfecho negada_auditor) e publicado adiante por ST_PublishNegada, no unico fluxo de saida desta task (Flow_Negativa_Pub).</bpmn:documentation>
      <bpmn:incoming>Flow_GWDec_Negar</bpmn:incoming>
      <bpmn:outgoing>Flow_Negativa_Pub</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- GAP-AUTH-2 (defesa-em-profundidade): boundary error na transmissao da negativa formal.
         Se send_denial_notice recusar por fundamentacao INCOMPLETA (guard L0 auth.py: qualquer de
         justificativa_clinica / cid10_referencia / fundamentacao_dut ausente), lanca
         ERR_AUTH_DENIAL_INCOMPLETE. Antes: incidente NAO tratado travava a instancia neste service
         task. Agora: captura -> End_FundamentacaoIncompletaBloqueada. Terminal NEUTRO: a NEGATIVA
         NAO foi transmitida (nada adverso ocorreu ao beneficiario) — apenas um bloqueio limpo que
         exige o auditor humano completar a fundamentacao. So alcancavel APOS UT humana (medico
         auditor / coordenacao / junta) ter decidido NEGAR; nao abre caminho automatico de negativa.
         O guard do worker PERMANECE o enforcement (ADR-0018); este catch so evita o incidente travado. -->
    <bpmn:boundaryEvent id="BE_NegativaIncompleta" name="Negativa barrada por fundamentacao incompleta (ERR_AUTH_DENIAL_INCOMPLETE)" attachedToRef="ST_EnviarNegativaFormal">
      <bpmn:outgoing>Flow_NegativaIncompleta_End</bpmn:outgoing>
      <bpmn:errorEventDefinition id="EED_NegativaIncompleta" errorRef="Error_AuthDenialIncompleta"/>
    </bpmn:boundaryEvent>
    <bpmn:endEvent id="End_FundamentacaoIncompletaBloqueada" name="Negativa formal barrada por fundamentacao incompleta (guard L0) — nada transmitido">
      <bpmn:documentation>Terminal NEUTRO (guard L0, authorization_denial): o worker send_denial_notice RECUSOU transmitir a negativa formal por faltar fundamentacao obrigatoria (justificativa_clinica / cid10_referencia / fundamentacao_dut) — ERR_AUTH_DENIAL_INCOMPLETE. NENHUM efeito adverso ocorreu: a negativa NAO foi enviada ao beneficiario. So alcancavel APOS uma User Task humana (UT_AnaliseMedicoAuditor / UT_CoordenacaoAssume / UT_RegistrarParecerJunta) ter decidido NEGAR — nao ha caminho automatizado. O guard do worker permanece o mecanismo de enforcement (ADR-0018); este terminal apenas encerra a instancia de forma limpa (em vez de incidente travado) para o auditor humano recompor a fundamentacao completa.</bpmn:documentation>
      <bpmn:incoming>Flow_NegativaIncompleta_End</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:serviceTask id="ST_PublishNegada" name="Publicar evento: auth.completed (negada_auditor)"
                      camunda:type="external" camunda:topic="operadora.events.publish">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="event_topic">agents.events.auth.completed</camunda:inputParameter>
          <camunda:inputParameter name="event_desfecho">negada_auditor</camunda:inputParameter>
          <!-- GAP-AUTH-1 (ADR-0006): o fato auth.completed NUNCA carrega PHI. A justificativa
               clinica e' texto livre clinico (Zona PHI) e nao pode ser difundida na Zona Geral.
               Carregamos apenas identificadores estruturais; o `_business_key`
               (AUTH-{tenant_id}-{numero_guia_tiss}), injetado pelo worker operadora.events.publish,
               e' o payload_ref pelo qual um consumidor da Zona PHI resolve o conteudo clinico no
               engine/store. Espelha a2a/facts.py ("O fato NUNCA carrega PHI"). O caminho de
               negativa formal (ST_EnviarNegativaFormal / send_denial_notice) permanece inalterado:
               a justificativa clinica segue nele, dentro da Zona PHI. -->
          <camunda:inputParameter name="event_payload_vars">tenant_id,numero_guia_tiss</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Negativa_Pub</bpmn:incoming>
      <bpmn:outgoing>Flow_PubNegada_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_NegadaAuditor" name="Negada pelo medico auditor (L0)">
      <bpmn:incoming>Flow_PubNegada_End</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Junta medica (RN 424 — DRAFT) -->
    <bpmn:serviceTask id="ST_ConvocarJunta" name="Convocar junta medica (RN 424)"
                      camunda:type="external" camunda:topic="operadora.auth.convene_junta">
      <bpmn:incoming>Flow_GWDec_Junta</bpmn:incoming>
      <bpmn:outgoing>Flow_Convocar_UTJunta</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="UT_RegistrarParecerJunta" name="Registrar parecer da junta medica"
                   camunda:candidateGroups="junta-medica">
      <bpmn:documentation>DRAFT — fluxo de junta simplificado; detalhar com juridico/regulatorio (prazos e desempate RN 424). Saida: decisao_auditor in {APROVAR, NEGAR} (parecer vinculante) + auditor_id, a identidade do medico relator do parecer na trilha de auditoria (ADR-0007).</bpmn:documentation>
      <!-- GAP-AUTH-3 (M2a): formData estrutural para junta medica. decisao_auditor restrito a
           {APROVAR, NEGAR} (parecer vinculante, sem SOLICITAR_INFO nem JUNTA_MEDICA recursiva).
           Se NEGAR, exige justificativa_clinica, cid10_referencia, fundamentacao_dut e auditor_id
           (este ultimo e a proveniencia humana que o guard ERR_DENIAL_NOT_HUMAN consome — GK-w4;
           uma junta-NEGAR sem auditor_id nao seria transmitida). -->
      <bpmn:extensionElements>
        <camunda:formData>
          <camunda:formField id="decisao_auditor" label="Parecer da junta medica" type="enum">
            <camunda:value id="APROVAR" name="Aprovar autorizacao (parecer vinculante)"/>
            <camunda:value id="NEGAR" name="Negar (exige fundamentacao clinica completa)"/>
            <camunda:validation>
              <camunda:constraint name="required"/>
            </camunda:validation>
          </camunda:formField>
          <camunda:formField id="justificativa_clinica" label="Justificativa clinica (obrigatoria se NEGAR)" type="string">
            <camunda:properties>
              <camunda:property name="requiredIf" value="decisao_auditor == NEGAR"/>
              <camunda:property name="enforcedBy" value="worker send_denial_notice guard ERR_AUTH_DENIAL_INCOMPLETE"/>
              <camunda:property name="zona" value="PHI — texto livre clinico (nao difundir na Zona Geral, ADR-0006)"/>
            </camunda:properties>
          </camunda:formField>
          <camunda:formField id="cid10_referencia" label="CID-10 de referencia (obrigatorio se NEGAR)" type="string">
            <camunda:properties>
              <camunda:property name="requiredIf" value="decisao_auditor == NEGAR"/>
              <camunda:property name="enforcedBy" value="worker send_denial_notice guard ERR_AUTH_DENIAL_INCOMPLETE"/>
            </camunda:properties>
          </camunda:formField>
          <camunda:formField id="fundamentacao_dut" label="Fundamentacao na DUT/ROL (obrigatoria se NEGAR)" type="string">
            <camunda:properties>
              <camunda:property name="requiredIf" value="decisao_auditor == NEGAR"/>
              <camunda:property name="enforcedBy" value="worker send_denial_notice guard ERR_AUTH_DENIAL_INCOMPLETE"/>
            </camunda:properties>
          </camunda:formField>
          <camunda:formField id="auditor_id" label="Id do medico auditor responsavel (obrigatorio se NEGAR)" type="string">
            <camunda:properties>
              <camunda:property name="requiredIf" value="decisao_auditor == NEGAR"/>
              <camunda:property name="enforcedBy" value="worker send_denial_notice guard ERR_DENIAL_NOT_HUMAN"/>
              <camunda:property name="adr" value="ADR-0007 — identidade do decisor humano (relator do parecer) na trilha de auditoria"/>
            </camunda:properties>
          </camunda:formField>
        </camunda:formData>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Convocar_UTJunta</bpmn:incoming>
      <bpmn:outgoing>Flow_Junta_GWDec</bpmn:outgoing>
    </bpmn:userTask>

    <!-- GAP-AUTH-3 (fail-safe, M2a): GW_DecisaoAuditor default roteado para terminal de erro.
         Se decisao_auditor chegar ausente/corrompida (nao bate nenhum dos 4 valores explicitos:
         APROVAR, NEGAR, SOLICITAR_INFO, JUNTA_MEDICA), o processo termina em incidente tecnico
         (ERR_AUTH_DECISION_INVALID) — NUNCA aprova por omissao. Espelha padrao fail-closed
         LGPD-DSR End_ErrDecisaoInvalida (GAP-LGPD-4). -->
    <bpmn:endEvent id="End_ErrDecisaoInvalida" name="Erro: decisao do auditor ausente ou desconhecida (ERR_AUTH_DECISION_INVALID)">
      <bpmn:documentation>Fail-closed (GAP-AUTH-3, ADR-0005): decisao_auditor fora de {APROVAR, NEGAR, SOLICITAR_INFO, JUNTA_MEDICA} (incluindo ausente/em branco) NUNCA aprova por omissao — incidente tecnico/operacional que exige correcao humana. Nenhuma autorizacao foi emitida; nenhuma negativa foi enviada.</bpmn:documentation>
      <bpmn:errorEventDefinition id="EED_AuthDecisaoInvalida" errorRef="Error_AuthDecisaoInvalida"/>
    </bpmn:endEvent>

    <!-- FLOWS -->
    <bpmn:sequenceFlow id="Flow_Start_PubReceived" sourceRef="Start_SolicitacaoRecebida" targetRef="ST_PublishReceived"/>
    <bpmn:sequenceFlow id="Flow_PubReceived_Admiss" sourceRef="ST_PublishReceived" targetRef="BRT_Admissibilidade"/>
    <bpmn:sequenceFlow id="Flow_Admiss_GW" sourceRef="BRT_Admissibilidade" targetRef="GW_Admissibilidade"/>
    <bpmn:sequenceFlow id="Flow_GW_NaoRequer" name="NAO_REQUER" sourceRef="GW_Admissibilidade" targetRef="ST_PublishNaoRequer">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${admissibilidade.resultado == 'NAO_REQUER'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_PubNaoRequer_End" sourceRef="ST_PublishNaoRequer" targetRef="End_NaoRequerAutorizacao"/>
    <bpmn:sequenceFlow id="Flow_GW_Pendencia" name="PENDENTE_DOCUMENTACAO" sourceRef="GW_Admissibilidade" targetRef="ST_SolicitarDocumentos">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${admissibilidade.resultado == 'PENDENTE_DOCUMENTACAO'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_GW_SegueAnalise" name="SEGUE_ANALISE (default)" sourceRef="GW_Admissibilidade" targetRef="BRT_SlaAnalise"/>
    <bpmn:sequenceFlow id="Flow_Solicitar_PubPended" sourceRef="ST_SolicitarDocumentos" targetRef="ST_PublishAuthPended"/>
    <bpmn:sequenceFlow id="Flow_PubPended_WaitDocs" sourceRef="ST_PublishAuthPended" targetRef="GW_AguardarDocs"/>
    <bpmn:sequenceFlow id="Flow_Wait_DocsMsg" sourceRef="GW_AguardarDocs" targetRef="ICE_DocsRecebidos"/>
    <bpmn:sequenceFlow id="Flow_Wait_Timer" sourceRef="GW_AguardarDocs" targetRef="ICE_PrazoPendencia"/>
    <bpmn:sequenceFlow id="Flow_DocsOk_Admiss" sourceRef="ICE_DocsRecebidos" targetRef="BRT_Admissibilidade"/>
    <bpmn:sequenceFlow id="Flow_PrazoPendencia_UT" sourceRef="ICE_PrazoPendencia" targetRef="UT_DecidirPendenciaExpirada"/>
    <bpmn:sequenceFlow id="Flow_UTPend_GW" sourceRef="UT_DecidirPendenciaExpirada" targetRef="GW_PendenciaExpirada"/>
    <bpmn:sequenceFlow id="Flow_GWPend_Cancelar" name="cancelar_guia" sourceRef="GW_PendenciaExpirada" targetRef="ST_PublishCancelada">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${decisao_pendencia == 'cancelar_guia'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_GWPend_PrazoExtra" name="conceder_prazo_extra" sourceRef="GW_PendenciaExpirada" targetRef="BRT_SlaAnalise">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${decisao_pendencia == 'conceder_prazo_extra'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_GWPend_SegueAnalise" name="seguir_analise (default)" sourceRef="GW_PendenciaExpirada" targetRef="BRT_SlaAnalise"/>
    <bpmn:sequenceFlow id="Flow_PubCancelada_End" sourceRef="ST_PublishCancelada" targetRef="End_CanceladaPendencia"/>
    <!-- GAP-AUTH-4: BRT_SlaAnalise -> ST_ValidateAutoApprovalCriteria -> BRT_AutoApproval. O
         worker computa os criterios ANTES da BRT que os consome (precedente GAP-REEMBOLSO-5:
         Flow_BRTCalc_Calc / Flow_Calc_AutoApproval em SP-OP-REEMBOLSO-001). -->
    <bpmn:sequenceFlow id="Flow_Sla_ValidateCriteria" sourceRef="BRT_SlaAnalise" targetRef="ST_ValidateAutoApprovalCriteria"/>
    <bpmn:sequenceFlow id="Flow_ValidateCriteria_AutoApproval" sourceRef="ST_ValidateAutoApprovalCriteria" targetRef="BRT_AutoApproval"/>
    <bpmn:sequenceFlow id="Flow_AutoApproval_GW" sourceRef="BRT_AutoApproval" targetRef="GW_AutoAprovacao"/>
    <bpmn:sequenceFlow id="Flow_GW_AutoAprovar" name="AUTO_APROVAR (L2)" sourceRef="GW_AutoAprovacao" targetRef="ST_EmitirAutorizacaoAuto">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${auto_aprovacao.recomendacao == 'AUTO_APROVAR'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_GW_AnaliseHumana" name="ANALISE_HUMANA (default)" sourceRef="GW_AutoAprovacao" targetRef="ST_PrepararDossie"/>
    <bpmn:sequenceFlow id="Flow_EmitirAuto_Pub" sourceRef="ST_EmitirAutorizacaoAuto" targetRef="ST_PublishAprovadaAuto"/>
    <bpmn:sequenceFlow id="Flow_PubAuto_End" sourceRef="ST_PublishAprovadaAuto" targetRef="End_AprovadaAutomatica"/>
    <bpmn:sequenceFlow id="Flow_Dossie_UTAuditor" sourceRef="ST_PrepararDossie" targetRef="UT_AnaliseMedicoAuditor"/>
    <bpmn:sequenceFlow id="Flow_Alerta_Notify" sourceRef="BT_AlertaSla" targetRef="ST_NotificarRiscoSla"/>
    <bpmn:sequenceFlow id="Flow_Notify_EndAlerta" sourceRef="ST_NotificarRiscoSla" targetRef="End_RiscoSlaNotificado"/>
    <bpmn:sequenceFlow id="Flow_SlaEstourado_Pub" sourceRef="BT_SlaAnalise" targetRef="ST_PublishSlaBreach"/>
    <bpmn:sequenceFlow id="Flow_PubBreach_UTCoord" sourceRef="ST_PublishSlaBreach" targetRef="UT_CoordenacaoAssume"/>
    <bpmn:sequenceFlow id="Flow_UTAuditor_GW" sourceRef="UT_AnaliseMedicoAuditor" targetRef="GW_DecisaoAuditor"/>
    <bpmn:sequenceFlow id="Flow_UTCoord_GW" sourceRef="UT_CoordenacaoAssume" targetRef="GW_DecisaoAuditor"/>
    <!-- ENGINE-09005 fix (T1.3 artifact-repair): esta flow nao e' o default do gateway
         (default="Flow_GWDec_Invalida", GAP-AUTH-3 fail-closed) e por isso PRECISA de
         conditionExpression propria — espelha o padrao das flows-irma (Negar/SolicitarInfo/
         Junta) e o vocabulario do contrato (docs/processes/contracts/SP-OP-AUTH-001.md:
         decisao_auditor in {APROVAR,NEGAR,SOLICITAR_INFO,JUNTA_MEDICA}). O v1 donor tinha
         esta flow como default do gateway (implicitamente sem condicao); v2 endureceu o
         default para o terminal de erro fail-closed e este fix so completa essa mudanca -
         NAO reverte o endurecimento. -->
    <bpmn:sequenceFlow id="Flow_GWDec_Aprovar" name="APROVAR" sourceRef="GW_DecisaoAuditor" targetRef="ST_EmitirAutorizacaoAuditor">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${decisao_auditor == 'APROVAR'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_GWDec_Negar" name="NEGAR (somente humano)" sourceRef="GW_DecisaoAuditor" targetRef="ST_EnviarNegativaFormal">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${decisao_auditor == 'NEGAR'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_GWDec_SolicitarInfo" name="SOLICITAR_INFO" sourceRef="GW_DecisaoAuditor" targetRef="ST_SolicitarDocumentos">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${decisao_auditor == 'SOLICITAR_INFO'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_GWDec_Junta" name="JUNTA_MEDICA" sourceRef="GW_DecisaoAuditor" targetRef="ST_ConvocarJunta">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${decisao_auditor == 'JUNTA_MEDICA'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_EmitirAuditor_Pub" sourceRef="ST_EmitirAutorizacaoAuditor" targetRef="ST_PublishAprovadaAuditor"/>
    <bpmn:sequenceFlow id="Flow_PubAuditor_End" sourceRef="ST_PublishAprovadaAuditor" targetRef="End_AprovadaAuditor"/>
    <bpmn:sequenceFlow id="Flow_Negativa_Pub" sourceRef="ST_EnviarNegativaFormal" targetRef="ST_PublishNegada"/>
    <bpmn:sequenceFlow id="Flow_NegativaIncompleta_End" sourceRef="BE_NegativaIncompleta" targetRef="End_FundamentacaoIncompletaBloqueada"/>
    <bpmn:sequenceFlow id="Flow_PubNegada_End" sourceRef="ST_PublishNegada" targetRef="End_NegadaAuditor"/>
    <bpmn:sequenceFlow id="Flow_Convocar_UTJunta" sourceRef="ST_ConvocarJunta" targetRef="UT_RegistrarParecerJunta"/>
    <bpmn:sequenceFlow id="Flow_Junta_GWDec" sourceRef="UT_RegistrarParecerJunta" targetRef="GW_DecisaoAuditor"/>
    <!-- GAP-AUTH-3 (M2a): default do GW_DecisaoAuditor — decisao_auditor invalida/ausente → terminal de erro -->
    <bpmn:sequenceFlow id="Flow_GWDec_Invalida" name="invalida/ausente (default → ERR_AUTH_DECISION_INVALID)" sourceRef="GW_DecisaoAuditor" targetRef="End_ErrDecisaoInvalida"/>
  </bpmn:process>

