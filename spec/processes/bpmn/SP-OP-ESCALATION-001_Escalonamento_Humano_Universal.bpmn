        <dc:Bounds x="272" y="302" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_BE_NotifFallbackFailed" bpmnElement="BE_NotifFallbackFailed">
        <dc:Bounds x="572" y="462" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_BE_PubAckBreachFailed" bpmnElement="BE_PubAckBreachFailed">
        <dc:Bounds x="732" y="582" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_BE_NotifSupervisorFailed" bpmnElement="BE_NotifSupervisorFailed">
        <dc:Bounds x="882" y="582" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_BE_PubResolBreachFailed" bpmnElement="BE_PubResolBreachFailed">
