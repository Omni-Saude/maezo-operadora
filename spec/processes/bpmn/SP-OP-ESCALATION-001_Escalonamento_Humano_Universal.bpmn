        <di:waypoint x="750" y="178"/><di:waypoint x="750" y="200"/><di:waypoint x="900" y="200"/><di:waypoint x="900" y="160"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_BEPubResolved_GW" bpmnElement="Flow_BEPubResolved_GW">
        <di:waypoint x="910" y="338"/><di:waypoint x="910" y="360"/><di:waypoint x="1040" y="360"/><di:waypoint x="1040" y="305"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_BEPubProcessCompleted_End" bpmnElement="Flow_BEPubProcessCompleted_End">
        <di:waypoint x="1170" y="478"/><di:waypoint x="1170" y="500"/><di:waypoint x="1290" y="500"/><di:waypoint x="1290" y="438"/>
      </bpmndi:BPMNEdge>
