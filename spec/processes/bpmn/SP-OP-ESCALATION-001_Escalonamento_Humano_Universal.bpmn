      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="Edge_Start_PubReq" bpmnElement="Flow_Start_PubReq">
        <di:waypoint x="188" y="280"/><di:waypoint x="240" y="280"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_PubReq_Rotear" bpmnElement="Flow_PubReq_Rotear">
