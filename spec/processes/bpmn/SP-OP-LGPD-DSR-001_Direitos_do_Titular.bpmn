<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_SP_OP_LGPD_DSR_001"
                  targetNamespace="http://maezo.health/operadora/lgpd"
                  exporter="Maezo W5-PROC"
                  exporterVersion="0.1.0-draft">

  <bpmn:message id="Msg_LgpdProvaRecebida" name="msg.lgpd.proof_received"/>
  <bpmn:error id="Error_LgpdIdentidade" name="Identidade do titular nao verificavel" errorCode="ERR_DSR_IDENTITY_UNVERIFIED"/>
  <!-- GAP-LGPD-2: erasure aprovada nao pode ser executada com seguranca (cascata ausente OU resolucao
       titular_pseudo_id->fhir_patient_id falhou). FALHA FECHADO: sem catch declarado, ST_ExecutarRequisicao
       vira incidente e a instancia NAO avanca a ST_EnviarResposta — a resposta jamais afirma uma erasure
       que nao ocorreu. Espelha Error_LgpdIdentidade (declarado, tratado como incidente). -->
  <bpmn:error id="Error_LgpdErasureFalhou" name="Erasure aprovada nao executavel com seguranca" errorCode="ERR_DSR_ERASURE_FAILED"/>
  <!-- Defesa em profundidade: a erasure (efeito adverso, ADR-0005) foi alcancada sem a decisao humana
       EXECUTAR_E_ENVIAR. So possivel via BPMN mal-configurada; espelha o padrao ERR_*_NOT_HUMAN. -->
  <bpmn:error id="Error_LgpdErasureNaoHumana" name="Erasure sem decisao humana EXECUTAR_E_ENVIAR" errorCode="ERR_DSR_ERASURE_NOT_HUMAN"/>
  <bpmn:error id="Error_LgpdDecisaoInvalida" name="Decisao do revisor ausente ou desconhecida" errorCode="ERR_DSR_DECISION_INVALID"/>
  <bpmn:error id="Error_LgpdFundamentacaoAusente" name="Negativa fundamentada sem fundamentacao_legal" errorCode="ERR_DSR_FUNDAMENTACAO_AUSENTE"/>

  <bpmn:process id="SP-OP-LGPD-DSR-001" name="SP-OP-LGPD-DSR-001 Direitos do Titular (LGPD)"
                isExecutable="true" camunda:historyTimeToLive="1825">
    <bpmn:documentation><![CDATA[
SP-OP-LGPD-DSR-001 — Direitos do titular de dados. Status: DRAFT (v0.1.0) — Phase 1.
DI (diagrama) sera adicionado na promocao a FINAL. Requer revisao do DPO/juridico antes
de qualquer deploy — ver docs/review-queue.md.

GATILHO REGULATORIO: LGPD (Lei 13.709/2018) art. 18 (direitos do titular) e art. 19, II
(declaracao completa em ate 15 dias). Dados de saude = dados sensiveis (art. 5, II;
art. 11): TODA liberacao/eliminacao/retificacao passa por revisao humana (DPO ou
juridico-privacidade) — nenhuma resposta com dados sensiveis sai automatizada.
Retencao legal pode impedir eliminacao (prontuario: CFM/Lei 13.787/2018 — DRAFT/verify;
regulatorio ANS 5+ anos — DRAFT/verify): negativa fundamentada e decisao humana.

BUSINESS KEY (idempotente): "DSR-{tenant_id}-{titular_pseudo_id}-{tipo_requisicao}-{data_solicitacao_iso}"
  — uma instancia por titular/tipo/dia; re-pedido no mesmo dia retorna a instancia ativa.

EVENTOS DE DOMINIO (worker operadora.events.publish):
  inicio -> agents.events.lgpd_dsr.received
  breach -> agents.events.lgpd_dsr.sla_breached
  fim    -> agents.events.lgpd_dsr.completed (payload.desfecho = atendida |
            negada_fundamentada | expirada_identidade | identidade_inverificavel)

SLA GLOBAL: event subprocess nao-interruptivo com timer P15D contado do INICIO da
instancia (LGPD art. 19, II) — alerta juridico + evento sla_breached; o caso segue
aberto (a obrigacao legal nao desaparece com o estouro).

VARIAVEIS DE ENTRADA: tenant_id, titular_pseudo_id (ADR-0006 — Zona Geral), canal,
tipo_requisicao (confirmacao_acesso | correcao | eliminacao | portabilidade |
info_compartilhamento | revogacao_consentimento), detalhes_requisicao,
data_solicitacao_iso. Contrato: docs/processes/contracts/SP-OP-LGPD-DSR-001.md.
]]></bpmn:documentation>

    <bpmn:startEvent id="Start_RequisicaoTitular" name="Requisicao do titular recebida">
      <bpmn:outgoing>Flow_Start_PubReceived</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:serviceTask id="ST_PublishReceived" name="Publicar evento: lgpd_dsr.received"
                      camunda:type="external" camunda:topic="operadora.events.publish">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="event_topic">agents.events.lgpd_dsr.received</camunda:inputParameter>
          <camunda:inputParameter name="event_payload_vars">tenant_id,titular_pseudo_id,tipo_requisicao,canal,data_solicitacao_iso</camunda:inputParameter>
          <!-- Inicializa decisao_dsr="" e fundamentacao_legal="" (variaveis humanas, so setadas de
               fato por UT_RevisaoDpo) na PRIMEIRA service task de TODO caminho, antes de qualquer
               gateway referencia-las. Garante que ${decisao_dsr ...} em GW_DecisaoDsr e
               ${fundamentacao_legal ...} em GW_GuardFundamentacao sejam SEMPRE resolviveis no
               engine (CIB Seven 2.1.0 lanca "Cannot resolve identifier" mesmo dentro de checks
               null-safe — ENGINE-16004; espelha o idioma de desfecho_humano em SP-OP-RECURSO-001).
               O humano sobrescreve na UT; o default "" preserva o fail-closed do gateway intacto
               (GAP-LGPD-3/GAP-LGPD-4). -->
          <camunda:outputParameter name="decisao_dsr">${""}</camunda:outputParameter>
          <camunda:outputParameter name="fundamentacao_legal">${""}</camunda:outputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Start_PubReceived</bpmn:incoming>
      <bpmn:outgoing>Flow_PubReceived_Verify</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="ST_VerificarIdentidade" name="Verificar identidade do titular"
                      camunda:type="external" camunda:topic="operadora.lgpd.verify_identity">
      <bpmn:documentation>Anti-vazamento: requisicao LGPD e vetor classico de engenharia social. Saida: identidade_confirmada (boolean).</bpmn:documentation>
      <bpmn:incoming>Flow_PubReceived_Verify</bpmn:incoming>
      <bpmn:incoming>Flow_ProvaOk_Verify</bpmn:incoming>
      <bpmn:outgoing>Flow_Verify_GW</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- GAP-LGPD-6 (dangling-catch fix, verifier finding #136): Error_LgpdIdentidade (declarado
         bpmn:14) era lancado por lgpd.py (guard estrutural: sem titular_pseudo_id nao ha sujeito a
         verificar) mas NAO tinha catch — erro nao-capturado no PRIMEIRO touchpoint da mainline
         encerraria o escopo SILENCIOSAMENTE (mesma classe TECNICA de defeito-de-origem de
         End_RecursoGlosaInvalidaOrigem/End_CredPrestadorInvalido/End_ReembolsoProtocoloInvalido —
         o worker RECUSA prosseguir por impossibilidade MECANICA, nao decide merito; NUNCA uma
         acusacao automatica de fraude, L0 hard fraud_accusation). Terminal VISIVEL + evento
         publicado (mais conservador que o precedente RECURSO/CRED/REEMBOLSO, que so terminam sem
         publicar): DPO/juridico-privacidade acompanham `lgpd_dsr.completed` e podem investigar
         manualmente um `desfecho=identidade_inverificavel` (human review is the safe route — nunca
         drop silencioso, nunca prosa de negativa automatica). Tratamento nuanced (fraude evidente
         de identidade) permanece pendente para a promocao a FINAL (contrato §Codigos de erro). -->
    <bpmn:boundaryEvent id="BE_IdentidadeInverificavel" name="Identidade inverificavel (ERR_DSR_IDENTITY_UNVERIFIED)" attachedToRef="ST_VerificarIdentidade">
      <bpmn:outgoing>Flow_IdentInverif_Pub</bpmn:outgoing>
      <bpmn:errorEventDefinition id="EED_IdentidadeInverificavel" errorRef="Error_LgpdIdentidade"/>
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="ST_PublishIdentidadeInverificavel" name="Publicar evento: lgpd_dsr.completed (identidade_inverificavel)"
                      camunda:type="external" camunda:topic="operadora.events.publish">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="event_topic">agents.events.lgpd_dsr.completed</camunda:inputParameter>
          <camunda:inputParameter name="event_desfecho">identidade_inverificavel</camunda:inputParameter>
          <camunda:inputParameter name="event_payload_vars">tenant_id,titular_pseudo_id,tipo_requisicao</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_IdentInverif_Pub</bpmn:incoming>
      <bpmn:outgoing>Flow_PubIdentInverif_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_IdentidadeInverificavel" name="Identidade do titular inverificavel — sem sujeito identificavel (fail-safe, nao adverso)">
      <bpmn:documentation>Terminal NEUTRO (guard TECNICO, GAP-LGPD-6): `operadora.lgpd.verify_identity` RECUSOU prosseguir porque `titular_pseudo_id` chegou ausente/vazio (ERR_DSR_IDENTITY_UNVERIFIED) — impossibilidade MECANICA de verificar, distinta de qualquer FATO/decisao de merito. NENHUM desfecho de merito ocorreu: nem atendida, nem negada fundamentada, nem execucao. NUNCA uma acusacao automatica de fraude (L0 hard). Espelha End_RecursoGlosaInvalidaOrigem (GAP-RECURSO-3) / End_CredPrestadorInvalido (GAP-CRED-1) / End_ReembolsoProtocoloInvalido (GAP-REEMBOLSO-2) — mas, dado o teto legal LGPD art. 19 II, publica `lgpd_dsr.completed` (desfecho=identidade_inverificavel) ANTES do fim, dando visibilidade a DPO/juridico-privacidade para revisao manual caso o padrao pareca suspeito.</bpmn:documentation>
      <bpmn:incoming>Flow_PubIdentInverif_End</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:exclusiveGateway id="GW_Identidade" name="Identidade confirmada?" default="Flow_GWId_Pedir">
      <bpmn:incoming>Flow_Verify_GW</bpmn:incoming>
      <bpmn:outgoing>Flow_GWId_Ok</bpmn:outgoing>
      <bpmn:outgoing>Flow_GWId_Pedir</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Identidade nao confirmada: pedir prova adicional, com prazo -->
    <bpmn:serviceTask id="ST_PedirProvaAdicional" name="Solicitar prova adicional de identidade"
                      camunda:type="external" camunda:topic="operadora.lgpd.request_additional_proof">
      <bpmn:incoming>Flow_GWId_Pedir</bpmn:incoming>
      <bpmn:outgoing>Flow_Pedir_Wait</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:eventBasedGateway id="GW_AguardarProva" name="Aguardar prova">
      <bpmn:incoming>Flow_Pedir_Wait</bpmn:incoming>
      <bpmn:outgoing>Flow_Wait_Prova</bpmn:outgoing>
      <bpmn:outgoing>Flow_Wait_Timer</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="ICE_ProvaRecebida" name="Prova recebida">
      <bpmn:incoming>Flow_Wait_Prova</bpmn:incoming>
      <bpmn:outgoing>Flow_ProvaOk_Verify</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_ProvaRecebida" messageRef="Msg_LgpdProvaRecebida"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="ICE_PrazoProva" name="Prazo de prova (P10D — politica interna DRAFT)">
      <bpmn:incoming>Flow_Wait_Timer</bpmn:incoming>
      <bpmn:outgoing>Flow_PrazoProva_Pub</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TD_PrazoProva">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P10D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="ST_PublishExpirada" name="Publicar evento: lgpd_dsr.completed (expirada_identidade)"
                      camunda:type="external" camunda:topic="operadora.events.publish">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="event_topic">agents.events.lgpd_dsr.completed</camunda:inputParameter>
          <camunda:inputParameter name="event_desfecho">expirada_identidade</camunda:inputParameter>
          <camunda:inputParameter name="event_payload_vars">tenant_id,titular_pseudo_id,tipo_requisicao</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_PrazoProva_Pub</bpmn:incoming>
      <bpmn:outgoing>Flow_PubExpirada_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_ExpiradaIdentidade" name="Expirada sem verificacao de identidade">
      <bpmn:incoming>Flow_PubExpirada_End</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Identidade ok: rotear pela DMN -->
    <bpmn:businessRuleTask id="BRT_RotearDsr" name="Rotear requisicao (DMN lgpd_dsr_routing)"
                           camunda:decisionRef="lgpd_dsr_routing"
                           camunda:mapDecisionResult="singleResult"
                           camunda:resultVariable="roteamento_dsr">
      <bpmn:documentation>(tipo_requisicao, envolve_dados_saude) -> {fluxo, grupo_revisor, sla_resposta, sla_alerta}.</bpmn:documentation>
      <bpmn:incoming>Flow_GWId_Ok</bpmn:incoming>
      <bpmn:outgoing>Flow_Rotear_Compilar</bpmn:outgoing>
    </bpmn:businessRuleTask>

    <bpmn:serviceTask id="ST_CompilarPacote" name="Compilar pacote de dados / minuta de resposta"
                      camunda:type="external" camunda:topic="operadora.lgpd.compile_data_package">
      <bpmn:documentation>Worker compila conforme roteamento_dsr.fluxo (EXPORTACAO | RETIFICACAO | ELIMINACAO_AVALIACAO | INFORMATIVO), incluindo mapa de bases legais e obrigacoes de retencao aplicaveis.</bpmn:documentation>
      <bpmn:incoming>Flow_Rotear_Compilar</bpmn:incoming>
      <bpmn:outgoing>Flow_Compilar_UT</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- HITL: nenhum dado sensivel sai sem revisao humana -->
    <bpmn:userTask id="UT_RevisaoDpo" name="Revisar e decidir resposta ao titular"
                   camunda:candidateGroups="${roteamento_dsr.grupo_revisor}">
      <bpmn:documentation><![CDATA[
HITL obrigatorio: dados de saude sao sensiveis (LGPD art. 11) — liberacao, eliminacao,
retificacao e negativa fundamentada sao decisoes humanas (DPO / juridico-privacidade).
Saidas: decisao_dsr in {APROVAR_ENVIO, EXECUTAR_E_ENVIAR, NEGAR_FUNDAMENTADO};
NEGAR_FUNDAMENTADO exige fundamentacao_legal (ex.: retencao obrigatoria de prontuario).
SLA total da instancia: P15D (LGPD art. 19, II) — event subprocess SlaGlobal.

FAIL-CLOSED (GAP-LGPD-4/GAP-LGPD-3, ADR-0005 HITL-estrutural): GW_DecisaoDsr so avanca para
envio/execucao com um dos TRES valores EXPLICITOS acima — decisao_dsr ausente/em branco/
desconhecido NUNCA libera dados por omissao (roteia a End_ErrDecisaoInvalida,
ERR_DSR_DECISION_INVALID). Para NEGAR_FUNDAMENTADO, GW_GuardFundamentacao (avaliado pelo
ENGINE, nao apenas validacao de formulario no Tasklist) barra a negativa se fundamentacao_legal
estiver vazia (End_ErrFundamentacaoAusente, ERR_DSR_FUNDAMENTACAO_AUSENTE) — a decisao de negar
continua humana; o guard so impede a AUSENCIA da fundamentacao exigida por lei.
]]></bpmn:documentation>
      <bpmn:incoming>Flow_Compilar_UT</bpmn:incoming>
      <bpmn:outgoing>Flow_UT_GWDec</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Alerta interno antes do estouro (nao-interruptivo) -->
    <bpmn:boundaryEvent id="BT_AlertaDpo" name="Alerta interno (P7D na tarefa — DRAFT)" cancelActivity="false" attachedToRef="UT_RevisaoDpo">
      <bpmn:outgoing>Flow_Alerta_Notify</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TD_AlertaDpo">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">${roteamento_dsr.sla_alerta}</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="ST_NotificarRiscoSla" name="Notificar risco de SLA (juridico)"
                      camunda:type="external" camunda:topic="operadora.lgpd.notify_sla_risk">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <!-- Rotulos locais do contador cibseven_user_task_sla_breach_total (GAP-LGPD obs-wiring,
               padrao res-nip-task-label): o worker notify_sla_risk serve DOIS service tasks no
               MESMO topico e o ExternalTask nao expoe o activityId — estes inputParameters sao a
               unica forma do handler distinguir o alerta P7D (ack) do estouro legal P15D
               (resolution). -->
          <camunda:inputParameter name="sla_breach_task_name">UT_RevisaoDpo</camunda:inputParameter>
          <camunda:inputParameter name="sla_breach_phase">ack</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Alerta_Notify</bpmn:incoming>
      <bpmn:outgoing>Flow_Notify_EndAlerta</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_RiscoNotificado" name="Risco notificado (revisao segue)">
      <bpmn:incoming>Flow_Notify_EndAlerta</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:exclusiveGateway id="GW_DecisaoDsr" name="Decisao do revisor" default="Flow_GWDec_Invalida">
      <bpmn:incoming>Flow_UT_GWDec</bpmn:incoming>
      <bpmn:outgoing>Flow_GWDec_Executar</bpmn:outgoing>
      <bpmn:outgoing>Flow_GWDec_Negar</bpmn:outgoing>
      <bpmn:outgoing>Flow_GWDec_Enviar</bpmn:outgoing>
      <bpmn:outgoing>Flow_GWDec_Invalida</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- GAP-LGPD-4 (fail-closed): decisao_dsr ausente/em branco/desconhecida NUNCA libera dados
         por omissao — o default do gateway agora vai para um incidente tecnico, nunca para o
         envio. Nenhum caminho automatizado libera/nega sem um dos tres valores EXPLICITOS. -->
    <bpmn:endEvent id="End_ErrDecisaoInvalida" name="Erro: decisao do revisor ausente ou desconhecida (ERR_DSR_DECISION_INVALID)">
      <bpmn:documentation>Fail-closed (GAP-LGPD-4, ADR-0005): decisao_dsr fora de {APROVAR_ENVIO, EXECUTAR_E_ENVIAR, NEGAR_FUNDAMENTADO} (incluindo ausente/em branco) NUNCA libera o pacote de dados por omissao. Este e um INCIDENTE tecnico/operacional (formulario incompleto, integracao quebrada) — NAO uma decisao adversa ao titular; exige correcao humana (reabrir UT_RevisaoDpo ou corrigir o dado) antes de qualquer resposta sair.</bpmn:documentation>
      <bpmn:incoming>Flow_GWDec_Invalida</bpmn:incoming>
      <bpmn:errorEventDefinition id="EED_DecisaoInvalida" errorRef="Error_LgpdDecisaoInvalida"/>
    </bpmn:endEvent>

    <!-- GAP-LGPD-3 (HITL-estrutural, ADR-0005): NEGAR_FUNDAMENTADO exige fundamentacao_legal
         nao-vazia. O guard e avaliado PELO ENGINE (nao apenas validacao de formulario no
         Tasklist, contornavel por chamada direta a REST API) — a negativa so alcanca
         ST_EnviarResposta com fundamentacao preenchida. -->
    <bpmn:exclusiveGateway id="GW_GuardFundamentacao" name="Fundamentacao legal preenchida?" default="Flow_GWFund_Ausente">
      <bpmn:incoming>Flow_GWDec_Negar</bpmn:incoming>
      <bpmn:outgoing>Flow_GWFund_Ok</bpmn:outgoing>
      <bpmn:outgoing>Flow_GWFund_Ausente</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_ErrFundamentacaoAusente" name="Erro: NEGAR_FUNDAMENTADO sem fundamentacao_legal (ERR_DSR_FUNDAMENTACAO_AUSENTE)">
      <bpmn:documentation>HITL-estrutural (GAP-LGPD-3, ADR-0005): uma negativa fundamentada SEM fundamentacao_legal NAO e enviada. A decisao de negar permanece humana (UT_RevisaoDpo); este guard so barra a AUSENCIA da fundamentacao exigida por lei (LGPD) — exige reabrir a revisao e preencher fundamentacao_legal antes de qualquer resposta sair.</bpmn:documentation>
      <bpmn:incoming>Flow_GWFund_Ausente</bpmn:incoming>
      <bpmn:errorEventDefinition id="EED_FundamentacaoAusente" errorRef="Error_LgpdFundamentacaoAusente"/>
    </bpmn:endEvent>

    <!-- Executar retificacao/eliminacao aprovada e depois responder -->
    <bpmn:serviceTask id="ST_ExecutarRequisicao" name="Executar retificacao/eliminacao aprovada"
                      camunda:type="external" camunda:topic="operadora.lgpd.execute_request">
      <bpmn:documentation>Executa nos sistemas de registro (FHIR/Postgres) o que o humano aprovou, com trilha assinada (ADR-0007).</bpmn:documentation>
      <bpmn:incoming>Flow_GWDec_Executar</bpmn:incoming>
      <bpmn:outgoing>Flow_Executar_Enviar</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="ST_EnviarResposta" name="Enviar resposta ao titular"
                      camunda:type="external" camunda:topic="operadora.lgpd.send_response">
      <bpmn:documentation>Resposta aprovada pelo humano: pacote de dados, confirmacao de execucao OU negativa fundamentada (fundamentacao_legal).</bpmn:documentation>
      <bpmn:incoming>Flow_GWDec_Enviar</bpmn:incoming>
      <bpmn:incoming>Flow_GWFund_Ok</bpmn:incoming>
      <bpmn:incoming>Flow_Executar_Enviar</bpmn:incoming>
      <bpmn:outgoing>Flow_Enviar_Pub</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="ST_PublishCompleted" name="Publicar evento: lgpd_dsr.completed"
                      camunda:type="external" camunda:topic="operadora.events.publish">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="event_topic">agents.events.lgpd_dsr.completed</camunda:inputParameter>
          <!-- GAP-LGPD-7 (M2a): event_desfecho agora computado in-engine via JUEL.
               APROVAR_ENVIO/EXECUTAR_E_ENVIAR → atendida; NEGAR_FUNDAMENTADO → negada_fundamentada.
               Os outros dois desfechos (expirada_identidade, identidade_inverificavel) sao
               emitidos por ST_PublishExpirada e ST_PublishIdentidadeInverificavel respectivamente. -->
          <camunda:inputParameter name="event_desfecho">${decisao_dsr == 'NEGAR_FUNDAMENTADO' ? 'negada_fundamentada' : 'atendida'}</camunda:inputParameter>
          <camunda:inputParameter name="event_payload_vars">tenant_id,titular_pseudo_id,tipo_requisicao,decisao_dsr</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Enviar_Pub</bpmn:incoming>
      <bpmn:outgoing>Flow_Pub_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_RequisicaoConcluida" name="Requisicao concluida (atendida ou negada fundamentada)">
      <bpmn:incoming>Flow_Pub_End</bpmn:incoming>
    </bpmn:endEvent>

    <!-- ===== Event subprocess: SLA global de 15 dias (LGPD art. 19, II) ===== -->
    <bpmn:subProcess id="ESP_SlaGlobal" name="SLA global LGPD (15 dias)" triggeredByEvent="true">
      <bpmn:startEvent id="Start_SlaGlobal" name="P15D desde o inicio (LGPD art. 19, II)" isInterrupting="false">
        <bpmn:outgoing>Flow_SlaGlobal_Pub</bpmn:outgoing>
        <bpmn:timerEventDefinition id="TD_SlaGlobal">
          <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P15D</bpmn:timeDuration>
        </bpmn:timerEventDefinition>
      </bpmn:startEvent>
      <bpmn:serviceTask id="ST_PublishSlaBreached" name="Publicar evento: lgpd_dsr.sla_breached"
                        camunda:type="external" camunda:topic="operadora.events.publish">
        <bpmn:extensionElements>
          <camunda:inputOutput>
            <camunda:inputParameter name="event_topic">agents.events.lgpd_dsr.sla_breached</camunda:inputParameter>
            <camunda:inputParameter name="event_payload_vars">tenant_id,titular_pseudo_id,tipo_requisicao</camunda:inputParameter>
          </camunda:inputOutput>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_SlaGlobal_Pub</bpmn:incoming>
        <bpmn:outgoing>Flow_SlaGlobal_Notify</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="ST_NotificarJuridicoBreach" name="Notificar juridico (SLA legal estourado)"
                        camunda:type="external" camunda:topic="operadora.lgpd.notify_sla_risk">
        <bpmn:extensionElements>
          <camunda:inputOutput>
            <!-- Estouro do SLA LEGAL P15D (LGPD art. 19, II) — fase resolution do contador
                 cibseven_user_task_sla_breach_total (ver ST_NotificarRiscoSla para o padrao). -->
            <camunda:inputParameter name="sla_breach_task_name">UT_RevisaoDpo</camunda:inputParameter>
            <camunda:inputParameter name="sla_breach_phase">resolution</camunda:inputParameter>
          </camunda:inputOutput>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_SlaGlobal_Notify</bpmn:incoming>
        <bpmn:outgoing>Flow_SlaGlobal_End</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="End_SlaGlobalAlertado" name="Juridico alertado (caso segue aberto)">
        <bpmn:incoming>Flow_SlaGlobal_End</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_SlaGlobal_Pub" sourceRef="Start_SlaGlobal" targetRef="ST_PublishSlaBreached"/>
      <bpmn:sequenceFlow id="Flow_SlaGlobal_Notify" sourceRef="ST_PublishSlaBreached" targetRef="ST_NotificarJuridicoBreach"/>
      <bpmn:sequenceFlow id="Flow_SlaGlobal_End" sourceRef="ST_NotificarJuridicoBreach" targetRef="End_SlaGlobalAlertado"/>
    </bpmn:subProcess>

    <!-- FLOWS -->
    <bpmn:sequenceFlow id="Flow_Start_PubReceived" sourceRef="Start_RequisicaoTitular" targetRef="ST_PublishReceived"/>
    <bpmn:sequenceFlow id="Flow_PubReceived_Verify" sourceRef="ST_PublishReceived" targetRef="ST_VerificarIdentidade"/>
    <bpmn:sequenceFlow id="Flow_Verify_GW" sourceRef="ST_VerificarIdentidade" targetRef="GW_Identidade"/>
    <bpmn:sequenceFlow id="Flow_IdentInverif_Pub" sourceRef="BE_IdentidadeInverificavel" targetRef="ST_PublishIdentidadeInverificavel"/>
    <bpmn:sequenceFlow id="Flow_PubIdentInverif_End" sourceRef="ST_PublishIdentidadeInverificavel" targetRef="End_IdentidadeInverificavel"/>
    <bpmn:sequenceFlow id="Flow_GWId_Ok" name="confirmada" sourceRef="GW_Identidade" targetRef="BRT_RotearDsr">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${identidade_confirmada == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_GWId_Pedir" name="nao confirmada (default)" sourceRef="GW_Identidade" targetRef="ST_PedirProvaAdicional"/>
    <bpmn:sequenceFlow id="Flow_Pedir_Wait" sourceRef="ST_PedirProvaAdicional" targetRef="GW_AguardarProva"/>
    <bpmn:sequenceFlow id="Flow_Wait_Prova" sourceRef="GW_AguardarProva" targetRef="ICE_ProvaRecebida"/>
    <bpmn:sequenceFlow id="Flow_Wait_Timer" sourceRef="GW_AguardarProva" targetRef="ICE_PrazoProva"/>
    <bpmn:sequenceFlow id="Flow_ProvaOk_Verify" sourceRef="ICE_ProvaRecebida" targetRef="ST_VerificarIdentidade"/>
    <bpmn:sequenceFlow id="Flow_PrazoProva_Pub" sourceRef="ICE_PrazoProva" targetRef="ST_PublishExpirada"/>
    <bpmn:sequenceFlow id="Flow_PubExpirada_End" sourceRef="ST_PublishExpirada" targetRef="End_ExpiradaIdentidade"/>
    <bpmn:sequenceFlow id="Flow_Rotear_Compilar" sourceRef="BRT_RotearDsr" targetRef="ST_CompilarPacote"/>
    <bpmn:sequenceFlow id="Flow_Compilar_UT" sourceRef="ST_CompilarPacote" targetRef="UT_RevisaoDpo"/>
    <bpmn:sequenceFlow id="Flow_Alerta_Notify" sourceRef="BT_AlertaDpo" targetRef="ST_NotificarRiscoSla"/>
    <bpmn:sequenceFlow id="Flow_Notify_EndAlerta" sourceRef="ST_NotificarRiscoSla" targetRef="End_RiscoNotificado"/>
    <bpmn:sequenceFlow id="Flow_UT_GWDec" sourceRef="UT_RevisaoDpo" targetRef="GW_DecisaoDsr"/>
    <bpmn:sequenceFlow id="Flow_GWDec_Executar" name="EXECUTAR_E_ENVIAR" sourceRef="GW_DecisaoDsr" targetRef="ST_ExecutarRequisicao">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${decisao_dsr == 'EXECUTAR_E_ENVIAR'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_GWDec_Negar" name="NEGAR_FUNDAMENTADO (decisao humana)" sourceRef="GW_DecisaoDsr" targetRef="GW_GuardFundamentacao">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${decisao_dsr == 'NEGAR_FUNDAMENTADO'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_GWDec_Enviar" name="APROVAR_ENVIO" sourceRef="GW_DecisaoDsr" targetRef="ST_EnviarResposta">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${decisao_dsr == 'APROVAR_ENVIO'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_GWDec_Invalida" name="invalida/ausente (default -&gt; ERR_DSR_DECISION_INVALID)" sourceRef="GW_DecisaoDsr" targetRef="End_ErrDecisaoInvalida"/>
    <bpmn:sequenceFlow id="Flow_GWFund_Ok" name="fundamentacao_legal preenchida" sourceRef="GW_GuardFundamentacao" targetRef="ST_EnviarResposta">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${fundamentacao_legal != null &amp;&amp; fundamentacao_legal != ''}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_GWFund_Ausente" name="fundamentacao_legal ausente (default -&gt; ERR_DSR_FUNDAMENTACAO_AUSENTE)" sourceRef="GW_GuardFundamentacao" targetRef="End_ErrFundamentacaoAusente"/>
    <bpmn:sequenceFlow id="Flow_Executar_Enviar" sourceRef="ST_ExecutarRequisicao" targetRef="ST_EnviarResposta"/>
    <bpmn:sequenceFlow id="Flow_Enviar_Pub" sourceRef="ST_EnviarResposta" targetRef="ST_PublishCompleted"/>
    <bpmn:sequenceFlow id="Flow_Pub_End" sourceRef="ST_PublishCompleted" targetRef="End_RequisicaoConcluida"/>
  </bpmn:process>

