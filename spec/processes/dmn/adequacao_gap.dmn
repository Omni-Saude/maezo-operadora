<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/"
             xmlns:dmndi="https://www.omg.org/spec/DMN/20191111/DMNDI/"
             xmlns:camunda="http://camunda.org/schema/1.0/dmn"
             id="defs_adequacao_gap"
             name="Medicao de gap de adequacao geografica de rede (RN 259)"
             namespace="http://maezo.health/dmn/operadora">
  <description>
    adequacao_gap v0.1.0 — status: DRAFT — TODOS os thresholds de tempo/distancia marcados
    DRAFT/verify: confirmar texto vigente com regulatorio (RN 259/2011 garantia de atendimento
    com tempos e distancias maximas de acesso; RN 566 dimensionamento/regras de rede;
    consolidacoes ANS; docs/review-queue.md). Consumida por SP-OP-ADEQUACAO-001 e mcp-dmn.

    INVARIANTE (ADR-0018): esta tabela APENAS MEDE a severidade do gap de adequacao geografica.
    NAO possui saida que firme/autorize compromisso financeiro — o dominio de `gap_adequacao` e
    um CLOSED-allowlist NEUTRO {CONFORME, GAP_LEVE, GAP_MODERADO, GAP_CRITICO}. O compromisso
    financeiro de fallback (COMPROMISSO_FALLBACK) SO nasce na User Task humana UT_DecisaoFallback,
    materializado pelo worker gated operadora.adequacao.register_fallback_commitment
    (ERR_FALLBACK_COMMITMENT_NOT_HUMAN).

    Thresholds de tempo/distancia maximos por tipo_carater (eletivo vs urgencia_emergencia) sao
    DRAFT/verify contra RN 259 vigente. Catch-all FAIL-SAFE (dados insuficientes/combinacao
    nao coberta): GAP_CRITICO (conservador → humano a jusante no adequacao_remediation_routing).

    Numeros nunca como `number` (ADR-0018 parte 2): tempo_acesso_apurado_min / prestadores_disponiveis
    = integer; distancia_apurada_km = double.

    hitPolicy FIRST (catch-all conservador como ultima row; rows ordenadas da condicao mais
    critica para a menos critica).
  </description>
  <decision id="adequacao_gap" name="Medicao de gap de adequacao geografica" camunda:historyTimeToLive="P180D">
    <decisionTable id="dt_adequacao_gap" hitPolicy="FIRST">
      <input id="in_tipo_carater" label="Tipo de carater (tipo_carater)">
        <inputExpression id="ie_tipo_carater" typeRef="string"><text>tipo_carater</text></inputExpression>
      </input>
      <input id="in_tempo_acesso" label="Tempo de acesso apurado em minutos (tempo_acesso_apurado_min)">
        <inputExpression id="ie_tempo_acesso" typeRef="integer"><text>tempo_acesso_apurado_min</text></inputExpression>
      </input>
      <input id="in_distancia" label="Distancia apurada em km (distancia_apurada_km)">
        <inputExpression id="ie_distancia" typeRef="double"><text>distancia_apurada_km</text></inputExpression>
      </input>
      <input id="in_prestadores" label="Prestadores disponiveis (prestadores_disponiveis)">
        <inputExpression id="ie_prestadores" typeRef="integer"><text>prestadores_disponiveis</text></inputExpression>
      </input>
      <input id="in_cobertura_geo" label="Cobertura geografica suficiente (cobertura_geo_suficiente)">
        <inputExpression id="ie_cobertura_geo" typeRef="boolean"><text>cobertura_geo_suficiente</text></inputExpression>
      </input>
      <output id="out_gap" label="gap_adequacao" name="gap_adequacao" typeRef="string"/>
      <output id="out_motivo" label="motivo" name="motivo" typeRef="string"/>
      <rule id="r_urgencia_critico">
        <description>Urgencia/emergencia com acesso acima de threshold (tempo > 30min ou distancia > 30km) -> GAP_CRITICO (conservador; humano decide remediacao)</description>
        <inputEntry id="r_urgencia_critico_i1"><text>"urgencia_emergencia"</text></inputEntry>
        <inputEntry id="r_urgencia_critico_i2"><text>&gt; 30</text></inputEntry>
        <inputEntry id="r_urgencia_critico_i3"><text>-</text></inputEntry>
        <inputEntry id="r_urgencia_critico_i4"><text>-</text></inputEntry>
        <inputEntry id="r_urgencia_critico_i5"><text>-</text></inputEntry>
        <outputEntry id="r_urgencia_critico_o1"><text>"GAP_CRITICO"</text></outputEntry>
        <outputEntry id="r_urgencia_critico_o2"><text>"Urgencia/emergencia com tempo de acesso acima do threshold RN 259 — gap critico; humano decide remediacao; DRAFT/verify"</text></outputEntry>
      </rule>
      <rule id="r_urgencia_distancia_critico">
        <description>Urgencia/emergencia com distancia acima do threshold (> 30km) -> GAP_CRITICO</description>
        <inputEntry id="r_urgencia_distancia_critico_i1"><text>"urgencia_emergencia"</text></inputEntry>
        <inputEntry id="r_urgencia_distancia_critico_i2"><text>-</text></inputEntry>
        <inputEntry id="r_urgencia_distancia_critico_i3"><text>&gt; 30.0</text></inputEntry>
        <inputEntry id="r_urgencia_distancia_critico_i4"><text>-</text></inputEntry>
        <inputEntry id="r_urgencia_distancia_critico_i5"><text>-</text></inputEntry>
        <outputEntry id="r_urgencia_distancia_critico_o1"><text>"GAP_CRITICO"</text></outputEntry>
        <outputEntry id="r_urgencia_distancia_critico_o2"><text>"Urgencia/emergencia com distancia acima do threshold RN 259 — gap critico; DRAFT/verify"</text></outputEntry>
      </rule>
      <rule id="r_zero_prestadores_critico">
        <description>Zero prestadores disponiveis -> GAP_CRITICO independente de tipo (falha total de cobertura)</description>
        <inputEntry id="r_zero_prestadores_critico_i1"><text>-</text></inputEntry>
        <inputEntry id="r_zero_prestadores_critico_i2"><text>-</text></inputEntry>
        <inputEntry id="r_zero_prestadores_critico_i3"><text>-</text></inputEntry>
        <inputEntry id="r_zero_prestadores_critico_i4"><text>0</text></inputEntry>
        <inputEntry id="r_zero_prestadores_critico_i5"><text>-</text></inputEntry>
        <outputEntry id="r_zero_prestadores_critico_o1"><text>"GAP_CRITICO"</text></outputEntry>
        <outputEntry id="r_zero_prestadores_critico_o2"><text>"Zero prestadores disponiveis na celula — gap critico (falha total de cobertura); DRAFT/verify RN 566"</text></outputEntry>
      </rule>
      <rule id="r_cobertura_insuficiente">
        <description>Cobertura geografica insuficiente -> GAP_MODERADO (dimensionamento RN 566 insuficiente)</description>
        <inputEntry id="r_cobertura_insuficiente_i1"><text>-</text></inputEntry>
        <inputEntry id="r_cobertura_insuficiente_i2"><text>-</text></inputEntry>
        <inputEntry id="r_cobertura_insuficiente_i3"><text>-</text></inputEntry>
        <inputEntry id="r_cobertura_insuficiente_i4"><text>-</text></inputEntry>
        <inputEntry id="r_cobertura_insuficiente_i5"><text>false</text></inputEntry>
        <outputEntry id="r_cobertura_insuficiente_o1"><text>"GAP_MODERADO"</text></outputEntry>
        <outputEntry id="r_cobertura_insuficiente_o2"><text>"Cobertura geografica insuficiente (dimensionamento RN 566) — gap moderado; DRAFT/verify"</text></outputEntry>
      </rule>
      <rule id="r_eletivo_leve">
        <description>Eletivo com tempo ate 60min e distancia ate 50km e ao menos 1 prestador -> GAP_LEVE (monitorar)</description>
        <inputEntry id="r_eletivo_leve_i1"><text>"eletivo"</text></inputEntry>
        <inputEntry id="r_eletivo_leve_i2"><text>&lt;= 60</text></inputEntry>
        <inputEntry id="r_eletivo_leve_i3"><text>&lt;= 50.0</text></inputEntry>
        <inputEntry id="r_eletivo_leve_i4"><text>&gt; 0</text></inputEntry>
        <inputEntry id="r_eletivo_leve_i5"><text>true</text></inputEntry>
        <outputEntry id="r_eletivo_leve_o1"><text>"GAP_LEVE"</text></outputEntry>
        <outputEntry id="r_eletivo_leve_o2"><text>"Eletivo com acesso dentro de thresholds estendidos — gap leve; monitorar (L3); DRAFT/verify RN 259"</text></outputEntry>
      </rule>
      <rule id="r_urgencia_leve">
        <description>Urgencia/emergencia com acesso dentro dos thresholds (<= 30min, <= 30km) e cobertura ok -> GAP_LEVE (monitorar)</description>
        <inputEntry id="r_urgencia_leve_i1"><text>"urgencia_emergencia"</text></inputEntry>
        <inputEntry id="r_urgencia_leve_i2"><text>&lt;= 30</text></inputEntry>
        <inputEntry id="r_urgencia_leve_i3"><text>&lt;= 30.0</text></inputEntry>
        <inputEntry id="r_urgencia_leve_i4"><text>&gt; 0</text></inputEntry>
        <inputEntry id="r_urgencia_leve_i5"><text>true</text></inputEntry>
        <outputEntry id="r_urgencia_leve_o1"><text>"GAP_LEVE"</text></outputEntry>
        <outputEntry id="r_urgencia_leve_o2"><text>"Urgencia/emergencia com acesso dentro dos thresholds RN 259 — gap leve; monitorar; DRAFT/verify"</text></outputEntry>
      </rule>
      <rule id="r_conforme">
        <description>Celula plenamente coberta: ao menos 1 prestador, cobertura geografica ok, dentro dos thresholds -> CONFORME</description>
        <inputEntry id="r_conforme_i1"><text>-</text></inputEntry>
        <inputEntry id="r_conforme_i2"><text>-</text></inputEntry>
        <inputEntry id="r_conforme_i3"><text>-</text></inputEntry>
        <inputEntry id="r_conforme_i4"><text>&gt; 0</text></inputEntry>
        <inputEntry id="r_conforme_i5"><text>true</text></inputEntry>
        <outputEntry id="r_conforme_o1"><text>"CONFORME"</text></outputEntry>
        <outputEntry id="r_conforme_o2"><text>"Celula plenamente coberta (prestadores disponiveis + cobertura geografica suficiente) — conforme RN 259/566; DRAFT/verify"</text></outputEntry>
      </rule>
      <rule id="r_catchall">
        <description>Catch-all FAIL-SAFE: dados insuficientes, combinacao nao coberta ou ambiguidade -> GAP_CRITICO (conservador -> humano a jusante; nunca compromisso automatico)</description>
        <inputEntry id="r_catchall_i1"><text>-</text></inputEntry>
        <inputEntry id="r_catchall_i2"><text>-</text></inputEntry>
        <inputEntry id="r_catchall_i3"><text>-</text></inputEntry>
        <inputEntry id="r_catchall_i4"><text>-</text></inputEntry>
        <inputEntry id="r_catchall_i5"><text>-</text></inputEntry>
        <outputEntry id="r_catchall_o1"><text>"GAP_CRITICO"</text></outputEntry>
        <outputEntry id="r_catchall_o2"><text>"Combinacao nao mapeada / dados geo insuficientes — gap critico por seguranca (conservador -> humano decide; nunca compromisso automatico); DRAFT/verify"</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
</definitions>
