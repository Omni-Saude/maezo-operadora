<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/"
             xmlns:dmndi="https://www.omg.org/spec/DMN/20191111/DMNDI/"
             xmlns:camunda="http://camunda.org/schema/1.0/dmn"
             id="defs_adequacao_sla"
             name="SLA de remediacao de adequacao geografica"
             namespace="http://maezo.health/dmn/operadora">
  <description>
    adequacao_sla v0.1.0 — status: DRAFT — TODOS os prazos marcados DRAFT/verify: confirmar
    texto vigente com regulatorio (RN 259/2011 garantia de atendimento; RN 566 dimensionamento
    de rede; consolidacoes ANS; docs/review-queue.md). Consumida por SP-OP-ADEQUACAO-001 e
    mcp-dmn.

    NOTA: prazos regulatorios sao em dias UTEIS / por vezes corridos; ISO 8601 usa dias corridos —
    valores abaixo sao aproximacao conservadora. Resolver calendario util no worker. Prazo
    regulatorio vive AQUI (DMN) e no timer BPMN — nunca em Python (CONTRIBUTING). Saidas de prazo
    sao string ISO 8601 (sla_remediacao, sla_alerta); fonte_regulatoria e a RN/IN citada
    (registrada para auditoria).

    INVARIANTE (ADR-0018): esta tabela NAO tem saida adversa; no estouro de SLA a coordenacao
    humana assume (UT_CoordenacaoRede) — NUNCA auto-compromisso financeiro por timeout. O timer
    interruptivo de remediacao so e relevante quando o fluxo entrou em ANALISE_HUMANA (gap critico).
    Gap critico / urgencia tem SLA mais curto.

    NOTA hitPolicy: FIRST (catch-all conservador como ultima row; rows ordenadas do SLA mais
    curto para o mais longo). Espelha cancel_sla / cred_sla.
  </description>
  <decision id="adequacao_sla" name="SLA de remediacao de adequacao geografica" camunda:historyTimeToLive="P180D">
    <decisionTable id="dt_adequacao_sla" hitPolicy="FIRST">
      <input id="in_gap_adequacao" label="Severidade do gap (gap_adequacao)">
        <inputExpression id="ie_gap_adequacao" typeRef="string"><text>gap_adequacao</text></inputExpression>
      </input>
      <input id="in_tipo_carater" label="Tipo de carater (tipo_carater)">
        <inputExpression id="ie_tipo_carater" typeRef="string"><text>tipo_carater</text></inputExpression>
      </input>
      <output id="out_sla_remediacao" label="sla_remediacao" name="sla_remediacao" typeRef="string"/>
      <output id="out_sla_alerta" label="sla_alerta" name="sla_alerta" typeRef="string"/>
      <output id="out_fonte" label="fonte_regulatoria" name="fonte_regulatoria" typeRef="string"/>
      <rule id="r_critico_urgencia">
        <description>Gap critico em urgencia/emergencia -> SLA mais curto (risco assistencial imediato; exposicao a sancao ANS)</description>
        <inputEntry id="r_critico_urgencia_i1"><text>"GAP_CRITICO"</text></inputEntry>
        <inputEntry id="r_critico_urgencia_i2"><text>"urgencia_emergencia"</text></inputEntry>
        <outputEntry id="r_critico_urgencia_o1"><text>"P5D"</text></outputEntry>
        <outputEntry id="r_critico_urgencia_o2"><text>"P3D"</text></outputEntry>
        <outputEntry id="r_critico_urgencia_o3"><text>"RN 259/2011 — gap critico em urgencia/emergencia: remediacao ~5 dias; DRAFT/verify"</text></outputEntry>
      </rule>
      <rule id="r_critico_eletivo">
        <description>Gap critico em carater eletivo -> SLA curto (compromisso de adequacao urgente)</description>
        <inputEntry id="r_critico_eletivo_i1"><text>"GAP_CRITICO"</text></inputEntry>
        <inputEntry id="r_critico_eletivo_i2"><text>-</text></inputEntry>
        <outputEntry id="r_critico_eletivo_o1"><text>"P10D"</text></outputEntry>
        <outputEntry id="r_critico_eletivo_o2"><text>"P7D"</text></outputEntry>
        <outputEntry id="r_critico_eletivo_o3"><text>"RN 259/2011 — gap critico (eletivo): remediacao ~10 dias; DRAFT/verify"</text></outputEntry>
      </rule>
      <rule id="r_moderado">
        <description>Gap moderado -> SLA intermediario (encaminhamento de credenciamento)</description>
        <inputEntry id="r_moderado_i1"><text>"GAP_MODERADO"</text></inputEntry>
        <inputEntry id="r_moderado_i2"><text>-</text></inputEntry>
        <outputEntry id="r_moderado_o1"><text>"P30D"</text></outputEntry>
        <outputEntry id="r_moderado_o2"><text>"P18D"</text></outputEntry>
        <outputEntry id="r_moderado_o3"><text>"RN 259/566 — gap moderado: remediacao ~30 dias (encaminhar credenciamento); DRAFT/verify"</text></outputEntry>
      </rule>
      <rule id="r_leve_monitorar">
        <description>Gap leve -> SLA de monitoramento (observacao L3; sem timer interruptivo de decisao humana)</description>
        <inputEntry id="r_leve_monitorar_i1"><text>"GAP_LEVE"</text></inputEntry>
        <inputEntry id="r_leve_monitorar_i2"><text>-</text></inputEntry>
        <outputEntry id="r_leve_monitorar_o1"><text>"P60D"</text></outputEntry>
        <outputEntry id="r_leve_monitorar_o2"><text>"P40D"</text></outputEntry>
        <outputEntry id="r_leve_monitorar_o3"><text>"RN 259/566 — gap leve: monitoramento ~60 dias (L3, sem timer interruptivo; acompanhamento periodico); DRAFT/verify"</text></outputEntry>
      </rule>
      <rule id="r_catchall">
        <description>Catch-all FAIL-SAFE: gap nao mapeado -> prazo conservador curto (gap critico presumido; nunca prazo longo que mascare urgencia)</description>
        <inputEntry id="r_catchall_i1"><text>-</text></inputEntry>
        <inputEntry id="r_catchall_i2"><text>-</text></inputEntry>
        <outputEntry id="r_catchall_o1"><text>"P10D"</text></outputEntry>
        <outputEntry id="r_catchall_o2"><text>"P7D"</text></outputEntry>
        <outputEntry id="r_catchall_o3"><text>"Fail-safe: prazo conservador na ausencia de classificacao de gap — DRAFT/verify"</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
</definitions>
