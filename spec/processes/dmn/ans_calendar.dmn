<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/"
             xmlns:dmndi="https://www.omg.org/spec/DMN/20191111/DMNDI/"
             xmlns:camunda="http://camunda.org/schema/1.0/dmn"
             id="defs_ans_calendar"
             name="Calendario regulatorio ANS (datas de competencia por report_type)"
             namespace="http://maezo.health/dmn/operadora">
  <description>
    ans_calendar v0.1.0 — status: DRAFT — TODAS as datas, fontes e periodicidades marcadas
    DRAFT/verify: confirmar texto vigente com regulatorio (RN 124/2006 SIP, RN 209/2009
    utilizacao, RN 388/2015 indicadores/qualidade, RN 424/2017 TISS/monitoramento, DIOPS
    trimestral; docs/review-queue.md). Consumida por SP-OP-ANS-SUBMIT-001 e mcp-dmn.

    POR QUE EXISTE (separada de ans_sla): ans_sla resolve DURACOES ISO 8601 relativas a
    criacao da User Task (timeDuration nos boundary timers). ans_calendar resolve DATAS
    ABSOLUTAS de competencia (due_date / sla_alerta como ISO YYYY-MM-DD) — consumidas pelo
    dossie de revisao e pelos eventos de deadline-risk (due_date), nunca pelos timers
    (que usam ans_sla). A separacao evita que um timer com timeDate de data fixa passada
    insta-disparasse e cancelasse a User Task no instante de criacao.

    NAO negativa-like: este processo e operadora -> regulador; NAO existe saida adversa contra
    beneficiario/prestador. Esta tabela apenas resolve as datas do calendario regulatorio —
    nunca decide envio nem rejeita. Catch-all FAIL-SAFE (report_type/competencia desconhecidos):
    due_date/sla_alerta conservadores + fonte_regulatoria="REVISAO_HUMANA" (roteia a humano;
    nunca prazo "infinito").

    Saidas sao string ISO 8601 DATE (YYYY-MM-DD) — typeRef string. hitPolicy FIRST
    (catch-all conservador como ultima row — sob UNIQUE colidiria em runtime; espelha ans_sla).
  </description>
  <decision id="ans_calendar" name="Calendario regulatorio ANS" camunda:historyTimeToLive="P180D">
    <decisionTable id="dt_ans_calendar" hitPolicy="FIRST">
      <input id="in_report_type" label="Tipo de relatorio (report_type)">
        <inputExpression id="ie_report_type" typeRef="string"><text>report_type</text></inputExpression>
      </input>
      <input id="in_competencia" label="Competencia (competencia)">
        <inputExpression id="ie_competencia" typeRef="string"><text>competencia</text></inputExpression>
      </input>
      <output id="out_due_date" label="due_date" name="due_date" typeRef="string"/>
      <output id="out_sla_alerta" label="sla_alerta" name="sla_alerta" typeRef="string"/>
      <output id="out_periodicidade" label="periodicidade" name="periodicidade" typeRef="string"/>
      <output id="out_fonte" label="fonte_regulatoria" name="fonte_regulatoria" typeRef="string"/>
      <rule id="r_rn124_sip">
        <description>RN 124/2006 — SIP, periodicidade mensal: due_date = ultimo dia do mes de competencia, alerta 5 dias antes — DRAFT/verify</description>
        <inputEntry id="r_rn124_sip_i1"><text>"RN_124_SIP"</text></inputEntry>
        <inputEntry id="r_rn124_sip_i2"><text>-</text></inputEntry>
        <outputEntry id="r_rn124_sip_o1"><text>"DRAFT_DUE_DATE"</text></outputEntry>
        <outputEntry id="r_rn124_sip_o2"><text>"DRAFT_ALERTA"</text></outputEntry>
        <outputEntry id="r_rn124_sip_o3"><text>"mensal"</text></outputEntry>
        <outputEntry id="r_rn124_sip_o4"><text>"RN 124/2006 — SIP: periodicidade mensal, due_date ultimo dia do mes: DRAFT/verify regulatorio"</text></outputEntry>
      </rule>
      <rule id="r_rn209_utilizacao">
        <description>RN 209/2009 — utilizacao de servicos, mensal — DRAFT/verify</description>
        <inputEntry id="r_rn209_utilizacao_i1"><text>"RN_209_UTILIZACAO"</text></inputEntry>
        <inputEntry id="r_rn209_utilizacao_i2"><text>-</text></inputEntry>
        <outputEntry id="r_rn209_utilizacao_o1"><text>"DRAFT_DUE_DATE"</text></outputEntry>
        <outputEntry id="r_rn209_utilizacao_o2"><text>"DRAFT_ALERTA"</text></outputEntry>
        <outputEntry id="r_rn209_utilizacao_o3"><text>"mensal"</text></outputEntry>
        <outputEntry id="r_rn209_utilizacao_o4"><text>"RN 209/2009 — utilizacao de servicos: periodicidade mensal: DRAFT/verify regulatorio"</text></outputEntry>
      </rule>
      <rule id="r_rn388_qualidade">
        <description>RN 388/2015 — indicadores de qualidade, anual — DRAFT/verify</description>
        <inputEntry id="r_rn388_qualidade_i1"><text>"RN_388_QUALIDADE"</text></inputEntry>
        <inputEntry id="r_rn388_qualidade_i2"><text>-</text></inputEntry>
        <outputEntry id="r_rn388_qualidade_o1"><text>"DRAFT_DUE_DATE"</text></outputEntry>
        <outputEntry id="r_rn388_qualidade_o2"><text>"DRAFT_ALERTA"</text></outputEntry>
        <outputEntry id="r_rn388_qualidade_o3"><text>"anual"</text></outputEntry>
        <outputEntry id="r_rn388_qualidade_o4"><text>"RN 388/2015 — indicadores de qualidade: periodicidade anual: DRAFT/verify regulatorio"</text></outputEntry>
      </rule>
      <rule id="r_rn424_tiss">
        <description>RN 424/2017 — padrao TISS / monitoramento, mensal — DRAFT/verify</description>
        <inputEntry id="r_rn424_tiss_i1"><text>"RN_424_TISS_MONITORAMENTO"</text></inputEntry>
        <inputEntry id="r_rn424_tiss_i2"><text>-</text></inputEntry>
        <outputEntry id="r_rn424_tiss_o1"><text>"DRAFT_DUE_DATE"</text></outputEntry>
        <outputEntry id="r_rn424_tiss_o2"><text>"DRAFT_ALERTA"</text></outputEntry>
        <outputEntry id="r_rn424_tiss_o3"><text>"mensal"</text></outputEntry>
        <outputEntry id="r_rn424_tiss_o4"><text>"RN 424/2017 — TISS/monitoramento: periodicidade mensal: DRAFT/verify regulatorio"</text></outputEntry>
      </rule>
      <rule id="r_diops_trimestral">
        <description>DIOPS — economico-financeiro, trimestral — DRAFT/verify</description>
        <inputEntry id="r_diops_trimestral_i1"><text>"DIOPS_TRIMESTRAL"</text></inputEntry>
        <inputEntry id="r_diops_trimestral_i2"><text>-</text></inputEntry>
        <outputEntry id="r_diops_trimestral_o1"><text>"DRAFT_DUE_DATE"</text></outputEntry>
        <outputEntry id="r_diops_trimestral_o2"><text>"DRAFT_ALERTA"</text></outputEntry>
        <outputEntry id="r_diops_trimestral_o3"><text>"trimestral"</text></outputEntry>
        <outputEntry id="r_diops_trimestral_o4"><text>"DIOPS — economico-financeiro: periodicidade trimestral: DRAFT/verify regulatorio"</text></outputEntry>
      </rule>
      <rule id="r_catchall">
        <description>Catch-all FAIL-SAFE: report_type/competencia desconhecidos -> due_date/sla_alerta conservadores + fonte REVISAO_HUMANA (roteia a humano; nunca prazo "infinito" nem envio de tipo desconhecido)</description>
        <inputEntry id="r_catchall_i1"><text>-</text></inputEntry>
        <inputEntry id="r_catchall_i2"><text>-</text></inputEntry>
        <outputEntry id="r_catchall_o1"><text>"DRAFT_DUE_DATE"</text></outputEntry>
        <outputEntry id="r_catchall_o2"><text>"DRAFT_ALERTA"</text></outputEntry>
        <outputEntry id="r_catchall_o3"><text>"indeterminada"</text></outputEntry>
        <outputEntry id="r_catchall_o4"><text>"REVISAO_HUMANA — report_type/competencia desconhecidos; revisao humana obrigatoria: DRAFT/verify"</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
</definitions>
