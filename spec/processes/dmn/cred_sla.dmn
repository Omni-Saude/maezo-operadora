<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/"
             xmlns:dmndi="https://www.omg.org/spec/DMN/20191111/DMNDI/"
             xmlns:camunda="http://camunda.org/schema/1.0/dmn"
             id="defs_cred_sla"
             name="SLA de analise de (des)credenciamento"
             namespace="http://maezo.health/dmn/operadora">
  <description>
    cred_sla v0.1.0 — status: DRAFT — TODOS os prazos marcados DRAFT/verify: confirmar texto vigente
    com regulatorio/juridico (RN 566/567 — prazo de analise de rede; consolidacoes ANS;
    docs/review-queue.md). Consumida por SP-OP-CRED-001 e mcp-dmn.
    NOTA: prazos regulatorios sao em dias UTEIS / por vezes corridos; ISO 8601 usa dias corridos —
    valores abaixo sao aproximacao conservadora. Resolver calendario util no worker. Prazo regulatorio
    vive AQUI (DMN) e no timer BPMN — nunca em Python (CONTRIBUTING). Saidas de prazo sao string ISO
    8601 (sla_analise, sla_alerta); fonte_regulatoria e a RN citada (registrada para auditoria).
    INVARIANTE L1 HARD: esta tabela NAO tem saida adversa; no estouro de SLA a coordenacao humana
    assume (nunca auto-descredencia/auto-nega por timeout).
    NOTA hitPolicy: FIRST (catch-all conservador como ultima row). Espelha cancel_sla.
  </description>
  <decision id="cred_sla" name="SLA de analise de (des)credenciamento" camunda:historyTimeToLive="P180D">
    <decisionTable id="dt_cred_sla" hitPolicy="FIRST">
      <input id="in_direcao" label="Direcao (direcao)">
        <inputExpression id="ie_direcao" typeRef="string"><text>direcao</text></inputExpression>
      </input>
      <input id="in_tipo_prestador" label="Tipo do prestador (tipo_prestador)">
        <inputExpression id="ie_tipo_prestador" typeRef="string"><text>tipo_prestador</text></inputExpression>
      </input>
      <output id="out_sla_analise" label="sla_analise" name="sla_analise" typeRef="string"/>
      <output id="out_sla_alerta" label="sla_alerta" name="sla_alerta" typeRef="string"/>
      <output id="out_fonte" label="fonte_regulatoria" name="fonte_regulatoria" typeRef="string"/>
      <rule id="r_descred_hospital">
        <description>Descredenciamento de hospital -> prazo de analise mais longo (impacto de rede; RN 567)</description>
        <inputEntry id="r_descred_hospital_i1"><text>"descredenciamento"</text></inputEntry>
        <inputEntry id="r_descred_hospital_i2"><text>"hospital"</text></inputEntry>
        <outputEntry id="r_descred_hospital_o1"><text>"P30D"</text></outputEntry>
        <outputEntry id="r_descred_hospital_o2"><text>"P20D"</text></outputEntry>
        <outputEntry id="r_descred_hospital_o3"><text>"RN 567 — descredenciamento hospitalar: analise de impacto de rede ~30 dias: DRAFT/verify"</text></outputEntry>
      </rule>
      <rule id="r_descred">
        <description>Descredenciamento de demais prestadores -> prazo de analise padrao</description>
        <inputEntry id="r_descred_i1"><text>"descredenciamento"</text></inputEntry>
        <inputEntry id="r_descred_i2"><text>-</text></inputEntry>
        <outputEntry id="r_descred_o1"><text>"P20D"</text></outputEntry>
        <outputEntry id="r_descred_o2"><text>"P12D"</text></outputEntry>
        <outputEntry id="r_descred_o3"><text>"RN 566/567 — descredenciamento de prestador: analise ~20 dias: DRAFT/verify"</text></outputEntry>
      </rule>
      <rule id="r_cred">
        <description>Credenciamento -> prazo de analise de admissao a rede (RN 566)</description>
        <inputEntry id="r_cred_i1"><text>"credenciamento"</text></inputEntry>
        <inputEntry id="r_cred_i2"><text>-</text></inputEntry>
        <outputEntry id="r_cred_o1"><text>"P15D"</text></outputEntry>
        <outputEntry id="r_cred_o2"><text>"P10D"</text></outputEntry>
        <outputEntry id="r_cred_o3"><text>"RN 566 — credenciamento de prestador: analise de admissao a rede ~15 dias: DRAFT/verify"</text></outputEntry>
      </rule>
      <rule id="r_catchall">
        <description>Catch-all FAIL-SAFE: direcao nao mapeada -> prazo conservador padrao</description>
        <inputEntry id="r_catchall_i1"><text>-</text></inputEntry>
        <inputEntry id="r_catchall_i2"><text>-</text></inputEntry>
        <outputEntry id="r_catchall_o1"><text>"P20D"</text></outputEntry>
        <outputEntry id="r_catchall_o2"><text>"P12D"</text></outputEntry>
        <outputEntry id="r_catchall_o3"><text>"Fail-safe: prazo conservador na ausencia de classificacao — DRAFT/verify"</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
</definitions>
