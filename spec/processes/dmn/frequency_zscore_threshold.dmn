<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/"
             xmlns:dmndi="https://www.omg.org/spec/DMN/20191111/DMNDI/"
             xmlns:dc="http://www.omg.org/spec/DMN/20180521/DC/"
             xmlns:camunda="http://camunda.org/schema/1.0/dmn"
             id="defs_frequency_zscore_threshold"
             name="Frequency Z-Score Threshold (indicador de montagem)"
             namespace="http://maezo.health/dmn/operadora">
  <!-- T2.7 (artifact phase, rework cycle 2): portada 1:1 (byte-fiel) do v1 donor
       Maezo-Healthcare-Plan src/maezo/processes/dmn/fraude_scoring/frequency_zscore_threshold.dmn
       (commit 1ba8cb8). ERA ORFAO DELIBERADO (orphans-allowlist.yaml) ate o wiring do worker
       operadora.fraude.score_indicators — wiring feito (T2.7 fase 2; PERSP-C5-FRAUDE-METADATA).
       Conteudo (scores/limiares) SINTETICO, pendente SME (medico-auditor/financas) —
       docs/review-queue.md. Comentario de proveniencia do donor preservado abaixo. -->
  <!-- PORTADA (copiada+adaptada+OWN — ADR-0011) de
       ../maezo-reference/.../fraud_scoring/frequency_zscore_threshold.dmn. INVERSAO
       (SP-OP-FRAUDE-001): typeRef "number"->"double" (z-score e racional); coluna de veredito
       (resultado) e coluna risco REMOVIDAS; emite indicador_score (integer) + indicador_label +
       motivo — FATO DE MONTAGEM, NUNCA veredito. camunda:historyTimeToLive adicionado;
       namespace -> maezo.health. -->
  <decision id="frequency_zscore_threshold" name="Frequency Z-Score Threshold" camunda:historyTimeToLive="P180D">
    <decisionTable id="dt_frequency_zscore_threshold" hitPolicy="FIRST">
      <input id="in_z_score" label="Z-Score">
        <inputExpression id="ie_z_score" typeRef="double"><text>z_score</text></inputExpression>
      </input>
      <input id="in_encounter_class" label="Encounter Class">
        <inputExpression id="ie_encounter_class_freq" typeRef="string"><text>encounter_class</text></inputExpression>
      </input>
      <output id="out_indicador_score" label="indicador_score" name="indicador_score" typeRef="integer"/>
      <output id="out_indicador_label" label="indicador_label" name="indicador_label" typeRef="string"/>
      <output id="out_motivo" label="motivo" name="motivo" typeRef="string"/>
      <rule id="r_zscore_critical">
        <description>Desvio critico: z-score &gt; 3 — indicador presente de score alto (frequencia muito acima do esperado)</description>
        <inputEntry id="r_zscore_critical_i1"><text>&gt; 3</text></inputEntry>
        <inputEntry id="r_zscore_critical_i2"><text>-</text></inputEntry>
        <outputEntry id="r_zscore_critical_o1"><text>30</text></outputEntry>
        <outputEntry id="r_zscore_critical_o2"><text>"frequency_zscore_threshold"</text></outputEntry>
        <outputEntry id="r_zscore_critical_o3"><text>"Indicador: quantidade de procedimentos muito acima do esperado (z &gt; 3) — fato de montagem de dossie, NUNCA veredito"</text></outputEntry>
      </rule>
      <rule id="r_zscore_high">
        <description>Desvio alto: z-score &gt; 2 — indicador presente</description>
        <inputEntry id="r_zscore_high_i1"><text>&gt; 2</text></inputEntry>
        <inputEntry id="r_zscore_high_i2"><text>-</text></inputEntry>
        <outputEntry id="r_zscore_high_o1"><text>20</text></outputEntry>
        <outputEntry id="r_zscore_high_o2"><text>"frequency_zscore_threshold"</text></outputEntry>
        <outputEntry id="r_zscore_high_o3"><text>"Indicador: quantidade de procedimentos acima do esperado (z &gt; 2) — fato de montagem de dossie"</text></outputEntry>
      </rule>
      <rule id="r_zscore_medium">
        <description>Desvio medio: z-score &gt; 1.5 — indicador moderado</description>
        <inputEntry id="r_zscore_medium_i1"><text>&gt; 1.5</text></inputEntry>
        <inputEntry id="r_zscore_medium_i2"><text>-</text></inputEntry>
        <outputEntry id="r_zscore_medium_o1"><text>10</text></outputEntry>
        <outputEntry id="r_zscore_medium_o2"><text>"frequency_zscore_threshold_moderado"</text></outputEntry>
        <outputEntry id="r_zscore_medium_o3"><text>"Indicador moderado: quantidade de procedimentos ligeiramente acima do esperado (z &gt; 1.5) — fato de montagem de dossie"</text></outputEntry>
      </rule>
      <rule id="r_zscore_normal">
        <description>Desvio normal: z-score &lt;= 1.5 — indicador ausente</description>
        <inputEntry id="r_zscore_normal_i1"><text>&lt;= 1.5</text></inputEntry>
        <inputEntry id="r_zscore_normal_i2"><text>-</text></inputEntry>
        <outputEntry id="r_zscore_normal_o1"><text>0</text></outputEntry>
        <outputEntry id="r_zscore_normal_o2"><text>"none"</text></outputEntry>
        <outputEntry id="r_zscore_normal_o3"><text>"Sem indicador de frequencia: quantidade de procedimentos dentro da faixa normal — fato de montagem de dossie"</text></outputEntry>
      </rule>
      <rule id="r_catchall">
        <description>Catch-all: z-score desconhecido — indicador moderado (requer avaliacao na montagem). A tabela alimenta o dossie, nao decide.</description>
        <inputEntry id="r_catchall_i1"><text>-</text></inputEntry>
        <inputEntry id="r_catchall_i2"><text>-</text></inputEntry>
        <outputEntry id="r_catchall_o1"><text>10</text></outputEntry>
        <outputEntry id="r_catchall_o2"><text>"frequency_zscore_threshold_indeterminado"</text></outputEntry>
        <outputEntry id="r_catchall_o3"><text>"Indicador moderado: z-score desconhecido — requer avaliacao na montagem do dossie"</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
</definitions>
