<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/"
             xmlns:dmndi="https://www.omg.org/spec/DMN/20191111/DMNDI/"
             xmlns:dc="http://www.omg.org/spec/DMN/20180521/DC/"
             xmlns:camunda="http://camunda.org/schema/1.0/dmn"
             id="defs_phantom_suspicious_prefix"
             name="Phantom Billing Suspicious Prefix (indicador de montagem)"
             namespace="http://maezo.health/dmn/operadora">
  <!-- T2.7 (artifact phase, rework cycle 2): portada 1:1 (byte-fiel) do v1 donor
       Maezo-Healthcare-Plan src/maezo/processes/dmn/fraude_scoring/phantom_suspicious_prefix.dmn
       (commit 1ba8cb8). ORFAO DELIBERADO (orphans-allowlist.yaml) ate o wiring do worker
       operadora.fraude.score_indicators — T2.7 fase 2, apos o ADR de avaliacao DMN do T1.4.
       Conteudo (scores/limiares) SINTETICO, pendente SME (medico-auditor/financas) —
       docs/review-queue.md. Comentario de proveniencia do donor preservado abaixo. -->
  <!-- PORTADA (copiada+adaptada+OWN — ADR-0011) de
       ../maezo-reference/.../fraud_scoring/phantom_suspicious_prefix.dmn. INVERSAO
       (SP-OP-FRAUDE-001): coluna de veredito (resultado) e coluna risco REMOVIDAS; emite apenas
       indicador_score (integer) + indicador_label + motivo — FATO DE MONTAGEM, NUNCA veredito.
       Mantem as expressoes FEEL "starts with(...)" do reference. Cada row testa um prefixo distinto;
       catch-all final neutro. camunda:historyTimeToLive adicionado; namespace -> maezo.health. -->
  <decision id="phantom_suspicious_prefix" name="Phantom Billing Suspicious Prefix" camunda:historyTimeToLive="P180D">
    <decisionTable id="dt_phantom_suspicious_prefix" hitPolicy="FIRST">
      <input id="in_tuss_prefix" label="TUSS Code Prefix">
        <inputExpression id="ie_tuss_prefix" typeRef="string"><text>tuss_prefix</text></inputExpression>
      </input>
      <output id="out_indicador_score" label="indicador_score" name="indicador_score" typeRef="integer"/>
      <output id="out_indicador_label" label="indicador_label" name="indicador_label" typeRef="string"/>
      <output id="out_motivo" label="motivo" name="motivo" typeRef="string"/>
      <rule id="r_suspicious_prefix">
        <description>Prefixo suspeito '99' — indicador presente (faturamento fantasma comum)</description>
        <inputEntry id="r_suspicious_prefix_i1"><text>starts with(tuss_prefix, "99")</text></inputEntry>
        <outputEntry id="r_suspicious_prefix_o1"><text>25</text></outputEntry>
        <outputEntry id="r_suspicious_prefix_o2"><text>"phantom_suspicious_prefix"</text></outputEntry>
        <outputEntry id="r_suspicious_prefix_o3"><text>"Indicador: codigos com prefixo suspeito '99' identificados — fato de montagem de dossie, NUNCA veredito"</text></outputEntry>
      </rule>
      <rule id="r_highrisk_prefix">
        <description>Prefixo '98' — indicador moderado (risco moderado de faturamento fantasma)</description>
        <inputEntry id="r_highrisk_prefix_i1"><text>starts with(tuss_prefix, "98")</text></inputEntry>
        <outputEntry id="r_highrisk_prefix_o1"><text>15</text></outputEntry>
        <outputEntry id="r_highrisk_prefix_o2"><text>"phantom_suspicious_prefix_moderado"</text></outputEntry>
        <outputEntry id="r_highrisk_prefix_o3"><text>"Indicador moderado: prefixo '98' requer verificacao — fato de montagem de dossie"</text></outputEntry>
      </rule>
      <rule id="r_watchlist_prefix">
        <description>Prefixo '00' em lista de monitoramento — indicador moderado</description>
        <inputEntry id="r_watchlist_prefix_i1"><text>starts with(tuss_prefix, "00")</text></inputEntry>
        <outputEntry id="r_watchlist_prefix_o1"><text>15</text></outputEntry>
        <outputEntry id="r_watchlist_prefix_o2"><text>"phantom_suspicious_prefix_moderado"</text></outputEntry>
        <outputEntry id="r_watchlist_prefix_o3"><text>"Indicador moderado: prefixo '00' em lista de monitoramento — verificar validade do codigo na montagem"</text></outputEntry>
      </rule>
      <rule id="r_normal_prefix">
        <description>Prefixo dentro do padrao normal — indicador ausente</description>
        <inputEntry id="r_normal_prefix_i1"><text>not(starts with(tuss_prefix, "99"))</text></inputEntry>
        <outputEntry id="r_normal_prefix_o1"><text>0</text></outputEntry>
        <outputEntry id="r_normal_prefix_o2"><text>"none"</text></outputEntry>
        <outputEntry id="r_normal_prefix_o3"><text>"Sem indicador de prefixo suspeito: prefixo dentro do padrao normal — fato de montagem de dossie"</text></outputEntry>
      </rule>
      <rule id="r_catchall">
        <description>Catch-all: prefixo desconhecido — indicador moderado (requer avaliacao na montagem). A tabela alimenta o dossie, nao decide.</description>
        <inputEntry id="r_catchall_i1"><text>-</text></inputEntry>
        <outputEntry id="r_catchall_o1"><text>10</text></outputEntry>
        <outputEntry id="r_catchall_o2"><text>"phantom_suspicious_prefix_indeterminado"</text></outputEntry>
        <outputEntry id="r_catchall_o3"><text>"Indicador moderado: prefixo desconhecido — requer avaliacao na montagem do dossie"</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
</definitions>
