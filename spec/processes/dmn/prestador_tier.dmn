        <inputEntry id="r_pico_ausente_i3"><text>-</text></inputEntry>
        <inputEntry id="r_pico_ausente_i4"><text>-</text></inputEntry>
        <inputEntry id="r_pico_ausente_i5"><text>-</text></inputEntry>
        <inputEntry id="r_pico_ausente_i6"><text>null</text></inputEntry>
