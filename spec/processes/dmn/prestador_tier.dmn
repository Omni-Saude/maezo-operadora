        <inputEntry id="r_pontuacao_invalida_i2"><text>-</text></inputEntry>
        <inputEntry id="r_pontuacao_invalida_i3"><text>-</text></inputEntry>
        <inputEntry id="r_pontuacao_invalida_i4"><text>-</text></inputEntry>
        <inputEntry id="r_pontuacao_invalida_i5"><text>-</text></inputEntry>
        <inputEntry id="r_pontuacao_invalida_i6"><text>-</text></inputEntry>
        <inputEntry id="r_pontuacao_invalida_i7"><text>-</text></inputEntry>
        <inputEntry id="r_pontuacao_invalida_i8"><text>-</text></inputEntry>
        <inputEntry id="r_pontuacao_invalida_i9"><text>-</text></inputEntry>
        <outputEntry id="r_pontuacao_invalida_o1"><text>"WATCH"</text></outputEntry>
        <outputEntry id="r_pontuacao_invalida_o2"><text>"PONTUACAO_FORA_DA_ESCALA"</text></outputEntry>
      </rule>
      <rule id="r_red_flag_pico">
        <description>F6 pico de faturamento -> WATCH no ciclo (nao compensatorio: nenhuma pontuacao anula)</description>
        <inputEntry id="r_red_flag_pico_i1"><text>-</text></inputEntry>
        <inputEntry id="r_red_flag_pico_i2"><text>-</text></inputEntry>
        <inputEntry id="r_red_flag_pico_i3"><text>-</text></inputEntry>
        <inputEntry id="r_red_flag_pico_i4"><text>-</text></inputEntry>
        <inputEntry id="r_red_flag_pico_i5"><text>-</text></inputEntry>
        <inputEntry id="r_red_flag_pico_i6"><text>true</text></inputEntry>
        <inputEntry id="r_red_flag_pico_i7"><text>-</text></inputEntry>
        <inputEntry id="r_red_flag_pico_i8"><text>-</text></inputEntry>
        <inputEntry id="r_red_flag_pico_i9"><text>-</text></inputEntry>
        <outputEntry id="r_red_flag_pico_o1"><text>"WATCH"</text></outputEntry>
        <outputEntry id="r_red_flag_pico_o2"><text>"RED_FLAG_PICO_FATURAMENTO"</text></outputEntry>
      </rule>
      <rule id="r_fraude_monitorar">
        <description>FRAUDE encerrada em MONITORAR nos ultimos 12 meses -> WATCH (nao compensatorio)</description>
        <inputEntry id="r_fraude_monitorar_i1"><text>-</text></inputEntry>
        <inputEntry id="r_fraude_monitorar_i2"><text>-</text></inputEntry>
        <inputEntry id="r_fraude_monitorar_i3"><text>-</text></inputEntry>
        <inputEntry id="r_fraude_monitorar_i4"><text>-</text></inputEntry>
        <inputEntry id="r_fraude_monitorar_i5"><text>-</text></inputEntry>
        <inputEntry id="r_fraude_monitorar_i6"><text>-</text></inputEntry>
        <inputEntry id="r_fraude_monitorar_i7"><text>true</text></inputEntry>
        <inputEntry id="r_fraude_monitorar_i8"><text>-</text></inputEntry>
        <inputEntry id="r_fraude_monitorar_i9"><text>-</text></inputEntry>
        <outputEntry id="r_fraude_monitorar_o1"><text>"WATCH"</text></outputEntry>
        <outputEntry id="r_fraude_monitorar_o2"><text>"RED_FLAG_FRAUDE_MONITORAR_12M"</text></outputEntry>
      </rule>
      <rule id="r_prestador_novo">
        <description>Menos de N=10 pagamentos liberados por humano -> WATCH (decisao do dono: novos em WATCH ate N)</description>
        <inputEntry id="r_prestador_novo_i1"><text>-</text></inputEntry>
        <inputEntry id="r_prestador_novo_i2"><text>-</text></inputEntry>
        <inputEntry id="r_prestador_novo_i3"><text>-</text></inputEntry>
        <inputEntry id="r_prestador_novo_i4"><text>-</text></inputEntry>
        <inputEntry id="r_prestador_novo_i5"><text>&lt; 10</text></inputEntry>
        <inputEntry id="r_prestador_novo_i6"><text>-</text></inputEntry>
        <inputEntry id="r_prestador_novo_i7"><text>-</text></inputEntry>
        <inputEntry id="r_prestador_novo_i8"><text>-</text></inputEntry>
        <inputEntry id="r_prestador_novo_i9"><text>-</text></inputEntry>
        <outputEntry id="r_prestador_novo_o1"><text>"WATCH"</text></outputEntry>
        <outputEntry id="r_prestador_novo_o2"><text>"PRESTADOR_NOVO_OU_BAIXO_VOLUME"</text></outputEntry>
      </rule>
      <rule id="r_trusted">
        <description>TRUSTED: gold-card (&gt;= 90% em &gt;= 10 ordens) E F5 &gt;= T=12 meses E pontuacao &gt;= corte_trusted=70 E nenhuma red flag (linhas acima)</description>
        <inputEntry id="r_trusted_i1"><text>[70..85]</text></inputEntry>
        <inputEntry id="r_trusted_i2"><text>&gt;= 10</text></inputEntry>
        <inputEntry id="r_trusted_i3"><text>[0.90..1]</text></inputEntry>
        <inputEntry id="r_trusted_i4"><text>&gt;= 12</text></inputEntry>
        <inputEntry id="r_trusted_i5"><text>-</text></inputEntry>
        <inputEntry id="r_trusted_i6"><text>-</text></inputEntry>
        <inputEntry id="r_trusted_i7"><text>-</text></inputEntry>
        <inputEntry id="r_trusted_i8"><text>-</text></inputEntry>
        <inputEntry id="r_trusted_i9"><text>-</text></inputEntry>
        <outputEntry id="r_trusted_o1"><text>"TRUSTED"</text></outputEntry>
        <outputEntry id="r_trusted_o2"><text>"GOLD_CARD_ATINGIDO"</text></outputEntry>
      </rule>
      <rule id="r_standard">
        <description>STANDARD: pontuacao &gt;= corte_watch=40 sem gold-card completo -> auto dentro do teto reduzido (P6/politica)</description>
        <inputEntry id="r_standard_i1"><text>[40..85]</text></inputEntry>
        <inputEntry id="r_standard_i2"><text>-</text></inputEntry>
        <inputEntry id="r_standard_i3"><text>-</text></inputEntry>
        <inputEntry id="r_standard_i4"><text>-</text></inputEntry>
        <inputEntry id="r_standard_i5"><text>-</text></inputEntry>
        <inputEntry id="r_standard_i6"><text>-</text></inputEntry>
        <inputEntry id="r_standard_i7"><text>-</text></inputEntry>
        <inputEntry id="r_standard_i8"><text>-</text></inputEntry>
        <inputEntry id="r_standard_i9"><text>-</text></inputEntry>
        <outputEntry id="r_standard_o1"><text>"STANDARD"</text></outputEntry>
        <outputEntry id="r_standard_o2"><text>"PONTUACAO_STANDARD"</text></outputEntry>
      </rule>
      <rule id="r_watch_pontuacao">
        <description>Pontuacao abaixo de corte_watch=40 -> WATCH</description>
        <inputEntry id="r_watch_pontuacao_i1"><text>[0..40)</text></inputEntry>
        <inputEntry id="r_watch_pontuacao_i2"><text>-</text></inputEntry>
        <inputEntry id="r_watch_pontuacao_i3"><text>-</text></inputEntry>
        <inputEntry id="r_watch_pontuacao_i4"><text>-</text></inputEntry>
        <inputEntry id="r_watch_pontuacao_i5"><text>-</text></inputEntry>
        <inputEntry id="r_watch_pontuacao_i6"><text>-</text></inputEntry>
        <inputEntry id="r_watch_pontuacao_i7"><text>-</text></inputEntry>
        <inputEntry id="r_watch_pontuacao_i8"><text>-</text></inputEntry>
        <inputEntry id="r_watch_pontuacao_i9"><text>-</text></inputEntry>
        <outputEntry id="r_watch_pontuacao_o1"><text>"WATCH"</text></outputEntry>
        <outputEntry id="r_watch_pontuacao_o2"><text>"PONTUACAO_ABAIXO_DO_CORTE_WATCH"</text></outputEntry>
      </rule>
      <rule id="r_catchall">
        <description>Catch-all FAIL-CLOSED: qualquer combinacao nao mapeada -> WATCH (vai a humano; nunca nega)</description>
        <inputEntry id="r_catchall_i1"><text>-</text></inputEntry>
        <inputEntry id="r_catchall_i2"><text>-</text></inputEntry>
        <inputEntry id="r_catchall_i3"><text>-</text></inputEntry>
        <inputEntry id="r_catchall_i4"><text>-</text></inputEntry>
        <inputEntry id="r_catchall_i5"><text>-</text></inputEntry>
        <inputEntry id="r_catchall_i6"><text>-</text></inputEntry>
        <inputEntry id="r_catchall_i7"><text>-</text></inputEntry>
        <inputEntry id="r_catchall_i8"><text>-</text></inputEntry>
        <inputEntry id="r_catchall_i9"><text>-</text></inputEntry>
        <outputEntry id="r_catchall_o1"><text>"WATCH"</text></outputEntry>
        <outputEntry id="r_catchall_o2"><text>"COMBINACAO_NAO_MAPEADA"</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
</definitions>
