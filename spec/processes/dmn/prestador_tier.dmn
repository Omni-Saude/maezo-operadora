        <inputEntry id="r_taxa_ausente_i2"><text>-</text></inputEntry>
        <inputEntry id="r_taxa_ausente_i3"><text>null</text></inputEntry>
        <inputEntry id="r_taxa_ausente_i4"><text>-</text></inputEntry>
        <inputEntry id="r_taxa_ausente_i5"><text>-</text></inputEntry>
        <inputEntry id="r_taxa_ausente_i6"><text>-</text></inputEntry>
        <inputEntry id="r_taxa_ausente_i7"><text>-</text></inputEntry>
