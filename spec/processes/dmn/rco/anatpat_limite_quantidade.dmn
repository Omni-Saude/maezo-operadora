<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:camunda="http://camunda.org/schema/1.0/dmn" id="def_anatpat_limite_quantidade" name="Anatomia patológica: quantidade por espécime, frasco, amostra, lâmina e linfonodo" namespace="https://omni-saude/dmn/anatomia-patologica">
  <decision id="rco_anatpat_limite_quantidade" name="Anatomia patológica: quantidade por espécime, frasco, amostra, lâmina e linfonodo" camunda:historyTimeToLive="P3650D">
    <description>OMNI-ANATPAT-LIM-0001. Domínio anatomia-patologica. Hit policy UNIQUE; nenhuma linha nega ou glosa; contagem do laudo ausente vai à mesma auditoria médica da contagem acima do documentado e só a contagem declarada libera (OPO-15); a linha de fechamento (data ausente) vai à regulação.</description>
    <decisionTable id="dt_anatpat_limite_quantidade" hitPolicy="UNIQUE">
      <input id="in_dataAtendimento" label="dataAtendimento ← TISS dataSolicitacao (pedido) ou dataExecucao (conta), AAAA-MM-DD">
        <inputExpression id="ie_dataAtendimento" typeRef="string"><text>dataAtendimento</text></inputExpression>
      </input>
      <input id="in_codigoProcedimento" label="codigoProcedimento ← TISS codigoProcedimento (TUSS 22)">
        <inputExpression id="ie_codigoProcedimento" typeRef="string"><text>codigoProcedimento</text></inputExpression>
      </input>
      <input id="in_quantidade" label="quantidade ← TISS quantidadeExecutada do item (inteiro)">
        <inputExpression id="ie_quantidade" typeRef="integer"><text>quantidade</text></inputExpression>
      </input>
      <input id="in_quantidadeAcimaDocumentada" label="quantidadeAcimaDocumentada ← laudo anexo à conta: quantidade cobrada acima das unidades documentadas (true, false ou ausente; ausente vai à auditoria médica)">
        <inputExpression id="ie_quantidadeAcimaDocumentada" typeRef="boolean"><text>quantidadeAcimaDocumentada</text></inputExpression>
      </input>
      <output id="out_decisao" name="decisao" typeRef="string"/>
      <output id="out_motivoTab38" name="motivoTab38" typeRef="string"/>
      <output id="out_idRegra" name="idRegra" typeRef="string"/>
      <output id="out_fila" name="fila" typeRef="string"/>
      <output id="out_classeAdverso" name="classeAdverso" typeRef="string"/>
      <rule id="pre">
        <description>OMNI-ANATPAT-LIM-0001 — antes do início da vigência (03/12/2026): o limite não se aplica</description>
        <inputEntry><text>&lt; "2026-12-16"</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"liberar"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-ANATPAT-LIM-0001"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="q30_rev">
        <description>OMNI-ANATPAT-LIM-0001 — primeiro espécime peroperatório com deslocamento acima do máximo provisório: auditoria médica posterior, sem glosa</description>
        <inputEntry><text>&gt;= "2026-12-16"</text></inputEntry>
        <inputEntry><text>"40601030"</text></inputEntry>
        <inputEntry><text>&gt; 1</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"revisao_humana"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-ANATPAT-LIM-0001"</text></outputEntry>
        <outputEntry><text>"auditoria_medica"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="q30_ok">
        <description>OMNI-ANATPAT-LIM-0001 — primeiro espécime peroperatório com deslocamento dentro do máximo provisório: sem pendência</description>
        <inputEntry><text>&gt;= "2026-12-16"</text></inputEntry>
        <inputEntry><text>"40601030"</text></inputEntry>
        <inputEntry><text>&lt;= 1</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"liberar"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-ANATPAT-LIM-0001"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="q30_nulo">
        <description>OMNI-ANATPAT-LIM-0001 — primeiro espécime peroperatório com deslocamento sem quantidade: regulação, sem negativa</description>
        <inputEntry><text>&gt;= "2026-12-16"</text></inputEntry>
        <inputEntry><text>"40601030"</text></inputEntry>
        <inputEntry><text>null</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"revisao_humana"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-ANATPAT-LIM-0001"</text></outputEntry>
        <outputEntry><text>"regulacao"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="q250_rev">
        <description>OMNI-ANATPAT-LIM-0001 — lâminas de punção aspirativa acima do máximo provisório: auditoria médica posterior, sem glosa</description>
        <inputEntry><text>&gt;= "2026-12-16"</text></inputEntry>
        <inputEntry><text>"40601250"</text></inputEntry>
        <inputEntry><text>&gt; 6</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"revisao_humana"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-ANATPAT-LIM-0001"</text></outputEntry>
        <outputEntry><text>"auditoria_medica"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="q250_ok">
        <description>OMNI-ANATPAT-LIM-0001 — lâminas de punção aspirativa dentro do máximo provisório: sem pendência</description>
        <inputEntry><text>&gt;= "2026-12-16"</text></inputEntry>
        <inputEntry><text>"40601250"</text></inputEntry>
        <inputEntry><text>&lt;= 6</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"liberar"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-ANATPAT-LIM-0001"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="q250_nulo">
        <description>OMNI-ANATPAT-LIM-0001 — lâminas de punção aspirativa sem quantidade: regulação, sem negativa</description>
        <inputEntry><text>&gt;= "2026-12-16"</text></inputEntry>
        <inputEntry><text>"40601250"</text></inputEntry>
        <inputEntry><text>null</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"revisao_humana"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-ANATPAT-LIM-0001"</text></outputEntry>
        <outputEntry><text>"regulacao"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="q226_rev">
        <description>OMNI-ANATPAT-LIM-0001 — grupos de linfonodos e margens acima do máximo provisório: auditoria médica posterior, sem glosa</description>
        <inputEntry><text>&gt;= "2026-12-16"</text></inputEntry>
        <inputEntry><text>"40601226"</text></inputEntry>
        <inputEntry><text>&gt; 6</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"revisao_humana"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-ANATPAT-LIM-0001"</text></outputEntry>
        <outputEntry><text>"auditoria_medica"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="q226_ok">
        <description>OMNI-ANATPAT-LIM-0001 — grupos de linfonodos e margens dentro do máximo provisório: sem pendência</description>
        <inputEntry><text>&gt;= "2026-12-16"</text></inputEntry>
        <inputEntry><text>"40601226"</text></inputEntry>
        <inputEntry><text>&lt;= 6</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"liberar"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-ANATPAT-LIM-0001"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="q226_nulo">
        <description>OMNI-ANATPAT-LIM-0001 — grupos de linfonodos e margens sem quantidade: regulação, sem negativa</description>
        <inputEntry><text>&gt;= "2026-12-16"</text></inputEntry>
        <inputEntry><text>"40601226"</text></inputEntry>
        <inputEntry><text>null</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"revisao_humana"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-ANATPAT-LIM-0001"</text></outputEntry>
        <outputEntry><text>"regulacao"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="u_rev">
        <description>OMNI-ANATPAT-LIM-0001 — espécime adicional, frasco ou amostra acima do documentado no laudo ou sem a contagem informada: auditoria médica posterior, sem glosa</description>
        <inputEntry><text>&gt;= "2026-12-16"</text></inputEntry>
        <inputEntry><text>"40601021", "40601110", "40601137"</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>not(false)</text></inputEntry>
        <outputEntry><text>"revisao_humana"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-ANATPAT-LIM-0001"</text></outputEntry>
        <outputEntry><text>"auditoria_medica"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="u_ok">
        <description>OMNI-ANATPAT-LIM-0001 — espécime adicional, frasco ou amostra dentro do documentado no laudo: sem pendência</description>
        <inputEntry><text>&gt;= "2026-12-16"</text></inputEntry>
        <inputEntry><text>"40601021", "40601110", "40601137"</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>false</text></inputEntry>
        <outputEntry><text>"liberar"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-ANATPAT-LIM-0001"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="resto">
        <description>OMNI-ANATPAT-LIM-0001 — código sem limite nesta tabela: libera</description>
        <inputEntry><text>&gt;= "2026-12-16"</text></inputEntry>
        <inputEntry><text>not("40601021", "40601030", "40601110", "40601137", "40601226", "40601250")</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"liberar"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-ANATPAT-LIM-0001"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="fim">
        <description>OMNI-ANATPAT-LIM-0001 — data ausente: regulação, sem negativa</description>
        <inputEntry><text>null</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"revisao_humana"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-ANATPAT-LIM-0001"</text></outputEntry>
        <outputEntry><text>"regulacao"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
</definitions>
