<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:camunda="http://camunda.org/schema/1.0/dmn" id="def_anestdor_autorizacao" name="Anestesia, terapia da dor e acupuntura: autorização prévia (bloqueios, TENS pela DUT 24, anestesia do art. 8º, continuidade, urgência)" namespace="https://omni-saude/dmn/anestesia-terapia-dor">
  <decision id="rco_anestdor_autorizacao" name="Anestesia, terapia da dor e acupuntura: autorização prévia (bloqueios, TENS pela DUT 24, anestesia do art. 8º, continuidade, urgência)" camunda:historyTimeToLive="P3650D">
    <description>OMNI-ANESTDOR-AUT-0001 a OMNI-ANESTDOR-AUT-0005. Hit policy UNIQUE; nenhuma linha nega, glosa ou exige autorização: pedido completo libera, incompleto gera a lista do que falta (exigir_documento), enquadramento clínico e dado ausente vão à revisão humana. Toda linha que exige documento lê caraterAtendimento: urgência (2) libera e caráter ausente vai à regulação. Classe do código em dominio.yaml (classes). A linha final (data ausente) vai à revisão humana.</description>
    <decisionTable id="dt_anestdor_autorizacao" hitPolicy="UNIQUE">
      <input id="in_0_dataAtendimento" label="dataAtendimento ← TISS dataExecucao (conta) ou dataSolicitacao (pedido), AAAA-MM-DD">
        <inputExpression id="ie_0_dataAtendimento" typeRef="string"><text>dataAtendimento</text></inputExpression>
      </input>
      <input id="in_1_classeProcedimento" label="classeProcedimento ← TISS codigoProcedimento (TUSS 22) classificado por dominio.yaml (classes): bloqueios_dor | estimulacao_eletrica_transcutanea | acupuntura | anestesia_assegurada_art_8 | recuperacao_pos_anestesica_plantonista">
        <inputExpression id="ie_1_classeProcedimento" typeRef="string"><text>classeProcedimento</text></inputExpression>
      </input>
      <input id="in_2_caraterAtendimento" label="caraterAtendimento ← TISS caraterAtendimento (TUSS 23: 1 eletivo, 2 urgência ou emergência)">
        <inputExpression id="ie_2_caraterAtendimento" typeRef="string"><text>caraterAtendimento</text></inputExpression>
      </input>
      <input id="in_3_cursoRegistrado" label="cursoRegistrado ← TISS numeroGuiaSolicitacao ou senha: guia vinculada a solicitação já registrada do mesmo tratamento, beneficiário e código">
        <inputExpression id="ie_3_cursoRegistrado" typeRef="boolean"><text>cursoRegistrado</text></inputExpression>
      </input>
      <input id="in_4_procedimentoCirurgicoNaGuia" label="procedimentoCirurgicoNaGuia ← TISS codigoProcedimento: procedimento cirúrgico principal na mesma guia">
        <inputExpression id="ie_4_procedimentoCirurgicoNaGuia" typeRef="boolean"><text>procedimentoCirurgicoNaGuia</text></inputExpression>
      </input>
      <input id="in_5_documentacaoCompleta" label="documentacaoCompleta ← solicitação: pedido do médico assistente com a indicação e o plano do ciclo anexados (anexo da guia TISS)">
        <inputExpression id="ie_5_documentacaoCompleta" typeRef="boolean"><text>documentacaoCompleta</text></inputExpression>
      </input>
      <input id="in_6_enquadramentoDut24" label="enquadramentoDut24 ← solicitação: relatório informa pelo menos um critério do grupo I da DUT 24 (campo fora da TISS)">
        <inputExpression id="ie_6_enquadramentoDut24" typeRef="boolean"><text>enquadramentoDut24</text></inputExpression>
      </input>
      <input id="in_7_contraindicacaoDut24" label="contraindicacaoDut24 ← solicitação: relatório aponta critério do grupo II da DUT 24 (campo fora da TISS)">
        <inputExpression id="ie_7_contraindicacaoDut24" typeRef="boolean"><text>contraindicacaoDut24</text></inputExpression>
      </input>
      <input id="in_8_planoSoAmbulatorial" label="planoSoAmbulatorial ← cadastro: segmentação do plano do beneficiário é só ambulatorial">
        <inputExpression id="ie_8_planoSoAmbulatorial" typeRef="boolean"><text>planoSoAmbulatorial</text></inputExpression>
      </input>
      <input id="in_9_tipoAnestesia" label="tipoAnestesia ← anexo: ficha anestésica, tipo de anestesia (local, sedacao, bloqueio, geral, regional; campo fora da TISS)">
        <inputExpression id="ie_9_tipoAnestesia" typeRef="string"><text>tipoAnestesia</text></inputExpression>
      </input>
      <output id="out_0_decisao" name="decisao" typeRef="string"/>
      <output id="out_1_motivoTab38" name="motivoTab38" typeRef="string"/>
      <output id="out_2_idRegra" name="idRegra" typeRef="string"/>
      <output id="out_3_fila" name="fila" typeRef="string"/>
      <output id="out_classeAdverso" name="classeAdverso" typeRef="string"/>
      <rule id="r_pre">
        <description>Antes da vigência (2026-12-03): nenhuma regra do domínio vale</description>
        <inputEntry><text>&lt; "2026-12-03"</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
