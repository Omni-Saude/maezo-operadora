        <inputEntry><text>"bloqueios_dor", "estimulacao_eletrica_transcutanea", "acupuntura", "anestesia_assegurada_art_8", "recuperacao_pos_anestesica_plantonista"</text></inputEntry>
        <inputEntry><text>not("1", "2")</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
