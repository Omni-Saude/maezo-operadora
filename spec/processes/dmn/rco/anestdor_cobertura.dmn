<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:camunda="http://camunda.org/schema/1.0/dmn" id="def_anestdor_cobertura" name="Anestesia, terapia da dor e acupuntura: cobertura (anuloplastia, auxiliar de anestesia, consulta pré-anestésica, toxina para síndrome miofascial)" namespace="https://omni-saude/dmn/anestesia-terapia-dor">
  <decision id="rco_anestdor_cobertura" name="Anestesia, terapia da dor e acupuntura: cobertura (anuloplastia, auxiliar de anestesia, consulta pré-anestésica, toxina para síndrome miofascial)" camunda:historyTimeToLive="P3650D">
    <description>OMNI-ANESTDOR-COB-0001 a OMNI-ANESTDOR-COB-0004. Hit policy UNIQUE; nenhuma linha nega ou glosa: o que exige conferência vai à revisão humana (auditoria médica, faturamento ou regulação) e dado ausente vai à regulação; a linha final (data ausente) vai à revisão humana. Limiar de duração do auxiliar (6 h) e de neonato (28 dias) são parâmetros provisórios do dominio.yaml, aplicados pelo worker nas entradas derivadas.</description>
    <decisionTable id="dt_anestdor_cobertura" hitPolicy="UNIQUE">
      <input id="in_0_dataAtendimento" label="dataAtendimento ← TISS dataExecucao (conta) ou dataSolicitacao (pedido), AAAA-MM-DD">
        <inputExpression id="ie_0_dataAtendimento" typeRef="string"><text>dataAtendimento</text></inputExpression>
      </input>
      <input id="in_1_descricaoCitaAnuloNucleoplastia" label="descricaoCitaAnuloNucleoplastia ← TISS descricaoProcedimento da guia (texto livre cita anuloplastia ou nucleoplastia; sem código TUSS 22 correspondente)">
        <inputExpression id="ie_1_descricaoCitaAnuloNucleoplastia" typeRef="boolean"><text>descricaoCitaAnuloNucleoplastia</text></inputExpression>
      </input>
      <input id="in_2_codigoProcedimento" label="codigoProcedimento ← TISS codigoProcedimento (TUSS 22)">
        <inputExpression id="ie_2_codigoProcedimento" typeRef="string"><text>codigoProcedimento</text></inputExpression>
      </input>
      <input id="in_3_cboExecutante" label="cboExecutante ← TISS CBO do profissional executante (Tabela 24)">
        <inputExpression id="ie_3_cboExecutante" typeRef="string"><text>cboExecutante</text></inputExpression>
      </input>
      <input id="in_4_visitaPreAnestesicaNaInternacao" label="visitaPreAnestesicaNaInternacao ← fluxo Camunda: visita hospitalar 10102019 do anestesiologista na mesma internação, antes do ato anestésico (grauParticipacao 06)">
        <inputExpression id="ie_4_visitaPreAnestesicaNaInternacao" typeRef="boolean"><text>visitaPreAnestesicaNaInternacao</text></inputExpression>
      </input>
      <input id="in_5_indicacaoSmf" label="indicacaoSmf ← solicitação: relatório do médico assistente declara síndrome miofascial (campo fora da TISS)">
        <inputExpression id="ie_5_indicacaoSmf" typeRef="boolean"><text>indicacaoSmf</text></inputExpression>
      </input>
      <input id="in_6_grauParticipacao" label="grauParticipacao ← TISS grauParticipacao (Tabela 35: 06 anestesista, 07 auxiliar de anestesista, 09 perfusionista)">
        <inputExpression id="ie_6_grauParticipacao" typeRef="string"><text>grauParticipacao</text></inputExpression>
      </input>
      <input id="in_7_atoAcimaDuracaoMinima" label="atoAcimaDuracaoMinima ← TISS horaInicial e horaFinal do ato anestésico, derivado pelo worker contra o limiar de horas do dominio.yaml">
        <inputExpression id="ie_7_atoAcimaDuracaoMinima" typeRef="boolean"><text>atoAcimaDuracaoMinima</text></inputExpression>
      </input>
      <input id="in_8_perfusionistaNaEquipe" label="perfusionistaNaEquipe ← TISS grauParticipacao 09 (perfusionista) na equipe do ato, derivado pelo worker">
        <inputExpression id="ie_8_perfusionistaNaEquipe" typeRef="boolean"><text>perfusionistaNaEquipe</text></inputExpression>
      </input>
      <input id="in_9_beneficiarioNeonato" label="beneficiarioNeonato ← cadastro dataNascimento e TISS dataExecucao, derivado pelo worker contra o limiar de dias do dominio.yaml">
        <inputExpression id="ie_9_beneficiarioNeonato" typeRef="boolean"><text>beneficiarioNeonato</text></inputExpression>
      </input>
      <output id="out_0_decisao" name="decisao" typeRef="string"/>
      <output id="out_1_motivoTab38" name="motivoTab38" typeRef="string"/>
      <output id="out_2_idRegra" name="idRegra" typeRef="string"/>
      <output id="out_3_fila" name="fila" typeRef="string"/>
      <output id="out_classeAdverso" name="classeAdverso" typeRef="string"/>
      <rule id="r_pre">
        <description>Antes da vigência (2026-12-03): nenhuma regra do domínio vale</description>
        <inputEntry><text>&lt; "2026-12-03"</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
