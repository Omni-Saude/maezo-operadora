<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:camunda="http://camunda.org/schema/1.0/dmn" id="def_anestdor_compatibilidade" name="Anestesia, terapia da dor e acupuntura: compatibilidade da anestesia com o procedimento principal e plantonista da recuperação pós-anestésica" namespace="https://omni-saude/dmn/anestesia-terapia-dor">
  <decision id="rco_anestdor_compatibilidade" name="Anestesia, terapia da dor e acupuntura: compatibilidade da anestesia com o procedimento principal e plantonista da recuperação pós-anestésica" camunda:historyTimeToLive="P3650D">
    <description>OMNI-ANESTDOR-CMP-0001 e OMNI-ANESTDOR-CMP-0002. Hit policy UNIQUE; nenhuma linha nega ou glosa: divergência vai à revisão do faturamento, dado ausente à regulação, conta conforme é liberada; a linha final (data ausente) vai à revisão humana. A compatibilidade do grupo da Tabela 63 do principal com o termo da anestesia (compatibilidade_anestesia de dominio.yaml) é derivada pelo worker em grupoTuss63Compativel.</description>
    <decisionTable id="dt_anestdor_compatibilidade" hitPolicy="UNIQUE">
      <input id="in_0_dataAtendimento" label="dataAtendimento ← TISS dataExecucao (conta) ou dataSolicitacao (pedido), AAAA-MM-DD">
        <inputExpression id="ie_0_dataAtendimento" typeRef="string"><text>dataAtendimento</text></inputExpression>
      </input>
      <input id="in_1_codigoProcedimento" label="codigoProcedimento ← TISS codigoProcedimento (TUSS 22) do item cobrado">
        <inputExpression id="ie_1_codigoProcedimento" typeRef="string"><text>codigoProcedimento</text></inputExpression>
      </input>
      <input id="in_2_procedimentoPrincipalNaGuia" label="procedimentoPrincipalNaGuia ← TISS codigoProcedimento: procedimento principal coberto na mesma guia e na mesma dataExecucao">
        <inputExpression id="ie_2_procedimentoPrincipalNaGuia" typeRef="boolean"><text>procedimentoPrincipalNaGuia</text></inputExpression>
      </input>
      <input id="in_3_grupoTuss63Compativel" label="grupoTuss63Compativel ← cadastro: grupo da Tabela 63 do procedimento principal (Tabela 64) comparado ao termo da anestesia em compatibilidade_anestesia de dominio.yaml, derivado pelo worker">
        <inputExpression id="ie_3_grupoTuss63Compativel" typeRef="boolean"><text>grupoTuss63Compativel</text></inputExpression>
      </input>
      <input id="in_4_justificativaAnestesiologista" label="justificativaAnestesiologista ← anexo: justificativa do anestesiologista para ato sem porte ou de imperativo clínico (campo fora da TISS)">
        <inputExpression id="ie_4_justificativaAnestesiologista" typeRef="boolean"><text>justificativaAnestesiologista</text></inputExpression>
      </input>
      <input id="in_5_fichaAnestesicaCompleta" label="fichaAnestesicaCompleta ← anexo: ficha anestésica com início, fim, técnica e anestesiologista (campo fora da TISS)">
        <inputExpression id="ie_5_fichaAnestesicaCompleta" typeRef="boolean"><text>fichaAnestesicaCompleta</text></inputExpression>
      </input>
      <input id="in_6_anestesistaNaEquipe" label="anestesistaNaEquipe ← TISS grauParticipacao 06 (anestesista) na equipe do ato">
        <inputExpression id="ie_6_anestesistaNaEquipe" typeRef="boolean"><text>anestesistaNaEquipe</text></inputExpression>
      </input>
      <input id="in_7_destinoDiretoUti" label="destinoDiretoUti ← anexo: paciente vai da sala cirúrgica direto à UTI ou ao CTI (campo fora da TISS)">
        <inputExpression id="ie_7_destinoDiretoUti" typeRef="boolean"><text>destinoDiretoUti</text></inputExpression>
      </input>
      <input id="in_8_horasRpaAcimaDoTermo" label="horasRpaAcimaDoTermo ← TISS quantidadeExecutada acima das horas registradas na sala de recuperação, derivado pelo worker">
        <inputExpression id="ie_8_horasRpaAcimaDoTermo" typeRef="boolean"><text>horasRpaAcimaDoTermo</text></inputExpression>
      </input>
      <output id="out_0_decisao" name="decisao" typeRef="string"/>
      <output id="out_1_motivoTab38" name="motivoTab38" typeRef="string"/>
      <output id="out_2_idRegra" name="idRegra" typeRef="string"/>
      <output id="out_3_fila" name="fila" typeRef="string"/>
      <output id="out_classeAdverso" name="classeAdverso" typeRef="string"/>
      <rule id="r_pre">
        <description>Antes da vigência (2026-12-03): nenhuma regra do domínio vale</description>
        <inputEntry><text>&lt; "2026-12-03"</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"liberar"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
