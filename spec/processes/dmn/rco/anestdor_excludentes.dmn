<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:camunda="http://camunda.org/schema/1.0/dmn" id="def_anestdor_excludentes" name="Anestesia, terapia da dor e acupuntura: pares excludentes (cateter e bomba de infusão × analgesia por dia subsequente)" namespace="https://omni-saude/dmn/anestesia-terapia-dor">
  <decision id="rco_anestdor_excludentes" name="Anestesia, terapia da dor e acupuntura: pares excludentes (cateter e bomba de infusão × analgesia por dia subsequente)" camunda:historyTimeToLive="P3650D">
    <description>OMNI-ANESTDOR-MEX-0001. Hit policy UNIQUE; pares sem exceção de campo da guia (indicador 0), mesma guia e mesma data de execução; nenhuma linha nega ou glosa: a cobrança conjunta vai à revisão do faturamento (Tab. 38 3209), a linha final (data ausente) vai à revisão humana.</description>
    <decisionTable id="dt_anestdor_excludentes" hitPolicy="UNIQUE">
      <input id="in_0_dataAtendimento" label="dataAtendimento ← TISS dataExecucao (conta) ou dataSolicitacao (pedido), AAAA-MM-DD">
        <inputExpression id="ie_0_dataAtendimento" typeRef="string"><text>dataAtendimento</text></inputExpression>
      </input>
      <input id="in_1_codigoPrincipal" label="codigoPrincipal ← TISS codigoProcedimento do cateter (31602223) ou da bomba (31602207) da guia (TUSS 22)">
        <inputExpression id="ie_1_codigoPrincipal" typeRef="string"><text>codigoPrincipal</text></inputExpression>
      </input>
      <input id="in_2_codigoSecundario" label="codigoSecundario ← TISS codigoProcedimento de outra linha da mesma guia e dataExecucao (TUSS 22); nulo se não há outra linha">
        <inputExpression id="ie_2_codigoSecundario" typeRef="string"><text>codigoSecundario</text></inputExpression>
      </input>
      <output id="out_0_decisao" name="decisao" typeRef="string"/>
      <output id="out_1_motivoTab38" name="motivoTab38" typeRef="string"/>
      <output id="out_2_idRegra" name="idRegra" typeRef="string"/>
      <output id="out_3_fila" name="fila" typeRef="string"/>
      <output id="out_classeAdverso" name="classeAdverso" typeRef="string"/>
      <rule id="r_pre">
        <description>Antes da vigência (2026-12-03): nenhuma regra do domínio vale</description>
        <inputEntry><text>&lt; "2026-12-03"</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"liberar"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="m_par">
        <description>OMNI-ANESTDOR-MEX-0001 — cateter ou bomba cobrados com a analgesia por dia subsequente na mesma data: faturamento, sem glosa (Tab. 38 3209)</description>
        <inputEntry><text>&gt;= "2026-12-03"</text></inputEntry>
        <inputEntry><text>"31602223", "31602207"</text></inputEntry>
        <inputEntry><text>"31602029"</text></inputEntry>
        <outputEntry><text>"revisao_humana"</text></outputEntry>
        <outputEntry><text>"3209"</text></outputEntry>
        <outputEntry><text>"OMNI-ANESTDOR-MEX-0001"</text></outputEntry>
        <outputEntry><text>"faturamento"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="m_par_inv">
        <description>OMNI-ANESTDOR-MEX-0001 — analgesia por dia subsequente como principal, com cateter ou bomba na mesma data: faturamento, sem glosa (Tab. 38 3209)</description>
        <inputEntry><text>&gt;= "2026-12-03"</text></inputEntry>
        <inputEntry><text>"31602029"</text></inputEntry>
        <inputEntry><text>"31602223", "31602207"</text></inputEntry>
        <outputEntry><text>"revisao_humana"</text></outputEntry>
        <outputEntry><text>"3209"</text></outputEntry>
        <outputEntry><text>"OMNI-ANESTDOR-MEX-0001"</text></outputEntry>
        <outputEntry><text>"faturamento"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="m_ok1">
        <description>OMNI-ANESTDOR-MEX-0001 — cateter ou bomba sem a analgesia por dia subsequente na data: conta conforme</description>
        <inputEntry><text>&gt;= "2026-12-03"</text></inputEntry>
        <inputEntry><text>"31602223", "31602207"</text></inputEntry>
        <inputEntry><text>not("31602029")</text></inputEntry>
        <outputEntry><text>"liberar"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-ANESTDOR-MEX-0001"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="m_ok2">
        <description>OMNI-ANESTDOR-MEX-0001 — analgesia por dia subsequente sem cateter nem bomba na data: conta conforme</description>
        <inputEntry><text>&gt;= "2026-12-03"</text></inputEntry>
        <inputEntry><text>"31602029"</text></inputEntry>
        <inputEntry><text>not("31602223", "31602207")</text></inputEntry>
        <outputEntry><text>"liberar"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-ANESTDOR-MEX-0001"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="m_fora">
        <description>Código principal fora dos pares deste domínio: nenhuma exigência</description>
        <inputEntry><text>&gt;= "2026-12-03"</text></inputEntry>
        <inputEntry><text>not("31602223", "31602207", "31602029", null)</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"liberar"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="m_nulo">
        <description>Código principal ausente: regulação, nunca negativa</description>
        <inputEntry><text>&gt;= "2026-12-03"</text></inputEntry>
        <inputEntry><text>null</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"revisao_humana"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-ANESTDOR-MEX-0001"</text></outputEntry>
        <outputEntry><text>"regulacao"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="r_final">
        <description>Data ausente: regulação, nunca negativa (fechamento)</description>
        <inputEntry><text>null</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"revisao_humana"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"regulacao"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
</definitions>
