      <rule id="q18_exc">
        <description>OMNI-ANESTDOR-LIM-0001 — bloqueio de terapia da dor: acima do limite sem justificativa: faturamento, sem glosa (Tab. 38 3210)</description>
        <inputEntry><text>&gt;= "2026-12-03"</text></inputEntry>
        <inputEntry><text>"31602037", "31602045", "31602053", "31602061", "31602070", "31602088", "31602096", "31602100", "31602118", "31602126", "31602134", "31602142", "31602150", "31602169", "31602177", "31602207", "31602223", "31602339"</text></inputEntry>
        <inputEntry><text>&gt; 1</text></inputEntry>
        <inputEntry><text>false, null</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"revisao_humana"</text></outputEntry>
        <outputEntry><text>"3210"</text></outputEntry>
        <outputEntry><text>"OMNI-ANESTDOR-LIM-0001"</text></outputEntry>
        <outputEntry><text>"faturamento"</text></outputEntry>
