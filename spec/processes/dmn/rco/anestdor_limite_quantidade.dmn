        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="x_fora">
        <description>Código fora dos limites deste domínio: nenhuma exigência</description>
        <inputEntry><text>&gt;= "2026-12-03"</text></inputEntry>
        <inputEntry><text>not("31602029", "31602037", "31602045", "31602053", "31602061", "31602070", "31602088", "31602096", "31602100", "31602118", "31602126", "31602134", "31602142", "31602150", "31602169", "31602177", "31602207", "31602223", "31602339", "31601014", null)</text></inputEntry>
