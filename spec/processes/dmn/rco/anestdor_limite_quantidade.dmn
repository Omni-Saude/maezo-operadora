      <rule id="q29_nulo">
        <description>OMNI-ANESTDOR-LIM-0001 — analgesia por dia subsequente por cateter: quantidade ausente: regulação, nunca negativa</description>
        <inputEntry><text>&gt;= "2026-12-03"</text></inputEntry>
