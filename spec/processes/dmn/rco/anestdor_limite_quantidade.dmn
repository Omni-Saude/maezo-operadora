      <rule id="q29_just">
        <description>OMNI-ANESTDOR-LIM-0001 — analgesia por dia subsequente por cateter: acima do limite com justificativa na guia: superado, conta conforme</description>
        <inputEntry><text>&gt;= "2026-12-03"</text></inputEntry>
        <inputEntry><text>"31602029"</text></inputEntry>
        <inputEntry><text>&gt; 1</text></inputEntry>
        <inputEntry><text>true</text></inputEntry>
