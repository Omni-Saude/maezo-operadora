<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:camunda="http://camunda.org/schema/1.0/dmn" id="def_anestdor_pacote" name="Anestesia, terapia da dor e acupuntura: composição da conta (sessão de acupuntura, exames sequenciais, anestesia combinada, valoração de honorários)" namespace="https://omni-saude/dmn/anestesia-terapia-dor">
  <decision id="rco_anestdor_pacote" name="Anestesia, terapia da dor e acupuntura: composição da conta (sessão de acupuntura, exames sequenciais, anestesia combinada, valoração de honorários)" camunda:historyTimeToLive="P3650D">
    <description>OMNI-ANESTDOR-PAC-0001 a OMNI-ANESTDOR-PAC-0004. Composição e edição de conta, HCP-LAN 1, sem tabela de pacote de episódio (desvio ANESTDOR-02). Hit policy UNIQUE; nenhuma linha nega ou glosa: composição conforme paga pelo contrato (pagar_pacote), divergência vai à revisão do faturamento, dado ausente à regulação; percentuais são parâmetros do contrato do prestador (regras/tabelas/honorarios.yaml), conferidos pelo worker na entrada percentualContratualConforme; acréscimo de urgência só com caráter 2. A linha final (data ausente) vai à revisão humana.</description>
    <decisionTable id="dt_anestdor_pacote" hitPolicy="UNIQUE">
      <input id="in_0_dataAtendimento" label="dataAtendimento ← TISS dataExecucao (conta) ou dataSolicitacao (pedido), AAAA-MM-DD">
        <inputExpression id="ie_0_dataAtendimento" typeRef="string"><text>dataAtendimento</text></inputExpression>
      </input>
      <input id="in_1_temaComposicao" label="temaComposicao ← fluxo Camunda: tema de composição do dominio.yaml derivado dos códigos da guia (acupuntura_sessao | exames_sequenciais | anestesia_combinada | valoracao_honorarios)">
        <inputExpression id="ie_1_temaComposicao" typeRef="string"><text>temaComposicao</text></inputExpression>
      </input>
      <input id="in_2_cobrancaIncluidaSeparada" label="cobrancaIncluidaSeparada ← TISS codigoProcedimento, conselhoExecutante e dataExecucao: ato já incluído na composição cobrado à parte pelo mesmo executante na mesma data">
        <inputExpression id="ie_2_cobrancaIncluidaSeparada" typeRef="boolean"><text>cobrancaIncluidaSeparada</text></inputExpression>
      </input>
      <input id="in_3_tecnicaAssociadaNaFicha" label="tecnicaAssociadaNaFicha ← anexo: técnica associada descrita na ficha anestésica (campo fora da TISS)">
        <inputExpression id="ie_3_tecnicaAssociadaNaFicha" typeRef="boolean"><text>tecnicaAssociadaNaFicha</text></inputExpression>
      </input>
      <input id="in_4_viaAcessoInformada" label="viaAcessoInformada ← TISS viaAcesso (Tabela 61) informada nos procedimentos do mesmo ato">
        <inputExpression id="ie_4_viaAcessoInformada" typeRef="boolean"><text>viaAcessoInformada</text></inputExpression>
      </input>
      <input id="in_5_percentualContratualConforme" label="percentualContratualConforme ← TISS reducaoAcrescimo igual ao percentual do contrato do prestador, derivado pelo worker">
        <inputExpression id="ie_5_percentualContratualConforme" typeRef="boolean"><text>percentualContratualConforme</text></inputExpression>
      </input>
      <input id="in_6_caraterAtendimento" label="caraterAtendimento ← TISS caraterAtendimento (TUSS 23: 1 eletivo, 2 urgência ou emergência)">
        <inputExpression id="ie_6_caraterAtendimento" typeRef="string"><text>caraterAtendimento</text></inputExpression>
      </input>
      <input id="in_7_acrescimoUrgenciaCobrado" label="acrescimoUrgenciaCobrado ← TISS reducaoAcrescimo: acréscimo de honorário de urgência cobrado">
        <inputExpression id="ie_7_acrescimoUrgenciaCobrado" typeRef="boolean"><text>acrescimoUrgenciaCobrado</text></inputExpression>
      </input>
      <output id="out_0_decisao" name="decisao" typeRef="string"/>
      <output id="out_1_motivoTab38" name="motivoTab38" typeRef="string"/>
      <output id="out_2_idRegra" name="idRegra" typeRef="string"/>
      <output id="out_3_fila" name="fila" typeRef="string"/>
      <output id="out_classeAdverso" name="classeAdverso" typeRef="string"/>
      <rule id="r_pre">
        <description>Antes da vigência (2026-12-03): nenhuma regra do domínio vale</description>
        <inputEntry><text>&lt; "2026-12-03"</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"liberar"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
