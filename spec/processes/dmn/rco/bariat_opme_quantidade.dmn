        <inputEntry><text>"31002285"</text></inputEntry>
        <inputEntry><text>not("banda_gastrica", "trocater")</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"revisao_humana"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-BARIAT-OPM-0001"</text></outputEntry>
        <outputEntry><text>"auditoria_medica"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="p_31002013_banda_gastrica_ok">
        <description>OMNI-BARIAT-OPM-0001: banda_gastrica até 1 em 31002013: libera</description>
