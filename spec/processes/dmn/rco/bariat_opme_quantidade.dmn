        <inputEntry><text>&gt;= "2026-11-03"</text></inputEntry>
        <inputEntry><text>"31002013"</text></inputEntry>
        <inputEntry><text>"banda_gastrica"</text></inputEntry>
        <inputEntry><text>null, &lt; 1</text></inputEntry>
