<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:camunda="http://camunda.org/schema/1.0/dmn" id="def_cardio_compatibilidade" name="Cardiovascular: acesso venoso central pelo anestesista no centro cirúrgico" namespace="https://omni-saude/dmn/cardiovascular">
  <decision id="rco_cardio_compatibilidade" name="Cardiovascular: acesso venoso central pelo anestesista no centro cirúrgico" camunda:historyTimeToLive="P3650D">
    <description>OMNI-CARDIO-CMP-0001. Hit policy UNIQUE; nenhuma linha glosa; fechamento null vai à revisão humana.</description>
    <decisionTable id="dt_cardio_compatibilidade" hitPolicy="UNIQUE">
      <input id="in_0_dataAtendimento" label="dataAtendimento ← TISS dataSolicitacao (pedido) ou dataExecucao (conta), AAAA-MM-DD">
        <inputExpression id="ie_0_dataAtendimento" typeRef="string"><text>dataAtendimento</text></inputExpression>
      </input>
      <input id="in_1_codigoProcedimento" label="codigoProcedimento ← TISS codigoProcedimento (TUSS 22)">
        <inputExpression id="ie_1_codigoProcedimento" typeRef="string"><text>codigoProcedimento</text></inputExpression>
      </input>
      <input id="in_2_acessoCobradoDuasVezes" label="acessoCobradoDuasVezes ← TISS: mesmo código de acesso venoso central em duas linhas da mesma guia e dataExecucao com grauParticipacao diferentes">
        <inputExpression id="ie_2_acessoCobradoDuasVezes" typeRef="boolean"><text>acessoCobradoDuasVezes</text></inputExpression>
      </input>
      <output id="out_0_decisao" name="decisao" typeRef="string"/>
      <output id="out_1_motivoTab38" name="motivoTab38" typeRef="string"/>
      <output id="out_2_idRegra" name="idRegra" typeRef="string"/>
      <output id="out_3_fila" name="fila" typeRef="string"/>
      <output id="out_classeAdverso" name="classeAdverso" typeRef="string"/>
      <rule id="p_pre">
        <description>OMNI-CARDIO-CMP-0001 — antes da vigência (03/12/2026)</description>
        <inputEntry><text>&lt; "2026-12-03"</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"liberar"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-CARDIO-CMP-0001"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="p_dup">
        <description>OMNI-CARDIO-CMP-0001 — acesso venoso central cobrado por dois profissionais: auditoria</description>
        <inputEntry><text>&gt;= "2026-12-03"</text></inputEntry>
        <inputEntry><text>"30913012", "30913098", "40813231"</text></inputEntry>
        <inputEntry><text>true</text></inputEntry>
        <outputEntry><text>"revisao_humana"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-CARDIO-CMP-0001"</text></outputEntry>
        <outputEntry><text>"auditoria_medica"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="p_ok">
        <description>OMNI-CARDIO-CMP-0001 — acesso cobrado uma vez: pago ao executante</description>
        <inputEntry><text>&gt;= "2026-12-03"</text></inputEntry>
        <inputEntry><text>"30913012", "30913098", "40813231"</text></inputEntry>
        <inputEntry><text>false, null</text></inputEntry>
        <outputEntry><text>"liberar"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-CARDIO-CMP-0001"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="p_resto">
        <description>OMNI-CARDIO-CMP-0001 — outro código</description>
        <inputEntry><text>&gt;= "2026-12-03"</text></inputEntry>
        <inputEntry><text>not("30913012", "30913098", "40813231")</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"liberar"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-CARDIO-CMP-0001"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="p_sem_data">
        <description>OMNI-CARDIO-CMP-0001 — data ausente: faturamento</description>
        <inputEntry><text>null</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"revisao_humana"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-CARDIO-CMP-0001"</text></outputEntry>
        <outputEntry><text>"faturamento"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
</definitions>
