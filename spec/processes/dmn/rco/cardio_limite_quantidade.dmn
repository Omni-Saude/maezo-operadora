<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:camunda="http://camunda.org/schema/1.0/dmn" id="def_cardio_limite_quantidade" name="Cardiovascular: repetição em curto intervalo e quantidade por ato" namespace="https://omni-saude/dmn/cardiovascular">
  <decision id="rco_cardio_limite_quantidade" name="Cardiovascular: repetição em curto intervalo e quantidade por ato" camunda:historyTimeToLive="P3650D">
    <description>OMNI-CARDIO-LIM-0001 a OMNI-CARDIO-LIM-0008 (a LIM-0005 não tem código TUSS: LACUNA L-faseE-cardio-01). Hit policy UNIQUE; nenhuma linha glosa; parâmetros provisórios em validacao/calibracao/parametros-provisorios.csv; fechamento null vai à revisão.</description>
    <decisionTable id="dt_cardio_limite_quantidade" hitPolicy="UNIQUE">
      <input id="in_0_dataAtendimento" label="dataAtendimento ← TISS dataSolicitacao (pedido) ou dataExecucao (conta), AAAA-MM-DD">
        <inputExpression id="ie_0_dataAtendimento" typeRef="string"><text>dataAtendimento</text></inputExpression>
      </input>
      <input id="in_1_codigoProcedimento" label="codigoProcedimento ← TISS codigoProcedimento (TUSS 22)">
        <inputExpression id="ie_1_codigoProcedimento" typeRef="string"><text>codigoProcedimento</text></inputExpression>
      </input>
      <input id="in_2_excedeLimiteCardio" label="excedeLimiteCardio ← histórico de contas OMNI e TISS quantidadeExecutada: execução repetida na janela ou quantidade acima de condicoes.limite da regra LIM">
        <inputExpression id="ie_2_excedeLimiteCardio" typeRef="boolean"><text>excedeLimiteCardio</text></inputExpression>
      </input>
      <output id="out_0_decisao" name="decisao" typeRef="string"/>
      <output id="out_1_motivoTab38" name="motivoTab38" typeRef="string"/>
      <output id="out_2_idRegra" name="idRegra" typeRef="string"/>
      <output id="out_3_fila" name="fila" typeRef="string"/>
      <output id="out_classeAdverso" name="classeAdverso" typeRef="string"/>
      <rule id="l_pre">
        <description>OMNI-CARDIO-LIM-0004 — antes da vigência (03/12/2026)</description>
        <inputEntry><text>&lt; "2026-12-03"</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"liberar"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-CARDIO-LIM-0004"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="l0001_acima">
        <description>OMNI-CARDIO-LIM-0001 — repetição na janela ou quantidade acima do parâmetro provisório: auditoria</description>
        <inputEntry><text>&gt;= "2026-12-03"</text></inputEntry>
        <inputEntry><text>"30907012", "30907020", "30907039", "30907047", "30907080", "30907098", "30907101", "30907110", "30907128", "30907136", "30907144", "30907152"</text></inputEntry>
        <inputEntry><text>true</text></inputEntry>
        <outputEntry><text>"revisao_humana"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-CARDIO-LIM-0001"</text></outputEntry>
        <outputEntry><text>"auditoria_medica"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="l0001_ok">
        <description>OMNI-CARDIO-LIM-0001 — dentro do parâmetro ou histórico não informado: segue sem conferência</description>
