<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:camunda="http://camunda.org/schema/1.0/dmn" id="def_cardio_opme" name="Cardiovascular: OPME do ritmo cardíaco e da eletrofisiologia, lista positiva e quantidade" namespace="https://omni-saude/dmn/cardiovascular">
  <decision id="rco_cardio_opme" name="Cardiovascular: OPME do ritmo cardíaco e da eletrofisiologia, lista positiva e quantidade" camunda:historyTimeToLive="P3650D">
    <description>OMNI-CARDIO-OPM-0001, OMNI-CARDIO-OPM-0002, OMNI-CARDIO-OPM-0007. Lista positiva de OPME por código de procedimento com quantidade máxima por ato (dominio.yaml, listas_opme): dentro da lista libera; acima, fora da lista ou sem categoria vai à auditoria médica; quantidade nula ou menor que 1 vai ao faturamento; gerador de tipo diferente do código vai à auditoria (OPM-0007). Quantidades provisórias em validacao/calibracao/parametros-provisorios.csv (L-faseE-cardio-04). Nenhuma linha nega ou glosa; fechamento null vai à regulação.</description>
    <decisionTable id="dt_cardio_opme" hitPolicy="UNIQUE">
      <input id="in_0_dataAtendimento" label="dataAtendimento ← TISS dataSolicitacao (pedido) ou dataExecucao (conta), AAAA-MM-DD">
        <inputExpression id="ie_0_dataAtendimento" typeRef="string"><text>dataAtendimento</text></inputExpression>
      </input>
      <input id="in_1_codigoProcedimento" label="codigoProcedimento ← TISS codigoProcedimento (TUSS 22)">
        <inputExpression id="ie_1_codigoProcedimento" typeRef="string"><text>codigoProcedimento</text></inputExpression>
      </input>
      <input id="in_2_categoriaOpme" label="categoriaOpme ← TISS codigoMaterial (TUSS 19) do anexo de OPME classificado pelo cadastro OMNI de materiais; sem correspondência vai nulo">
        <inputExpression id="ie_2_categoriaOpme" typeRef="string"><text>categoriaOpme</text></inputExpression>
      </input>
      <input id="in_3_quantidadeSolicitada" label="quantidadeSolicitada ← TISS quantidadeSolicitada do item de OPME no anexo">
        <inputExpression id="ie_3_quantidadeSolicitada" typeRef="integer"><text>quantidadeSolicitada</text></inputExpression>
      </input>
      <output id="out_0_decisao" name="decisao" typeRef="string"/>
      <output id="out_1_motivoTab38" name="motivoTab38" typeRef="string"/>
      <output id="out_2_idRegra" name="idRegra" typeRef="string"/>
      <output id="out_3_fila" name="fila" typeRef="string"/>
      <output id="out_classeAdverso" name="classeAdverso" typeRef="string"/>
      <rule id="p_pre">
        <description>OMNI-CARDIO-OPM-0001 — antes da vigência (03/12/2026): sem conferência</description>
        <inputEntry><text>&lt; "2026-12-03"</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"liberar"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-CARDIO-OPM-0001"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="p01_ok">
        <description>OMNI-CARDIO-OPM-0001 — cateter_ablacao até 1 por ato: dentro da lista positiva</description>
        <inputEntry><text>&gt;= "2026-12-03"</text></inputEntry>
        <inputEntry><text>"30912016", "30918073", "30918081", "30918090"</text></inputEntry>
        <inputEntry><text>"cateter_ablacao"</text></inputEntry>
        <inputEntry><text>[1..1]</text></inputEntry>
        <outputEntry><text>"liberar"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-CARDIO-OPM-0001"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="p01_acima">
        <description>OMNI-CARDIO-OPM-0001 — cateter_ablacao acima de 1 por ato: auditoria médica (nunca glosa)</description>
        <inputEntry><text>&gt;= "2026-12-03"</text></inputEntry>
        <inputEntry><text>"30912016", "30918073", "30918081", "30918090"</text></inputEntry>
        <inputEntry><text>"cateter_ablacao"</text></inputEntry>
        <inputEntry><text>&gt; 1</text></inputEntry>
        <outputEntry><text>"revisao_humana"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-CARDIO-OPM-0001"</text></outputEntry>
        <outputEntry><text>"auditoria_medica"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="p01_qtd">
