        <inputEntry><text>not("30905028", "30912024", "30912032", "30912091", "30912105", "30912180", "30912237", "30912261", "30906229", "30906237", "30906245", "30906253", "30906261", "30906270", "30906288", "30906296", "30906300", "30906318", "30906326", "30906334", "30906342", "30906350", "30906415", "30912040", "30912199")</text></inputEntry>
