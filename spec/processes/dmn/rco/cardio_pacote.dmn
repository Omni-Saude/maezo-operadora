<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:camunda="http://camunda.org/schema/1.0/dmn" id="def_cardio_pacote" name="Cardiovascular: enquadramento do episódio em pacote ou conta aberta" namespace="https://omni-saude/dmn/cardiovascular">
  <decision id="rco_cardio_pacote" name="Cardiovascular: enquadramento do episódio em pacote ou conta aberta" camunda:historyTimeToLive="P3650D">
    <description>OMNI-CARDIO-PAC-0001 a OMNI-CARDIO-PAC-0004. Enquadramento do episódio cardiovascular no pacote: eletivo em prestador com pacote vigente paga o pacote; urgência, caráter não informado ou prestador sem pacote ficam em conta aberta (HCP-LAN 1). Os códigos 40812065 e 40812073 constam das PAC-0002 e PAC-0003; a decisão cita a PAC-0002 (remuneração da equipe). Nenhuma linha nega ou glosa; fechamento null vai ao faturamento. Os pacotes OMNI-PAC-CARDIO-* ligam-se pelo package-designer.</description>
    <decisionTable id="dt_cardio_pacote" hitPolicy="UNIQUE">
      <input id="in_0_dataAtendimento" label="dataAtendimento ← TISS dataSolicitacao (pedido) ou dataExecucao (conta), AAAA-MM-DD">
        <inputExpression id="ie_0_dataAtendimento" typeRef="string"><text>dataAtendimento</text></inputExpression>
      </input>
      <input id="in_1_codigoProcedimento" label="codigoProcedimento ← TISS codigoProcedimento (TUSS 22)">
        <inputExpression id="ie_1_codigoProcedimento" typeRef="string"><text>codigoProcedimento</text></inputExpression>
      </input>
      <input id="in_2_caraterAtendimento" label="caraterAtendimento ← TISS caraterAtendimento (TUSS 23: 1 eletivo, 2 urgência/emergência)">
        <inputExpression id="ie_2_caraterAtendimento" typeRef="string"><text>caraterAtendimento</text></inputExpression>
      </input>
      <input id="in_3_prestadorComPacote" label="prestadorComPacote ← cadastro de contrato: pacote OMNI-PAC-CARDIO vigente para o prestador (booleano)">
        <inputExpression id="ie_3_prestadorComPacote" typeRef="boolean"><text>prestadorComPacote</text></inputExpression>
      </input>
      <input id="in_4_diasInternacao" label="diasInternacao ← resumo de internação TISS: data da alta menos data da internação, em dias (nulo no pedido)">
        <inputExpression id="ie_4_diasInternacao" typeRef="integer"><text>diasInternacao</text></inputExpression>
      </input>
      <output id="out_0_decisao" name="decisao" typeRef="string"/>
      <output id="out_1_motivoTab38" name="motivoTab38" typeRef="string"/>
      <output id="out_2_idRegra" name="idRegra" typeRef="string"/>
      <output id="out_3_fila" name="fila" typeRef="string"/>
      <output id="out_classeAdverso" name="classeAdverso" typeRef="string"/>
      <output id="out_4_modalidadePagamento" name="modalidadePagamento" typeRef="string"/>
      <rule id="k_pre">
        <description>OMNI-CARDIO-PAC-0001 — antes da vigência (03/12/2026): conta aberta</description>
        <inputEntry><text>&lt; "2026-12-03"</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"liberar"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-CARDIO-PAC-0001"</text></outputEntry>
