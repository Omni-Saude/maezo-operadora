<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:camunda="http://camunda.org/schema/1.0/dmn" id="def_cirger_dut_ablacao_hepatica" name="Ablação de tumor hepático por videolaparoscopia: DUT 1 e DUT 164" namespace="https://omni-saude/dmn/cirurgia-geral-digestiva">
  <decision id="rco_cirger_dut_ablacao_hepatica" name="Ablação de tumor hepático por videolaparoscopia: DUT 1 e DUT 164 (OMNI-CIRGER-DUT-0001; OMNI-CIRGER-DUT-0002)" camunda:historyTimeToLive="P180D">
    <description>Enquadramento do código 31005640 nas DUT 1 (carcinoma hepático primário) e 164 (metástase hepática de câncer colorretal) do Anexo II vigente. Negativa só com dado objetivo fora da DUT; dado ausente pede documento; o que exige juízo clínico vai à auditoria médica. Regras: OMNI-CIRGER-DUT-0001; OMNI-CIRGER-DUT-0002. Gerado por regras/cirurgia-geral-digestiva/gerar_cirger.py; hit policy UNIQUE; a linha de fechamento nunca nega.</description>
    <decisionTable id="dt_cirger_dut_ablacao_hepatica" hitPolicy="UNIQUE">
      <input id="in_0_dataAtendimento" label="dataAtendimento ← TISS dataSolicitacao (pedido) ou dataExecucao (conta), AAAA-MM-DD">
        <inputExpression id="ie_0_dataAtendimento" typeRef="string"><text>dataAtendimento</text></inputExpression>
      </input>
      <input id="in_1_codigoProcedimento" label="codigoProcedimento ← TISS codigoProcedimento (TUSS 22)">
        <inputExpression id="ie_1_codigoProcedimento" typeRef="string"><text>codigoProcedimento</text></inputExpression>
      </input>
      <input id="in_2_indicacaoAblacao" label="indicacaoAblacao ← TISS anexo da guia de solicitação: indicação no relatório (carcinoma_hepatico_primario | metastase_colorretal | outra)">
        <inputExpression id="ie_2_indicacaoAblacao" typeRef="string"><text>indicacaoAblacao</text></inputExpression>
      </input>
      <input id="in_3_classeChildPugh" label="classeChildPugh ← TISS anexo da guia de solicitação: classe de Child-Pugh no relatório (A | B | C)">
        <inputExpression id="ie_3_classeChildPugh" typeRef="string"><text>classeChildPugh</text></inputExpression>
      </input>
      <input id="in_4_doencaRestritaFigado" label="doencaRestritaFigado ← TISS anexo da guia de solicitação: doença restrita ao fígado no laudo de imagem (booleano)">
        <inputExpression id="ie_4_doencaRestritaFigado" typeRef="boolean"><text>doencaRestritaFigado</text></inputExpression>
      </input>
      <input id="in_5_maiorLesaoMm" label="maiorLesaoMm ← TISS anexo da guia de solicitação: maior diâmetro de lesão no laudo de imagem, em milímetros">
        <inputExpression id="ie_5_maiorLesaoMm" typeRef="integer"><text>maiorLesaoMm</text></inputExpression>
      </input>
      <output id="out_decisao" name="decisao" typeRef="string"/>
      <output id="out_motivoTab38" name="motivoTab38" typeRef="string"/>
      <output id="out_idRegra" name="idRegra" typeRef="string"/>
      <output id="out_fila" name="fila" typeRef="string"/>
      <output id="out_classeAdverso" name="classeAdverso" typeRef="string"/>
      <rule id="r000">
        <description>OMNI-CIRGER-DUT-0001 — antes da vigência (2027-01-01): fluxo anterior, com revisão</description>
        <inputEntry><text>&lt; "2027-01-01"</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"revisao_humana"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-CIRGER-DUT-0001"</text></outputEntry>
        <outputEntry><text>"regulacao"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="r001">
        <description>OMNI-CIRGER-DUT-0001 — fechamento: a DUT 1/164 não se aplica a outro código</description>
        <inputEntry><text>&gt;= "2027-01-01"</text></inputEntry>
        <inputEntry><text>not("31005640")</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"liberar"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-CIRGER-DUT-0001"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="r002">
        <description>OMNI-CIRGER-DUT-0001 — indicação ausente no relatório: pedir documento</description>
        <inputEntry><text>&gt;= "2027-01-01"</text></inputEntry>
        <inputEntry><text>"31005640"</text></inputEntry>
        <inputEntry><text>null</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"exigir_documento"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-CIRGER-DUT-0001"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="r003">
        <description>OMNI-CIRGER-DUT-0001 — indicação fora das DUT 1 e 164: auditoria médica (art. 10, §13, da Lei 9.656)</description>
        <inputEntry><text>&gt;= "2027-01-01"</text></inputEntry>
        <inputEntry><text>"31005640"</text></inputEntry>
        <inputEntry><text>not("carcinoma_hepatico_primario","metastase_colorretal",null)</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"revisao_humana"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-CIRGER-DUT-0001"</text></outputEntry>
        <outputEntry><text>"auditoria_medica"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="r004">
        <description>OMNI-CIRGER-DUT-0001 — DUT 1: Child-Pugh C não atende à diretriz; a auditoria médica decide</description>
        <inputEntry><text>&gt;= "2027-01-01"</text></inputEntry>
        <inputEntry><text>"31005640"</text></inputEntry>
        <inputEntry><text>"carcinoma_hepatico_primario"</text></inputEntry>
        <inputEntry><text>"C"</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"recomendar_negativa"</text></outputEntry>
        <outputEntry><text>"3288"</text></outputEntry>
        <outputEntry><text>"OMNI-CIRGER-DUT-0001"</text></outputEntry>
        <outputEntry><text>"auditoria_medica"</text></outputEntry>
        <outputEntry><text>"clinico"</text></outputEntry>
      </rule>
      <rule id="r005">
        <description>OMNI-CIRGER-DUT-0001 — DUT 1: classe de Child-Pugh ausente</description>
        <inputEntry><text>&gt;= "2027-01-01"</text></inputEntry>
        <inputEntry><text>"31005640"</text></inputEntry>
        <inputEntry><text>"carcinoma_hepatico_primario"</text></inputEntry>
        <inputEntry><text>null</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"exigir_documento"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-CIRGER-DUT-0001"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="r006">
        <description>OMNI-CIRGER-DUT-0001 — DUT 1: classe de Child-Pugh inválida</description>
        <inputEntry><text>&gt;= "2027-01-01"</text></inputEntry>
        <inputEntry><text>"31005640"</text></inputEntry>
        <inputEntry><text>"carcinoma_hepatico_primario"</text></inputEntry>
        <inputEntry><text>not("A","B","C",null)</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"revisao_humana"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-CIRGER-DUT-0001"</text></outputEntry>
        <outputEntry><text>"auditoria_medica"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="r007">
        <description>OMNI-CIRGER-DUT-0001 — DUT 1: doença fora do fígado não atende à diretriz; a auditoria médica decide</description>
        <inputEntry><text>&gt;= "2027-01-01"</text></inputEntry>
        <inputEntry><text>"31005640"</text></inputEntry>
        <inputEntry><text>"carcinoma_hepatico_primario"</text></inputEntry>
        <inputEntry><text>"A","B"</text></inputEntry>
        <inputEntry><text>false</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"recomendar_negativa"</text></outputEntry>
        <outputEntry><text>"3288"</text></outputEntry>
        <outputEntry><text>"OMNI-CIRGER-DUT-0001"</text></outputEntry>
        <outputEntry><text>"auditoria_medica"</text></outputEntry>
        <outputEntry><text>"clinico"</text></outputEntry>
      </rule>
      <rule id="r008">
        <description>OMNI-CIRGER-DUT-0001 — DUT 1: extensão da doença não informada</description>
        <inputEntry><text>&gt;= "2027-01-01"</text></inputEntry>
        <inputEntry><text>"31005640"</text></inputEntry>
        <inputEntry><text>"carcinoma_hepatico_primario"</text></inputEntry>
        <inputEntry><text>"A","B"</text></inputEntry>
        <inputEntry><text>null</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"exigir_documento"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-CIRGER-DUT-0001"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="r009">
        <description>OMNI-CIRGER-DUT-0001 — DUT 1: lesão menor que 40 mm, Child A ou B, restrita ao fígado: atende</description>
        <inputEntry><text>&gt;= "2027-01-01"</text></inputEntry>
        <inputEntry><text>"31005640"</text></inputEntry>
        <inputEntry><text>"carcinoma_hepatico_primario"</text></inputEntry>
        <inputEntry><text>"A","B"</text></inputEntry>
        <inputEntry><text>true</text></inputEntry>
        <inputEntry><text>&lt; 40</text></inputEntry>
        <outputEntry><text>"liberar"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-CIRGER-DUT-0001"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="r010">
        <description>OMNI-CIRGER-DUT-0001 — DUT 1: lesão de 40 mm ou mais não atende à diretriz; a auditoria médica decide</description>
        <inputEntry><text>&gt;= "2027-01-01"</text></inputEntry>
        <inputEntry><text>"31005640"</text></inputEntry>
        <inputEntry><text>"carcinoma_hepatico_primario"</text></inputEntry>
        <inputEntry><text>"A","B"</text></inputEntry>
        <inputEntry><text>true</text></inputEntry>
        <inputEntry><text>&gt;= 40</text></inputEntry>
        <outputEntry><text>"recomendar_negativa"</text></outputEntry>
        <outputEntry><text>"3288"</text></outputEntry>
        <outputEntry><text>"OMNI-CIRGER-DUT-0001"</text></outputEntry>
        <outputEntry><text>"auditoria_medica"</text></outputEntry>
        <outputEntry><text>"clinico"</text></outputEntry>
      </rule>
      <rule id="r011">
        <description>OMNI-CIRGER-DUT-0001 — DUT 1: tamanho da lesão não informado</description>
        <inputEntry><text>&gt;= "2027-01-01"</text></inputEntry>
        <inputEntry><text>"31005640"</text></inputEntry>
        <inputEntry><text>"carcinoma_hepatico_primario"</text></inputEntry>
        <inputEntry><text>"A","B"</text></inputEntry>
        <inputEntry><text>true</text></inputEntry>
        <inputEntry><text>null</text></inputEntry>
        <outputEntry><text>"exigir_documento"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-CIRGER-DUT-0001"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="r012">
        <description>OMNI-CIRGER-DUT-0002 — DUT 164: lesão acima de 40 mm não atende à diretriz; a auditoria médica decide</description>
        <inputEntry><text>&gt;= "2027-01-01"</text></inputEntry>
        <inputEntry><text>"31005640"</text></inputEntry>
        <inputEntry><text>"metastase_colorretal"</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>&gt; 40</text></inputEntry>
        <outputEntry><text>"recomendar_negativa"</text></outputEntry>
        <outputEntry><text>"3288"</text></outputEntry>
        <outputEntry><text>"OMNI-CIRGER-DUT-0002"</text></outputEntry>
        <outputEntry><text>"auditoria_medica"</text></outputEntry>
        <outputEntry><text>"clinico"</text></outputEntry>
      </rule>
      <rule id="r013">
        <description>OMNI-CIRGER-DUT-0002 — DUT 164: lesão até 40 mm: auditoria confirma irressecabilidade ou alto risco cirúrgico</description>
        <inputEntry><text>&gt;= "2027-01-01"</text></inputEntry>
        <inputEntry><text>"31005640"</text></inputEntry>
        <inputEntry><text>"metastase_colorretal"</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>&lt;= 40</text></inputEntry>
        <outputEntry><text>"revisao_humana"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-CIRGER-DUT-0002"</text></outputEntry>
        <outputEntry><text>"auditoria_medica"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="r014">
        <description>OMNI-CIRGER-DUT-0002 — DUT 164: tamanho da lesão não informado</description>
        <inputEntry><text>&gt;= "2027-01-01"</text></inputEntry>
        <inputEntry><text>"31005640"</text></inputEntry>
        <inputEntry><text>"metastase_colorretal"</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>null</text></inputEntry>
        <outputEntry><text>"exigir_documento"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-CIRGER-DUT-0002"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="r015">
        <description>OMNI-CIRGER-DUT-0001 — data ausente na guia</description>
        <inputEntry><text>null</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"revisao_humana"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-CIRGER-DUT-0001"</text></outputEntry>
        <outputEntry><text>"regulacao"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
</definitions>
