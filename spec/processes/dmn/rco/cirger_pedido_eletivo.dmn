<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:camunda="http://camunda.org/schema/1.0/dmn" id="def_cirger_pedido_eletivo" name="Documentos e critério clínico do pedido eletivo em cirurgia geral" namespace="https://omni-saude/dmn/cirurgia-geral-digestiva">
  <decision id="rco_cirger_pedido_eletivo" name="Documentos e critério clínico do pedido eletivo em cirurgia geral (OMNI-CIRGER-AUT-0002; OMNI-CIRGER-COB-0002)" camunda:historyTimeToLive="P180D">
    <description>Confere a documentação mínima do pedido eletivo (relatório com justificativa clínica) e encaminha à auditoria médica o critério clínico próprio (risco cirúrgico ASA V), sem negativa. Regras: OMNI-CIRGER-AUT-0002; OMNI-CIRGER-COB-0002. Gerado por regras/cirurgia-geral-digestiva/gerar_cirger.py; hit policy UNIQUE; a linha de fechamento nunca nega.</description>
    <decisionTable id="dt_cirger_pedido_eletivo" hitPolicy="UNIQUE">
      <input id="in_0_dataAtendimento" label="dataAtendimento ← TISS dataSolicitacao (pedido) ou dataExecucao (conta), AAAA-MM-DD">
        <inputExpression id="ie_0_dataAtendimento" typeRef="string"><text>dataAtendimento</text></inputExpression>
      </input>
      <input id="in_1_classeProcedimento" label="classeProcedimento ← TISS codigoProcedimento (TUSS 22) classificado por dominio.yaml: cirger_hospitalar | cirger_ambulatorial">
        <inputExpression id="ie_1_classeProcedimento" typeRef="string"><text>classeProcedimento</text></inputExpression>
      </input>
      <input id="in_2_caraterAtendimento" label="caraterAtendimento ← TISS caraterAtendimento (TUSS 23: 1 eletivo, 2 urgência/emergência)">
        <inputExpression id="ie_2_caraterAtendimento" typeRef="string"><text>caraterAtendimento</text></inputExpression>
      </input>
      <input id="in_3_relatorioMedicoAnexado" label="relatorioMedicoAnexado ← TISS anexo da guia de solicitação: relatório do médico assistente com justificativa clínica, CID e exame que indica a cirurgia (booleano)">
        <inputExpression id="ie_3_relatorioMedicoAnexado" typeRef="boolean"><text>relatorioMedicoAnexado</text></inputExpression>
      </input>
      <input id="in_4_riscoCirurgicoAsa" label="riscoCirurgicoAsa ← TISS anexo da guia de solicitação: classificação ASA do risco cirúrgico informada no relatório (ASA_I a ASA_VI)">
        <inputExpression id="ie_4_riscoCirurgicoAsa" typeRef="string"><text>riscoCirurgicoAsa</text></inputExpression>
      </input>
      <output id="out_decisao" name="decisao" typeRef="string"/>
      <output id="out_motivoTab38" name="motivoTab38" typeRef="string"/>
      <output id="out_idRegra" name="idRegra" typeRef="string"/>
      <output id="out_fila" name="fila" typeRef="string"/>
      <output id="out_classeAdverso" name="classeAdverso" typeRef="string"/>
      <rule id="r000">
        <description>OMNI-CIRGER-AUT-0002 — antes da vigência (2027-01-01)</description>
        <inputEntry><text>&lt; "2027-01-01"</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"liberar"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-CIRGER-AUT-0002"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="r001">
        <description>OMNI-CIRGER-AUT-0002 — classe fora do pedido eletivo CIRGER</description>
        <inputEntry><text>&gt;= "2027-01-01"</text></inputEntry>
        <inputEntry><text>not("cirger_hospitalar","cirger_ambulatorial")</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"liberar"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-CIRGER-AUT-0002"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="r002">
        <description>OMNI-CIRGER-AUT-0002 — urgência: documentos não são pré-requisito do atendimento</description>
        <inputEntry><text>&gt;= "2027-01-01"</text></inputEntry>
        <inputEntry><text>"cirger_hospitalar","cirger_ambulatorial"</text></inputEntry>
        <inputEntry><text>"2"</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"liberar"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-CIRGER-AUT-0002"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="r003">
        <description>OMNI-CIRGER-AUT-0002 — caráter ausente ou inválido</description>
        <inputEntry><text>&gt;= "2027-01-01"</text></inputEntry>
        <inputEntry><text>"cirger_hospitalar","cirger_ambulatorial"</text></inputEntry>
        <inputEntry><text>not("1","2")</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"revisao_humana"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-CIRGER-AUT-0002"</text></outputEntry>
        <outputEntry><text>"regulacao"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="r004">
        <description>OMNI-CIRGER-AUT-0002 — eletivo sem relatório médico: pedido pendente do documento</description>
        <inputEntry><text>&gt;= "2027-01-01"</text></inputEntry>
        <inputEntry><text>"cirger_hospitalar","cirger_ambulatorial"</text></inputEntry>
        <inputEntry><text>"1"</text></inputEntry>
        <inputEntry><text>false, null</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"exigir_documento"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-CIRGER-AUT-0002"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="r005">
        <description>OMNI-CIRGER-COB-0002 — eletivo com relatório e risco ASA V: auditoria médica (critério clínico, sem negativa)</description>
        <inputEntry><text>&gt;= "2027-01-01"</text></inputEntry>
        <inputEntry><text>"cirger_hospitalar","cirger_ambulatorial"</text></inputEntry>
        <inputEntry><text>"1"</text></inputEntry>
        <inputEntry><text>true</text></inputEntry>
        <inputEntry><text>"ASA_V"</text></inputEntry>
        <outputEntry><text>"revisao_humana"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-CIRGER-COB-0002"</text></outputEntry>
        <outputEntry><text>"auditoria_medica"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="r006">
        <description>OMNI-CIRGER-AUT-0002 — eletivo com relatório e sem risco ASA V: documentação completa</description>
        <inputEntry><text>&gt;= "2027-01-01"</text></inputEntry>
        <inputEntry><text>"cirger_hospitalar","cirger_ambulatorial"</text></inputEntry>
        <inputEntry><text>"1"</text></inputEntry>
        <inputEntry><text>true</text></inputEntry>
        <inputEntry><text>not("ASA_V")</text></inputEntry>
        <outputEntry><text>"liberar"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-CIRGER-AUT-0002"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="r007">
        <description>OMNI-CIRGER-AUT-0002 — data ausente na guia</description>
        <inputEntry><text>null</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"revisao_humana"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-CIRGER-AUT-0002"</text></outputEntry>
        <outputEntry><text>"regulacao"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
</definitions>
