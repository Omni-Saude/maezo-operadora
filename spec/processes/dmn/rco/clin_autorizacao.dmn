<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:camunda="http://camunda.org/schema/1.0/dmn" id="def_clin_autorizacao" name="Procedimentos clínicos: autorização prévia só no início das terapias de custo alto; urgência libera" namespace="https://omni-saude/dmn/procedimentos-clinicos">
  <decision id="rco_clin_autorizacao" name="Procedimentos clínicos: autorização prévia só no início das terapias de custo alto; urgência libera" camunda:historyTimeToLive="P3650D">
    <description>OMNI-CLIN-AUT-0001 a AUT-0008. Domínio procedimentos-clinicos. Hit policy UNIQUE; nenhuma linha nega; exigir_autorizacao só em caráter eletivo (1) e só no início de AUT-0004 e AUT-0005 (terapiaEmCurso falso); urgência ou emergência (2) libera por AUT-0008; caráter ausente ou fora da TUSS 23 e terapia em curso desconhecida vão à regulação; fechamento null vai à regulação. Códigos sem regra de autorização própria seguem as regras de cobertura sem restrição adicional (COB-0002, COB-0003, COB-0004, COB-0011).</description>
    <decisionTable id="dt_clin_autorizacao" hitPolicy="UNIQUE">
      <input id="in_0_dataAtendimento" label="dataAtendimento ← TISS dataSolicitacao (pedido) ou dataExecucao (conta), AAAA-MM-DD">
        <inputExpression id="ie_0_dataAtendimento" typeRef="string"><text>dataAtendimento</text></inputExpression>
      </input>
      <input id="in_1_codigoProcedimento" label="codigoProcedimento ← TISS codigoProcedimento (TUSS 22); nulo em item de conta sem código TUSS 22 (nutrição, material)">
        <inputExpression id="ie_1_codigoProcedimento" typeRef="string"><text>codigoProcedimento</text></inputExpression>
      </input>
      <input id="in_2_caraterAtendimento" label="caraterAtendimento ← TISS caraterAtendimento (TUSS 23: 1 eletivo, 2 urgência ou emergência)">
        <inputExpression id="ie_2_caraterAtendimento" typeRef="string"><text>caraterAtendimento</text></inputExpression>
      </input>
      <input id="in_3_terapiaEmCurso" label="terapiaEmCurso ← cadastro e histórico de contas OMNI: execução anterior do mesmo código dentro da janela de continuidade ou autorização anterior vigente">
        <inputExpression id="ie_3_terapiaEmCurso" typeRef="boolean"><text>terapiaEmCurso</text></inputExpression>
      </input>
      <input id="in_4_classeItemNutricao" label="classeItemNutricao ← cadastro OMNI de materiais: classe do item de nutrição">
        <inputExpression id="ie_4_classeItemNutricao" typeRef="string"><text>classeItemNutricao</text></inputExpression>
      </input>
      <input id="in_5_itemRotinaLeitoUti" label="itemRotinaLeitoUti ← cadastro OMNI de materiais e TISS tipo de despesa: medicamento ou material de rotina em leito ou UTI, fora do centro cirúrgico (booleano)">
        <inputExpression id="ie_5_itemRotinaLeitoUti" typeRef="boolean"><text>itemRotinaLeitoUti</text></inputExpression>
      </input>
      <input id="in_6_regime" label="regime ← TISS regimeInternacao ou regimeAtendimento (ambulatorial, internacao, hospital_dia, pronto_socorro)">
        <inputExpression id="ie_6_regime" typeRef="string"><text>regime</text></inputExpression>
      </input>
      <output id="out_0_decisao" name="decisao" typeRef="string"/>
      <output id="out_1_motivoTab38" name="motivoTab38" typeRef="string"/>
      <output id="out_2_idRegra" name="idRegra" typeRef="string"/>
      <output id="out_3_fila" name="fila" typeRef="string"/>
      <output id="out_classeAdverso" name="classeAdverso" typeRef="string"/>
      <rule id="pre">
        <description>OMNI-CLIN-AUT-0008 — antes da vigência (03/12/2026): regras CLIN não se aplicam</description>
        <inputEntry><text>&lt; "2026-12-03"</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"liberar"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-CLIN-AUT-0008"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="urg">
        <description>OMNI-CLIN-AUT-0008 — urgência ou emergência (caráter 2), qualquer código ou item: liberação sem autorização prévia</description>
        <inputEntry><text>&gt;= "2026-12-03"</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>"2"</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"liberar"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-CLIN-AUT-0008"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
