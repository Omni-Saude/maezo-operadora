<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:camunda="http://camunda.org/schema/1.0/dmn" id="def_clin_cobertura" name="Procedimentos clínicos: cobertura sem restrição adicional e nutrição na internação" namespace="https://omni-saude/dmn/procedimentos-clinicos">
  <decision id="rco_clin_cobertura" name="Procedimentos clínicos: cobertura sem restrição adicional e nutrição na internação" camunda:historyTimeToLive="P3650D">
    <description>OMNI-CLIN-COB-0001 a COB-0011. Domínio procedimentos-clinicos. Hit policy UNIQUE; nenhuma linha nega ou glosa; segmento do plano incompatível, classe de nutrição ausente ou uso fora da internação vão à revisão humana; a linha de fechamento (data ausente) vai à regulação. Os códigos são agrupados pelas classes e famílias de regras/procedimentos-clinicos/dominio.yaml; a classe cruza o limite de algumas regras (curativo, cardioversão), por isso a linha cita o código.</description>
    <decisionTable id="dt_clin_cobertura" hitPolicy="UNIQUE">
      <input id="in_0_dataAtendimento" label="dataAtendimento ← TISS dataSolicitacao (pedido) ou dataExecucao (conta), AAAA-MM-DD">
        <inputExpression id="ie_0_dataAtendimento" typeRef="string"><text>dataAtendimento</text></inputExpression>
      </input>
      <input id="in_1_codigoProcedimento" label="codigoProcedimento ← TISS codigoProcedimento (TUSS 22); nulo em item de conta sem código TUSS 22 (nutrição, material)">
        <inputExpression id="ie_1_codigoProcedimento" typeRef="string"><text>codigoProcedimento</text></inputExpression>
      </input>
      <input id="in_2_planoSoAmbulatorial" label="planoSoAmbulatorial ← cadastro do produto: segmentação só ambulatorial (booleano)">
        <inputExpression id="ie_2_planoSoAmbulatorial" typeRef="boolean"><text>planoSoAmbulatorial</text></inputExpression>
      </input>
      <input id="in_3_planoSoHospitalar" label="planoSoHospitalar ← cadastro do produto: segmentação só hospitalar (booleano)">
        <inputExpression id="ie_3_planoSoHospitalar" typeRef="boolean"><text>planoSoHospitalar</text></inputExpression>
      </input>
      <input id="in_4_classeItemNutricao" label="classeItemNutricao ← cadastro OMNI de materiais: classe do item de nutrição">
        <inputExpression id="ie_4_classeItemNutricao" typeRef="string"><text>classeItemNutricao</text></inputExpression>
      </input>
      <input id="in_5_regime" label="regime ← TISS regimeInternacao ou regimeAtendimento (ambulatorial, internacao, hospital_dia, pronto_socorro)">
        <inputExpression id="ie_5_regime" typeRef="string"><text>regime</text></inputExpression>
      </input>
      <output id="out_0_decisao" name="decisao" typeRef="string"/>
      <output id="out_1_motivoTab38" name="motivoTab38" typeRef="string"/>
      <output id="out_2_idRegra" name="idRegra" typeRef="string"/>
      <output id="out_3_fila" name="fila" typeRef="string"/>
      <output id="out_classeAdverso" name="classeAdverso" typeRef="string"/>
      <rule id="pre">
        <description>OMNI-CLIN-COB-0001 — antes da vigência (03/12/2026): regras CLIN não se aplicam</description>
        <inputEntry><text>&lt; "2026-12-03"</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"liberar"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-CLIN-COB-0001"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="c0001_livre">
        <description>OMNI-CLIN-COB-0001 — código com os três segmentos do Rol: cobertura sem restrição adicional</description>
        <inputEntry><text>&gt;= "2026-12-03"</text></inputEntry>
        <inputEntry><text>"20102070", "20202016", "20202024"</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"liberar"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-CLIN-COB-0001"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="c0001_h_gate">
        <description>OMNI-CLIN-COB-0001 — código só hospitalar e plano só ambulatorial: regulação, sem negativa</description>
        <inputEntry><text>&gt;= "2026-12-03"</text></inputEntry>
