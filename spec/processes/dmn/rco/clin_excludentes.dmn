<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:camunda="http://camunda.org/schema/1.0/dmn" id="def_clin_excludentes" name="Procedimentos clínicos: avaliações que incluem consulta e imunoterapia específica com inespecífica" namespace="https://omni-saude/dmn/procedimentos-clinicos">
  <decision id="rco_clin_excludentes" name="Procedimentos clínicos: avaliações que incluem consulta e imunoterapia específica com inespecífica" camunda:historyTimeToLive="P3650D">
    <description>OMNI-CLIN-MEX-0001, MEX-0002 e MEX-0003. Domínio procedimentos-clinicos. Hit policy UNIQUE; nenhuma linha nega ou glosa; o par cobrado na mesma data pelo mesmo executante vai à revisão do faturamento (indicador de exceção 1 em MEX-0001 e MEX-0003, sem exceção em MEX-0002); dado ausente vai à regulação; fechamento null vai à regulação.</description>
    <decisionTable id="dt_clin_excludentes" hitPolicy="UNIQUE">
      <input id="in_0_dataAtendimento" label="dataAtendimento ← TISS dataSolicitacao (pedido) ou dataExecucao (conta), AAAA-MM-DD">
        <inputExpression id="ie_0_dataAtendimento" typeRef="string"><text>dataAtendimento</text></inputExpression>
      </input>
      <input id="in_1_codigoPrincipal" label="codigoPrincipal ← TISS codigoProcedimento (TUSS 22) do procedimento principal do par">
        <inputExpression id="ie_1_codigoPrincipal" typeRef="string"><text>codigoPrincipal</text></inputExpression>
      </input>
      <input id="in_2_codigoSecundario" label="codigoSecundario ← TISS codigoProcedimento (TUSS 22) do procedimento secundário do par, mesma guia ou mesma data">
        <inputExpression id="ie_2_codigoSecundario" typeRef="string"><text>codigoSecundario</text></inputExpression>
      </input>
      <input id="in_3_mesmoExecutante" label="mesmoExecutante ← TISS codigoProfissionalExecutante (ou CNPJ do contratado) igual nos dois procedimentos do par, na mesma data">
        <inputExpression id="ie_3_mesmoExecutante" typeRef="boolean"><text>mesmoExecutante</text></inputExpression>
      </input>
      <input id="in_4_descricaoProgramacaoDispositivo" label="descricaoProgramacaoDispositivo ← anexo da conta: programação feita no dispositivo cardíaco descrita no prontuário (booleano)">
        <inputExpression id="ie_4_descricaoProgramacaoDispositivo" typeRef="boolean"><text>descricaoProgramacaoDispositivo</text></inputExpression>
      </input>
      <input id="in_5_faseTratamentoDistinta" label="faseTratamentoDistinta ← solicitação: relatório informa fase do tratamento distinta para a segunda imunoterapia (booleano)">
        <inputExpression id="ie_5_faseTratamentoDistinta" typeRef="boolean"><text>faseTratamentoDistinta</text></inputExpression>
      </input>
      <output id="out_0_decisao" name="decisao" typeRef="string"/>
      <output id="out_1_motivoTab38" name="motivoTab38" typeRef="string"/>
      <output id="out_2_idRegra" name="idRegra" typeRef="string"/>
      <output id="out_3_fila" name="fila" typeRef="string"/>
      <output id="out_classeAdverso" name="classeAdverso" typeRef="string"/>
      <rule id="pre">
        <description>OMNI-CLIN-MEX-0001 — antes da vigência (03/12/2026): regras CLIN não se aplicam</description>
        <inputEntry><text>&lt; "2026-12-03"</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"liberar"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-CLIN-MEX-0001"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="m1_nulo">
        <description>OMNI-CLIN-MEX-0001 — executante dos dois atos não comparável: regulação, sem glosa</description>
        <inputEntry><text>&gt;= "2026-12-03"</text></inputEntry>
        <inputEntry><text>"20101201"</text></inputEntry>
        <inputEntry><text>"10101012", "10106014", "10106030", "10106049", "10106146", "10106154", "10101039"</text></inputEntry>
        <inputEntry><text>null</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"revisao_humana"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-CLIN-MEX-0001"</text></outputEntry>
        <outputEntry><text>"regulacao"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="m1_outro">
        <description>OMNI-CLIN-MEX-0001 — executantes diferentes: liberar</description>
        <inputEntry><text>&gt;= "2026-12-03"</text></inputEntry>
        <inputEntry><text>"20101201"</text></inputEntry>
        <inputEntry><text>"10101012", "10106014", "10106030", "10106049", "10106146", "10106154", "10101039"</text></inputEntry>
        <inputEntry><text>false</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"liberar"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-CLIN-MEX-0001"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="m1_exc">
        <description>OMNI-CLIN-MEX-0001 — mesmo executante, programação do dispositivo descrita (indicador de exceção 1): liberar</description>
        <inputEntry><text>&gt;= "2026-12-03"</text></inputEntry>
        <inputEntry><text>"20101201"</text></inputEntry>
        <inputEntry><text>"10101012", "10106014", "10106030", "10106049", "10106146", "10106154", "10101039"</text></inputEntry>
        <inputEntry><text>true</text></inputEntry>
        <inputEntry><text>true</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"liberar"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-CLIN-MEX-0001"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="m1_par">
        <description>OMNI-CLIN-MEX-0001 — mesmo executante, sem descrição da programação do dispositivo: faturamento, sem glosa automática</description>
        <inputEntry><text>&gt;= "2026-12-03"</text></inputEntry>
        <inputEntry><text>"20101201"</text></inputEntry>
        <inputEntry><text>"10101012", "10106014", "10106030", "10106049", "10106146", "10106154", "10101039"</text></inputEntry>
        <inputEntry><text>true</text></inputEntry>
        <inputEntry><text>false, null</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"revisao_humana"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-CLIN-MEX-0001"</text></outputEntry>
        <outputEntry><text>"faturamento"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="m2_nulo">
        <description>OMNI-CLIN-MEX-0002 — executante dos dois atos não comparável: regulação, sem glosa</description>
        <inputEntry><text>&gt;= "2026-12-03"</text></inputEntry>
        <inputEntry><text>"20101074", "20101090", "20101104", "41301048"</text></inputEntry>
        <inputEntry><text>"10101012", "10106014", "10106030", "10106049", "10106146", "10106154", "10101039"</text></inputEntry>
        <inputEntry><text>null</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"revisao_humana"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-CLIN-MEX-0002"</text></outputEntry>
        <outputEntry><text>"regulacao"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="m2_outro">
        <description>OMNI-CLIN-MEX-0002 — executantes diferentes: liberar</description>
        <inputEntry><text>&gt;= "2026-12-03"</text></inputEntry>
        <inputEntry><text>"20101074", "20101090", "20101104", "41301048"</text></inputEntry>
        <inputEntry><text>"10101012", "10106014", "10106030", "10106049", "10106146", "10106154", "10101039"</text></inputEntry>
        <inputEntry><text>false</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"liberar"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-CLIN-MEX-0002"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="m2_par">
        <description>OMNI-CLIN-MEX-0002 — mesmo executante, avaliação que inclui a consulta: faturamento, sem glosa automática</description>
        <inputEntry><text>&gt;= "2026-12-03"</text></inputEntry>
        <inputEntry><text>"20101074", "20101090", "20101104", "41301048"</text></inputEntry>
        <inputEntry><text>"10101012", "10106014", "10106030", "10106049", "10106146", "10106154", "10101039"</text></inputEntry>
        <inputEntry><text>true</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"revisao_humana"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-CLIN-MEX-0002"</text></outputEntry>
        <outputEntry><text>"faturamento"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="m3a_exc">
        <description>OMNI-CLIN-MEX-0003 — fase do tratamento distinta (indicador de exceção 1): liberar</description>
        <inputEntry><text>&gt;= "2026-12-03"</text></inputEntry>
        <inputEntry><text>"20104138"</text></inputEntry>
        <inputEntry><text>"20104146"</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>true</text></inputEntry>
        <outputEntry><text>"liberar"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-CLIN-MEX-0003"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="m3a_par">
        <description>OMNI-CLIN-MEX-0003 — imunoterapia específica e inespecífica na mesma unidade sem fase distinta: faturamento, sem glosa automática</description>
        <inputEntry><text>&gt;= "2026-12-03"</text></inputEntry>
        <inputEntry><text>"20104138"</text></inputEntry>
        <inputEntry><text>"20104146"</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>false</text></inputEntry>
        <outputEntry><text>"revisao_humana"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-CLIN-MEX-0003"</text></outputEntry>
        <outputEntry><text>"faturamento"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="m3a_nulo">
        <description>OMNI-CLIN-MEX-0003 — fase do tratamento não informada: regulação, sem glosa</description>
        <inputEntry><text>&gt;= "2026-12-03"</text></inputEntry>
        <inputEntry><text>"20104138"</text></inputEntry>
        <inputEntry><text>"20104146"</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>null</text></inputEntry>
        <outputEntry><text>"revisao_humana"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-CLIN-MEX-0003"</text></outputEntry>
        <outputEntry><text>"regulacao"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="m3b_exc">
        <description>OMNI-CLIN-MEX-0003 — fase do tratamento distinta (indicador de exceção 1): liberar</description>
        <inputEntry><text>&gt;= "2026-12-03"</text></inputEntry>
        <inputEntry><text>"20104146"</text></inputEntry>
        <inputEntry><text>"20104138"</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>true</text></inputEntry>
        <outputEntry><text>"liberar"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-CLIN-MEX-0003"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="m3b_par">
        <description>OMNI-CLIN-MEX-0003 — imunoterapia específica e inespecífica na mesma unidade sem fase distinta: faturamento, sem glosa automática</description>
        <inputEntry><text>&gt;= "2026-12-03"</text></inputEntry>
        <inputEntry><text>"20104146"</text></inputEntry>
        <inputEntry><text>"20104138"</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>false</text></inputEntry>
        <outputEntry><text>"revisao_humana"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-CLIN-MEX-0003"</text></outputEntry>
        <outputEntry><text>"faturamento"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="m3b_nulo">
        <description>OMNI-CLIN-MEX-0003 — fase do tratamento não informada: regulação, sem glosa</description>
        <inputEntry><text>&gt;= "2026-12-03"</text></inputEntry>
        <inputEntry><text>"20104146"</text></inputEntry>
        <inputEntry><text>"20104138"</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>null</text></inputEntry>
        <outputEntry><text>"revisao_humana"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-CLIN-MEX-0003"</text></outputEntry>
        <outputEntry><text>"regulacao"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="resto_p">
        <description>OMNI-CLIN-MEX-0001 — código principal sem par excludente no domínio: liberar</description>
        <inputEntry><text>&gt;= "2026-12-03"</text></inputEntry>
        <inputEntry><text>not("20101201", "20101074", "20101090", "20101104", "41301048", "20104138", "20104146")</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"liberar"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-CLIN-MEX-0001"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="resto_s1">
        <description>OMNI-CLIN-MEX-0001 — secundário fora do par de MEX-0001: liberar</description>
        <inputEntry><text>&gt;= "2026-12-03"</text></inputEntry>
        <inputEntry><text>"20101201"</text></inputEntry>
        <inputEntry><text>not("10101012", "10106014", "10106030", "10106049", "10106146", "10106154", "10101039")</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"liberar"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-CLIN-MEX-0001"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="resto_s2">
        <description>OMNI-CLIN-MEX-0002 — secundário fora do par de MEX-0002: liberar</description>
        <inputEntry><text>&gt;= "2026-12-03"</text></inputEntry>
        <inputEntry><text>"20101074", "20101090", "20101104", "41301048"</text></inputEntry>
        <inputEntry><text>not("10101012", "10106014", "10106030", "10106049", "10106146", "10106154", "10101039")</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"liberar"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-CLIN-MEX-0002"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="resto_s3a">
        <description>OMNI-CLIN-MEX-0003 — secundário fora do par de MEX-0003: liberar</description>
        <inputEntry><text>&gt;= "2026-12-03"</text></inputEntry>
        <inputEntry><text>"20104138"</text></inputEntry>
        <inputEntry><text>not("20104146")</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"liberar"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-CLIN-MEX-0003"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="resto_s3b">
        <description>OMNI-CLIN-MEX-0003 — secundário fora do par de MEX-0003: liberar</description>
        <inputEntry><text>&gt;= "2026-12-03"</text></inputEntry>
        <inputEntry><text>"20104146"</text></inputEntry>
        <inputEntry><text>not("20104138")</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"liberar"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-CLIN-MEX-0003"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="sem_data">
        <description>OMNI-CLIN-MEX-0001 — data ausente: regulação, nunca negativa</description>
        <inputEntry><text>null</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"revisao_humana"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-CLIN-MEX-0001"</text></outputEntry>
        <outputEntry><text>"regulacao"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
</definitions>
