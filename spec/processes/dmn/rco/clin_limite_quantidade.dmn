<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:camunda="http://camunda.org/schema/1.0/dmn" id="def_clin_limite_quantidade" name="Procedimentos clínicos: quantidade por dia, por semana, por tempo e tentativas de punção" namespace="https://omni-saude/dmn/procedimentos-clinicos">
  <decision id="rco_clin_limite_quantidade" name="Procedimentos clínicos: quantidade por dia, por semana, por tempo e tentativas de punção" camunda:historyTimeToLive="P3650D">
    <description>OMNI-CLIN-LIM-0001 a LIM-0006. Domínio procedimentos-clinicos. Hit policy UNIQUE; nenhuma linha nega ou glosa; quantidade acima do limite vai à revisão humana (faturamento, auditoria médica ou de enfermagem); dado ausente vai à regulação; os limites de LIM-0001, 0003, 0004, 0005 e 0006 são parâmetros provisórios (validacao/calibracao/parametros-provisorios/procedimentos-clinicos.csv) e os de LIM-0002 vêm da unidade do termo TUSS 22; fechamento null vai à regulação.</description>
    <decisionTable id="dt_clin_limite_quantidade" hitPolicy="UNIQUE">
      <input id="in_0_dataAtendimento" label="dataAtendimento ← TISS dataSolicitacao (pedido) ou dataExecucao (conta), AAAA-MM-DD">
        <inputExpression id="ie_0_dataAtendimento" typeRef="string"><text>dataAtendimento</text></inputExpression>
      </input>
      <input id="in_1_codigoProcedimento" label="codigoProcedimento ← TISS codigoProcedimento (TUSS 22); nulo em item de conta sem código TUSS 22 (nutrição, material)">
        <inputExpression id="ie_1_codigoProcedimento" typeRef="string"><text>codigoProcedimento</text></inputExpression>
      </input>
      <input id="in_2_caraterAtendimento" label="caraterAtendimento ← TISS caraterAtendimento (TUSS 23: 1 eletivo, 2 urgência ou emergência)">
        <inputExpression id="ie_2_caraterAtendimento" typeRef="string"><text>caraterAtendimento</text></inputExpression>
      </input>
      <input id="in_3_quantidadeDia" label="quantidadeDia ← TISS quantidadeExecutada somada do mesmo codigoProcedimento, beneficiário e dataExecucao">
        <inputExpression id="ie_3_quantidadeDia" typeRef="integer"><text>quantidadeDia</text></inputExpression>
      </input>
      <input id="in_4_visitaMesmoProfissionalDia" label="visitaMesmoProfissionalDia ← TISS conta: visita hospitalar (10102019) ou atendimento do intensivista (10104011, 10104020) do mesmo profissional no mesmo dia (booleano)">
        <inputExpression id="ie_4_visitaMesmoProfissionalDia" typeRef="boolean"><text>visitaMesmoProfissionalDia</text></inputExpression>
      </input>
      <input id="in_5_sessoesSemana" label="sessoesSemana ← TISS histórico de contas OMNI: execuções do mesmo código para o mesmo beneficiário nos 7 dias até a dataExecucao, somada a esta">
        <inputExpression id="ie_5_sessoesSemana" typeRef="integer"><text>sessoesSemana</text></inputExpression>
      </input>
      <input id="in_6_indicacaoAguda" label="indicacaoAguda ← solicitação: doenca_descompressiva, embolia_traumatica_ar, embolia_gasosa ou outra">
        <inputExpression id="ie_6_indicacaoAguda" typeRef="string"><text>indicacaoAguda</text></inputExpression>
      </input>
      <input id="in_7_itemInclusoCobradoAParte" label="itemInclusoCobradoAParte ← TISS conta: gás, taxa ou equipamento da sessão hiperbárica cobrado em linha separada (booleano)">
        <inputExpression id="ie_7_itemInclusoCobradoAParte" typeRef="boolean"><text>itemInclusoCobradoAParte</text></inputExpression>
      </input>
      <input id="in_8_justificativaTrocaCurativo" label="justificativaTrocaCurativo ← anexo da conta: justificativa da troca de curativo no prontuário (booleano)">
        <inputExpression id="ie_8_justificativaTrocaCurativo" typeRef="boolean"><text>justificativaTrocaCurativo</text></inputExpression>
      </input>
      <input id="in_9_classeMaterial" label="classeMaterial ← cadastro OMNI de materiais: classe do item (TUSS 19 → classe)">
        <inputExpression id="ie_9_classeMaterial" typeRef="string"><text>classeMaterial</text></inputExpression>
      </input>
      <input id="in_10_quantidadeProfissional" label="quantidadeProfissional ← TISS quantidadeExecutada de tentativas de punção do mesmo profissional executante no episódio">
        <inputExpression id="ie_10_quantidadeProfissional" typeRef="integer"><text>quantidadeProfissional</text></inputExpression>
      </input>
      <input id="in_11_quantidadeEpisodio" label="quantidadeEpisodio ← TISS quantidadeExecutada de tentativas de punção no episódio, todos os profissionais">
        <inputExpression id="ie_11_quantidadeEpisodio" typeRef="integer"><text>quantidadeEpisodio</text></inputExpression>
      </input>
      <output id="out_0_decisao" name="decisao" typeRef="string"/>
      <output id="out_1_motivoTab38" name="motivoTab38" typeRef="string"/>
      <output id="out_2_idRegra" name="idRegra" typeRef="string"/>
      <output id="out_3_fila" name="fila" typeRef="string"/>
      <output id="out_classeAdverso" name="classeAdverso" typeRef="string"/>
      <rule id="pre">
        <description>OMNI-CLIN-LIM-0001 — antes da vigência (03/12/2026): regras CLIN não se aplicam</description>
        <inputEntry><text>&lt; "2026-12-03"</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"liberar"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-CLIN-LIM-0001"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
