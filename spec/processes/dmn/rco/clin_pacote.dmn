<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:camunda="http://camunda.org/schema/1.0/dmn" id="def_clin_pacote" name="Procedimentos clínicos: composição da conta de dietas e fórmulas na internação (sem pacote de episódio)" namespace="https://omni-saude/dmn/procedimentos-clinicos">
  <decision id="rco_clin_pacote" name="Procedimentos clínicos: composição da conta de dietas e fórmulas na internação (sem pacote de episódio)" camunda:historyTimeToLive="P3650D">
    <description>OMNI-CLIN-PAC-0001, PAC-0002 e PAC-0003. Domínio procedimentos-clinicos. Regras de composição de conta, não pacote de episódio (decisão CLIN-17): pagar_pacote significa pagar o item pela composição da diária. Hit policy UNIQUE; nenhuma linha nega ou glosa; item incluído na diária e cobrado à parte, item à parte sem prescrição e checagem e classe ausente vão à revisão do faturamento; fechamento null vai à regulação.</description>
    <decisionTable id="dt_clin_pacote" hitPolicy="UNIQUE">
      <input id="in_0_dataAtendimento" label="dataAtendimento ← TISS dataSolicitacao (pedido) ou dataExecucao (conta), AAAA-MM-DD">
        <inputExpression id="ie_0_dataAtendimento" typeRef="string"><text>dataAtendimento</text></inputExpression>
      </input>
      <input id="in_1_regime" label="regime ← TISS regimeInternacao ou regimeAtendimento (ambulatorial, internacao, hospital_dia, pronto_socorro)">
        <inputExpression id="ie_1_regime" typeRef="string"><text>regime</text></inputExpression>
      </input>
      <input id="in_2_classeItemNutricao" label="classeItemNutricao ← cadastro OMNI de materiais: classe do item de nutrição">
        <inputExpression id="ie_2_classeItemNutricao" typeRef="string"><text>classeItemNutricao</text></inputExpression>
      </input>
      <input id="in_3_cobradoAParte" label="cobradoAParte ← TISS conta: item lançado em linha separada da diária hospitalar (booleano)">
        <inputExpression id="ie_3_cobradoAParte" typeRef="boolean"><text>cobradoAParte</text></inputExpression>
      </input>
      <input id="in_4_prescricaoEChecagem" label="prescricaoEChecagem ← anexo da conta: prescrição médica e checagem da enfermagem no prontuário (booleano)">
        <inputExpression id="ie_4_prescricaoEChecagem" typeRef="boolean"><text>prescricaoEChecagem</text></inputExpression>
      </input>
      <output id="out_0_decisao" name="decisao" typeRef="string"/>
      <output id="out_1_motivoTab38" name="motivoTab38" typeRef="string"/>
      <output id="out_2_idRegra" name="idRegra" typeRef="string"/>
      <output id="out_3_fila" name="fila" typeRef="string"/>
      <output id="out_classeAdverso" name="classeAdverso" typeRef="string"/>
      <rule id="pre">
        <description>OMNI-CLIN-PAC-0001 — antes da vigência (03/12/2026): regras CLIN não se aplicam</description>
        <inputEntry><text>&lt; "2026-12-03"</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"liberar"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-CLIN-PAC-0001"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="i_formula_infantil_padrao_na">
        <description>OMNI-CLIN-PAC-0001 — formula_infantil_padrao está na diária: pagar pela composição</description>
        <inputEntry><text>&gt;= "2026-12-03"</text></inputEntry>
        <inputEntry><text>"internacao"</text></inputEntry>
        <inputEntry><text>"formula_infantil_padrao"</text></inputEntry>
        <inputEntry><text>false</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"pagar_pacote"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-CLIN-PAC-0001"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="i_formula_infantil_padrao_cobra">
        <description>OMNI-CLIN-PAC-0001 — formula_infantil_padrao cobrado à parte da diária: faturamento, sem glosa automática</description>
        <inputEntry><text>&gt;= "2026-12-03"</text></inputEntry>
        <inputEntry><text>"internacao"</text></inputEntry>
        <inputEntry><text>"formula_infantil_padrao"</text></inputEntry>
        <inputEntry><text>true</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"revisao_humana"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-CLIN-PAC-0001"</text></outputEntry>
        <outputEntry><text>"faturamento"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
