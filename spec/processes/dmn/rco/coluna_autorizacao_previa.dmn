<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:camunda="http://camunda.org/schema/1.0/dmn" id="def_coluna_autorizacao_previa" name="Autorização prévia de cirurgia de coluna (OMNI-COLUNA-AUT-0001)" namespace="https://omni-saude/dmn/opme-coluna">
  <decision id="rco_coluna_autorizacao_previa" name="Autorização prévia de cirurgia de coluna (OMNI-COLUNA-AUT-0001)" camunda:historyTimeToLive="P3650D">
    <description>OMNI-COLUNA-AUT-0001; OMNI-COLUNA-AUT-0002. Domínio opme-coluna. Gerado por scripts do piloto; hit policy UNIQUE, sem lacuna (linhas de fechamento nunca negam).</description>
    <decisionTable id="dt_coluna_autorizacao_previa" hitPolicy="UNIQUE">
      <input id="in_0_dataAtendimento" label="dataAtendimento ← TISS dataSolicitacao (pedido) ou dataExecucao (conta), AAAA-MM-DD">
        <inputExpression id="ie_0_dataAtendimento" typeRef="string"><text>dataAtendimento</text></inputExpression>
      </input>
      <input id="in_1_codigoProcedimento" label="codigoProcedimento ← TISS codigoProcedimento (TUSS 22)">
        <inputExpression id="ie_1_codigoProcedimento" typeRef="string"><text>codigoProcedimento</text></inputExpression>
      </input>
      <input id="in_2_caraterAtendimento" label="caraterAtendimento ← TISS caraterAtendimento (TUSS 23: 1 eletivo, 2 urgência/emergência)">
        <inputExpression id="ie_2_caraterAtendimento" typeRef="string"><text>caraterAtendimento</text></inputExpression>
      </input>
      <output id="out_0_decisao" name="decisao" typeRef="string"/>
      <output id="out_1_motivoTab38" name="motivoTab38" typeRef="string"/>
      <output id="out_2_idRegra" name="idRegra" typeRef="string"/>
      <output id="out_3_fila" name="fila" typeRef="string"/>
      <output id="out_classeAdverso" name="classeAdverso" typeRef="string"/>
      <rule id="r002">
        <description>OMNI-COLUNA-AUT-0001 — Antes da vigência das regras canônicas (2026-11-03): fluxo anterior, com revisão</description>
        <inputEntry><text>&lt; "2026-11-03"</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"revisao_humana"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-COLUNA-AUT-0001"</text></outputEntry>
        <outputEntry><text>"regulacao"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="r003">
        <description>OMNI-COLUNA-AUT-0001 — Urgência/emergência: sem autorização prévia (comunicar OPME em 2 dias úteis)</description>
        <inputEntry><text>&gt;= "2026-11-03"</text></inputEntry>
        <inputEntry><text>"30715016", "30715024", "30715032", "30715040", "30715059", "30715067", "30715075", "30715083", "30715091", "30715105", "30715113", "30715148", "30715164", "30715172", "30715180", "30715199", "30715202", "30715210", "30715229", "30715245", "30715261", "30715270", "30715288", "30715296", "30715300", "30715318", "30715326", "30715334", "30715350", "30715369", "30715385", "30715393", "30715407", "30715423", "30715598", "30715121", "30715130", "30715156", "30715253", "30715342", "30715237"</text></inputEntry>
        <inputEntry><text>"2"</text></inputEntry>
        <outputEntry><text>"liberar"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-COLUNA-AUT-0001"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="r004">
        <description>OMNI-COLUNA-AUT-0001 — Eletivo (ou caráter não informado): exige autorização prévia</description>
        <inputEntry><text>&gt;= "2026-11-03"</text></inputEntry>
        <inputEntry><text>"30715016", "30715024", "30715032", "30715040", "30715059", "30715067", "30715075", "30715083", "30715091", "30715105", "30715113", "30715148", "30715164", "30715172", "30715180", "30715199", "30715202", "30715210", "30715229", "30715245", "30715261", "30715270", "30715288", "30715296", "30715300", "30715318", "30715326", "30715334", "30715350", "30715369", "30715385", "30715393", "30715407", "30715423", "30715598", "30715121", "30715130", "30715156", "30715253", "30715342"</text></inputEntry>
        <inputEntry><text>not("2")</text></inputEntry>
        <outputEntry><text>"exigir_autorizacao"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-COLUNA-AUT-0001"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="r005">
        <description>OMNI-COLUNA-AUT-0002 — Outras afecções - tratamento incruento: eletivo só com relatório médico (v36 p. 170)</description>
        <inputEntry><text>&gt;= "2026-11-03"</text></inputEntry>
        <inputEntry><text>"30715237"</text></inputEntry>
        <inputEntry><text>not("2")</text></inputEntry>
        <outputEntry><text>"exigir_documento"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-COLUNA-AUT-0002"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="r006">
        <description>OMNI-COLUNA-AUT-0001 — Fechamento: código fora do escopo do domínio</description>
        <inputEntry><text>&gt;= "2026-11-03"</text></inputEntry>
        <inputEntry><text>not("30715016", "30715024", "30715032", "30715040", "30715059", "30715067", "30715075", "30715083", "30715091", "30715105", "30715113", "30715148", "30715164", "30715172", "30715180", "30715199", "30715202", "30715210", "30715229", "30715245", "30715261", "30715270", "30715288", "30715296", "30715300", "30715318", "30715326", "30715334", "30715350", "30715369", "30715385", "30715393", "30715407", "30715423", "30715598", "30715121", "30715130", "30715156", "30715253", "30715342", "30715237")</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"liberar"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-COLUNA-AUT-0001"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="r001">
        <description>OMNI-COLUNA-AUT-0001 — Data ausente: revisão de cadastro da guia</description>
        <inputEntry><text>null</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"revisao_humana"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-COLUNA-AUT-0001"</text></outputEntry>
        <outputEntry><text>"regulacao"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
</definitions>
