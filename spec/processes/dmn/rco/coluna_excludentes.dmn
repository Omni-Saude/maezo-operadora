<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:camunda="http://camunda.org/schema/1.0/dmn" id="def_coluna_excludentes" name="Pares de procedimentos de coluna que não se somam (OMNI-COLUNA-MEX-0001 a 0006)" namespace="https://omni-saude/dmn/opme-coluna">
  <decision id="rco_coluna_excludentes" name="Pares de procedimentos de coluna que não se somam (OMNI-COLUNA-MEX-0001 a 0006)" camunda:historyTimeToLive="P3650D">
    <description>OMNI-COLUNA-MEX-0001; OMNI-COLUNA-MEX-0002; OMNI-COLUNA-MEX-0003; OMNI-COLUNA-MEX-0004; OMNI-COLUNA-MEX-0005; OMNI-COLUNA-MEX-0006. Domínio opme-coluna. Gerado por scripts do piloto; hit policy UNIQUE, sem lacuna (linhas de fechamento nunca negam).</description>
    <decisionTable id="dt_coluna_excludentes" hitPolicy="UNIQUE">
      <input id="in_0_dataAtendimento" label="dataAtendimento ← TISS dataSolicitacao (pedido) ou dataExecucao (conta), AAAA-MM-DD">
        <inputExpression id="ie_0_dataAtendimento" typeRef="string"><text>dataAtendimento</text></inputExpression>
      </input>
      <input id="in_1_codigoPrincipal" label="codigoPrincipal ← TISS codigoProcedimento do procedimento de referência na mesma guia/ato">
        <inputExpression id="ie_1_codigoPrincipal" typeRef="string"><text>codigoPrincipal</text></inputExpression>
      </input>
      <input id="in_2_codigoSecundario" label="codigoSecundario ← TISS codigoProcedimento do outro procedimento na mesma guia/ato">
        <inputExpression id="ie_2_codigoSecundario" typeRef="string"><text>codigoSecundario</text></inputExpression>
      </input>
      <input id="in_3_codigoSecundarioOutraData" label="codigoSecundarioOutraData ← TISS codigoProcedimento de outra linha da mesma guia com dataExecucao DIFERENTE da linha avaliada e que forma par com o codigoPrincipal (derivado); nulo se não houver">
        <inputExpression id="ie_3_codigoSecundarioOutraData" typeRef="string"><text>codigoSecundarioOutraData</text></inputExpression>
      </input>
      <input id="in_3b_dataExecucaoInformada" label="dataExecucaoInformada ← TISS dataExecucao das linhas da guia que formam par com o codigoPrincipal (derivado): false se alguma não tem data; nulo se a guia não foi extraída">
        <inputExpression id="ie_3b_dataExecucaoInformada" typeRef="boolean"><text>dataExecucaoInformada</text></inputExpression>
      </input>
      <input id="in_4_cidExcecaoDescompressao" label="cidExcecaoDescompressao ← TISS CID principal da guia (derivado): na lista de compressão tumoral, traumática ou inflamatória (lista em LACUNA: enviar nulo)">
        <inputExpression id="ie_4_cidExcecaoDescompressao" typeRef="boolean"><text>cidExcecaoDescompressao</text></inputExpression>
      </input>
      <input id="in_5_substituicaoCorpoVertebralNaGuia" label="substituicaoCorpoVertebralNaGuia ← TISS codigoProcedimento das linhas da guia (derivado): 30715288 (substituição de corpo vertebral) entre os executados">
        <inputExpression id="ie_5_substituicaoCorpoVertebralNaGuia" typeRef="boolean"><text>substituicaoCorpoVertebralNaGuia</text></inputExpression>
      </input>
      <input id="in_6_descricaoCirurgicaAnexada" label="descricaoCirurgicaAnexada ← anexo da conta: descrição cirúrgica presente (sim/não); o texto nunca entra no payload">
        <inputExpression id="ie_6_descricaoCirurgicaAnexada" typeRef="boolean"><text>descricaoCirurgicaAnexada</text></inputExpression>
      </input>
      <input id="in_7_prazoDocumentoVencido" label="prazoDocumentoVencido ← fluxo Camunda: a OMNI pediu o documento faltante e o prazo de 5 dias úteis venceu">
        <inputExpression id="ie_7_prazoDocumentoVencido" typeRef="boolean"><text>prazoDocumentoVencido</text></inputExpression>
      </input>
      <input id="in_8_quantidade" label="quantidade ← TISS quantidadeExecutada da linha do codigoSecundario (30715016) na mesma guia: a base do 30715385 cobre um segmento">
        <inputExpression id="ie_8_quantidade" typeRef="integer"><text>quantidade</text></inputExpression>
      </input>
      <output id="out_0_decisao" name="decisao" typeRef="string"/>
      <output id="out_1_motivoTab38" name="motivoTab38" typeRef="string"/>
      <output id="out_2_idRegra" name="idRegra" typeRef="string"/>
      <output id="out_3_fila" name="fila" typeRef="string"/>
      <output id="out_classeAdverso" name="classeAdverso" typeRef="string"/>
      <rule id="r002">
        <description>OMNI-COLUNA-AUT-0001 — Antes da vigência das regras canônicas (2026-11-03): fluxo anterior, com revisão</description>
        <inputEntry><text>&lt; "2026-11-03"</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"revisao_humana"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-COLUNA-AUT-0001"</text></outputEntry>
