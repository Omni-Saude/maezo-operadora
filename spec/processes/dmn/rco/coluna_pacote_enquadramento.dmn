<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:camunda="http://camunda.org/schema/1.0/dmn" id="def_coluna_pacote_enquadramento" name="Enquadramento nos pacotes de coluna (OMNI-COLUNA-PAC-0001, PAC-0002)" namespace="https://omni-saude/dmn/opme-coluna">
  <decision id="rco_coluna_pacote_enquadramento" name="Enquadramento nos pacotes de coluna (OMNI-COLUNA-PAC-0001, PAC-0002)" camunda:historyTimeToLive="P3650D">
    <description>OMNI-COLUNA-PAC-0001; OMNI-COLUNA-PAC-0002. Domínio opme-coluna. Gerado por scripts do piloto; hit policy UNIQUE, sem lacuna (linhas de fechamento nunca negam).</description>
    <decisionTable id="dt_coluna_pacote_enquadramento" hitPolicy="UNIQUE">
      <input id="in_0_dataAtendimento" label="dataAtendimento ← TISS dataSolicitacao (pedido) ou dataExecucao (conta), AAAA-MM-DD">
        <inputExpression id="ie_0_dataAtendimento" typeRef="string"><text>dataAtendimento</text></inputExpression>
      </input>
      <input id="in_1_codigoProcedimento" label="codigoProcedimento ← TISS codigoProcedimento (TUSS 22)">
        <inputExpression id="ie_1_codigoProcedimento" typeRef="string"><text>codigoProcedimento</text></inputExpression>
      </input>
      <input id="in_2_caraterAtendimento" label="caraterAtendimento ← TISS caraterAtendimento (TUSS 23: 1 eletivo, 2 urgência/emergência)">
        <inputExpression id="ie_2_caraterAtendimento" typeRef="string"><text>caraterAtendimento</text></inputExpression>
      </input>
      <input id="in_3_prestadorComPacote" label="prestadorComPacote ← cadastro contratual: prestador com o pacote no anexo do contrato">
        <inputExpression id="ie_3_prestadorComPacote" typeRef="boolean"><text>prestadorComPacote</text></inputExpression>
      </input>
      <input id="in_4_quantidadeNiveis" label="quantidadeNiveis ← TISS quantidadeSolicitada do procedimento principal (segmentos)">
        <inputExpression id="ie_4_quantidadeNiveis" typeRef="integer"><text>quantidadeNiveis</text></inputExpression>
      </input>
      <input id="in_5_procedimentoCirurgicoAdicional" label="procedimentoCirurgicoAdicional ← a guia TISS traz outro código cirúrgico (TUSS 22, grupo 3) fora da composição do pacote">
        <inputExpression id="ie_5_procedimentoCirurgicoAdicional" typeRef="boolean"><text>procedimentoCirurgicoAdicional</text></inputExpression>
      </input>
      <output id="out_0_decisao" name="decisao" typeRef="string"/>
      <output id="out_1_motivoTab38" name="motivoTab38" typeRef="string"/>
      <output id="out_2_idRegra" name="idRegra" typeRef="string"/>
      <output id="out_3_fila" name="fila" typeRef="string"/>
      <output id="out_classeAdverso" name="classeAdverso" typeRef="string"/>
      <output id="out_4_codigoPacote" name="codigoPacote" typeRef="string"/>
      <output id="out_5_variantePacote" name="variantePacote" typeRef="string"/>
      <rule id="r002">
        <description>OMNI-COLUNA-PAC-0001 — Antes da vigência: conta aberta</description>
        <inputEntry><text>&lt; "2026-11-03"</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"liberar"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-COLUNA-PAC-0001"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="r003">
        <description>OMNI-COLUNA-PAC-0001 — Fechamento: procedimento sem pacote no domínio (conta aberta)</description>
        <inputEntry><text>&gt;= "2026-11-03"</text></inputEntry>
        <inputEntry><text>not("30715180", "30715016")</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"liberar"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-COLUNA-PAC-0001"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="r004">
        <description>OMNI-COLUNA-PAC-0001 — Prestador sem pacote contratado: conta aberta</description>
        <inputEntry><text>&gt;= "2026-11-03"</text></inputEntry>
        <inputEntry><text>"30715180"</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>false, null</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"liberar"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-COLUNA-PAC-0001"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="r005">
        <description>OMNI-COLUNA-PAC-0001 — Urgência: caso sai do pacote (conta aberta)</description>
        <inputEntry><text>&gt;= "2026-11-03"</text></inputEntry>
        <inputEntry><text>"30715180"</text></inputEntry>
        <inputEntry><text>"2"</text></inputEntry>
        <inputEntry><text>true</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"liberar"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-COLUNA-PAC-0001"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="r006">
        <description>OMNI-COLUNA-PAC-0001 — Eletivo, um nível: pacote base</description>
        <inputEntry><text>&gt;= "2026-11-03"</text></inputEntry>
        <inputEntry><text>"30715180"</text></inputEntry>
        <inputEntry><text>not("2")</text></inputEntry>
        <inputEntry><text>true</text></inputEntry>
        <inputEntry><text>1</text></inputEntry>
        <inputEntry><text>false, null</text></inputEntry>
        <outputEntry><text>"pagar_pacote"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-COLUNA-PAC-0001"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-PAC-COLUNA-0001"</text></outputEntry>
        <outputEntry><text>"BASE"</text></outputEntry>
      </rule>
      <rule id="r007">
        <description>OMNI-COLUNA-PAC-0001 — Eletivo, dois níveis: variante V01</description>
        <inputEntry><text>&gt;= "2026-11-03"</text></inputEntry>
        <inputEntry><text>"30715180"</text></inputEntry>
        <inputEntry><text>not("2")</text></inputEntry>
        <inputEntry><text>true</text></inputEntry>
        <inputEntry><text>2</text></inputEntry>
        <inputEntry><text>false, null</text></inputEntry>
        <outputEntry><text>"pagar_pacote"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-COLUNA-PAC-0001"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-PAC-COLUNA-0001"</text></outputEntry>
        <outputEntry><text>"V01"</text></outputEntry>
      </rule>
      <rule id="r008">
        <description>OMNI-COLUNA-PAC-0001 — Procedimento cirúrgico adicional: auditoria decide pacote ou conta aberta</description>
        <inputEntry><text>&gt;= "2026-11-03"</text></inputEntry>
        <inputEntry><text>"30715180"</text></inputEntry>
        <inputEntry><text>not("2")</text></inputEntry>
        <inputEntry><text>true</text></inputEntry>
        <inputEntry><text>[1..2]</text></inputEntry>
        <inputEntry><text>true</text></inputEntry>
        <outputEntry><text>"revisao_humana"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-COLUNA-PAC-0001"</text></outputEntry>
        <outputEntry><text>"auditoria_medica"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-PAC-COLUNA-0001"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="r009">
        <description>OMNI-COLUNA-PAC-0001 — Mais de dois níveis: conta aberta</description>
        <inputEntry><text>&gt;= "2026-11-03"</text></inputEntry>
        <inputEntry><text>"30715180"</text></inputEntry>
        <inputEntry><text>not("2")</text></inputEntry>
        <inputEntry><text>true</text></inputEntry>
        <inputEntry><text>&gt; 2</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"liberar"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-COLUNA-PAC-0001"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="r010">
        <description>OMNI-COLUNA-PAC-0001 — Níveis ausentes ou zero: pedir dado</description>
        <inputEntry><text>&gt;= "2026-11-03"</text></inputEntry>
        <inputEntry><text>"30715180"</text></inputEntry>
        <inputEntry><text>not("2")</text></inputEntry>
        <inputEntry><text>true</text></inputEntry>
        <inputEntry><text>&lt; 1, null</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"exigir_documento"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-COLUNA-PAC-0001"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="r011">
        <description>OMNI-COLUNA-PAC-0002 — Prestador sem pacote contratado: conta aberta</description>
        <inputEntry><text>&gt;= "2026-11-03"</text></inputEntry>
        <inputEntry><text>"30715016"</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>false, null</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"liberar"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-COLUNA-PAC-0002"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="r012">
        <description>OMNI-COLUNA-PAC-0002 — Urgência: caso sai do pacote (conta aberta)</description>
        <inputEntry><text>&gt;= "2026-11-03"</text></inputEntry>
        <inputEntry><text>"30715016"</text></inputEntry>
        <inputEntry><text>"2"</text></inputEntry>
        <inputEntry><text>true</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"liberar"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-COLUNA-PAC-0002"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="r013">
        <description>OMNI-COLUNA-PAC-0002 — Eletivo, um nível: pacote base</description>
        <inputEntry><text>&gt;= "2026-11-03"</text></inputEntry>
        <inputEntry><text>"30715016"</text></inputEntry>
        <inputEntry><text>not("2")</text></inputEntry>
        <inputEntry><text>true</text></inputEntry>
        <inputEntry><text>1</text></inputEntry>
        <inputEntry><text>false, null</text></inputEntry>
        <outputEntry><text>"pagar_pacote"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-COLUNA-PAC-0002"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-PAC-COLUNA-0002"</text></outputEntry>
        <outputEntry><text>"BASE"</text></outputEntry>
      </rule>
      <rule id="r014">
        <description>OMNI-COLUNA-PAC-0002 — Eletivo, dois níveis: variante V01</description>
        <inputEntry><text>&gt;= "2026-11-03"</text></inputEntry>
        <inputEntry><text>"30715016"</text></inputEntry>
        <inputEntry><text>not("2")</text></inputEntry>
        <inputEntry><text>true</text></inputEntry>
        <inputEntry><text>2</text></inputEntry>
        <inputEntry><text>false, null</text></inputEntry>
        <outputEntry><text>"pagar_pacote"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-COLUNA-PAC-0002"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-PAC-COLUNA-0002"</text></outputEntry>
        <outputEntry><text>"V01"</text></outputEntry>
      </rule>
      <rule id="r015">
        <description>OMNI-COLUNA-PAC-0002 — Procedimento cirúrgico adicional: auditoria decide pacote ou conta aberta</description>
        <inputEntry><text>&gt;= "2026-11-03"</text></inputEntry>
        <inputEntry><text>"30715016"</text></inputEntry>
        <inputEntry><text>not("2")</text></inputEntry>
        <inputEntry><text>true</text></inputEntry>
        <inputEntry><text>[1..2]</text></inputEntry>
        <inputEntry><text>true</text></inputEntry>
        <outputEntry><text>"revisao_humana"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-COLUNA-PAC-0002"</text></outputEntry>
        <outputEntry><text>"auditoria_medica"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-PAC-COLUNA-0002"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="r016">
        <description>OMNI-COLUNA-PAC-0002 — Mais de dois níveis: conta aberta</description>
        <inputEntry><text>&gt;= "2026-11-03"</text></inputEntry>
        <inputEntry><text>"30715016"</text></inputEntry>
        <inputEntry><text>not("2")</text></inputEntry>
        <inputEntry><text>true</text></inputEntry>
        <inputEntry><text>&gt; 2</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"liberar"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-COLUNA-PAC-0002"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="r017">
        <description>OMNI-COLUNA-PAC-0002 — Níveis ausentes ou zero: pedir dado</description>
        <inputEntry><text>&gt;= "2026-11-03"</text></inputEntry>
        <inputEntry><text>"30715016"</text></inputEntry>
        <inputEntry><text>not("2")</text></inputEntry>
        <inputEntry><text>true</text></inputEntry>
        <inputEntry><text>&lt; 1, null</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"exigir_documento"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-COLUNA-PAC-0002"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="r001">
        <description>OMNI-COLUNA-PAC-0001 — Data ausente</description>
        <inputEntry><text>null</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"revisao_humana"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-COLUNA-PAC-0001"</text></outputEntry>
        <outputEntry><text>"regulacao"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
