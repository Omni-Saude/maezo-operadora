<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:camunda="http://camunda.org/schema/1.0/dmn" id="def_compatibilidade_ortop" name="Compatibilidade entre CID e procedimento em mão, pé e menisco (OMNI-ORTOP-CMP-0001 a 0007)" namespace="https://omni-saude/dmn/ortopedia-opme">
  <decision id="rco_compatibilidade_ortop" name="Compatibilidade entre CID e procedimento em mão, pé e menisco (OMNI-ORTOP-CMP-0001 a 0007)" camunda:historyTimeToLive="P180D">
    <description>Confere se o código TUSS é o adequado para a condição. Nunca nega: divergência vai a auditoria. OMNI-ORTOP-CMP-0001 a OMNI-ORTOP-CMP-0007.</description>
    <decisionTable id="dt_compatibilidade_ortop" hitPolicy="UNIQUE">
      <input id="in_0_dataExecucao" label="dataExecucao ← TISS dataExecucao/dataRealizacao (inteiro AAAAMMDD)">
        <inputExpression id="ie_0_dataExecucao" typeRef="integer"><text>dataExecucao</text></inputExpression>
      </input>
      <input id="in_1_codigoProcedimento" label="codigoProcedimento ← TISS codigoProcedimento (TUSS 22)">
        <inputExpression id="ie_1_codigoProcedimento" typeRef="string"><text>codigoProcedimento</text></inputExpression>
      </input>
      <input id="in_2_cidPrincipal" label="cidPrincipal ← TISS diagnosticoPrincipal/CID-10 (4 caracteres, sem ponto)">
        <inputExpression id="ie_2_cidPrincipal" typeRef="string"><text>cidPrincipal</text></inputExpression>
      </input>
      <input id="in_3_idadeBeneficiario" label="idadeBeneficiario ← cadastro (anos completos na data de execução)">
        <inputExpression id="ie_3_idadeBeneficiario" typeRef="integer"><text>idadeBeneficiario</text></inputExpression>
      </input>
      <output id="out_decisao" name="decisao" typeRef="string"/>
      <output id="out_motivoTab38" name="motivoTab38" typeRef="string"/>
      <output id="out_idRegra" name="idRegra" typeRef="string"/>
      <output id="out_fila" name="fila" typeRef="string"/>
      <output id="out_classeAdverso" name="classeAdverso" typeRef="string"/>
      <rule id="r000">
        <description>OMNI-ORTOP-CMP-0006 — 30101778 compatível com M720</description>
        <inputEntry><text>&gt;= 20261103</text></inputEntry>
        <inputEntry><text>"30101778"</text></inputEntry>
        <inputEntry><text>"M720"</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"liberar"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-ORTOP-CMP-0006"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="r001">
        <description>OMNI-ORTOP-CMP-0006 — 30101778 com CID diferente de M720 ou sem CID</description>
        <inputEntry><text>&gt;= 20261103</text></inputEntry>
        <inputEntry><text>"30101778"</text></inputEntry>
        <inputEntry><text>not("M720")</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"revisao_humana"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-ORTOP-CMP-0006"</text></outputEntry>
        <outputEntry><text>"auditoria_medica"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
