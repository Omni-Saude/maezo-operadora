      </rule>
      <rule id="l_fora">
        <description>Fechamento: classe sem limite neste domínio (transporte, junta médica, consulta em domicílio)</description>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>not("consulta_ambulatorial", "consulta_pronto_socorro", "visita_hospitalar", "recem_nascido", "intensivista")</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
