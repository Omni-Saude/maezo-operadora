        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="l_vis_acima">
        <description>Visita do mesmo médico acima de uma por dia: auditoria de enfermagem</description>
        <inputEntry><text>&gt;= "2026-12-03"</text></inputEntry>
        <inputEntry><text>"visita_hospitalar"</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
