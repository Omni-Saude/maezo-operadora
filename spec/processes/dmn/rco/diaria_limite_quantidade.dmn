<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:camunda="http://camunda.org/schema/1.0/dmn" id="def_diaria_limite_quantidade" name="DIARIA: diaria_limite_quantidade (OMNI-DIARIA-LIM-0001, OMNI-DIARIA-LIM-0002, OMNI-DIARIA-LIM-0003, OMNI-DIARIA-LIM-0004, OMNI-DIARIA-LIM-0005, OMNI-DIARIA-LIM-0006, OMNI-DIARIA-LIM-0007, OMNI-DIARIA-LIM-0008, OMNI-DIARIA-LIM-0009, OMNI-DIARIA-LIM-0010, OMNI-DIARIA-LIM-0011, OMNI-DIARIA-LIM-0012, OMNI-DIARIA-LIM-0013)" namespace="https://omni-saude/dmn/diarias-taxas">
  <decision id="rco_diaria_limite_quantidade" name="DIARIA: diaria_limite_quantidade" camunda:historyTimeToLive="P3650D">
    <description>Decisão de conta do domínio DIARIA sobre a família ou classe do dominio.yaml (OMNI-DIARIA-LIM-0001, OMNI-DIARIA-LIM-0002, OMNI-DIARIA-LIM-0003, OMNI-DIARIA-LIM-0004, OMNI-DIARIA-LIM-0005, OMNI-DIARIA-LIM-0006, OMNI-DIARIA-LIM-0007, OMNI-DIARIA-LIM-0008, OMNI-DIARIA-LIM-0009, OMNI-DIARIA-LIM-0010, OMNI-DIARIA-LIM-0011, OMNI-DIARIA-LIM-0012, OMNI-DIARIA-LIM-0013). Nenhuma linha nega: gatilho atendido ou dado ausente vai à revisão humana; a linha final manda data ausente à revisão. Início de vigência 2026-12-03.</description>
    <decisionTable id="dt_diaria_limite_quantidade" hitPolicy="UNIQUE">
      <input id="in_dataAtendimento" label="dataAtendimento ← TISS dataExecucao do item cobrado (ct_procedimentoExecutadoInt), AAAA-MM-DD">
        <inputExpression id="ie_dataAtendimento" typeRef="string"><text>dataAtendimento</text></inputExpression>
      </input>
      <input id="in_familiaDiariaTaxa" label="familiaDiariaTaxa ← fluxo Camunda: chave do dominio.yaml (família tuss18_*, tema_* ou classe) derivada do TISS codigoProcedimento (TUSS 18) do item em checagem">
        <inputExpression id="ie_familiaDiariaTaxa" typeRef="string"><text>familiaDiariaTaxa</text></inputExpression>
      </input>
      <input id="in_criterioRevisaoAtendido" label="criterioRevisaoAtendido ← anexo da conta e TISS, derivado pelo worker por família (true = o critério de encaminhamento da regra da família foi atendido, conforme revisao_humana.criterio_encaminhamento em regras/diarias-taxas/; nulo = dado ausente)">
        <inputExpression id="ie_criterioRevisaoAtendido" typeRef="boolean"><text>criterioRevisaoAtendido</text></inputExpression>
      </input>
      <input id="in_reinternacaoMesmaCausa" label="reinternacaoMesmaCausa ← histórico TISS: nova internação do beneficiário pela mesma causa dentro de janela_readmissao_dias (dominio.yaml)">
        <inputExpression id="ie_reinternacaoMesmaCausa" typeRef="boolean"><text>reinternacaoMesmaCausa</text></inputExpression>
      </input>
      <input id="in_internacaoProgramadaOuComplicacao" label="internacaoProgramadaOuComplicacao ← anexo da conta: internação programada (quimioterapia, diálise, cirurgia em etapas) ou complicação documentada">
        <inputExpression id="ie_internacaoProgramadaOuComplicacao" typeRef="boolean"><text>internacaoProgramadaOuComplicacao</text></inputExpression>
      </input>
      <output id="out_decisao" name="decisao" typeRef="string"/>
      <output id="out_motivoTab38" name="motivoTab38" typeRef="string"/>
      <output id="out_idRegra" name="idRegra" typeRef="string"/>
      <output id="out_fila" name="fila" typeRef="string"/>
      <output id="out_classeAdverso" name="classeAdverso" typeRef="string"/>
      <rule id="r00">
        <description>Fora da vigência (antes de 2026-12-03)</description>
        <inputEntry><text>&lt; "2026-12-03"</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"liberar"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="r01">
        <description>OMNI-DIARIA-LIM-0001: gatilho atendido: revisão humana, sem negativa</description>
        <inputEntry><text>&gt;= "2026-12-03"</text></inputEntry>
        <inputEntry><text>"tema_desmame_ventilatorio","tuss18_respirador"</text></inputEntry>
        <inputEntry><text>true</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"revisao_humana"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-DIARIA-LIM-0001"</text></outputEntry>
        <outputEntry><text>"auditoria_medica"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="r02">
