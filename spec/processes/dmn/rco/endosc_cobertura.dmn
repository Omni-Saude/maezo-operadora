<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:camunda="http://camunda.org/schema/1.0/dmn" id="def_endosc_cobertura" name="Endoscopia: cobertura pelo Rol, fora do Rol e vínculo com a internação" namespace="https://omni-saude/dmn/endoscopia">
  <decision id="rco_endosc_cobertura" name="Endoscopia: cobertura pelo Rol, fora do Rol e vínculo com a internação" camunda:historyTimeToLive="P3650D">
    <description>OMNI-ENDOSC-COB-0001; OMNI-ENDOSC-COB-0002; OMNI-ENDOSC-COB-0003; OMNI-ENDOSC-COB-0004. Domínio endoscopia. Hit policy UNIQUE; nenhuma linha nega ou glosa; a linha de fechamento (data ausente) vai à revisão humana.</description>
    <decisionTable id="dt_endosc_cobertura" hitPolicy="UNIQUE">
      <input id="in_0_dataAtendimento" label="dataAtendimento ← TISS dataSolicitacao (pedido) ou dataExecucao (conta), AAAA-MM-DD">
        <inputExpression id="ie_0_dataAtendimento" typeRef="string"><text>dataAtendimento</text></inputExpression>
      </input>
      <input id="in_1_codigoProcedimento" label="codigoProcedimento ← TISS codigoProcedimento (TUSS 22)">
        <inputExpression id="ie_1_codigoProcedimento" typeRef="string"><text>codigoProcedimento</text></inputExpression>
      </input>
      <input id="in_2_planoSoAmbulatorial" label="planoSoAmbulatorial ← cadastro do produto: segmentação só ambulatorial (booleano)">
        <inputExpression id="ie_2_planoSoAmbulatorial" typeRef="boolean"><text>planoSoAmbulatorial</text></inputExpression>
      </input>
      <input id="in_3_regime" label="regime ← TISS regimeInternacao ou tipo de guia (ambulatorial, internacao, hospital_dia)">
        <inputExpression id="ie_3_regime" typeRef="string"><text>regime</text></inputExpression>
      </input>
      <input id="in_4_internacaoVinculada" label="internacaoVinculada ← TISS senha ou numeroGuiaSolicitacaoInternacao vinculada à guia na dataExecucao (booleano)">
        <inputExpression id="ie_4_internacaoVinculada" typeRef="boolean"><text>internacaoVinculada</text></inputExpression>
      </input>
      <output id="out_0_decisao" name="decisao" typeRef="string"/>
      <output id="out_1_motivoTab38" name="motivoTab38" typeRef="string"/>
      <output id="out_2_idRegra" name="idRegra" typeRef="string"/>
      <output id="out_3_fila" name="fila" typeRef="string"/>
      <output id="out_classeAdverso" name="classeAdverso" typeRef="string"/>
      <rule id="pre">
        <description>OMNI-ENDOSC-COB-0001 — antes da vigência (03/12/2026): regras ENDOSC não se aplicam</description>
        <inputEntry><text>&lt; "2026-12-03"</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"liberar"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-ENDOSC-COB-0001"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="c_fora">
        <description>OMNI-ENDOSC-COB-0001 — código fora do Rol: auditoria médica (art. 10, §13)</description>
        <inputEntry><text>&gt;= "2026-12-03"</text></inputEntry>
        <inputEntry><text>"40201317", "40201325", "40201376", "40201384", "40201392", "40201406", "40202070", "40202224", "40202232", "40202658", "40202755", "40202771", "40202801", "40202810", "40202828", "40202836"</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"revisao_humana"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-ENDOSC-COB-0001"</text></outputEntry>
        <outputEntry><text>"auditoria_medica"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
