      </rule>
      <rule id="m07">
        <description>OMNI-ENDOSC-MEX-0001 — par com 40201031 na mesma guia e data: auditoria médica, sem glosa automática</description>
        <inputEntry><text>&gt;= "2026-12-03"</text></inputEntry>
