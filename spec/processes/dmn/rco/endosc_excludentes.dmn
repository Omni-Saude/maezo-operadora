      </rule>
      <rule id="m06_ok">
        <description>OMNI-ENDOSC-MEX-0001 — 40202437 sem secundário do par: sem restrição desta tabela</description>
        <inputEntry><text>&gt;= "2026-12-03"</text></inputEntry>
        <inputEntry><text>"40202437"</text></inputEntry>
