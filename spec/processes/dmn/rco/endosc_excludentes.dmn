      </rule>
      <rule id="m07_ok">
        <description>OMNI-ENDOSC-MEX-0001 — 40201031 sem secundário do par: sem restrição desta tabela</description>
        <inputEntry><text>&gt;= "2026-12-03"</text></inputEntry>
        <inputEntry><text>"40201031"</text></inputEntry>
        <inputEntry><text>not("40201058")</text></inputEntry>
        <outputEntry><text>"liberar"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
