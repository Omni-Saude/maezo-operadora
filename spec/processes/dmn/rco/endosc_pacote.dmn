        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="p_resto">
        <description>OMNI-ENDOSC-PAC-0001 — código fora dos pacotes do domínio: conta aberta</description>
        <inputEntry><text>&gt;= "2026-12-03"</text></inputEntry>
        <inputEntry><text>not("40201031", "40202011", "40202054", "40202119", "40202208", "40202283", "40202356", "40202364", "40202399", "40202470", "40202500", "40202526", "40202798", "40201082", "40201120", "40201171", "40202038", "40202615", "40202666", "40202690")</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
