        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="p2_cad_nulo">
        <description>OMNI-ENDOSC-PAC-0002 — pacote do prestador não informado: cadastro, sem negativa</description>
        <inputEntry><text>&gt;= "2026-12-03"</text></inputEntry>
        <inputEntry><text>"40201082", "40201120", "40201171", "40202038", "40202615", "40202666", "40202690"</text></inputEntry>
