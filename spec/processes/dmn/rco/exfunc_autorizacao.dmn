<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:camunda="http://camunda.org/schema/1.0/dmn" id="def_exfunc_autorizacao" name="Exames funcionais: autorização prévia só nas DUT 68 e 5; critério publicado no tubo digestivo; urgência liberada (AUT-0001 a AUT-0004)" namespace="https://omni-saude/dmn/exames-funcionais">
  <decision id="rco_exfunc_autorizacao" name="Exames funcionais: autorização prévia só nas DUT 68 e 5; critério publicado no tubo digestivo; urgência liberada (AUT-0001 a AUT-0004)" camunda:historyTimeToLive="P3650D">
    <description>OMNI-EXFUNC-AUT-0001 a AUT-0004. Hit policy UNIQUE; nenhuma linha nega; urgência libera sem autorização nem documento; caráter ausente vai à regulação, nunca à autorização nem à glosa.</description>
    <decisionTable id="dt_exfunc_autorizacao" hitPolicy="UNIQUE">
      <input id="in_dataAtendimento" label="dataAtendimento ← TISS dataSolicitacao (pedido) ou dataExecucao (conta), AAAA-MM-DD">
