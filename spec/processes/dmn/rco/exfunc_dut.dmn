<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:camunda="http://camunda.org/schema/1.0/dmn" id="def_exfunc_dut" name="Exames funcionais com DUT: teste ergométrico (68), processamento auditivo central (5) e tomografia de coerência óptica (69) (DUT-0001 a DUT-0003)" namespace="https://omni-saude/dmn/exames-funcionais">
  <decision id="rco_exfunc_dut" name="Exames funcionais com DUT: teste ergométrico (68), processamento auditivo central (5) e tomografia de coerência óptica (69) (DUT-0001 a DUT-0003)" camunda:historyTimeToLive="P3650D">
    <description>OMNI-EXFUNC-DUT-0001 a DUT-0003. Hit policy UNIQUE; nenhuma linha nega; urgência libera; dado ausente gera a lista do que falta; fora da diretriz vai à auditoria médica; caráter ausente vai à regulação.</description>
    <decisionTable id="dt_exfunc_dut" hitPolicy="UNIQUE">
      <input id="in_dataAtendimento" label="dataAtendimento ← TISS dataSolicitacao (pedido) ou dataExecucao (conta), AAAA-MM-DD">
        <inputExpression id="ie_dataAtendimento" typeRef="string"><text>dataAtendimento</text></inputExpression>
      </input>
      <input id="in_codigoProcedimento" label="codigoProcedimento ← TISS codigoProcedimento (TUSS 22)">
        <inputExpression id="ie_codigoProcedimento" typeRef="string"><text>codigoProcedimento</text></inputExpression>
      </input>
      <input id="in_caraterAtendimento" label="caraterAtendimento ← TISS caraterAtendimento (TUSS 23: 1 eletivo, 2 urgência ou emergência)">
        <inputExpression id="ie_caraterAtendimento" typeRef="string"><text>caraterAtendimento</text></inputExpression>
      </input>
      <input id="in_itemDut68" label="itemDut68 ← solicitação (formulário do pedido): item da DUT 68 invocado pelo médico (1 a 13), 0 se nenhum se aplica">
        <inputExpression id="ie_itemDut68" typeRef="integer"><text>itemDut68</text></inputExpression>
      </input>
      <input id="in_idadeBeneficiario" label="idadeBeneficiario ← cadastro do beneficiário (anos completos)">
        <inputExpression id="ie_idadeBeneficiario" typeRef="integer"><text>idadeBeneficiario</text></inputExpression>
      </input>
      <input id="in_criterioGrupoI" label="criterioGrupoI ← solicitação (formulário do pedido): letra do critério do grupo I da DUT 5 (a a f)">
        <inputExpression id="ie_criterioGrupoI" typeRef="string"><text>criterioGrupoI</text></inputExpression>
      </input>
      <input id="in_criterioGrupoII" label="criterioGrupoII ← solicitação (formulário do pedido): critério do grupo II da DUT 5 presente (verdadeiro ou falso)">
        <inputExpression id="ie_criterioGrupoII" typeRef="boolean"><text>criterioGrupoII</text></inputExpression>
      </input>
      <input id="in_criterioDut69" label="criterioDut69 ← solicitação (formulário do pedido): letra do critério do item 1 da DUT 69 (a a d), 0 se nenhum se aplica">
        <inputExpression id="ie_criterioDut69" typeRef="string"><text>criterioDut69</text></inputExpression>
      </input>
      <output id="out_decisao" name="decisao" typeRef="string"/>
      <output id="out_motivoTab38" name="motivoTab38" typeRef="string"/>
      <output id="out_idRegra" name="idRegra" typeRef="string"/>
      <output id="out_fila" name="fila" typeRef="string"/>
      <output id="out_classeAdverso" name="classeAdverso" typeRef="string"/>
      <rule id="d_pre">
        <description>OMNI-EXFUNC-DUT-0001 — antes do início da vigência (03/12/2026): sem exigência nova</description>
        <inputEntry><text>&lt; "2026-12-03"</text></inputEntry>
        <inputEntry><text>"40101037", "40101045", "40103110", "40103803", "40103889", "40103897", "41401174", "41401182", "41501144"</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"liberar"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-EXFUNC-DUT-0001"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="d_sem_data">
        <description>OMNI-EXFUNC-DUT-0001 — data ausente: regulação confere</description>
        <inputEntry><text>null</text></inputEntry>
        <inputEntry><text>"40101037", "40101045", "40103110", "40103803", "40103889", "40103897", "41401174", "41401182", "41501144"</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"revisao_humana"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-EXFUNC-DUT-0001"</text></outputEntry>
        <outputEntry><text>"regulacao"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="d68_urg">
        <description>OMNI-EXFUNC-DUT-0001 — DUT 68, urgência: libera sem documento</description>
        <inputEntry><text>&gt;= "2026-12-03"</text></inputEntry>
        <inputEntry><text>"40101037", "40101045", "41401174", "41401182"</text></inputEntry>
        <inputEntry><text>"2"</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
