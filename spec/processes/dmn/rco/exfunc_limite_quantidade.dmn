<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:camunda="http://camunda.org/schema/1.0/dmn" id="def_exfunc_limite_quantidade" name="Exames funcionais: repetição em curto intervalo e limite anual (LIM-0001 a LIM-0003)" namespace="https://omni-saude/dmn/exames-funcionais">
  <decision id="rco_exfunc_limite_quantidade" name="Exames funcionais: repetição em curto intervalo e limite anual (LIM-0001 a LIM-0003)" camunda:historyTimeToLive="P3650D">
    <description>OMNI-EXFUNC-LIM-0001 a LIM-0003. Hit policy UNIQUE; nenhuma linha nega ou glosa; valor acima do parâmetro provisório vai à auditoria médica posterior; histórico ausente libera; data ausente vai à regulação.</description>
    <decisionTable id="dt_exfunc_limite_quantidade" hitPolicy="UNIQUE">
      <input id="in_dataAtendimento" label="dataAtendimento ← TISS dataSolicitacao (pedido) ou dataExecucao (conta), AAAA-MM-DD">
        <inputExpression id="ie_dataAtendimento" typeRef="string"><text>dataAtendimento</text></inputExpression>
      </input>
      <input id="in_codigoProcedimento" label="codigoProcedimento ← TISS codigoProcedimento (TUSS 22)">
        <inputExpression id="ie_codigoProcedimento" typeRef="string"><text>codigoProcedimento</text></inputExpression>
      </input>
      <input id="in_diasDesdeUltimoExame" label="diasDesdeUltimoExame ← TISS histórico de guias da OMNI: dias desde a última execução do mesmo código para o beneficiário">
        <inputExpression id="ie_diasDesdeUltimoExame" typeRef="integer"><text>diasDesdeUltimoExame</text></inputExpression>
      </input>
      <input id="in_quantidadeNoAno" label="quantidadeNoAno ← TISS histórico de guias da OMNI: execuções do código nos 365 dias anteriores">
        <inputExpression id="ie_quantidadeNoAno" typeRef="integer"><text>quantidadeNoAno</text></inputExpression>
      </input>
      <output id="out_decisao" name="decisao" typeRef="string"/>
      <output id="out_motivoTab38" name="motivoTab38" typeRef="string"/>
      <output id="out_idRegra" name="idRegra" typeRef="string"/>
      <output id="out_fila" name="fila" typeRef="string"/>
      <output id="out_classeAdverso" name="classeAdverso" typeRef="string"/>
      <rule id="l_pre">
        <description>OMNI-EXFUNC-LIM-0001 — antes do início da vigência (03/12/2026): sem limite novo</description>
        <inputEntry><text>&lt; "2026-12-03"</text></inputEntry>
        <inputEntry><text>"40101037", "40101045", "41301102", "40103196", "40103390"</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"liberar"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-EXFUNC-LIM-0001"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="l_sem_data">
        <description>OMNI-EXFUNC-LIM-0001 — data ausente: regulação confere</description>
        <inputEntry><text>null</text></inputEntry>
        <inputEntry><text>"40101037", "40101045", "41301102", "40103196", "40103390"</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"revisao_humana"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-EXFUNC-LIM-0001"</text></outputEntry>
        <outputEntry><text>"regulacao"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="l1_rev">
        <description>OMNI-EXFUNC-LIM-0001 — teste ergométrico repetido em intervalo menor que o mínimo provisório: auditoria médica</description>
        <inputEntry><text>&gt;= "2026-12-03"</text></inputEntry>
        <inputEntry><text>"40101037", "40101045"</text></inputEntry>
        <inputEntry><text>&lt; 90</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"revisao_humana"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-EXFUNC-LIM-0001"</text></outputEntry>
        <outputEntry><text>"auditoria_medica"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="l1_ok">
        <description>OMNI-EXFUNC-LIM-0001 — teste ergométrico fora do intervalo mínimo: libera</description>
        <inputEntry><text>&gt;= "2026-12-03"</text></inputEntry>
        <inputEntry><text>"40101037", "40101045"</text></inputEntry>
        <inputEntry><text>&gt;= 90</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"liberar"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-EXFUNC-LIM-0001"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="l1_nulo">
        <description>OMNI-EXFUNC-LIM-0001 — teste ergométrico sem histórico: libera</description>
        <inputEntry><text>&gt;= "2026-12-03"</text></inputEntry>
        <inputEntry><text>"40101037", "40101045"</text></inputEntry>
        <inputEntry><text>null</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"liberar"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-EXFUNC-LIM-0001"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="l2_rev">
        <description>OMNI-EXFUNC-LIM-0002 — colposcopia acima do limite anual provisório: auditoria médica</description>
        <inputEntry><text>&gt;= "2026-12-03"</text></inputEntry>
        <inputEntry><text>"41301102"</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>&gt; 4</text></inputEntry>
        <outputEntry><text>"revisao_humana"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-EXFUNC-LIM-0002"</text></outputEntry>
        <outputEntry><text>"auditoria_medica"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="l2_ok">
        <description>OMNI-EXFUNC-LIM-0002 — colposcopia até o limite anual: libera</description>
        <inputEntry><text>&gt;= "2026-12-03"</text></inputEntry>
        <inputEntry><text>"41301102"</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>&lt;= 4</text></inputEntry>
        <outputEntry><text>"liberar"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-EXFUNC-LIM-0002"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="l2_nulo">
        <description>OMNI-EXFUNC-LIM-0002 — colposcopia sem histórico anual: libera</description>
        <inputEntry><text>&gt;= "2026-12-03"</text></inputEntry>
        <inputEntry><text>"41301102"</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>null</text></inputEntry>
        <outputEntry><text>"liberar"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-EXFUNC-LIM-0002"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="l3_rev">
        <description>OMNI-EXFUNC-LIM-0003 — EEG quantitativo ou ENMG repetidos em intervalo menor que o mínimo provisório: auditoria médica</description>
        <inputEntry><text>&gt;= "2026-12-03"</text></inputEntry>
        <inputEntry><text>"40103196", "40103390"</text></inputEntry>
        <inputEntry><text>&lt; 180</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"revisao_humana"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-EXFUNC-LIM-0003"</text></outputEntry>
        <outputEntry><text>"auditoria_medica"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="l3_ok">
        <description>OMNI-EXFUNC-LIM-0003 — EEG quantitativo ou ENMG fora do intervalo mínimo: libera</description>
        <inputEntry><text>&gt;= "2026-12-03"</text></inputEntry>
        <inputEntry><text>"40103196", "40103390"</text></inputEntry>
        <inputEntry><text>&gt;= 180</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"liberar"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-EXFUNC-LIM-0003"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="l3_nulo">
        <description>OMNI-EXFUNC-LIM-0003 — EEG quantitativo ou ENMG sem histórico: libera</description>
        <inputEntry><text>&gt;= "2026-12-03"</text></inputEntry>
        <inputEntry><text>"40103196", "40103390"</text></inputEntry>
        <inputEntry><text>null</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"liberar"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-EXFUNC-LIM-0003"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="l_fora">
        <description>OMNI-EXFUNC-LIM-0001 — fechamento: código sem limite no domínio, sem efeito desta tabela</description>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>not("40101037", "40101045", "41301102", "40103196", "40103390")</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"liberar"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-EXFUNC-LIM-0001"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
</definitions>
