<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:camunda="http://camunda.org/schema/1.0/dmn" id="def_genet_autorizacao" name="Exames genéticos: autorização prévia só com DUT exclusiva; urgência liberada (OMNI-GENET-AUT-0001, 0002, 0003 e 0005)" namespace="https://omni-saude/dmn/genetica">
  <decision id="rco_genet_autorizacao" name="Exames genéticos: autorização prévia só com DUT exclusiva; urgência liberada (OMNI-GENET-AUT-0001, 0002, 0003 e 0005)" camunda:historyTimeToLive="P3650D">
    <description>OMNI-GENET-AUT-0001; OMNI-GENET-AUT-0002; OMNI-GENET-AUT-0003; OMNI-GENET-AUT-0005. Nenhuma linha nega; caráter ausente vai à regulação; condição não listada da DUT 110 e código sem correlação no Rol vão à auditoria médica.</description>
    <decisionTable id="dt_genet_autorizacao" hitPolicy="UNIQUE">
      <input id="in_0_dataAtendimento" label="dataAtendimento ← TISS dataSolicitacao (pedido) ou dataExecucao (conta), AAAA-MM-DD">
        <inputExpression id="ie_0_dataAtendimento" typeRef="string"><text>dataAtendimento</text></inputExpression>
      </input>
      <input id="in_1_classeGenet" label="classeGenet ← TISS codigoProcedimento (TUSS 22) pela lista classes de regras/genetica/dominio.yaml">
        <inputExpression id="ie_1_classeGenet" typeRef="string"><text>classeGenet</text></inputExpression>
      </input>
      <input id="in_2_caraterAtendimento" label="caraterAtendimento ← TISS caraterAtendimento (1 eletivo, 2 urgência ou emergência)">
        <inputExpression id="ie_2_caraterAtendimento" typeRef="string"><text>caraterAtendimento</text></inputExpression>
      </input>
      <input id="in_3_enquadramentoDut110" label="enquadramentoDut110 ← solicitação (formulário do pedido): subitem_listado ou condicao_nao_listada">
        <inputExpression id="ie_3_enquadramentoDut110" typeRef="string"><text>enquadramentoDut110</text></inputExpression>
      </input>
      <output id="out_0_decisao" name="decisao" typeRef="string"/>
      <output id="out_1_motivoTab38" name="motivoTab38" typeRef="string"/>
      <output id="out_2_idRegra" name="idRegra" typeRef="string"/>
      <output id="out_3_fila" name="fila" typeRef="string"/>
      <output id="out_classeAdverso" name="classeAdverso" typeRef="string"/>
      <rule id="a_pre">
        <description>Antes da vigência: sem exigência nova</description>
        <inputEntry><text>&lt; "2026-12-03"</text></inputEntry>
        <inputEntry><text>"citogenetica_dut", "molecular_dut110", "bioquimica_dut", "biomarcador_tumoral_dut", "dut_parcial", "sem_dut", "procedimento_acessorio", "fora_rol"</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"liberar"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-GENET-AUT-0002"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="a_sem_data">
        <description>Data ausente: regulação confere, sem negativa</description>
        <inputEntry><text>null</text></inputEntry>
        <inputEntry><text>"citogenetica_dut", "molecular_dut110", "bioquimica_dut", "biomarcador_tumoral_dut", "dut_parcial", "sem_dut", "procedimento_acessorio", "fora_rol"</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"revisao_humana"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-GENET-AUT-0002"</text></outputEntry>
        <outputEntry><text>"regulacao"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="a_livre">
        <description>DUT parcial ou sem DUT: sem autorização prévia</description>
        <inputEntry><text>&gt;= "2026-12-03"</text></inputEntry>
        <inputEntry><text>"dut_parcial", "sem_dut"</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"liberar"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-GENET-AUT-0002"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="a_acess">
        <description>Cultura que prepara a amostra: segue o exame principal</description>
        <inputEntry><text>&gt;= "2026-12-03"</text></inputEntry>
        <inputEntry><text>"procedimento_acessorio"</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"liberar"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-GENET-AUT-0003"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="a_urg_cito">
        <description>Citogenética com DUT em urgência: liberar</description>
        <inputEntry><text>&gt;= "2026-12-03"</text></inputEntry>
        <inputEntry><text>"citogenetica_dut"</text></inputEntry>
        <inputEntry><text>"2"</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"liberar"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-GENET-AUT-0001"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="a_car_cito">
        <description>Citogenética com DUT, caráter ausente ou inválido: regulação</description>
        <inputEntry><text>&gt;= "2026-12-03"</text></inputEntry>
        <inputEntry><text>"citogenetica_dut"</text></inputEntry>
        <inputEntry><text>not("1", "2")</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"revisao_humana"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-GENET-AUT-0001"</text></outputEntry>
        <outputEntry><text>"regulacao"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="a_cito">
        <description>Citogenética com DUT, eletivo: autorização prévia</description>
        <inputEntry><text>&gt;= "2026-12-03"</text></inputEntry>
        <inputEntry><text>"citogenetica_dut"</text></inputEntry>
        <inputEntry><text>"1"</text></inputEntry>
        <inputEntry><text>not("condicao_nao_listada")</text></inputEntry>
        <outputEntry><text>"exigir_autorizacao"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-GENET-AUT-0001"</text></outputEntry>
        <outputEntry><text>"auditoria_medica"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="a_cito_nl">
        <description>Citogenética com DUT, condição não listada: auditoria médica</description>
        <inputEntry><text>&gt;= "2026-12-03"</text></inputEntry>
        <inputEntry><text>"citogenetica_dut"</text></inputEntry>
        <inputEntry><text>"1"</text></inputEntry>
        <inputEntry><text>"condicao_nao_listada"</text></inputEntry>
        <outputEntry><text>"revisao_humana"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-GENET-AUT-0005"</text></outputEntry>
        <outputEntry><text>"auditoria_medica"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="a_urg">
        <description>Molecular, bioquímica ou biomarcador com DUT em urgência: liberar</description>
        <inputEntry><text>&gt;= "2026-12-03"</text></inputEntry>
        <inputEntry><text>"molecular_dut110", "bioquimica_dut", "biomarcador_tumoral_dut"</text></inputEntry>
        <inputEntry><text>"2"</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"liberar"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-GENET-AUT-0002"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="a_car">
        <description>Molecular, bioquímica ou biomarcador com DUT, caráter ausente ou inválido: regulação</description>
        <inputEntry><text>&gt;= "2026-12-03"</text></inputEntry>
        <inputEntry><text>"molecular_dut110", "bioquimica_dut", "biomarcador_tumoral_dut"</text></inputEntry>
        <inputEntry><text>not("1", "2")</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"revisao_humana"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-GENET-AUT-0002"</text></outputEntry>
        <outputEntry><text>"regulacao"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="a_mol">
        <description>Molecular com DUT 110, eletivo: autorização prévia</description>
        <inputEntry><text>&gt;= "2026-12-03"</text></inputEntry>
        <inputEntry><text>"molecular_dut110"</text></inputEntry>
        <inputEntry><text>"1"</text></inputEntry>
        <inputEntry><text>not("condicao_nao_listada")</text></inputEntry>
        <outputEntry><text>"exigir_autorizacao"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-GENET-AUT-0002"</text></outputEntry>
        <outputEntry><text>"auditoria_medica"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="a_mol_nl">
        <description>Molecular com DUT 110, condição não listada: auditoria médica</description>
        <inputEntry><text>&gt;= "2026-12-03"</text></inputEntry>
        <inputEntry><text>"molecular_dut110"</text></inputEntry>
        <inputEntry><text>"1"</text></inputEntry>
        <inputEntry><text>"condicao_nao_listada"</text></inputEntry>
        <outputEntry><text>"revisao_humana"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-GENET-AUT-0005"</text></outputEntry>
        <outputEntry><text>"auditoria_medica"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="a_outras_dut">
        <description>Bioquímica ou biomarcador com DUT exclusiva, eletivo: autorização prévia</description>
        <inputEntry><text>&gt;= "2026-12-03"</text></inputEntry>
        <inputEntry><text>"bioquimica_dut", "biomarcador_tumoral_dut"</text></inputEntry>
        <inputEntry><text>"1"</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"exigir_autorizacao"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-GENET-AUT-0002"</text></outputEntry>
        <outputEntry><text>"auditoria_medica"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="a_urg_fora">
        <description>Código sem correlação no Rol em urgência: liberar</description>
        <inputEntry><text>&gt;= "2026-12-03"</text></inputEntry>
        <inputEntry><text>"fora_rol"</text></inputEntry>
        <inputEntry><text>"2"</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"liberar"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-GENET-AUT-0005"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="a_fora_rol">
        <description>Código sem correlação no Rol fora de urgência: auditoria médica (art. 10, §13)</description>
        <inputEntry><text>&gt;= "2026-12-03"</text></inputEntry>
        <inputEntry><text>"fora_rol"</text></inputEntry>
        <inputEntry><text>not("2")</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"revisao_humana"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-GENET-AUT-0005"</text></outputEntry>
        <outputEntry><text>"auditoria_medica"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="a_fora">
        <description>Fechamento: classe fora desta tabela, sem efeito</description>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>not("citogenetica_dut", "molecular_dut110", "bioquimica_dut", "biomarcador_tumoral_dut", "dut_parcial", "sem_dut", "procedimento_acessorio", "fora_rol")</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"liberar"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-GENET-AUT-0002"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
</definitions>
