<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:camunda="http://camunda.org/schema/1.0/dmn" id="def_genet_compatibilidade" name="Exames genéticos: CID de neoplasia no biomarcador, especialidade do solicitante na DUT 110 e executante do aconselhamento (OMNI-GENET-CMP-0001, 0002 e 0003)" namespace="https://omni-saude/dmn/genetica">
  <decision id="rco_genet_compatibilidade" name="Exames genéticos: CID de neoplasia no biomarcador, especialidade do solicitante na DUT 110 e executante do aconselhamento (OMNI-GENET-CMP-0001, 0002 e 0003)" camunda:historyTimeToLive="P3650D">
    <description>OMNI-GENET-CMP-0001; OMNI-GENET-CMP-0002; OMNI-GENET-CMP-0003. Nenhuma linha glosa; dado ausente vai à auditoria médica ou ao faturamento.</description>
    <decisionTable id="dt_genet_compatibilidade" hitPolicy="UNIQUE">
      <input id="in_0_dataAtendimento" label="dataAtendimento ← TISS dataSolicitacao (pedido) ou dataExecucao (conta), AAAA-MM-DD">
        <inputExpression id="ie_0_dataAtendimento" typeRef="string"><text>dataAtendimento</text></inputExpression>
      </input>
      <input id="in_1_classeGenet" label="classeGenet ← TISS codigoProcedimento (TUSS 22) pela lista classes de regras/genetica/dominio.yaml (inclui aconselhamento_genetico, código de interface 10106014)">
        <inputExpression id="ie_1_classeGenet" typeRef="string"><text>classeGenet</text></inputExpression>
      </input>
      <input id="in_2_cidNeoplasia" label="cidNeoplasia ← solicitação (CID-10 do formulário) ou TISS diagnosticoCID: CID entre C00 e D48">
        <inputExpression id="ie_2_cidNeoplasia" typeRef="boolean"><text>cidNeoplasia</text></inputExpression>
      </input>
      <input id="in_3_solicitanteEspecialidadeDut110" label="solicitanteEspecialidadeDut110 ← solicitação (especialidade e RQE no formulário) ou cadastro da rede: neurologia, oncologia clínica, hematologia ou genética médica">
        <inputExpression id="ie_3_solicitanteEspecialidadeDut110" typeRef="boolean"><text>solicitanteEspecialidadeDut110</text></inputExpression>
      </input>
      <input id="in_4_executanteGeneticaMedica" label="executanteGeneticaMedica ← cadastro da rede: executante com especialidade em genética médica">
        <inputExpression id="ie_4_executanteGeneticaMedica" typeRef="boolean"><text>executanteGeneticaMedica</text></inputExpression>
      </input>
      <output id="out_0_decisao" name="decisao" typeRef="string"/>
      <output id="out_1_motivoTab38" name="motivoTab38" typeRef="string"/>
      <output id="out_2_idRegra" name="idRegra" typeRef="string"/>
      <output id="out_3_fila" name="fila" typeRef="string"/>
      <output id="out_classeAdverso" name="classeAdverso" typeRef="string"/>
      <rule id="c_pre_tum">
        <description>Biomarcador antes da vigência: sem conferência nova</description>
        <inputEntry><text>&lt; "2026-12-03"</text></inputEntry>
        <inputEntry><text>"biomarcador_tumoral_dut"</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"liberar"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-GENET-CMP-0001"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="c_sem_data_tum">
        <description>Biomarcador sem data: auditoria médica</description>
        <inputEntry><text>null</text></inputEntry>
        <inputEntry><text>"biomarcador_tumoral_dut"</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"revisao_humana"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-GENET-CMP-0001"</text></outputEntry>
        <outputEntry><text>"auditoria_medica"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="c_tum_ok">
        <description>Biomarcador com CID de neoplasia: segue</description>
        <inputEntry><text>&gt;= "2026-12-03"</text></inputEntry>
        <inputEntry><text>"biomarcador_tumoral_dut"</text></inputEntry>
        <inputEntry><text>true</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"liberar"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-GENET-CMP-0001"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="c_tum_rev">
        <description>Biomarcador com CID fora de neoplasias ou ausente: auditoria médica</description>
        <inputEntry><text>&gt;= "2026-12-03"</text></inputEntry>
        <inputEntry><text>"biomarcador_tumoral_dut"</text></inputEntry>
        <inputEntry><text>false, null</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"revisao_humana"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-GENET-CMP-0001"</text></outputEntry>
        <outputEntry><text>"auditoria_medica"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="c_pre_dut">
        <description>DUT 110 antes da vigência: sem conferência nova</description>
        <inputEntry><text>&lt; "2026-12-03"</text></inputEntry>
        <inputEntry><text>"citogenetica_dut", "molecular_dut110"</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"liberar"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-GENET-CMP-0003"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="c_sem_data_dut">
        <description>DUT 110 sem data: auditoria médica</description>
        <inputEntry><text>null</text></inputEntry>
        <inputEntry><text>"citogenetica_dut", "molecular_dut110"</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"revisao_humana"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-GENET-CMP-0003"</text></outputEntry>
        <outputEntry><text>"auditoria_medica"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="c_dut_ok">
        <description>DUT 110 pedida por especialidade da diretriz: segue</description>
        <inputEntry><text>&gt;= "2026-12-03"</text></inputEntry>
        <inputEntry><text>"citogenetica_dut", "molecular_dut110"</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>true</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"liberar"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-GENET-CMP-0003"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="c_dut_rev">
        <description>DUT 110 pedida por outra especialidade ou sem especialidade conferível: auditoria médica</description>
        <inputEntry><text>&gt;= "2026-12-03"</text></inputEntry>
        <inputEntry><text>"citogenetica_dut", "molecular_dut110"</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>false, null</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"revisao_humana"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-GENET-CMP-0003"</text></outputEntry>
        <outputEntry><text>"auditoria_medica"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="c_pre_acon">
        <description>Aconselhamento antes da vigência: sem conferência nova</description>
        <inputEntry><text>&lt; "2026-12-03"</text></inputEntry>
        <inputEntry><text>"aconselhamento_genetico"</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"liberar"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-GENET-CMP-0002"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="c_sem_data_acon">
        <description>Aconselhamento sem data: faturamento</description>
        <inputEntry><text>null</text></inputEntry>
        <inputEntry><text>"aconselhamento_genetico"</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"revisao_humana"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-GENET-CMP-0002"</text></outputEntry>
        <outputEntry><text>"faturamento"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="c_acon_ok">
        <description>Aconselhamento por executante de genética médica: segue</description>
        <inputEntry><text>&gt;= "2026-12-03"</text></inputEntry>
        <inputEntry><text>"aconselhamento_genetico"</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>true</text></inputEntry>
        <outputEntry><text>"liberar"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-GENET-CMP-0002"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="c_acon_rev">
        <description>Aconselhamento sem genética médica confirmada no cadastro: faturamento</description>
        <inputEntry><text>&gt;= "2026-12-03"</text></inputEntry>
        <inputEntry><text>"aconselhamento_genetico"</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>false, null</text></inputEntry>
        <outputEntry><text>"revisao_humana"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-GENET-CMP-0002"</text></outputEntry>
        <outputEntry><text>"faturamento"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="c_fora">
        <description>Fechamento: classe fora desta tabela, sem efeito</description>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>not("citogenetica_dut", "molecular_dut110", "biomarcador_tumoral_dut", "aconselhamento_genetico")</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"liberar"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-GENET-CMP-0003"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
</definitions>
