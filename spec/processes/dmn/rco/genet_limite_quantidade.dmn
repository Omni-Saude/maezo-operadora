<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:camunda="http://camunda.org/schema/1.0/dmn" id="def_genet_limite_quantidade" name="Teste germinativo específico repetido no mesmo beneficiário vai à auditoria médica (OMNI-GENET-LIM-0001)" namespace="https://omni-saude/dmn/genetica">
  <decision id="rco_genet_limite_quantidade" name="Teste germinativo específico repetido no mesmo beneficiário vai à auditoria médica (OMNI-GENET-LIM-0001)" camunda:historyTimeToLive="P3650D">
    <description>OMNI-GENET-LIM-0001. Limiar provisório (a partir de 1 execução paga do mesmo código); nenhuma linha glosa; histórico ausente segue.</description>
    <decisionTable id="dt_genet_limite_quantidade" hitPolicy="UNIQUE">
      <input id="in_0_dataAtendimento" label="dataAtendimento ← TISS dataSolicitacao (pedido) ou dataExecucao (conta), AAAA-MM-DD">
        <inputExpression id="ie_0_dataAtendimento" typeRef="string"><text>dataAtendimento</text></inputExpression>
      </input>
      <input id="in_1_grupoRepeticaoGenet" label="grupoRepeticaoGenet ← TISS codigoProcedimento pela lista teste_germinativo_especifico de regras/genetica/dominio.yaml (germinativo_especifico)">
        <inputExpression id="ie_1_grupoRepeticaoGenet" typeRef="string"><text>grupoRepeticaoGenet</text></inputExpression>
      </input>
      <input id="in_2_execucoesAnterioresMesmoCodigo" label="execucoesAnterioresMesmoCodigo ← cadastro (histórico de guias OMNI: execuções pagas do mesmo código para o mesmo beneficiário)">
        <inputExpression id="ie_2_execucoesAnterioresMesmoCodigo" typeRef="integer"><text>execucoesAnterioresMesmoCodigo</text></inputExpression>
      </input>
      <output id="out_0_decisao" name="decisao" typeRef="string"/>
      <output id="out_1_motivoTab38" name="motivoTab38" typeRef="string"/>
      <output id="out_2_idRegra" name="idRegra" typeRef="string"/>
      <output id="out_3_fila" name="fila" typeRef="string"/>
      <output id="out_classeAdverso" name="classeAdverso" typeRef="string"/>
      <rule id="l_pre">
        <description>Antes da vigência: sem conferência nova</description>
        <inputEntry><text>&lt; "2026-12-03"</text></inputEntry>
        <inputEntry><text>"germinativo_especifico"</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"liberar"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-GENET-LIM-0001"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="l_sem_data">
        <description>Data ausente: auditoria médica</description>
        <inputEntry><text>null</text></inputEntry>
        <inputEntry><text>"germinativo_especifico"</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"revisao_humana"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-GENET-LIM-0001"</text></outputEntry>
        <outputEntry><text>"auditoria_medica"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="l_primeira">
        <description>Primeira execução do código: segue</description>
        <inputEntry><text>&gt;= "2026-12-03"</text></inputEntry>
        <inputEntry><text>"germinativo_especifico"</text></inputEntry>
        <inputEntry><text>&lt; 1</text></inputEntry>
        <outputEntry><text>"liberar"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-GENET-LIM-0001"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="l_rep">
        <description>Mesmo teste germinativo já pago: auditoria médica</description>
        <inputEntry><text>&gt;= "2026-12-03"</text></inputEntry>
        <inputEntry><text>"germinativo_especifico"</text></inputEntry>
        <inputEntry><text>&gt;= 1</text></inputEntry>
        <outputEntry><text>"revisao_humana"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-GENET-LIM-0001"</text></outputEntry>
        <outputEntry><text>"auditoria_medica"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="l_sem_hist">
        <description>Histórico ausente: segue, sem negativa</description>
        <inputEntry><text>&gt;= "2026-12-03"</text></inputEntry>
        <inputEntry><text>"germinativo_especifico"</text></inputEntry>
        <inputEntry><text>null</text></inputEntry>
        <outputEntry><text>"liberar"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-GENET-LIM-0001"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="l_fora">
        <description>Fechamento: código fora do grupo, sem efeito</description>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>not("germinativo_especifico")</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"liberar"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-GENET-LIM-0001"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
</definitions>
