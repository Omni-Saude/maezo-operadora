<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:camunda="http://camunda.org/schema/1.0/dmn" id="def_genet_pacote" name="Exame genético por ato: coleta, envio e etapas do sequenciamento incluídos (OMNI-GENET-PAC-0001 e 0002)" namespace="https://omni-saude/dmn/genetica">
  <decision id="rco_genet_pacote" name="Exame genético por ato: coleta, envio e etapas do sequenciamento incluídos (OMNI-GENET-PAC-0001 e 0002)" camunda:historyTimeToLive="P3650D">
    <description>OMNI-GENET-PAC-0001; OMNI-GENET-PAC-0002. Item incluído cobrado à parte vai ao faturamento; nunca glosa automática.</description>
    <decisionTable id="dt_genet_pacote" hitPolicy="UNIQUE">
      <input id="in_0_dataAtendimento" label="dataAtendimento ← TISS dataSolicitacao (pedido) ou dataExecucao (conta), AAAA-MM-DD">
        <inputExpression id="ie_0_dataAtendimento" typeRef="string"><text>dataAtendimento</text></inputExpression>
      </input>
      <input id="in_1_itemCobradoAParteGenet" label="itemCobradoAParteGenet ← TISS conta do prestador: coleta_envio ou etapa_incluida_sequenciamento">
        <inputExpression id="ie_1_itemCobradoAParteGenet" typeRef="string"><text>itemCobradoAParteGenet</text></inputExpression>
      </input>
      <output id="out_0_decisao" name="decisao" typeRef="string"/>
      <output id="out_1_motivoTab38" name="motivoTab38" typeRef="string"/>
      <output id="out_2_idRegra" name="idRegra" typeRef="string"/>
      <output id="out_3_fila" name="fila" typeRef="string"/>
      <output id="out_classeAdverso" name="classeAdverso" typeRef="string"/>
      <rule id="k_pre">
        <description>Antes da vigência: pago como cobrado</description>
        <inputEntry><text>&lt; "2026-12-03"</text></inputEntry>
        <inputEntry><text>"coleta_envio", "etapa_incluida_sequenciamento"</text></inputEntry>
        <outputEntry><text>"pagar_pacote"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-GENET-PAC-0001"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="k_sem_data">
        <description>Data ausente com item à parte: faturamento confere</description>
        <inputEntry><text>null</text></inputEntry>
        <inputEntry><text>"coleta_envio", "etapa_incluida_sequenciamento"</text></inputEntry>
        <outputEntry><text>"revisao_humana"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-GENET-PAC-0001"</text></outputEntry>
        <outputEntry><text>"faturamento"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="k_coleta">
        <description>Taxa de coleta ou envio cobrada à parte: faturamento confere</description>
        <inputEntry><text>&gt;= "2026-12-03"</text></inputEntry>
        <inputEntry><text>"coleta_envio"</text></inputEntry>
        <outputEntry><text>"revisao_humana"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-GENET-PAC-0001"</text></outputEntry>
        <outputEntry><text>"faturamento"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="k_etapa">
        <description>Amplificação cobrada com o sequenciamento da mesma amostra: faturamento confere</description>
        <inputEntry><text>&gt;= "2026-12-03"</text></inputEntry>
        <inputEntry><text>"etapa_incluida_sequenciamento"</text></inputEntry>
        <outputEntry><text>"revisao_humana"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-GENET-PAC-0002"</text></outputEntry>
        <outputEntry><text>"faturamento"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="k_ok">
        <description>Fechamento: sem item incluído cobrado à parte, pago por ato</description>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>not("coleta_envio", "etapa_incluida_sequenciamento")</text></inputEntry>
        <outputEntry><text>"pagar_pacote"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-GENET-PAC-0001"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
</definitions>
