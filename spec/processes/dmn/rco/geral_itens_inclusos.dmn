      <rule id="v_depois">
        <description>OMNI-GERAL-MEX-0002: visita do cirurgião depois de 10 dias: paga</description>
        <inputEntry><text>&gt;= "2026-11-03"</text></inputEntry>
        <inputEntry><text>"10102019"</text></inputEntry>
        <inputEntry><text>true</text></inputEntry>
        <inputEntry><text>&gt; 10</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>"internacao"</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>true</text></inputEntry>
        <outputEntry><text>"liberar"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-GERAL-MEX-0002"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="v_dias_inv">
        <description>OMNI-GERAL-MEX-0002: data da cirurgia ausente ou posterior à visita</description>
        <inputEntry><text>&gt;= "2026-11-03"</text></inputEntry>
        <inputEntry><text>"10102019"</text></inputEntry>
        <inputEntry><text>true</text></inputEntry>
        <inputEntry><text>&lt; 0, null</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>"internacao"</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>true</text></inputEntry>
        <outputEntry><text>"revisao_humana"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-GERAL-MEX-0002"</text></outputEntry>
        <outputEntry><text>"auditoria_medica"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="i_fechamento">
        <description>Código fora da tabela (linha final, nunca nega)</description>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>not("20104081", "20104103", "10102019")</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"liberar"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
</definitions>
