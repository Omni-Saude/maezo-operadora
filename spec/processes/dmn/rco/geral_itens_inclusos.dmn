<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:camunda="http://camunda.org/schema/1.0/dmn" id="def_geral_itens_inclusos" name="Regras gerais: itens incluídos no ato cirúrgico (OMNI-GERAL-MEX-0001, OMNI-GERAL-MEX-0002)" namespace="https://omni-saude/dmn/regras-gerais">
  <decision id="rco_geral_itens_inclusos" name="Regras gerais: itens incluídos no ato cirúrgico (OMNI-GERAL-MEX-0001, OMNI-GERAL-MEX-0002)" camunda:historyTimeToLive="P3650D">
    <description>OMNI-GERAL-MEX-0001: curativo (20104081, 20104103) do mesmo profissional no dia da cirurgia, em internação, é glosado (Tab. 38: 3202). OMNI-GERAL-MEX-0002: visita hospitalar (10102019) do mesmo profissional até 10 dias após a cirurgia, em internação e sem CID secundário na guia, é glosada (3202), salvo no dia da alta. A glosa automática só vale com a cláusula de itens incluídos no contrato do prestador (aditivo, base contratual: a norma não fixa a exclusão); sem a cláusula ou com regime que não é internação, o item é pago; com a cláusula e regime ausente (o regime vem da internação vinculada), o item fica pendente na fila faturamento, sem pagamento nem glosa; CID secundário informado ou ausente vai à auditoria médica. Glosa só do pagamento ao prestador, com recurso; dado ausente nunca glosa.</description>
    <decisionTable id="dt_geral_itens_inclusos" hitPolicy="UNIQUE">
      <input id="in_dataAtendimento" label="dataAtendimento ← TISS dataExecucao do item cobrado, AAAA-MM-DD">
        <inputExpression id="ie_dataAtendimento" typeRef="string"><text>dataAtendimento</text></inputExpression>
      </input>
      <input id="in_codigoProcedimento" label="codigoProcedimento ← TISS codigoProcedimento do item cobrado (TUSS 22)">
        <inputExpression id="ie_codigoProcedimento" typeRef="string"><text>codigoProcedimento</text></inputExpression>
      </input>
      <input id="in_mesmoProfissionalCirurgia" label="mesmoProfissionalCirurgia ← TISS: o executante do item (conselho, número no conselho e UF do profissional executante) também executou procedimento cirúrgico (TUSS 22, grupo 3) na mesma guia ou internação">
        <inputExpression id="ie_mesmoProfissionalCirurgia" typeRef="boolean"><text>mesmoProfissionalCirurgia</text></inputExpression>
      </input>
      <input id="in_diasAposCirurgia" label="diasAposCirurgia ← TISS: dias corridos entre a dataExecucao do procedimento cirúrgico desse profissional e a dataExecucao do item">
        <inputExpression id="ie_diasAposCirurgia" typeRef="integer"><text>diasAposCirurgia</text></inputExpression>
      </input>
      <input id="in_visitaNaDataDaAlta" label="visitaNaDataDaAlta ← TISS: dataExecucao da visita igual à data da alta (dataFinalFaturamento com motivoEncerramento de alta) da guia de resumo de internação">
        <inputExpression id="ie_visitaNaDataDaAlta" typeRef="boolean"><text>visitaNaDataDaAlta</text></inputExpression>
      </input>
      <input id="in_regime" label="regime ← TISS regimeInternacao (Tab. 41) ou regimeAtendimento (Tab. 76) da internação vinculada ao item (a mesma internação de mesmoProfissionalCirurgia): internacao | ambulatorial | pronto_socorro | hospital_dia; outro código ou ausente: nulo">
        <inputExpression id="ie_regime" typeRef="string"><text>regime</text></inputExpression>
      </input>
      <input id="in_cidSecundarioInformado" label="cidSecundarioInformado ← TISS: a guia de resumo de internação traz CID-10 secundário (diagnostico 2 a 4 de dadosSaidaInternacao); false = só o principal; nulo = resumo não extraído">
        <inputExpression id="ie_cidSecundarioInformado" typeRef="boolean"><text>cidSecundarioInformado</text></inputExpression>
      </input>
      <input id="in_clausulaItensInclusos" label="clausulaItensInclusos ← cadastro do prestador: contrato com a cláusula do aditivo que inclui curativo e visita do cirurgião no ato cirúrgico (true = aceita; false = não aceita; nulo = não informado)">
        <inputExpression id="ie_clausulaItensInclusos" typeRef="boolean"><text>clausulaItensInclusos</text></inputExpression>
      </input>
      <output id="out_decisao" name="decisao" typeRef="string"/>
      <output id="out_motivoTab38" name="motivoTab38" typeRef="string"/>
      <output id="out_idRegra" name="idRegra" typeRef="string"/>
      <output id="out_fila" name="fila" typeRef="string"/>
      <output id="out_classeAdverso" name="classeAdverso" typeRef="string"/>
            <rule id="i_pre">
        <description>Fora da vigência (antes de 2026-11-03)</description>
        <inputEntry><text>&lt; "2026-11-03"</text></inputEntry>
        <inputEntry><text>"20104081", "20104103", "10102019"</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"liberar"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
