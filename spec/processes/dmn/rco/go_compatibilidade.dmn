<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:camunda="http://camunda.org/schema/1.0/dmn" id="def_go_compatibilidade" name="Ginecologia e obstetrícia: parto múltiplo e executante do parto" namespace="https://omni-saude/dmn/ginecologia-obstetricia">
  <decision id="rco_go_compatibilidade" name="Ginecologia e obstetrícia: parto múltiplo e executante do parto" camunda:historyTimeToLive="P3650D">
    <description>OMNI-GO-CMP-0001 e OMNI-GO-CMP-0002. Domínio ginecologia-obstetricia. Hit policy UNIQUE; nenhuma linha nega ou glosa salvo onde indicado com base de nível A; a linha de fechamento (data ausente) vai à revisão humana.</description>
    <decisionTable id="dt_go_compatibilidade" hitPolicy="UNIQUE">
      <input id="in_0_dataAtendimento" label="dataAtendimento ← TISS dataSolicitacao (pedido) ou dataExecucao (conta), AAAA-MM-DD">
        <inputExpression id="ie_0_dataAtendimento" typeRef="string"><text>dataAtendimento</text></inputExpression>
      </input>
      <input id="in_1_codigoProcedimento" label="codigoProcedimento ← TISS codigoProcedimento (TUSS 22)">
        <inputExpression id="ie_1_codigoProcedimento" typeRef="string"><text>codigoProcedimento</text></inputExpression>
      </input>
      <input id="in_2_partoInicialNaGuia" label="partoInicialNaGuia ← TISS codigoProcedimento das linhas da mesma guia: 31309127, 31309054 ou 31309208 presente (derivado)">
        <inputExpression id="ie_2_partoInicialNaGuia" typeRef="boolean"><text>partoInicialNaGuia</text></inputExpression>
      </input>
      <input id="in_3_conselhoExecutante" label="conselhoExecutante ← TISS conselho do executante em identEquipe (TUSS 26; 02 COREN, 06 CRM)">
        <inputExpression id="ie_3_conselhoExecutante" typeRef="string"><text>conselhoExecutante</text></inputExpression>
      </input>
      <output id="out_0_decisao" name="decisao" typeRef="string"/>
      <output id="out_1_motivoTab38" name="motivoTab38" typeRef="string"/>
      <output id="out_2_idRegra" name="idRegra" typeRef="string"/>
      <output id="out_3_fila" name="fila" typeRef="string"/>
      <output id="out_classeAdverso" name="classeAdverso" typeRef="string"/>
      <rule id="p_pre">
        <description>OMNI-GO-CMP-0001 — antes da vigência (03/12/2026): regras de compatibilidade GO não se aplicam</description>
        <inputEntry><text>&lt; "2026-12-03"</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"liberar"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-GO-CMP-0001"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="p_mult_sem">
        <description>OMNI-GO-CMP-0001 — parto múltiplo sem parto inicial na guia: faturamento confere</description>
        <inputEntry><text>&gt;= "2026-12-03"</text></inputEntry>
        <inputEntry><text>"31309135"</text></inputEntry>
        <inputEntry><text>false</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"revisao_humana"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-GO-CMP-0001"</text></outputEntry>
        <outputEntry><text>"faturamento"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="p_mult_ok">
        <description>OMNI-GO-CMP-0001 — parto múltiplo com parto inicial na guia ou sem a informação: sem conferência</description>
        <inputEntry><text>&gt;= "2026-12-03"</text></inputEntry>
        <inputEntry><text>"31309135"</text></inputEntry>
        <inputEntry><text>not(false)</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"liberar"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-GO-CMP-0001"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="p_vag_coren">
        <description>OMNI-GO-CMP-0002 — parto vaginal ou assistência ao trabalho de parto por executante do COREN: auditoria de enfermagem confere a habilitação obstétrica</description>
        <inputEntry><text>&gt;= "2026-12-03"</text></inputEntry>
        <inputEntry><text>"31309127", "31309038"</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>"02"</text></inputEntry>
        <outputEntry><text>"revisao_humana"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-GO-CMP-0002"</text></outputEntry>
        <outputEntry><text>"auditoria_enfermagem"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="p_vag_ok">
        <description>OMNI-GO-CMP-0002 — parto vaginal ou assistência ao trabalho de parto por outro executante ou sem conselho informado: sem conferência</description>
        <inputEntry><text>&gt;= "2026-12-03"</text></inputEntry>
        <inputEntry><text>"31309127", "31309038"</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>not("02")</text></inputEntry>
        <outputEntry><text>"liberar"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-GO-CMP-0002"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="p_ces_crm">
        <description>OMNI-GO-CMP-0002 — cesariana por executante do CRM: sem conferência</description>
        <inputEntry><text>&gt;= "2026-12-03"</text></inputEntry>
        <inputEntry><text>"31309054", "31309208"</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>"06"</text></inputEntry>
        <outputEntry><text>"liberar"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-GO-CMP-0002"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="p_ces_outro">
        <description>OMNI-GO-CMP-0002 — cesariana com executante de outro conselho ou sem conselho: auditoria médica</description>
        <inputEntry><text>&gt;= "2026-12-03"</text></inputEntry>
        <inputEntry><text>"31309054", "31309208"</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>not("06")</text></inputEntry>
        <outputEntry><text>"revisao_humana"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-GO-CMP-0002"</text></outputEntry>
        <outputEntry><text>"auditoria_medica"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="p_resto">
        <description>OMNI-GO-CMP-0001 — procedimento sem regra de compatibilidade GO: sem restrição desta tabela</description>
        <inputEntry><text>&gt;= "2026-12-03"</text></inputEntry>
        <inputEntry><text>not("31309135", "31309127", "31309038", "31309054", "31309208")</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"liberar"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-GO-CMP-0001"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="p_sem_data">
        <description>OMNI-GO-CMP-0001 — data ausente: faturamento, sem negativa</description>
        <inputEntry><text>null</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"revisao_humana"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-GO-CMP-0001"</text></outputEntry>
        <outputEntry><text>"faturamento"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
</definitions>
