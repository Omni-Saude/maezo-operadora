        <inputEntry><text>"31307043"</text></inputEntry>
        <inputEntry><text>"31307078", "31009174"</text></inputEntry>
        <inputEntry><text>not("3")</text></inputEntry>
        <outputEntry><text>"revisao_humana"</text></outputEntry>
