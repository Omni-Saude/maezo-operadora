<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:camunda="http://camunda.org/schema/1.0/dmn" id="def_go_opme" name="Ginecologia: OPME das cirurgias ginecológicas por ato (OMNI-GO-OPM-0001)" namespace="https://omni-saude/dmn/ginecologia-obstetricia">
  <decision id="rco_go_opme" name="Ginecologia: OPME das cirurgias ginecológicas por ato (OMNI-GO-OPM-0001)" camunda:historyTimeToLive="P3650D">
    <description>OMNI-GO-OPM-0001. Lista positiva por procedimento de regras/ginecologia-obstetricia/dominio.yaml (listas_opme), quantidade máxima provisória (OPS-UNIMEDFESP-OPME-2026 p. 146 a 150, nível C; validacao/calibracao/parametros-provisorios/ginecologia-obstetricia.csv). Dentro do limite paga; acima, fora da lista ou sem classificação vai à auditoria médica e, na divergência, à junta (ANS-RN-424). A tela do assoalho pélvico não tem categoria nem lista de referência (L-faseE-go-01): vai sempre à auditoria médica. Hit policy UNIQUE; nenhuma linha nega ou glosa; a linha de fechamento (data ausente) vai à revisão humana.</description>
    <decisionTable id="dt_go_opme" hitPolicy="UNIQUE">
      <input id="in_0_dataAtendimento" label="dataAtendimento ← TISS dataExecucao do procedimento, AAAA-MM-DD">
        <inputExpression id="ie_0_dataAtendimento" typeRef="string"><text>dataAtendimento</text></inputExpression>
      </input>
      <input id="in_1_codigoProcedimento" label="codigoProcedimento ← TISS codigoProcedimento do ato cirúrgico (TUSS 22)">
        <inputExpression id="ie_1_codigoProcedimento" typeRef="string"><text>codigoProcedimento</text></inputExpression>
      </input>
      <input id="in_2_categoriaOpme" label="categoriaOpme ← TISS codigoItem da OPME (TUSS 19) classificado pelo cadastro OMNI de materiais (trocater); sem correspondência vai nulo">
        <inputExpression id="ie_2_categoriaOpme" typeRef="string"><text>categoriaOpme</text></inputExpression>
      </input>
      <input id="in_3_quantidade" label="quantidade ← TISS quantidadeExecutada da categoria por guia e dataExecucao (ato)">
        <inputExpression id="ie_3_quantidade" typeRef="integer"><text>quantidade</text></inputExpression>
      </input>
      <output id="out_0_decisao" name="decisao" typeRef="string"/>
      <output id="out_1_motivoTab38" name="motivoTab38" typeRef="string"/>
      <output id="out_2_idRegra" name="idRegra" typeRef="string"/>
      <output id="out_3_fila" name="fila" typeRef="string"/>
      <output id="out_classeAdverso" name="classeAdverso" typeRef="string"/>
      <rule id="o_pre">
        <description>OMNI-GO-OPM-0001 — antes da vigência (03/12/2026): sem efeito desta tabela</description>
        <inputEntry><text>&lt; "2026-12-03"</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"liberar"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-GO-OPM-0001"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="o_fora">
        <description>OMNI-GO-OPM-0001 — procedimento sem lista de OPME GO: sem efeito desta tabela</description>
        <inputEntry><text>&gt;= "2026-12-03"</text></inputEntry>
        <inputEntry><text>not("31303200", "31303218", "31303226", "31303234", "31303250", "31304052", "31304079", "31305032", "31306012", "31306020", "31307027", "31307167", "31304087", "31307183", "31307205", "31307280", "31307299")</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"liberar"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-GO-OPM-0001"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="o_tela">
        <description>OMNI-GO-OPM-0001 — correção de defeito do assoalho pélvico (31306012, 31306020, 31307027, 31307167): tela sem categoria nem lista de referência, auditoria médica, sem glosa</description>
        <inputEntry><text>&gt;= "2026-12-03"</text></inputEntry>
        <inputEntry><text>"31306012", "31306020", "31307027", "31307167"</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"revisao_humana"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-GO-OPM-0001"</text></outputEntry>
        <outputEntry><text>"auditoria_medica"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="o_semref">
        <description>OMNI-GO-OPM-0001 — laparoscopia dos pacotes sem quantidade de referência (31304087, 31307183, 31307205, 31307280, 31307299): OPME à auditoria médica, sem glosa (L-faseE-go-pac-02)</description>
        <inputEntry><text>&gt;= "2026-12-03"</text></inputEntry>
        <inputEntry><text>"31304087", "31307183", "31307205", "31307280", "31307299"</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"revisao_humana"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-GO-OPM-0001"</text></outputEntry>
        <outputEntry><text>"auditoria_medica"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
