<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:camunda="http://camunda.org/schema/1.0/dmn" id="def_go_pacote" name="Ginecologia: enquadramento e permanência dos pacotes GO (OMNI-PAC-GO-0001 a 0007)" namespace="https://omni-saude/dmn/ginecologia-obstetricia">
  <decision id="rco_go_pacote" name="Ginecologia: enquadramento e permanência dos pacotes GO (OMNI-PAC-GO-0001 a 0007)" camunda:historyTimeToLive="P3650D">
    <description>OMNI-GO-PAC-0002, OMNI-GO-PAC-0003, OMNI-GO-PAC-0004, OMNI-GO-PAC-0005, OMNI-GO-PAC-0006, OMNI-GO-PAC-0007, OMNI-GO-PAC-0008. Enquadra a conta no pacote OMNI-PAC-GO do procedimento principal e aplica o outlier de permanência (limiares provisórios, GO-PAC-02; validacao/calibracao/parametros-provisorios/ginecologia-obstetricia.csv). Urgência, caráter não informado e prestador sem pacote ficam em conta aberta (EXC-01, EXC-02); a internação obstétrica e a cirurgia oncológica ampliada são edições da conta (EXC-04, EXC-05). Hit policy UNIQUE; nenhuma linha nega ou glosa; nenhum desvio muda a cobertura, só a forma de pagar o prestador; a linha de fechamento (data ausente) vai à revisão humana.</description>
    <decisionTable id="dt_go_pacote" hitPolicy="UNIQUE">
      <input id="in_0_dataAtendimento" label="dataAtendimento ← TISS dataExecucao do procedimento principal, AAAA-MM-DD">
        <inputExpression id="ie_0_dataAtendimento" typeRef="string"><text>dataAtendimento</text></inputExpression>
      </input>
      <input id="in_1_codigoProcedimentoPrincipal" label="codigoProcedimentoPrincipal ← TISS codigoProcedimento do procedimento principal da guia de resumo de internação (TUSS 22)">
        <inputExpression id="ie_1_codigoProcedimentoPrincipal" typeRef="string"><text>codigoProcedimentoPrincipal</text></inputExpression>
      </input>
      <input id="in_2_caraterAtendimento" label="caraterAtendimento ← TISS caraterAtendimento (TUSS 23: 1 eletivo, 2 urgência/emergência)">
        <inputExpression id="ie_2_caraterAtendimento" typeRef="string"><text>caraterAtendimento</text></inputExpression>
      </input>
      <input id="in_3_prestadorComPacote" label="prestadorComPacote ← cadastro contratual: pacote OMNI-PAC-GO do procedimento vigente no anexo do contrato do prestador (booleano)">
        <inputExpression id="ie_3_prestadorComPacote" typeRef="boolean"><text>prestadorComPacote</text></inputExpression>
      </input>
      <input id="in_4_diasInternacao" label="diasInternacao ← resumo de internação TISS: data da alta menos data da internação, em dias">
        <inputExpression id="ie_4_diasInternacao" typeRef="integer"><text>diasInternacao</text></inputExpression>
      </input>
      <output id="out_0_decisao" name="decisao" typeRef="string"/>
      <output id="out_1_motivoTab38" name="motivoTab38" typeRef="string"/>
      <output id="out_2_idRegra" name="idRegra" typeRef="string"/>
      <output id="out_3_fila" name="fila" typeRef="string"/>
      <output id="out_classeAdverso" name="classeAdverso" typeRef="string"/>
      <rule id="p_pre">
        <description>OMNI-GO-PAC-0002 — antes da vigência (03/12/2026): pacotes GO não se aplicam, conta aberta</description>
        <inputEntry><text>&lt; "2026-12-03"</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"liberar"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-GO-PAC-0002"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="p_fora">
        <description>OMNI-GO-PAC-0002 — procedimento principal fora dos pacotes GO: conta aberta, sem efeito desta tabela</description>
        <inputEntry><text>&gt;= "2026-12-03"</text></inputEntry>
        <inputEntry><text>not("31303102", "31303080", "31303129", "31303358", "31303218", "31303200", "31303234", "31303145", "31303250", "31303188", "31303366", "31304010", "31304052", "31304044", "31304087", "31305016", "31305032", "31302041", "31302050", "31302068", "31306012", "31306020", "31307027", "31307167", "31307280", "31307183", "31307205", "31307299")</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"liberar"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-GO-PAC-0002"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="p0001_urg">
        <description>OMNI-GO-PAC-0002 — urgência ou caráter não informado (EXC-01): conta aberta, sujeita às edições automáticas</description>
        <inputEntry><text>&gt;= "2026-12-03"</text></inputEntry>
        <inputEntry><text>"31303102", "31303080", "31303129", "31303358", "31303218", "31303200", "31303234"</text></inputEntry>
        <inputEntry><text>not("1")</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"liberar"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-GO-PAC-0002"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
