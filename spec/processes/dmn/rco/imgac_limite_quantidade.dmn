        <inputEntry><text>&gt;= "2026-12-03"</text></inputEntry>
        <inputEntry><text>"41001141", "41001150", "41002059", "41101251", "41101286", "41101294", "41101553", "41001010", "41001028", "41001036", "41001044", "41001052", "41001060", "41001079", "41001095", "41001109", "41001117", "41001125", "41001176", "41001184", "41001230", "41001273", "41001281", "41001370", "41001389", "41001397", "41001400", "41001419", "41001427", "41001435", "41001443", "41001451", "41001460", "41001478", "41001516", "41001524", "41101014", "41101022", "41101030", "41101057", "41101065", "41101073", "41101081", "41101090", "41101103", "41101111", "41101120", "41101138", "41101146", "41101154", "41101170", "41101189", "41101197", "41101200", "41101219", "41101227", "41101235", "41101243", "41101260", "41101278", "41101308", "41101332", "41101340", "41101480", "41101499", "41101502", "41101510", "41101529", "41101537", "41101545", "41101596", "41101600", "41101618", "41101626"</text></inputEntry>
        <inputEntry><text>null</text></inputEntry>
        <outputEntry><text>"liberar"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-IMGAC-LIM-0001"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="resto">
        <description>demais códigos: sem limite por dia nesta tabela</description>
        <inputEntry><text>&gt;= "2026-12-03"</text></inputEntry>
        <inputEntry><text>not("41001141", "41001150", "41002059", "41101251", "41101286", "41101294", "41101553", "41001010", "41001028", "41001036", "41001044", "41001052", "41001060", "41001079", "41001095", "41001109", "41001117", "41001125", "41001176", "41001184", "41001230", "41001273", "41001281", "41001370", "41001389", "41001397", "41001400", "41001419", "41001427", "41001435", "41001443", "41001451", "41001460", "41001478", "41001516", "41001524", "41101014", "41101022", "41101030", "41101057", "41101065", "41101073", "41101081", "41101090", "41101103", "41101111", "41101120", "41101138", "41101146", "41101154", "41101170", "41101189", "41101197", "41101200", "41101219", "41101227", "41101235", "41101243", "41101260", "41101278", "41101308", "41101332", "41101340", "41101480", "41101499", "41101502", "41101510", "41101529", "41101537", "41101545", "41101596", "41101600", "41101618", "41101626")</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"liberar"</text></outputEntry>
