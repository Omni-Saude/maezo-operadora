        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="resto">
        <description>demais códigos: sem composição nesta tabela</description>
        <inputEntry><text>&gt;= "2026-12-03"</text></inputEntry>
        <inputEntry><text>not("41002040", "41101014", "41101022", "41101030", "41101057", "41101065", "41101073", "41101081", "41101090", "41101103", "41101111", "41101120", "41101138", "41101146", "41101154", "41101170", "41101189", "41101197", "41101200", "41101219", "41101227", "41101235", "41101243", "41101251", "41101260", "41101278", "41101286", "41101294", "41101308", "41101316", "41101332", "41101340", "41101480", "41101499", "41101502", "41101510", "41101529", "41101537", "41101545", "41101553", "41101596", "41101600", "41101618", "41101626")</text></inputEntry>
