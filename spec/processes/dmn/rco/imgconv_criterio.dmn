<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:camunda="http://camunda.org/schema/1.0/dmn" id="def_imgconv_criterio" name="Imagem convencional: sem autorização e critério publicado" namespace="https://omni-saude/dmn/imagem-convencional">
  <decision id="rco_imgconv_criterio" name="Imagem convencional: sem autorização e critério publicado" camunda:historyTimeToLive="P3650D">
    <description>OMNI-IMGCONV-AUT-0004; AUT-0005; AUT-0006; AUT-0007; AUT-0008; AUT-0009. Domínio imagem-convencional. Hit policy UNIQUE; nenhuma linha nega ou glosa; urgência libera; caráter ausente ou inválido vai à regulação; critério incompleto gera a lista do que falta; a linha de fechamento (data ausente) vai à revisão humana. Separada de imgconv_autorizacao para caber no orçamento do motor (decisão IMGCONV-14).</description>
    <decisionTable id="dt_imgconv_criterio" hitPolicy="UNIQUE">
      <input id="in_0_dataAtendimento" label="dataAtendimento ← TISS dataSolicitacao (pedido) ou dataExecucao (conta), AAAA-MM-DD">
        <inputExpression id="ie_0_dataAtendimento" typeRef="string"><text>dataAtendimento</text></inputExpression>
      </input>
      <input id="in_1_codigoProcedimento" label="codigoProcedimento ← TISS codigoProcedimento (TUSS 22)">
        <inputExpression id="ie_1_codigoProcedimento" typeRef="string"><text>codigoProcedimento</text></inputExpression>
      </input>
      <input id="in_2_caraterAtendimento" label="caraterAtendimento ← TISS caraterAtendimento (TUSS 23: 1 eletivo, 2 urgência ou emergência)">
        <inputExpression id="ie_2_caraterAtendimento" typeRef="string"><text>caraterAtendimento</text></inputExpression>
      </input>
      <input id="in_3_documentacaoCompleta" label="documentacaoCompleta ← solicitação: itens de efeito.documentacao_exigida conferidos no pedido (dados do solicitante e indicação clínica)">
        <inputExpression id="ie_3_documentacaoCompleta" typeRef="boolean"><text>documentacaoCompleta</text></inputExpression>
      </input>
      <output id="out_0_decisao" name="decisao" typeRef="string"/>
      <output id="out_1_motivoTab38" name="motivoTab38" typeRef="string"/>
      <output id="out_2_idRegra" name="idRegra" typeRef="string"/>
      <output id="out_3_fila" name="fila" typeRef="string"/>
      <output id="out_classeAdverso" name="classeAdverso" typeRef="string"/>
      <rule id="pre">
        <description>antes da vigência: regras IMGCONV não se aplicam</description>
        <inputEntry><text>&lt; "2026-12-03"</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"liberar"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-IMGCONV-AUT-0009"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="urg">
