<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:camunda="http://camunda.org/schema/1.0/dmn" id="def_imgconv_limite_intervalo" name="Imagem convencional: repetição de radiografia e mamografia em intervalo curto" namespace="https://omni-saude/dmn/imagem-convencional">
  <decision id="rco_imgconv_limite_intervalo" name="Imagem convencional: repetição de radiografia e mamografia em intervalo curto" camunda:historyTimeToLive="P3650D">
    <description>OMNI-IMGCONV-LIM-0005; LIM-0006. Domínio imagem-convencional. Hit policy UNIQUE; nenhuma linha nega ou glosa; só o eletivo ambulatorial dentro do intervalo vai à conferência; caráter ausente vai à regulação; a linha de fechamento (data ausente) vai à revisão humana. Separada de imgconv_limite_quantidade e dividida por método (radiografia e mamografia aqui, ultrassonografia em imgconv_limite_intervalo_us) para caber no orçamento do motor (decisão IMGCONV-14). Os dois códigos da mamografia seguem o intervalo de LIM-0006, que inclui o de LIM-0005.</description>
    <decisionTable id="dt_imgconv_limite_intervalo" hitPolicy="UNIQUE">
      <input id="in_0_dataAtendimento" label="dataAtendimento ← TISS dataSolicitacao (pedido) ou dataExecucao (conta), AAAA-MM-DD">
        <inputExpression id="ie_0_dataAtendimento" typeRef="string"><text>dataAtendimento</text></inputExpression>
      </input>
      <input id="in_1_codigoProcedimento" label="codigoProcedimento ← TISS codigoProcedimento (TUSS 22)">
        <inputExpression id="ie_1_codigoProcedimento" typeRef="string"><text>codigoProcedimento</text></inputExpression>
      </input>
      <input id="in_2_diasDesdeUltimoExame" label="diasDesdeUltimoExame ← cadastro: dias desde a dataExecucao anterior do mesmo código e beneficiário (histórico de guias da OMNI)">
        <inputExpression id="ie_2_diasDesdeUltimoExame" typeRef="integer"><text>diasDesdeUltimoExame</text></inputExpression>
      </input>
      <input id="in_3_caraterAtendimento" label="caraterAtendimento ← TISS caraterAtendimento (TUSS 23: 1 eletivo, 2 urgência ou emergência)">
        <inputExpression id="ie_3_caraterAtendimento" typeRef="string"><text>caraterAtendimento</text></inputExpression>
      </input>
      <input id="in_4_regime" label="regime ← TISS regimeInternacao ou tipo de guia (ambulatorial, internacao, hospital_dia)">
        <inputExpression id="ie_4_regime" typeRef="string"><text>regime</text></inputExpression>
      </input>
      <output id="out_0_decisao" name="decisao" typeRef="string"/>
      <output id="out_1_motivoTab38" name="motivoTab38" typeRef="string"/>
      <output id="out_2_idRegra" name="idRegra" typeRef="string"/>
      <output id="out_3_fila" name="fila" typeRef="string"/>
      <output id="out_classeAdverso" name="classeAdverso" typeRef="string"/>
      <rule id="pre">
        <description>antes da vigência: regras IMGCONV não se aplicam</description>
        <inputEntry><text>&lt; "2026-12-03"</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"liberar"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-IMGCONV-LIM-0005"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
