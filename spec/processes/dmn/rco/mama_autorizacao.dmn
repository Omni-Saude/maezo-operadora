        <inputEntry><text>not("30602033", "30602041", "30602076", "30602084", "30602092", "30602106", "30602114", "30602130", "30602149", "30602157", "30602190", "30602203", "30602289", "30602297", "30602300", "30602319", "30602343", "30602351", "30602386", "30602394", "30602408", "30602416", "30602424", "30602440", "30602459", "30601010", "30601029", "30601037", "30601045", "30601053", "30601070", "30601088", "30601096", "30601100", "30601118", "30601126", "30601134", "30601142", "30601150", "30601169", "30601177", "30601185", "30601193", "30601207", "30601215", "30601240", "30601258", "30601290", "30602165", "30602173", "30602211", "30602238", "30602246", "30602254", "30602262", "30602327", "30602467", "30602432")</text></inputEntry>
