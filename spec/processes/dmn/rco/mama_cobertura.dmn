<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:camunda="http://camunda.org/schema/1.0/dmn" id="def_mama_cobertura" name="Mastologia: cobertura de mama e parede torácica; reconstrução liberada; fora do Rol e estética na auditoria" namespace="https://omni-saude/dmn/mastologia">
  <decision id="rco_mama_cobertura" name="Mastologia: cobertura de mama e parede torácica; reconstrução liberada; fora do Rol e estética na auditoria" camunda:historyTimeToLive="P3650D">
    <description>OMNI-MAMA-COB-0001 a OMNI-MAMA-COB-0005. Hit policy UNIQUE; nenhuma linha nega; fora do Rol e a fronteira função × estética vão à auditoria médica; a reconstrução (Lei 9.656/1998, art. 10-A) é liberada; a linha de fechamento (data ausente) vai à revisão humana. Classes e famílias em regras/mastologia/dominio.yaml.</description>
    <decisionTable id="dt_mama_cobertura" hitPolicy="UNIQUE">
      <input id="in_0_dataAtendimento" label="dataAtendimento ← TISS dataSolicitacao (pedido) ou dataExecucao (conta), AAAA-MM-DD">
        <inputExpression id="ie_0_dataAtendimento" typeRef="string"><text>dataAtendimento</text></inputExpression>
      </input>
      <input id="in_1_codigoProcedimento" label="codigoProcedimento ← TISS codigoProcedimento (TUSS 22)">
        <inputExpression id="ie_1_codigoProcedimento" typeRef="string"><text>codigoProcedimento</text></inputExpression>
      </input>
      <output id="out_0_decisao" name="decisao" typeRef="string"/>
      <output id="out_1_motivoTab38" name="motivoTab38" typeRef="string"/>
      <output id="out_2_idRegra" name="idRegra" typeRef="string"/>
      <output id="out_3_fila" name="fila" typeRef="string"/>
      <output id="out_classeAdverso" name="classeAdverso" typeRef="string"/>
      <rule id="c_pre">
        <description>OMNI-MAMA-COB-0001 — antes da vigência (03/12/2026)</description>
        <inputEntry><text>&lt; "2026-12-03"</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"liberar"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-MAMA-COB-0001"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="c0001">
        <description>OMNI-MAMA-COB-0001 — TUSS 22 sem correlação no Rol: auditoria médica aplica o art. 10, §13, da Lei 9.656/1998; sem negativa automática</description>
        <inputEntry><text>&gt;= "2026-12-03"</text></inputEntry>
        <inputEntry><text>"30602360", "30602378", "30601274", "30601282"</text></inputEntry>
        <outputEntry><text>"revisao_humana"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-MAMA-COB-0001"</text></outputEntry>
        <outputEntry><text>"auditoria_medica"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="c0002">
        <description>OMNI-MAMA-COB-0002 — biópsia, punção e drenagem da mama: sem exigência prévia</description>
        <inputEntry><text>&gt;= "2026-12-03"</text></inputEntry>
        <inputEntry><text>"30602017", "30602050", "30602068", "30602181", "30602335"</text></inputEntry>
        <outputEntry><text>"liberar"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-MAMA-COB-0002"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="c0003">
        <description>OMNI-MAMA-COB-0003 — fronteira entre função e estética: auditoria médica, sem negativa automática</description>
        <inputEntry><text>&gt;= "2026-12-03"</text></inputEntry>
        <inputEntry><text>"30602084", "30602114", "30602122"</text></inputEntry>
        <outputEntry><text>"revisao_humana"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-MAMA-COB-0003"</text></outputEntry>
        <outputEntry><text>"auditoria_medica"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="c0004">
        <description>OMNI-MAMA-COB-0004 — reconstrução e simetrização da mama: cobertura obrigatória, liberada, sem caminho de negativa</description>
        <inputEntry><text>&gt;= "2026-12-03"</text></inputEntry>
        <inputEntry><text>"30602165", "30602173", "30602211", "30602238", "30602246", "30602254", "30602262", "30602327", "30602467"</text></inputEntry>
        <outputEntry><text>"liberar"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-MAMA-COB-0004"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="c0005">
        <description>OMNI-MAMA-COB-0005 — retalho livre microcirúrgico: auditoria confere o vínculo com o câncer e libera; sem negativa no câncer</description>
        <inputEntry><text>&gt;= "2026-12-03"</text></inputEntry>
        <inputEntry><text>"30602432"</text></inputEntry>
        <outputEntry><text>"revisao_humana"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-MAMA-COB-0005"</text></outputEntry>
        <outputEntry><text>"auditoria_medica"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="c_resto">
        <description>OMNI-MAMA-COB-0001 — demais códigos: no Rol, cobertura obrigatória na segmentação contratada</description>
        <inputEntry><text>&gt;= "2026-12-03"</text></inputEntry>
        <inputEntry><text>not("30602360", "30602378", "30601274", "30601282", "30602017", "30602050", "30602068", "30602181", "30602335", "30602084", "30602114", "30602122", "30602165", "30602173", "30602211", "30602246", "30602254", "30602262", "30602327", "30602238", "30602467", "30602432")</text></inputEntry>
        <outputEntry><text>"liberar"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-MAMA-COB-0001"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="c_sem_data">
        <description>OMNI-MAMA-COB-0001 — data ausente: regulação, nunca negativa</description>
        <inputEntry><text>null</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"revisao_humana"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-MAMA-COB-0001"</text></outputEntry>
        <outputEntry><text>"regulacao"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
</definitions>
