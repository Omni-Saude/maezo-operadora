<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:camunda="http://camunda.org/schema/1.0/dmn" id="def_mama_pacote" name="Mastologia: pacotes da cirurgia conservadora e da mastectomia eletivas; composição da técnica combinada; demais em conta aberta" namespace="https://omni-saude/dmn/mastologia">
  <decision id="rco_mama_pacote" name="Mastologia: pacotes da cirurgia conservadora e da mastectomia eletivas; composição da técnica combinada; demais em conta aberta" camunda:historyTimeToLive="P3650D">
    <description>OMNI-MAMA-PAC-0001, OMNI-MAMA-PAC-0002 e OMNI-MAMA-PAC-0003. Hit policy UNIQUE; nenhuma linha nega: eletivo em prestador com o pacote vigente paga o pacote (OMNI-PAC-MAMA-0001 e OMNI-PAC-MAMA-0002); urgência, caráter não informado (EXC-01) e prestador sem pacote (EXC-02) ficam em conta aberta (HCP-LAN 1); permanência acima do limiar paga diária adicional e acima do limite de revisão vai também à auditoria médica, sem suspender o pagamento (limiares provisórios em validacao/calibracao/parametros-provisorios/mastologia.csv); a técnica combinada de marcação e linfonodo sentinela é cobrada por ato, uma vez por ato (PAC-0002); reconstrução, simetrização e OPME ficam fora dos pacotes. Fechamento com data ausente vai à revisão humana.</description>
    <decisionTable id="dt_mama_pacote" hitPolicy="UNIQUE">
      <input id="in_0_dataAtendimento" label="dataAtendimento ← TISS dataSolicitacao (pedido) ou dataExecucao (conta), AAAA-MM-DD">
        <inputExpression id="ie_0_dataAtendimento" typeRef="string"><text>dataAtendimento</text></inputExpression>
      </input>
      <input id="in_1_codigoProcedimento" label="codigoProcedimento ← TISS codigoProcedimento (TUSS 22)">
        <inputExpression id="ie_1_codigoProcedimento" typeRef="string"><text>codigoProcedimento</text></inputExpression>
      </input>
      <input id="in_2_caraterAtendimento" label="caraterAtendimento ← TISS caraterAtendimento (TUSS 23: 1 eletivo, 2 urgência ou emergência)">
        <inputExpression id="ie_2_caraterAtendimento" typeRef="string"><text>caraterAtendimento</text></inputExpression>
      </input>
      <input id="in_3_prestadorComPacote" label="prestadorComPacote ← cadastro de contrato: pacote OMNI-PAC-MAMA vigente para o prestador (booleano)">
        <inputExpression id="ie_3_prestadorComPacote" typeRef="boolean"><text>prestadorComPacote</text></inputExpression>
      </input>
      <input id="in_4_diasInternacao" label="diasInternacao ← resumo de internação TISS: data da alta menos data da internação, em dias (nulo no pedido)">
        <inputExpression id="ie_4_diasInternacao" typeRef="integer"><text>diasInternacao</text></inputExpression>
      </input>
      <input id="in_5_componenteRepetidoMesmoAto" label="componenteRepetidoMesmoAto ← conta TISS: mesmo código do ato na lista mais de uma vez para o mesmo beneficiário e data (booleano)">
        <inputExpression id="ie_5_componenteRepetidoMesmoAto" typeRef="boolean"><text>componenteRepetidoMesmoAto</text></inputExpression>
      </input>
      <output id="out_0_decisao" name="decisao" typeRef="string"/>
      <output id="out_1_motivoTab38" name="motivoTab38" typeRef="string"/>
      <output id="out_2_idRegra" name="idRegra" typeRef="string"/>
      <output id="out_3_fila" name="fila" typeRef="string"/>
      <output id="out_classeAdverso" name="classeAdverso" typeRef="string"/>
      <output id="out_4_modalidadePagamento" name="modalidadePagamento" typeRef="string"/>
      <rule id="k_pre">
        <description>OMNI-MAMA-PAC-0001 — antes da vigência (03/12/2026): conta aberta</description>
        <inputEntry><text>&lt; "2026-12-03"</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"liberar"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-MAMA-PAC-0001"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"conta_aberta"</text></outputEntry>
      </rule>
      <rule id="ka_urg">
        <description>OMNI-MAMA-PAC-0001 — urgência ou caráter não informado (EXC-01): conta aberta, sujeita às edições automáticas</description>
        <inputEntry><text>&gt;= "2026-12-03"</text></inputEntry>
        <inputEntry><text>"30602203", "30602190"</text></inputEntry>
        <inputEntry><text>not("1")</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"liberar"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-MAMA-PAC-0001"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"conta_aberta"</text></outputEntry>
      </rule>
      <rule id="ka_sem">
        <description>OMNI-MAMA-PAC-0001 — prestador sem o pacote no contrato (EXC-02): conta aberta</description>
        <inputEntry><text>&gt;= "2026-12-03"</text></inputEntry>
        <inputEntry><text>"30602203", "30602190"</text></inputEntry>
        <inputEntry><text>"1"</text></inputEntry>
        <inputEntry><text>false</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"liberar"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-MAMA-PAC-0001"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"conta_aberta"</text></outputEntry>
      </rule>
      <rule id="ka_cad">
        <description>OMNI-MAMA-PAC-0001 — contrato do prestador não informado: faturamento confere o cadastro; sem negativa</description>
        <inputEntry><text>&gt;= "2026-12-03"</text></inputEntry>
        <inputEntry><text>"30602203", "30602190"</text></inputEntry>
        <inputEntry><text>"1"</text></inputEntry>
        <inputEntry><text>null</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"revisao_humana"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-MAMA-PAC-0001"</text></outputEntry>
        <outputEntry><text>"faturamento"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"verificar"</text></outputEntry>
      </rule>
      <rule id="ka_pac">
        <description>OMNI-MAMA-PAC-0001 — eletivo em prestador com pacote, permanência até o limiar de 1 dia(s) (provisório) ou ainda não informada: paga o pacote</description>
        <inputEntry><text>&gt;= "2026-12-03"</text></inputEntry>
        <inputEntry><text>"30602203", "30602190"</text></inputEntry>
        <inputEntry><text>"1"</text></inputEntry>
        <inputEntry><text>true</text></inputEntry>
        <inputEntry><text>&lt;= 1, null</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"pagar_pacote"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-MAMA-PAC-0001"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"pacote"</text></outputEntry>
      </rule>
      <rule id="ka_dia">
        <description>OMNI-MAMA-PAC-0001 — permanência acima do limiar e até o limite de revisão de 3 dia(s) (provisório): pacote mais diária adicional</description>
        <inputEntry><text>&gt;= "2026-12-03"</text></inputEntry>
        <inputEntry><text>"30602203", "30602190"</text></inputEntry>
        <inputEntry><text>"1"</text></inputEntry>
        <inputEntry><text>true</text></inputEntry>
        <inputEntry><text>[2..3]</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"pagar_pacote"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-MAMA-PAC-0001"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"pacote_mais_diarias"</text></outputEntry>
      </rule>
      <rule id="ka_rev">
        <description>OMNI-MAMA-PAC-0001 — permanência acima do limite de revisão: auditoria médica, sem suspender o pagamento</description>
