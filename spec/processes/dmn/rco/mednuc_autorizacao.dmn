<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:camunda="http://camunda.org/schema/1.0/dmn" id="def_mednuc_autorizacao" name="Medicina nuclear: critério publicado no lugar da autorização caso a caso, terapia em curso e urgência" namespace="https://omni-saude/dmn/medicina-nuclear">
  <decision id="rco_mednuc_autorizacao" name="Medicina nuclear: critério publicado no lugar da autorização caso a caso, terapia em curso e urgência" camunda:historyTimeToLive="P3650D">
    <description>OMNI-MEDNUC-AUT-0001 a OMNI-MEDNUC-AUT-0010. Domínio medicina-nuclear. Hit policy UNIQUE; nenhuma linha nega ou glosa; campo nulo vai à revisão humana; a linha de fechamento (data ausente) vai à regulação.</description>
    <decisionTable id="dt_mednuc_autorizacao" hitPolicy="UNIQUE">
      <input id="in_dataAtendimento" label="dataAtendimento ← TISS dataSolicitacao (pedido) ou dataExecucao (conta), AAAA-MM-DD">
        <inputExpression id="ie_dataAtendimento" typeRef="string"><text>dataAtendimento</text></inputExpression>
      </input>
      <input id="in_familiaMednuc" label="familiaMednuc ← fluxo Camunda: chave de familias em regras/medicina-nuclear/dominio.yaml, derivada do TISS codigoProcedimento (TUSS 22)">
        <inputExpression id="ie_familiaMednuc" typeRef="string"><text>familiaMednuc</text></inputExpression>
      </input>
      <input id="in_caraterAtendimento" label="caraterAtendimento ← TISS caraterAtendimento (TUSS 23: 1 eletivo, 2 urgência ou emergência)">
        <inputExpression id="ie_caraterAtendimento" typeRef="string"><text>caraterAtendimento</text></inputExpression>
      </input>
      <input id="in_pedidoCompleto" label="pedidoCompleto ← TISS guia de SP/SADT: CID-10 (diagnostico) e indicacaoClinica preenchidos, conferido pelo fluxo Camunda">
        <inputExpression id="ie_pedidoCompleto" typeRef="boolean"><text>pedidoCompleto</text></inputExpression>
      </input>
      <input id="in_terapiaEmCurso" label="terapiaEmCurso ← fluxo Camunda: histórico de guias OMNI, mesmo código de terapia já pago ao beneficiário no tratamento atual">
        <inputExpression id="ie_terapiaEmCurso" typeRef="boolean"><text>terapiaEmCurso</text></inputExpression>
      </input>
      <output id="out_decisao" name="decisao" typeRef="string"/>
      <output id="out_motivoTab38" name="motivoTab38" typeRef="string"/>
      <output id="out_idRegra" name="idRegra" typeRef="string"/>
      <output id="out_fila" name="fila" typeRef="string"/>
      <output id="out_classeAdverso" name="classeAdverso" typeRef="string"/>
      <rule id="pre">
        <description>OMNI-MEDNUC-AUT-0010 — antes do início da vigência (03/12/2026): a regra de autorização não se aplica</description>
        <inputEntry><text>&lt; "2026-12-03"</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"liberar"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-MEDNUC-AUT-0010"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="a01_ok">
        <description>OMNI-MEDNUC-AUT-0001 — eletivo com CID-10 e indicação clínica na guia: libera</description>
        <inputEntry><text>&gt;= "2026-12-03"</text></inputEntry>
        <inputEntry><text>"cardiovascular_in_vivo"</text></inputEntry>
        <inputEntry><text>"1"</text></inputEntry>
        <inputEntry><text>true</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"liberar"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-MEDNUC-AUT-0001"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="a01_falta">
        <description>OMNI-MEDNUC-AUT-0001 — eletivo sem CID-10 ou indicação clínica: lista do que falta (RN 623 art. 12 §6º)</description>
        <inputEntry><text>&gt;= "2026-12-03"</text></inputEntry>
        <inputEntry><text>"cardiovascular_in_vivo"</text></inputEntry>
        <inputEntry><text>"1"</text></inputEntry>
        <inputEntry><text>false</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"exigir_documento"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-MEDNUC-AUT-0001"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="a01_nulo">
        <description>OMNI-MEDNUC-AUT-0001 — eletivo com conferência do pedido não informada: regulação, sem negativa</description>
        <inputEntry><text>&gt;= "2026-12-03"</text></inputEntry>
        <inputEntry><text>"cardiovascular_in_vivo"</text></inputEntry>
        <inputEntry><text>"1"</text></inputEntry>
        <inputEntry><text>null</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"revisao_humana"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-MEDNUC-AUT-0001"</text></outputEntry>
        <outputEntry><text>"regulacao"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="a01_urg">
        <description>OMNI-MEDNUC-AUT-0001 — urgência ou emergência: libera sem exigência (OMNI-URG-*)</description>
        <inputEntry><text>&gt;= "2026-12-03"</text></inputEntry>
        <inputEntry><text>"cardiovascular_in_vivo"</text></inputEntry>
        <inputEntry><text>"2"</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"liberar"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-MEDNUC-AUT-0001"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="a01_car">
        <description>OMNI-MEDNUC-AUT-0001 — caráter ausente ou fora da TUSS 23: regulação, sem negativa</description>
        <inputEntry><text>&gt;= "2026-12-03"</text></inputEntry>
        <inputEntry><text>"cardiovascular_in_vivo"</text></inputEntry>
        <inputEntry><text>not("1", "2")</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"revisao_humana"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-MEDNUC-AUT-0001"</text></outputEntry>
        <outputEntry><text>"regulacao"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
