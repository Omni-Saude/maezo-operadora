<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:camunda="http://camunda.org/schema/1.0/dmn" id="def_mednuc_glosa" name="Medicina nuclear: taxa de radiofármaco sem o exame e radiofármaco cobrado como material, a posteriori" namespace="https://omni-saude/dmn/medicina-nuclear">
  <decision id="rco_mednuc_glosa" name="Medicina nuclear: taxa de radiofármaco sem o exame e radiofármaco cobrado como material, a posteriori" camunda:historyTimeToLive="P3650D">
    <description>OMNI-MEDNUC-GLO-0001. Domínio medicina-nuclear. Hit policy UNIQUE; nenhuma linha nega ou glosa; campo nulo vai à revisão humana; a linha de fechamento (data ausente) vai à regulação.</description>
    <decisionTable id="dt_mednuc_glosa" hitPolicy="UNIQUE">
      <input id="in_dataAtendimento" label="dataAtendimento ← TISS dataSolicitacao (pedido) ou dataExecucao (conta), AAAA-MM-DD">
        <inputExpression id="ie_dataAtendimento" typeRef="string"><text>dataAtendimento</text></inputExpression>
      </input>
      <input id="in_taxaSemExame" label="taxaSemExame ← TISS conta: taxa TUSS 18 de radiofármaco sem o código TUSS 22 citado no termo na mesma guia">
        <inputExpression id="ie_taxaSemExame" typeRef="boolean"><text>taxaSemExame</text></inputExpression>
      </input>
      <input id="in_radiofarmacoComoMatMed" label="radiofarmacoComoMatMed ← TISS conta: item de material ou medicamento identificado como radiofármaco pelo faturamento num exame com taxa própria">
        <inputExpression id="ie_radiofarmacoComoMatMed" typeRef="boolean"><text>radiofarmacoComoMatMed</text></inputExpression>
      </input>
      <output id="out_decisao" name="decisao" typeRef="string"/>
      <output id="out_motivoTab38" name="motivoTab38" typeRef="string"/>
      <output id="out_idRegra" name="idRegra" typeRef="string"/>
      <output id="out_fila" name="fila" typeRef="string"/>
      <output id="out_classeAdverso" name="classeAdverso" typeRef="string"/>
      <rule id="pre">
        <description>OMNI-MEDNUC-GLO-0001 — antes do início da vigência (03/12/2026): a conferência da taxa não se aplica</description>
        <inputEntry><text>&lt; "2026-12-03"</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"liberar"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-MEDNUC-GLO-0001"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="g_taxa">
        <description>OMNI-MEDNUC-GLO-0001 — taxa de radiofármaco sem o exame citado no termo na mesma guia: faturamento, sem glosa automática</description>
        <inputEntry><text>&gt;= "2026-12-03"</text></inputEntry>
        <inputEntry><text>true</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"revisao_humana"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-MEDNUC-GLO-0001"</text></outputEntry>
        <outputEntry><text>"faturamento"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="g_mat">
        <description>OMNI-MEDNUC-GLO-0001 — radiofármaco cobrado como material ou medicamento em exame com taxa própria: faturamento, sem glosa automática</description>
        <inputEntry><text>&gt;= "2026-12-03"</text></inputEntry>
        <inputEntry><text>false, null</text></inputEntry>
        <inputEntry><text>true</text></inputEntry>
        <outputEntry><text>"revisao_humana"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-MEDNUC-GLO-0001"</text></outputEntry>
        <outputEntry><text>"faturamento"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="g_ok">
        <description>OMNI-MEDNUC-GLO-0001 — taxa com o exame e sem radiofármaco como material: libera</description>
        <inputEntry><text>&gt;= "2026-12-03"</text></inputEntry>
        <inputEntry><text>false</text></inputEntry>
        <inputEntry><text>false</text></inputEntry>
        <outputEntry><text>"liberar"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-MEDNUC-GLO-0001"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="g_mat_nulo">
        <description>OMNI-MEDNUC-GLO-0001 — indicação de radiofármaco como material não informada: regulação, sem negativa</description>
        <inputEntry><text>&gt;= "2026-12-03"</text></inputEntry>
        <inputEntry><text>false</text></inputEntry>
        <inputEntry><text>null</text></inputEntry>
        <outputEntry><text>"revisao_humana"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-MEDNUC-GLO-0001"</text></outputEntry>
        <outputEntry><text>"regulacao"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="g_taxa_nulo">
        <description>OMNI-MEDNUC-GLO-0001 — conferência da taxa sem exame não informada: regulação, sem negativa</description>
        <inputEntry><text>&gt;= "2026-12-03"</text></inputEntry>
        <inputEntry><text>null</text></inputEntry>
        <inputEntry><text>false, null</text></inputEntry>
        <outputEntry><text>"revisao_humana"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-MEDNUC-GLO-0001"</text></outputEntry>
        <outputEntry><text>"regulacao"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="fim">
        <description>OMNI-MEDNUC-GLO-0001 — data ausente: regulação, sem negativa</description>
        <inputEntry><text>null</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"revisao_humana"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-MEDNUC-GLO-0001"</text></outputEntry>
        <outputEntry><text>"regulacao"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
</definitions>
