<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:camunda="http://camunda.org/schema/1.0/dmn" id="def_mex_orl" name="ORL: pares de procedimentos mutuamente exclusivos (OMNI-ORL-MEX-0001 a 0009)" namespace="https://omni-saude/dmn/otorrino-cabeca-pescoco">
  <decision id="rco_mex_orl" name="ORL: pares de procedimentos mutuamente exclusivos (OMNI-ORL-MEX-0001 a 0009)" camunda:historyTimeToLive="P3650D">
    <description>Avalia cada par (principal × secundário) da mesma guia e data de execução. Glosa só a linha secundária, com motivo 3202 e recurso; a TISS não tem lateralidade, então o par por outra via vai à auditoria médica. OMNI-ORL-MEX-0001 a MEX-0009.</description>
    <decisionTable id="dt_mex_orl" hitPolicy="UNIQUE">
      <input id="in_0_dataAtendimento" label="dataAtendimento ← TISS dataExecucao, AAAA-MM-DD">
        <inputExpression id="ie_0_dataAtendimento" typeRef="string"><text>dataAtendimento</text></inputExpression>
      </input>
      <input id="in_1_codigoPrincipal" label="codigoPrincipal ← TISS codigoProcedimento do procedimento de referência na mesma guia e data de execução (TUSS 22)">
        <inputExpression id="ie_1_codigoPrincipal" typeRef="string"><text>codigoPrincipal</text></inputExpression>
      </input>
      <input id="in_2_codigoSecundario" label="codigoSecundario ← TISS codigoProcedimento de outra linha da mesma guia e data de execução (TUSS 22)">
        <inputExpression id="ie_2_codigoSecundario" typeRef="string"><text>codigoSecundario</text></inputExpression>
      </input>
      <input id="in_3_viaAcessoSecundario" label="viaAcessoSecundario ← TISS viaAcesso da linha secundária (Tab. 61: 1 única, 2 mesma via, 3 diferentes vias)">
        <inputExpression id="ie_3_viaAcessoSecundario" typeRef="string"><text>viaAcessoSecundario</text></inputExpression>
      </input>
      <output id="out_decisao" name="decisao" typeRef="string"/>
      <output id="out_motivoTab38" name="motivoTab38" typeRef="string"/>
      <output id="out_idRegra" name="idRegra" typeRef="string"/>
      <output id="out_fila" name="fila" typeRef="string"/>
      <output id="out_classeAdverso" name="classeAdverso" typeRef="string"/>
      <rule id="m_pre">
        <description>OMNI-ORL-MEX-0001 — fora da vigência (antes de 02/12/2026): sem conferência automática</description>
        <inputEntry><text>&lt; "2026-12-02"</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"liberar"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-ORL-MEX-0001"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="m00">
        <description>OMNI-ORL-MEX-0001 — 20104065: secundário pela mesma via é excludente</description>
        <inputEntry><text>&gt;= "2026-12-02"</text></inputEntry>
        <inputEntry><text>"20104065"</text></inputEntry>
        <inputEntry><text>"30402018"</text></inputEntry>
        <inputEntry><text>"2"</text></inputEntry>
        <outputEntry><text>"glosar"</text></outputEntry>
        <outputEntry><text>"3202"</text></outputEntry>
        <outputEntry><text>"OMNI-ORL-MEX-0001"</text></outputEntry>
        <outputEntry><text>"faturamento"</text></outputEntry>
        <outputEntry><text>"contas"</text></outputEntry>
      </rule>
