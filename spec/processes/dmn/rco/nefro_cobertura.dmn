<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:camunda="http://camunda.org/schema/1.0/dmn" id="def_nefro_cobertura" name="Hemodiálise e nefrologia: cobertura da terapia renal substitutiva e dos acessos para diálise" namespace="https://omni-saude/dmn/hemodialise-nefrologia">
  <decision id="rco_nefro_cobertura" name="Hemodiálise e nefrologia: cobertura da terapia renal substitutiva e dos acessos para diálise" camunda:historyTimeToLive="P3650D">
    <description>OMNI-NEFRO-COB-0001 a OMNI-NEFRO-COB-0003. Hit policy UNIQUE; nenhuma linha nega (cobertura obrigatória do Rol); retirada de cateter sem tipo informado ou fora de totalmente implantado e tunelizado suturado, e implante hospitalar de cateter em plano só ambulatorial, vão à revisão humana; campo nulo nunca vira negativa; fechamento null vai à regulação.</description>
    <decisionTable id="dt_nefro_cobertura" hitPolicy="UNIQUE">
      <input id="in_0_dataAtendimento" label="dataAtendimento ← TISS dataSolicitacao (pedido) ou dataExecucao (conta), AAAA-MM-DD">
        <inputExpression id="ie_0_dataAtendimento" typeRef="string"><text>dataAtendimento</text></inputExpression>
      </input>
      <input id="in_1_codigoProcedimento" label="codigoProcedimento ← TISS codigoProcedimento (TUSS 22)">
        <inputExpression id="ie_1_codigoProcedimento" typeRef="string"><text>codigoProcedimento</text></inputExpression>
      </input>
      <input id="in_2_tipoCateter" label="tipoCateter ← solicitação e cadastro: tipo do cateter de longa permanência na retirada (totalmente_implantado, tunelizado_suturado; nulo se não informado)">
        <inputExpression id="ie_2_tipoCateter" typeRef="string"><text>tipoCateter</text></inputExpression>
      </input>
      <input id="in_3_planoSoAmbulatorial" label="planoSoAmbulatorial ← cadastro do produto: segmentação só ambulatorial (Lei 9.656/1998, art. 12)">
        <inputExpression id="ie_3_planoSoAmbulatorial" typeRef="boolean"><text>planoSoAmbulatorial</text></inputExpression>
      </input>
      <output id="out_0_decisao" name="decisao" typeRef="string"/>
      <output id="out_1_motivoTab38" name="motivoTab38" typeRef="string"/>
      <output id="out_2_idRegra" name="idRegra" typeRef="string"/>
      <output id="out_3_fila" name="fila" typeRef="string"/>
      <output id="out_classeAdverso" name="classeAdverso" typeRef="string"/>
      <rule id="n_pre">
        <description>OMNI-NEFRO-COB-0003 — antes da vigência (03/12/2026)</description>
        <inputEntry><text>&lt; "2026-12-03"</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"liberar"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-NEFRO-COB-0003"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="c1_cvc">
        <description>OMNI-NEFRO-COB-0001 — cateter venoso central por punção: cobertura sem restrição adicional</description>
        <inputEntry><text>&gt;= "2026-12-03"</text></inputEntry>
        <inputEntry><text>"30913012"</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"liberar"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-NEFRO-COB-0001"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="c2_ret_ok">
        <description>OMNI-NEFRO-COB-0002 — retirada cirúrgica de cateter, tipo totalmente implantado ou tunelizado e suturado: liberar</description>
        <inputEntry><text>&gt;= "2026-12-03"</text></inputEntry>
        <inputEntry><text>"30913128"</text></inputEntry>
        <inputEntry><text>"totalmente_implantado", "tunelizado_suturado"</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"liberar"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-NEFRO-COB-0002"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="c2_ret_rev">
        <description>OMNI-NEFRO-COB-0002 — retirada cirúrgica de cateter sem tipo informado ou de outro tipo: auditoria, sem negativa</description>
        <inputEntry><text>&gt;= "2026-12-03"</text></inputEntry>
        <inputEntry><text>"30913128"</text></inputEntry>
        <inputEntry><text>not("totalmente_implantado", "tunelizado_suturado")</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"revisao_humana"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-NEFRO-COB-0002"</text></outputEntry>
        <outputEntry><text>"auditoria_medica"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="c2_imp_amb">
        <description>OMNI-NEFRO-COB-0002 — implante cirúrgico de cateter de longa permanência em plano só ambulatorial: auditoria (Lei 9.656/1998, art. 10, §13), sem negativa</description>
        <inputEntry><text>&gt;= "2026-12-03"</text></inputEntry>
        <inputEntry><text>"30913101"</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>true</text></inputEntry>
        <outputEntry><text>"revisao_humana"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-NEFRO-COB-0002"</text></outputEntry>
        <outputEntry><text>"auditoria_medica"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="c2_imp_ok">
        <description>OMNI-NEFRO-COB-0002 — implante cirúrgico de cateter de longa permanência fora de plano só ambulatorial ou segmentação não informada: liberar</description>
        <inputEntry><text>&gt;= "2026-12-03"</text></inputEntry>
        <inputEntry><text>"30913101"</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>false, null</text></inputEntry>
        <outputEntry><text>"liberar"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-NEFRO-COB-0002"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="c2_fistula">
        <description>OMNI-NEFRO-COB-0002 — fístula arteriovenosa (confecção e retirada): cobertura pelo Rol</description>
        <inputEntry><text>&gt;= "2026-12-03"</text></inputEntry>
        <inputEntry><text>"30913144", "30913152"</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"liberar"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-NEFRO-COB-0002"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="c3_trs">
        <description>OMNI-NEFRO-COB-0003 — hemodiálise, hemodepuração, hemodiafiltração e diálise peritoneal: indicação do médico assistente, cobertura pelo Rol</description>
        <inputEntry><text>&gt;= "2026-12-03"</text></inputEntry>
        <inputEntry><text>"30909023", "30909031", "30909139", "30909147", "30909155", "31008011", "31008020", "31008038", "31008046", "31008119"</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"liberar"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-NEFRO-COB-0003"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="c_resto">
        <description>OMNI-NEFRO-COB-0003 — código fora do domínio: sem restrição desta tabela</description>
        <inputEntry><text>&gt;= "2026-12-03"</text></inputEntry>
        <inputEntry><text>not("30909023", "30909031", "30909139", "30909147", "30909155", "30913012", "30913101", "30913128", "30913144", "30913152", "31008011", "31008020", "31008038", "31008046", "31008119")</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"liberar"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-NEFRO-COB-0003"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="n_sem_data">
        <description>OMNI-NEFRO-COB-0003 — data de atendimento ausente: regulação, nunca negativa</description>
        <inputEntry><text>null</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"revisao_humana"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-NEFRO-COB-0003"</text></outputEntry>
        <outputEntry><text>"regulacao"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
</definitions>
