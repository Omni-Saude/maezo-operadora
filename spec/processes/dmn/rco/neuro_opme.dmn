<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:camunda="http://camunda.org/schema/1.0/dmn" id="def_neuro_opme" name="Neurocirurgia: brocas e fresa de craniotomia por ato (OMNI-NEURO-OPM-0001)" namespace="https://omni-saude/dmn/neurocirurgia-neuroestimulacao">
  <decision id="rco_neuro_opme" name="Neurocirurgia: brocas e fresa de craniotomia por ato (OMNI-NEURO-OPM-0001)" camunda:historyTimeToLive="P3650D">
    <description>OMNI-NEURO-OPM-0001. Lista positiva por procedimento de regras/neurocirurgia-neuroestimulacao/dominio.yaml (listas_opme, familias_opme CRANIOTOMIA e FIXACAO), quantidade máxima provisória por categoria por ato (validacao/calibracao/parametros-provisorios/neurocirurgia-neuroestimulacao.csv). Dentro do limite paga; acima, fora da lista ou sem classificação vai à auditoria médica, sem glosa; quantidade nula vai ao faturamento. Hit policy UNIQUE; nenhuma linha nega ou glosa; a linha de fechamento (data ausente) vai à revisão humana.</description>
    <decisionTable id="dt_neuro_opme" hitPolicy="UNIQUE">
      <input id="in_0_dataAtendimento" label="dataAtendimento ← TISS dataExecucao do procedimento, AAAA-MM-DD">
        <inputExpression id="ie_0_dataAtendimento" typeRef="string"><text>dataAtendimento</text></inputExpression>
      </input>
      <input id="in_1_codigoProcedimento" label="codigoProcedimento ← TISS codigoProcedimento do ato cirúrgico (TUSS 22)">
        <inputExpression id="ie_1_codigoProcedimento" typeRef="string"><text>codigoProcedimento</text></inputExpression>
      </input>
      <input id="in_2_categoriaOpme" label="categoriaOpme ← TISS codigoItem da OPME (TUSS 19) classificado pelo cadastro OMNI de materiais (broca_trepanacao_craniana, fresa_craniotomia, broca_desgaste, broca_perfuracao); sem correspondência vai nulo">
        <inputExpression id="ie_2_categoriaOpme" typeRef="string"><text>categoriaOpme</text></inputExpression>
      </input>
      <input id="in_3_quantidade" label="quantidade ← TISS quantidadeExecutada da categoria por guia e dataExecucao (ato)">
        <inputExpression id="ie_3_quantidade" typeRef="integer"><text>quantidade</text></inputExpression>
      </input>
      <output id="out_0_decisao" name="decisao" typeRef="string"/>
      <output id="out_1_motivoTab38" name="motivoTab38" typeRef="string"/>
      <output id="out_2_idRegra" name="idRegra" typeRef="string"/>
      <output id="out_3_fila" name="fila" typeRef="string"/>
      <output id="out_classeAdverso" name="classeAdverso" typeRef="string"/>
      <rule id="o_pre">
        <description>OMNI-NEURO-OPM-0001 — antes da vigência (03/12/2026): sem efeito desta tabela</description>
        <inputEntry><text>&lt; "2026-12-03"</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"liberar"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-NEURO-OPM-0001"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="o_fora">
        <description>OMNI-NEURO-OPM-0001 — procedimento sem lista de OPME NEURO: sem efeito desta tabela</description>
        <inputEntry><text>&gt;= "2026-12-03"</text></inputEntry>
        <inputEntry><text>not("30215021", "31401058", "31401082", "31401090", "31401244", "31401236", "31401155", "31401171", "31401309", "31401384", "30215013")</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"liberar"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-NEURO-OPM-0001"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="o_cran_ok">
        <description>OMNI-NEURO-OPM-0001 — categoria da lista, até o máximo por ato: paga</description>
        <inputEntry><text>&gt;= "2026-12-03"</text></inputEntry>
        <inputEntry><text>"30215021", "31401058", "31401082", "31401090", "31401244", "31401236"</text></inputEntry>
        <inputEntry><text>"broca_trepanacao_craniana", "fresa_craniotomia", "broca_desgaste"</text></inputEntry>
        <inputEntry><text>&lt;= 1</text></inputEntry>
        <outputEntry><text>"liberar"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-NEURO-OPM-0001"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="o_cran_exc">
        <description>OMNI-NEURO-OPM-0001 — acima do máximo por ato: auditoria médica, sem glosa</description>
        <inputEntry><text>&gt;= "2026-12-03"</text></inputEntry>
        <inputEntry><text>"30215021", "31401058", "31401082", "31401090", "31401244", "31401236"</text></inputEntry>
        <inputEntry><text>"broca_trepanacao_craniana", "fresa_craniotomia", "broca_desgaste"</text></inputEntry>
        <inputEntry><text>&gt; 1</text></inputEntry>
        <outputEntry><text>"revisao_humana"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-NEURO-OPM-0001"</text></outputEntry>
        <outputEntry><text>"auditoria_medica"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="o_cran_qnulo">
        <description>OMNI-NEURO-OPM-0001 — quantidade não informada: faturamento</description>
        <inputEntry><text>&gt;= "2026-12-03"</text></inputEntry>
        <inputEntry><text>"30215021", "31401058", "31401082", "31401090", "31401244", "31401236"</text></inputEntry>
        <inputEntry><text>"broca_trepanacao_craniana", "fresa_craniotomia", "broca_desgaste"</text></inputEntry>
        <inputEntry><text>null</text></inputEntry>
        <outputEntry><text>"revisao_humana"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-NEURO-OPM-0001"</text></outputEntry>
        <outputEntry><text>"faturamento"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="o_cran_fora">
        <description>OMNI-NEURO-OPM-0001 — categoria fora da lista do procedimento ou sem classificação: auditoria médica, sem glosa</description>
        <inputEntry><text>&gt;= "2026-12-03"</text></inputEntry>
        <inputEntry><text>"30215021", "31401058", "31401082", "31401090", "31401244", "31401236"</text></inputEntry>
        <inputEntry><text>not("broca_trepanacao_craniana", "fresa_craniotomia", "broca_desgaste")</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"revisao_humana"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-NEURO-OPM-0001"</text></outputEntry>
        <outputEntry><text>"auditoria_medica"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="o_cranfix_ok">
        <description>OMNI-NEURO-OPM-0001 — categoria da lista, até o máximo por ato: paga</description>
