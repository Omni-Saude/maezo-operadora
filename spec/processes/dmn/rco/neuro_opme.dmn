        <inputEntry><text>&gt;= "2026-12-03"</text></inputEntry>
        <inputEntry><text>"31401155", "31401171", "31401309", "31401384"</text></inputEntry>
        <inputEntry><text>"broca_trepanacao_craniana", "fresa_craniotomia", "broca_desgaste", "broca_perfuracao"</text></inputEntry>
        <inputEntry><text>null</text></inputEntry>
        <outputEntry><text>"revisao_humana"</text></outputEntry>
