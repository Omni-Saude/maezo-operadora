<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:camunda="http://camunda.org/schema/1.0/dmn" id="def_odonto_cobertura" name="Odontologia hospitalar: cobertura (COB-0001 a COB-0006)" namespace="https://omni-saude/dmn/odontologia-hospitalar">
  <decision id="rco_odonto_cobertura" name="Odontologia hospitalar: cobertura (COB-0001 a COB-0006)" camunda:historyTimeToLive="P3650D">
    <description>OMNI-ODONTO-COB-0001 a COB-0006 (e as classes de DUT em odonto_dut). Hit policy UNIQUE; nenhuma linha nega. Urgência ou emergência (caráter 2) libera antes de qualquer exigência; caráter nulo ou fora da TUSS 23 nunca vira exigência de documento ou glosa: vai à regulação ou à auditoria médica; declaração de imperativo clínico ausente em atendimento eletivo gera só a lista do que falta; honorários e materiais odontológicos seguem a segmentação odontológica e a estrutura hospitalar segue a hospitalar (RN 465, art. 19, IX e §1º, I); as classes com DUT têm a diretriz conferida na decisão odonto_dut; fechamento: data ausente vai à regulação.</description>
    <decisionTable id="dt_odonto_cobertura" hitPolicy="UNIQUE">
      <input id="in_0_dataAtendimento" label="dataAtendimento ← TISS dataSolicitacao (pedido) ou dataExecucao (conta), AAAA-MM-DD">
        <inputExpression id="ie_0_dataAtendimento" typeRef="string"><text>dataAtendimento</text></inputExpression>
      </input>
      <input id="in_1_classeProcedimento" label="classeProcedimento ← TISS codigoProcedimento (TUSS 22) classificado por regras/odontologia-hospitalar/dominio.yaml (classes)">
        <inputExpression id="ie_1_classeProcedimento" typeRef="string"><text>classeProcedimento</text></inputExpression>
      </input>
      <input id="in_2_caraterAtendimento" label="caraterAtendimento ← TISS caraterAtendimento (TUSS 23: 1 eletivo, 2 urgência ou emergência)">
        <inputExpression id="ie_2_caraterAtendimento" typeRef="string"><text>caraterAtendimento</text></inputExpression>
      </input>
      <input id="in_3_regime" label="regime ← TISS regimeInternacao ou regimeAtendimento (internacao, hospital_dia, ambulatorial ou pronto_socorro)">
        <inputExpression id="ie_3_regime" typeRef="string"><text>regime</text></inputExpression>
      </input>
      <input id="in_4_segmentacaoOdontologica" label="segmentacaoOdontologica ← cadastro do produto do beneficiário (booleano: o produto inclui a segmentação odontológica)">
        <inputExpression id="ie_4_segmentacaoOdontologica" typeRef="boolean"><text>segmentacaoOdontologica</text></inputExpression>
      </input>
      <input id="in_5_imperativoClinicoDeclarado" label="imperativoClinicoDeclarado ← solicitação: declaração do cirurgião-dentista ou do médico assistente anexa ao pedido, fora do TISS (booleano)">
        <inputExpression id="ie_5_imperativoClinicoDeclarado" typeRef="boolean"><text>imperativoClinicoDeclarado</text></inputExpression>
      </input>
      <input id="in_6_finalidadeImplanteDentario" label="finalidadeImplanteDentario ← solicitação: formulário do pedido, fora do TISS (booleano: o enxerto prepara implante dentário)">
        <inputExpression id="ie_6_finalidadeImplanteDentario" typeRef="boolean"><text>finalidadeImplanteDentario</text></inputExpression>
      </input>
      <output id="out_0_decisao" name="decisao" typeRef="string"/>
      <output id="out_1_motivoTab38" name="motivoTab38" typeRef="string"/>
      <output id="out_2_idRegra" name="idRegra" typeRef="string"/>
      <output id="out_3_fila" name="fila" typeRef="string"/>
      <output id="out_classeAdverso" name="classeAdverso" typeRef="string"/>
      <rule id="pre">
        <description>OMNI-ODONTO-COB-0004 — antes da vigência (03/12/2026): sem exigência</description>
        <inputEntry><text>&lt; "2026-12-03"</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"liberar"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-ODONTO-COB-0004"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
