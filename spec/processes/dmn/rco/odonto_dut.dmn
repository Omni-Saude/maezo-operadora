<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:camunda="http://camunda.org/schema/1.0/dmn" id="def_odonto_dut" name="Odontologia hospitalar: diretrizes de utilização 78 a 101 (DUT-0001 a DUT-0003)" namespace="https://omni-saude/dmn/odontologia-hospitalar">
  <decision id="rco_odonto_dut" name="Odontologia hospitalar: diretrizes de utilização 78 a 101 (DUT-0001 a DUT-0003)" camunda:historyTimeToLive="P3650D">
    <description>OMNI-ODONTO-DUT-0001, DUT-0002 e DUT-0003 (diretrizes 78 a 101 do Anexo II vigente). Hit policy UNIQUE; nenhuma linha nega. A diretriz recebe a declaração do cirurgião-dentista e não avalia mérito clínico: declaração presente libera; ausente em atendimento eletivo gera só a lista do que falta; declaração negativa ou sessões acima do mínimo vão à auditoria médica. Urgência ou emergência (caráter 2) libera antes de qualquer exigência; caráter, regime ou segmentação ausentes vão à regulação, nunca à exigência de documento nem à negativa; fechamento: data ausente vai à regulação.</description>
    <decisionTable id="dt_odonto_dut" hitPolicy="UNIQUE">
      <input id="in_0_dataAtendimento" label="dataAtendimento ← TISS dataSolicitacao (pedido) ou dataExecucao (conta), AAAA-MM-DD">
        <inputExpression id="ie_0_dataAtendimento" typeRef="string"><text>dataAtendimento</text></inputExpression>
      </input>
      <input id="in_1_classeProcedimento" label="classeProcedimento ← TISS codigoProcedimento (TUSS 22) classificado por regras/odontologia-hospitalar/dominio.yaml (classes)">
        <inputExpression id="ie_1_classeProcedimento" typeRef="string"><text>classeProcedimento</text></inputExpression>
      </input>
      <input id="in_2_codigoProcedimento" label="codigoProcedimento ← TISS codigoProcedimento (TUSS 22)">
        <inputExpression id="ie_2_codigoProcedimento" typeRef="string"><text>codigoProcedimento</text></inputExpression>
      </input>
      <input id="in_3_caraterAtendimento" label="caraterAtendimento ← TISS caraterAtendimento (TUSS 23: 1 eletivo, 2 urgência ou emergência)">
        <inputExpression id="ie_3_caraterAtendimento" typeRef="string"><text>caraterAtendimento</text></inputExpression>
      </input>
      <input id="in_4_regime" label="regime ← TISS regimeInternacao ou regimeAtendimento (internacao, hospital_dia, ambulatorial ou pronto_socorro)">
        <inputExpression id="ie_4_regime" typeRef="string"><text>regime</text></inputExpression>
      </input>
      <input id="in_5_segmentacaoOdontologica" label="segmentacaoOdontologica ← cadastro do produto do beneficiário (booleano: o produto inclui a segmentação odontológica)">
        <inputExpression id="ie_5_segmentacaoOdontologica" typeRef="boolean"><text>segmentacaoOdontologica</text></inputExpression>
      </input>
      <input id="in_6_indicacaoAmbulatorial" label="indicacaoAmbulatorial ← solicitação: declaração do cirurgião-dentista assistente no pedido, fora do TISS (booleano: o ambiente ambulatorial é possível)">
        <inputExpression id="ie_6_indicacaoAmbulatorial" typeRef="boolean"><text>indicacaoAmbulatorial</text></inputExpression>
      </input>
      <input id="in_7_declaracaoCriterioDut" label="declaracaoCriterioDut ← solicitação: declaração do cirurgião-dentista assistente no pedido, fora do TISS (booleano: o critério da diretriz está atendido)">
        <inputExpression id="ie_7_declaracaoCriterioDut" typeRef="boolean"><text>declaracaoCriterioDut</text></inputExpression>
      </input>
      <input id="in_8_finalidadeComDut" label="finalidadeComDut ← solicitação: formulário do pedido, fora do TISS, só em 84000171 e 85400599 (booleano: a finalidade é a que a diretriz alcança)">
        <inputExpression id="ie_8_finalidadeComDut" typeRef="boolean"><text>finalidadeComDut</text></inputExpression>
      </input>
      <input id="in_9_sessoesAnoContrato" label="sessoesAnoContrato ← cadastro: histórico de contas do beneficiário, sessões de condicionamento no ano de contrato até a sessão da guia (inteiro)">
        <inputExpression id="ie_9_sessoesAnoContrato" typeRef="integer"><text>sessoesAnoContrato</text></inputExpression>
      </input>
      <output id="out_0_decisao" name="decisao" typeRef="string"/>
      <output id="out_1_motivoTab38" name="motivoTab38" typeRef="string"/>
      <output id="out_2_idRegra" name="idRegra" typeRef="string"/>
      <output id="out_3_fila" name="fila" typeRef="string"/>
      <output id="out_classeAdverso" name="classeAdverso" typeRef="string"/>
      <rule id="pre">
        <description>OMNI-ODONTO-DUT-0001 — antes da vigência (03/12/2026): sem exigência</description>
        <inputEntry><text>&lt; "2026-12-03"</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
