<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:camunda="http://camunda.org/schema/1.0/dmn" id="def_oftalmo_autorizacao" name="Oftalmologia: autorização prévia da cirurgia eletiva; urgência sem autorização" namespace="https://omni-saude/dmn/oftalmologia">
  <decision id="rco_oftalmo_autorizacao" name="Oftalmologia: autorização prévia da cirurgia eletiva; urgência sem autorização" camunda:historyTimeToLive="P3650D">
    <description>OMNI-OFTALMO-AUT-0001 a OMNI-OFTALMO-AUT-0010. Hit policy UNIQUE; nenhuma linha nega ou glosa; eletivo (caráter 1) de código só hospitalar do Rol exige autorização; urgência ou emergência (caráter 2) libera (AUT-0009); caráter ausente ou fora da TUSS 23 vai à regulação; antiangiogênico e infusão intravítrea (30307139, 30307147, 30312140) exigem autorização só no início do esquema (inicioEsquema true), esquema em curso libera sem nova autorização e histórico ausente vai à regulação; fechamento null vai à revisão humana.</description>
    <decisionTable id="dt_oftalmo_autorizacao" hitPolicy="UNIQUE">
      <input id="in_0_dataAtendimento" label="dataAtendimento ← TISS dataSolicitacao (pedido) ou dataExecucao (conta), AAAA-MM-DD">
        <inputExpression id="ie_0_dataAtendimento" typeRef="string"><text>dataAtendimento</text></inputExpression>
      </input>
      <input id="in_1_codigoProcedimento" label="codigoProcedimento ← TISS codigoProcedimento (TUSS 22)">
        <inputExpression id="ie_1_codigoProcedimento" typeRef="string"><text>codigoProcedimento</text></inputExpression>
      </input>
      <input id="in_2_caraterAtendimento" label="caraterAtendimento ← TISS caraterAtendimento (TUSS 23: 1 eletivo, 2 urgência ou emergência)">
        <inputExpression id="ie_2_caraterAtendimento" typeRef="string"><text>caraterAtendimento</text></inputExpression>
      </input>
      <input id="in_3_inicioEsquema" label="inicioEsquema ← TISS (histórico de guias OMNI do mesmo código e beneficiário) ou solicitação (declaração de esquema novo no pedido)">
        <inputExpression id="ie_3_inicioEsquema" typeRef="boolean"><text>inicioEsquema</text></inputExpression>
      </input>
      <output id="out_0_decisao" name="decisao" typeRef="string"/>
      <output id="out_1_motivoTab38" name="motivoTab38" typeRef="string"/>
      <output id="out_2_idRegra" name="idRegra" typeRef="string"/>
      <output id="out_3_fila" name="fila" typeRef="string"/>
      <output id="out_classeAdverso" name="classeAdverso" typeRef="string"/>
      <rule id="a_pre">
        <description>OMNI-OFTALMO-AUT-0009 — antes da vigência (03/12/2026)</description>
        <inputEntry><text>&lt; "2026-12-03"</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"liberar"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-OFTALMO-AUT-0009"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="a0001_elet">
        <description>OMNI-OFTALMO-AUT-0001 — pedido eletivo: autorização prévia</description>
        <inputEntry><text>&gt;= "2026-12-03"</text></inputEntry>
        <inputEntry><text>"30303010", "30303079", "30303109"</text></inputEntry>
        <inputEntry><text>"1"</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"exigir_autorizacao"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-OFTALMO-AUT-0001"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
