<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:camunda="http://camunda.org/schema/1.0/dmn" id="def_oftalmo_dut" name="Oftalmologia: diretrizes de utilização 13, 15, 34, 46, 59, 66, 74, 121 e 149" namespace="https://omni-saude/dmn/oftalmologia">
  <decision id="rco_oftalmo_dut" name="Oftalmologia: diretrizes de utilização 13, 15, 34, 46, 59, 66, 74, 121 e 149" camunda:historyTimeToLive="P3650D">
    <description>OMNI-OFTALMO-DUT-0002, 0003, 0005, 0007 e 0008. Hit policy UNIQUE; nenhuma linha nega; a exigência de documento vale só para caráter 1 (eletivo); urgência ou emergência (caráter 2) é liberada por OMNI-OFTALMO-AUT-0009 e caráter ausente vai à regulação; documentação incompleta gera a lista do que falta; o enquadramento clínico vai à auditoria médica; na DUT 74 (30307139, 30307147, 30312140) a documentação vale só no início do esquema (inicioEsquema true), o esquema em curso libera e o histórico ausente vai à auditoria; fechamento null vai à revisão humana.</description>
    <decisionTable id="dt_oftalmo_dut" hitPolicy="UNIQUE">
      <input id="in_0_dataAtendimento" label="dataAtendimento ← TISS dataSolicitacao (pedido) ou dataExecucao (conta), AAAA-MM-DD">
        <inputExpression id="ie_0_dataAtendimento" typeRef="string"><text>dataAtendimento</text></inputExpression>
      </input>
      <input id="in_1_codigoProcedimento" label="codigoProcedimento ← TISS codigoProcedimento (TUSS 22)">
        <inputExpression id="ie_1_codigoProcedimento" typeRef="string"><text>codigoProcedimento</text></inputExpression>
      </input>
      <input id="in_2_documentacaoCompleta" label="documentacaoCompleta ← solicitação: relatório e exames da DUT anexados (anexo da guia TISS)">
        <inputExpression id="ie_2_documentacaoCompleta" typeRef="boolean"><text>documentacaoCompleta</text></inputExpression>
      </input>
      <input id="in_3_caraterAtendimento" label="caraterAtendimento ← TISS caraterAtendimento (TUSS 23: 1 eletivo, 2 urgência ou emergência)">
        <inputExpression id="ie_3_caraterAtendimento" typeRef="string"><text>caraterAtendimento</text></inputExpression>
      </input>
      <input id="in_4_inicioEsquema" label="inicioEsquema ← TISS (histórico de guias OMNI do mesmo código e beneficiário) ou solicitação (declaração de esquema novo no pedido)">
        <inputExpression id="ie_4_inicioEsquema" typeRef="boolean"><text>inicioEsquema</text></inputExpression>
      </input>
      <output id="out_0_decisao" name="decisao" typeRef="string"/>
      <output id="out_1_motivoTab38" name="motivoTab38" typeRef="string"/>
      <output id="out_2_idRegra" name="idRegra" typeRef="string"/>
      <output id="out_3_fila" name="fila" typeRef="string"/>
      <output id="out_classeAdverso" name="classeAdverso" typeRef="string"/>
      <rule id="d_pre">
        <description>OMNI-OFTALMO-DUT-0002 — antes da vigência (03/12/2026)</description>
        <inputEntry><text>&lt; "2026-12-03"</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"liberar"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-OFTALMO-AUT-0009"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="d0002_falta">
        <description>OMNI-OFTALMO-DUT-0002 — documentação incompleta: lista objetiva do que falta (RN 623, art. 12, §6º)</description>
