        <inputEntry><text>"30304083", "30304091", "30304105", "30304156"</text></inputEntry>
        <inputEntry><text>false</text></inputEntry>
        <inputEntry><text>"1"</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"exigir_documento"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-OFTALMO-DUT-0002"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="d0002_ok">
        <description>OMNI-OFTALMO-DUT-0002 — documentação completa: auditoria confere o enquadramento na DUT</description>
