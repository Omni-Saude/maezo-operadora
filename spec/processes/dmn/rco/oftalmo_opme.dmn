<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:camunda="http://camunda.org/schema/1.0/dmn" id="def_oftalmo_opme" name="Oftalmologia: OPME por lista positiva e quantidade máxima por ato" namespace="https://omni-saude/dmn/oftalmologia">
  <decision id="rco_oftalmo_opme" name="Oftalmologia: OPME por lista positiva e quantidade máxima por ato" camunda:historyTimeToLive="P3650D">
    <description>OMNI-OFTALMO-OPM-0001. Hit policy UNIQUE; nenhuma linha nega ou glosa; categoria da lista positiva do procedimento dentro da quantidade máxima por ato (parâmetros provisórios) é liberada; acima da quantidade, fora da lista ou sem categoria vai à auditoria médica; quantidade nula vai ao faturamento; na urgência vale OMNI-URG-OPM-0001; fechamento null vai à revisão humana.</description>
    <decisionTable id="dt_oftalmo_opme" hitPolicy="UNIQUE">
      <input id="in_0_dataAtendimento" label="dataAtendimento ← TISS dataSolicitacao (pedido) ou dataExecucao (conta), AAAA-MM-DD">
        <inputExpression id="ie_0_dataAtendimento" typeRef="string"><text>dataAtendimento</text></inputExpression>
      </input>
      <input id="in_1_codigoProcedimento" label="codigoProcedimento ← TISS codigoProcedimento (TUSS 22)">
        <inputExpression id="ie_1_codigoProcedimento" typeRef="string"><text>codigoProcedimento</text></inputExpression>
      </input>
      <input id="in_2_categoriaOpme" label="categoriaOpme ← TISS codigoItem (TUSS 19) do anexo de OPME classificado pelo cadastro OMNI de materiais; sem correspondência vai nulo">
        <inputExpression id="ie_2_categoriaOpme" typeRef="string"><text>categoriaOpme</text></inputExpression>
      </input>
      <input id="in_3_quantidade" label="quantidade ← TISS quantidadeExecutada do código (ou da categoria de OPME) na mesma guia e dataExecucao">
        <inputExpression id="ie_3_quantidade" typeRef="integer"><text>quantidade</text></inputExpression>
      </input>
      <output id="out_0_decisao" name="decisao" typeRef="string"/>
      <output id="out_1_motivoTab38" name="motivoTab38" typeRef="string"/>
      <output id="out_2_idRegra" name="idRegra" typeRef="string"/>
      <output id="out_3_fila" name="fila" typeRef="string"/>
      <output id="out_classeAdverso" name="classeAdverso" typeRef="string"/>
      <rule id="p_pre">
        <description>OMNI-OFTALMO-OPM-0001 — antes da vigência (03/12/2026)</description>
        <inputEntry><text>&lt; "2026-12-03"</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"liberar"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-OFTALMO-OPM-0001"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="p1_peso_palpebral_ok">
        <description>OMNI-OFTALMO-OPM-0001 — peso_palpebral dentro da quantidade da lista positiva do procedimento</description>
        <inputEntry><text>&gt;= "2026-12-03"</text></inputEntry>
        <inputEntry><text>"30301181"</text></inputEntry>
        <inputEntry><text>"peso_palpebral"</text></inputEntry>
        <inputEntry><text>[1..1]</text></inputEntry>
        <outputEntry><text>"liberar"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-OFTALMO-OPM-0001"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="p1_peso_palpebral_acima">
        <description>OMNI-OFTALMO-OPM-0001 — peso_palpebral acima da quantidade da lista positiva: auditoria médica, sem glosa automática</description>
        <inputEntry><text>&gt;= "2026-12-03"</text></inputEntry>
        <inputEntry><text>"30301181"</text></inputEntry>
        <inputEntry><text>"peso_palpebral"</text></inputEntry>
        <inputEntry><text>&gt; 1</text></inputEntry>
        <outputEntry><text>"revisao_humana"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-OFTALMO-OPM-0001"</text></outputEntry>
        <outputEntry><text>"auditoria_medica"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="p1_peso_palpebral_qtd">
        <description>OMNI-OFTALMO-OPM-0001 — peso_palpebral com quantidade não informada ou inválida: faturamento confere, nunca nega</description>
        <inputEntry><text>&gt;= "2026-12-03"</text></inputEntry>
        <inputEntry><text>"30301181"</text></inputEntry>
        <inputEntry><text>"peso_palpebral"</text></inputEntry>
        <inputEntry><text>null, &lt; 1</text></inputEntry>
        <outputEntry><text>"revisao_humana"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-OFTALMO-OPM-0001"</text></outputEntry>
        <outputEntry><text>"faturamento"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="p1_fora">
        <description>OMNI-OFTALMO-OPM-0001 — item fora da lista positiva do procedimento, ou sem categoria no cadastro: auditoria médica</description>
