        <description>OMNI-OFTALMO-OPM-0001 — implante_drenagem_glaucoma acima da quantidade da lista positiva: auditoria médica, sem glosa automática</description>
        <inputEntry><text>&gt;= "2026-12-03"</text></inputEntry>
        <inputEntry><text>"30310040"</text></inputEntry>
        <inputEntry><text>"implante_drenagem_glaucoma"</text></inputEntry>
        <inputEntry><text>&gt; 1</text></inputEntry>
        <outputEntry><text>"revisao_humana"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-OFTALMO-OPM-0001"</text></outputEntry>
        <outputEntry><text>"auditoria_medica"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="p7_implante_drenagem_glaucoma_qtd">
        <description>OMNI-OFTALMO-OPM-0001 — implante_drenagem_glaucoma com quantidade não informada ou inválida: faturamento confere, nunca nega</description>
        <inputEntry><text>&gt;= "2026-12-03"</text></inputEntry>
        <inputEntry><text>"30310040"</text></inputEntry>
        <inputEntry><text>"implante_drenagem_glaucoma"</text></inputEntry>
        <inputEntry><text>null, &lt; 1</text></inputEntry>
        <outputEntry><text>"revisao_humana"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-OFTALMO-OPM-0001"</text></outputEntry>
        <outputEntry><text>"faturamento"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="p7_substancia_viscoelastica_ok">
        <description>OMNI-OFTALMO-OPM-0001 — substancia_viscoelastica dentro da quantidade da lista positiva do procedimento</description>
        <inputEntry><text>&gt;= "2026-12-03"</text></inputEntry>
        <inputEntry><text>"30310040"</text></inputEntry>
        <inputEntry><text>"substancia_viscoelastica"</text></inputEntry>
        <inputEntry><text>[1..1]</text></inputEntry>
        <outputEntry><text>"liberar"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-OFTALMO-OPM-0001"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="p7_substancia_viscoelastica_acima">
        <description>OMNI-OFTALMO-OPM-0001 — substancia_viscoelastica acima da quantidade da lista positiva: auditoria médica, sem glosa automática</description>
        <inputEntry><text>&gt;= "2026-12-03"</text></inputEntry>
        <inputEntry><text>"30310040"</text></inputEntry>
        <inputEntry><text>"substancia_viscoelastica"</text></inputEntry>
        <inputEntry><text>&gt; 1</text></inputEntry>
        <outputEntry><text>"revisao_humana"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-OFTALMO-OPM-0001"</text></outputEntry>
        <outputEntry><text>"auditoria_medica"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="p7_substancia_viscoelastica_qtd">
        <description>OMNI-OFTALMO-OPM-0001 — substancia_viscoelastica com quantidade não informada ou inválida: faturamento confere, nunca nega</description>
        <inputEntry><text>&gt;= "2026-12-03"</text></inputEntry>
        <inputEntry><text>"30310040"</text></inputEntry>
        <inputEntry><text>"substancia_viscoelastica"</text></inputEntry>
        <inputEntry><text>null, &lt; 1</text></inputEntry>
        <outputEntry><text>"revisao_humana"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-OFTALMO-OPM-0001"</text></outputEntry>
        <outputEntry><text>"faturamento"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="p7_fora">
        <description>OMNI-OFTALMO-OPM-0001 — item fora da lista positiva do procedimento, ou sem categoria no cadastro: auditoria médica</description>
        <inputEntry><text>&gt;= "2026-12-03"</text></inputEntry>
        <inputEntry><text>"30310040"</text></inputEntry>
        <inputEntry><text>not("implante_drenagem_glaucoma", "substancia_viscoelastica")</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"revisao_humana"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-OFTALMO-OPM-0001"</text></outputEntry>
        <outputEntry><text>"auditoria_medica"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="p_resto">
        <description>OMNI-OFTALMO-OPM-0001 — código sem OPME na lista do domínio: sem conferência</description>
        <inputEntry><text>&gt;= "2026-12-03"</text></inputEntry>
        <inputEntry><text>not("30301181", "30303060", "30304083", "30306027", "30306035", "30306043", "30309018", "30310040")</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"liberar"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-OFTALMO-OPM-0001"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="p_sem_data">
        <description>OMNI-OFTALMO-OPM-0001 — data ausente: regulação confere, nunca nega</description>
        <inputEntry><text>null</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
