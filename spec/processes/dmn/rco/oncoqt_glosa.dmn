<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:camunda="http://camunda.org/schema/1.0/dmn" id="def_oncoqt_glosa" name="Oncologia: hormonioterapia e bisfosfonato isolados" namespace="https://omni-saude/dmn/oncologia-terapia-sistemica">
  <decision id="rco_oncoqt_glosa" name="Oncologia: hormonioterapia e bisfosfonato isolados" camunda:historyTimeToLive="P3650D">
    <description>Oncologia: hormonioterapia e bisfosfonato isolados. Nenhuma linha nega ou glosa; dado ausente vai à revisão humana ou segue sem efeito.</description>
    <decisionTable id="dt_oncoqt_glosa" hitPolicy="UNIQUE">
      <input id="in_0_dataAtendimento" label="dataAtendimento ← TISS dataSolicitacao (pedido) ou dataExecucao (conta), AAAA-MM-DD">
        <inputExpression id="ie_0_dataAtendimento" typeRef="string"><text>dataAtendimento</text></inputExpression>
      </input>
      <input id="in_1_temaOncoqt" label="temaOncoqt ← TISS codigoProcedimento (TUSS 22) ou item de medicamento (TUSS 20) e solicitação (formulário), pela lista temas_dmn de regras/oncologia-terapia-sistemica/dominio.yaml">
        <inputExpression id="ie_1_temaOncoqt" typeRef="string"><text>temaOncoqt</text></inputExpression>
      </input>
      <input id="in_2_sinalConta" label="sinalConta ← TISS (conta e histórico de guias OMNI: condição da regra do tema presente)">
        <inputExpression id="ie_2_sinalConta" typeRef="boolean"><text>sinalConta</text></inputExpression>
      </input>
      <output id="out_0_decisao" name="decisao" typeRef="string"/>
      <output id="out_1_motivoTab38" name="motivoTab38" typeRef="string"/>
      <output id="out_2_idRegra" name="idRegra" typeRef="string"/>
      <output id="out_3_fila" name="fila" typeRef="string"/>
      <output id="out_classeAdverso" name="classeAdverso" typeRef="string"/>
      <rule id="glo0001_pre">
        <description>Antes da vigência: sem exigência nova</description>
        <inputEntry><text>&lt; "2026-12-03"</text></inputEntry>
        <inputEntry><text>"tema_terapia_oncologica"</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"liberar"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-ONCOQT-GLO-0001"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="glo0001_sem_data">
        <description>Data ausente: conferência humana</description>
        <inputEntry><text>null</text></inputEntry>
        <inputEntry><text>"tema_terapia_oncologica"</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"revisao_humana"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-ONCOQT-GLO-0001"</text></outputEntry>
        <outputEntry><text>"faturamento"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="glo0001_sinal">
        <description>Condição da regra presente: revisão humana, sem glosa</description>
        <inputEntry><text>&gt;= "2026-12-03"</text></inputEntry>
        <inputEntry><text>"tema_terapia_oncologica"</text></inputEntry>
        <inputEntry><text>true</text></inputEntry>
        <outputEntry><text>"revisao_humana"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-ONCOQT-GLO-0001"</text></outputEntry>
        <outputEntry><text>"faturamento"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="glo0001_sem_sinal">
        <description>Condição ausente ou histórico ausente: sem efeito</description>
        <inputEntry><text>&gt;= "2026-12-03"</text></inputEntry>
        <inputEntry><text>"tema_terapia_oncologica"</text></inputEntry>
        <inputEntry><text>false, null</text></inputEntry>
        <outputEntry><text>"liberar"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-ONCOQT-GLO-0001"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="fechamento">
        <description>Fechamento: tema fora desta tabela, sem efeito</description>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>not("tema_terapia_oncologica")</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"liberar"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-ONCOQT-GLO-0001"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
</definitions>
