      </rule>
      <rule id="fechamento">
        <description>Fechamento: tema fora desta tabela, sem efeito</description>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>not("quimioterapia_sistemica", "tema_biomarcador_exigido", "tema_regime_por_indicacao", "tema_biopsia_tumoral", "tema_medicamentos_e_testes", "transplante_medula_ossea", "biomarcador_bcr_abl", "biomarcador_braf", "biomarcador_flt3", "biomarcador_msi", "medicamento_rituximabe", "medicamento_lenalidomida", "medicamento_pembrolizumabe", "medicamento_trastuzumabe", "medicamento_bevacizumabe", "medicamento_bortezomibe", "medicamento_cabozantinibe", "medicamento_daratumumabe", "medicamento_ibrutinibe", "medicamento_imatinibe", "medicamento_lorlatinibe", "medicamento_niraparibe", "medicamento_nivolumabe", "medicamento_osimertinibe", "medicamento_regorafenibe", "medicamento_venetoclax")</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"liberar"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-ONCOQT-LIM-0001"</text></outputEntry>
