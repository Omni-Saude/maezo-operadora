      <rule id="lim0026_sinal_nulo">
        <description>Conferência não calculada (sinalConta nulo: falta a prescrição ou a checagem que permite conferir a quantidade): auditoria de faturamento, sem glosa (OPO-16 (OPME-31))</description>
        <inputEntry><text>&gt;= "2026-12-16"</text></inputEntry>
        <inputEntry><text>"medicamento_venetoclax"</text></inputEntry>
        <inputEntry><text>null</text></inputEntry>
