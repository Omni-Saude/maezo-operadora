<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:camunda="http://camunda.org/schema/1.0/dmn" id="def_oncoqt_limite_quantidade" name="Oncologia: edições de quantidade, ciclo e repetição" namespace="https://omni-saude/dmn/oncologia-terapia-sistemica">
  <decision id="rco_oncoqt_limite_quantidade" name="Oncologia: edições de quantidade, ciclo e repetição" camunda:historyTimeToLive="P3650D">
    <description>Oncologia: edições de quantidade, ciclo e repetição. Nenhuma linha nega ou glosa; dado ausente vai à revisão humana ou segue sem efeito. Nas regras de pagamento pela dose administrada e de fornecimento por ciclo (OMNI-ONCOQT-LIM-0005 e LIM-0011 a LIM-0026), sinalConta nulo (conferência não calculada) vai à auditoria de faturamento, sem glosa; só false segue sem efeito (OPO-16, decisão PROG-MEL-2-ONCOQT-01).</description>
    <decisionTable id="dt_oncoqt_limite_quantidade" hitPolicy="UNIQUE">
      <input id="in_0_dataAtendimento" label="dataAtendimento ← TISS dataSolicitacao (pedido) ou dataExecucao (conta), AAAA-MM-DD">
        <inputExpression id="ie_0_dataAtendimento" typeRef="string"><text>dataAtendimento</text></inputExpression>
      </input>
      <input id="in_1_temaOncoqt" label="temaOncoqt ← TISS codigoProcedimento (TUSS 22) ou item de medicamento (TUSS 20) e solicitação (formulário), pela lista temas_dmn de regras/oncologia-terapia-sistemica/dominio.yaml">
        <inputExpression id="ie_1_temaOncoqt" typeRef="string"><text>temaOncoqt</text></inputExpression>
      </input>
      <input id="in_2_sinalConta" label="sinalConta ← TISS (conta e histórico de guias OMNI: condição da regra do tema presente)">
        <inputExpression id="ie_2_sinalConta" typeRef="boolean"><text>sinalConta</text></inputExpression>
      </input>
      <output id="out_0_decisao" name="decisao" typeRef="string"/>
      <output id="out_1_motivoTab38" name="motivoTab38" typeRef="string"/>
      <output id="out_2_idRegra" name="idRegra" typeRef="string"/>
      <output id="out_3_fila" name="fila" typeRef="string"/>
      <output id="out_classeAdverso" name="classeAdverso" typeRef="string"/>
      <rule id="lim0001_pre">
        <description>Antes da vigência: sem exigência nova</description>
        <inputEntry><text>&lt; "2026-12-03"</text></inputEntry>
        <inputEntry><text>"quimioterapia_sistemica"</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"liberar"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-ONCOQT-LIM-0001"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="lim0001_sem_data">
        <description>Data ausente: conferência humana</description>
        <inputEntry><text>null</text></inputEntry>
        <inputEntry><text>"quimioterapia_sistemica"</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"revisao_humana"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-ONCOQT-LIM-0001"</text></outputEntry>
        <outputEntry><text>"faturamento"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="lim0001_sinal">
