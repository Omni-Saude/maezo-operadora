      </rule>
      <rule id="lim0026_sinal">
        <description>Condição da regra presente: revisão humana, sem glosa</description>
        <inputEntry><text>&gt;= "2026-12-16"</text></inputEntry>
        <inputEntry><text>"medicamento_venetoclax"</text></inputEntry>
        <inputEntry><text>true</text></inputEntry>
        <outputEntry><text>"revisao_humana"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-ONCOQT-LIM-0026"</text></outputEntry>
        <outputEntry><text>"faturamento"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="lim0026_sem_sinal">
        <description>Condição conferida e ausente (false): sem efeito</description>
        <inputEntry><text>&gt;= "2026-12-16"</text></inputEntry>
        <inputEntry><text>"medicamento_venetoclax"</text></inputEntry>
        <inputEntry><text>false</text></inputEntry>
        <outputEntry><text>"liberar"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-ONCOQT-LIM-0026"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
