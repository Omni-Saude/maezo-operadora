<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:camunda="http://camunda.org/schema/1.0/dmn" id="def_opme_lista_orl" name="ORL: lista positiva de OPME e instrumentos de corte (OMNI-ORL-OPM-0001 e 0002)" namespace="https://omni-saude/dmn/otorrino-cabeca-pescoco">
  <decision id="rco_opme_lista_orl" name="ORL: lista positiva de OPME e instrumentos de corte (OMNI-ORL-OPM-0001 e 0002)" camunda:historyTimeToLive="P3650D">
    <description>Confere categoria e quantidade de OPME, fresas e brocas contra o procedimento. Quantidade acima da lista e material fora da lista vão à auditoria médica, e a divergência à junta médica (ANS-RN-424); nunca nega. OMNI-ORL-OPM-0001 e OMNI-ORL-OPM-0002.</description>
    <decisionTable id="dt_opme_lista_orl" hitPolicy="UNIQUE">
      <input id="in_0_dataAtendimento" label="dataAtendimento ← TISS dataSolicitacao (pedido) ou dataExecucao (conta), AAAA-MM-DD">
        <inputExpression id="ie_0_dataAtendimento" typeRef="string"><text>dataAtendimento</text></inputExpression>
      </input>
      <input id="in_1_familiaProcedimento" label="familiaProcedimento ← TISS codigoProcedimento principal (TUSS 22) classificado por dominio.yaml (familias_opme)">
        <inputExpression id="ie_1_familiaProcedimento" typeRef="string"><text>familiaProcedimento</text></inputExpression>
      </input>
      <input id="in_2_categoriaOpme" label="categoriaOpme ← cadastro OMNI de materiais: categoria do item TISS codigoMaterial (TUSS 19)">
        <inputExpression id="ie_2_categoriaOpme" typeRef="string"><text>categoriaOpme</text></inputExpression>
      </input>
      <input id="in_3_quantidade" label="quantidade ← TISS quantidadeSolicitada/quantidadeExecutada do item">
        <inputExpression id="ie_3_quantidade" typeRef="integer"><text>quantidade</text></inputExpression>
      </input>
      <output id="out_decisao" name="decisao" typeRef="string"/>
      <output id="out_motivoTab38" name="motivoTab38" typeRef="string"/>
      <output id="out_idRegra" name="idRegra" typeRef="string"/>
      <output id="out_fila" name="fila" typeRef="string"/>
      <output id="out_classeAdverso" name="classeAdverso" typeRef="string"/>
      <rule id="o_pre">
        <description>OMNI-ORL-OPM-0001 — fora da vigência (antes de 02/12/2026): sem conferência automática</description>
        <inputEntry><text>&lt; "2026-12-02"</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"liberar"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-ORL-OPM-0001"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="o_disp">
        <description>OMNI-ORL-OPM-0001 — material dispensado de autorização (fio, cânula de traqueostomia)</description>
        <inputEntry><text>&gt;= "2026-12-02"</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>"fio_cirurgico","canula_traqueostomia"</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"liberar"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-ORL-OPM-0001"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="o_IC_unidade_interna_implante_coclear_ok">
        <description>OMNI-ORL-OPM-0001 — IC: unidade_interna_implante_coclear até 1</description>
        <inputEntry><text>&gt;= "2026-12-02"</text></inputEntry>
        <inputEntry><text>"IC"</text></inputEntry>
        <inputEntry><text>"unidade_interna_implante_coclear"</text></inputEntry>
        <inputEntry><text>&lt;= 1</text></inputEntry>
        <outputEntry><text>"liberar"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-ORL-OPM-0001"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
