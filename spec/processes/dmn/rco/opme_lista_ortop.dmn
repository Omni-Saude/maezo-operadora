<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:camunda="http://camunda.org/schema/1.0/dmn" id="def_opme_lista_ortop" name="Lista positiva de OPME por procedimento ortopédico (OMNI-ORTOP-OPM-0001 a 0003)" namespace="https://omni-saude/dmn/ortopedia-opme">
  <decision id="rco_opme_lista_ortop" name="Lista positiva de OPME por procedimento ortopédico (OMNI-ORTOP-OPM-0001 a 0003)" camunda:historyTimeToLive="P180D">
    <description>Confere categoria e quantidade de OPME e instrumentos de corte contra o procedimento. OMNI-ORTOP-OPM-0001, OMNI-ORTOP-OPM-0002, OMNI-ORTOP-OPM-0003.</description>
    <decisionTable id="dt_opme_lista_ortop" hitPolicy="UNIQUE">
      <input id="in_0_dataExecucao" label="dataExecucao ← TISS dataExecucao/dataRealizacao (inteiro AAAAMMDD)">
        <inputExpression id="ie_0_dataExecucao" typeRef="integer"><text>dataExecucao</text></inputExpression>
      </input>
      <input id="in_1_familiaProcedimento" label="familiaProcedimento ← TISS codigoProcedimento principal (TUSS 22) classificado por dominio.yaml (familias_opme)">
        <inputExpression id="ie_1_familiaProcedimento" typeRef="string"><text>familiaProcedimento</text></inputExpression>
      </input>
      <input id="in_2_categoriaOpme" label="categoriaOpme ← cadastro OMNI de materiais: categoria do item TISS codigoMaterial (TUSS 19)">
        <inputExpression id="ie_2_categoriaOpme" typeRef="string"><text>categoriaOpme</text></inputExpression>
      </input>
      <input id="in_3_quantidade" label="quantidade ← TISS quantidadeSolicitada/quantidadeExecutada do item">
        <inputExpression id="ie_3_quantidade" typeRef="integer"><text>quantidade</text></inputExpression>
      </input>
      <output id="out_decisao" name="decisao" typeRef="string"/>
      <output id="out_motivoTab38" name="motivoTab38" typeRef="string"/>
      <output id="out_idRegra" name="idRegra" typeRef="string"/>
      <output id="out_fila" name="fila" typeRef="string"/>
      <output id="out_classeAdverso" name="classeAdverso" typeRef="string"/>
      <rule id="r000">
        <description>OMNI-ORTOP-OPM-0001 — ATQ: haste_femoral até 1</description>
        <inputEntry><text>&gt;= 20261103</text></inputEntry>
        <inputEntry><text>"ATQ"</text></inputEntry>
        <inputEntry><text>"haste_femoral"</text></inputEntry>
        <inputEntry><text>&lt;= 1</text></inputEntry>
        <outputEntry><text>"liberar"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-ORTOP-OPM-0001"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="r001">
        <description>OMNI-ORTOP-OPM-0001 — ATQ: haste_femoral acima de 1 (justificativa técnica)</description>
