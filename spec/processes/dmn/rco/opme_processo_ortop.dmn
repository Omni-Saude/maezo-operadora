<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:camunda="http://camunda.org/schema/1.0/dmn" id="def_opme_processo_ortop" name="Processo de OPME em ortopedia: marcas, autorização, prova de uso e urgência (OMNI-ORTOP-OPM-0004 a 0007)" namespace="https://omni-saude/dmn/ortopedia-opme">
  <decision id="rco_opme_processo_ortop" name="Processo de OPME em ortopedia: marcas, autorização, prova de uso e urgência (OMNI-ORTOP-OPM-0004 a 0007)" camunda:historyTimeToLive="P180D">
    <description>Pedido de OPME eletiva com três marcas, cobrança sem autorização, etiqueta de rastreabilidade e comunicação de OPME de urgência. OMNI-ORTOP-OPM-0004 a OMNI-ORTOP-OPM-0007.</description>
    <decisionTable id="dt_opme_processo_ortop" hitPolicy="UNIQUE">
      <input id="in_0_dataExecucao" label="dataExecucao ← TISS dataExecucao/dataRealizacao (inteiro AAAAMMDD)">
        <inputExpression id="ie_0_dataExecucao" typeRef="integer"><text>dataExecucao</text></inputExpression>
      </input>
      <input id="in_1_etapa" label="etapa ← fluxo Camunda (solicitacao | conta)">
        <inputExpression id="ie_1_etapa" typeRef="string"><text>etapa</text></inputExpression>
      </input>
      <input id="in_2_caraterAtendimento" label="caraterAtendimento ← TISS caraterAtendimento (TUSS 23)">
        <inputExpression id="ie_2_caraterAtendimento" typeRef="string"><text>caraterAtendimento</text></inputExpression>
      </input>
      <input id="in_3_quantidadeMarcasIndicadas" label="quantidadeMarcasIndicadas ← TISS anexo de OPME: fabricantes distintos com registro Anvisa">
        <inputExpression id="ie_3_quantidadeMarcasIndicadas" typeRef="integer"><text>quantidadeMarcasIndicadas</text></inputExpression>
      </input>
      <input id="in_4_opmeAutorizada" label="opmeAutorizada ← TISS senha/autorização do item de OPME (booleano)">
        <inputExpression id="ie_4_opmeAutorizada" typeRef="boolean"><text>opmeAutorizada</text></inputExpression>
      </input>
      <input id="in_5_etiquetaRastreabilidade" label="etiquetaRastreabilidade ← anexo da conta: etiqueta do implante enviada (booleano)">
        <inputExpression id="ie_5_etiquetaRastreabilidade" typeRef="boolean"><text>etiquetaRastreabilidade</text></inputExpression>
      </input>
      <input id="in_6_diasUteisComunicacao" label="diasUteisComunicacao ← dias úteis entre TISS dataExecucao e a comunicação da OPME de urgência">
        <inputExpression id="ie_6_diasUteisComunicacao" typeRef="integer"><text>diasUteisComunicacao</text></inputExpression>
      </input>
      <input id="in_7_opmeNaConta" label="opmeNaConta ← TISS outrasDespesas/despesa/codigoDespesa = 08 (OPME, TUSS 25) ou item com codigoTabela 19 na conta (booleano)">
        <inputExpression id="ie_7_opmeNaConta" typeRef="boolean"><text>opmeNaConta</text></inputExpression>
      </input>
      <input id="in_8_prazoComprovacaoUsoVencido" label="prazoComprovacaoUsoVencido ← cálculo do worker sobre a guia TISS (dataFinalFaturamento ou dataExecucao) e o anexo da conta: passou o prazo de envio da conta (OMNI-GERAL-GLO-0002, condicoes.periodo_dias) sem a comprovação de uso da OPME (booleano)">
        <inputExpression id="ie_8_prazoComprovacaoUsoVencido" typeRef="boolean"><text>prazoComprovacaoUsoVencido</text></inputExpression>
      </input>
      <output id="out_decisao" name="decisao" typeRef="string"/>
      <output id="out_motivoTab38" name="motivoTab38" typeRef="string"/>
      <output id="out_idRegra" name="idRegra" typeRef="string"/>
      <output id="out_fila" name="fila" typeRef="string"/>
      <output id="out_classeAdverso" name="classeAdverso" typeRef="string"/>
      <rule id="r000">
        <description>OMNI-ORTOP-OPM-0004 — pedido eletivo com três marcas: segue à análise no prazo</description>
        <inputEntry><text>&gt;= 20261103</text></inputEntry>
        <inputEntry><text>"solicitacao"</text></inputEntry>
        <inputEntry><text>"1"</text></inputEntry>
        <inputEntry><text>&gt;= 3</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"exigir_autorizacao"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-ORTOP-OPM-0004"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="r001">
        <description>OMNI-ORTOP-OPM-0004 — pedido eletivo com menos de três marcas: junta médica (RN 424, art. 7º)</description>
        <inputEntry><text>&gt;= 20261103</text></inputEntry>
        <inputEntry><text>"solicitacao"</text></inputEntry>
        <inputEntry><text>"1"</text></inputEntry>
        <inputEntry><text>&lt; 3</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"revisao_humana"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-ORTOP-OPM-0004"</text></outputEntry>
        <outputEntry><text>"junta_medica"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="r002">
        <description>OMNI-ORTOP-OPM-0004 — pedido eletivo sem marcas informadas: junta médica</description>
        <inputEntry><text>&gt;= 20261103</text></inputEntry>
        <inputEntry><text>"solicitacao"</text></inputEntry>
        <inputEntry><text>"1"</text></inputEntry>
        <inputEntry><text>null</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"revisao_humana"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-ORTOP-OPM-0004"</text></outputEntry>
        <outputEntry><text>"junta_medica"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="r003">
        <description>OMNI-ORTOP-OPM-0007 — urgência: OPME sem autorização prévia nem junta; comunicação posterior e pagamento pela referência (OMNI-URG-OPM-0001)</description>
        <inputEntry><text>&gt;= 20261103</text></inputEntry>
        <inputEntry><text>"solicitacao"</text></inputEntry>
        <inputEntry><text>"2"</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"liberar"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-ORTOP-OPM-0007"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="r004">
        <description>OMNI-ORTOP-OPM-0004 — caráter ausente ou inválido</description>
        <inputEntry><text>&gt;= 20261103</text></inputEntry>
        <inputEntry><text>"solicitacao"</text></inputEntry>
        <inputEntry><text>not("1","2")</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"revisao_humana"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-ORTOP-OPM-0004"</text></outputEntry>
        <outputEntry><text>"regulacao"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="r005">
        <description>OMNI-ORTOP-OPM-0006 — eletivo autorizado com etiqueta de rastreabilidade</description>
        <inputEntry><text>&gt;= 20261103</text></inputEntry>
        <inputEntry><text>"conta"</text></inputEntry>
        <inputEntry><text>"1"</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>true</text></inputEntry>
        <inputEntry><text>true</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>true</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"liberar"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-ORTOP-OPM-0006"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="r006">
        <description>OMNI-ORTOP-OPM-0006 — eletivo autorizado sem etiqueta de rastreabilidade: glosa do item de OPME (prova de uso)</description>
        <inputEntry><text>&gt;= 20261103</text></inputEntry>
        <inputEntry><text>"conta"</text></inputEntry>
        <inputEntry><text>"1"</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>true</text></inputEntry>
        <inputEntry><text>false</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>true</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"glosar"</text></outputEntry>
        <outputEntry><text>"3263"</text></outputEntry>
        <outputEntry><text>"OMNI-ORTOP-OPM-0006"</text></outputEntry>
        <outputEntry><text>"faturamento"</text></outputEntry>
        <outputEntry><text>"contas"</text></outputEntry>
      </rule>
      <rule id="r007">
        <description>OMNI-ORTOP-OPM-0006 — eletivo autorizado com etiqueta não extraída (nula): pedir a etiqueta (3263) antes de glosar</description>
        <inputEntry><text>&gt;= 20261103</text></inputEntry>
        <inputEntry><text>"conta"</text></inputEntry>
        <inputEntry><text>"1"</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>true</text></inputEntry>
        <inputEntry><text>null</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>true</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"exigir_documento"</text></outputEntry>
        <outputEntry><text>"3263"</text></outputEntry>
        <outputEntry><text>"OMNI-ORTOP-OPM-0006"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="r008">
        <description>OMNI-ORTOP-OPM-0005 — OPME eletiva cobrada sem autorização prévia</description>
        <inputEntry><text>&gt;= 20261103</text></inputEntry>
        <inputEntry><text>"conta"</text></inputEntry>
        <inputEntry><text>"1"</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>false</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>true</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"glosar"</text></outputEntry>
        <outputEntry><text>"1818"</text></outputEntry>
        <outputEntry><text>"OMNI-ORTOP-OPM-0005"</text></outputEntry>
        <outputEntry><text>"faturamento"</text></outputEntry>
        <outputEntry><text>"contas"</text></outputEntry>
      </rule>
      <rule id="r009">
        <description>OMNI-ORTOP-OPM-0005 — OPME eletiva sem dado de autorização</description>
        <inputEntry><text>&gt;= 20261103</text></inputEntry>
        <inputEntry><text>"conta"</text></inputEntry>
        <inputEntry><text>"1"</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>null</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>true</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"revisao_humana"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-ORTOP-OPM-0005"</text></outputEntry>
        <outputEntry><text>"faturamento"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="r010">
        <description>OMNI-ORTOP-OPM-0007 — urgência comunicada em até 2 dias úteis, com etiqueta (o valor da OPME é pago pela referência em dmn/urgencia/urg_roteamento_opme.dmn, OMNI-URG-OPM-0001)</description>
        <inputEntry><text>&gt;= 20261103</text></inputEntry>
        <inputEntry><text>"conta"</text></inputEntry>
        <inputEntry><text>"2"</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>true</text></inputEntry>
        <inputEntry><text>&lt;= 2</text></inputEntry>
        <inputEntry><text>true</text></inputEntry>
        <inputEntry><text>false, null</text></inputEntry>
        <outputEntry><text>"liberar"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-ORTOP-OPM-0007"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="r011">
        <description>OMNI-ORTOP-OPM-0007 — urgência comunicada após 2 dias úteis</description>
        <inputEntry><text>&gt;= 20261103</text></inputEntry>
        <inputEntry><text>"conta"</text></inputEntry>
        <inputEntry><text>"2"</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>true</text></inputEntry>
        <inputEntry><text>&gt; 2</text></inputEntry>
        <inputEntry><text>true</text></inputEntry>
        <inputEntry><text>false, null</text></inputEntry>
        <outputEntry><text>"revisao_humana"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-ORTOP-OPM-0007"</text></outputEntry>
        <outputEntry><text>"auditoria_enfermagem"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="r012">
        <description>OMNI-ORTOP-OPM-0007 — urgência sem comunicação registrada</description>
        <inputEntry><text>&gt;= 20261103</text></inputEntry>
        <inputEntry><text>"conta"</text></inputEntry>
        <inputEntry><text>"2"</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>true</text></inputEntry>
        <inputEntry><text>null</text></inputEntry>
        <inputEntry><text>true</text></inputEntry>
        <inputEntry><text>false, null</text></inputEntry>
        <outputEntry><text>"revisao_humana"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-ORTOP-OPM-0007"</text></outputEntry>
        <outputEntry><text>"auditoria_enfermagem"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="r013">
        <description>OMNI-ORTOP-OPM-0006 — urgência sem comprovação de uso da OPME (etiqueta, embalagem com etiqueta ou radiografia de controle): o uso foi livre e o procedimento não é negado nem glosado (RN 424, art. 3º, I); o pagamento do item fica pendente até a comprovação (decisão do dono de 15/11/2026; OMNI-URG-OPM-0001), e com ela o item é pago pelo valor de referência (D11). Mesmo tratamento da comprovação não informada. Vale enquanto o prazo de envio da conta (OMNI-GERAL-GLO-0002) não venceu ou o vencimento não foi informado (prazoComprovacaoUsoVencido falso ou nulo); vencido o prazo sem a comprovação, vale a linha r021 (PROG-RCO-7)</description>
        <inputEntry><text>&gt;= 20261103</text></inputEntry>
        <inputEntry><text>"conta"</text></inputEntry>
        <inputEntry><text>"2"</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>false</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>true</text></inputEntry>
        <inputEntry><text>false, null</text></inputEntry>
        <outputEntry><text>"exigir_documento"</text></outputEntry>
        <outputEntry><text>"3263"</text></outputEntry>
        <outputEntry><text>"OMNI-URG-OPM-0001"</text></outputEntry>
        <outputEntry><text>"faturamento"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="r014">
        <description>OMNI-ORTOP-OPM-0006 — urgência com a comprovação de uso não informada (nula): mesmo tratamento da comprovação ausente; o pagamento do item fica pendente até a comprovação (OMNI-URG-OPM-0001); campo nulo nunca vira glosa. Vale enquanto o prazo de envio da conta (OMNI-GERAL-GLO-0002) não venceu ou o vencimento não foi informado (prazoComprovacaoUsoVencido falso ou nulo); vencido o prazo sem a comprovação, vale a linha r021 (PROG-RCO-7)</description>
        <inputEntry><text>&gt;= 20261103</text></inputEntry>
        <inputEntry><text>"conta"</text></inputEntry>
        <inputEntry><text>"2"</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>null</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>true</text></inputEntry>
        <inputEntry><text>false, null</text></inputEntry>
        <outputEntry><text>"exigir_documento"</text></outputEntry>
        <outputEntry><text>"3263"</text></outputEntry>
        <outputEntry><text>"OMNI-URG-OPM-0001"</text></outputEntry>
        <outputEntry><text>"faturamento"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="r022">
        <description>OMNI-ORTOP-OPM-0006 — urgência com o prazo de envio da conta (OMNI-GERAL-GLO-0002) vencido sem a comprovação de uso da OPME, antes de 16/12/2026 (início da vigência da glosa por prazo, 30 dias de antecedência da política de mudança): o item continua pendente até a comprovação (OMNI-URG-OPM-0001), sem glosa (PROG-RCO-7)</description>
        <inputEntry><text>[20261103..20261216[</text></inputEntry>
        <inputEntry><text>"conta"</text></inputEntry>
        <inputEntry><text>"2"</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>true</text></inputEntry>
        <inputEntry><text>true</text></inputEntry>
        <outputEntry><text>"exigir_documento"</text></outputEntry>
        <outputEntry><text>"3263"</text></outputEntry>
        <outputEntry><text>"OMNI-URG-OPM-0001"</text></outputEntry>
        <outputEntry><text>"faturamento"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="r021">
        <description>OMNI-ORTOP-OPM-0006 — urgência com o prazo de envio da conta (OMNI-GERAL-GLO-0002) vencido sem a comprovação de uso da OPME (etiqueta ausente ou não informada): o item de OPME não é pago e é glosado com 3263, com recurso de glosa (decisão do dono de 15/11/2026, PROG-COORD-10; PROG-RCO-7). O procedimento não é negado nem glosado (RN 424, art. 3º, I). A etiqueta não é testada nesta linha porque a entrada derivada já embute a ausência de comprovação; nulo no prazo nunca glosa (D4). Restrição com vigência a partir de 16/12/2026 (30 dias de antecedência da política de mudança, regras/politica-mudanca.yaml)</description>
        <inputEntry><text>&gt;= 20261216</text></inputEntry>
        <inputEntry><text>"conta"</text></inputEntry>
        <inputEntry><text>"2"</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>true</text></inputEntry>
        <inputEntry><text>true</text></inputEntry>
        <outputEntry><text>"glosar"</text></outputEntry>
        <outputEntry><text>"3263"</text></outputEntry>
        <outputEntry><text>"OMNI-ORTOP-OPM-0006"</text></outputEntry>
        <outputEntry><text>"faturamento"</text></outputEntry>
        <outputEntry><text>"contas"</text></outputEntry>
      </rule>
      <rule id="r015">
        <description>OMNI-ORTOP-OPM-0005 — caráter ausente ou inválido na conta</description>
        <inputEntry><text>&gt;= 20261103</text></inputEntry>
        <inputEntry><text>"conta"</text></inputEntry>
        <inputEntry><text>not("1","2")</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>true</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"revisao_humana"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-ORTOP-OPM-0005"</text></outputEntry>
        <outputEntry><text>"faturamento"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="r016">
        <description>OMNI-ORTOP-OPM-0004 — etapa do fluxo ausente ou inválida</description>
        <inputEntry><text>&gt;= 20261103</text></inputEntry>
        <inputEntry><text>not("solicitacao","conta")</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"revisao_humana"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-ORTOP-OPM-0004"</text></outputEntry>
        <outputEntry><text>"regulacao"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="r017">
        <description>OMNI-ORTOP-OPM-0004 — fora da vigência (antes de 03/11/2026): o processo de OPME ORTOP não se aplica</description>
        <inputEntry><text>&lt; 20261103</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"liberar"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-ORTOP-OPM-0004"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="r019">
        <description>OMNI-ORTOP-OPM-0006 — conta sem item de OPME: as exigências de OPME não se aplicam</description>
        <inputEntry><text>&gt;= 20261103</text></inputEntry>
        <inputEntry><text>"conta"</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>false</text></inputEntry>
