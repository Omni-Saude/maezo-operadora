<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:camunda="http://camunda.org/schema/1.0/dmn" id="def_pacote_artroplastia_ortop" name="Pacote de artroplastia total eletiva de quadril e de joelho (OMNI-ORTOP-PAC-0001 a 0003)" namespace="https://omni-saude/dmn/ortopedia-opme">
  <decision id="rco_pacote_artroplastia_ortop" name="Pacote de artroplastia total eletiva de quadril e de joelho (OMNI-ORTOP-PAC-0001 a 0003)" camunda:historyTimeToLive="P180D">
    <description>Enquadra a conta no pacote OMNI-PAC-ORTOP-0001/0002, aplica outlier de permanência e UTI e trata reinternação em 30 dias. Nunca nega cobertura. OMNI-ORTOP-PAC-0001, 0002, 0003.</description>
    <decisionTable id="dt_pacote_artroplastia_ortop" hitPolicy="UNIQUE">
      <input id="in_0_dataExecucao" label="dataExecucao ← TISS dataExecucao/dataRealizacao (inteiro AAAAMMDD)">
        <inputExpression id="ie_0_dataExecucao" typeRef="integer"><text>dataExecucao</text></inputExpression>
      </input>
      <input id="in_1_codigoProcedimento" label="codigoProcedimento ← TISS codigoProcedimento principal da guia de internação (TUSS 22)">
        <inputExpression id="ie_1_codigoProcedimento" typeRef="string"><text>codigoProcedimento</text></inputExpression>
      </input>
      <input id="in_2_caraterAtendimento" label="caraterAtendimento ← TISS caraterAtendimento (TUSS 23)">
        <inputExpression id="ie_2_caraterAtendimento" typeRef="string"><text>caraterAtendimento</text></inputExpression>
      </input>
      <input id="in_3_prestadorComPacote" label="prestadorComPacote ← cadastro de contrato: pacote OMNI-PAC-ORTOP vigente para o prestador (booleano)">
        <inputExpression id="ie_3_prestadorComPacote" typeRef="boolean"><text>prestadorComPacote</text></inputExpression>
      </input>
      <input id="in_4_diasInternacao" label="diasInternacao ← TISS dataInicioFaturamento a dataFimFaturamento/alta (diárias)">
        <inputExpression id="ie_4_diasInternacao" typeRef="integer"><text>diasInternacao</text></inputExpression>
      </input>
      <input id="in_5_utiNaoPrevista" label="utiNaoPrevista ← TISS diárias de UTI (TUSS 18) na guia (booleano)">
        <inputExpression id="ie_5_utiNaoPrevista" typeRef="boolean"><text>utiNaoPrevista</text></inputExpression>
      </input>
      <input id="in_6_reinternacaoJanela" label="reinternacaoJanela ← histórico TISS: nova internação no mesmo prestador até 30 dias da alta de episódio pago em pacote ORTOP (booleano)">
        <inputExpression id="ie_6_reinternacaoJanela" typeRef="boolean"><text>reinternacaoJanela</text></inputExpression>
      </input>
      <output id="out_decisao" name="decisao" typeRef="string"/>
      <output id="out_motivoTab38" name="motivoTab38" typeRef="string"/>
      <output id="out_idRegra" name="idRegra" typeRef="string"/>
      <output id="out_fila" name="fila" typeRef="string"/>
      <output id="out_classeAdverso" name="classeAdverso" typeRef="string"/>
      <output id="out_acaoPacote" name="acaoPacote" typeRef="string"/>
      <rule id="r000">
        <description>OMNI-ORTOP-PAC-0003 — reinternação em até 30 dias da alta do pacote no mesmo prestador: conferir mesma causa</description>
        <inputEntry><text>&gt;= 20261103</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>true</text></inputEntry>
        <outputEntry><text>"revisao_humana"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-ORTOP-PAC-0003"</text></outputEntry>
        <outputEntry><text>"auditoria_medica"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"verificar_sem_novo_pacote"</text></outputEntry>
      </rule>
      <rule id="r001">
        <description>OMNI-ORTOP-PAC-0001 — pacote integral</description>
        <inputEntry><text>&gt;= 20261103</text></inputEntry>
        <inputEntry><text>"30724058"</text></inputEntry>
        <inputEntry><text>"1"</text></inputEntry>
        <inputEntry><text>true</text></inputEntry>
        <inputEntry><text>&lt;= 4</text></inputEntry>
        <inputEntry><text>false</text></inputEntry>
        <inputEntry><text>false</text></inputEntry>
        <outputEntry><text>"pagar_pacote"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-ORTOP-PAC-0001"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"pacote"</text></outputEntry>
      </rule>
      <rule id="r002">
        <description>OMNI-ORTOP-PAC-0001 — pacote mais diárias excedentes</description>
        <inputEntry><text>&gt;= 20261103</text></inputEntry>
        <inputEntry><text>"30724058"</text></inputEntry>
        <inputEntry><text>"1"</text></inputEntry>
        <inputEntry><text>true</text></inputEntry>
        <inputEntry><text>[5..10]</text></inputEntry>
        <inputEntry><text>false</text></inputEntry>
        <inputEntry><text>false</text></inputEntry>
        <outputEntry><text>"pagar_pacote"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-ORTOP-PAC-0001"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"pacote_mais_diarias"</text></outputEntry>
      </rule>
      <rule id="r003">
        <description>OMNI-ORTOP-PAC-0001 — permanência acima do limite de revisão (pagamento das diárias mantido)</description>
