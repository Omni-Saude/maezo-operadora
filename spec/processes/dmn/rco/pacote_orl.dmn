<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:camunda="http://camunda.org/schema/1.0/dmn" id="def_pacote_orl" name="ORL: pacotes eletivos de adenotonsilectomia e septoplastia (OMNI-ORL-PAC-0001 a 0003)" namespace="https://omni-saude/dmn/otorrino-cabeca-pescoco">
  <decision id="rco_pacote_orl" name="ORL: pacotes eletivos de adenotonsilectomia e septoplastia (OMNI-ORL-PAC-0001 a 0003)" camunda:historyTimeToLive="P3650D">
    <description>Enquadra a conta no pacote OMNI-PAC-ORL-0001/0002, aplica outlier de permanência (limiar provisório, C-COORD-05) e UTI, e trata reinternação em 30 dias. Nunca nega cobertura; fora do pacote, a conta é aberta. OMNI-ORL-PAC-0001, 0002 e 0003.</description>
    <decisionTable id="dt_pacote_orl" hitPolicy="UNIQUE">
      <input id="in_0_dataAtendimento" label="dataAtendimento ← TISS dataExecucao do procedimento principal, AAAA-MM-DD">
        <inputExpression id="ie_0_dataAtendimento" typeRef="string"><text>dataAtendimento</text></inputExpression>
      </input>
      <input id="in_1_codigoProcedimentoPrincipal" label="codigoProcedimentoPrincipal ← TISS codigoProcedimento do procedimento principal da guia de resumo de internação (TUSS 22)">
        <inputExpression id="ie_1_codigoProcedimentoPrincipal" typeRef="string"><text>codigoProcedimentoPrincipal</text></inputExpression>
      </input>
      <input id="in_2_caraterAtendimento" label="caraterAtendimento ← TISS caraterAtendimento (TUSS 23: 1 eletivo, 2 urgência/emergência)">
        <inputExpression id="ie_2_caraterAtendimento" typeRef="string"><text>caraterAtendimento</text></inputExpression>
      </input>
      <input id="in_3_prestadorComPacote" label="prestadorComPacote ← cadastro contratual: pacote OMNI-PAC-ORL vigente no anexo do contrato do prestador (booleano)">
        <inputExpression id="ie_3_prestadorComPacote" typeRef="boolean"><text>prestadorComPacote</text></inputExpression>
      </input>
      <input id="in_4_diasInternacao" label="diasInternacao ← resumo de internação TISS: data da alta menos data da internação, em dias">
        <inputExpression id="ie_4_diasInternacao" typeRef="integer"><text>diasInternacao</text></inputExpression>
      </input>
      <input id="in_5_utiNaoPrevista" label="utiNaoPrevista ← TISS diária de UTI (TUSS 18) cobrada sem previsão na autorização (booleano)">
        <inputExpression id="ie_5_utiNaoPrevista" typeRef="boolean"><text>utiNaoPrevista</text></inputExpression>
      </input>
      <input id="in_6_reinternacaoJanela" label="reinternacaoJanela ← TISS: nova internação no mesmo prestador até 30 dias da alta de episódio pago em pacote ORL (booleano)">
        <inputExpression id="ie_6_reinternacaoJanela" typeRef="boolean"><text>reinternacaoJanela</text></inputExpression>
      </input>
      <output id="out_decisao" name="decisao" typeRef="string"/>
      <output id="out_motivoTab38" name="motivoTab38" typeRef="string"/>
      <output id="out_idRegra" name="idRegra" typeRef="string"/>
      <output id="out_fila" name="fila" typeRef="string"/>
      <output id="out_classeAdverso" name="classeAdverso" typeRef="string"/>
      <rule id="x_pre">
        <description>OMNI-ORL-PAC-0001 — fora da vigência (antes de 02/12/2026): pacote ORL não se aplica</description>
        <inputEntry><text>&lt; "2026-12-02"</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"liberar"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-ORL-PAC-0001"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="x_reint">
        <description>OMNI-ORL-PAC-0003 — reinternação em até 30 dias da alta do pacote no mesmo prestador: conferir mesma causa</description>
        <inputEntry><text>&gt;= "2026-12-02"</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>true</text></inputEntry>
        <outputEntry><text>"revisao_humana"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-ORL-PAC-0003"</text></outputEntry>
        <outputEntry><text>"auditoria_medica"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="x_a_int">
        <description>OMNI-ORL-PAC-0001 — pacote integral (até o limiar provisório de diárias)</description>
        <inputEntry><text>&gt;= "2026-12-02"</text></inputEntry>
        <inputEntry><text>"30205034","30205050","30205042","30205271"</text></inputEntry>
        <inputEntry><text>"1"</text></inputEntry>
        <inputEntry><text>true</text></inputEntry>
        <inputEntry><text>&lt;= 1</text></inputEntry>
        <inputEntry><text>false</text></inputEntry>
        <inputEntry><text>false</text></inputEntry>
        <outputEntry><text>"pagar_pacote"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-ORL-PAC-0001"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="x_a_dia">
        <description>OMNI-ORL-PAC-0001 — pacote mais diárias excedentes (outlier de permanência)</description>
        <inputEntry><text>&gt;= "2026-12-02"</text></inputEntry>
        <inputEntry><text>"30205034","30205050","30205042","30205271"</text></inputEntry>
        <inputEntry><text>"1"</text></inputEntry>
        <inputEntry><text>true</text></inputEntry>
        <inputEntry><text>&gt; 1</text></inputEntry>
        <inputEntry><text>false</text></inputEntry>
        <inputEntry><text>false</text></inputEntry>
        <outputEntry><text>"pagar_pacote"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-ORL-PAC-0001"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="x_a_dia_nulo">
        <description>OMNI-ORL-PAC-0001 — dias de internação ausentes</description>
        <inputEntry><text>&gt;= "2026-12-02"</text></inputEntry>
        <inputEntry><text>"30205034","30205050","30205042","30205271"</text></inputEntry>
        <inputEntry><text>"1"</text></inputEntry>
        <inputEntry><text>true</text></inputEntry>
        <inputEntry><text>null</text></inputEntry>
        <inputEntry><text>false</text></inputEntry>
        <inputEntry><text>false</text></inputEntry>
        <outputEntry><text>"revisao_humana"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-ORL-PAC-0001"</text></outputEntry>
