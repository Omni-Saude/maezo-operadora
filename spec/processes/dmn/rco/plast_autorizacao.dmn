<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:camunda="http://camunda.org/schema/1.0/dmn" id="def_plast_autorizacao" name="Plástica e dermatologia: critério publicado e documentos do pedido" namespace="https://omni-saude/dmn/plastica-dermatologia">
  <decision id="rco_plast_autorizacao" name="Plástica e dermatologia: critério publicado e documentos do pedido" camunda:historyTimeToLive="P3650D">
    <description>OMNI-PLAST-AUT-0001 a AUT-0006. Hit policy UNIQUE; nenhuma linha nega nem exige autorização caso a caso; a exigência de documento vale só para caráter 1 (eletivo); urgência ou emergência (caráter 2) é liberada por OMNI-PLAST-AUT-0006; caráter, documentação e data ausentes vão à regulação; estético declarado e linfedema eletivo vão à auditoria médica; fechamento null vai à revisão humana.</description>
    <decisionTable id="dt_plast_autorizacao" hitPolicy="UNIQUE">
      <input id="in_0_dataAtendimento" label="dataAtendimento ← TISS dataSolicitacao (pedido) ou dataExecucao (conta), AAAA-MM-DD">
        <inputExpression id="ie_0_dataAtendimento" typeRef="string"><text>dataAtendimento</text></inputExpression>
      </input>
      <input id="in_1_caraterAtendimento" label="caraterAtendimento ← TISS caraterAtendimento (TUSS 23: 1 eletivo, 2 urgência ou emergência)">
        <inputExpression id="ie_1_caraterAtendimento" typeRef="string"><text>caraterAtendimento</text></inputExpression>
      </input>
      <input id="in_2_documentacaoCompleta" label="documentacaoCompleta ← solicitação: relatório e anexos do pedido conferidos pela regulação contra a lista da regra (anexo da guia TISS)">
        <inputExpression id="ie_2_documentacaoCompleta" typeRef="boolean"><text>documentacaoCompleta</text></inputExpression>
      </input>
      <input id="in_3_finalidadeEsteticaDeclarada" label="finalidadeEsteticaDeclarada ← solicitação: relatório do médico assistente declara finalidade estética (booleano; ausente não é gatilho)">
        <inputExpression id="ie_3_finalidadeEsteticaDeclarada" typeRef="boolean"><text>finalidadeEsteticaDeclarada</text></inputExpression>
      </input>
      <input id="in_4_acimaLimiteLesoes" label="acimaLimiteLesoes ← histórico de contas OMNI e TISS quantidadeExecutada: lesões examinadas nos últimos 365 dias, somadas as do pedido, atingem condicoes.limite de OMNI-PLAST-AUT-0004 (nulo sem histórico)">
        <inputExpression id="ie_4_acimaLimiteLesoes" typeRef="boolean"><text>acimaLimiteLesoes</text></inputExpression>
      </input>
      <input id="in_5_codigoProcedimento" label="codigoProcedimento ← TISS codigoProcedimento (TUSS 22)">
        <inputExpression id="ie_5_codigoProcedimento" typeRef="string"><text>codigoProcedimento</text></inputExpression>
      </input>
      <output id="out_0_decisao" name="decisao" typeRef="string"/>
      <output id="out_1_motivoTab38" name="motivoTab38" typeRef="string"/>
      <output id="out_2_idRegra" name="idRegra" typeRef="string"/>
      <output id="out_3_fila" name="fila" typeRef="string"/>
      <output id="out_classeAdverso" name="classeAdverso" typeRef="string"/>
      <rule id="pre">
        <description>antes da vigência (03/12/2026): OMNI-PLAST-AUT-0002 ainda não vale, liberação</description>
        <inputEntry><text>&lt; "2026-12-03"</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"liberar"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-PLAST-AUT-0002"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
