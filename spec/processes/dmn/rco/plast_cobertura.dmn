<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:camunda="http://camunda.org/schema/1.0/dmn" id="def_plast_cobertura" name="Plástica e dermatologia: cobertura de pele e partes moles" namespace="https://omni-saude/dmn/plastica-dermatologia">
  <decision id="rco_plast_cobertura" name="Plástica e dermatologia: cobertura de pele e partes moles" camunda:historyTimeToLive="P3650D">
    <description>OMNI-PLAST-COB-0001, COB-0002 e COB-0004. Hit policy UNIQUE; nenhuma linha nega (cobertura obrigatória); estético declarado, código fora do Rol, par de suturas, queimadura de primeiro grau e curativo repetido vão à auditoria médica; urgência (caráter 2) é liberada por OMNI-PLAST-AUT-0006; caráter e data ausentes vão à regulação; fechamento null vai à revisão humana.</description>
    <decisionTable id="dt_plast_cobertura" hitPolicy="UNIQUE">
      <input id="in_0_dataAtendimento" label="dataAtendimento ← TISS dataSolicitacao (pedido) ou dataExecucao (conta), AAAA-MM-DD">
        <inputExpression id="ie_0_dataAtendimento" typeRef="string"><text>dataAtendimento</text></inputExpression>
      </input>
      <input id="in_1_caraterAtendimento" label="caraterAtendimento ← TISS caraterAtendimento (TUSS 23: 1 eletivo, 2 urgência ou emergência)">
        <inputExpression id="ie_1_caraterAtendimento" typeRef="string"><text>caraterAtendimento</text></inputExpression>
      </input>
      <input id="in_2_codigoSecundario" label="codigoSecundario ← TISS codigoProcedimento de outra linha da mesma guia e dataExecucao (TUSS 22)">
        <inputExpression id="ie_2_codigoSecundario" typeRef="string"><text>codigoSecundario</text></inputExpression>
      </input>
      <input id="in_3_finalidadeEsteticaDeclarada" label="finalidadeEsteticaDeclarada ← solicitação: relatório do médico assistente declara finalidade estética (booleano; ausente não é gatilho)">
        <inputExpression id="ie_3_finalidadeEsteticaDeclarada" typeRef="boolean"><text>finalidadeEsteticaDeclarada</text></inputExpression>
      </input>
      <input id="in_4_grauQueimadura" label="grauQueimadura ← anexo: grau da queimadura informado no relatório do atendimento (inteiro; fora da guia TISS)">
        <inputExpression id="ie_4_grauQueimadura" typeRef="integer"><text>grauQueimadura</text></inputExpression>
      </input>
      <input id="in_5_codigoProcedimento" label="codigoProcedimento ← TISS codigoProcedimento (TUSS 22)">
        <inputExpression id="ie_5_codigoProcedimento" typeRef="string"><text>codigoProcedimento</text></inputExpression>
      </input>
      <output id="out_0_decisao" name="decisao" typeRef="string"/>
      <output id="out_1_motivoTab38" name="motivoTab38" typeRef="string"/>
      <output id="out_2_idRegra" name="idRegra" typeRef="string"/>
      <output id="out_3_fila" name="fila" typeRef="string"/>
      <output id="out_classeAdverso" name="classeAdverso" typeRef="string"/>
