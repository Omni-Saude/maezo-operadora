<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:camunda="http://camunda.org/schema/1.0/dmn" id="def_plast_compatibilidade" name="Plástica e dermatologia: laudo da cirurgia de Mohs e biópsia com exérese" namespace="https://omni-saude/dmn/plastica-dermatologia">
  <decision id="rco_plast_compatibilidade" name="Plástica e dermatologia: laudo da cirurgia de Mohs e biópsia com exérese" camunda:historyTimeToLive="P3650D">
    <description>OMNI-PLAST-CMP-0001 e CMP-0002. Hit policy UNIQUE; nenhuma linha glosa nem nega; conferência posterior pela auditoria médica; viaAcesso 3 (diferentes vias) é a exceção TISS do par; campo nulo vai à auditoria ou segue sem conferência; fechamento null vai à revisão humana.</description>
    <decisionTable id="dt_plast_compatibilidade" hitPolicy="UNIQUE">
      <input id="in_0_dataAtendimento" label="dataAtendimento ← TISS dataSolicitacao (pedido) ou dataExecucao (conta), AAAA-MM-DD">
        <inputExpression id="ie_0_dataAtendimento" typeRef="string"><text>dataAtendimento</text></inputExpression>
      </input>
      <input id="in_1_codigoSecundario" label="codigoSecundario ← TISS codigoProcedimento de outra linha da mesma guia e dataExecucao (TUSS 22)">
        <inputExpression id="ie_1_codigoSecundario" typeRef="string"><text>codigoSecundario</text></inputExpression>
      </input>
      <input id="in_2_viaAcessoSecundario" label="viaAcessoSecundario ← TISS viaAcesso da linha secundária (Tab. 61: 1 única, 2 mesma via, 3 diferentes vias)">
        <inputExpression id="ie_2_viaAcessoSecundario" typeRef="string"><text>viaAcessoSecundario</text></inputExpression>
      </input>
      <input id="in_3_laudoAnatomopatologicoAnexado" label="laudoAnatomopatologicoAnexado ← anexo: laudo anatomopatológico anexado à guia da cirurgia de Mohs (booleano; fora da guia TISS)">
        <inputExpression id="ie_3_laudoAnatomopatologicoAnexado" typeRef="boolean"><text>laudoAnatomopatologicoAnexado</text></inputExpression>
      </input>
      <input id="in_4_codigoPrincipal" label="codigoPrincipal ← TISS codigoProcedimento do procedimento de referência da guia e dataExecucao (TUSS 22)">
        <inputExpression id="ie_4_codigoPrincipal" typeRef="string"><text>codigoPrincipal</text></inputExpression>
      </input>
      <output id="out_0_decisao" name="decisao" typeRef="string"/>
      <output id="out_1_motivoTab38" name="motivoTab38" typeRef="string"/>
      <output id="out_2_idRegra" name="idRegra" typeRef="string"/>
      <output id="out_3_fila" name="fila" typeRef="string"/>
      <output id="out_classeAdverso" name="classeAdverso" typeRef="string"/>
      <rule id="pre">
        <description>antes da vigência (03/12/2026): OMNI-PLAST-CMP-0001 ainda não vale, liberação</description>
        <inputEntry><text>&lt; "2026-12-03"</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"liberar"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-PLAST-CMP-0001"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="mohs_ok">
        <description>OMNI-PLAST-CMP-0001 — cirurgia de Mohs com laudo anatomopatológico anexado: liberação</description>
        <inputEntry><text>&gt;= "2026-12-03"</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>true</text></inputEntry>
        <inputEntry><text>"30101123"</text></inputEntry>
        <outputEntry><text>"liberar"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-PLAST-CMP-0001"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="mohs_aud">
        <description>OMNI-PLAST-CMP-0001 — cirurgia de Mohs sem o laudo anatomopatológico: auditoria médica posterior, sem glosa</description>
        <inputEntry><text>&gt;= "2026-12-03"</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>false, null</text></inputEntry>
        <inputEntry><text>"30101123"</text></inputEntry>
        <outputEntry><text>"revisao_humana"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-PLAST-CMP-0001"</text></outputEntry>
        <outputEntry><text>"auditoria_medica"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="bx_par">
        <description>OMNI-PLAST-CMP-0002 — biópsia e exérese na mesma guia e data, sem vias diferentes: auditoria médica, sem glosa</description>
        <inputEntry><text>&gt;= "2026-12-03"</text></inputEntry>
        <inputEntry><text>"30101468", "30101492"</text></inputEntry>
        <inputEntry><text>not("3")</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>"30102022", "30102030", "30102049"</text></inputEntry>
        <outputEntry><text>"revisao_humana"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-PLAST-CMP-0002"</text></outputEntry>
        <outputEntry><text>"auditoria_medica"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="bx_via">
        <description>OMNI-PLAST-CMP-0002 — biópsia e exérese por vias diferentes (viaAcesso 3): dois atos explicados, liberação</description>
        <inputEntry><text>&gt;= "2026-12-03"</text></inputEntry>
        <inputEntry><text>"30101468", "30101492"</text></inputEntry>
        <inputEntry><text>"3"</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>"30102022", "30102030", "30102049"</text></inputEntry>
        <outputEntry><text>"liberar"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-PLAST-CMP-0002"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="bx_ok">
        <description>OMNI-PLAST-CMP-0002 — biópsia sem exérese na guia: liberação</description>
        <inputEntry><text>&gt;= "2026-12-03"</text></inputEntry>
        <inputEntry><text>not("30101468", "30101492")</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>"30102022", "30102030", "30102049"</text></inputEntry>
        <outputEntry><text>"liberar"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-PLAST-CMP-0002"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="resto">
        <description>OMNI-PLAST-CMP-0002 — código sem regra de compatibilidade no domínio</description>
        <inputEntry><text>&gt;= "2026-12-03"</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>not("30101123", "30102022", "30102030", "30102049")</text></inputEntry>
        <outputEntry><text>"liberar"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-PLAST-CMP-0002"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="sem_data">
        <description>OMNI-PLAST-CMP-0001 — data ausente: regulação, nunca negativa</description>
        <inputEntry><text>null</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"revisao_humana"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-PLAST-CMP-0001"</text></outputEntry>
        <outputEntry><text>"regulacao"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
</definitions>
