<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:camunda="http://camunda.org/schema/1.0/dmn" id="def_plast_pacote" name="Plástica e dermatologia: composição de conta da exérese de tumor de partes moles" namespace="https://omni-saude/dmn/plastica-dermatologia">
  <decision id="rco_plast_pacote" name="Plástica e dermatologia: composição de conta da exérese de tumor de partes moles" camunda:historyTimeToLive="P3650D">
    <description>OMNI-PLAST-PAC-0001. Composição do ato de 30101913 em conta aberta (HCP-LAN 1), sem pacote de episódio (PLAST-04). Hit policy UNIQUE; nenhuma linha glosa nem nega; sutura cobrada à parte na mesma guia e data vai à auditoria médica; viaAcesso 3 é a exceção TISS; fechamento null vai à revisão humana.</description>
    <decisionTable id="dt_plast_pacote" hitPolicy="UNIQUE">
      <input id="in_0_dataAtendimento" label="dataAtendimento ← TISS dataSolicitacao (pedido) ou dataExecucao (conta), AAAA-MM-DD">
        <inputExpression id="ie_0_dataAtendimento" typeRef="string"><text>dataAtendimento</text></inputExpression>
      </input>
      <input id="in_1_codigoSecundario" label="codigoSecundario ← TISS codigoProcedimento de outra linha da mesma guia e dataExecucao (TUSS 22)">
        <inputExpression id="ie_1_codigoSecundario" typeRef="string"><text>codigoSecundario</text></inputExpression>
      </input>
      <input id="in_2_viaAcessoSecundario" label="viaAcessoSecundario ← TISS viaAcesso da linha secundária (Tab. 61: 1 única, 2 mesma via, 3 diferentes vias)">
        <inputExpression id="ie_2_viaAcessoSecundario" typeRef="string"><text>viaAcessoSecundario</text></inputExpression>
      </input>
      <input id="in_3_codigoPrincipal" label="codigoPrincipal ← TISS codigoProcedimento do procedimento de referência da guia e dataExecucao (TUSS 22)">
        <inputExpression id="ie_3_codigoPrincipal" typeRef="string"><text>codigoPrincipal</text></inputExpression>
      </input>
      <output id="out_0_decisao" name="decisao" typeRef="string"/>
      <output id="out_1_motivoTab38" name="motivoTab38" typeRef="string"/>
      <output id="out_2_idRegra" name="idRegra" typeRef="string"/>
      <output id="out_3_fila" name="fila" typeRef="string"/>
      <output id="out_classeAdverso" name="classeAdverso" typeRef="string"/>
      <rule id="pre">
        <description>antes da vigência (03/12/2026): OMNI-PLAST-PAC-0001 ainda não vale, liberação</description>
        <inputEntry><text>&lt; "2026-12-03"</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"liberar"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-PLAST-PAC-0001"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="par">
        <description>OMNI-PLAST-PAC-0001 — exérese de tumor de partes moles com sutura cobrada à parte na mesma guia e data: auditoria médica, sem glosa</description>
        <inputEntry><text>&gt;= "2026-12-03"</text></inputEntry>
        <inputEntry><text>"30101786", "30101794"</text></inputEntry>
        <inputEntry><text>not("3")</text></inputEntry>
        <inputEntry><text>"30101913"</text></inputEntry>
        <outputEntry><text>"revisao_humana"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-PLAST-PAC-0001"</text></outputEntry>
        <outputEntry><text>"auditoria_medica"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="via">
        <description>OMNI-PLAST-PAC-0001 — sutura por outra via (viaAcesso 3): dois atos explicados, liberação</description>
        <inputEntry><text>&gt;= "2026-12-03"</text></inputEntry>
        <inputEntry><text>"30101786", "30101794"</text></inputEntry>
        <inputEntry><text>"3"</text></inputEntry>
        <inputEntry><text>"30101913"</text></inputEntry>
        <outputEntry><text>"liberar"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-PLAST-PAC-0001"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="ok">
        <description>OMNI-PLAST-PAC-0001 — exérese de tumor de partes moles sem sutura à parte: conta aberta, liberação</description>
        <inputEntry><text>&gt;= "2026-12-03"</text></inputEntry>
        <inputEntry><text>not("30101786", "30101794")</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>"30101913"</text></inputEntry>
        <outputEntry><text>"liberar"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-PLAST-PAC-0001"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="resto">
        <description>OMNI-PLAST-PAC-0001 — código sem composição de conta no domínio</description>
        <inputEntry><text>&gt;= "2026-12-03"</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>not("30101913")</text></inputEntry>
        <outputEntry><text>"liberar"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-PLAST-PAC-0001"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="sem_data">
        <description>OMNI-PLAST-PAC-0001 — data ausente: regulação, nunca negativa</description>
        <inputEntry><text>null</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"revisao_humana"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-PLAST-PAC-0001"</text></outputEntry>
        <outputEntry><text>"regulacao"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
</definitions>
