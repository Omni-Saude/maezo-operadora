<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:camunda="http://camunda.org/schema/1.0/dmn" id="def_radio_pacote" name="Radioterapia: código por tratamento, uma unidade por curso" namespace="https://omni-saude/dmn/radioterapia">
  <decision id="rco_radio_pacote" name="Radioterapia: código por tratamento, uma unidade por curso" camunda:historyTimeToLive="P3650D">
    <description>OMNI-RADIO-PAC-0001. Domínio radioterapia. Hit policy UNIQUE; a linha de fechamento (data ausente) vai à revisão humana e não nega.</description>
    <decisionTable id="dt_radio_pacote" hitPolicy="UNIQUE">
      <input id="in_0_dataAtendimento" label="dataAtendimento ← TISS dataSolicitacao (pedido) ou dataExecucao (conta), AAAA-MM-DD">
        <inputExpression id="ie_0_dataAtendimento" typeRef="string"><text>dataAtendimento</text></inputExpression>
      </input>
      <input id="in_1_codigoProcedimento" label="codigoProcedimento ← TISS codigoProcedimento (TUSS 22)">
        <inputExpression id="ie_1_codigoProcedimento" typeRef="string"><text>codigoProcedimento</text></inputExpression>
      </input>
      <input id="in_2_acimaUnidadeTuss" label="acimaUnidadeTuss ← TISS quantidadeExecutada somada do código no mesmo curso acima do máximo de unidades_tuss de dominio.yaml (booleano; nulo sem curso vinculado)">
        <inputExpression id="ie_2_acimaUnidadeTuss" typeRef="boolean"><text>acimaUnidadeTuss</text></inputExpression>
      </input>
      <input id="in_3_campoConvencionalMesmoCurso" label="campoConvencionalMesmoCurso ← TISS: código de teleterapia por campo cobrado no mesmo curso (booleano)">
        <inputExpression id="ie_3_campoConvencionalMesmoCurso" typeRef="boolean"><text>campoConvencionalMesmoCurso</text></inputExpression>
      </input>
      <output id="out_0_decisao" name="decisao" typeRef="string"/>
      <output id="out_1_motivoTab38" name="motivoTab38" typeRef="string"/>
      <output id="out_2_idRegra" name="idRegra" typeRef="string"/>
      <output id="out_3_fila" name="fila" typeRef="string"/>
      <output id="out_classeAdverso" name="classeAdverso" typeRef="string"/>
      <rule id="pre">
        <description>OMNI-RADIO-PAC-0001 — antes da vigência (2026-12-03): regras RADIO não se aplicam</description>
        <inputEntry><text>&lt; "2026-12-03"</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"liberar"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-RADIO-PAC-0001"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="p_acima">
        <description>OMNI-RADIO-PAC-0001 — unidade a mais do código por tratamento no mesmo curso: glosa</description>
        <inputEntry><text>&gt;= "2026-12-03"</text></inputEntry>
        <inputEntry><text>"41203020", "41203038", "41203046", "41203054", "41203062", "41203100", "41203127", "41203160", "41203216"</text></inputEntry>
        <inputEntry><text>true</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"glosar"</text></outputEntry>
        <outputEntry><text>"3210"</text></outputEntry>
        <outputEntry><text>"OMNI-RADIO-PAC-0001"</text></outputEntry>
        <outputEntry><text>"faturamento"</text></outputEntry>
        <outputEntry><text>"contas"</text></outputEntry>
      </rule>
      <rule id="p_conv">
        <description>OMNI-RADIO-PAC-0001 — código por campo no mesmo curso do código por tratamento: faturamento</description>
        <inputEntry><text>&gt;= "2026-12-03"</text></inputEntry>
        <inputEntry><text>"41203020", "41203038", "41203046", "41203054", "41203062", "41203100", "41203127", "41203160", "41203216"</text></inputEntry>
        <inputEntry><text>false, null</text></inputEntry>
        <inputEntry><text>true</text></inputEntry>
        <outputEntry><text>"revisao_humana"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-RADIO-PAC-0001"</text></outputEntry>
        <outputEntry><text>"faturamento"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="p_ok">
        <description>OMNI-RADIO-PAC-0001 — uma unidade por curso: pagar pela unidade do termo TUSS</description>
        <inputEntry><text>&gt;= "2026-12-03"</text></inputEntry>
        <inputEntry><text>"41203020", "41203038", "41203046", "41203054", "41203062", "41203100", "41203127", "41203160", "41203216"</text></inputEntry>
        <inputEntry><text>false, null</text></inputEntry>
        <inputEntry><text>false, null</text></inputEntry>
        <outputEntry><text>"pagar_pacote"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-RADIO-PAC-0001"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="p_resto">
        <description>OMNI-RADIO-PAC-0001 — código fora desta tabela</description>
        <inputEntry><text>&gt;= "2026-12-03"</text></inputEntry>
        <inputEntry><text>not("41203020", "41203038", "41203046", "41203054", "41203062", "41203100", "41203127", "41203160", "41203216")</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"liberar"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-RADIO-PAC-0001"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="sem_data">
        <description>OMNI-RADIO-PAC-0001 — data ausente: regulação, sem negativa</description>
        <inputEntry><text>null</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"revisao_humana"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-RADIO-PAC-0001"</text></outputEntry>
        <outputEntry><text>"regulacao"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
</definitions>
