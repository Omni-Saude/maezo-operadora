<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:camunda="http://camunda.org/schema/1.0/dmn" id="def_teresp_cobertura" name="Terapias multiprofissionais e TEA: cobertura do Rol, regime e método indicado" namespace="https://omni-saude/dmn/terapias-multiprofissionais-tea">
  <decision id="rco_teresp_cobertura" name="Terapias multiprofissionais e TEA: cobertura do Rol, regime e método indicado" camunda:historyTimeToLive="P3650D">
    <description>OMNI-TERESP-COB-0001 a OMNI-TERESP-COB-0005. Hit policy UNIQUE; nenhuma linha nega: cobertura obrigatória nunca é negada, o que sai do regime do Rol, do Rol ou da finalidade estética vai à revisão humana; urgência libera; sem limite de sessões (RN 541/2022); método indicado no TEA sem prestador apto vai à regulação; data ausente vai à revisão humana.</description>
    <decisionTable id="dt_teresp_cobertura" hitPolicy="UNIQUE">
      <input id="in_0_dataAtendimento" label="dataAtendimento ← TISS dataSolicitacao (pedido) ou dataExecucao (conta), AAAA-MM-DD">
        <inputExpression id="ie_0_dataAtendimento" typeRef="string"><text>dataAtendimento</text></inputExpression>
      </input>
      <input id="in_1_segmentacaoCompativel" label="segmentacaoCompativel ← TISS regime de atendimento da guia × segmentos_rol do código (AMB, HCO, HSO) em dominio.yaml; ausente se o regime não vier na guia">
        <inputExpression id="ie_1_segmentacaoCompativel" typeRef="boolean"><text>segmentacaoCompativel</text></inputExpression>
      </input>
      <input id="in_2_caraterAtendimento" label="caraterAtendimento ← TISS caraterAtendimento (TUSS 23: 1 eletivo, 2 urgência ou emergência)">
        <inputExpression id="ie_2_caraterAtendimento" typeRef="string"><text>caraterAtendimento</text></inputExpression>
      </input>
      <input id="in_3_cidGrupoF84" label="cidGrupoF84 ← TISS cidPrincipal ou cidSecundario no grupo F84 (transtornos globais do desenvolvimento, TEA)">
        <inputExpression id="ie_3_cidGrupoF84" typeRef="boolean"><text>cidGrupoF84</text></inputExpression>
      </input>
      <input id="in_4_cidFinalidadeEstetica" label="cidFinalidadeEstetica ← TISS cidPrincipal no grupo Z41 em pedido de fisioterapia (a confirmar pela auditoria médica)">
        <inputExpression id="ie_4_cidFinalidadeEstetica" typeRef="boolean"><text>cidFinalidadeEstetica</text></inputExpression>
      </input>
      <input id="in_5_metodoIndicado" label="metodoIndicado ← solicitação: método ou técnica indicados pelo médico assistente no TEA">
        <inputExpression id="ie_5_metodoIndicado" typeRef="boolean"><text>metodoIndicado</text></inputExpression>
      </input>
      <input id="in_6_prestadorAptoMetodo" label="prestadorAptoMetodo ← cadastro de rede da OMNI: prestador apto ao método indicado na praça do beneficiário">
        <inputExpression id="ie_6_prestadorAptoMetodo" typeRef="boolean"><text>prestadorAptoMetodo</text></inputExpression>
      </input>
      <input id="in_7_cirurgiaNaInternacao" label="cirurgiaNaInternacao ← TISS guia de internação: procedimento cirúrgico informado na mesma internação">
        <inputExpression id="ie_7_cirurgiaNaInternacao" typeRef="boolean"><text>cirurgiaNaInternacao</text></inputExpression>
      </input>
      <input id="in_8_classeTerapia" label="classeTerapia ← TISS codigoProcedimento (TUSS 22) pela lista classes de dominio.yaml (regras/terapias-multiprofissionais-tea)">
        <inputExpression id="ie_8_classeTerapia" typeRef="string"><text>classeTerapia</text></inputExpression>
      </input>
      <input id="in_9_codigoProcedimento" label="codigoProcedimento ← TISS codigoProcedimento (TUSS 22)">
        <inputExpression id="ie_9_codigoProcedimento" typeRef="string"><text>codigoProcedimento</text></inputExpression>
      </input>
      <output id="out_0_decisao" name="decisao" typeRef="string"/>
      <output id="out_1_motivoTab38" name="motivoTab38" typeRef="string"/>
      <output id="out_2_idRegra" name="idRegra" typeRef="string"/>
      <output id="out_3_fila" name="fila" typeRef="string"/>
      <output id="out_classeAdverso" name="classeAdverso" typeRef="string"/>
      <rule id="t_pre">
        <description>OMNI-TERESP-COB-0001 — antes da vigência (06/12/2026): liberar, sem efeito</description>
        <inputEntry><text>&lt; "2026-12-06"</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"liberar"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-TERESP-COB-0001"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
