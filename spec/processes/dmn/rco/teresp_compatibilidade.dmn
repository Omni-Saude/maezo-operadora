<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:camunda="http://camunda.org/schema/1.0/dmn" id="def_teresp_compatibilidade" name="Terapias multiprofissionais e TEA: regime × segmentação do Rol e acréscimo em ato de fisioterapeuta" namespace="https://omni-saude/dmn/terapias-multiprofissionais-tea">
  <decision id="rco_teresp_compatibilidade" name="Terapias multiprofissionais e TEA: regime × segmentação do Rol e acréscimo em ato de fisioterapeuta" camunda:historyTimeToLive="P3650D">
    <description>OMNI-TERESP-CMP-0001 e OMNI-TERESP-CMP-0002. Hit policy UNIQUE; nenhuma linha nega: regime incompatível ou ausente e acréscimo em ato de fisioterapeuta vão à revisão do faturamento; dado ausente do acréscimo ou da profissão não gera efeito; fechamento null vai à revisão humana.</description>
    <decisionTable id="dt_teresp_compatibilidade" hitPolicy="UNIQUE">
      <input id="in_0_dataAtendimento" label="dataAtendimento ← TISS dataSolicitacao (pedido) ou dataExecucao (conta), AAAA-MM-DD">
        <inputExpression id="ie_0_dataAtendimento" typeRef="string"><text>dataAtendimento</text></inputExpression>
      </input>
      <input id="in_1_segmentacaoCompativel" label="segmentacaoCompativel ← TISS regime de atendimento da guia × segmentos_rol do código (AMB, HCO, HSO) em dominio.yaml; ausente se o regime não vier na guia">
        <inputExpression id="ie_1_segmentacaoCompativel" typeRef="boolean"><text>segmentacaoCompativel</text></inputExpression>
      </input>
      <input id="in_2_regime" label="regime ← TISS regime de atendimento (Tab. 76: ambulatorial, internação)">
        <inputExpression id="ie_2_regime" typeRef="string"><text>regime</text></inputExpression>
      </input>
      <input id="in_3_reducaoAcrescimoMaiorQueUm" label="reducaoAcrescimoMaiorQueUm ← TISS reducaoAcrescimo da linha do procedimento maior que 1">
        <inputExpression id="ie_3_reducaoAcrescimoMaiorQueUm" typeRef="boolean"><text>reducaoAcrescimoMaiorQueUm</text></inputExpression>
      </input>
      <input id="in_4_profissaoExecutante" label="profissaoExecutante ← cadastro do prestador: conselho do profissional executante">
        <inputExpression id="ie_4_profissaoExecutante" typeRef="string"><text>profissaoExecutante</text></inputExpression>
      </input>
      <input id="in_5_codigoProcedimento" label="codigoProcedimento ← TISS codigoProcedimento (TUSS 22)">
        <inputExpression id="ie_5_codigoProcedimento" typeRef="string"><text>codigoProcedimento</text></inputExpression>
      </input>
      <output id="out_0_decisao" name="decisao" typeRef="string"/>
      <output id="out_1_motivoTab38" name="motivoTab38" typeRef="string"/>
      <output id="out_2_idRegra" name="idRegra" typeRef="string"/>
      <output id="out_3_fila" name="fila" typeRef="string"/>
      <output id="out_classeAdverso" name="classeAdverso" typeRef="string"/>
      <rule id="t_pre">
        <description>OMNI-TERESP-CMP-0001 — antes da vigência (06/12/2026): liberar, sem efeito</description>
        <inputEntry><text>&lt; "2026-12-06"</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"liberar"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-TERESP-CMP-0001"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="t001">
        <description>OMNI-TERESP-CMP-0001 — reabilitação física no regime compatível com a segmentação do Rol: liberar</description>
        <inputEntry><text>&gt;= "2026-12-06"</text></inputEntry>
        <inputEntry><text>true</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>"20103018", "20103026", "20103034", "20103042", "20103050", "20103069", "20103077", "20103093", "20103107", "20103131", "20103182", "20103190", "20103204", "20103212", "20103220", "20103239", "20103247", "20103255", "20103263", "20103271", "20103280", "20103298", "20103301", "20103310", "20103328", "20103344", "20103360", "20103379", "20103387", "20103395", "20103409", "20103417", "20103425", "20103433", "20103441", "20103450", "20103468", "20103476", "20103484", "20103492", "20103506", "20103514", "20103522", "20103530", "20103565", "20103611", "20103620", "20103638", "20103646", "20103654", "20103662", "20103670", "20103689", "20103697", "20103700", "20103719", "20103727", "20103743", "50000012", "50000020", "50000926", "50001000", "50001019", "50001051", "50001078"</text></inputEntry>
