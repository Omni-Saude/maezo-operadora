<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:camunda="http://camunda.org/schema/1.0/dmn" id="def_teresp_dut" name="Terapias multiprofissionais e TEA: diretrizes de utilização 5, 8, 103 e 135 e pedido do TEA" namespace="https://omni-saude/dmn/terapias-multiprofissionais-tea">
  <decision id="rco_teresp_dut" name="Terapias multiprofissionais e TEA: diretrizes de utilização 5, 8, 103 e 135 e pedido do TEA" camunda:historyTimeToLive="P3650D">
    <description>OMNI-TERESP-DUT-0001 a OMNI-TERESP-DUT-0004. Hit policy UNIQUE; nenhuma linha nega: a exigência de documento vale só para caráter 1 (eletivo); urgência ou emergência (caráter 2) é liberada por OMNI-TERESP-AUT-0003 e caráter ausente vai à revisão humana; documentação incompleta gera a lista do que falta; o enquadramento clínico vai à auditoria médica; fechamento null vai à revisão humana. DUT 102, 104 a 108 e 136 a 138 revogadas pela RN 541/2022 não entram.</description>
    <decisionTable id="dt_teresp_dut" hitPolicy="UNIQUE">
      <input id="in_0_dataAtendimento" label="dataAtendimento ← TISS dataSolicitacao (pedido) ou dataExecucao (conta), AAAA-MM-DD">
        <inputExpression id="ie_0_dataAtendimento" typeRef="string"><text>dataAtendimento</text></inputExpression>
      </input>
      <input id="in_1_regime" label="regime ← TISS regime de atendimento (Tab. 76: ambulatorial, internação)">
        <inputExpression id="ie_1_regime" typeRef="string"><text>regime</text></inputExpression>
      </input>
      <input id="in_2_caraterAtendimento" label="caraterAtendimento ← TISS caraterAtendimento (TUSS 23: 1 eletivo, 2 urgência ou emergência)">
        <inputExpression id="ie_2_caraterAtendimento" typeRef="string"><text>caraterAtendimento</text></inputExpression>
      </input>
      <input id="in_3_documentacaoCompleta" label="documentacaoCompleta ← solicitação: relatório e dados exigidos pela diretriz ou pelo critério publicado (anexo da guia TISS)">
        <inputExpression id="ie_3_documentacaoCompleta" typeRef="boolean"><text>documentacaoCompleta</text></inputExpression>
      </input>
      <input id="in_4_habilitacaoObstetricaExecutante" label="habilitacaoObstetricaExecutante ← cadastro do prestador: registro no conselho com habilitação obstétrica">
        <inputExpression id="ie_4_habilitacaoObstetricaExecutante" typeRef="boolean"><text>habilitacaoObstetricaExecutante</text></inputExpression>
      </input>
      <input id="in_5_idadeBeneficiario" label="idadeBeneficiario ← cadastro do beneficiário na data da solicitação">
        <inputExpression id="ie_5_idadeBeneficiario" typeRef="integer"><text>idadeBeneficiario</text></inputExpression>
      </input>
      <input id="in_6_cidEspasticidadeDut8" label="cidEspasticidadeDut8 ← TISS cidPrincipal ou cidSecundario na lista codigos_cid da OMNI-TERESP-DUT-0004 (espasticidade, item 2 da DUT 8)">
        <inputExpression id="ie_6_cidEspasticidadeDut8" typeRef="boolean"><text>cidEspasticidadeDut8</text></inputExpression>
      </input>
      <input id="in_7_cidGrupoF84" label="cidGrupoF84 ← TISS cidPrincipal ou cidSecundario no grupo F84 (transtornos globais do desenvolvimento, TEA)">
        <inputExpression id="ie_7_cidGrupoF84" typeRef="boolean"><text>cidGrupoF84</text></inputExpression>
      </input>
      <input id="in_8_classeTerapia" label="classeTerapia ← TISS codigoProcedimento (TUSS 22) pela lista classes de dominio.yaml (regras/terapias-multiprofissionais-tea)">
        <inputExpression id="ie_8_classeTerapia" typeRef="string"><text>classeTerapia</text></inputExpression>
      </input>
      <input id="in_9_codigoProcedimento" label="codigoProcedimento ← TISS codigoProcedimento (TUSS 22)">
        <inputExpression id="ie_9_codigoProcedimento" typeRef="string"><text>codigoProcedimento</text></inputExpression>
      </input>
      <output id="out_0_decisao" name="decisao" typeRef="string"/>
      <output id="out_1_motivoTab38" name="motivoTab38" typeRef="string"/>
      <output id="out_2_idRegra" name="idRegra" typeRef="string"/>
      <output id="out_3_fila" name="fila" typeRef="string"/>
      <output id="out_classeAdverso" name="classeAdverso" typeRef="string"/>
      <rule id="t_pre">
        <description>OMNI-TERESP-DUT-0001 — antes da vigência (06/12/2026): liberar, sem efeito</description>
        <inputEntry><text>&lt; "2026-12-06"</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"liberar"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-TERESP-DUT-0001"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
