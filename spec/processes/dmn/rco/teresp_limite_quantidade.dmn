<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:camunda="http://camunda.org/schema/1.0/dmn" id="def_teresp_limite_quantidade" name="Terapias multiprofissionais e TEA: glosa de cobrança idêntica e gatilhos de revisão de quantidade" namespace="https://omni-saude/dmn/terapias-multiprofissionais-tea">
  <decision id="rco_teresp_limite_quantidade" name="Terapias multiprofissionais e TEA: glosa de cobrança idêntica e gatilhos de revisão de quantidade" camunda:historyTimeToLive="P3650D">
    <description>OMNI-TERESP-LIM-0001 a OMNI-TERESP-LIM-0009. Hit policy UNIQUE; única glosa automática: cobrança idêntica repetida, motivo 3209 da Tabela 38 (RN 503, art. 14), e só com histórico (cobrancaIdentica verdadeiro); os demais gatilhos, calculados com os parâmetros das regras (efeito.parametros), vão à revisão do faturamento ou à auditoria médica, nunca a glosa por contagem; sem limite de sessões (RN 541/2022); beneficiário com CID F84 fora dos gatilhos de frequência, de mesma especialidade no dia e de janela; urgência libera; dado ausente nunca glosa; fechamento null vai à revisão humana.</description>
    <decisionTable id="dt_teresp_limite_quantidade" hitPolicy="UNIQUE">
      <input id="in_0_dataAtendimento" label="dataAtendimento ← TISS dataSolicitacao (pedido) ou dataExecucao (conta), AAAA-MM-DD">
        <inputExpression id="ie_0_dataAtendimento" typeRef="string"><text>dataAtendimento</text></inputExpression>
      </input>
      <input id="in_1_caraterAtendimento" label="caraterAtendimento ← TISS caraterAtendimento (TUSS 23: 1 eletivo, 2 urgência ou emergência)">
        <inputExpression id="ie_1_caraterAtendimento" typeRef="string"><text>caraterAtendimento</text></inputExpression>
      </input>
      <input id="in_2_cobrancaIdentica" label="cobrancaIdentica ← TISS histórico de guias OMNI: mesmo beneficiário, código, data, hora inicial, executante e prestador">
        <inputExpression id="ie_2_cobrancaIdentica" typeRef="boolean"><text>cobrancaIdentica</text></inputExpression>
      </input>
      <input id="in_3_cidGrupoF84" label="cidGrupoF84 ← TISS cidPrincipal ou cidSecundario no grupo F84 (transtornos globais do desenvolvimento, TEA)">
        <inputExpression id="ie_3_cidGrupoF84" typeRef="boolean"><text>cidGrupoF84</text></inputExpression>
      </input>
      <input id="in_4_contagemAcimaDoParametro" label="contagemAcimaDoParametro ← TISS histórico de guias OMNI: contagem do beneficiário acima do parâmetro da regra LIM aplicável ao código (detalhe na descrição da cláusula)">
        <description>contagemAcimaDoParametro ← TISS histórico de guias OMNI: contagem do beneficiário acima do parâmetro da regra LIM aplicável ao código (mínimo da DUT 103/135 em LIM-0001, segmentos em LIM-0002, consulta ou concomitância em LIM-0004, sessão ou consulta do internado em LIM-0006; efeito.parametros)</description>
        <inputExpression id="ie_4_contagemAcimaDoParametro" typeRef="boolean"><text>contagemAcimaDoParametro</text></inputExpression>
      </input>
      <input id="in_5_frequenciaAcimaDoGatilho" label="frequenciaAcimaDoGatilho ← TISS histórico de guias OMNI: sessões da semana, de biofeedback ou do dia perioperatório acima dos gatilhos de OMNI-TERESP-LIM-0003 (efeito.parametros)">
        <inputExpression id="ie_5_frequenciaAcimaDoGatilho" typeRef="boolean"><text>frequenciaAcimaDoGatilho</text></inputExpression>
      </input>
      <input id="in_6_mesmaEspecialidadeAcimaNoDia" label="mesmaEspecialidadeAcimaNoDia ← TISS beneficiário, data e especialidade pela lista especialidade_por_codigo de dominio.yaml: sessões acima do parâmetro de OMNI-TERESP-LIM-0005">
        <inputExpression id="ie_6_mesmaEspecialidadeAcimaNoDia" typeRef="boolean"><text>mesmaEspecialidadeAcimaNoDia</text></inputExpression>
      </input>
      <input id="in_7_sessoesNaJanelaAcimaDoGatilho" label="sessoesNaJanelaAcimaDoGatilho ← TISS histórico de guias OMNI: sessões da especialidade na janela de 30 dias acima do gatilho de OMNI-TERESP-LIM-0009 (terapia ocupacional sem gatilho)">
        <inputExpression id="ie_7_sessoesNaJanelaAcimaDoGatilho" typeRef="boolean"><text>sessoesNaJanelaAcimaDoGatilho</text></inputExpression>
      </input>
      <input id="in_8_quantidadeAcimaDoPedido" label="quantidadeAcimaDoPedido ← TISS quantidadeExecutada somada por solicitação maior que quantidadeSolicitada da solicitação em vigor">
        <inputExpression id="ie_8_quantidadeAcimaDoPedido" typeRef="boolean"><text>quantidadeAcimaDoPedido</text></inputExpression>
      </input>
      <input id="in_9_codigoProcedimento" label="codigoProcedimento ← TISS codigoProcedimento (TUSS 22)">
        <inputExpression id="ie_9_codigoProcedimento" typeRef="string"><text>codigoProcedimento</text></inputExpression>
      </input>
      <output id="out_0_decisao" name="decisao" typeRef="string"/>
      <output id="out_1_motivoTab38" name="motivoTab38" typeRef="string"/>
      <output id="out_2_idRegra" name="idRegra" typeRef="string"/>
      <output id="out_3_fila" name="fila" typeRef="string"/>
      <output id="out_classeAdverso" name="classeAdverso" typeRef="string"/>
      <rule id="t_pre">
        <description>OMNI-TERESP-LIM-0007 — antes da vigência (06/12/2026): liberar, sem efeito</description>
