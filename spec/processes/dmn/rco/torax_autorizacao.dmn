<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:camunda="http://camunda.org/schema/1.0/dmn" id="def_torax_autorizacao" name="Tórax: autorização prévia da cirurgia eletiva; urgência sem autorização" namespace="https://omni-saude/dmn/torax-pneumologia">
  <decision id="rco_torax_autorizacao" name="Tórax: autorização prévia da cirurgia eletiva; urgência sem autorização" camunda:historyTimeToLive="P3650D">
    <description>OMNI-TORAX-AUT-0001 a 0007, 0009 e 0010. Hit policy UNIQUE; nenhuma linha nega ou glosa; caráter ausente ou fora de 1 e 2 vai à regulação; a linha de fechamento (data ausente) vai à revisão humana. Classe de cada código em regras/torax-pneumologia/dominio.yaml (classes_autorizacao). A troca de via (OMNI-TORAX-AUT-0008) é conferida na conta, em torax_compatibilidade.</description>
    <decisionTable id="dt_torax_autorizacao" hitPolicy="UNIQUE">
      <input id="in_0_dataAtendimento" label="dataAtendimento ← TISS dataSolicitacao (pedido) ou dataExecucao (conta), AAAA-MM-DD">
        <inputExpression id="ie_0_dataAtendimento" typeRef="string"><text>dataAtendimento</text></inputExpression>
      </input>
      <input id="in_1_codigoProcedimento" label="codigoProcedimento ← TISS codigoProcedimento (TUSS 22)">
        <inputExpression id="ie_1_codigoProcedimento" typeRef="string"><text>codigoProcedimento</text></inputExpression>
      </input>
      <input id="in_2_caraterAtendimento" label="caraterAtendimento ← TISS caraterAtendimento (TUSS 23: 1 eletivo, 2 urgência ou emergência)">
        <inputExpression id="ie_2_caraterAtendimento" typeRef="string"><text>caraterAtendimento</text></inputExpression>
      </input>
      <output id="out_0_decisao" name="decisao" typeRef="string"/>
      <output id="out_1_motivoTab38" name="motivoTab38" typeRef="string"/>
      <output id="out_2_idRegra" name="idRegra" typeRef="string"/>
      <output id="out_3_fila" name="fila" typeRef="string"/>
      <output id="out_classeAdverso" name="classeAdverso" typeRef="string"/>
      <rule id="a_pre">
        <description>OMNI-TORAX-AUT-0009 — antes da vigência (2026-12-03): regras de autorização TORAX não se aplicam</description>
        <inputEntry><text>&lt; "2026-12-03"</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"liberar"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-TORAX-AUT-0009"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
