<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:camunda="http://camunda.org/schema/1.0/dmn" id="def_torax_cobertura" name="Tórax: cobertura (fora do Rol, só hospitalar em plano ambulatorial, exames funcionais da pneumologia)" namespace="https://omni-saude/dmn/torax-pneumologia">
  <decision id="rco_torax_cobertura" name="Tórax: cobertura (fora do Rol, só hospitalar em plano ambulatorial, exames funcionais da pneumologia)" camunda:historyTimeToLive="P3650D">
    <description>OMNI-TORAX-COB-0001 a OMNI-TORAX-COB-0004. Hit policy UNIQUE; nenhuma linha nega; fechamento com data ausente vai à revisão humana. Listas em regras/torax-pneumologia/dominio.yaml (codigos_fora_rol, segmentos_rol, codigos_externos).</description>
    <decisionTable id="dt_torax_cobertura" hitPolicy="UNIQUE">
      <input id="in_0_dataAtendimento" label="dataAtendimento ← TISS dataSolicitacao (pedido) ou dataExecucao (conta), AAAA-MM-DD">
        <inputExpression id="ie_0_dataAtendimento" typeRef="string"><text>dataAtendimento</text></inputExpression>
      </input>
      <input id="in_1_codigoProcedimento" label="codigoProcedimento ← TISS codigoProcedimento (TUSS 22)">
        <inputExpression id="ie_1_codigoProcedimento" typeRef="string"><text>codigoProcedimento</text></inputExpression>
      </input>
      <input id="in_2_planoSoAmbulatorial" label="planoSoAmbulatorial ← cadastro do produto (segmentação só ambulatorial, Lei 9.656/1998, art. 12, I)">
        <inputExpression id="ie_2_planoSoAmbulatorial" typeRef="boolean"><text>planoSoAmbulatorial</text></inputExpression>
      </input>
      <output id="out_0_decisao" name="decisao" typeRef="string"/>
      <output id="out_1_motivoTab38" name="motivoTab38" typeRef="string"/>
      <output id="out_2_idRegra" name="idRegra" typeRef="string"/>
      <output id="out_3_fila" name="fila" typeRef="string"/>
      <output id="out_classeAdverso" name="classeAdverso" typeRef="string"/>
      <rule id="c_pre">
        <description>OMNI-TORAX-COB-0004 — antes da vigência (2026-12-03): regras de cobertura TORAX não se aplicam</description>
        <inputEntry><text>&lt; "2026-12-03"</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"liberar"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-TORAX-COB-0004"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
