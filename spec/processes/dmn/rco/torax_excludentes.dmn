<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:camunda="http://camunda.org/schema/1.0/dmn" id="def_torax_excludentes" name="Tórax: drenagem pleural e retirada de dreno cobradas com o ato que as inclui" namespace="https://omni-saude/dmn/torax-pneumologia">
  <decision id="rco_torax_excludentes" name="Tórax: drenagem pleural e retirada de dreno cobradas com o ato que as inclui" camunda:historyTimeToLive="P3650D">
    <description>OMNI-TORAX-MEX-0001. Hit policy UNIQUE; nenhuma linha glosa: o par vai à auditoria médica. Par permitido (bulectomia por vídeo com pleurectomia ou pleurodese por vídeo) cai em liberar. Listas em regras/torax-pneumologia/dominio.yaml (pares_excludentes).</description>
    <decisionTable id="dt_torax_excludentes" hitPolicy="UNIQUE">
      <input id="in_0_dataAtendimento" label="dataAtendimento ← TISS dataSolicitacao (pedido) ou dataExecucao (conta), AAAA-MM-DD">
        <inputExpression id="ie_0_dataAtendimento" typeRef="string"><text>dataAtendimento</text></inputExpression>
      </input>
      <input id="in_1_codigoPrincipal" label="codigoPrincipal ← TISS codigoProcedimento do ato principal (TUSS 22), mesma guia e dataExecucao">
        <inputExpression id="ie_1_codigoPrincipal" typeRef="string"><text>codigoPrincipal</text></inputExpression>
      </input>
      <input id="in_2_codigoSecundario" label="codigoSecundario ← TISS codigoProcedimento do outro ato (TUSS 22), mesma guia e dataExecucao">
        <inputExpression id="ie_2_codigoSecundario" typeRef="string"><text>codigoSecundario</text></inputExpression>
      </input>
      <output id="out_0_decisao" name="decisao" typeRef="string"/>
      <output id="out_1_motivoTab38" name="motivoTab38" typeRef="string"/>
      <output id="out_2_idRegra" name="idRegra" typeRef="string"/>
      <output id="out_3_fila" name="fila" typeRef="string"/>
      <output id="out_classeAdverso" name="classeAdverso" typeRef="string"/>
      <rule id="x_pre">
        <description>OMNI-TORAX-MEX-0001 — antes da vigência (2026-12-03)</description>
        <inputEntry><text>&lt; "2026-12-03"</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"liberar"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-TORAX-MEX-0001"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="x_dreno">
        <description>OMNI-TORAX-MEX-0001 — retirada de dreno com a drenagem do mesmo prestador na mesma guia: auditoria médica</description>
        <inputEntry><text>&gt;= "2026-12-03"</text></inputEntry>
        <inputEntry><text>"30804132"</text></inputEntry>
        <inputEntry><text>"30804116"</text></inputEntry>
        <outputEntry><text>"revisao_humana"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-TORAX-MEX-0001"</text></outputEntry>
        <outputEntry><text>"auditoria_medica"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="x_dreno_ok">
        <description>OMNI-TORAX-MEX-0001 — drenagem como ato principal com outro código: liberar</description>
        <inputEntry><text>&gt;= "2026-12-03"</text></inputEntry>
        <inputEntry><text>"30804132"</text></inputEntry>
        <inputEntry><text>not("30804116")</text></inputEntry>
        <outputEntry><text>"liberar"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-TORAX-MEX-0001"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="x_grande">
        <description>OMNI-TORAX-MEX-0001 — drenagem pleural fechada com cirurgia do tórax que a inclui: auditoria médica</description>
        <inputEntry><text>&gt;= "2026-12-03"</text></inputEntry>
        <inputEntry><text>"30801010", "30801028", "30801036", "30801052", "30801060", "30801079", "30801087", "30801109", "30801117", "30801133", "30801141", "30801150", "30801168", "30801176", "30802016", "30802024", "30802032", "30802040", "30802059", "30803012", "30803020", "30803039", "30803047", "30803055", "30803063", "30803071", "30803080", "30803098", "30803101", "30803110", "30803128", "30803136", "30803144", "30803152", "30803160", "30803179", "30803187", "30803195", "30803209", "30803217", "30803225", "30803233", "30804027", "30804035", "30804043", "30804051", "30804060", "30804094", "30804108", "30804124", "30804140", "30804159", "30804167", "30804175", "30804183", "30804191", "30804205", "30804213", "30805015", "30805031", "30805040", "30805074", "30805082", "30805090", "30805104", "30805112", "30805120", "30805139", "30805147", "30805155", "30805163", "30805171", "30805180", "30805198", "30805201", "30805210", "30805228", "30805236", "30805244", "30805252", "30805260", "30805279", "30805287", "30805295", "30806011", "30806020", "30806038", "30806046", "30806054", "30806062", "30806070"</text></inputEntry>
        <inputEntry><text>"30804132"</text></inputEntry>
        <outputEntry><text>"revisao_humana"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-TORAX-MEX-0001"</text></outputEntry>
        <outputEntry><text>"auditoria_medica"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="x_grande_ok">
        <description>OMNI-TORAX-MEX-0001 — cirurgia do tórax com outro código (inclusive o par permitido da bulectomia por vídeo): liberar</description>
        <inputEntry><text>&gt;= "2026-12-03"</text></inputEntry>
        <inputEntry><text>"30801010", "30801028", "30801036", "30801052", "30801060", "30801079", "30801087", "30801109", "30801117", "30801133", "30801141", "30801150", "30801168", "30801176", "30802016", "30802024", "30802032", "30802040", "30802059", "30803012", "30803020", "30803039", "30803047", "30803055", "30803063", "30803071", "30803080", "30803098", "30803101", "30803110", "30803128", "30803136", "30803144", "30803152", "30803160", "30803179", "30803187", "30803195", "30803209", "30803217", "30803225", "30803233", "30804027", "30804035", "30804043", "30804051", "30804060", "30804094", "30804108", "30804124", "30804140", "30804159", "30804167", "30804175", "30804183", "30804191", "30804205", "30804213", "30805015", "30805031", "30805040", "30805074", "30805082", "30805090", "30805104", "30805112", "30805120", "30805139", "30805147", "30805155", "30805163", "30805171", "30805180", "30805198", "30805201", "30805210", "30805228", "30805236", "30805244", "30805252", "30805260", "30805279", "30805287", "30805295", "30806011", "30806020", "30806038", "30806046", "30806054", "30806062", "30806070"</text></inputEntry>
        <inputEntry><text>not("30804132")</text></inputEntry>
        <outputEntry><text>"liberar"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-TORAX-MEX-0001"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="x_resto">
        <description>OMNI-TORAX-MEX-0001 — principal fora dos pares da regra: liberar</description>
        <inputEntry><text>&gt;= "2026-12-03"</text></inputEntry>
        <inputEntry><text>not("30801010", "30801028", "30801036", "30801052", "30801060", "30801079", "30801087", "30801109", "30801117", "30801133", "30801141", "30801150", "30801168", "30801176", "30802016", "30802024", "30802032", "30802040", "30802059", "30803012", "30803020", "30803039", "30803047", "30803055", "30803063", "30803071", "30803080", "30803098", "30803101", "30803110", "30803128", "30803136", "30803144", "30803152", "30803160", "30803179", "30803187", "30803195", "30803209", "30803217", "30803225", "30803233", "30804027", "30804035", "30804043", "30804051", "30804060", "30804094", "30804108", "30804124", "30804140", "30804159", "30804167", "30804175", "30804183", "30804191", "30804205", "30804213", "30805015", "30805031", "30805040", "30805074", "30805082", "30805090", "30805104", "30805112", "30805120", "30805139", "30805147", "30805155", "30805163", "30805171", "30805180", "30805198", "30805201", "30805210", "30805228", "30805236", "30805244", "30805252", "30805260", "30805279", "30805287", "30805295", "30806011", "30806020", "30806038", "30806046", "30806054", "30806062", "30806070", "30804132")</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"liberar"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-TORAX-MEX-0001"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="x_sem_data">
        <description>OMNI-TORAX-MEX-0001 — data ausente: faturamento (fechamento, nunca negativa)</description>
        <inputEntry><text>null</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"revisao_humana"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-TORAX-MEX-0001"</text></outputEntry>
        <outputEntry><text>"faturamento"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
