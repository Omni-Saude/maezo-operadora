<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:camunda="http://camunda.org/schema/1.0/dmn" id="def_torax_opme" name="Tórax: lista positiva de OPME por procedimento" namespace="https://omni-saude/dmn/torax-pneumologia">
  <decision id="rco_torax_opme" name="Tórax: lista positiva de OPME por procedimento" camunda:historyTimeToLive="P3650D">
    <description>OMNI-TORAX-OPM-0001 a 0003. Hit policy UNIQUE; nenhuma linha glosa: fora da lista, acima da quantidade ou sem categoria vai à auditoria médica; quantidade nula vai ao faturamento. Listas em regras/torax-pneumologia/dominio.yaml (listas_opme).</description>
    <decisionTable id="dt_torax_opme" hitPolicy="UNIQUE">
      <input id="in_0_dataAtendimento" label="dataAtendimento ← TISS dataSolicitacao (pedido) ou dataExecucao (conta), AAAA-MM-DD">
        <inputExpression id="ie_0_dataAtendimento" typeRef="string"><text>dataAtendimento</text></inputExpression>
      </input>
      <input id="in_1_codigoProcedimento" label="codigoProcedimento ← TISS codigoProcedimento (TUSS 22)">
        <inputExpression id="ie_1_codigoProcedimento" typeRef="string"><text>codigoProcedimento</text></inputExpression>
      </input>
      <input id="in_2_categoriaOpme" label="categoriaOpme ← cadastro OMNI de materiais (TISS codigoItem TUSS 19 → categoria da OMNI-TAB-OPME-0001)">
        <inputExpression id="ie_2_categoriaOpme" typeRef="string"><text>categoriaOpme</text></inputExpression>
      </input>
      <input id="in_3_quantidade" label="quantidade ← TISS quantidade da categoria de OPME por guia e dataExecucao">
        <inputExpression id="ie_3_quantidade" typeRef="integer"><text>quantidade</text></inputExpression>
      </input>
      <output id="out_0_decisao" name="decisao" typeRef="string"/>
      <output id="out_1_motivoTab38" name="motivoTab38" typeRef="string"/>
      <output id="out_2_idRegra" name="idRegra" typeRef="string"/>
      <output id="out_3_fila" name="fila" typeRef="string"/>
      <output id="out_classeAdverso" name="classeAdverso" typeRef="string"/>
      <rule id="o_pre">
        <description>OMNI-TORAX-OPM-0001 — antes da vigência (2026-12-03)</description>
        <inputEntry><text>&lt; "2026-12-03"</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"liberar"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-TORAX-OPM-0001"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="o1_carga_grampeador_ok">
