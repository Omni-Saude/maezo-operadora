<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:camunda="http://camunda.org/schema/1.0/dmn" id="def_torax_pacote" name="Tórax: enquadramento nos pacotes OMNI-PAC-TORAX-0001 a 0004" namespace="https://omni-saude/dmn/torax-pneumologia">
  <decision id="rco_torax_pacote" name="Tórax: enquadramento nos pacotes OMNI-PAC-TORAX-0001 a 0004" camunda:historyTimeToLive="P3650D">
    <description>OMNI-TORAX-PAC-0001, OMNI-TORAX-PAC-0002, OMNI-TORAX-PAC-0003, OMNI-TORAX-PAC-0004. Domínio torax-pneumologia. Hit policy UNIQUE; nenhuma linha nega ou glosa; urgência, caráter não informado e prestador sem pacote (inclusive não informado) vão à conta aberta, como as exclusões EXC-01 e EXC-02 dos pacotes; outro dado ausente vai à revisão humana; a linha de fechamento (data ausente) vai à regulação.</description>
    <decisionTable id="dt_torax_pacote" hitPolicy="UNIQUE">
      <input id="in_0_dataAtendimento" label="dataAtendimento ← TISS dataSolicitacao (pedido) ou dataExecucao (conta), AAAA-MM-DD">
        <inputExpression id="ie_0_dataAtendimento" typeRef="string"><text>dataAtendimento</text></inputExpression>
      </input>
      <input id="in_1_codigoProcedimentoPrincipal" label="codigoProcedimentoPrincipal ← TISS codigoProcedimento do procedimento principal da guia de resumo de internação (TUSS 22)">
        <inputExpression id="ie_1_codigoProcedimentoPrincipal" typeRef="string"><text>codigoProcedimentoPrincipal</text></inputExpression>
      </input>
      <input id="in_2_caraterAtendimento" label="caraterAtendimento ← TISS caraterAtendimento (TUSS 23: 1 eletivo, 2 urgência ou emergência)">
        <inputExpression id="ie_2_caraterAtendimento" typeRef="string"><text>caraterAtendimento</text></inputExpression>
      </input>
      <input id="in_3_prestadorComPacote" label="prestadorComPacote ← cadastro contratual: pacote OMNI-PAC-TORAX do procedimento vigente no contrato do prestador (booleano)">
        <inputExpression id="ie_3_prestadorComPacote" typeRef="boolean"><text>prestadorComPacote</text></inputExpression>
      </input>
      <input id="in_4_procedimentoCirurgicoAdicional" label="procedimentoCirurgicoAdicional ← TISS codigoProcedimento: a guia traz outro código cirúrgico (TUSS 22, grupo 3) fora do principal, das variantes e das inclusões do pacote">
        <inputExpression id="ie_4_procedimentoCirurgicoAdicional" typeRef="boolean"><text>procedimentoCirurgicoAdicional</text></inputExpression>
      </input>
      <input id="in_5_diasInternacao" label="diasInternacao ← derivado: dias entre TISS dataInicioFaturamento e dataFinalFaturamento da guia de resumo de internação (nulo no pedido)">
        <inputExpression id="ie_5_diasInternacao" typeRef="integer"><text>diasInternacao</text></inputExpression>
      </input>
      <output id="out_0_decisao" name="decisao" typeRef="string"/>
      <output id="out_1_motivoTab38" name="motivoTab38" typeRef="string"/>
      <output id="out_2_idRegra" name="idRegra" typeRef="string"/>
      <output id="out_3_fila" name="fila" typeRef="string"/>
      <output id="out_classeAdverso" name="classeAdverso" typeRef="string"/>
      <rule id="pre">
        <description>OMNI-TORAX-PAC-0001 — antes da vigência (03/12/2026): regras TORAX não se aplicam (conta aberta)</description>
        <inputEntry><text>&lt; "2026-12-03"</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"liberar"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-TORAX-PAC-0001"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="p1_pac">
        <description>OMNI-TORAX-PAC-0001 — cirurgia eletiva da pleura, eletiva, em prestador com o pacote OMNI-PAC-TORAX-0001, sem outro procedimento cirúrgico e com até 7 dias de internação (limite_revisao_dias do pacote, provisório): pagar o pacote (diária adicional acima do limiar)</description>
        <inputEntry><text>&gt;= "2026-12-03"</text></inputEntry>
        <inputEntry><text>"30804167", "30804183", "30804051", "30804191", "30804108", "30804035"</text></inputEntry>
        <inputEntry><text>"1"</text></inputEntry>
        <inputEntry><text>true</text></inputEntry>
        <inputEntry><text>false</text></inputEntry>
        <inputEntry><text>&lt;= 7</text></inputEntry>
        <outputEntry><text>"pagar_pacote"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-TORAX-PAC-0001"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="p1_longo">
        <description>OMNI-TORAX-PAC-0001 — internação acima de 7 dias (limite_revisao_dias do pacote, provisório): auditoria médica, sem suspender o pagamento do pacote</description>
        <inputEntry><text>&gt;= "2026-12-03"</text></inputEntry>
        <inputEntry><text>"30804167", "30804183", "30804051", "30804191", "30804108", "30804035"</text></inputEntry>
        <inputEntry><text>"1"</text></inputEntry>
        <inputEntry><text>true</text></inputEntry>
        <inputEntry><text>false</text></inputEntry>
        <inputEntry><text>&gt; 7</text></inputEntry>
        <outputEntry><text>"revisao_humana"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-TORAX-PAC-0001"</text></outputEntry>
        <outputEntry><text>"auditoria_medica"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="p1_pedido">
        <description>OMNI-TORAX-PAC-0001 — dias de internação ainda não informados (pedido ou guia sem resumo de internação): pagar o pacote; a contagem de dias é conferida na conta</description>
        <inputEntry><text>&gt;= "2026-12-03"</text></inputEntry>
        <inputEntry><text>"30804167", "30804183", "30804051", "30804191", "30804108", "30804035"</text></inputEntry>
        <inputEntry><text>"1"</text></inputEntry>
        <inputEntry><text>true</text></inputEntry>
