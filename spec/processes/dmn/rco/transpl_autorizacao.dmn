        <inputEntry><text>&gt;= "2026-11-03"</text></inputEntry>
        <inputEntry><text>"40403017", "40403050", "40403076", "40403084", "40403726", "40403742", "40403785", "40403793", "40403807", "40403815", "40403823", "40403912"</text></inputEntry>
