        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="a_amb_urg">
        <description>OMNI-TRANSPL-AUT-0001: etapa do TCTH em urgência (ANS-RN-465 art. 20 §4º)</description>
