      </rule>
      <rule id="a_fora">
        <description>Fechamento: código fora do escopo do domínio transplantes (sem efeito desta tabela)</description>
        <inputEntry><text>&gt;= "2026-11-03"</text></inputEntry>
        <inputEntry><text>not("31501010", "31505015", "31506011", "40401057", "31501028", "31505023", "31506038", "31506046", "40403033", "40402207", "40402215", "40403041", "40403734", "40403750", "40403769", "40403777", "40404013", "40404030", "40404048", "40404056", "40404064", "40404072", "40404080", "40404099", "40404137", "40404145", "40404170", "40404188", "40404196", "40404200", "40404218", "40404226", "40404234", "40404242", "40404269", "40404277", "40404285", "40403831", "40403017", "40403050", "40403076", "40403084", "40403726", "40403742", "40403785", "40403793", "40403807", "40403815", "40403823", "40403912")</text></inputEntry>
