<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:camunda="http://camunda.org/schema/1.0/dmn" id="def_urg_roteamento_opme" name="Pagamento e auditoria da OPME em urgência (OMNI-URG-OPM-0001, OMNI-URG-GLO-0001, OMNI-URG-PRZ-0001)" namespace="https://omni-saude/dmn/urgencia">
  <decision id="rco_urg_roteamento_opme" name="Pagamento e auditoria da OPME em urgência (OMNI-URG-OPM-0001, OMNI-URG-GLO-0001, OMNI-URG-PRZ-0001)" camunda:historyTimeToLive="P180D">
    <description>Urgência garante o acesso, não o pagamento (PROG-COORD-10): o item de OPME de urgência só é pago depois da comprovação de uso (etiquetaRastreabilidade = true, requisitos RAS-*); sem ela, ou sem a informação, o item fica pendente (exigir_documento), sem glosa, enquanto o prazo de envio da conta não vence; vencido o prazo (prazoComprovacaoUsoVencido), o item não é pago e é glosado com 3263, com recurso, e a justificativa do excedente ou da OPME fora da lista não recebida depois de 5 dias úteis da notificação também vai à glosa, ausente ou não informada (PROG-RCO-7b). Com a comprovação, a OPME é paga pelo valor de referência; a diferença acima da referência só é paga com justificativa aceita, com auditoria retrospectiva pela faixa do ECU. O procedimento nunca é glosado nem negado; nada é cobrado do beneficiário. OMNI-URG-OPM-0001, OMNI-URG-GLO-0001, OMNI-URG-PRZ-0001.</description>
    <decisionTable id="dt_urg_roteamento_opme" hitPolicy="UNIQUE">
      <input id="in_0_dataAtendimento" label="dataAtendimento ← TISS dataExecucao do procedimento principal (conta), AAAA-MM-DD">
        <inputExpression id="ie_0_dataAtendimento" typeRef="string"><text>dataAtendimento</text></inputExpression>
      </input>
      <input id="in_1_caraterAtendimento" label="caraterAtendimento ← TISS caraterAtendimento (TUSS 23: 1 eletivo, 2 urgência/emergência)">
        <inputExpression id="ie_1_caraterAtendimento" typeRef="string"><text>caraterAtendimento</text></inputExpression>
      </input>
      <input id="in_2_opmeNaGuia" label="opmeNaGuia ← TISS guia com item de OPME (TUSS 19) cobrado na conta">
        <inputExpression id="ie_2_opmeNaGuia" typeRef="boolean"><text>opmeNaGuia</text></inputExpression>
      </input>
      <input id="in_3_opmeNaLista" label="opmeNaLista ← cadastro OMNI: categoria de cada OPME da guia (TISS codigoMaterial, TUSS 19) na lista positiva do domínio e na quantidade máxima; nulo = categoria não identificada">
        <description>opmeNaLista ← cadastro OMNI: categoria de cada OPME da guia (TISS codigoMaterial, TUSS 19) na lista positiva do domínio e dentro da quantidade máxima; nulo = categoria não identificada (desde 16/12/2026: exigir_documento, item pendente; antes, tratado como na lista)</description>
        <inputExpression id="ie_3_opmeNaLista" typeRef="boolean"><text>opmeNaLista</text></inputExpression>
      </input>
      <input id="in_4_opmeAcimaReferencia" label="opmeAcimaReferencia ← TISS valor apresentado da OPME maior que o valor de referência da categoria (cadastro OMNI)">
        <inputExpression id="ie_4_opmeAcimaReferencia" typeRef="boolean"><text>opmeAcimaReferencia</text></inputExpression>
      </input>
      <input id="in_5_escoreEcu" label="escoreEcu ← Escore de Consistência da Urgência calculado pelo worker sobre campos TISS e de cadastro (regras/urgencia/dominio.yaml)">
        <inputExpression id="ie_5_escoreEcu" typeRef="integer"><text>escoreEcu</text></inputExpression>
      </input>
      <input id="in_6_documentacaoCompleta" label="documentacaoCompleta ← anexo da conta: justificativa técnica e documentação mínima da faixa do ECU recebidas">
        <inputExpression id="ie_6_documentacaoCompleta" typeRef="boolean"><text>documentacaoCompleta</text></inputExpression>
      </input>
      <input id="in_7_diasUteisDesdeNotificacao" label="diasUteisDesdeNotificacao ← fluxo Camunda: dias úteis desde a notificação da OMNI ao prestador pedindo a documentação (prazo de 5 dias úteis)">
        <inputExpression id="ie_7_diasUteisDesdeNotificacao" typeRef="integer"><text>diasUteisDesdeNotificacao</text></inputExpression>
      </input>
      <input id="in_8_etiquetaRastreabilidade" label="etiquetaRastreabilidade ← anexo da conta: comprovação de uso da OPME enviada (etiqueta do implante, embalagem com etiqueta ou radiografia de controle; requisitos RAS-* de OMNI-TAB-OPME-0001), booleano">
        <inputExpression id="ie_8_etiquetaRastreabilidade" typeRef="boolean"><text>etiquetaRastreabilidade</text></inputExpression>
      </input>
      <input id="in_9_prazoComprovacaoUsoVencido" label="prazoComprovacaoUsoVencido ← cálculo do worker sobre a guia TISS (dataFinalFaturamento ou dataExecucao) e o anexo da conta: passou o prazo de envio da conta (OMNI-GERAL-GLO-0002, condicoes.periodo_dias) sem a comprovação de uso da OPME (booleano)">
        <inputExpression id="ie_9_prazoComprovacaoUsoVencido" typeRef="boolean"><text>prazoComprovacaoUsoVencido</text></inputExpression>
      </input>
      <input id="in_10_documentacaoOpmeNaoRecebidaNoPrazo" label="documentacaoOpmeNaoRecebidaNoPrazo ← fluxo Camunda e registro de recebimento: prazo de OMNI-URG-GLO-0001 vencido sem a documentação mínima (nulo = não calculado, nunca glosa)">
        <description>documentacaoOpmeNaoRecebidaNoPrazo ← cálculo da OMNI sobre o registro de recebimento da justificativa (portal ou anexo da conta) e o fluxo Camunda: passaram 5 dias úteis da notificação ao prestador (prazo de OMNI-URG-GLO-0001, efeito.prazos) sem a justificativa técnica e a documentação mínima recebidas (booleano; nulo = não calculado, nunca glosa)</description>
        <inputExpression id="ie_10_documentacaoOpmeNaoRecebidaNoPrazo" typeRef="boolean"><text>documentacaoOpmeNaoRecebidaNoPrazo</text></inputExpression>
      </input>
      <output id="out_decisao" name="decisao" typeRef="string"/>
      <output id="out_motivoTab38" name="motivoTab38" typeRef="string"/>
      <output id="out_idRegra" name="idRegra" typeRef="string"/>
      <output id="out_fila" name="fila" typeRef="string"/>
      <output id="out_classeAdverso" name="classeAdverso" typeRef="string"/>
      <rule id="r000">
        <description>OMNI-URG-OPM-0001 — fora da vigência (antes de 03/11/2026): a regra URG não se aplica</description>
        <inputEntry><text>&lt; "2026-11-03"</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"liberar"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-URG-OPM-0001"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="r002">
