      </rule>
      <rule id="c_resto">
        <description>OMNI-URO-COB-0001 — procedimento do Rol ou de outro domínio: sem restrição desta tabela</description>
        <inputEntry><text>&gt;= "2026-12-03"</text></inputEntry>
        <inputEntry><text>not("31103510", "31103545", "31103553", "31103570", "31103588", "31201059", "31201083", "31201156", "31201164", "31101496", "31101500", "31101593", "31102492", "31102506", "31102522", "31102573", "31102581", "31104258", "31104266", "31202055", "31203140", "31203159", "31205089", "31206131", "31201032", "31201040", "31101240", "31102310", "31103103")</text></inputEntry>
