        <outputEntry><text>"auditoria_medica"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="c_bio">
        <description>OMNI-URO-COB-0006 — biópsia prostática ou rebiópsia: cobertura pelo Rol, sem critério próprio</description>
        <inputEntry><text>&gt;= "2026-12-03"</text></inputEntry>
        <inputEntry><text>"31201032", "31201040"</text></inputEntry>
        <inputEntry><text>not("31201032", "31201040")</text></inputEntry>
        <outputEntry><text>"liberar"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-URO-COB-0006"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="c_leoc_1">
        <description>OMNI-URO-COB-0007 — primeira sessão 31101240 e reaplicação 31101259 na mesma guia: auditoria médica</description>
        <inputEntry><text>&gt;= "2026-12-03"</text></inputEntry>
        <inputEntry><text>"31101240"</text></inputEntry>
        <inputEntry><text>"31101259"</text></inputEntry>
        <outputEntry><text>"revisao_humana"</text></outputEntry>
