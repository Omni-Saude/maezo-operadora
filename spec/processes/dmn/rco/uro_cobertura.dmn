      <rule id="c_leoc_3">
        <description>OMNI-URO-COB-0007 — primeira sessão 31103103 e reaplicação 31103111 na mesma guia: auditoria médica</description>
        <inputEntry><text>&gt;= "2026-12-03"</text></inputEntry>
        <inputEntry><text>"31103103"</text></inputEntry>
