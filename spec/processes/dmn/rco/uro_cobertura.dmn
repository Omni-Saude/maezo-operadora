      <rule id="c_fora_6">
        <description>OMNI-URO-COB-0008 — procedimento sem correlação no Rol: auditoria médica (Lei 9.656 art. 10 §13), sem negativa</description>
        <inputEntry><text>&gt;= "2026-12-03"</text></inputEntry>
        <inputEntry><text>"31202055", "31203140", "31203159", "31205089", "31206131"</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"revisao_humana"</text></outputEntry>
