<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:camunda="http://camunda.org/schema/1.0/dmn" id="def_uro_pacote" name="Urologia: enquadramento e permanência dos pacotes URO (OMNI-PAC-URO-0001 a 0008)" namespace="https://omni-saude/dmn/urologia">
  <decision id="rco_uro_pacote" name="Urologia: enquadramento e permanência dos pacotes URO (OMNI-PAC-URO-0001 a 0008)" camunda:historyTimeToLive="P3650D">
    <description>OMNI-URO-PAC-0001, OMNI-URO-PAC-0002, OMNI-URO-PAC-0003, OMNI-URO-PAC-0004, OMNI-URO-PAC-0005, OMNI-URO-PAC-0006, OMNI-URO-PAC-0007, OMNI-URO-PAC-0008, OMNI-URO-PAC-0009. Enquadra a conta no pacote OMNI-PAC-URO do procedimento principal e aplica o outlier de permanência (limiares provisórios, URO-PAC-03; validacao/calibracao/parametros-provisorios.csv). Urgência, caráter não informado e prestador sem pacote ficam em conta aberta. Hit policy UNIQUE; nenhuma linha nega ou glosa; nenhum desvio muda a cobertura, só a forma de pagar o prestador; a linha de fechamento (data ausente) vai à revisão humana.</description>
    <decisionTable id="dt_uro_pacote" hitPolicy="UNIQUE">
      <input id="in_0_dataAtendimento" label="dataAtendimento ← TISS dataExecucao do procedimento principal, AAAA-MM-DD">
        <inputExpression id="ie_0_dataAtendimento" typeRef="string"><text>dataAtendimento</text></inputExpression>
      </input>
      <input id="in_1_codigoProcedimentoPrincipal" label="codigoProcedimentoPrincipal ← TISS codigoProcedimento do procedimento principal da guia de resumo de internação (TUSS 22)">
        <inputExpression id="ie_1_codigoProcedimentoPrincipal" typeRef="string"><text>codigoProcedimentoPrincipal</text></inputExpression>
      </input>
      <input id="in_2_caraterAtendimento" label="caraterAtendimento ← TISS caraterAtendimento (TUSS 23: 1 eletivo, 2 urgência/emergência)">
        <inputExpression id="ie_2_caraterAtendimento" typeRef="string"><text>caraterAtendimento</text></inputExpression>
      </input>
      <input id="in_3_prestadorComPacote" label="prestadorComPacote ← cadastro contratual: pacote OMNI-PAC-URO do procedimento vigente no anexo do contrato do prestador (booleano)">
        <inputExpression id="ie_3_prestadorComPacote" typeRef="boolean"><text>prestadorComPacote</text></inputExpression>
      </input>
      <input id="in_4_diasInternacao" label="diasInternacao ← resumo de internação TISS: data da alta menos data da internação, em dias">
        <inputExpression id="ie_4_diasInternacao" typeRef="integer"><text>diasInternacao</text></inputExpression>
      </input>
      <output id="out_0_decisao" name="decisao" typeRef="string"/>
      <output id="out_1_motivoTab38" name="motivoTab38" typeRef="string"/>
      <output id="out_2_idRegra" name="idRegra" typeRef="string"/>
      <output id="out_3_fila" name="fila" typeRef="string"/>
      <output id="out_classeAdverso" name="classeAdverso" typeRef="string"/>
      <rule id="p_pre">
        <description>OMNI-URO-PAC-0005 — antes da vigência (03/12/2026): pacotes URO não se aplicam, conta aberta</description>
        <inputEntry><text>&lt; "2026-12-03"</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"liberar"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-URO-PAC-0005"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="p_fora">
        <description>OMNI-URO-PAC-0005 — procedimento principal fora dos pacotes URO: conta aberta, sem efeito desta tabela</description>
        <inputEntry><text>&gt;= "2026-12-03"</text></inputEntry>
        <inputEntry><text>not("31101240", "31102310", "31103103", "31101259", "31102328", "31103111", "31201130", "31102050", "31102034", "31102077", "31101550", "31101488", "31101569", "31101585", "31101518", "31101526", "31101615", "31101534", "31102514", "31102530", "31102549", "31101542", "31103529", "31201148", "31203132", "31103537", "31102557", "31101275", "31101224", "31101577", "31103456", "31103391", "31103448", "31102379", "31102360", "31102565", "31102220")</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"liberar"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>"OMNI-URO-PAC-0005"</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
        <outputEntry><text>""</text></outputEntry>
      </rule>
      <rule id="p0001_urg">
        <description>OMNI-URO-PAC-0001 — urgência ou caráter não informado (EXC-01): conta aberta, sujeita às edições automáticas</description>
        <inputEntry><text>&gt;= "2026-12-03"</text></inputEntry>
        <inputEntry><text>"31101240", "31102310", "31103103", "31101259", "31102328", "31103111"</text></inputEntry>
        <inputEntry><text>not("1")</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
