        <inputEntry id="r_exposicao_valor_humano_i7"><text>-</text></inputEntry>
        <inputEntry id="r_exposicao_valor_humano_i8"><text>-</text></inputEntry>
        <inputEntry id="r_exposicao_valor_humano_i9"><text>-</text></inputEntry>
        <inputEntry id="r_exposicao_valor_humano_i10"><text>-</text></inputEntry>
        <inputEntry id="r_exposicao_valor_humano_i11"><text>-</text></inputEntry>
        <inputEntry id="r_exposicao_valor_humano_i12"><text>&gt; limite_valor_auto_benef_30d_cents - valor_solicitado_cents</text></inputEntry>
        <inputEntry id="r_exposicao_valor_humano_i13"><text>-</text></inputEntry>
        <inputEntry id="r_exposicao_valor_humano_i14"><text>-</text></inputEntry>
        <inputEntry id="r_exposicao_valor_humano_i15"><text>-</text></inputEntry>
        <outputEntry id="r_exposicao_valor_humano_o1"><text>"ANALISE_HUMANA"</text></outputEntry>
        <outputEntry id="r_exposicao_valor_humano_o2"><text>"Limite de valor automatico do beneficiario em 30 dias atingido — analise humana"</text></outputEntry>
        <outputEntry id="r_exposicao_valor_humano_o3"><text>null</text></outputEntry>
      </rule>
      <rule id="r_orcamento_tenant_humano">
        <description>Orcamento diario da faixa automatica do tenant esgotado -&gt; humano</description>
        <inputEntry id="r_orcamento_tenant_humano_i1"><text>-</text></inputEntry>
        <inputEntry id="r_orcamento_tenant_humano_i2"><text>-</text></inputEntry>
        <inputEntry id="r_orcamento_tenant_humano_i3"><text>-</text></inputEntry>
