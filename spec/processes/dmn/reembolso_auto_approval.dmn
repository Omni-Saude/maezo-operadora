        <inputEntry id="r_exposicao_humano_i10"><text>&gt;= limite_aprovacoes_auto_benef_30d</text></inputEntry>
        <inputEntry id="r_exposicao_humano_i11"><text>-</text></inputEntry>
        <inputEntry id="r_exposicao_humano_i12"><text>-</text></inputEntry>
        <inputEntry id="r_exposicao_humano_i13"><text>-</text></inputEntry>
