        <outputEntry id="r_exposicao_humano_o2"><text>"Limite de aprovacoes automaticas do beneficiario em 30 dias atingido — analise humana"</text></outputEntry>
        <outputEntry id="r_exposicao_humano_o3"><text>null</text></outputEntry>
      </rule>
      <rule id="r_exposicao_valor_humano">
        <description>Exposicao acumulada do beneficiario (valor) esgotada -&gt; humano</description>
        <inputEntry id="r_exposicao_valor_humano_i1"><text>-</text></inputEntry>
        <inputEntry id="r_exposicao_valor_humano_i2"><text>-</text></inputEntry>
        <inputEntry id="r_exposicao_valor_humano_i3"><text>-</text></inputEntry>
