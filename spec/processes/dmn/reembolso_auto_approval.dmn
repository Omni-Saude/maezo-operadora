        <inputEntry id="r_acima_teto_humano_i14"><text>-</text></inputEntry>
        <inputEntry id="r_acima_teto_humano_i15"><text>-</text></inputEntry>
        <outputEntry id="r_acima_teto_humano_o1"><text>"ANALISE_HUMANA"</text></outputEntry>
        <outputEntry id="r_acima_teto_humano_o2"><text>"Valor solicitado acima do teto L2 do tenant (ou teto 0) — analise humana; o teto nunca reduz o pagamento"</text></outputEntry>
        <outputEntry id="r_acima_teto_humano_o3"><text>null</text></outputEntry>
      </rule>
      <rule id="r_exposicao_humano">
        <description>Exposicao acumulada do beneficiario (quantidade) esgotada -&gt; humano</description>
        <inputEntry id="r_exposicao_humano_i1"><text>-</text></inputEntry>
        <inputEntry id="r_exposicao_humano_i2"><text>-</text></inputEntry>
        <inputEntry id="r_exposicao_humano_i3"><text>-</text></inputEntry>
