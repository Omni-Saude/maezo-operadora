        <inputEntry id="r_orcamento_tenant_humano_i13"><text>-</text></inputEntry>
        <inputEntry id="r_orcamento_tenant_humano_i14"><text>&gt; orcamento_auto_tenant_dia_cents - valor_solicitado_cents</text></inputEntry>
        <inputEntry id="r_orcamento_tenant_humano_i15"><text>-</text></inputEntry>
        <outputEntry id="r_orcamento_tenant_humano_o1"><text>"ANALISE_HUMANA"</text></outputEntry>
        <outputEntry id="r_orcamento_tenant_humano_o2"><text>"Orcamento diario da faixa automatica do tenant atingido — analise humana"</text></outputEntry>
        <outputEntry id="r_orcamento_tenant_humano_o3"><text>null</text></outputEntry>
      </rule>
      <rule id="r_auto">
        <description>Todas as condicoes da opcao B verdadeiras -&gt; aprovacao INTEGRAL automatica do valor solicitado (= min(solicitado, limite contratual, teto), pois o solicitado nao excede nenhum deles)</description>
        <inputEntry id="r_auto_i1"><text>false</text></inputEntry>
        <inputEntry id="r_auto_i2"><text>false</text></inputEntry>
        <inputEntry id="r_auto_i3"><text>"livre_escolha"</text></inputEntry>
        <inputEntry id="r_auto_i4"><text>"consulta"</text></inputEntry>
        <inputEntry id="r_auto_i5"><text>true</text></inputEntry>
        <inputEntry id="r_auto_i6"><text>&gt; 0</text></inputEntry>
        <inputEntry id="r_auto_i7"><text>&gt;= valor_solicitado_cents</text></inputEntry>
        <inputEntry id="r_auto_i8"><text>&gt;= valor_solicitado_cents</text></inputEntry>
        <inputEntry id="r_auto_i9"><text>&gt;= valor_solicitado_cents</text></inputEntry>
        <inputEntry id="r_auto_i10"><text>&lt; limite_aprovacoes_auto_benef_30d</text></inputEntry>
        <inputEntry id="r_auto_i11"><text>&gt; 0</text></inputEntry>
        <inputEntry id="r_auto_i12"><text>&lt;= limite_valor_auto_benef_30d_cents - valor_solicitado_cents</text></inputEntry>
        <inputEntry id="r_auto_i13"><text>&gt; 0</text></inputEntry>
        <inputEntry id="r_auto_i14"><text>&lt;= orcamento_auto_tenant_dia_cents - valor_solicitado_cents</text></inputEntry>
        <inputEntry id="r_auto_i15"><text>&gt; 0</text></inputEntry>
        <outputEntry id="r_auto_o1"><text>"AUTO_APROVAR"</text></outputEntry>
        <outputEntry id="r_auto_o2"><text>"Opcao B: dentro da tabela, do limite contratual, do teto e da exposicao, NF verificada, sem merito clinico — aprovacao integral automatica (nunca parcial)"</text></outputEntry>
        <outputEntry id="r_auto_o3"><text>valor_solicitado_cents</text></outputEntry>
      </rule>
      <rule id="r_auto_catchall">
        <description>Catch-all FAIL-SAFE: qualquer fato ausente/nulo ou combinacao nao mapeada -&gt; humano; nunca auto-aprovar por omissao</description>
        <inputEntry id="r_auto_catchall_i1"><text>-</text></inputEntry>
        <inputEntry id="r_auto_catchall_i2"><text>-</text></inputEntry>
        <inputEntry id="r_auto_catchall_i3"><text>-</text></inputEntry>
        <inputEntry id="r_auto_catchall_i4"><text>-</text></inputEntry>
        <inputEntry id="r_auto_catchall_i5"><text>-</text></inputEntry>
        <inputEntry id="r_auto_catchall_i6"><text>-</text></inputEntry>
        <inputEntry id="r_auto_catchall_i7"><text>-</text></inputEntry>
        <inputEntry id="r_auto_catchall_i8"><text>-</text></inputEntry>
        <inputEntry id="r_auto_catchall_i9"><text>-</text></inputEntry>
        <inputEntry id="r_auto_catchall_i10"><text>-</text></inputEntry>
        <inputEntry id="r_auto_catchall_i11"><text>-</text></inputEntry>
        <inputEntry id="r_auto_catchall_i12"><text>-</text></inputEntry>
        <inputEntry id="r_auto_catchall_i13"><text>-</text></inputEntry>
        <inputEntry id="r_auto_catchall_i14"><text>-</text></inputEntry>
        <inputEntry id="r_auto_catchall_i15"><text>-</text></inputEntry>
        <outputEntry id="r_auto_catchall_o1"><text>"ANALISE_HUMANA"</text></outputEntry>
        <outputEntry id="r_auto_catchall_o2"><text>"Combinacao nao mapeada ou fato ausente — analise humana por seguranca (nunca auto-aprova; nunca reduz)"</text></outputEntry>
        <outputEntry id="r_auto_catchall_o3"><text>null</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
</definitions>
