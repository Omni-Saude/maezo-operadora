      <rule id="r_auto">
        <description>Todas as condicoes da opcao B verdadeiras -&gt; aprovacao INTEGRAL automatica do valor solicitado (= min(solicitado, limite contratual, teto), pois o solicitado nao excede nenhum dos dois)</description>
        <inputEntry id="r_auto_i1"><text>false</text></inputEntry>
        <inputEntry id="r_auto_i2"><text>false</text></inputEntry>
        <inputEntry id="r_auto_i3"><text>"livre_escolha"</text></inputEntry>
        <inputEntry id="r_auto_i4"><text>"consulta"</text></inputEntry>
        <inputEntry id="r_auto_i5"><text>true</text></inputEntry>
        <inputEntry id="r_auto_i6"><text>true</text></inputEntry>
        <inputEntry id="r_auto_i7"><text>true</text></inputEntry>
        <inputEntry id="r_auto_i8"><text>&gt; 0</text></inputEntry>
        <inputEntry id="r_auto_i9"><text>&gt;= valor_solicitado_cents</text></inputEntry>
        <inputEntry id="r_auto_i10"><text>&gt;= valor_solicitado_cents</text></inputEntry>
        <inputEntry id="r_auto_i11"><text>&gt;= valor_solicitado_cents</text></inputEntry>
        <inputEntry id="r_auto_i12"><text>&lt; limite_aprovacoes_auto_benef_30d</text></inputEntry>
        <inputEntry id="r_auto_i13"><text>&gt; 0</text></inputEntry>
        <inputEntry id="r_auto_i14"><text>&lt;= limite_valor_auto_benef_30d_cents - valor_solicitado_cents</text></inputEntry>
        <inputEntry id="r_auto_i15"><text>&gt; 0</text></inputEntry>
        <inputEntry id="r_auto_i16"><text>&lt;= orcamento_auto_tenant_dia_cents - valor_solicitado_cents</text></inputEntry>
        <inputEntry id="r_auto_i17"><text>&gt; 0</text></inputEntry>
        <outputEntry id="r_auto_o1"><text>"AUTO_APROVAR"</text></outputEntry>
        <outputEntry id="r_auto_o2"><text>"Opcao B: dentro da tabela, do limite contratual, do teto e da exposicao, NF verificada, sem merito clinico — aprovacao integral automatica (nunca parcial)"</text></outputEntry>
        <outputEntry id="r_auto_o3"><text>valor_solicitado_cents</text></outputEntry>
      </rule>
