<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <!--
    T1.7a (docs/plans/portal-autoridade-nativa-dev.md, secao 3.1): provedor Q2 PortalReadTrust.Providers
    recortado ao escopo staff. Pacote qualificado a parte (src/maezo/portal/engine/README.md): o JAR so
    entra na imagem INSTALL_PORTAL_READ=true. Depende do JAR do engine como `provided`; o CI instala
    esse JAR antes (`mvn install` do modulo ../java).
  -->
  <modelVersion>4.0.0</modelVersion>
  <groupId>br.com.maezo</groupId>
  <artifactId>maezo-portal-read-provider</artifactId>
  <version>1.0.0</version>
  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.build.outputTimestamp>2026-09-23T00:00:00Z</project.build.outputTimestamp>
    <provider.jar>${project.build.directory}/${project.build.finalName}.jar</provider.jar>
  </properties>
  <dependencies>
    <dependency><groupId>br.com.maezo</groupId><artifactId>human-command-engine</artifactId><version>1.0.0</version><scope>provided</scope></dependency>
    <!-- Only the tests build a ProcessEngineConfiguration around the real PortalReadPlugin. -->
    <dependency><groupId>org.cibseven.bpm</groupId><artifactId>cibseven-engine</artifactId><version>2.1.0</version><scope>test</scope></dependency>
    <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><version>5.11.4</version><scope>test</scope></dependency>
    <dependency><groupId>org.postgresql</groupId><artifactId>postgresql</artifactId><version>42.7.12</version><scope>test</scope></dependency>
  </dependencies>
  <build><plugins>
    <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-resources-plugin</artifactId><version>3.3.1</version></plugin>
    <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId><version>3.13.0</version></plugin>
    <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-jar-plugin</artifactId><version>3.4.2</version></plugin>
    <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId><version>3.5.2</version>
      <configuration>
        <excludes><exclude>**/*JarIT.java</exclude></excludes>
        <failIfNoTests>true</failIfNoTests>
        <systemPropertyVariables>
          <!-- T1.7b: the JCS parity vector shared with tests/unit/portal/test_jcs_membership_vector.py -->
          <maezo.jcs.vector>${project.basedir}/../../../../../tests/fixtures/portal_read/jcs-membership-vector.json</maezo.jcs.vector>
          <!-- H1/H2 (D-N): the human admission block + resource publication contract, shared with the Python H2 -->
          <maezo.jcs.resource.vector>${project.basedir}/../../../../../tests/fixtures/portal_read/jcs-resource-vector.json</maezo.jcs.resource.vector>
        </systemPropertyVariables>
      </configuration>
      <executions>
        <!--
          The admission pins the SHA-256 of the provider JAR actually loaded (CodeSource). These
          tests therefore run AFTER `package`, against the built JAR instead of target/classes, with
          the same two environment variables the engine image uses. They need PostgreSQL
          (MAEZO_READ_PROVIDER_IT_JDBC_URL/_USER/_PASSWORD) and fail, never skip, without it.
        -->
        <execution><id>provider-jar-it</id><phase>integration-test</phase><goals><goal>test</goal></goals>
          <configuration>
            <classesDirectory>${provider.jar}</classesDirectory>
            <includes combine.self="override"><include>**/*JarIT.java</include></includes>
            <excludes combine.self="override"><exclude>**/*Test.java</exclude></excludes>
            <failIfNoTests>true</failIfNoTests>
            <systemPropertyVariables>
              <java.naming.factory.initial>br.com.maezo.human.readprovider.TestNaming</java.naming.factory.initial>
              <maezo.provider.jar>${provider.jar}</maezo.provider.jar>
            </systemPropertyVariables>
            <environmentVariables>
              <MAEZO_PORTAL_READ_TRUST_FILE>${project.build.directory}/provider-it/portal-read-trust.json</MAEZO_PORTAL_READ_TRUST_FILE>
              <MAEZO_PORTAL_READ_PROVIDER_FILE>${project.build.directory}/provider-it/portal-read-provider.json</MAEZO_PORTAL_READ_PROVIDER_FILE>
            </environmentVariables>
          </configuration>
        </execution>
      </executions>
    </plugin>
  </plugins></build>
</project>
