{
  "components": {
    "schemas": {
      "Centavos": {
        "description": "Canonical browser representation of an exact integer number of centavos.\n\nThere is intentionally no business ceiling and no signed-int64 restriction in this value\nobject: SP-OP-PAGTO-001 requires an integer but does not declare either bound.  Conversion is\ndirect from the canonical decimal string and never passes through float/JavaScript Number.",
        "pattern": "^(?:0|-[1-9][0-9]*|[1-9][0-9]*)$",
        "title": "Centavos",
        "type": "string"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "PagtoAdmissibilityEvidence": {
        "additionalProperties": false,
        "description": "Closed read-only PAGTO projection; evidence does not confer financial approval.",
        "properties": {
          "dados_pagamento_validos": {
            "title": "Dados Pagamento Validos",
            "type": "boolean"
          },
          "duplicidade_suspeita": {
            "title": "Duplicidade Suspeita",
            "type": "boolean"
          },
          "kind": {
            "const": "pagto_admissibilidade",
            "title": "Kind",
            "type": "string"
          },
          "lastro_confirmado": {
            "title": "Lastro Confirmado",
            "type": "boolean"
          },
          "lastro_decisor_id": {
            "anyOf": [
              {
                "maxLength": 512,
                "minLength": 1,
                "pattern": "^[^\\s\\x00-\\x1f\\x7f/?#]+$",
                "type": "string"
              },
              {
                "const": "",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Lastro Decisor Id"
          },
          "lastro_origem": {
            "anyOf": [
              {
                "enum": [
                  "contas_adjudicacao_automatica",
                  "contas_adjudicacao_humana",
                  "recurso_deferimento_humano"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Lastro Origem"
          },
          "valor_pagamento_cents": {
            "$ref": "#/components/schemas/Centavos"
          }
        },
        "required": [
          "kind",
          "valor_pagamento_cents",
          "dados_pagamento_validos",
          "lastro_confirmado",
          "duplicidade_suspeita"
        ],
        "title": "PagtoAdmissibilityEvidence",
        "type": "object"
      },
      "PortalReadError": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "enum": [
              "invalid_request",
              "session_unavailable",
              "employee_access_required",
              "resource_unavailable",
              "refresh_required",
              "read_dependency_unavailable"
            ],
            "title": "Code",
            "type": "string"
          },
          "schema": {
            "const": "portal-read-error.v1",
            "default": "portal-read-error.v1",
            "title": "Schema",
            "type": "string"
          }
        },
        "required": [
          "code"
        ],
        "title": "PortalReadError",
        "type": "object"
      },
      "PublicTaskSnapshot": {
        "additionalProperties": false,
        "properties": {
          "allowed_actions": {
            "default": [],
            "maxItems": 0,
            "minItems": 0,
            "title": "Allowed Actions",
            "type": "array"
          },
          "allowed_inputs": {
            "items": {
              "enum": [
                "decisao_auditor",
                "justificativa_clinica",
                "cid10_referencia",
                "fundamentacao_dut",
                "resultado",
                "notas_resolucao",
                "decisao_admissibilidade",
                "justificativa_recusa",
                "decisao_contas",
                "justificativa_glosa",
                "codigo_glosa_tiss",
                "valor_glosado_centavos",
                "valor_liberado_centavos",
                "justificativa_devolucao",
                "decisao_coordenacao",
                "decisao_recurso",
                "fundamentacao_indeferimento",
                "valor_glosa_mantido_centavos",
                "valor_deferido_centavos",
                "referencia_contratual",
                "desfecho_humano",
                "decisao_auditor_recurso",
                "parecer_auditor",
                "decisao_pendencia",
                "decisao_reembolso",
                "valor_reembolso_aprovado_cents",
                "justificativa",
                "fundamentacao_contratual",
                "decisao_cancelamento",
                "decisao_inadimplencia",
                "comprovacao_periodo_minimo",
                "data_efeito_iso",
                "referencia_regulatoria",
                "comprovacao_notificacao_previa",
                "decisao_programa",
                "motivo_desligamento_clinico",
                "referencia_clinica"
              ],
              "type": "string"
            },
            "title": "Allowed Inputs",
            "type": "array"
          },
          "assignee_ref": {
            "anyOf": [
              {
                "maxLength": 512,
                "minLength": 1,
                "pattern": "^[^\\s\\x00-\\x1f\\x7f/?#]+$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Assignee Ref"
          },
          "eligible_candidate_groups": {
            "items": {
              "maxLength": 512,
              "minLength": 1,
              "pattern": "^[^\\s\\x00-\\x1f\\x7f/?#]+$",
              "type": "string"
            },
            "title": "Eligible Candidate Groups",
            "type": "array"
          },
          "engine_due_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Engine Due At"
          },
          "evidence_digest": {
            "pattern": "^[0-9a-f]{64}$",
            "title": "Evidence Digest",
            "type": "string"
          },
          "evidence_revision": {
            "pattern": "^(0|[1-9][0-9]*)$",
            "title": "Evidence Revision",
            "type": "string"
          },
          "form_digest": {
            "pattern": "^[0-9a-f]{64}$",
            "title": "Form Digest",
            "type": "string"
          },
          "form_key": {
            "enum": [
              "auth_decisao",
              "auth_junta",
              "escalation",
              "pagto_admissibilidade",
              "contas_decisao",
              "contas_coordenacao",
              "recurso_decisao",
              "recurso_coordenacao",
              "recurso_auditor",
              "reembolso_pendencia",
              "reembolso_decisao",
              "reembolso_auditor",
              "cancel_decisao",
              "inad_decisao",
              "programa_decisao"
            ],
            "title": "Form Key",
            "type": "string"
          },
          "form_source_status": {
            "enum": [
              "BPMN_FORMDATA",
              "BPMN_TASK_DOCUMENTATION_DRAFT_VERIFY"
            ],
            "title": "Form Source Status",
            "type": "string"
          },
          "form_version": {
            "pattern": "^[1-9][0-9]*$",
            "title": "Form Version",
            "type": "string"
          },
          "process_definition_digest": {
            "pattern": "^[0-9a-f]{64}$",
            "title": "Process Definition Digest",
            "type": "string"
          },
          "process_definition_id": {
            "maxLength": 512,
            "minLength": 1,
            "pattern": "^[^\\s\\x00-\\x1f\\x7f/?#]+$",
            "title": "Process Definition Id",
            "type": "string"
          },
          "process_definition_key": {
            "maxLength": 512,
            "minLength": 1,
            "pattern": "^[^\\s\\x00-\\x1f\\x7f/?#]+$",
            "title": "Process Definition Key",
            "type": "string"
          },
          "process_definition_version": {
            "pattern": "^[1-9][0-9]*$",
            "title": "Process Definition Version",
            "type": "string"
          },
          "read_only_evidence": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PagtoAdmissibilityEvidence"
              },
              {
                "type": "null"
              }
            ]
          },
          "schema_version": {
            "maximum": 1.0,
            "minimum": 1.0,
            "title": "Schema Version",
            "type": "integer"
          },
          "snapshot_at": {
            "format": "date-time",
            "title": "Snapshot At",
            "type": "string"
          },
          "task_definition_key": {
            "maxLength": 512,
            "minLength": 1,
            "pattern": "^[^\\s\\x00-\\x1f\\x7f/?#]+$",
            "title": "Task Definition Key",
            "type": "string"
          },
          "task_id": {
            "maxLength": 512,
            "minLength": 1,
            "pattern": "^[^\\s\\x00-\\x1f\\x7f/?#]+$",
            "title": "Task Id",
            "type": "string"
          },
          "task_revision": {
            "pattern": "^(0|[1-9][0-9]*)$",
            "title": "Task Revision",
            "type": "string"
          }
        },
        "required": [
          "schema_version",
          "snapshot_at",
          "task_id",
          "process_definition_key",
          "process_definition_version",
          "process_definition_id",
          "process_definition_digest",
          "task_definition_key",
          "form_key",
          "form_version",
          "form_digest",
          "form_source_status",
          "task_revision",
          "assignee_ref",
          "eligible_candidate_groups",
          "evidence_revision",
          "evidence_digest",
          "engine_due_at",
          "allowed_inputs",
          "read_only_evidence"
        ],
        "title": "PublicTaskSnapshot",
        "type": "object"
      },
      "QueueFreshness": {
        "additionalProperties": false,
        "properties": {
          "observed_at": {
            "format": "date-time",
            "title": "Observed At",
            "type": "string"
          },
          "refresh_after_seconds": {
            "const": 10,
            "default": 10,
            "title": "Refresh After Seconds",
            "type": "integer"
          },
          "source_observed_at": {
            "format": "date-time",
            "title": "Source Observed At",
            "type": "string"
          },
          "state": {
            "const": "current",
            "default": "current",
            "title": "State",
            "type": "string"
          },
          "valid_until": {
            "format": "date-time",
            "title": "Valid Until",
            "type": "string"
          }
        },
        "required": [
          "observed_at",
          "source_observed_at",
          "valid_until"
        ],
        "title": "QueueFreshness",
        "type": "object"
      },
      "SessionDTO": {
        "additionalProperties": false,
        "description": "Minimal browser projection, never a principal accepted back as authority.",
        "properties": {
          "audience": {
            "enum": [
              "staff",
              "beneficiary",
              "provider"
            ],
            "title": "Audience",
            "type": "string"
          },
          "csrf_token": {
            "title": "Csrf Token",
            "type": "string"
          },
          "expires_at": {
            "format": "date-time",
            "title": "Expires At",
            "type": "string"
          },
          "principal_ref": {
            "title": "Principal Ref",
            "type": "string"
          },
          "roles": {
            "items": {
              "type": "string"
            },
            "title": "Roles",
            "type": "array"
          },
          "schema_version": {
            "const": 1,
            "default": 1,
            "title": "Schema Version",
            "type": "integer"
          }
        },
        "required": [
          "principal_ref",
          "audience",
          "roles",
          "expires_at",
          "csrf_token"
        ],
        "title": "SessionDTO",
        "type": "object"
      },
      "TaskQueueItem": {
        "additionalProperties": false,
        "properties": {
          "engine_due_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Engine Due At"
          },
          "ownership": {
            "enum": [
              "unassigned",
              "self",
              "other"
            ],
            "title": "Ownership",
            "type": "string"
          },
          "process_definition_key": {
            "maxLength": 512,
            "minLength": 1,
            "pattern": "^[^\\s\\x00-\\x1f\\x7f/?#]+$",
            "title": "Process Definition Key",
            "type": "string"
          },
          "snapshot_at": {
            "format": "date-time",
            "title": "Snapshot At",
            "type": "string"
          },
          "task_definition_key": {
            "maxLength": 512,
            "minLength": 1,
            "pattern": "^[^\\s\\x00-\\x1f\\x7f/?#]+$",
            "title": "Task Definition Key",
            "type": "string"
          },
          "task_id": {
            "maxLength": 512,
            "minLength": 1,
            "pattern": "^[^\\s\\x00-\\x1f\\x7f/?#]+$",
            "title": "Task Id",
            "type": "string"
          },
          "task_revision": {
            "pattern": "^(0|[1-9][0-9]*)$",
            "title": "Task Revision",
            "type": "string"
          }
        },
        "required": [
          "task_id",
          "process_definition_key",
          "task_definition_key",
          "task_revision",
          "ownership",
          "engine_due_at",
          "snapshot_at"
        ],
        "title": "TaskQueueItem",
        "type": "object"
      },
      "TaskQueuePage": {
        "additionalProperties": false,
        "properties": {
          "freshness": {
            "$ref": "#/components/schemas/QueueFreshness"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/TaskQueueItem"
            },
            "maxItems": 100,
            "title": "Items",
            "type": "array"
          },
          "next_cursor": {
            "anyOf": [
              {
                "maxLength": 2048,
                "minLength": 1,
                "pattern": "^[A-Za-z0-9_-]+$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Cursor"
          },
          "queue": {
            "enum": [
              "mine",
              "team"
            ],
            "title": "Queue",
            "type": "string"
          },
          "schema": {
            "const": "portal-task-queue.v1",
            "default": "portal-task-queue.v1",
            "title": "Schema",
            "type": "string"
          }
        },
        "required": [
          "queue",
          "items",
          "next_cursor",
          "freshness"
        ],
        "title": "TaskQueuePage",
        "type": "object"
      },
      "TaskReadResponse": {
        "additionalProperties": false,
        "properties": {
          "freshness": {
            "$ref": "#/components/schemas/QueueFreshness"
          },
          "schema": {
            "const": "portal-task-read.v1",
            "default": "portal-task-read.v1",
            "title": "Schema",
            "type": "string"
          },
          "task": {
            "$ref": "#/components/schemas/PublicTaskSnapshot"
          }
        },
        "required": [
          "task",
          "freshness"
        ],
        "title": "TaskReadResponse",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Portal Maezo",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/portal/auth/callback": {
      "get": {
        "operationId": "callback_api_v1_portal_auth_callback_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Callback"
      }
    },
    "/api/v1/portal/auth/login": {
      "get": {
        "operationId": "login_api_v1_portal_auth_login_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Login"
      }
    },
    "/api/v1/portal/auth/logout": {
      "post": {
        "operationId": "logout_api_v1_portal_auth_logout_post",
        "responses": {
          "204": {
            "description": "Successful Response"
          }
        },
        "summary": "Logout"
      }
    },
    "/api/v1/portal/session": {
      "get": {
        "operationId": "session_api_v1_portal_session_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionDTO"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Session"
      }
    },
    "/api/v1/portal/tasks": {
      "get": {
        "operationId": "list_tasks_api_v1_portal_tasks_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TaskQueuePage"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PortalReadError"
                }
              }
            },
            "description": "Bad Request"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PortalReadError"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PortalReadError"
                }
              }
            },
            "description": "Forbidden"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PortalReadError"
                }
              }
            },
            "description": "Not Found"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PortalReadError"
                }
              }
            },
            "description": "Conflict"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PortalReadError"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "List Tasks"
      }
    },
    "/api/v1/portal/tasks/{task_id}": {
      "get": {
        "operationId": "read_task_api_v1_portal_tasks__task_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "task_id",
            "required": true,
            "schema": {
              "title": "Task Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TaskReadResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PortalReadError"
                }
              }
            },
            "description": "Bad Request"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PortalReadError"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PortalReadError"
                }
              }
            },
            "description": "Forbidden"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PortalReadError"
                }
              }
            },
            "description": "Not Found"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PortalReadError"
                }
              }
            },
            "description": "Conflict"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PortalReadError"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Read Task"
      }
    }
  }
}
