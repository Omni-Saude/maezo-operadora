{
  "name": "@maezo/portal-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "generate": "../../../../.venv/bin/python ../../../../scripts/dev/export_portal_openapi.py --output openapi.json && openapi-typescript openapi.json -o src/generated/api.ts",
    "generate:phi": "../../../../.venv/bin/python ../../../../scripts/dev/export_phi_openapi.py --output phi-openapi.json && openapi-typescript phi-openapi.json -o src/generated/phiApi.ts",
    "check:generated": "node scripts/check-generated.mjs",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "test": "vitest run",
    "test:e2e": "playwright test --config e2e/playwright.config.ts",
    "typecheck:e2e": "tsc --noEmit -p e2e/tsconfig.json",
    "verify": "npm run check:generated && npm run typecheck && npm run test && npm run build",
    "verify:e2e": "npm run typecheck:e2e && npm run test:e2e"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "axe-core": "4.13.0",
    "jsdom": "30.0.1",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  },
  "overrides": {
    "js-yaml": "4.3.2"
  }
}
