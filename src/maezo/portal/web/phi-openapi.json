{
  "components": {
    "schemas": {
      "CommunicationContent": {
        "additionalProperties": false,
        "properties": {
          "body": {
            "title": "Body",
            "type": "string"
          },
          "communication_ref": {
            "pattern": "^[A-Za-z0-9_-]{16,128}$",
            "title": "Communication Ref",
            "type": "string"
          },
          "observed_at": {
            "title": "Observed At",
            "type": "string"
          },
          "valid_until": {
            "title": "Valid Until",
            "type": "string"
          }
        },
        "required": [
          "communication_ref",
          "body",
          "observed_at",
          "valid_until"
        ],
        "title": "CommunicationContent",
        "type": "object"
      },
      "CommunicationContentReceipt": {
        "additionalProperties": false,
        "properties": {
          "body_ref": {
            "pattern": "^[A-Za-z0-9_-]{16,128}$",
            "title": "Body Ref",
            "type": "string"
          },
          "command_id": {
            "pattern": "^[A-Za-z0-9_-]{16,128}$",
            "title": "Command Id",
            "type": "string"
          },
          "disposition": {
            "const": "preserved",
            "default": "preserved",
            "title": "Disposition",
            "type": "string"
          }
        },
        "required": [
          "body_ref",
          "command_id"
        ],
        "title": "CommunicationContentReceipt",
        "type": "object"
      },
      "CommunicationContentSubmission": {
        "additionalProperties": false,
        "properties": {
          "body": {
            "minLength": 1,
            "title": "Body",
            "type": "string"
          },
          "command_id": {
            "pattern": "^[A-Za-z0-9_-]{16,128}$",
            "title": "Command Id",
            "type": "string"
          }
        },
        "required": [
          "command_id",
          "body"
        ],
        "title": "CommunicationContentSubmission",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "PortalIntakeError": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "enum": [
              "invalid_request",
              "authentication_unavailable",
              "operation_forbidden",
              "resource_unavailable",
              "conflict",
              "dependency_unavailable"
            ],
            "title": "Code",
            "type": "string"
          }
        },
        "required": [
          "code"
        ],
        "title": "PortalIntakeError",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
