        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>not("30726042","30726220","30727162","30725151","30731062","30733014","30733022","30733030","30733057","30710065","30726204","30726280")</text></inputEntry>
        <inputEntry><text>not(false)</text></inputEntry>
